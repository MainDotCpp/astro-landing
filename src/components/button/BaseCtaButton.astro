---
import { Image } from 'astro:assets'

type Props = {
    text?: string
    size?: 'sm' | 'md' | 'lg'
    animate?: boolean
    class?: string
    redirect?: boolean
    unstyled?: boolean
    variant?: 'kakao' | 'band' | 'mixed' | 'default'
    icon?: { src: ImageMetadata; alt: string } | null
    showIcon?: boolean
}

const {
    text = '정보 받기',
    size = 'md',
    animate = true,
    class: className = '',
    redirect = true,
    unstyled = false,
    variant = 'default',
    icon = null,
    showIcon = true,
} = Astro.props as Props

// Size configurations
const sizes = {
    sm: { padding: '0.5rem 1rem', fontSize: '1.125rem', icon: 24, gap: '0.375rem' },
    md: { padding: '0.75rem 1.5rem', fontSize: '1.5rem', icon: 28, gap: '0.5rem' },
    lg: { padding: '1rem 2rem', fontSize: '1.5rem', icon: 32, gap: '0.625rem' },
}

const currentSize = sizes[size]

// Get variant class name
function getVariantClass() {
    if (unstyled) return ''
    switch (variant) {
        case 'kakao':
            return 'cta-button-kakao'
        case 'band':
            return 'cta-button-band'
        case 'mixed':
            return 'cta-button-mixed'
        default:
            return 'cta-button-default'
    }
}

const baseClasses = unstyled
    ? `cta-button ${className}`
    : `cta-button ${getVariantClass()} ${className}`
---

<button
    class={`${baseClasses} ${animate && !unstyled ? 'breathing' : ''} ${redirect && variant !== 'mixed' ? 'link-btn' : ''}`}
    id="cta-button"
    onclick={redirect && variant !== 'mixed'
        ? (variant === 'band' ? 'onLinkBtnClick(\'band\')' : 'onLinkBtnClick()')
        : undefined}
    data-umami-event="cta-click"
    data-umami-event-type={variant}
    data-umami-event-size={size}
    type="button"
>
    <slot name="content">
        {showIcon && icon && !unstyled && variant !== 'mixed' && (
            <Image
                class="cta-icon"
                src={icon.src}
                alt={icon.alt}
                width={currentSize.icon}
                height={currentSize.icon}
            />
        )}
        <span class={unstyled ? '' : 'cta-text'} style="position: relative; z-index: 1; display: inline-block;">{text}</span>
    </slot>
</button>

<style>
    .cta-button {
        width: 100%;
        height: 5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        user-select: none;
        border: none;
        outline: none;
        position: relative;
        overflow: hidden;
        padding-left: 2rem;
        padding-right: 2rem;
        box-sizing: border-box;
    }

    .cta-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s ease;
        z-index: 0;
        pointer-events: none;
    }

    .cta-button:hover::before {
        left: 100%;
    }

    .cta-button:focus {
        outline: none;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5), 0 0 0 4px rgba(59, 130, 246, 0.2);
    }

    .cta-button:focus-visible {
        outline: 2px solid rgba(59, 130, 246, 0.5);
        outline-offset: 2px;
    }

    .cta-button:active {
        transform: scale(0.98);
    }

    .cta-button-sm {
        padding: 0.5rem 2rem;
        font-size: 1.125rem;
        gap: 0.375rem;
    }

    .cta-button-md {
        padding: 0.75rem 2.5rem;
        font-size: 1.5rem;
        gap: 0.5rem;
    }

    .cta-button-lg {
        padding: 1rem 3rem;
        font-size: 1.5rem;
        gap: 0.625rem;
    }

    .cta-button-kakao {
        background: linear-gradient(135deg, #FEE500 0%, #FFEB00 40%, #FEE500 80%, #FFF44F 100%);
        background-size: 200% 200%;
        color: #3C1E1E;
        box-shadow: 0 10px 30px -5px rgba(254, 229, 0, 0.45), 
                    0 4px 15px -2px rgba(254, 229, 0, 0.35),
                    inset 0 1px 0 rgba(255, 255, 255, 0.4);
        border: 2px solid rgba(255, 235, 0, 0.4);
        position: relative;
        overflow: hidden;
    }

    .cta-button-kakao::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
        transition: left 0.6s ease;
        z-index: 0;
        pointer-events: none;
    }

    .cta-button-kakao:hover {
        background-position: 100% 50%;
        box-shadow: 0 20px 50px -8px rgba(254, 229, 0, 0.55), 
                    0 8px 20px -4px rgba(254, 229, 0, 0.45),
                    inset 0 1px 0 rgba(255, 255, 255, 0.5);
        border-color: rgba(255, 235, 0, 0.6);
        transform: translateY(-3px) scale(1.02);
    }

    .cta-button-kakao:hover::after {
        left: 100%;
    }

    .cta-button-kakao:active {
        transform: translateY(-1px) scale(0.99);
        box-shadow: 0 5px 20px -5px rgba(254, 229, 0, 0.45), 
                    0 2px 10px -2px rgba(254, 229, 0, 0.35);
    }

    /* Kakao 按钮文字增强 */
    .cta-button-kakao .cta-text {
        font-weight: 700;
        letter-spacing: 0.01em;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
        color: #3C1E1E;
    }

    .cta-button-band {
        background: linear-gradient(135deg, #00C651 0%, #00B347 40%, #00A642 80%, #00D65A 100%);
        background-size: 200% 200%;
        color: white;
        box-shadow: 0 12px 35px -5px rgba(0, 198, 81, 0.5), 
                    0 6px 18px -2px rgba(0, 198, 81, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.1),
                    inset 0 1px 0 rgba(255, 255, 255, 0.3);
        border: 2px solid rgba(0, 198, 81, 0.4);
        position: relative;
        overflow: hidden;
        animation: bandPulse 3s ease-in-out infinite;
    }

    .cta-button-band::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.6s ease;
        z-index: 0;
        pointer-events: none;
    }

    .cta-button-band:hover {
        background-position: 100% 50%;
        box-shadow: 0 25px 60px -8px rgba(0, 198, 81, 0.6), 
                    0 10px 25px -4px rgba(0, 198, 81, 0.5),
                    0 0 0 2px rgba(255, 255, 255, 0.2),
                    inset 0 1px 0 rgba(255, 255, 255, 0.4);
        border-color: rgba(0, 198, 81, 0.6);
        transform: translateY(-4px) scale(1.03);
        animation: none;
    }

    .cta-button-band:hover::after {
        left: 100%;
    }

    .cta-button-band:active {
        transform: translateY(-1px) scale(0.99);
        box-shadow: 0 5px 20px -5px rgba(0, 198, 81, 0.4), 
                    0 2px 10px -2px rgba(0, 198, 81, 0.3);
    }

    /* Band 按钮文字增强 */
    .cta-button-band .cta-text {
        font-weight: 800;
        letter-spacing: 0.03em;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2),
                     0 1px 2px rgba(0, 0, 0, 0.15);
        font-size: 1.05em;
    }

    /* 响应式样式 - 小屏设备优化 */
    @media screen and (max-width: 768px) {
        .cta-button {
            padding-left: 1.25rem;
            padding-right: 1.25rem;
            height: 4rem;
        }

        .cta-button-md {
            font-size: 1.25rem;
            padding: 0.625rem 1.5rem;
        }

        .cta-button-lg {
            font-size: 1.25rem;
            padding: 0.75rem 2rem;
        }

        .cta-button-band .cta-text {
            font-size: 1em;
            letter-spacing: 0.02em;
        }
    }

    @media screen and (max-width: 480px) {
        .cta-button {
            padding-left: 1rem;
            padding-right: 1rem;
            height: 3.5rem;
        }

        .cta-button-md {
            font-size: 1.125rem;
            padding: 0.5rem 1.25rem;
        }

        .cta-button-lg {
            font-size: 1.125rem;
            padding: 0.625rem 1.5rem;
        }

        .cta-button-band .cta-text {
            font-size: 0.95em;
            letter-spacing: 0.01em;
        }
    }

    /* Band 按钮脉冲动画 */
    @keyframes bandPulse {
        0%, 100% {
            box-shadow: 0 12px 35px -5px rgba(0, 198, 81, 0.5), 
                        0 6px 18px -2px rgba(0, 198, 81, 0.4),
                        0 0 0 1px rgba(255, 255, 255, 0.1),
                        inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }
        50% {
            box-shadow: 0 15px 40px -5px rgba(0, 198, 81, 0.6), 
                        0 8px 20px -2px rgba(0, 198, 81, 0.5),
                        0 0 0 2px rgba(255, 255, 255, 0.15),
                        inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }
    }

    .cta-button-mixed {
        background: linear-gradient(135deg, #FEE500 0%, #FFEB00 30%, #ffffff 70%, #f9fafb 100%);
        background-size: 200% 200%;
        color: black;
        box-shadow: 0 10px 25px -5px rgba(254, 229, 0, 0.3), 0 4px 12px -2px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(209, 213, 219, 0.6);
    }

    .cta-button-mixed:hover {
        background-position: 100% 50%;
        box-shadow: 0 20px 40px -8px rgba(254, 229, 0, 0.4), 0 8px 16px -4px rgba(0, 0, 0, 0.15);
        border-color: rgba(209, 213, 219, 0.8);
        transform: translateY(-2px);
    }

    .cta-button-mixed:active {
        transform: translateY(0) scale(0.98);
    }

    .cta-button-default {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 50%, #1e40af 100%);
        background-size: 200% 200%;
        color: white;
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.4), 0 4px 12px -2px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(37, 99, 235, 0.3);
    }

    .cta-button-default:hover {
        background-position: 100% 50%;
        box-shadow: 0 20px 40px -8px rgba(37, 99, 235, 0.5), 0 8px 16px -4px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        transform: translateY(-2px);
    }

    .cta-button-default:active {
        transform: translateY(0) scale(0.98);
    }

    .cta-button .cta-icon {
        border-radius: 9999px;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .cta-button .cta-text {
        flex: 1;
        text-align: center;
        white-space: nowrap;
        position: relative;
        z-index: 1;
        display: block;
    }

    /* 小屏设备允许文字换行 */
    @media screen and (max-width: 480px) {
        .cta-button .cta-text {
            white-space: normal;
            line-height: 1.3;
        }
    }

    .breathing {
        animation: breathing 2s ease-in-out infinite;
    }

    @keyframes breathing {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.05);
            opacity: 0.9;
        }
    }
</style>
