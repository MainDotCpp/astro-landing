---
import BaseCtaButton from './BaseCtaButton.astro'
import kakao from '@/assets/kakao-icon.png'

type Props = {
    size?: 'sm' | 'md' | 'lg'
    animate?: boolean
    class?: string
    redirect?: boolean
    unstyled?: boolean
}

const {
    ...restProps
} = Astro.props as Props
---

<BaseCtaButton
    variant="kakao"
    text="친구추가 후 '7' 전송하기"
    icon={{ src: kakao, alt: 'Kakao' }}
    {...restProps}
>
    <slot name="content" />
</BaseCtaButton>
