---
// StepSection.astro
interface Step {
    title: string;
    description: string;
    icon?: string;
}

interface Props {
    title?: string;
    steps?: Step[];
}

const {
    title = "How It Works",
    steps = [
        { title: "Step 1", description: "Sign up for an account", icon: "user-plus" },
        { title: "Step 2", description: "Configure your settings", icon: "settings" },
        { title: "Step 3", description: "Start enjoying the benefits", icon: "check-circle" }
    ]
} = Astro.props;
---

<section id="steps" class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
        {title}
      </h2>
    </div>
    
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {steps.map((step, index) => (
            <div class="relative flex flex-col items-center bg-white p-6 rounded-lg shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                 <div class="flex items-center justify-center h-12 w-12 rounded-md bg-blue-500 text-white mb-5 text-xl font-bold">
                    {index + 1}
                 </div>
                 <h3 class="text-lg leading-6 font-medium text-gray-900">{step.title}</h3>
                 <p class="mt-2 text-base text-gray-500 text-center">
                    {step.description}
                 </p>
            </div>
        ))}
    </div>
  </div>
</section>
