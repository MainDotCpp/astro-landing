---
import BandCtaButton from './button/BandCtaButton.astro'
import KakaoCopyButton from './button/KaKaoCopyButton.tsx'
import KakaoCtaButton from './button/KakaoCtaButton.astro'
import KakaoGroupCtaButton from './button/KakaoGroupCtaButton.astro'
import KakaoFormButton from './button/KaKaoFormButton.tsx'
import MixedCtaButton from './button/MixedCtaButton.astro'

type Props = {
    social?: '卡扣' | '卡群' | '棒群' | '混合' | '引导弹窗' | '提高质量_'
    size?: 'sm' | 'md' | 'lg'
    animate?: boolean
    class?: string
    redirect?: boolean
    variant?: 'default' | 'custom'
    unstyled?: boolean
}

const {
    social,
    size = 'md',
    animate = true,
    class: className = '',
    redirect = true,
    unstyled = false,
} = Astro.props as Props

// 根据 social 类型渲染对应的按钮组件
---

{social === '卡扣' && (
    <KakaoCtaButton
      size={size}
      animate={animate}
      class={className}
      redirect={redirect}
      unstyled={unstyled}
    >
        <slot name="content" slot="content" />
    </KakaoCtaButton>
)}

{social === '卡群' && (
    <KakaoGroupCtaButton
      size={size}
      animate={animate}
      class={className}
      redirect={redirect}
      unstyled={unstyled}
    >
        <slot name="content" slot="content" />
    </KakaoGroupCtaButton>
)}

{social === '棒群' && (
    <BandCtaButton
      size={size}
      animate={animate}
      class={className}
      redirect={redirect}
      unstyled={unstyled}
    >
        <slot name="content" slot="content" />
    </BandCtaButton>
)}

{social === '混合' && (
    <MixedCtaButton
      size={size}
      animate={animate}
      class={className}
      redirect={redirect}
      unstyled={unstyled}
    >
        <slot name="content" slot="content" />
    </MixedCtaButton>
)}

{social === '引导弹窗' && (
    <KakaoCopyButton client:only="react" />
)}

{social === '提高质量_' && (
    <KakaoFormButton client:only="react" />
)}
