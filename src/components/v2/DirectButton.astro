---
import type { Platform } from '@/campaigns/types'
import BandCtaButton from '@/components/button/BandCtaButton.astro'
import KakaoCtaButton from '@/components/button/KakaoCtaButton.astro'

type Props = {
  platform: Platform
  size?: 'sm' | 'md' | 'lg'
  animate?: boolean
}

const { platform, size = 'md', animate = true } = Astro.props
---

{platform === 'kakao' && <KakaoCtaButton {size} {animate} />}
{platform === 'band' && <BandCtaButton {size} {animate} />}

{(platform === 'line' || platform === 'whatsapp' || platform === 'telegram') && (
  <button
    class="v2-direct-btn link-btn"
    type="button"
    data-platform={platform}
    data-umami-event="cta-click"
    data-umami-event-platform={platform}
  >
    <slot>정보 받기</slot>
  </button>
)}

<style>
  .v2-direct-btn {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 5rem; border: none; border-radius: 9999px;
    font-weight: 700; font-size: 1.25rem; cursor: pointer;
    background: #00b900; color: white;
    transition: filter 0.2s, transform 0.2s;
  }
  .v2-direct-btn:hover { filter: brightness(1.08); transform: translateY(-2px); }
  .v2-direct-btn:active { transform: scale(0.98); }
</style>
