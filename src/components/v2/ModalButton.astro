---
/**
 * Shows a trigger button; clicking reveals an overlay modal whose content
 * is provided via the "modal-content" slot.
 *
 * Falls back to the existing MixedCtaButton for kakao (legacy compat).
 */
import type { Platform } from '@/campaigns/types'
import MixedCtaButton from '@/components/button/MixedCtaButton.astro'

type Props = {
  platform: Platform
  size?: 'sm' | 'md' | 'lg'
  animate?: boolean
}

const { platform, size = 'md', animate = true } = Astro.props

const modalId = `v2-modal-${Math.random().toString(36).slice(2, 8)}`
---

{platform === 'kakao' && (
  <MixedCtaButton {size} {animate}>
    <slot name="modal-content" slot="modal" />
  </MixedCtaButton>
)}

{platform !== 'kakao' && (
  <div>
    <button
      class="v2-modal-trigger link-btn"
      type="button"
      data-modal-target={modalId}
      data-umami-event="cta-modal-open"
      data-umami-event-platform={platform}
     onclick="onLinkBtnClick()">
      <slot>지금 확인하기</slot>
    </button>

    <div id={modalId} class="v2-modal-overlay" style="display:none;">
      <div class="v2-modal-box">
        <button class="v2-modal-close" data-modal-close={modalId} type="button" aria-label="닫기">✕</button>
        <slot name="modal-content">
          <p style="padding:1rem;text-align:center;">채널에 참여하시려면 버튼을 눌러주세요.</p>
        </slot>
      </div>
    </div>
  </div>
)}

<style>
  .v2-modal-trigger {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 5rem; border: none; border-radius: 9999px;
    font-weight: 700; font-size: 1.25rem; cursor: pointer;
    background: #FEE500; color: #3C1E1E;
    transition: filter 0.2s, transform 0.2s;
  }
  .v2-modal-trigger:hover { filter: brightness(0.97); transform: translateY(-2px); }

  .v2-modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
  }
  .v2-modal-box {
    background: white; border-radius: 20px;
    padding: 1.5rem; max-width: 360px; width: 90%; position: relative;
  }
  .v2-modal-close {
    position: absolute; top: 12px; right: 14px;
    background: transparent; border: none; font-size: 18px; cursor: pointer; color: #666;
  }
</style>

<script>
document.addEventListener('click', (e) => {
  const trigger = (e.target as Element).closest('[data-modal-target]') as HTMLElement | null
  if (trigger) {
    const id = trigger.dataset.modalTarget!
    const modal = document.getElementById(id)
    if (modal)
      modal.style.display = 'flex'
  }

  const closer = (e.target as Element).closest('[data-modal-close]') as HTMLElement | null
  if (closer) {
    const id = closer.dataset.modalClose!
    const modal = document.getElementById(id)
    if (modal)
      modal.style.display = 'none'
  }

  const overlay = e.target as Element
  if (overlay.classList.contains('v2-modal-overlay')) {
    (overlay as HTMLElement).style.display = 'none'
  }
})
</script>
