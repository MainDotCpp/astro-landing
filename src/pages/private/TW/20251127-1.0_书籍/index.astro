    <script>
  // Countdown Timer
  function updateCountdown() {
    const now = new Date()

    // 取得當前台灣時間的日期字串
    const twDateString = now.toLocaleString('en-US', {
      timeZone: 'Asia/Taipei',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })

    // 解析日期
    const [month, day, year] = twDateString.split('/')

    // 建立隔天 23:59:59（台灣時間）
    const tomorrowJST = new Date(Date.UTC(
      Number.parseInt(year, 10),
      Number.parseInt(month, 10) - 1,
      Number.parseInt(day, 10) + 1,
      23 - 8, // 台灣 UTC+8 換算
      59,
      59,
      999,
    ))

    // 更新活动期限显示
    const deadlineEl = document.getElementById('campaign-deadline')
    if (deadlineEl) {
      const tomorrowYear = Number.parseInt(year, 10)
      const tomorrowMonth = Number.parseInt(month, 10)
      const tomorrowDay = Number.parseInt(day, 10) + 1
      const formattedDate = `${tomorrowYear}年${tomorrowMonth}月${tomorrowDay}日`
      deadlineEl.textContent = `活動期限：${formattedDate} 23:59 止`
    }

    const diffTime = tomorrowTW.getTime() - now.getTime()

    const daysEl = document.getElementById('days')
    const hoursEl = document.getElementById('hours')
    const minutesEl = document.getElementById('minutes')
    const secondsEl = document.getElementById('seconds')

    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) {
      return
    }

    if (diffTime <= 0) {
      daysEl.textContent = '00'
      hoursEl.textContent = '00'
      minutesEl.textContent = '00'
      secondsEl.textContent = '00'
      return
    }

    const days = Math.floor(diffTime / (1000 * 60 * 60 * 24))
    const hours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
    const minutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60))
    const seconds = Math.floor((diffTime % (1000 * 60)) / 1000)

    daysEl.textContent = days.toString().padStart(2, '0')
    hoursEl.textContent = hours.toString().padStart(2, '0')
    minutesEl.textContent = minutes.toString().padStart(2, '0')
    secondsEl.textContent = seconds.toString().padStart(2, '0')
  }

  setInterval(updateCountdown, 1000)
  updateCountdown()
  </script>

