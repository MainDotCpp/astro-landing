---
// Image imports
import avatarImage from './static/picture/1_rstuvwxyzltywf2.jpg'

import bannerImage from './static/picture/oi_banner.png'
import contactImage from './static/picture/oi_contact.png'
// CSS imports
import './static/css/main-style.css'
---
<!DOCTYPE html>
<html lang="ja">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" >
<!-- #include file="head.html" -->
