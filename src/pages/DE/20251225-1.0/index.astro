---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout lang="de" title="Plan statt Hype - Strukturierte Investment-Strategie" description="Kosten, Regeln, Risiko: Professionelle Investment-Checkliste, Vorlagen und wöchentliche Routine für deutsche Anleger.">
  <script src="https://unpkg.com/lucide@latest"></script>
  <div class="bg-pattern"></div>
  <canvas id="particles-canvas" class="particles-canvas"></canvas>
  <div class="floating-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
  </div>
  <main class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="data-stream">
        <div class="stream-item">+12.5%</div>
        <div class="stream-item">€24,500</div>
        <div class="stream-item">NASDAQ</div>
        <div class="stream-item">DAX</div>
        <div class="stream-item">+8.3%</div>
        <div class="stream-item">€18,200</div>
      </div>
      <div class="container">
        <div class="hero-content-wrapper">
          <div class="hero-badge">Strukturiert • Professionell • Transparent</div>
          <h1 class="hero-title">
            <span class="title-glow">Plan</span> statt <span class="title-glow">Hype</span>
          </h1>
          <div class="hero-subtitle-wrapper">
            <span class="hero-subtitle-line"></span>
            <p class="hero-subtitle">Kosten • Regeln • Risiko</p>
            <span class="hero-subtitle-line"></span>
          </div>
          <p class="hero-description">
            Strukturierte Investment-Strategie für rationale Anleger.
            Keine Versprechungen, nur klare Regeln und nachvollziehbare Prozesse.
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-value" data-target="1000">0</div>
              <div class="stat-label">Aktive Mitglieder</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <div class="stat-value" data-target="95">0</div>
              <div class="stat-label">% Strukturiert</div>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <div class="stat-value" data-target="24">0</div>
              <div class="stat-label">/7 Support</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Provide Section -->
    <section class="provides-section">
      <div class="container">
        <h2 class="section-title">Was Sie erhalten</h2>
        <div class="provides-grid">
          <div class="provide-card">
            <div class="card-glow"></div>
            <div class="card-icon">
              <i data-lucide="check-circle-2" class="icon"></i>
            </div>
            <h3 class="card-title">Checkliste</h3>
            <p class="card-description">
              Strukturierte Prüfliste für jede Investment-Entscheidung.
              Systematische Bewertung von Chancen und Risiken.
            </p>
            <ul class="card-features">
              <li>Risiko-Bewertungsmatrix</li>
              <li>Kosten-Nutzen-Analyse</li>
              <li>Exit-Strategie Checkliste</li>
            </ul>
          </div>

          <div class="provide-card">
            <div class="card-glow"></div>
            <div class="card-icon">
              <i data-lucide="file-text" class="icon"></i>
            </div>
            <h3 class="card-title">Vorlage</h3>
            <p class="card-description">
              Professionelle Templates für Ihre Investment-Dokumentation.
              Standardisierte Formate für bessere Entscheidungen.
            </p>
            <ul class="card-features">
              <li>Trade-Journal Vorlage</li>
              <li>Portfolio-Tracking Sheet</li>
              <li>Risiko-Management Formular</li>
            </ul>
          </div>

          <div class="provide-card">
            <div class="card-glow"></div>
            <div class="card-icon">
              <i data-lucide="calendar" class="icon"></i>
            </div>
            <h3 class="card-title">Routine</h3>
            <p class="card-description">
              Wöchentliche Struktur für kontinuierliche Verbesserung.
              Regelmäßige Review-Prozesse statt impulsiver Entscheidungen.
            </p>
            <ul class="card-features">
              <li>Wöchentliches Portfolio-Review</li>
              <li>Marktanalyse-Framework</li>
              <li>Performance-Tracking Prozess</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2 class="cta-title">Strukturiert investieren lernen</h2>
          <p class="cta-description">
            Holen Sie sich die kostenlose Checkliste und treten Sie unserer
            strukturierten Investment-Community bei.
          </p>
          <a href="#" class="cta-button" id="whatsappBtn">
            <i data-lucide="message-circle" class="icon"></i>
            WhatsApp öffnen und Checkliste holen
          </a>
        </div>
      </div>
    </section>

    <!-- Risk Disclosure Section -->
    <section class="risk-section">
      <div class="container">
        <h2 class="section-title">Wichtige Hinweise</h2>
        <div class="risk-box">
          <div class="risk-item">
            <div class="risk-header">
              <i data-lucide="alert-triangle" class="icon"></i>
              <strong>Keine Kaufempfehlung</strong>
            </div>
            <p>Wir geben keine konkreten Kauf- oder Verkaufsempfehlungen für einzelne Wertpapiere.</p>
          </div>
          <div class="risk-item">
            <div class="risk-header">
              <i data-lucide="alert-triangle" class="icon"></i>
              <strong>Keine Garantie</strong>
            </div>
            <p>Wir garantieren keine Gewinne oder Renditen. Alle Informationen dienen ausschließlich der Bildung.</p>
          </div>
          <div class="risk-item">
            <div class="risk-header">
              <i data-lucide="alert-triangle" class="icon"></i>
              <strong>Investieren hat Risiken</strong>
            </div>
            <p>Kurse können fallen. Sie können Ihr investiertes Kapital teilweise oder vollständig verlieren.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trader Code Section (Screening Module) -->
    <section class="trader-code-section">
      <div class="container">
        <h2 class="section-title">Für erfahrene Anleger</h2>
        <p class="section-description">
          Wenn Sie diese Begriffe verstehen, sind Sie bereits auf dem richtigen Weg:
        </p>
        <div class="code-grid">
          <div class="code-item">
            <span class="code-term">Breakout</span>
            <span class="code-desc">Preisdurchbruch aus Konsolidierung</span>
          </div>
          <div class="code-item">
            <span class="code-term">Pullback</span>
            <span class="code-desc">Korrektur nach Aufwärtstrend</span>
          </div>
          <div class="code-item">
            <span class="code-term">Volumen</span>
            <span class="code-desc">Handelsvolumen als Bestätigung</span>
          </div>
          <div class="code-item">
            <span class="code-term">Stop Loss</span>
            <span class="code-desc">Risikobegrenzung durch Ausstiegsorder</span>
          </div>
          <div class="code-item">
            <span class="code-term">Positionsgröße</span>
            <span class="code-desc">Kapitalallokation pro Trade</span>
          </div>
          <div class="code-item">
            <span class="code-term">Earnings</span>
            <span class="code-desc">Quartalszahlen und deren Auswirkungen</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            <h3 class="footer-title">Impressum</h3>
            <p class="footer-text">
              Angaben gemäß § 5 TMG<br>
              [Firmenname]<br>
              [Straße und Hausnummer]<br>
              [PLZ Ort]<br><br>
              Kontakt:<br>
              E-Mail: [E-Mail-Adresse]<br>
              Telefon: [Telefonnummer]
            </p>
          </div>
          <div class="footer-section">
            <h3 class="footer-title">Datenschutz</h3>
            <p class="footer-text">
              Ihre Daten werden gemäß der DSGVO verarbeitet.
              Weitere Informationen finden Sie in unserer
              <a href="#" class="footer-link">Datenschutzerklärung</a>.
            </p>
          </div>
          <div class="footer-section">
            <h3 class="footer-title">Kontakt</h3>
            <p class="footer-text">
              Bei Fragen erreichen Sie uns unter:<br>
              E-Mail: [E-Mail-Adresse]<br>
              WhatsApp: [WhatsApp-Link]
            </p>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2024. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>
  </main>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap');

    :root {
      --primary-color: #0a0e27;
      --secondary-color: #1e293b;
      --accent-color: #3b82f6;
      --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      --text-color: #1e293b;
      --text-light: #64748b;
      --bg-light: #f8fafc;
      --bg-dark: #0f172a;
      --border-color: #e2e8f0;
      --white: #ffffff;
      --risk-color: #ef4444;
      --success-color: #10b981;
      --glass-bg: rgba(255, 255, 255, 0.1);
      --glass-border: rgba(255, 255, 255, 0.2);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      color: var(--text-color);
      line-height: 1.6;
      background-color: var(--white);
      overflow-x: hidden;
      font-feature-settings: 'kern' 1, 'liga' 1;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
      position: relative;
      z-index: 1;
    }

    /* Particles Canvas */
    .particles-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      opacity: 0.6;
    }

    /* Floating Shapes */
    .floating-shapes {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    .shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.3;
      animation: float 20s infinite ease-in-out;
    }

    .shape-1 {
      width: 400px;
      height: 400px;
      background: linear-gradient(135deg, #3b82f6, #8b5cf6);
      top: 10%;
      left: 10%;
      animation-delay: 0s;
    }

    .shape-2 {
      width: 300px;
      height: 300px;
      background: linear-gradient(135deg, #8b5cf6, #ec4899);
      top: 60%;
      right: 10%;
      animation-delay: 5s;
    }

    .shape-3 {
      width: 250px;
      height: 250px;
      background: linear-gradient(135deg, #3b82f6, #06b6d4);
      bottom: 20%;
      left: 20%;
      animation-delay: 10s;
    }

    .shape-4 {
      width: 350px;
      height: 350px;
      background: linear-gradient(135deg, #ec4899, #f59e0b);
      top: 30%;
      right: 30%;
      animation-delay: 15s;
    }

    @keyframes float {
      0%, 100% {
        transform: translate(0, 0) scale(1);
      }
      25% {
        transform: translate(50px, -50px) scale(1.1);
      }
      50% {
        transform: translate(-30px, 30px) scale(0.9);
      }
      75% {
        transform: translate(30px, 50px) scale(1.05);
      }
    }

    /* Animated Background Pattern */
    .bg-pattern {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.05;
      background-image:
        linear-gradient(30deg, #3b82f6 12%, transparent 12.5%, transparent 87%, #3b82f6 87.5%, #3b82f6),
        linear-gradient(150deg, #3b82f6 12%, transparent 12.5%, transparent 87%, #3b82f6 87.5%, #3b82f6),
        linear-gradient(30deg, #3b82f6 12%, transparent 12.5%, transparent 87%, #3b82f6 87.5%, #3b82f6),
        linear-gradient(150deg, #3b82f6 12%, transparent 12.5%, transparent 87%, #3b82f6 87.5%, #3b82f6);
      background-size: 80px 140px;
      background-position: 0 0, 0 0, 40px 70px, 40px 70px;
      animation: patternMove 20s linear infinite;
    }

    @keyframes patternMove {
      0% { transform: translate(0, 0); }
      100% { transform: translate(40px, 70px); }
    }

    /* Hero Section */
    .hero {
      position: relative;
      background:
        linear-gradient(135deg, rgba(10, 14, 39, 0.98) 0%, rgba(30, 41, 59, 0.98) 100%),
        url('https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1920&q=80') center/cover;
      color: var(--white);
      padding: 140px 0;
      text-align: center;
      overflow: hidden;
      z-index: 2;
    }

    .hero-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
      border-radius: 50%;
      filter: blur(100px);
      animation: pulseGlow 4s ease-in-out infinite;
      z-index: 0;
    }

    @keyframes pulseGlow {
      0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.5;
      }
      50% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0.8;
      }
    }

    .data-stream {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    .stream-item {
      position: absolute;
      font-family: 'JetBrains Mono', 'Courier New', monospace;
      font-size: 14px;
      color: rgba(59, 130, 246, 0.4);
      font-weight: 600;
      animation: streamDown 15s linear infinite;
      text-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
      letter-spacing: 0.05em;
    }

    .stream-item:nth-child(1) {
      left: 10%;
      animation-delay: 0s;
    }

    .stream-item:nth-child(2) {
      left: 25%;
      animation-delay: 2s;
    }

    .stream-item:nth-child(3) {
      left: 40%;
      animation-delay: 4s;
    }

    .stream-item:nth-child(4) {
      left: 55%;
      animation-delay: 6s;
    }

    .stream-item:nth-child(5) {
      left: 70%;
      animation-delay: 8s;
    }

    .stream-item:nth-child(6) {
      left: 85%;
      animation-delay: 10s;
    }

    @keyframes streamDown {
      0% {
        top: -50px;
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    .hero-content-wrapper {
      position: relative;
      z-index: 2;
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-badge {
      font-family: 'JetBrains Mono', 'Courier New', monospace;
      display: inline-block;
      padding: 8px 20px;
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 50px;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.9);
      letter-spacing: 0.08em;
      margin-bottom: 32px;
      backdrop-filter: blur(10px);
      animation: fadeInUp 0.8s ease-out 0.1s both;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%);
      z-index: 0;
    }

    .hero::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(59, 130, 246, 0.03) 2px,
          rgba(59, 130, 246, 0.03) 4px
        );
      animation: gridMove 20s linear infinite;
      z-index: 0;
    }

    @keyframes gridMove {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(20px, 20px) rotate(0deg); }
    }

    .hero .container {
      position: relative;
      z-index: 1;
    }

    .hero-title {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 5rem;
      font-weight: 700;
      margin-bottom: 24px;
      letter-spacing: -0.05em;
      animation: fadeInUp 0.8s ease-out 0.2s both;
      position: relative;
      display: inline-block;
      line-height: 1.1;
    }

    .title-glow {
      background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #f472b6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: 0 0 40px rgba(96, 165, 250, 0.5);
      animation: textShimmer 3s ease-in-out infinite;
      position: relative;
    }

    .title-glow::after {
      content: attr(data-text);
      position: absolute;
      left: 0;
      top: 0;
      z-index: -1;
      background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #f472b6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: blur(20px);
      opacity: 0.7;
    }

    @keyframes textShimmer {
      0%, 100% {
        filter: brightness(1);
      }
      50% {
        filter: brightness(1.3);
      }
    }

    .hero-subtitle-wrapper {
      display: flex;
      align-items: center;
      gap: 20px;
      width: 100%;
      max-width: 600px;
      margin-bottom: 40px;
      animation: fadeInUp 0.8s ease-out 0.3s both;
    }

    .hero-subtitle-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.5), transparent);
    }

    .hero-subtitle {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.9);
      white-space: nowrap;
      padding: 0 10px;
    }

    .hero-description {
      font-family: 'Inter', sans-serif;
      font-size: 1.25rem;
      max-width: 700px;
      margin: 0 auto 50px;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.75;
      animation: fadeInUp 0.8s ease-out 0.4s both;
      font-weight: 400;
      letter-spacing: -0.01em;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0;
      margin-top: 50px;
      flex-wrap: wrap;
      padding: 30px 0;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      width: 100%;
      max-width: 700px;
      animation: fadeInUp 0.8s ease-out 0.5s both;
    }

    .stat-item {
      text-align: center;
      flex: 1;
      min-width: 150px;
      padding: 0 20px;
    }

    .stat-divider {
      width: 1px;
      height: 60px;
      background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      flex-shrink: 0;
    }

    .stat-value {
      font-family: 'JetBrains Mono', 'Courier New', monospace;
      font-size: 2.5rem;
      font-weight: 700;
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      margin-bottom: 6px;
      text-shadow: 0 0 30px rgba(59, 130, 246, 0.5);
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }

    .stat-label {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 500;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Provides Section */
    .provides-section {
      position: relative;
      padding: 100px 0;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .provides-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.3), transparent);
    }

    .section-title {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 2.75rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 60px;
      color: var(--primary-color);
      letter-spacing: -0.04em;
      position: relative;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: -16px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background: var(--accent-gradient);
      border-radius: 2px;
    }

    .provides-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 40px;
      margin-top: 50px;
    }

    .provide-card {
      position: relative;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 20px;
      padding: 48px 32px;
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      transform-style: preserve-3d;
      perspective: 1000px;
    }

    .card-glow {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    .provide-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--accent-gradient);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease;
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
    }

    .provide-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 20px;
      padding: 2px;
      background: var(--accent-gradient);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .provide-card:hover {
      box-shadow:
        0 30px 60px rgba(59, 130, 246, 0.25),
        0 0 0 1px rgba(59, 130, 246, 0.2),
        inset 0 0 60px rgba(59, 130, 246, 0.1);
      transform: translateY(-12px) rotateX(2deg);
      border-color: rgba(59, 130, 246, 0.4);
    }

    .provide-card:hover .card-glow {
      opacity: 1;
    }

    .provide-card:hover::before {
      transform: scaleX(1);
    }

    .provide-card:hover::after {
      opacity: 1;
    }

    .card-icon {
      width: 72px;
      height: 72px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-gradient);
      border-radius: 16px;
      padding: 16px;
      box-shadow:
        0 8px 24px rgba(59, 130, 246, 0.3),
        0 0 0 0 rgba(59, 130, 246, 0.5),
        inset 0 2px 4px rgba(255, 255, 255, 0.2);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .card-icon::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transform: rotate(45deg);
      animation: iconShine 3s infinite;
    }

    @keyframes iconShine {
      0% {
        transform: translateX(-100%) translateY(-100%) rotate(45deg);
      }
      100% {
        transform: translateX(100%) translateY(100%) rotate(45deg);
      }
    }

    .card-icon .icon {
      width: 100%;
      height: 100%;
      color: white;
      stroke-width: 2;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
      position: relative;
      z-index: 1;
    }

    .provide-card:hover .card-icon {
      transform: rotate(8deg) scale(1.15);
      box-shadow:
        0 16px 32px rgba(59, 130, 246, 0.4),
        0 0 0 4px rgba(59, 130, 246, 0.2),
        inset 0 2px 4px rgba(255, 255, 255, 0.3);
    }

    .card-title {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 15px;
      color: var(--primary-color);
      letter-spacing: -0.01em;
    }

    .card-description {
      font-family: 'Inter', sans-serif;
      color: var(--text-light);
      margin-bottom: 20px;
      line-height: 1.7;
      font-weight: 400;
    }

    .card-features {
      list-style: none;
      padding: 0;
    }

    .card-features li {
      padding: 8px 0;
      padding-left: 24px;
      position: relative;
      color: var(--text-color);
    }

    .card-features li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--success-color);
      font-weight: bold;
      font-size: 1.1em;
    }

    /* CTA Section */
    .cta-section {
      position: relative;
      padding: 100px 0;
      background:
        linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%),
        url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1920&q=80') center/cover;
      background-attachment: fixed;
    }

    .cta-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(255, 255, 255, 0.95);
      z-index: 0;
    }

    .cta-box {
      position: relative;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px);
      border: 2px solid transparent;
      background-image:
        linear-gradient(white, white),
        var(--accent-gradient);
      background-origin: border-box;
      background-clip: padding-box, border-box;
      border-radius: 24px;
      padding: 72px 48px;
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      box-shadow:
        0 20px 60px rgba(59, 130, 246, 0.2),
        0 0 0 1px rgba(59, 130, 246, 0.1);
      z-index: 1;
    }

    .cta-title {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: var(--primary-color);
      letter-spacing: -0.02em;
    }

    .cta-description {
      font-family: 'Inter', sans-serif;
      font-size: 1.125rem;
      color: var(--text-light);
      margin-bottom: 40px;
      line-height: 1.75;
      font-weight: 400;
    }

    .cta-button {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--accent-gradient);
      color: var(--white);
      padding: 22px 48px;
      border-radius: 16px;
      text-decoration: none;
      font-size: 1.25rem;
      font-weight: 600;
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      border: none;
      cursor: pointer;
      box-shadow:
        0 10px 30px rgba(59, 130, 246, 0.4),
        0 0 0 0 rgba(59, 130, 246, 0.5);
      position: relative;
      overflow: hidden;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .cta-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      transition: left 0.6s ease;
    }

    .cta-button::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 16px;
      padding: 2px;
      background: var(--accent-gradient);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.5s ease;
      z-index: -1;
    }

    .cta-button:hover {
      transform: translateY(-6px) scale(1.05);
      box-shadow:
        0 20px 50px rgba(59, 130, 246, 0.5),
        0 0 0 8px rgba(59, 130, 246, 0.2);
    }

    .cta-button:hover::before {
      left: 100%;
    }

    .cta-button:hover::after {
      opacity: 1;
    }

    .cta-button .icon {
      width: 24px;
      height: 24px;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
      transition: transform 0.3s ease;
    }

    .cta-button:hover .icon {
      transform: scale(1.2) rotate(5deg);
    }

    .cta-button svg {
      width: 24px;
      height: 24px;
    }

    /* Risk Section */
    .risk-section {
      position: relative;
      padding: 100px 0;
      background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .risk-box {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.05) 0%, rgba(239, 68, 68, 0.02) 100%);
      border-left: 4px solid var(--risk-color);
      border-radius: 16px;
      padding: 48px;
      max-width: 900px;
      margin: 0 auto;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 24px rgba(239, 68, 68, 0.1);
    }

    .risk-item {
      margin-bottom: 32px;
      padding-left: 40px;
      position: relative;
    }

    .risk-item:last-child {
      margin-bottom: 0;
    }

    .risk-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .risk-header .icon {
      position: absolute;
      left: 0;
      width: 24px;
      height: 24px;
      color: var(--risk-color);
      flex-shrink: 0;
      stroke-width: 2;
    }

    .risk-item strong {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 1.25rem;
      color: var(--risk-color);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .risk-item p {
      color: var(--text-color);
      line-height: 1.7;
    }

    /* Trader Code Section */
    .trader-code-section {
      position: relative;
      padding: 100px 0;
      background:
        linear-gradient(135deg, rgba(59, 130, 246, 0.03) 0%, rgba(139, 92, 246, 0.03) 100%),
        url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1920&q=80') center/cover;
      background-attachment: fixed;
    }

    .trader-code-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(248, 250, 252, 0.95);
      z-index: 0;
    }

    .trader-code-section .container {
      position: relative;
      z-index: 1;
    }

    .section-description {
      text-align: center;
      font-size: 1.25rem;
      color: var(--text-light);
      margin-bottom: 50px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
      font-weight: 400;
    }

    .code-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      max-width: 1000px;
      margin: 0 auto;
    }

    .code-item {
      position: relative;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 12px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }

    .code-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: var(--accent-gradient);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }

    .code-item:hover {
      border-color: rgba(59, 130, 246, 0.4);
      box-shadow: 0 12px 32px rgba(59, 130, 246, 0.15);
      transform: translateY(-4px);
    }

    .code-item:hover::before {
      transform: scaleX(1);
    }

    .code-term {
      font-family: 'JetBrains Mono', 'Courier New', monospace;
      font-weight: 600;
      font-size: 1.25rem;
      color: var(--primary-color);
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 0.02em;
    }

    .code-desc {
      font-size: 0.95rem;
      color: var(--text-light);
      line-height: 1.6;
    }

    /* Footer */
    .footer {
      position: relative;
      background:
        linear-gradient(135deg, #0a0e27 0%, #1e293b 100%),
        url('https://images.unsplash.com/photo-1557683316-973673baf926?w=1920&q=80') center/cover;
      color: var(--white);
      padding: 80px 0 40px;
      overflow: hidden;
    }

    .footer::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(10, 14, 39, 0.95);
      z-index: 0;
    }

    .footer::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.5), transparent);
      z-index: 1;
    }

    .footer .container {
      position: relative;
      z-index: 1;
    }

    .footer-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 40px;
      margin-bottom: 40px;
    }

    .footer-title {
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }

    .footer-text {
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.8;
      font-size: 0.95rem;
    }

    .footer-link {
      color: #60a5fa;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: all 0.3s ease;
    }

    .footer-link:hover {
      color: #93c5fd;
      border-bottom-color: #93c5fd;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.9rem;
    }

    /* Smooth Scroll */
    html {
      scroll-behavior: smooth;
    }

    /* Responsive - Mobile First Approach */

    /* Small Mobile (up to 480px) */
    @media (max-width: 480px) {
      .container {
        padding: 0 16px;
      }

      .hero {
        padding: 60px 0 80px;
        background-attachment: scroll;
      }

      .hero-glow {
        width: 400px;
        height: 400px;
      }

      .hero-title {
        font-size: 2rem;
        line-height: 1.2;
        margin-bottom: 20px;
      }

      .hero-badge {
        font-size: 0.75rem;
        padding: 6px 16px;
        margin-bottom: 24px;
      }

      .hero-subtitle-wrapper {
        flex-direction: column;
        gap: 12px;
        margin-bottom: 28px;
      }

      .hero-subtitle-line {
        width: 60px;
        height: 1px;
      }

      .hero-subtitle {
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        padding: 0;
      }

      .hero-description {
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 40px;
        padding: 0 10px;
      }

      .hero-stats {
        flex-direction: column;
        gap: 0;
        margin-top: 40px;
        padding: 24px 20px;
        border-radius: 12px;
      }

      .stat-divider {
        width: 60px;
        height: 1px;
        margin: 20px auto;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      }

      .stat-item {
        padding: 0;
        min-width: auto;
      }

      .stat-value {
        font-size: 2rem;
      }

      .stat-label {
        font-size: 0.75rem;
      }

      .data-stream {
        display: none; /* Hide on very small screens for performance */
      }

      .section-title {
        font-size: 1.75rem;
        margin-bottom: 32px;
      }

      .section-title::after {
        width: 60px;
        height: 3px;
      }

      .provides-section,
      .cta-section,
      .risk-section,
      .trader-code-section {
        padding: 50px 0;
      }

      .provides-grid {
        grid-template-columns: 1fr;
        gap: 20px;
        margin-top: 32px;
      }

      .provide-card {
        padding: 28px 20px;
        border-radius: 16px;
      }

      .card-icon {
        width: 56px;
        height: 56px;
        padding: 12px;
        margin-bottom: 20px;
      }

      .card-title {
        font-size: 1.25rem;
        margin-bottom: 12px;
      }

      .card-description {
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 16px;
      }

      .card-features {
        font-size: 0.85rem;
      }

      .card-features li {
        padding: 6px 0;
        padding-left: 20px;
      }

      .cta-box {
        padding: 36px 20px;
        border-radius: 20px;
      }

      .cta-title {
        font-size: 1.5rem;
        margin-bottom: 16px;
        line-height: 1.3;
      }

      .cta-description {
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 32px;
      }

      .cta-button {
        padding: 16px 32px;
        font-size: 1rem;
        width: 100%;
        justify-content: center;
        border-radius: 12px;
      }

      .cta-button svg {
        width: 20px;
        height: 20px;
      }

      .risk-box {
        padding: 28px 20px;
        border-radius: 12px;
      }

      .risk-item {
        margin-bottom: 24px;
        padding-left: 32px;
      }

      .risk-header svg {
        width: 20px;
        height: 20px;
      }

      .risk-item strong {
        font-size: 1.1rem;
        margin-bottom: 8px;
      }

      .risk-item p {
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .section-description {
        font-size: 1rem;
        margin-bottom: 32px;
        padding: 0 10px;
      }

      .code-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .code-item {
        padding: 20px;
        border-radius: 12px;
      }

      .code-term {
        font-size: 1.1rem;
      }

      .code-desc {
        font-size: 0.85rem;
        line-height: 1.5;
      }

      .footer {
        padding: 50px 0 30px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 28px;
        margin-bottom: 32px;
      }

      .footer-title {
        font-size: 1.1rem;
        margin-bottom: 16px;
      }

      .footer-text {
        font-size: 0.85rem;
        line-height: 1.7;
      }

      .footer-bottom {
        padding-top: 24px;
        font-size: 0.8rem;
      }

      /* Reduce floating shapes on mobile */
      .shape {
        opacity: 0.15;
      }

      .shape-1,
      .shape-2,
      .shape-3,
      .shape-4 {
        width: 200px;
        height: 200px;
      }

      /* Reduce particle count on mobile */
      .particles-canvas {
        opacity: 0.3;
      }
    }

    /* Medium Mobile (481px to 768px) */
    @media (min-width: 481px) and (max-width: 768px) {
      .container {
        padding: 0 20px;
      }

      .hero {
        padding: 80px 0 100px;
        background-attachment: scroll;
      }

      .hero-glow {
        width: 600px;
        height: 600px;
      }

      .hero-title {
        font-size: 3rem;
        margin-bottom: 24px;
      }

      .hero-badge {
        font-size: 0.8rem;
        padding: 7px 18px;
        margin-bottom: 28px;
      }

      .hero-subtitle-wrapper {
        gap: 16px;
        margin-bottom: 32px;
      }

      .hero-subtitle-line {
        width: 80px;
      }

      .hero-subtitle {
        font-size: 1rem;
        letter-spacing: 0.12em;
      }

      .hero-description {
        font-size: 1.1rem;
        margin-bottom: 50px;
      }

      .hero-stats {
        gap: 0;
        margin-top: 45px;
        padding: 28px 24px;
        border-radius: 14px;
      }

      .stat-divider {
        width: 80px;
        height: 1px;
        margin: 24px auto;
      }

      .stat-item {
        padding: 0 15px;
      }

      .stat-value {
        font-size: 2.25rem;
      }

      .stat-label {
        font-size: 0.8rem;
      }

      .section-title {
        font-size: 2.25rem;
        margin-bottom: 40px;
      }

      .provides-section,
      .cta-section,
      .risk-section,
      .trader-code-section {
        padding: 60px 0;
      }

      .provides-grid {
        grid-template-columns: 1fr;
        gap: 24px;
        margin-top: 40px;
      }

      .provide-card {
        padding: 36px 28px;
      }

      .card-icon {
        width: 64px;
        height: 64px;
      }

      .card-title {
        font-size: 1.375rem;
      }

      .card-description {
        font-size: 0.95rem;
      }

      .cta-box {
        padding: 50px 32px;
      }

      .cta-title {
        font-size: 1.75rem;
      }

      .cta-description {
        font-size: 1.05rem;
      }

      .cta-button {
        padding: 18px 40px;
        font-size: 1.1rem;
      }

      .risk-box {
        padding: 36px 28px;
      }

      .risk-item {
        padding-left: 36px;
      }

      .code-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }

      .footer-content {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .shape-1,
      .shape-2,
      .shape-3,
      .shape-4 {
        width: 250px;
        height: 250px;
      }
    }

    /* Tablet (769px to 1024px) */
    @media (min-width: 769px) and (max-width: 1024px) {
      .hero-title {
        font-size: 4rem;
      }

      .hero-subtitle {
        font-size: 1.25rem;
      }

      .provides-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 32px;
      }

      .code-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .hero-stats {
        gap: 50px;
      }
    }

    /* General Mobile Optimizations */
    @media (max-width: 768px) {
      .container {
        padding: 0 20px;
      }

      .hero {
        background-attachment: scroll;
      }

      .cta-section {
        background-attachment: scroll;
      }

      .trader-code-section {
        background-attachment: scroll;
      }

      /* Optimize animations for mobile */
      .provide-card:hover {
        transform: translateY(-4px);
      }

      .provide-card:hover .card-icon {
        transform: rotate(4deg) scale(1.1);
      }

      .cta-button:hover {
        transform: translateY(-3px) scale(1.02);
      }

      /* Reduce data stream items on mobile */
      .stream-item {
        font-size: 12px;
      }

      /* Adjust hero glow for mobile */
      .hero-glow {
        width: 500px;
        height: 500px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <script>
// Particles Animation
function initParticles() {
  const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement | null
  if (!canvas)
    return

  const ctx = canvas.getContext('2d')
  if (!ctx)
    return

  const setCanvasSize = () => {
    canvas.width = window.innerWidth
    canvas.height = window.innerHeight
  }
  setCanvasSize()

  interface Particle {
    x: number
    y: number
    size: number
    speedX: number
    speedY: number
    opacity: number
    update: () => void
    draw: () => void
  }

  const particles: Particle[] = []
  // Reduce particle count on mobile for better performance
  const isMobile = window.innerWidth <= 768
  const particleCount = isMobile ? 40 : 80

  class ParticleClass implements Particle {
    x: number
    y: number
    size: number
    speedX: number
    speedY: number
    opacity: number
    private canvasRef: HTMLCanvasElement
    private ctxRef: CanvasRenderingContext2D

    constructor(canvasRef: HTMLCanvasElement, ctxRef: CanvasRenderingContext2D) {
      this.canvasRef = canvasRef
      this.ctxRef = ctxRef
      this.x = Math.random() * canvasRef.width
      this.y = Math.random() * canvasRef.height
      this.size = Math.random() * 2 + 1
      this.speedX = Math.random() * 1 - 0.5
      this.speedY = Math.random() * 1 - 0.5
      this.opacity = Math.random() * 0.5 + 0.2
    }

    update() {
      this.x += this.speedX
      this.y += this.speedY

      if (this.x > this.canvasRef.width)
        this.x = 0
      if (this.x < 0)
        this.x = this.canvasRef.width
      if (this.y > this.canvasRef.height)
        this.y = 0
      if (this.y < 0)
        this.y = this.canvasRef.height
    }

    draw() {
      this.ctxRef.fillStyle = `rgba(59, 130, 246, ${this.opacity})`
      this.ctxRef.beginPath()
      this.ctxRef.arc(this.x, this.y, this.size, 0, Math.PI * 2)
      this.ctxRef.fill()
    }
  }

  for (let i = 0; i < particleCount; i++) {
    particles.push(new ParticleClass(canvas, ctx))
  }

  function animate() {
    if (!ctx || !canvas)
      return
    ctx.clearRect(0, 0, canvas.width, canvas.height)

    particles.forEach((particle, i) => {
      particle.update()
      particle.draw()

      // Draw connections
      particles.slice(i + 1).forEach((otherParticle) => {
        const dx = particle.x - otherParticle.x
        const dy = particle.y - otherParticle.y
        const distance = Math.sqrt(dx * dx + dy * dy)

        if (distance < 120 && ctx) {
          ctx.strokeStyle = `rgba(59, 130, 246, ${0.2 * (1 - distance / 120)})`
          ctx.lineWidth = 1
          ctx.beginPath()
          ctx.moveTo(particle.x, particle.y)
          ctx.lineTo(otherParticle.x, otherParticle.y)
          ctx.stroke()
        }
      })
    })

    requestAnimationFrame(animate)
  }

  animate()

  window.addEventListener('resize', () => {
    setCanvasSize()
    // Canvas size updated, particles will adapt automatically
  })
}

// Animated Counter
function animateCounter(element: HTMLElement, target: number, duration = 2000) {
  const start = 0
  const increment = target / (duration / 16)
  let current = start

  const timer = setInterval(() => {
    current += increment
    if (current >= target) {
      element.textContent = String(target)
      clearInterval(timer)
    }
    else {
      element.textContent = String(Math.floor(current))
    }
  }, 16)
}

// Initialize counters when in view
function initCounters() {
  const stats = document.querySelectorAll('.stat-value')
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && entry.target instanceof HTMLElement) {
        const targetAttr = entry.target.getAttribute('data-target')
        if (targetAttr) {
          const target = Number.parseInt(targetAttr, 10)
          animateCounter(entry.target, target)
          observer.unobserve(entry.target)
        }
      }
    })
  }, { threshold: 0.5 })

  stats.forEach(stat => observer.observe(stat))
}

// Initialize Lucide Icons
function initLucideIcons() {
  if (typeof window !== 'undefined' && (window as any).lucide) {
    (window as any).lucide.createIcons()
  }
}

// WhatsApp button handler
document.addEventListener('DOMContentLoaded', () => {
  initParticles()
  initCounters()
  initLucideIcons()

  const whatsappBtn = document.getElementById('whatsappBtn')
  if (whatsappBtn) {
    whatsappBtn.addEventListener('click', (e) => {
      e.preventDefault()
      // Replace with your actual WhatsApp link
      const whatsappLink = 'https://wa.me/YOUR_NUMBER?text=Hallo%2C%20ich%20m%C3%B6chte%20die%20Checkliste%20erhalten'
      window.open(whatsappLink, '_blank')
    })
  }
})
</script>
</BaseLayout>
