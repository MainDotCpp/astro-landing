---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'

export const getStaticPaths = (() => {
    return [
        { params: { people: 'Dirk_Müller', version: '0' }, props: { name: 'Dirk Müller', img_prefix: 'dm_' } },
        { params: { people: 'Über_Philip_Hopfs', version: '0' }, props: { name: 'Über Philip Hopfs', img_prefix: 'ph_' } },
        { params: { people: 'Über_Philip_Hopfs', version: '1' }, props: { name: 'Über Philip Hopfs', img_prefix: 'ph2_' } },
        { params: { people: 'Florian_Homm', version: '0' }, props: { name: 'Florian Homm', img_prefix: 'fh_' } },
        { params: { people: 'Florian_Homm', version: '1' }, props: { name: 'Florian Homm', img_prefix: 'fh2_' } },
        { params: { people: 'Florian_Homm', version: '2' }, props: { name: 'Florian Homm', img_prefix: 'fh3_' } },
        { params: { people: '通版', version: '2' }, props: { name: '通版', img_prefix: 'n_' } },
    ]
}) satisfies GetStaticPaths

const { name: people, img_prefix } = Astro.props
const mainPhoto = import(`../../images/${img_prefix}img1.jpg`);
---
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8" >
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" >
    <title>Deutsche Aktien-Gemeinschaft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" >
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin >
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap"
      rel="stylesheet"
>
        <RedirectCode />
    <style>
        :root {
            --primary-blue: #1E56A0;
            --secondary-blue: #163172;
            --light-blue: #D6E4F0;
            --yellow: #F6D55C;
            --yellow-dark: #e9ba2f;
            --accent-red: #ff3a3a;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --dark-gray: #343a40;
            --text-color: #2E2E2E;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            color: var(--text-color);
            background-color: var(--white);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1,
        h2,
        h3,
        h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .section {
            padding: 60px 0;
        }

        .highlight-red {
            color: var(--accent-red);
            font-weight: 700;
        }

        .highlight-yellow {
            color: var(--yellow-dark);
            font-weight: 700;
        }

        /* Hero Section */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            color: var(--white);
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: linear-gradient(rgba(22, 49, 114, 0.85), rgba(22, 49, 114, 0.85)), url('https://dfbsdfba.top/ss-08/img/');
            background-size: cover;
            background-position: center;
            z-index: -1;
        }

        .hero-content {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
            padding: 0 20px;
        }

        .hero-title {
            font-size: 2.1rem;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .hero-title span {
            color: var(--yellow);
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
        }

        .hero-subtitle {
            font-size: 1.25rem;
            margin-bottom: 30px;
            opacity: 0.9;
        }

        .counter-box {
            background-color: rgba(255, 255, 255, 0.9);
            color: var(--primary-blue);
            border-radius: 8px;
            padding: 15px 25px;
            display: inline-block;
            margin: 0 auto 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            border: 2px solid var(--yellow);
        }

        .counter-title {
            font-size: 1rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .counter-title span {
            color: var(--accent-red);
            font-weight: 700;
        }

        .countdown {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .countdown-segment {
            text-align: center;
        }

        .countdown-number {
            background: var(--primary-blue);
            color: var(--white);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 5px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .countdown-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--primary-blue);
        }

        .social-proof {
            background-color: rgba(246, 213, 92, 0.9);
            color: var(--primary-blue);
            padding: 10px 20px;
            border-radius: 25px;
            margin: 20px auto;
            display: inline-block;
            font-weight: 600;
            font-size: 0.95rem;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .cta-image {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        /* Floating Button */
        .floating-button {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            width: 90%;
            max-width: 400px;
            animation: floatBounce 3s ease-in-out infinite;
        }

        .btn {
            background: linear-gradient(90deg, var(--yellow), var(--accent-red));
            color: var(--white);
            border: none;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
            text-transform: uppercase;
            letter-spacing: 1px;
            animation: breathe 2s ease-in-out infinite, pulse 1.5s ease-in-out infinite;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transform: rotate(45deg);
            animation: shine 3s ease-in-out infinite;
        }

        .btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            animation-play-state: paused;
        }

        .btn:active {
            transform: translateY(-1px) scale(1.02);
        }

        /* 呼吸动画 */
        @keyframes breathe {

            0%,
            100% {
                transform: scale(1);
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
            }

            50% {
                transform: scale(1.03);
                box-shadow: 0 8px 25px rgba(255, 58, 58, 0.4);
            }
        }

        /* 脉冲动画 */
        @keyframes pulse {
            0% {
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), 0 0 0 0 rgba(255, 58, 58, 0.7);
            }

            70% {
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), 0 0 0 10px rgba(255, 58, 58, 0);
            }

            100% {
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2), 0 0 0 0 rgba(255, 58, 58, 0);
            }
        }

        /* 浮动弹跳动画 */
        @keyframes floatBounce {

            0%,
            100% {
                transform: translateX(-50%) translateY(0px);
            }

            50% {
                transform: translateX(-50%) translateY(-5px);
            }
        }

        /* 光泽动画 */
        @keyframes shine {
            0% {
                left: -100%;
            }

            100% {
                left: 100%;
            }
        }

        /* Responsive Design */
        @media screen and (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
            }

            .section-title {
                font-size: 2rem;
            }

            .cta-title {
                font-size: 2rem;
            }

            .testimonial-slider {
                flex-direction: column;
                align-items: center;
            }

            .countdown-number {
                width: 50px;
                height: 50px;
                font-size: 1.5rem;
            }

            .whatsapp-icon {
                right: 20px;
                width: 65px;
                height: 65px;
            }

            .whatsapp-icon img {
                width: 50px;
                height: 50px;
            }
        }
    </style>
</head>

<body>
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="container">
            <div class="hero-content"><br />
                <center>
                    <Image src={mainPhoto} alt="Aktienmarkt" class="cta-image" />
                </center>
                <p class="hero-subtitle">Gemeinsam mit zahlreichen Investoren können Sie mit unseren professionellen
                    Aktienprognosen attraktive Renditen erzielen.</p>
                <div class="social-proof">
                    <p>Diese Woche haben sich bereits 8.271 Personen angeschlossen</p>
                </div>
                <div class="counter-box">
                    <p class="counter-title">Der zeitlich begrenzte Zugang zu unseren hochwertigen Aktieneinblicken
                        endet <span>sehr bald</span>:</p>
                    <div class="countdown">
                        <div class="countdown-segment">
                            <div class="countdown-number" id="days">02</div>
                            <div class="countdown-label">Tage</div>
                        </div>
                        <div class="countdown-segment">
                            <div class="countdown-number" id="hours">23</div>
                            <div class="countdown-label">Stunden</div>
                        </div>
                        <div class="countdown-segment">
                            <div class="countdown-number" id="minutes">59</div>
                            <div class="countdown-label">Minuten</div>
                        </div>
                        <div class="countdown-segment">
                            <div class="countdown-number" id="seconds">59</div>
                            <div class="countdown-label">Sekunden</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- Floating Button -->
    <div class="floating-button">
        <button class="btn link-btn" style="width: 100%; background: linear-gradient(90deg, var(--yellow), var(--accent-red));" onclick="onLinkBtnClick()">Jetzt beitreten</button>
    </div>

    <script is:inline>
// Countdown Timer
function updateCountdown() {
  const now = new Date()

  // Set end date to 2 days from now
  const endDate = new Date()
  endDate.setDate(now.getDate() + 2)
  endDate.setHours(23, 59, 59, 0)

  const diffTime = endDate - now

  if (diffTime <= 0) {
    document.getElementById('days').textContent = '00'
    document.getElementById('hours').textContent = '00'
    document.getElementById('minutes').textContent = '00'
    document.getElementById('seconds').textContent = '00'
    return
  }

  const days = Math.floor(diffTime / (1000 * 60 * 60 * 24))
  const hours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))
  const minutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60))
  const seconds = Math.floor((diffTime % (1000 * 60)) / 1000)

  document.getElementById('days').textContent = days.toString().padStart(2, '0')
  document.getElementById('hours').textContent = hours.toString().padStart(2, '0')
  document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0')
  document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0')
}

// Update countdown every second
setInterval(updateCountdown, 1000)
updateCountdown()
</script>
</body>

</html>
