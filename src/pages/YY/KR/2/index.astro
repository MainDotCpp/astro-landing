  <!-- 增强效果的脚本 -->
  <script is:inline>
// AOS 滚动动画初始化
document.addEventListener('DOMContentLoaded', () => {
  if (typeof AOS !== 'undefined') {
    AOS.init({
      duration: 800,
      easing: 'ease-out-cubic',
      once: true,
      offset: 100,
      delay: 0,
    })
  }

  // 实时统计数字更新（提高紧迫感）
  const viewerCountEl = document.getElementById('viewer-count')
  if (viewerCountEl) {
    const baseCount = 89
    const updateCount = () => {
      // 随机增加1-3人，模拟实时增长
      const increment = Math.floor(Math.random() * 3) + 1
      const newCount = baseCount + increment + Math.floor(Math.random() * 30)
      viewerCountEl.textContent = newCount

      // 添加闪烁效果
      viewerCountEl.style.animation = 'none'
      setTimeout(() => {
        viewerCountEl.style.animation = 'flash 0.3s ease'
      }, 10)
    }

    // 每5-8秒更新一次
    setInterval(updateCount, 5000 + Math.random() * 3000)
  }

  // 按钮点击增强反馈（只针对按钮本身，不干扰跳转）
  document.querySelectorAll('.cta-button').forEach((button) => {
    button.addEventListener('click', function (e) {
      // 创建点击波纹效果
      const ripple = document.createElement('span')
      ripple.style.cssText = `
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.6);
        transform: scale(0);
        animation: ripple-animation 0.6s ease-out;
        pointer-events: none;
        width: 100px;
        height: 100px;
        left: 50%;
        top: 50%;
        margin-left: -50px;
        margin-top: -50px;
        z-index: 1000;
      `

      const rect = this.getBoundingClientRect()
      const x = e.clientX - rect.left
      const y = e.clientY - rect.top

      ripple.style.left = `${x}px`
      ripple.style.top = `${y}px`
      ripple.style.marginLeft = '-50px'
      ripple.style.marginTop = '-50px'

      this.style.position = 'relative'
      this.appendChild(ripple)

      setTimeout(() => ripple.remove(), 600)
    })
  })

  // 确保浮动按钮始终可见
  const floatingCta = document.querySelector('.floating-cta')
  if (floatingCta) {
    floatingCta.style.opacity = '1'
    floatingCta.style.visibility = 'visible'
  }

  // CountUp 数字动画
  if (typeof CountUp !== 'undefined') {
    const animateCounters = () => {
      const counters = document.querySelectorAll('.count-up')
      counters.forEach((el) => {
        const target = el.getAttribute('data-count')
        const suffix = el.getAttribute('data-suffix') || ''
        const duration = Number.parseInt(el.getAttribute('data-duration') || '2000', 10)

        if (target && !el.classList.contains('counted')) {
          el.classList.add('counted')

          // 处理百分比和带+号的数字
          let endValue = target
          if (target.includes('%')) {
            endValue = Number.parseFloat(target)
          }
          else if (target.includes('+')) {
            endValue = Number.parseInt(target.replace(/,/g, '').replace('+', ''), 10)
          }
          else if (target.includes(',')) {
            endValue = Number.parseInt(target.replace(/,/g, ''), 10)
          }
          else if (target.includes('/')) {
            // 处理分数如 4.8/5
            endValue = target
          }
          else {
            endValue = Number.parseInt(target, 10) || Number.parseFloat(target)
          }

          if (typeof endValue === 'number') {
            const countUp = new CountUp(el, endValue, {
              duration: duration / 1000,
              separator: ',',
              suffix,
              useEasing: true,
              useGrouping: true,
            })
            countUp.start()
          }
          else {
            // 对于非数字（如年份、分数），直接显示
            el.textContent = target + suffix
          }
        }
      })
    }

    // 使用 Intersection Observer 触发动画
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounters()
          observer.unobserve(entry.target)
        }
      })
    }, { threshold: 0.3 })

    // 观察包含数字的元素
    const statSections = document.querySelectorAll('.hero-stats, .proof-grid')
    statSections.forEach(section => observer.observe(section))
  }

  // 卡片悬停效果增强
  const cards = document.querySelectorAll('.proof-card, .service-card')
  cards.forEach((card) => {
    card.addEventListener('mouseenter', function () {
      this.style.transform = 'translateY(-8px) scale(1.02)'
    })
    card.addEventListener('mouseleave', function () {
      this.style.transform = 'translateY(0) scale(1)'
    })
  })

  // 平滑滚动增强
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href')
      if (href !== '#' && href.startsWith('#')) {
        e.preventDefault()
        const target = document.querySelector(href)
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
          })
        }
      }
    })
  })
})
</script>
</KRBaseLayout>
