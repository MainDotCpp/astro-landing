---
import { Image } from 'astro:assets'
import { AlertCircle, Award, CheckCircle, GraduationCap, Star, Target, TrendingUp, Users } from 'lucide-astro'
import avatarImage from '@/assets/avatar/金美京_avatar.png'
import CtaButton from '@/components/CtaButton.astro'
import ScrollingBanner from '@/components/landing/ScrollingBanner.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'

// 金美京的个人信息
const name = '김미경'
const school = '서울대학교 경영학과'
const career = '전 대신증권 리서치센터 · 전 KB투자증권 애널리스트'
const description = '소재주 전문 애널리스트로서 15년간 반도체 소재 및 HBM 관련 기업을 집중 분석해왔습니다. AI 메모리·HBM 흐름을 정확히 포착하고, EUV 핵심 소재와 선단공정 기업을 선별하는 것으로 유명합니다.'
---

<KRBaseLayout
  title={`${name} 주식투자 전문가 - 소재주 분석 및 투자 전략`}
  description={`${name}과 함께하는 소재주 투자 분석. AI 메모리·HBM 흐름을 놓치지 않는 전문적인 종목 분석을 제공합니다.`}
  plugins={{
    aos: {},
    countup: {},
  }}
>
  <!-- Google Fonts Preconnect for Performance -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <!-- Stylized Korean Fonts Collection -->
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Jua&family=Noto+Sans+KR:wght@300;400;500;600;700;800;900&family=Nanum+Gothic:wght@400;700;800&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet" />
  <!-- Pretendard - Modern Korean Font (via CDN) -->
  <link slot="head" rel="stylesheet" as="style" crossorigin="anonymous" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  <!-- Inter - Modern English Font for Numbers -->
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    /* Base Reset and Typography */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* Stylized Typography System */
    :root {
      /* 正文字体 - 现代易读 */
      --font-primary: 'Pretendard', 'Nanum Gothic', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, 'Malgun Gothic', sans-serif;

      /* 标题字体 - 粗体有力 */
      --font-display: 'Black Han Sans', 'Nanum Gothic', 'Noto Sans KR', sans-serif;

      /* 副标题字体 - 圆润友好 */
      --font-subtitle: 'Jua', 'Pretendard', 'Noto Sans KR', sans-serif;

      /* 数字字体 - 现代等宽感 */
      --font-numbers: 'Inter', 'Pretendard', 'Noto Sans KR', monospace;

      /* 优雅字体 - 传统风格 */
      --font-elegant: 'Gowun Batang', 'Nanum Gothic', serif;
    }

    body {
      font-family: var(--font-primary);
      line-height: 1.7;
      color: #2c3e50;
      background: #f5f5f7;
      font-size: 16px;
      font-weight: 400;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    /* Hero Section - Mobile First */
    .hero {
      padding: 60px 0 50px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 30% 20%, rgba(255,215,0,0.08) 0%, transparent 50%),
                  radial-gradient(circle at 70% 80%, rgba(231,76,60,0.06) 0%, transparent 50%);
      z-index: 1;
    }

    .hero-content {
      max-width: 1000px;
      margin: 0 auto;
      position: relative;
      z-index: 10;
      padding: 0 16px;
      text-align: center;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(32px, 7vw, 56px);
      font-weight: 400; /* Black Han Sans is already bold */
      margin-bottom: 24px;
      line-height: 1.2;
      color: #ffffff;
      letter-spacing: 1px;
      text-shadow:
        0 2px 4px rgba(0,0,0,0.4),
        0 4px 8px rgba(0,0,0,0.3),
        0 8px 16px rgba(0,0,0,0.2);
      text-transform: none;
    }

    .hero h1 .highlight {
      font-family: var(--font-display);
      background: linear-gradient(135deg, #f1c40f 0%, #f39c12 50%, #e67e22 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 400;
      display: inline-block;
      letter-spacing: 2px;
      position: relative;
      filter: drop-shadow(0 2px 4px rgba(241,196,15,0.3));
    }

    .hero-subtitle {
      font-family: var(--font-subtitle);
      font-size: clamp(18px, 4.5vw, 24px);
      margin-bottom: 24px;
      opacity: 0.98;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      font-weight: 400;
      line-height: 1.7;
      color: rgba(255,255,255,0.98);
      letter-spacing: 0.3px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* Hero区域紧迫感提示 */
    .hero-urgency {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, rgba(241, 196, 15, 0.2) 0%, rgba(243, 156, 18, 0.15) 100%);
      backdrop-filter: blur(10px);
      padding: 12px 20px;
      border-radius: 50px;
      margin-bottom: 32px;
      border: 2px solid rgba(241, 196, 15, 0.4);
      box-shadow: 0 4px 15px rgba(241, 196, 15, 0.2);
      animation: hero-urgency-pulse 2s ease-in-out infinite;
    }

    .hero-urgency-icon {
      font-size: 24px;
      animation: hero-icon-spin 2s ease-in-out infinite;
    }

    .hero-urgency-text {
      font-size: clamp(14px, 3vw, 16px);
      font-weight: 600;
      color: #fff;
      text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    .hero-urgency-text strong {
      color: #f1c40f;
      font-weight: 800;
      font-family: var(--font-display);
    }

    @keyframes hero-urgency-pulse {
      0%, 100% {
        box-shadow: 0 4px 15px rgba(241, 196, 15, 0.2);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 6px 20px rgba(241, 196, 15, 0.4);
        transform: scale(1.02);
      }
    }

    @keyframes hero-icon-spin {
      0%, 100% {
        transform: rotate(0deg) scale(1);
      }
      25% {
        transform: rotate(-10deg) scale(1.1);
      }
      75% {
        transform: rotate(10deg) scale(1.1);
      }
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 32px;
      flex-wrap: wrap;
    }

    .hero-stat {
      text-align: center;
      opacity: 0.9;
    }

    .hero-stat-number {
      font-family: var(--font-numbers);
      display: block;
      font-size: clamp(24px, 5.5vw, 32px);
      font-weight: 900;
      color: #f1c40f;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
      text-shadow: 0 2px 8px rgba(241,196,15,0.4);
      font-variant-numeric: tabular-nums;
    }

    .hero-stat-label {
      font-size: clamp(11px, 3vw, 13px);
      color: rgba(255,255,255,0.8);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Stock Highlight Section */
    .stock-highlight {
      background: linear-gradient(135deg, rgba(241, 196, 15, 0.1) 0%, rgba(243, 156, 18, 0.05) 100%);
      border: 2px solid rgba(241, 196, 15, 0.3);
      border-radius: 20px;
      padding: 24px;
      margin: 32px 0;
      text-align: center;
    }

    .stock-highlight h3 {
      font-family: var(--font-display);
      font-size: clamp(24px, 5vw, 32px);
      color: #f1c40f;
      margin-bottom: 16px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    .stock-code {
      font-family: var(--font-numbers);
      font-size: clamp(28px, 6vw, 36px);
      font-weight: 900;
      color: #ffffff;
      background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
      padding: 12px 24px;
      border-radius: 12px;
      display: inline-block;
      margin: 12px 0;
      box-shadow: 0 4px 12px rgba(231, 76, 60, 0.4);
    }

    .stock-info {
      font-size: clamp(14px, 3.5vw, 16px);
      color: rgba(255,255,255,0.9);
      line-height: 1.8;
      margin-top: 16px;
    }

    /* Profile Section - Mobile First */
    .profile-section {
      padding: 50px 16px;
      background: #ffffff;
      position: relative;
      border-top: 1px solid rgba(0, 0, 0, 0.05);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .profile-container {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: flex-start;
      gap: 30px;
      flex-wrap: wrap;
      flex-direction: column;
    }

    .profile-image {
      flex-shrink: 0;
      margin: 0 auto;
    }

    .profile-avatar {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 4px solid #fff;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      object-fit: cover;
    }

    .profile-info {
      flex: 1;
      width: 100%;
      text-align: center;
    }

    .profile-info h2 {
      font-family: var(--font-display);
      font-size: clamp(32px, 7vw, 42px);
      color: #c0392b;
      margin-bottom: 12px;
      font-weight: 400;
      letter-spacing: 1px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
    }

    .profile-title {
      font-family: var(--font-subtitle);
      font-size: clamp(18px, 4.5vw, 22px);
      color: #34495e;
      margin-bottom: 24px;
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    .profile-details {
      background: #ffffff;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .detail-item {
      margin-bottom: 20px;
      padding: 16px 0;
      border-bottom: 2px solid #ecf0f1;
    }

    .detail-item:last-child {
      border-bottom: none;
    }

    .detail-label {
      font-family: var(--font-display);
      font-weight: 400;
      color: #c0392b;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 10px;
      font-size: clamp(18px, 4.5vw, 20px);
      letter-spacing: 0.5px;
    }

    .detail-text {
      font-family: var(--font-primary);
      color: #2c3e50;
      line-height: 1.75;
      font-size: clamp(14px, 3.5vw, 16px);
      font-weight: 500;
      text-align: left;
      letter-spacing: -0.1px;
    }

    /* Social Proof Section - Mobile First */
    .social-proof {
      padding: 50px 16px;
      background: #f5f5f7;
    }

    .section-title {
      font-family: var(--font-display);
      text-align: center;
      font-size: clamp(28px, 7vw, 40px);
      color: #c0392b;
      margin-bottom: 32px;
      font-weight: 400;
      position: relative;
      line-height: 1.2;
      letter-spacing: 1px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
    }

    .section-title::after {
      content: '';
      display: block;
      width: 80px;
      height: 3px;
      background: linear-gradient(45deg, #e74c3c, #f39c12);
      margin: 16px auto;
      border-radius: 2px;
    }

    .proof-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .proof-card {
      background: #ffffff;
      padding: 24px 16px;
      border-radius: 16px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.06);
      touch-action: manipulation;
      opacity: 0;
      transform: translateY(20px);
    }

    .proof-card[data-aos].aos-animate {
      opacity: 1;
      transform: translateY(0);
    }

    .proof-card:active {
      transform: scale(0.98);
    }

    .proof-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }

    .proof-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 12px;
      color: #e74c3c;
    }

    .proof-number {
      font-family: var(--font-numbers);
      font-size: clamp(32px, 7vw, 42px);
      font-weight: 900;
      color: #c0392b;
      margin-bottom: 8px;
      letter-spacing: 1px;
      font-variant-numeric: tabular-nums;
      text-shadow: 1px 1px 3px rgba(0,0,0,0.15);
    }

    .proof-label {
      font-size: clamp(12px, 3vw, 14px);
      color: #2c3e50;
      font-weight: 600;
      line-height: 1.4;
    }

    /* Service Section - Mobile First */
    .service-section {
      padding: 50px 16px;
      background: #f5f5f7;
    }

    .service-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .service-card {
      background: #ffffff;
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      border-left: 4px solid #e74c3c;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
      touch-action: manipulation;
      opacity: 0;
      transform: translateY(20px);
      border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .service-card[data-aos].aos-animate {
      opacity: 1;
      transform: translateY(0);
    }

    .service-card:active {
      transform: scale(0.98);
    }

    .service-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }

    .service-card h3 {
      font-family: var(--font-display);
      color: #c0392b;
      margin-bottom: 16px;
      font-size: clamp(20px, 5vw, 26px);
      font-weight: 400;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 0.5px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.08);
    }

    .service-card p {
      color: #2c3e50;
      line-height: 1.7;
      font-size: clamp(14px, 3.5vw, 16px);
      font-weight: 500;
    }

    .service-list {
      list-style: none;
      margin-top: 16px;
    }

    .service-list li {
      padding: 8px 0;
      color: #2c3e50;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: clamp(13px, 3vw, 15px);
      line-height: 1.6;
    }

    .service-list li::before {
      content: '✓';
      color: #27ae60;
      font-weight: bold;
      font-size: 18px;
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* CTA Section - Mobile First */
    .cta-section {
      padding: 50px 16px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      text-align: center;
    }

    .cta-content {
      max-width: 800px;
      margin: 0 auto;
    }

    .cta-content h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 7vw, 40px);
      margin-bottom: 20px;
      font-weight: 400;
      line-height: 1.2;
      letter-spacing: 1px;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .cta-content p {
      font-size: clamp(15px, 3.5vw, 18px);
      margin-bottom: 32px;
      opacity: 0.95;
      line-height: 1.7;
    }

    /* 紧迫感元素 */
    .urgency-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      padding: 12px 20px;
      border-radius: 50px;
      margin-bottom: 24px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      animation: pulse-glow 2s ease-in-out infinite;
    }

    .urgency-icon {
      font-size: 20px;
      animation: bounce 1s ease-in-out infinite;
    }

    .urgency-text {
      font-size: clamp(14px, 3vw, 16px);
      font-weight: 600;
      color: #fff;
      text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    .urgency-text #viewer-count {
      color: #f1c40f;
      font-weight: 800;
      font-family: var(--font-numbers);
    }

    /* CTA包装器 */
    .cta-wrapper {
      position: relative;
      display: inline-block;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
    }

    .cta-badge {
      position: absolute;
      top: -12px;
      right: -12px;
      background: linear-gradient(135deg, #f1c40f 0%, #f39c12 100%);
      color: #2c3e50;
      font-size: clamp(11px, 2.5vw, 13px);
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 20px;
      box-shadow: 0 4px 12px rgba(241, 196, 15, 0.5);
      z-index: 10;
      animation: badge-bounce 2s ease-in-out infinite;
      white-space: nowrap;
    }

    /* 浮动CTA增强 */
    .floating-cta-wrapper {
      position: relative;
      width: 100%;
    }

    .pulse-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      height: 100%;
      border: 3px solid rgba(0, 198, 81, 0.6);
      border-radius: 9999px;
      animation: pulse-ring-animation 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      pointer-events: none;
      z-index: 1;
    }

    .pulse-ring-delay-1 {
      animation-delay: 1s;
      border-color: rgba(0, 198, 81, 0.4);
    }

    /* 动画 */
    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
      }
      50% {
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.6);
      }
    }

    @keyframes bounce {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-5px);
      }
    }

    @keyframes badge-bounce {
      0%, 100% {
        transform: translateY(0) scale(1);
      }
      50% {
        transform: translateY(-3px) scale(1.05);
      }
    }

    @keyframes pulse-ring-animation {
      0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) scale(1.3);
        opacity: 0;
      }
    }

    @keyframes flash {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.7;
        transform: scale(1.1);
      }
    }

    @keyframes ripple-animation {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }

    /* Footer Section */
    .footer-section {
      background: #2c3e50;
      color: rgba(255, 255, 255, 0.9);
      padding: 50px 16px 30px;
      margin-top: 0;
      border-top: 3px solid rgba(241, 196, 15, 0.3);
    }

    .footer-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .footer-content {
      display: flex;
      flex-direction: column;
      gap: 40px;
      margin-bottom: 40px;
      padding-bottom: 40px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer-brand {
      text-align: center;
    }

    .footer-title {
      font-family: var(--font-display);
      font-size: clamp(24px, 5vw, 28px);
      font-weight: 400;
      color: #ffffff;
      margin-bottom: 16px;
      letter-spacing: 1px;
    }

    .footer-description {
      font-size: clamp(14px, 3vw, 16px);
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.7;
      max-width: 600px;
      margin: 0 auto;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .footer-column {
      text-align: center;
    }

    .footer-heading {
      font-family: var(--font-display);
      font-size: clamp(16px, 3.5vw, 18px);
      font-weight: 400;
      color: #f1c40f;
      margin-bottom: 20px;
      letter-spacing: 0.5px;
    }

    .footer-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-list li {
      font-size: clamp(13px, 3vw, 14px);
      color: rgba(255, 255, 255, 0.75);
      margin-bottom: 12px;
      line-height: 1.6;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 30px;
    }

    .footer-copyright {
      margin-bottom: 20px;
    }

    .footer-copyright p {
