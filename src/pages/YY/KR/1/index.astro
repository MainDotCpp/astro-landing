    /* Floating CTA - Mobile Optimized */
    .floating-cta {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      width: calc(100% - 32px);
      max-width: 500px;
      padding: 0 16px;
      pointer-events: none;
      animation: float-up 0.5s ease-out;
      opacity: 1 !important;
      visibility: visible !important;
    }

    @keyframes float-up {
      from {
        opacity: 0;
        transform: translateX(-50%) translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
    }

    .floating-cta :global(*) {
      pointer-events: auto;
      min-height: 48px;
      touch-action: manipulation;
    }

    /* 修复浮动按钮图标被挤扁和文字垂直居中的问题 */
    .floating-cta :global(.cta-button) {
      min-width: 0;
      gap: 0.75rem;
      align-items: center !important;
      justify-content: center !important;
      display: flex !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      height: auto !important;
      min-height: 48px;
      position: relative;
      z-index: 10;
      pointer-events: auto !important;
    }

    .floating-cta :global(.cta-icon) {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
      max-width: 32px !important;
      max-height: 32px !important;
      flex-shrink: 0 !important;
      object-fit: contain !important;
      aspect-ratio: 1 / 1 !important;
      align-self: center !important;
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .floating-cta :global(.cta-text) {
      flex: 1 1 auto;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      line-height: 1 !important;
      margin: 0 !important;
      padding: 0 !important;
      height: auto !important;
      vertical-align: middle !important;
    }

    /* 移动端优化 */
    @media (max-width: 480px) {
      .floating-cta :global(.cta-icon) {
        width: 28px !important;
        height: 28px !important;
        min-width: 28px !important;
        min-height: 28px !important;
        max-width: 28px !important;
        max-height: 28px !important;
      }

      .floating-cta :global(.cta-text) {
        font-size: 0.9em;
        white-space: normal;
        line-height: 1.2 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }

      .floating-cta :global(.cta-button) {
        align-items: center !important;
        min-height: 44px;
      }
    }

    /* Mobile Touch Optimizations */
    @media (max-width: 767px) {
      button, a, .proof-card, .service-card, .testimonial-card {
        min-height: 44px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(0,0,0,0.1);
      }

