---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import lineIcon from '@/assets/line-icon.png'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = (() => {
  return [
    { params: { people: '杜金龍', version: '0' }, props: { name: '杜金龍', img_prefix: 'djl_' } },
  ]
}) satisfies GetStaticPaths

const { img_prefix, name: people } = Astro.props
// 使用靜態導入來避免動態導入問題
const header = await import(`../../../images/${img_prefix}header.png`)
const img1 = await import(`../../../images/${img_prefix}img.png`);
---

<BaseLayout title={people} description={people} lang="zh-TW">
  <main
    class="flex flex-col gap-8 items-center justify-center max-w-2xl mx-auto"
  >
    <Image src={header.default} alt={people} />
    <div class="text-xl px-4">
      免費加入{people}的LINE，只要傳送「領取」訊息，就能知道明天會上漲的股票。此外，還能獲得每週預期300%獲利的優質股票資訊。
    </div>
    <h3 class="text-xl font-bold text-center px-4">
      立即參加，獲得優質股票！
    </h3>
    <a
      class="link-btn cta-line animate-breathe"
      href="javascript:void(0)"
      onclick="onLinkBtnClick()"
    >
      <Image class="cta-line__icon" src={lineIcon} alt="LINE" width={80} height={80} loading="eager" />
      <span class="cta-line__text">加入好友 免費領取</span>
    </a>
    <h3 class="text-xl font-bold text-center px-4">
      加入LINE並傳送「領取」訊息<br />
      就能免費獲得最新的股票上漲<br />
      新聞資訊！
    </h3>
    <Image src={img1.default} alt="圖片1" />
    <a
      class="link-btn cta-line animate-breathe"
      href="javascript:void(0)"
      onclick="onLinkBtnClick()"
    >
      <Image class="cta-line__icon" src={lineIcon} alt="LINE" width={80} height={80} loading="eager" />
      <span class="cta-line__text">加入好友 免費領取</span>
    </a>
    <h3 class="text-xl font-bold text-center mb-10 px-4">
      隱私權政策
    </h3>
  </main>
  <style>
    @keyframes breathe {
      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.1);
        opacity: 0.8;
      }
    }

    .animate-breathe {
      animation: breathe 1s ease-in-out infinite;
    }

    /* 文字 CTA：沿用 LINE 品牌綠，取代原本印死文案的按鈕圖 */
    .cta-line {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      width: calc(100% - 2rem);
      max-width: 30rem;
      padding: 1rem 1.25rem;
      border-radius: 9999px;
      background: #06c755;
      color: #fff;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      box-shadow: 0 6px 16px rgba(6, 199, 85, 0.35);
      cursor: pointer;
    }

    .cta-line:active {
      transform: scale(0.98);
    }

    /* LINE 官方圖標：圖標本身的綠底與按鈕同色，視覺上只留白色對話泡 */
    .cta-line__icon {
      flex: none;
      width: 1.75em;
      height: 1.75em;
      border-radius: 0.35em;
    }

    @media (min-width: 480px) {
      .cta-line {
        font-size: 1.4rem;
      }
    }

    /* 繁體中文字體設定 */
    body,
    html {
      font-family:
        "Noto Sans TC",
        "PingFang TC",
        "Microsoft JhengHei",
        "微軟正黑體",
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Roboto",
        "Oxygen",
        "Ubuntu",
        "Cantarell",
        "Helvetica Neue",
        sans-serif;
      font-feature-settings: "liga" 1, "kern" 1; /* 繁體中文字符優化 */
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* 確保所有文本元素都使用繁體中文字體 */
    main,
    div,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p,
    span {
      font-family:
        "Noto Sans TC",
        "PingFang TC",
        "Microsoft JhengHei",
        "微軟正黑體",
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Roboto",
        "Oxygen",
        "Ubuntu",
        "Cantarell",
        "Helvetica Neue",
        sans-serif;
      font-feature-settings: "liga" 1, "kern" 1;
    }

    /* 繁體中文文本的行高優化 */
    .text-xl {
      line-height: 1.8;
      letter-spacing: 0.02em;
    }

    /* 加強繁體中文字體權重 */
    .font-bold {
      font-weight: 700;
    }
  </style>
</BaseLayout>
