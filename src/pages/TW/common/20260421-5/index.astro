---
import BaseLayout from '@/layouts/BaseLayout.astro'
import lineIcon from './static/line.png'
---

<BaseLayout title="【獨家】主力倒貨前的最後逃命波！" description="馬上加入LINE，免費領取明日必漲飆股清單" lang="zh-TW">
  <main class="scam-landing">

    <!-- 頂部閃爍跑馬燈 -->
    <div class="marquee-alert">
      <div class="marquee-text">
        ⚠️ 警告！警告！台股主力準備大洗盤！最後 30 個免費領取避險名單名額！ ⚠️
      </div>
    </div>

    <!-- 聳動的橫幅與標題 -->
    <header class="header-banner">
      <div class="badge-urgent blink-bg">最後機會</div>
      <h1 class="main-title">
        <span class="text-white">【完全免費】</span><br/>
        千萬級操盤手<span class="text-yellow">喝醉酒漏口風散布的</span><br/>
        <span class="bg-red text-white p-1">3檔必買飆股！</span>
      </h1>
      <p class="subtitle">
        這份名單明天開盤前就會被強勢拉抬，<br/>
        <span class="text-red font-bold">加LINE立刻免費拿，保證不收費！</span>
      </p>
    </header>

    <!-- 恐嚇與引誘區塊 -->
    <section class="fear-section">
      <h2>還在傻傻的抱著不會動的股票？</h2>
      <p class="fear-text">
        你知道為什麼你總是買在最高點、賣在最低點嗎？<br/>
        因為你永遠都比主力慢了一大步！
      </p>

      <div class="highlight-frame">
        <p class="big-hook">只要加了老師的LINE：</p>
        <ul class="hook-list">
          <li>✅ 每天早上準時拿到 <span class="bg-yellow text-red font-bold">漲停預測股</span></li>
          <li>✅ 老師親自帶你進出，跟著買就對了</li>
          <li>✅ 群組裡的大家每天都在曬獲利單！</li>
        </ul>
      </div>

      <!-- 插入假聊天紀錄截圖 -->
      <div class="chat-proof-box">
        <p class="proof-label">👇 內部群組真實對話流出 👇</p>
        <img src={(await import('./static/chat-new.png')).default.src} alt="群組對話紀錄" class="proof-img border-red-thick" />
      </div>

      <div class="bank-proof mt-4">
        <div class="proof-title">👇 這是今天早上剛入帳的真實獲利 👇</div>
        <img src={(await import('./static/fake-profit-new.png')).default.src} alt="真實獲利截圖" class="proof-img border-red-thick" />
      </div>
    </section>

    <!-- 終極 CTA 區塊 -->
    <section class="action-section">
      <div class="countdown-box">
        <p>免費名額即將關閉</p>
        <div class="timer">剩餘 <span class="text-yellow" id="mins">09</span> 分 <span class="text-yellow" id="secs">59</span> 秒</div>
      </div>

      <a href="#" class="line-btn link-btn pulse-shadow">
        <img src={lineIcon.src} alt="LINE" class="line-logo" />
        <div class="btn-text">
          <span class="btn-top">👉 點這裡立刻加LINE 👈</span>
          <span class="btn-bottom">領取明日飆股名單</span>
        </div>
      </a>

      <p class="guarantee text-red font-bold animate-bounce-text">
        ！！！100% 免費，加進去立刻拿！！！
      </p>
    </section>

    <!-- 假 Yahoo 新聞留言區 -->
    <section class="news-comments">
      <div class="news-header">新聞網上熱烈討論...</div>

      <div class="comment">
        <div class="user-info">
          <strong class="user-name">陳X雄 (苗栗)</strong>
          <span class="time">1小時前</span>
        </div>
        <div class="user-text">
          我這個月靠老師給的股票，把房貸都繳清了！真的不用錢！大家趕快加！
        </div>
      </div>

      <div class="comment">
        <div class="user-info">
          <strong class="user-name">林X珠 (高雄)</strong>
          <span class="time">3小時前</span>
        </div>
        <div class="user-text">
          一開始我也是半信半疑，結果昨天買的那檔今天真的漲停板... 老師真的是活菩薩下來救我們的！😭
        </div>
      </div>

      <div class="comment">
        <div class="user-info">
          <strong class="user-name">張X明 (桃園)</strong>
          <span class="time">5小時前</span>
        </div>
        <div class="user-text">
          還好我昨天有加！賺死了！這名單太準了吧！
        </div>
      </div>
    </section>

    <footer class="footer">
      版權所有，盜用必究。投資理財一定有風險。
    </footer>

  </main>

  <style>
    /* 長輩愛看的配色：黑底、紅字、黃字、白字，極度刺眼高對比 */
    body {
      background-color: #222;
      font-family: "微軟正黑體", Arial, sans-serif;
      margin: 0;
      padding: 0;
      color: #333;
    }

    .scam-landing {
      max-width: 600px;
      margin: 0 auto;
      background-color: #fff;
      min-height: 100vh;
      padding-bottom: 20px;
    }

    .text-red { color: #ff0000; }
    .text-yellow { color: #ffff00; }
    .text-white { color: #ffffff; }
    .font-bold { font-weight: bold; }
    .bg-red { background-color: #ff0000; }
    .bg-yellow { background-color: #ffff00; }
    .p-1 { padding: 4px 8px; }

    /* 頂部跑馬燈 */
    .marquee-alert {
      background-color: #ff0000;
      color: #ffff00;
      font-weight: bold;
      font-size: 20px;
      padding: 10px 0;
      overflow: hidden;
      white-space: nowrap;
      border-bottom: 4px solid #ffff00;
    }

    .marquee-text {
      display: inline-block;
      animation: marquee 10s linear infinite;
    }

    @keyframes marquee {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }

    /* 標題區塊 */
    .header-banner {
      background-color: #000;
      color: #fff;
      text-align: center;
      padding: 30px 15px;
      border-bottom: 5px solid #ff0000;
    }

    .badge-urgent {
      display: inline-block;
      padding: 5px 15px;
      color: #fff;
      font-size: 22px;
      font-weight: bold;
      border-radius: 5px;
      border: 2px solid #fff;
      margin-bottom: 15px;
    }

    @keyframes blink-bg {
      0%, 100% { background-color: #ff0000; }
      50% { background-color: #000; }
    }
    .blink-bg {
      animation: blink-bg 0.5s infinite;
    }

    .main-title {
      font-size: 30px;
      margin: 0 0 15px 0;
      line-height: 1.5;
    }

    .subtitle {
      background-color: #fff;
      color: #000;
      font-size: 20px;
      font-weight: bold;
      padding: 15px;
      margin: 0;
      border-radius: 5px;
    }

    /* 內文區塊 */
    .fear-section {
      padding: 20px 15px;
      font-size: 22px;
      line-height: 1.5;
    }

    .fear-section h2 {
      color: #0000ff;
      font-size: 26px;
      margin: 0 0 15px 0;
      text-align: center;
    }

    .fear-text {
      margin-bottom: 20px;
    }

    .highlight-frame {
      border: 4px dashed #ff0000;
      padding: 15px;
      background-color: #ffffe0;
      margin-bottom: 25px;
    }

    .big-hook {
      font-size: 24px;
      font-weight: bold;
      color: #ff0000;
      margin: 0 0 10px 0;
    }

    .hook-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .hook-list li {
      margin-bottom: 15px;
      font-weight: bold;
    }

    /* 假的網銀匯款紀錄 */
    .bank-proof {
      background-color: #f5f5f5;
      padding: 15px;
      text-align: center;
    }

    .proof-title {
      font-size: 20px;
      font-weight: bold;
      color: #d32f2f;
      margin-bottom: 10px;
    }

    .border-red-thick {
      border: 3px solid #d32f2f;
    }

    .fake-bank-img {
      background-color: #fff;
      padding: 15px;
      font-family: monospace;
      font-size: 22px;
    }

    .bank-row {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px dotted #ccc;
      padding: 8px 0;
    }
    .bank-row:last-child {
      border-bottom: none;
    }

    /* CTA 區塊 */
    .action-section {
      padding: 30px 15px;
      text-align: center;
      background-color: #000;
      color: #fff;
    }

    .countdown-box {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 20px;
    }

    .countdown-box p {
      margin: 0 0 5px 0;
      color: #ff0000;
    }

    .timer {
      font-size: 36px;
      background-color: #333;
      display: inline-block;
      padding: 10px 20px;
      border-radius: 10px;
      border: 2px solid #ffff00;
    }

    /* LINE 按鈕 */
    .line-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #06C755;
      color: #fff;
      text-decoration: none;
      padding: 15px;
      border-radius: 15px;
      border: 5px solid #fff;
      margin: 0 auto;
      width: 95%;
      box-sizing: border-box;
      box-shadow: 0 10px 0 #048c3b;
      transition: transform 0.1s;
    }

    .line-btn:active {
      transform: translateY(10px);
      box-shadow: 0 0 0 #048c3b;
    }

    @keyframes pulse-shadow {
      0% { box-shadow: 0 0 0 0 rgba(6, 199, 85, 0.7), 0 10px 0 #048c3b; }
      50% { box-shadow: 0 0 0 15px rgba(6, 199, 85, 0), 0 10px 0 #048c3b; }
      100% { box-shadow: 0 0 0 0 rgba(6, 199, 85, 0), 0 10px 0 #048c3b; }
    }
    .pulse-shadow {
      animation: pulse-shadow 1.5s infinite;
    }

    .line-logo {
      width: 60px;
      height: 60px;
      margin-right: 10px;
      border-radius: 10px;
      background-color: #fff;
      flex-shrink: 0;
    }

    .btn-text {
      text-align: left;
    }

    .btn-top {
      display: block;
      font-size: 18px;
      font-weight: bold;
      color: #ffff00;
      margin-bottom: 5px;
      text-shadow: 1px 1px 1px #000;
    }

    .btn-bottom {
      display: block;
      font-size: 26px;
      font-weight: 900;
      text-shadow: 1px 1px 2px #000;
    }

    .guarantee {
      font-size: 20px;
      margin-top: 20px;
    }

    @keyframes bounce-text {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
    .animate-bounce-text {
      display: inline-block;
      animation: bounce-text 0.5s infinite;
    }

    /* 假新聞留言區 */
    .news-comments {
      padding: 20px 15px;
      background-color: #f9f9f9;
      border-top: 2px solid #ccc;
    }

    .news-header {
      font-size: 22px;
      font-weight: bold;
      color: #c00;
      margin-bottom: 15px;
      border-bottom: 2px solid #c00;
      padding-bottom: 5px;
    }

    .comment {
      background-color: #fff;
      border: 1px solid #ddd;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 5px;
    }

    .user-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .user-name {
      color: #1e56a0;
      font-size: 18px;
    }

    .time {
      color: #999;
      font-size: 14px;
    }

    .user-text {
      font-size: 18px;
      line-height: 1.4;
    }

    /* 頁尾 */
    .footer {
      text-align: center;
      padding: 20px;
      background-color: #ddd;
      color: #666;
      font-size: 14px;
    }

    @media (max-width: 480px) {
      .main-title { font-size: 26px; }
      .fear-section { font-size: 20px; }
      .btn-bottom { font-size: 22px; }
    }
  </style>

  <script>
    // 綁定跳轉邏輯
    document.querySelectorAll('.link-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (typeof window.mixinJump === 'function') {
          window.mixinJump();
        }
      });
    });

    // 倒數計時器
    let totalSeconds = 9 * 60 + 59;

    function updateTimer() {
      if (totalSeconds <= 0) return;
      totalSeconds--;

      const m = Math.floor(totalSeconds / 60);
      const s = totalSeconds % 60;

      const minEl = document.getElementById('mins');
      const secEl = document.getElementById('secs');

      if(minEl) minEl.innerText = m < 10 ? '0' + m : m.toString();
      if(secEl) secEl.innerText = s < 10 ? '0' + s : s.toString();
    }

    setInterval(updateTimer, 1000);
  </script>
</BaseLayout>