---
import BaseLayout from '@/layouts/BaseLayout.astro'
import lineIcon from './static/line.png'
---

<BaseLayout title="免費領取飆股名單" description="立即加入LINE免費領取最新飆股" lang="zh-TW">
  <main class="landing-container">

    <!-- 頂部緊迫性橫幅 -->
    <div class="alert-bar blink-bg">
      ⚠ 警告：名額即將額滿，本網頁隨時可能關閉！
    </div>

    <!-- 主視覺區塊 -->
    <header class="header-section">
      <h1 class="main-title">
        <span class="highlight-yellow">【完全免費】</span><br/>
        2026 最新飆股大公開！
      </h1>

      <div class="subtitle-box">
        加 LINE 立即領取：<br/>
        <span class="text-red animate-flash">🔥 明天開盤準備漲停的 3 檔爆發股 🔥</span>
      </div>
    </header>

    <!-- 直白的內文區 -->
    <section class="content-section">
      <p class="big-text">別再當股市裡的韭菜！</p>
      <p class="normal-text">
        我們不教複雜的理論，不說花言巧語，<br/>
        <strong>我們只報最直接的明牌！</strong>
      </p>

      <div class="proof-box">
        <ul>
          <li>✅ 昨天進場，今天直接拉<span class="text-red font-bold">半根停板</span></li>
          <li>✅ 內部主力籌碼提前佈局</li>
          <li>✅ 散戶也能輕鬆跟上的無腦操作</li>
        </ul>
      </div>

      <p class="urgency-text">
        本週已有 <span class="text-red font-bold">8,521</span> 人成功領取<br/>
        並跟上這波暴賺行情！
      </p>
    </section>

    <!-- 強烈引導按鈕與倒數計時 -->
    <section class="cta-section">
      <div class="countdown-wrapper">
        <p class="countdown-title">免費名額最後倒數</p>
        <div class="timer">
          <div class="time-box">00</div><span>天</span>
          <div class="time-box">00</div><span>時</span>
          <div class="time-box" id="min">14</div><span>分</span>
          <div class="time-box" id="sec">59</div><span>秒</span>
        </div>
      </div>

      <!-- 巨大的 LINE 按鈕 -->
      <a href="#" class="line-btn link-btn animate-breathe" onclick="onLinkBtnClick()">
        <img src={lineIcon.src} alt="LINE" class="line-icon" style="border-radius: 10px;" />
        <div class="btn-text">
          <span class="click-hint">👉 點擊這裡加入 👈</span>
          <span class="main-action">免費領取飆股名單</span>
        </div>
      </a>

      <p class="privacy-text">加入後只需傳送「領取」即可收到，完全免費。</p>
    </section>

    <!-- 俗套的免責與頁尾 -->
    <footer class="footer-section">
      <p>※ 投資有風險，入市須謹慎</p>
      <p>本活動為免費資訊分享，不收取任何費用</p>
    </footer>

  </main>

  <style>
    /* 基礎設定 */
    body {
      background-color: #f5f5f5;
      font-family: "Noto Sans TC", "微軟正黑體", sans-serif;
      margin: 0;
      padding: 0;
    }

    .landing-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      min-height: 100vh;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
      padding-bottom: 50px;
    }

    .text-red { color: #e53935; }
    .font-bold { font-weight: bold; }

    /* 頂部橫幅 */
    .alert-bar {
      background-color: #d32f2f;
      color: #ffffff;
      text-align: center;
      padding: 12px 10px;
      font-size: 16px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    /* 標題與視覺 */
    .header-section {
      text-align: center;
      padding: 30px 15px;
      background: linear-gradient(180deg, #fffde7 0%, #ffffff 100%);
      border-bottom: 3px solid #ffeb3b;
    }

    .main-title {
      font-size: 32px;
      font-weight: 900;
      color: #212121;
      line-height: 1.4;
      margin: 0 0 20px 0;
    }

    .highlight-yellow {
      background-color: #ffeb3b;
      color: #d32f2f;
      padding: 5px 10px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 5px;
    }

    .subtitle-box {
      font-size: 22px;
      font-weight: bold;
      color: #1565c0;
      line-height: 1.6;
      border: 2px dashed #e53935;
      padding: 15px;
      border-radius: 8px;
      background-color: #fff;
    }

    /* 內文區塊 */
    .content-section {
      padding: 30px 20px;
      text-align: center;
    }

    .big-text {
      font-size: 28px;
      color: #d32f2f;
      font-weight: 900;
      margin-bottom: 15px;
    }

    .normal-text {
      font-size: 20px;
      color: #424242;
      line-height: 1.6;
      margin-bottom: 25px;
    }

    .proof-box {
      background-color: #f1f8e9;
      border: 1px solid #c5e1a5;
      border-radius: 8px;
      padding: 20px;
      text-align: left;
      margin-bottom: 25px;
    }

    .proof-box ul {
      list-style-type: none;
      padding: 0;
      margin: 0;
    }

    .proof-box li {
      font-size: 18px;
      font-weight: bold;
      color: #2e7d32;
      margin-bottom: 12px;
      line-height: 1.4;
    }
    .proof-box li:last-child { margin-bottom: 0; }

    .urgency-text {
      font-size: 18px;
      color: #616161;
      background-color: #fff3e0;
      padding: 15px;
      border-radius: 5px;
    }

    /* CTA 區塊 */
    .cta-section {
      padding: 0 20px 40px 20px;
      text-align: center;
    }

    .countdown-wrapper {
      background-color: #212121;
      color: #fff;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: inline-block;
      width: 100%;
      box-sizing: border-box;
    }

    .countdown-title {
      margin: 0 0 10px 0;
      font-size: 18px;
      color: #ffeb3b;
      font-weight: bold;
    }

    .timer {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 5px;
    }

    .time-box {
      background-color: #e53935;
      color: white;
      font-size: 24px;
      font-weight: bold;
      padding: 5px 10px;
      border-radius: 4px;
      min-width: 35px;
    }

    /* LINE 按鈕 */
    .line-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #06C755;
      color: #ffffff;
      text-decoration: none;
      padding: 15px 20px;
      border-radius: 50px;
      box-shadow: 0 6px 15px rgba(6, 199, 85, 0.4);
      margin-bottom: 15px;
      position: relative;
    }

    .line-icon {
      width: 45px;
      height: 45px;
      margin-right: 15px;
    }

    .btn-text {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .click-hint {
      font-size: 14px;
      color: #e8f5e9;
      margin-bottom: 2px;
    }

    .main-action {
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .privacy-text {
      font-size: 14px;
      color: #757575;
      margin-top: 15px;
    }

    /* 頁尾 */
    .footer-section {
      border-top: 1px solid #e0e0e0;
      padding: 20px;
      text-align: center;
      font-size: 13px;
      color: #9e9e9e;
    }

    .footer-section p { margin: 5px 0; }

    /* 動畫配置 */
    @keyframes blink-bg {
      0% { background-color: #d32f2f; }
      50% { background-color: #b71c1c; }
      100% { background-color: #d32f2f; }
    }
    .blink-bg { animation: blink-bg 1s infinite; }

    @keyframes flash {
      0% { opacity: 1; text-shadow: 0 0 5px #ffcccc; }
      50% { opacity: 0.6; text-shadow: none; }
      100% { opacity: 1; text-shadow: 0 0 5px #ffcccc; }
    }
    .animate-flash { animation: flash 1.5s infinite; }

    @keyframes breathe {
      0% { transform: scale(1); box-shadow: 0 5px 15px rgba(6,199,85,0.4); }
      50% { transform: scale(1.05); box-shadow: 0 15px 25px rgba(6,199,85,0.6); }
      100% { transform: scale(1); box-shadow: 0 5px 15px rgba(6,199,85,0.4); }
    }
    .animate-breathe { animation: breathe 1.2s infinite ease-in-out; }

    /* RWD 適應 */
    @media (max-width: 480px) {
      .main-title { font-size: 28px; }
      .subtitle-box { font-size: 20px; }
      .big-text { font-size: 24px; }
      .main-action { font-size: 20px; }
    }
  </style>

  <script>
    // 綁定跳轉邏輯
    document.querySelectorAll('.link-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (typeof window.onLinkBtnClick === 'function') {
          window.onLinkBtnClick();
        }
      });
    });

    // 倒數計時邏輯 (15分鐘)
    let totalSeconds = 15 * 60;

    function updateTimer() {
      if (totalSeconds <= 0) return; // 停在 0
      totalSeconds--;

      const m = Math.floor(totalSeconds / 60);
      const s = totalSeconds % 60;

      const minEl = document.getElementById('min');
      const secEl = document.getElementById('sec');

      if (minEl) minEl.innerText = m < 10 ? '0' + m : m.toString();
      if (secEl) secEl.innerText = s < 10 ? '0' + s : s.toString();
    }

    setInterval(updateTimer, 1000);
  </script>
</BaseLayout>