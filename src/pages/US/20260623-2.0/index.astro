            </p>
          </div>

          <!-- 卡片 2 -->
          <div class="terminal-card px-5 py-5 mb-3">
            <div class="flex items-center gap-2 mb-2">
              <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
