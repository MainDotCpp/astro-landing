            </div>
          </div>
        </section>

        <!-- ── 谁适合加入 section ── -->
        <section class="mb-10">
          <h2 class="mono text-[10px] tracking-[0.25em] text-textMuted uppercase mb-4">// WHO_IS_THIS_FOR</h2>
          <div class="space-y-2">
            {[
              '在美持仓美股/ETF，想真正看懂K线结构',
              '对期权感兴趣但从没系统学过',
              '平时工作忙，需要浓缩的每日盘面摘要',
              '想加入真正在认真做功课的华人圈子',
            ].map((item) => (
              <div class="flex items-start gap-3 text-sm text-textSecondary">
                <span class="glow-green font-bold mt-0.5 shrink-0">✓</span>
