        仅供教育与资讯参考，不构成任何投资建议。投资有风险，入市需谨慎。<br/>
        历史分析不代表未来表现。© 2026 技术投研社群
      </footer>

    </main>

    <!-- ── Sticky 底部 CTA ── -->
    <div class="sticky-cta">
      <a
       
        onclick="onLinkBtnClick()"
        class="link-btn cta-glow btn-neon flex items-center justify-center gap-2 text-sm w-full max-w-[600px] mx-auto py-3.5 rounded-lg cursor-pointer"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <span>免费加入技术投研社群</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    </div>

    <!-- ── 手写 canvas 数据网格背景 ── -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById('grid-canvas')
        if (!canvas) return
        const ctx = canvas.getContext('2d')

        const COLS = 40
        const CHARS = '0123456789ABCDEF><+-=%$'
        const NEON_GREEN = 'rgba(22,255,122,'
        const NEON_CYAN  = 'rgba(0,212,255,'

        let W, H, cellW, cellH, drops = []

        function resize() {
          W = canvas.width  = window.innerWidth
          H = canvas.height = window.innerHeight
          cellW = Math.floor(W / COLS)
          cellH = 18
          drops = Array.from({ length: COLS }, () => Math.random() * -50 | 0)
        }

        function draw() {
          // 半透明刷黑,形成拖尾
          ctx.fillStyle = 'rgba(10,14,18,0.18)'
          ctx.fillRect(0, 0, W, H)

          ctx.font = `500 12px "JetBrains Mono", monospace`

          for (let i = 0; i < COLS; i++) {
            const char = CHARS[Math.random() * CHARS.length | 0]
            const y    = drops[i] * cellH
            const isCyan = i % 5 === 0

            // 头部字符更亮
            const alpha = 0.9
            ctx.fillStyle = isCyan
              ? NEON_CYAN  + alpha + ')'
              : NEON_GREEN + alpha + ')'
            ctx.fillText(char, i * cellW + 2, y)

            // 拖尾暗色
            if (drops[i] > 2) {
              const tailChar = CHARS[Math.random() * CHARS.length | 0]
              ctx.fillStyle = isCyan
                ? NEON_CYAN  + '0.25)'
                : NEON_GREEN + '0.2)'
              ctx.fillText(tailChar, i * cellW + 2, y - cellH)
            }

            if (y > H && Math.random() > 0.975) {
              drops[i] = 0
            }
            drops[i] += 0.4
          }

          // 横向网格线(极淡)
          ctx.strokeStyle = 'rgba(22,255,122,0.04)'
          ctx.lineWidth = 1
          for (let row = 0; row * cellH < H; row++) {
            ctx.beginPath()
            ctx.moveTo(0, row * cellH)
            ctx.lineTo(W, row * cellH)
            ctx.stroke()
          }
        }

        resize()
        window.addEventListener('resize', resize)
        let gridTimer = setInterval(draw, 55)
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            clearInterval(gridTimer)
          } else {
            gridTimer = setInterval(draw, 55)
          }
        })
      })()
    </script>

    <!-- ── Hero K线图 canvas ── -->
    <script is:inline>
      (function () {
        const canvas = document.getElementById('hero-canvas')
        if (!canvas) return
        const ctx = canvas.getContext('2d')

        let W, H

        function resize() {
          const wrap = canvas.parentElement
          W = canvas.width  = wrap.clientWidth
          H = canvas.height = wrap.clientHeight
        }

        // 生成随机 K 线数据
        function makeCandles(n) {
          const candles = []
          let price = 180 + Math.random() * 40
          for (let i = 0; i < n; i++) {
            const open  = price
            const move  = (Math.random() - 0.46) * 8
            const close = open + move
            const hi    = Math.max(open, close) + Math.random() * 4
            const lo    = Math.min(open, close) - Math.random() * 4
            candles.push({ open, close, hi, lo })
            price = close
          }
          return candles
        }

        let candles = makeCandles(80)
        let tick = 0

        function draw() {
          ctx.clearRect(0, 0, W, H)

          // 网格线
          ctx.strokeStyle = 'rgba(22,255,122,0.06)'
          ctx.lineWidth = 1
          for (let i = 1; i < 6; i++) {
            ctx.beginPath()
            ctx.moveTo(0, H * i / 6)
            ctx.lineTo(W, H * i / 6)
            ctx.stroke()
          }
          for (let i = 1; i < 10; i++) {
            ctx.beginPath()
            ctx.moveTo(W * i / 10, 0)
            ctx.lineTo(W * i / 10, H)
            ctx.stroke()
          }

          // K 线
          const n = candles.length
          const candleW = Math.floor(W / n)
          const pad = 10

          const prices = candles.flatMap(c => [c.hi, c.lo])
          const minP = Math.min(...prices)
          const maxP = Math.max(...prices)
          const range = maxP - minP || 1

          const toY = p => pad + (1 - (p - minP) / range) * (H - pad * 2)

          // 移动平均线（青色）
          const ma = 10
          ctx.beginPath()
          ctx.strokeStyle = 'rgba(0,212,255,0.55)'
          ctx.lineWidth = 1.5
          for (let i = ma; i < n; i++) {
            const avg = candles.slice(i - ma, i).reduce((s, c) => s + (c.open + c.close) / 2, 0) / ma
            const x = i * candleW + candleW / 2
            if (i === ma) ctx.moveTo(x, toY(avg))
            else ctx.lineTo(x, toY(avg))
          }
          ctx.stroke()

          // 绘制 K 线主体
          for (let i = 0; i < n; i++) {
            const c = candles[i]
            const x = i * candleW
            const bullish = c.close >= c.open
            const color = bullish ? 'rgba(22,255,122,' : 'rgba(255,80,80,'
            const bodyTop    = toY(Math.max(c.open, c.close))
            const bodyBottom = toY(Math.min(c.open, c.close))
            const bodyH = Math.max(bodyBottom - bodyTop, 1)

            // 影线
            ctx.strokeStyle = color + '0.7)'
            ctx.lineWidth = 1
            ctx.beginPath()
            ctx.moveTo(x + candleW / 2, toY(c.hi))
            ctx.lineTo(x + candleW / 2, toY(c.lo))
            ctx.stroke()

            // 实体
            ctx.fillStyle = color + (bullish ? '0.75)' : '0.6)')
            ctx.fillRect(x + 1, bodyTop, candleW - 2, bodyH)

            // 发光描边
            if (bullish) {
              ctx.strokeStyle = 'rgba(22,255,122,0.9)'
              ctx.lineWidth = 0.5
              ctx.strokeRect(x + 1, bodyTop, candleW - 2, bodyH)
            }
          }

          // 最新价格线（霓虹绿虚线）
          const last = candles[n - 1]
          const lastY = toY(last.close)
          ctx.setLineDash([4, 4])
          ctx.strokeStyle = 'rgba(22,255,122,0.6)'
          ctx.lineWidth = 1
          ctx.beginPath()
          ctx.moveTo(0, lastY)
          ctx.lineTo(W, lastY)
          ctx.stroke()
          ctx.setLineDash([])

          tick++
        }

        resize()
        window.addEventListener('resize', () => { resize(); candles = makeCandles(80) })

        // 每隔2秒新增一根 K 线，形成实时感
        let candleTimer = setInterval(() => {
          const last = candles[candles.length - 1]
          const move = (Math.random() - 0.46) * 6
          const open  = last.close
          const close = open + move
          candles.push({
            open, close,
            hi: Math.max(open, close) + Math.random() * 3,
            lo: Math.min(open, close) - Math.random() * 3,
          })
          if (candles.length > 80) candles.shift()
        }, 2000)

        let drawTimer = setInterval(draw, 50)
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) {
            clearInterval(candleTimer)
            clearInterval(drawTimer)
          } else {
            candleTimer = setInterval(() => {
              const last = candles[candles.length - 1]
              const move = (Math.random() - 0.46) * 6
              const open  = last.close
              const close = open + move
              candles.push({
                open, close,
                hi: Math.max(open, close) + Math.random() * 3,
                lo: Math.min(open, close) - Math.random() * 3,
              })
              if (candles.length > 80) candles.shift()
            }, 2000)
            drawTimer = setInterval(draw, 50)
          }
        })
      })()
    </script>
  </body>
