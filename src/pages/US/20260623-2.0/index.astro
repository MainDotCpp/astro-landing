        <!-- ── 我们提供什么 section ── -->
        <section class="mb-10">
          <h2 class="mono text-[10px] tracking-[0.25em] text-textMuted uppercase mb-4">// WHAT_WE_PROVIDE</h2>

          <!-- 卡片 1 -->
          <div class="terminal-card px-5 py-5 mb-3">
            <div class="flex items-center gap-2 mb-2">
              <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16ff7a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
              <span class="font-semibold text-sm text-textPrimary">每天开盘前，先看一遍结构</span>
