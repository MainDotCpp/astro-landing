---
import RedirectCode from '@/components/RedirectCode.astro'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>每日大盘技术面解读 + 期权学习 — 免费技术投研社群</title>
    <meta name="description" content="不靠感觉下单，看懂盘面结构再决策。每天5分钟，跟资深投研团队读一次大盘技术面、学期权基础逻辑。免费加入华人技术投研社群。" />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              base: '#0a0e12',
              baseSoft: '#111820',
              baseCard: '#131c24',
              neonGreen: '#16ff7a',
              neonGreenDim: '#0ecf5e',
              neonCyan: '#00d4ff',
              neonCyanDim: '#00a8cc',
              textPrimary: '#e8f0fe',
              textSecondary: '#7a9ab8',
              textMuted: '#445566',
              border: '#1e3040',
            },
            fontFamily: {
              mono: ['"JetBrains Mono"', '"Roboto Mono"', 'Consolas', 'monospace'],
              sans: ['"Noto Sans SC"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet" />

    <style>
      * { box-sizing: border-box; }

      body {
        font-family: 'Noto Sans SC', system-ui, sans-serif;
        background: #0a0e12;
        color: #e8f0fe;
        overflow-x: hidden;
      }

      /* ── canvas 背景 ── */
      #grid-canvas {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.35;
      }

      /* ── 内容层 ── */
      .content-layer {
        position: relative;
        z-index: 1;
      }

      /* ── 霓虹文字发光 ── */
      .glow-green {
        color: #16ff7a;
        text-shadow: 0 0 16px rgba(22, 255, 122, 0.6), 0 0 40px rgba(22, 255, 122, 0.2);
      }
      .glow-cyan {
        color: #00d4ff;
        text-shadow: 0 0 12px rgba(0, 212, 255, 0.5), 0 0 30px rgba(0, 212, 255, 0.2);
      }

      /* ── 终端卡片 ── */
      .terminal-card {
        background: #131c24;
        border: 1px solid #1e3040;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
      }
      .terminal-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #16ff7a40, transparent);
      }

      /* ── 等宽数字 ── */
      .mono {
        font-family: 'JetBrains Mono', 'Roboto Mono', monospace;
      }

      /* ── 终端 eyebrow 闪烁光标 ── */
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
      .cursor-blink {
        display: inline-block;
        width: 8px; height: 1.1em;
        background: #16ff7a;
        vertical-align: text-bottom;
        animation: blink 1.1s step-end infinite;
        margin-left: 2px;
      }

      /* ── CTA 按钮发光 ── */
      @keyframes ctaPulse {
        0%, 100% { box-shadow: 0 0 20px rgba(22, 255, 122, 0.4), 0 4px 32px rgba(22, 255, 122, 0.15); }
        50%       { box-shadow: 0 0 32px rgba(22, 255, 122, 0.65), 0 4px 48px rgba(22, 255, 122, 0.25); }
      }
      .cta-glow { animation: ctaPulse 2.2s ease-in-out infinite; }

      /* ── 在线活跃点 ── */
      @keyframes activeDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.5; transform: scale(0.7); }
      }
      .active-dot {
        display: inline-block;
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #16ff7a;
        animation: activeDot 1.8s ease-in-out infinite;
        box-shadow: 0 0 6px #16ff7a;
      }

      /* ── 数据条动画 ── */
      @keyframes barFill {
        from { width: 0; }
        to   { width: var(--bar-w); }
      }
      .bar-fill { animation: barFill 1.2s cubic-bezier(.4,0,.2,1) forwards; }

      /* ── hero canvas 区域 ── */
      .hero-canvas-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        overflow: hidden;
        background: #050810;
      }
      @media (min-width: 600px) {
        .hero-canvas-wrap { aspect-ratio: 21/9; }
      }
      #hero-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .hero-canvas-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(10,14,18,0.1) 0%, rgba(10,14,18,0.85) 100%);
        pointer-events: none;
      }

      /* ── sticky CTA bar ── */
      .sticky-cta {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        z-index: 100;
        background: linear-gradient(to top, #0a0e12 80%, transparent);
        padding: 12px 16px 20px;
      }

      /* ── FAQ 折叠 ── */
      details summary { cursor: pointer; list-style: none; }
      details summary::-webkit-details-marker { display: none; }
      details[open] .faq-arrow { transform: rotate(90deg); }
      .faq-arrow { transition: transform 0.2s; }

      /* ── 扫描线氛围 ── */
      .scan-line {
        background: linear-gradient(
          to bottom,
          transparent 0%,
          rgba(22, 255, 122, 0.03) 50%,
          transparent 100%
        );
        background-size: 100% 4px;
        pointer-events: none;
      }

      /* ── CTA 按钮颜色（覆盖 Tailwind 自定义色失效问题）── */
      .btn-neon {
        background: #16ff7a;
        color: #000;
        font-weight: 800;
        border: none;
        transition: background 0.15s;
      }
      .btn-neon:hover, .btn-neon:active { background: #0ecf5e; }

      /* ── stats grid 强制3列 ── */
      .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }

      /* ── 活跃度进度条 ── */
      .bar-track {
        flex: 1;
        background: #1e3040;
        border-radius: 999px;
        height: 6px;
        overflow: hidden;
      }
      .bar-green  { background: #16ff7a; height: 100%; border-radius: 999px; animation: barFill 1.2s cubic-bezier(.4,0,.2,1) forwards; }
      .bar-cyan   { background: #00d4ff; height: 100%; border-radius: 999px; animation: barFill 1.2s cubic-bezier(.4,0,.2,1) forwards; }
      .bar-muted  { background: #445566; height: 100%; border-radius: 999px; animation: barFill 1.2s cubic-bezier(.4,0,.2,1) forwards; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">

    <!-- 数据网格 canvas 背景 -->
    <canvas id="grid-canvas"></canvas>

    <main class="content-layer flex-1 flex flex-col pb-[80px]">

      <!-- ── HERO canvas ── -->
      <div class="hero-canvas-wrap">
        <canvas id="hero-canvas"></canvas>
        <div class="hero-canvas-overlay"></div>
      </div>

      <!-- ── 主内容区 ── -->
      <div class="w-full max-w-[600px] mx-auto px-4 md:px-6">

