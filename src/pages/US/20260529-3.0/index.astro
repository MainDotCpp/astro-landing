---
import RedirectCode from '@/components/RedirectCode.astro'
import heroClass from './assets/images/hero-classroom.png'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Learn the High-Probability Stock Strategy — Free Daily Classes</title>
    <meta name="description" content="Thousands of young professionals are learning a high-probability stock trading strategy — risk management, technical analysis, discipline. Join the free community. Live online classes every day." />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              ink: '#0A2540',
              inkSoft: '#5B6B7B',
              emerald: '#0F5132',
              gold: '#B8860B',
              cta: '#16A34A',
              ctaDark: '#15803D',
            },
            fontFamily: {
              display: ['Spectral', 'Georgia', 'serif'],
              sans: ['"Public Sans"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spectral:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
      body {
        font-family: 'Public Sans', system-ui, sans-serif;
        background: #FFFFFF;
        color: #0A2540;
      }

      @keyframes ctaBounce {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-3px); }
      }
      .bounce { animation: ctaBounce 1.8s ease-in-out infinite; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">

    <main class="flex-1 flex flex-col justify-center w-full max-w-[600px] mx-auto">

      <!-- IMAGE -->
      <img src={heroClass.src} alt="Instructor presenting a high-probability stock trading strategy to a class" class="w-full block" />

      <!-- ONE BLOCK OF TEXT -->
      <section class="w-full px-6 py-10 md:py-12 text-center">
        <p class="text-xs uppercase tracking-[0.22em] text-gold font-700 mb-5">
          Free Community · Live Classes Every Day
        </p>

        <h1 class="font-display font-800 text-ink text-[2.1rem] md:text-[2.6rem] leading-[1.12] mb-6">
          Turn a Small Stake Into <span class="text-emerald">Real Returns</span>
        </h1>

        <p class="text-base md:text-lg text-inkSoft leading-relaxed mb-9">
          <span class="font-700 text-ink">Big returns from a small investment</span> — it sounds
          out of reach, but thousands of young professionals are already learning the same
          high-probability stock trading strategy: risk management, technical analysis and the
          discipline behind real gains. I'm not selling a dream. I'm teaching the system, live, every day.
        </p>

        <div class="flex flex-col items-center gap-3.5">
          <a
            onclick="onLinkBtnClick()"
            class="link-btn inline-flex items-center justify-center gap-3 bg-cta hover:bg-ctaDark text-white font-800 text-lg px-10 py-[18px] rounded-xl shadow-xl shadow-cta/30 bounce cursor-pointer transition-colors whitespace-nowrap w-full sm:w-auto"
          >
            <i class="fab fa-whatsapp text-2xl shrink-0"></i>
            <span>Join the Free Community &nbsp;→</span>
          </a>
          <p class="text-xs text-inkSoft">Free to join · No experience needed · Leave anytime</p>
        </div>
      </section>

    </main>

    <footer class="py-5 text-center text-inkSoft text-[11px] px-4">
      © 2026 · Investing Education Community · Educational content only, not financial advice.
    </footer>

  </body>
</html>
