---
// Ultra-Premium Fintech Landing Page - Stock Intelligence
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'StockIntel Premium - Profit in Any Market'
const description = 'Access exclusive stock recommendations even in down markets. Verify yesterday\'s picks (GPPL, Rico Auto) and unlock today\'s target (Ajamna Auto) on WhatsApp.'
---

<BaseLayout title={title} description={description} lang="en">
  <Fragment slot="head">
    <!-- Google Fonts: Playfair Display for Serifs, Inter for Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --color-gold: #D4AF37;
        --color-gold-light: #F4D03F;
        --color-slate-950: #020617;
        --color-slate-900: #0f172a;
        --color-slate-800: #1e293b;
      }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--color-slate-950);
        color: #f8fafc;
        overflow-x: hidden;
      }

      h1, h2, h3, .serif {
        font-family: 'Playfair Display', serif;
      }

      .text-gold-gradient {
        background: linear-gradient(135deg, #D4AF37 0%, #F4D03F 50%, #D4AF37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .glass-card {
        background: rgba(30, 41, 59, 0.4);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 1.5rem;
      }

      .btn-glow {
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
      }

      .btn-glow::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.2) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .btn-glow:hover::after {
        opacity: 1;
      }

      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }

      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </Fragment>

  <div class="relative min-h-screen">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-6 px-4">
      <div class="max-w-7xl w-full flex justify-between items-center px-6 py-4 glass-card shadow-2xl">
        <div class="flex items-center gap-2">
          <div class="w-10 h-10 bg-gradient-to-tr from-amber-500 to-yellow-200 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight serif italic">StockIntel</span>
        </div>
        <button onclick="window.onLinkBtnClick()" class="hidden md:flex items-center gap-2 bg-white text-slate-950 px-6 py-2.5 rounded-full font-bold hover:bg-amber-400 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          Join Now
        </button>
      </div>
    </nav>

    <!-- Background Decoration -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-amber-500/10 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[10%] right-[-10%] w-[50%] h-[50%] bg-blue-500/5 rounded-full blur-[150px]"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative z-10 pt-48 pb-20 px-4 flex flex-col items-center text-center">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card border-amber-500/30 text-amber-200 text-sm font-medium animate-fade-in">
          <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
          Exclusive Market Intelligence
        </div>

        <h1 class="text-6xl md:text-8xl font-bold leading-tight tracking-tight text-white reveal">
          Profit Even in a <br />
          <span class="text-gold-gradient italic italic">Down Market</span>
        </h1>

        <p class="text-xl md:text-2xl text-slate-400 max-w-2xl mx-auto leading-relaxed reveal" style="transition-delay: 200ms;">
          Friends, in this market, you only need one thing. Join our inner circle on WhatsApp and verify the results yourself.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-8 reveal" style="transition-delay: 400ms;">
          <button onclick="window.onLinkBtnClick()" class="btn-primary w-full sm:w-auto px-10 py-5 bg-gradient-to-r from-amber-500 to-yellow-300 text-slate-950 font-black text-xl rounded-2xl shadow-[0_20px_50px_rgba(245,158,11,0.3)] hover:scale-105 active:scale-95 transition-all cursor-pointer">
            Get WhatsApp Link
          </button>
          <p class="text-slate-500 text-sm italic">Unlock today's target instantly</p>
        </div>
      </div>
    </section>

    <!-- Performance Section -->
    <section class="relative z-10 py-24 px-4 bg-slate-900/50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16 space-y-4">
          <h2 class="text-4xl md:text-5xl font-bold reveal">Yesterday's <span class="text-gold-gradient italic">Validation</span></h2>
          <p class="text-slate-400 max-w-xl mx-auto reveal" style="transition-delay: 100ms;">I gave the judgment. I told you why. See the results for yourself.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-20">
          <!-- Card 1 -->
          <div class="glass-card p-8 group hover:border-amber-500/50 transition-all reveal" style="transition-delay: 200ms;">
            <div class="flex justify-between items-start mb-6">
              <div>
                <span class="text-amber-500 text-sm font-bold tracking-widest uppercase">Verified Recommendation</span>
                <h3 class="text-4xl font-bold mt-1 tracking-tight">GPPL</h3>
              </div>
              <div class="text-emerald-400 text-right">
                <span class="text-4xl font-black">+14.2%</span>
                <p class="text-xs uppercase tracking-tighter opacity-60">Single Day Gain</p>
              </div>
            </div>
            <p class="text-slate-400 leading-relaxed mb-6">
              "Check on WhatsApp. I told you above the personal link, and GPPL was recommended yesterday."
            </p>
            <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 w-[75%] shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="glass-card p-8 group hover:border-amber-500/50 transition-all reveal" style="transition-delay: 300ms;">
            <div class="flex justify-between items-start mb-6">
              <div>
                <span class="text-amber-500 text-sm font-bold tracking-widest uppercase">Verified Recommendation</span>
                <h3 class="text-4xl font-bold mt-1 tracking-tight">Rico Auto</h3>
              </div>
              <div class="text-emerald-400 text-right">
                <span class="text-4xl font-black">+9.8%</span>
                <p class="text-xs uppercase tracking-tighter opacity-60">Market Outperformance</p>
              </div>
            </div>
            <p class="text-slate-400 leading-relaxed mb-6">
              "And Rico Auto came in front of you. There will be an example that was said."
            </p>
            <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 w-[60%] shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
            </div>
          </div>
        </div>

        <!-- Today's Target -->
        <div class="max-w-4xl mx-auto glass-card border-amber-500/40 p-1 bg-gradient-to-br from-amber-500/20 to-transparent reveal" style="transition-delay: 400ms;">
          <div class="bg-slate-950 rounded-[1.4rem] p-10 md:p-16 text-center space-y-8 relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4">
              <span class="bg-amber-500 text-slate-950 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-tighter">Hot Target</span>
            </div>

            <div class="space-y-4">
              <h2 class="text-3xl md:text-5xl font-bold">Today's Selection</h2>
              <div class="relative inline-block group">
                 <h3 class="text-6xl md:text-8xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-slate-200 to-slate-700 blur-[8px] group-hover:blur-[10px] transition-all">
                  XXXXX AUTO
                </h3>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-2xl font-bold bg-amber-500 text-slate-950 px-6 py-2 rounded-xl rotate-[-5deg] shadow-2xl">Ajamna Auto</span>
                </div>
              </div>
            </div>

            <p class="text-xl text-slate-400 italic serif">
              "Join that one and see a big one. I have given the judgment. Why I have given it, how did I give it?"
            </p>

            <button onclick="window.onLinkBtnClick()" class="w-full max-w-md py-6 rounded-2xl bg-white text-slate-950 text-2xl font-black shadow-2xl hover:bg-amber-400 transition-all cursor-pointer">
              Reveal Full Analysis
            </button>

            <p class="text-slate-500 text-sm">Join by 3:00 PM for the full trailer and reasoning.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Authority Section -->
    <section class="py-32 px-4 relative">
      <div class="max-w-4xl mx-auto text-center space-y-12">
        <div class="space-y-4">
          <h2 class="text-4xl md:text-6xl font-bold reveal">Expert <span class="italic serif text-amber-500">Judgment</span></h2>
          <p class="text-2xl text-slate-300 leading-relaxed reveal" style="transition-delay: 100ms;">
            "Judgment, I have given. Why I have given it, how did I give it? Movement. Join."
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 reveal" style="transition-delay: 200ms;">
          <div class="space-y-1">
            <div class="text-3xl font-bold text-white">94%</div>
            <div class="text-slate-500 text-sm uppercase">Accuracy</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-bold text-white">125+</div>
            <div class="text-slate-500 text-sm uppercase">Picks</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-bold text-white">15k</div>
            <div class="text-slate-500 text-sm uppercase">Traders</div>
          </div>
          <div class="space-y-1">
            <div class="text-3xl font-bold text-white">2.5x</div>
            <div class="text-slate-500 text-sm uppercase">ROI Avg</div>
          </div>
        </div>

        <div class="pt-12 reveal" style="transition-delay: 300ms;">
          <button onclick="window.onLinkBtnClick()" class="inline-flex items-center gap-4 text-2xl font-bold text-amber-400 hover:text-white transition-colors cursor-pointer border-b-2 border-amber-500/30 pb-2">
            Experience the Movement
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-20 border-t border-slate-800/50 bg-slate-950">
      <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-10">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-amber-500 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <span class="text-xl font-bold serif italic">StockIntel</span>
          </div>
          <p class="text-slate-500 text-sm max-w-xs">
            Premium market intelligence for the sophisticated trader. Join the movement today.
          </p>
        </div>

        <div class="flex gap-8 text-slate-400 text-sm">
          <a href="#" class="hover:text-amber-400 transition-colors">Risk Disclosure</a>
          <a href="#" class="hover:text-amber-400 transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-amber-400 transition-colors">Terms of Service</a>
        </div>

        <div class="flex items-center gap-4">
          <div class="flex -space-x-3">
            {[1, 2, 3, 4].map(i => (
              <div class="w-10 h-10 rounded-full border-2 border-slate-950 bg-slate-800 flex items-center justify-center overflow-hidden">
                <img src={`https://i.pravatar.cc/100?u=${i}`} alt="user" />
              </div>
            ))}
          </div>
          <p class="text-slate-400 text-sm"><span class="text-white font-bold">4.9/5</span> from 2k+ traders</p>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline>
// Intersection Observer for reveal animations
const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      entry.target.classList.add('active')
    }
  })
}, { threshold: 0.1 })

document.querySelectorAll('.reveal').forEach(el => observer.observe(el))
</script>
</BaseLayout>
