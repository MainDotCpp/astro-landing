---
import RedirectCode from '@/components/RedirectCode.astro'
import heroPerson from './assets/images/hero-person.png'
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A Stock Is About to Soar — Get the Stock Code Free</title>
    <meta name="description" content="A US-listed stock currently priced at $2.96 is expected to climb. Get the stock code free and follow the daily breakdown with our community." />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              navy: '#0B2A5B',
              ink: '#0A1F44',
              flame: '#FB4516',
              blue: '#1E6BFF',
              blueDark: '#0A4FD0',
              mute: '#5A6B86',
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: linear-gradient(180deg, #FFFFFF 0%, #EEF4FF 100%);
        background-attachment: fixed;
        color: #0A1F44;
      }

      @keyframes ctaPulse {
        0%, 100% { transform: translateY(0); box-shadow: 0 14px 30px -8px rgba(30, 107, 255, 0.55); }
        50%      { transform: translateY(-3px); box-shadow: 0 20px 38px -8px rgba(30, 107, 255, 0.65); }
      }
      .cta-pulse { animation: ctaPulse 1.9s ease-in-out infinite; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">

    <main class="flex-1">

      <!-- ===== SCREEN 1 — HERO ===== -->
      <section class="max-w-6xl mx-auto w-full px-6 pt-10 md:pt-16 pb-12 grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-center">

        <!-- copy -->
        <div class="order-2 lg:order-1 text-center lg:text-left">
          <p class="inline-flex items-center gap-2 text-[11px] md:text-xs uppercase tracking-[0.18em] text-blue font-700 mb-5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
            Market Signal · Released Today
          </p>

          <h1 class="font-800 text-navy text-[2rem] leading-[1.1] md:text-[2.9rem] md:leading-[1.05] mb-4">
            A US Stock Under $5 Just Flashed a Rare Buy Signal
          </h1>

          <p class="text-mute text-[15px] md:text-lg leading-relaxed mb-7 max-w-[480px] mx-auto lg:mx-0">
            The name stays private — but the <span class="font-700 text-navy">stock code goes out free</span>
            inside our group today. Here's where our analysts see it heading.
          </p>

          <!-- price predictions (credible range) -->
          <div class="space-y-3 mb-6 max-w-[440px] mx-auto lg:mx-0">
            <div class="flex items-center gap-3 justify-center lg:justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">Trading now</span>
              <span class="font-800 text-navy text-xl md:text-2xl">$2.96</span>
            </div>
            <div class="flex items-center gap-3 justify-center lg:justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">30-day target</span>
              <span class="font-800 text-flame text-xl md:text-2xl">$7.40</span>
              <span class="text-xs font-700 text-flame bg-flame/10 rounded-full px-2 py-0.5">+150%</span>
            </div>
            <div class="flex items-center gap-3 justify-center lg:justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">12-week target</span>
              <span class="font-800 text-flame text-xl md:text-2xl">$14.80</span>
              <span class="text-xs font-700 text-flame bg-flame/10 rounded-full px-2 py-0.5">+400%</span>
            </div>
          </div>

          <!-- social proof -->
          <p class="flex items-center gap-2 justify-center lg:justify-start text-sm text-navy font-600 mb-5">
            <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse shrink-0"></span>
            <span><span class="font-800">9,200+</span> US investors inside · <span class="font-800">274</span> joined today</span>
          </p>

          <div class="flex flex-col items-center lg:items-start gap-3">
            <a
              onclick="onLinkBtnClick()"
              class="link-btn cta-pulse inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-blue to-blueDark text-white font-800 text-sm md:text-lg tracking-wide px-6 md:px-9 py-4 md:py-[18px] rounded-full cursor-pointer text-center leading-snug whitespace-normal sm:whitespace-nowrap w-full sm:w-auto"
            >
              <span>GET THE STOCK CODE FREE</span>
            </a>
            <p class="text-xs text-mute">Code released to the group today only · Free · No payment · Leave anytime</p>
          </div>
        </div>

        <!-- visual -->
        <div class="order-1 lg:order-2">
          <img src={heroPerson.src} alt="An analyst studying a rising stock chart on screen" class="w-full h-auto block select-none pointer-events-none rounded-2xl" />
        </div>
      </section>

      <!-- ===== SCREEN 1.5 — WHY / TRUST ===== -->
      <section class="bg-white/70 border-t border-blue/10">
        <div class="max-w-5xl mx-auto w-full px-6 py-10 md:py-12">
          <div class="grid lg:grid-cols-2 gap-9 lg:gap-14 items-center">

            <!-- who we are -->
            <div class="order-1">
              <div class="space-y-5">
                <p class="text-[11px] uppercase tracking-[0.18em] text-mute font-700">Who's behind the picks</p>

                <div class="flex gap-4 items-start">
                  <div class="w-9 h-9 rounded-full bg-blue/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  </div>
                  <div>
                    <p class="font-700 text-navy text-[15px] leading-snug">Ex–Morgan Stanley quant researchers + Google &amp; Meta engineers</p>
                    <p class="text-mute text-sm mt-1">Building AI-driven stock research since 2015.</p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-9 h-9 rounded-full bg-blue/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  </div>
                  <div>
                    <p class="font-700 text-navy text-[15px] leading-snug">24/7 AI engine tracking every US-listed company</p>
                    <p class="text-mute text-sm mt-1">Options flow, dark pool trades, institutional positions, SEC filings — all in real time.</p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-9 h-9 rounded-full bg-flame/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-flame" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                  </div>
                  <div>
                    <p class="font-700 text-navy text-[15px] leading-snug">"10 Must-Buy Stocks" published two years running</p>
                    <p class="text-mute text-sm mt-1"><span class="font-700 text-navy">5 stocks delivered 2–3× gains</span>, 8 out of 10 finished positive. Jan 2025 &amp; Jan 2026 — on the record, before the bell.</p>
                  </div>
                </div>

                <div class="flex gap-4 items-start">
                  <div class="w-9 h-9 rounded-full bg-blue/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </div>
                  <div>
                    <p class="font-700 text-navy text-[15px] leading-snug">Turned down eight-figure PE funding</p>
                    <p class="text-mute text-sm mt-1">Record-high subscribers. Staying independent — not controlled by outside capital.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- stats + cta -->
            <div class="order-2">
              <p class="text-center lg:text-left text-[11px] uppercase tracking-[0.18em] text-mute font-700 mb-6">Why investors aren't waiting</p>

              <div class="grid grid-cols-3 gap-4 text-center lg:text-left mb-8">
                <div>
                  <div class="font-800 text-navy text-2xl md:text-3xl mb-1 leading-none">9,200<span class="text-flame">+</span></div>
                  <p class="text-mute text-xs">Active members</p>
                </div>
                <div>
                  <div class="font-800 text-flame text-2xl md:text-3xl mb-1 leading-none">+64%</div>
                  <p class="text-mute text-xs">Avg · last 3 picks</p>
                </div>
                <div>
                  <div class="font-800 text-navy text-2xl md:text-3xl mb-1 leading-none">Today</div>
                  <p class="text-mute text-xs">Code release</p>
                </div>
              </div>

              <div class="flex flex-col items-center lg:items-start gap-3">
                <a
                  onclick="onLinkBtnClick()"
                  class="link-btn inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-blue to-blueDark text-white font-800 text-sm md:text-lg tracking-wide px-6 md:px-9 py-4 rounded-full cursor-pointer text-center leading-snug whitespace-normal sm:whitespace-nowrap w-full sm:w-auto shadow-lg shadow-blue/30 hover:opacity-95 transition-opacity"
                >
                  <span>GET THE CODE BEFORE IT'S GONE</span>
                </a>
                <p class="text-xs text-mute">Limited to today's session · Free · Leave anytime</p>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <footer class="py-5 text-center text-mute text-[11px] px-4">
      © 2026 · US Stock Insights · Educational content only, not financial advice. Capital is at risk.
    </footer>

  </body>
</html>
