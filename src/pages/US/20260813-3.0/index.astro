---
import { getImage } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'
import phoneSrc from './images/hero-portfolio.png'

const POR_W = 560
const phone = await getImage({ src: phoneSrc, format: 'webp', width: POR_W, quality: 80 })
const phoneH = Math.round(POR_W * phoneSrc.height / phoneSrc.width)

const bullets = [
  'Portfolio return: +15.2% over the last 2 months',
  'One portfolio, U.S. and Canadian stocks together',
  'Free to join, no forms, leave anytime',
]
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Achieve Over 10% Returns in Just 2 Months — Free Portfolio Group</title>
    <meta
      name="description"
      content="A free WhatsApp group tracking one live stock portfolio across U.S. and Canadian markets — up over 10% in the last 2 months, moves explained simply. Free to join, no forms."
    />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              navy: '#0B2A5B',
              ink: '#0A1F44',
              flame: '#FB4516',
              blue: '#1E6BFF',
              blueDark: '#0A4FD0',
              mute: '#5A6B86',
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: linear-gradient(180deg, #FFFFFF 0%, #EEF4FF 100%);
        background-attachment: fixed;
        color: #0A1F44;
      }
      @keyframes ctaPulse {
        0%, 100% { transform: translateY(0); box-shadow: 0 14px 30px -8px rgba(30, 107, 255, 0.55); }
        50%      { transform: translateY(-3px); box-shadow: 0 20px 38px -8px rgba(30, 107, 255, 0.65); }
      }
      .cta-pulse { animation: ctaPulse 1.9s ease-in-out infinite; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">
    <main class="flex-1">
      <section class="max-w-5xl mx-auto w-full px-6 pt-10 md:pt-16 pb-12 grid lg:grid-cols-[1.1fr_0.9fr] gap-8 lg:gap-12 items-center">

        <!-- copy -->
        <div class="order-1 text-center lg:text-left">
          <p class="inline-flex items-center gap-2 text-[11px] md:text-xs uppercase tracking-[0.18em] text-blue font-700 mb-5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
            Free Portfolio Group · 2-Month Performance
          </p>

          <h1 class="font-800 text-navy text-[2rem] leading-[1.12] md:text-[2.7rem] md:leading-[1.08] mb-4">
            Achieve Over <span class="text-flame">10% Returns</span> in Just 2 Months
          </h1>

          <p class="text-mute text-[15px] md:text-lg leading-relaxed mb-7 max-w-[460px] mx-auto lg:mx-0">
            One free WhatsApp group, one live portfolio across U.S. and Canadian stocks — up more than 10% over the last two months, moves explained simply before the open.
          </p>

          <ul class="space-y-2.5 mb-7 max-w-[440px] mx-auto lg:mx-0 text-left">
            {bullets.map(b => (
              <li class="flex items-start gap-2.5 text-[14px] md:text-[15px] font-600 text-navy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="w-[17px] h-[17px] shrink-0 mt-0.5 text-blue"><path d="M20 6L9 17l-5-5" /></svg>
                {b}
              </li>
            ))}
          </ul>

          <p class="flex items-center gap-2 justify-center lg:justify-start text-sm text-navy font-600 mb-5">
            <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse shrink-0"></span>
            <span><span class="font-800 text-flame">+15.2%</span> last 2 months · <span class="font-800">9,200+</span> members</span>
          </p>

          <div class="flex flex-col items-center lg:items-start gap-3">
            <a
              onclick="mixinJump()"
              class="link-btn cta-pulse inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-blue to-blueDark text-white font-800 text-sm md:text-lg tracking-wide px-7 md:px-9 py-4 md:py-[18px] rounded-full cursor-pointer text-center leading-snug whitespace-normal sm:whitespace-nowrap w-full sm:w-auto"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-[18px] h-[18px] shrink-0"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
              <span>JOIN THE FREE WHATSAPP GROUP</span>
            </a>
            <p class="text-xs text-mute">Free · no forms, no cost · leave anytime</p>
          </div>
        </div>

        <!-- visual -->
        <div class="order-2 max-w-[240px] mx-auto lg:max-w-none">
          <img
            src={phone.src}
            width={POR_W}
            height={phoneH}
            alt="A portfolio app showing a mix of U.S. and Canadian stock positions"
            class="w-full max-w-[320px] mx-auto h-auto block rounded-2xl shadow-xl shadow-navy/10 select-none pointer-events-none"
          />
        </div>
      </section>
    </main>

    <footer class="py-5 text-center text-mute text-[11px] px-4">
      General market commentary for information and education only. Not personalized investment advice, and not a recommendation to buy or sell any security. Investing involves risk, including loss of principal.
    </footer>
  </body>
</html>
