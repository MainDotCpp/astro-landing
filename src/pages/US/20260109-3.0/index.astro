---
// Landing page for WhatsApp stock recommendations service
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'Premium Stock Intelligence - Daily Market Picks'
const description = 'Even in a down market, you can still profit. Get daily stock recommendations on WhatsApp. Check yesterday\'s picks (GPPL & Rico Auto) and get today\'s recommendation (Ajamna Auto) with full analysis.'
---

<BaseLayout title={title} description={description} lang="en">
  <Fragment slot="head">
    <!-- Fonts: Modern Professional (Poppins + Open Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      /* Page-specific styles */
      :root {
        --color-primary: #F59E0B;
        --color-secondary: #8B5CF6;
        --color-accent: #10B981;
      }

      @keyframes gradient-shift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
      }

      @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
      }

      @keyframes glow {
        0%, 100% { box-shadow: 0 0 20px rgba(245, 158, 11, 0.3), 0 0 40px rgba(139, 92, 246, 0.2); }
        50% { box-shadow: 0 0 30px rgba(245, 158, 11, 0.5), 0 0 60px rgba(139, 92, 246, 0.4); }
      }

      @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
      }

      @keyframes count-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes pulse-glow {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.8; transform: scale(1.05); }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      body {
        font-family: 'Open Sans', sans-serif;
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 25%, #334155 50%, #1E293B 75%, #0F172A 100%);
        background-size: 400% 400%;
        animation: gradient-shift 12s ease infinite;
        position: relative;
        overflow-x: hidden;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
          radial-gradient(circle at 20% 50%, rgba(245, 158, 11, 0.15) 0%, transparent 50%),
          radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
          radial-gradient(circle at 40% 20%, rgba(16, 185, 129, 0.1) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      /* Particle Canvas */
      #particles-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Poppins', sans-serif;
      }

      .text-gradient {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradient-shift 8s ease infinite;
        position: relative;
      }

      .text-gradient::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
        background-size: 200% 200%;
        filter: blur(20px);
        opacity: 0.5;
        z-index: -1;
        animation: gradient-shift 8s ease infinite;
      }

      .glass-dark {
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }

      .glass-light {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }

      .animate-glow {
        animation: glow 3s ease-in-out infinite;
      }

      .animate-pulse-glow {
        animation: pulse-glow 2s ease-in-out infinite;
      }

      .whatsapp-icon {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }

      @media (max-width: 640px) {
        .whatsapp-icon {
          width: 32px;
          height: 32px;
        }
      }

      /* 3D Card Effect */
      .card-3d {
        transform-style: preserve-3d;
        transition: transform 0.3s ease;
      }

      .card-3d:hover {
        transform: translateY(-8px) rotateX(2deg) rotateY(-2deg);
      }

      /* Premium Button */
      .btn-premium {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--color-secondary) 0%, var(--color-primary) 100%);
        background-size: 200% 200%;
        animation: gradient-shift 3s ease infinite;
      }

      .btn-premium::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        animation: shimmer 3s infinite;
      }

      .btn-premium:hover {
        animation: glow 1s ease-in-out infinite;
      }

      /* Stats Counter */
      .stat-number {
        font-size: clamp(1.6rem, 7vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: count-up 1s ease-out;
        word-break: keep-all;
        overflow-wrap: normal;
      }

      /* Scroll Reveal */
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.6s ease-out;
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </Fragment>

  <!-- Particle Background Canvas -->
  <canvas id="particles-canvas"></canvas>

  <div class="relative z-10 min-h-screen">
    <!-- Navigation -->
    <header id="navbar" class="fixed w-full z-50 transition-all duration-300 py-4 top-0">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-dark rounded-2xl px-6 py-4 flex justify-between items-center shadow-xl">
          <!-- Logo -->
          <a href="#" class="flex items-center space-x-3 cursor-pointer group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#F59E0B] to-[#8B5CF6] flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-200">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <span class="text-xl font-bold text-white tracking-tight" style="font-family: 'Poppins', sans-serif;">StockIntel</span>
          </a>

          <!-- CTA Button -->
          <button
            onclick="onLinkBtnClick()"
            class="hidden md:flex items-center space-x-2 bg-gradient-to-r from-[#8B5CF6] to-[#F59E0B] px-6 py-2.5 rounded-xl font-semibold text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200 cursor-pointer"
          >
            <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            <span>Join WhatsApp</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 min-h-screen flex items-center">
      <div class="container mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <!-- Left: Content -->
          <div class="text-center lg:text-left space-y-8">
            <!-- Badge -->
            <div class="inline-flex items-center space-x-2 glass-light px-4 py-2 rounded-full">
              <span class="w-2 h-2 bg-[#10B981] rounded-full animate-pulse"></span>
              <span class="text-sm font-medium text-slate-300">Even in Down Markets</span>
            </div>

            <!-- Headline -->
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-white" style="font-family: 'Poppins', sans-serif;">
              Profit in Any Market
              <br />
              <span class="text-gradient">Get Stock Picks on WhatsApp</span>
            </h1>

            <!-- Subheadline -->
            <p class="text-xl md:text-2xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
              Even in a down market, you can still make profits. Get daily stock recommendations delivered to your WhatsApp. Check yesterday's picks and see the results yourself.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <button
                onclick="onLinkBtnClick()"
                class="btn-premium group relative px-8 py-4 rounded-xl font-semibold text-white text-lg shadow-2xl hover:scale-105 transition-all duration-200 cursor-pointer"
                style="font-family: 'Poppins', sans-serif;"
              >
                <span class="relative z-10 flex items-center justify-center space-x-3">
                  <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                  </svg>
                  <span>Join WhatsApp Now</span>
                  <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </span>
              </button>

              <button class="glass-dark px-8 py-4 rounded-xl font-semibold text-white text-lg hover:bg-white/10 transition-all duration-200 cursor-pointer" style="font-family: 'Poppins', sans-serif;">
                Check Yesterday's Picks
              </button>
            </div>

            <!-- Trust Indicators -->
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-6 pt-8">
              <div class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-[#10B981]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-slate-300">Verify Yesterday's Picks</span>
              </div>
              <div class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-[#10B981]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-slate-300">Analysis & Reasoning</span>
              </div>
              <div class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-[#10B981]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-slate-300">Works in Down Markets</span>
              </div>
            </div>
          </div>

          <!-- Right: Visual Element -->
          <div class="relative hidden lg:block">
            <div class="relative">
              <!-- Animated Chart Background -->
              <div class="glass-dark rounded-3xl p-8 shadow-2xl transition-all duration-300 hover:translate-y-[-8px] hover:shadow-2xl cursor-pointer">
                <div class="space-y-6">
                  <!-- Stock Cards -->
                  <div class="glass-light rounded-xl p-4 border border-white/10">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-slate-300 text-sm">GPPL</span>
                      <span class="text-[#10B981] font-semibold">+12.5%</span>
                    </div>
                    <div class="h-1 bg-gradient-to-r from-[#10B981] to-transparent rounded-full"></div>
                  </div>

                  <div class="glass-light rounded-xl p-4 border border-white/10">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-slate-300 text-sm">Rico Auto</span>
                      <span class="text-[#10B981] font-semibold">+8.3%</span>
                    </div>
                    <div class="h-1 bg-gradient-to-r from-[#10B981] to-transparent rounded-full"></div>
                  </div>

                  <div class="glass-light rounded-xl p-4 border border-white/10">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-slate-300 text-sm">Ajamna Auto</span>
                      <span class="text-[#10B981] font-semibold">+15.2%</span>
                    </div>
                    <div class="h-1 bg-gradient-to-r from-[#10B981] to-transparent rounded-full"></div>
                  </div>
                </div>
              </div>

              <!-- Floating Elements -->
              <div class="absolute -top-8 -right-8 w-24 h-24 bg-gradient-to-br from-[#F59E0B]/20 to-[#8B5CF6]/20 rounded-full blur-2xl animate-float"></div>
              <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-gradient-to-br from-[#8B5CF6]/20 to-[#10B981]/20 rounded-full blur-2xl animate-float" style="animation-delay: 2s;"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 relative">
      <div class="container mx-auto max-w-7xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="glass-dark rounded-2xl p-6 text-center reveal">
            <div class="stat-number" data-target="12500">0</div>
            <p class="text-slate-400 mt-2 text-sm">Active Members</p>
          </div>
          <div class="glass-dark rounded-2xl p-6 text-center reveal">
            <div class="stat-number" data-target="98">0</div>
            <p class="text-slate-400 mt-2 text-sm">Success Rate %</p>
          </div>
          <div class="glass-dark rounded-2xl p-6 text-center reveal">
            <div class="stat-number" data-target="365">0</div>
            <p class="text-slate-400 mt-2 text-sm">Days Active</p>
          </div>
          <div class="glass-dark rounded-2xl p-6 text-center reveal">
            <div class="stat-number" data-target="24">0</div>
            <p class="text-slate-400 mt-2 text-sm">Hour Support</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 px-4 sm:px-6 lg:px-8 relative">
      <div class="container mx-auto max-w-7xl">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-4" style="font-family: 'Poppins', sans-serif;">
            Why Choose <span class="text-gradient">StockIntel</span>?
          </h2>
          <p class="text-xl text-slate-300 max-w-2xl mx-auto">
            Even in a down market, you can still profit. Get daily stock picks with full analysis and reasoning delivered to your WhatsApp.
          </p>
        </div>

        <!-- Features Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Feature 1 -->
          <div class="card-3d glass-dark rounded-2xl p-8 transition-all duration-300 hover:shadow-2xl cursor-pointer reveal">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#F59E0B] to-[#8B5CF6] flex items-center justify-center mb-6 animate-pulse-glow">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3" style="font-family: 'Poppins', sans-serif;">Daily Stock Picks</h3>
            <p class="text-slate-300 leading-relaxed">
              Get carefully researched stock recommendations every day. Check yesterday's picks on WhatsApp to verify the results yourself.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="card-3d glass-dark rounded-2xl p-8 transition-all duration-300 hover:shadow-2xl cursor-pointer reveal">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#8B5CF6] to-[#10B981] flex items-center justify-center mb-6 animate-pulse-glow">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3" style="font-family: 'Poppins', sans-serif;">Verify Results</h3>
            <p class="text-slate-300 leading-relaxed">
              Check yesterday's recommendations on WhatsApp. See GPPL and Rico Auto - both recommended yesterday and showing results today.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="card-3d glass-dark rounded-2xl p-8 transition-all duration-300 hover:shadow-2xl cursor-pointer reveal">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#10B981] to-[#F59E0B] flex items-center justify-center mb-6 animate-pulse-glow">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3" style="font-family: 'Poppins', sans-serif;">Full Analysis</h3>
            <p class="text-slate-300 leading-relaxed">
              Get complete judgment and reasoning. I tell you why I gave the recommendation and how I analyzed it - not just the pick, but the method.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="card-3d glass-dark rounded-2xl p-8 transition-all duration-300 hover:shadow-2xl cursor-pointer reveal">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#F59E0B] to-[#10B981] flex items-center justify-center mb-6 animate-pulse-glow">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3" style="font-family: 'Poppins', sans-serif;">Works in Down Markets</h3>
            <p class="text-slate-300 leading-relaxed">
              Even when the market is down, you can still make profits. Our picks are designed to work in any market condition.
            </p>
