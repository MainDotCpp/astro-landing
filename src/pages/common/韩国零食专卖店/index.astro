---
import BaseLayout from '@/layouts/BaseLayout.astro'

import heroShelfImg from './images/hero-shelf.png'
import honeyButterImg from './images/honey-butter.png'
import seaweedImg from './images/seaweed.png'
import snackSpreadImg from './images/snack-spread.png'
import tteokbokkiImg from './images/tteokbokki.png'
import unboxingImg from './images/unboxing.png'

const title = '맛나스낵 MATNNA | 한국 프리미엄 과자 전문점'
const description = 'Korean premium snack specialty store. Authentic K-snacks curated for adventurous taste buds — from honey butter chips to tteok-bokki crackers.'
---

<BaseLayout title={title} description={description} lang="ko">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #FFF8F0;
        --bg-warm: #FFF1E0;
        --ink: #1A1A1A;
        --ink-mid: #555;
        --ink-light: #999;
        --paper: #FFFFFF;
        --red: #E8453C;
        --red-light: #FFF0EE;
        --yellow: #FFD233;
        --yellow-light: #FFF9E0;
        --green: #2DB84B;
        --green-light: #EDFFF2;
        --blue: #3B82F6;
        --pink: #FF6B9D;
        --orange: #FF8C42;
        --purple: #8B5CF6;
        --border: #E8E0D8;
        --shadow: 0 2px 16px rgba(0,0,0,0.06);
        --font-display: 'Black Han Sans', sans-serif;
        --font-body: 'Noto Sans KR', sans-serif;
        --font-mono: 'Space Mono', monospace;
        --col: 64rem;
        --radius: 1rem;
      }

      * { box-sizing: border-box; }

      body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--ink);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .col {
        max-width: var(--col);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ---- Topbar ---- */
      .topbar {
        background: var(--red);
        color: white;
        text-align: center;
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.03em;
      }
      .topbar span {
        animation: pulse-text 2s ease-in-out infinite;
      }
      @keyframes pulse-text {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
      }

      /* ---- Hero ---- */
      .hero {
        padding: clamp(3rem, 2rem + 5vw, 6rem) 0 clamp(2rem, 1rem + 4vw, 4rem);
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: '';
        position: absolute;
        top: -60%;
        right: -20%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(255, 210, 51, 0.2) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
      }
      @media (max-width: 768px) {
        .hero-grid { grid-template-columns: 1fr; text-align: center; }
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--yellow-light);
        border: 2px solid var(--yellow);
        padding: 0.3rem 0.8rem;
        border-radius: 99px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 1.25rem;
      }
      .hero h1 {
        font-family: var(--font-display);
        font-size: clamp(2.5rem, 1.5rem + 5vw, 4.5rem);
        line-height: 1.15;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
      }
      .hero h1 .accent { color: var(--red); }
      .hero-sub {
        font-size: 1.05rem;
        color: var(--ink-mid);
        max-width: 28rem;
        margin-bottom: 2rem;
      }
      @media (max-width: 768px) {
        .hero-sub { margin: 0 auto 2rem; }
      }
      .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--red);
        color: white;
        font-weight: 900;
        font-size: 1rem;
        padding: 1rem 2rem;
        border-radius: var(--radius);
        text-decoration: none;
        border: 3px solid var(--ink);
        box-shadow: 4px 4px 0 var(--ink);
        transition: transform 0.12s, box-shadow 0.12s;
      }
      .hero-cta:hover {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 var(--ink);
      }

      /* ---- Hero image ---- */
      .hero-img-wrap {
        border: 3px solid var(--ink);
        border-radius: var(--radius);
        box-shadow: 6px 6px 0 var(--ink);
        overflow: hidden;
        position: relative;
      }
      .hero-img-wrap img {
        width: 100%;
        height: auto;
        display: block;
      }

      /* ---- Marquee ---- */
      .marquee-wrap {
        overflow: hidden;
        background: var(--yellow);
        border-top: 3px solid var(--ink);
        border-bottom: 3px solid var(--ink);
        padding: 0.6rem 0;
      }
      .marquee-track {
        display: flex;
        gap: 2rem;
        white-space: nowrap;
        animation: scroll-left 20s linear infinite;
        width: max-content;
      }
      @keyframes scroll-left {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .marquee-item {
        font-family: var(--font-display);
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--ink);
        flex-shrink: 0;
      }

      /* ---- Section common ---- */
      .section-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--ink-light);
        margin-bottom: 0.5rem;
      }
      .section-title {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 1rem + 3vw, 2.8rem);
        margin-bottom: 2.5rem;
        line-height: 1.2;
      }

      /* ---- Spread banner ---- */
      .spread-banner {
        padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
      }
      .spread-img-wrap {
        border: 3px solid var(--ink);
        border-radius: var(--radius);
        box-shadow: 6px 6px 0 var(--ink);
        overflow: hidden;
      }
      .spread-img-wrap img {
        width: 100%;
        height: auto;
        display: block;
      }

      /* ---- Category section ---- */
      .categories {
        padding: 0 0 clamp(3rem, 2rem + 4vw, 5rem);
      }
      .cat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
      }
      .cat-card {
        background: var(--paper);
        border: 2px solid var(--ink);
        border-radius: var(--radius);
        padding: 1.5rem;
        text-align: center;
        box-shadow: 3px 3px 0 var(--ink);
        transition: transform 0.12s, box-shadow 0.12s;
        cursor: pointer;
      }
      .cat-card:hover {
        transform: translate(1px, 1px);
        box-shadow: 2px 2px 0 var(--ink);
      }
      .cat-emoji {
        font-size: 2rem;
        margin-bottom: 0.5rem;
      }
      .cat-name {
        font-weight: 900;
        font-size: 0.95rem;
        margin-bottom: 0.2rem;
      }
      .cat-count {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink-light);
      }

      /* ---- Popular picks ---- */
      .picks {
        padding: 0 0 clamp(3rem, 2rem + 4vw, 5rem);
      }
      .picks-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }
      @media (max-width: 768px) {
        .picks-grid { grid-template-columns: 1fr; }
      }
      .pick-card {
        background: var(--paper);
        border: 2px solid var(--ink);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 4px 4px 0 var(--ink);
        transition: transform 0.12s, box-shadow 0.12s;
      }
      .pick-card:hover {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 var(--ink);
      }
      .pick-visual {
        height: 240px;
        overflow: hidden;
        position: relative;
      }
      .pick-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .pick-info {
        padding: 1.25rem;
        border-top: 2px solid var(--ink);
      }
      .pick-tag {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.15rem 0.5rem;
        border-radius: 3px;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }
      .pick-name {
        font-family: var(--font-display);
        font-size: 1.2rem;
        margin-bottom: 0.25rem;
        line-height: 1.3;
      }
      .pick-desc {
        font-size: 0.8rem;
        color: var(--ink-mid);
        margin-bottom: 0.75rem;
      }
      .pick-price {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--red);
      }
      .pick-price-old {
        font-size: 0.8rem;
        color: var(--ink-light);
        text-decoration: line-through;
        margin-left: 0.4rem;
        font-weight: 400;
      }

      /* ---- Why us ---- */
      .why {
        padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
        background: var(--ink);
        color: white;
      }
      .why .section-label { color: var(--yellow); }
      .why .section-title { color: white; }
      .why-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }
      @media (max-width: 768px) {
        .why-grid { grid-template-columns: 1fr; }
      }
      .why-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        align-items: center;
      }
      @media (max-width: 768px) {
        .why-layout { grid-template-columns: 1fr; }
      }
      .why-card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: var(--radius);
        padding: 1.5rem;
      }
      .why-num {
        font-family: var(--font-display);
        font-size: 2.5rem;
        line-height: 1;
        margin-bottom: 0.75rem;
        color: var(--yellow);
      }
      .why-title {
        font-weight: 900;
        font-size: 0.9rem;
        margin-bottom: 0.4rem;
      }
      .why-body {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.6);
        line-height: 1.6;
      }
      .why-img-wrap {
        border-radius: var(--radius);
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.1);
      }
      .why-img-wrap img {
        width: 100%;
        height: auto;
        display: block;
      }

      /* ---- Reviews ---- */
      .reviews {
        padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
      }
      .review-stack {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }
      @media (max-width: 768px) {
        .review-stack { grid-template-columns: 1fr; }
      }
      .review-card {
        background: var(--paper);
        border: 2px solid var(--ink);
        border-radius: var(--radius);
        padding: 1.5rem;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .review-stars {
        color: var(--yellow);
        font-size: 1rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.1em;
      }
      .review-text {
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--ink-mid);
        margin-bottom: 0.75rem;
      }
      .review-author {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink-light);
      }

      /* ---- CTA bottom ---- */
      .cta-bottom {
        padding: clamp(3rem, 2rem + 5vw, 6rem) 0;
        text-align: center;
        background: var(--bg-warm);
        border-top: 3px solid var(--ink);
        position: relative;
        overflow: hidden;
      }
      .cta-bottom::before {
        content: '';
        position: absolute;
        bottom: -40%;
        left: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(232,69,60,0.08) 0%, transparent 70%);
        pointer-events: none;
      }
      .cta-bottom-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 1rem + 4vw, 3.5rem);
        margin-bottom: 1rem;
        position: relative;
      }
      .cta-bottom-sub {
        font-size: 1rem;
        color: var(--ink-mid);
        max-width: 32rem;
        margin: 0 auto 2rem;
      }

      /* ---- Footer ---- */
      footer {
        background: var(--ink);
        color: rgba(255,255,255,0.4);
        padding: 2rem 0;
        font-size: 0.72rem;
        line-height: 1.7;
      }
      .footer-grid {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 2rem;
        flex-wrap: wrap;
      }
      .footer-brand {
        font-family: var(--font-display);
        font-size: 1.2rem;
        color: white;
        margin-bottom: 0.5rem;
      }
    </style>
  </Fragment>

  <!-- Topbar -->
  <div class="topbar">
    <span>🎉 첫 주문 15% 할인 — 코드: MATNNA15 입력하세요!</span>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="col">
      <div class="hero-grid">
        <div>
          <div class="hero-badge">★ Since 2019</div>
          <h1>진짜 한국 맛,<br><span class="accent">맛나스낵</span></h1>
          <p class="hero-sub">
            서울 편의점에서 직접 고른 프리미엄 과자를 전세계 어디서나. 허니버터칩부터 떡볶이맛 스낵까지, 진짜 K-스낵을 만나보세요.
          </p>
          <a href="#shop" class="hero-cta">
            지금 쇼핑하기 →
          </a>
        </div>

        <div class="hero-img-wrap">
          <img src={heroShelfImg.src} alt="한국 과자 진열대" width="1200" height="800" loading="eager" fetchpriority="high">
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee strip -->
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span class="marquee-item">🍘 한국 직배송</span>
      <span class="marquee-item">✦ 300+ 종류</span>
      <span class="marquee-item">🔥 매주 신상 입고</span>
      <span class="marquee-item">📦 3일 배송</span>
      <span class="marquee-item">💛 정품 보장</span>
      <span class="marquee-item">🎁 서프라이즈 박스</span>
      <span class="marquee-item">⭐ 4.9 평점</span>
      <span class="marquee-item">🍘 한국 직배송</span>
      <span class="marquee-item">✦ 300+ 종류</span>
      <span class="marquee-item">🔥 매주 신상 입고</span>
      <span class="marquee-item">📦 3일 배송</span>
      <span class="marquee-item">💛 정품 보장</span>
      <span class="marquee-item">🎁 서프라이즈 박스</span>
      <span class="marquee-item">⭐ 4.9 평점</span>
    </div>
  </div>

  <!-- Snack spread banner -->
  <section class="spread-banner" id="shop">
    <div class="col">
      <p class="section-label">Our Collection</p>
      <h2 class="section-title">풍성한 K-스낵 컬렉션</h2>
      <div class="spread-img-wrap">
        <img src={snackSpreadImg.src} alt="다양한 한국 과자 모음" width="1200" height="600" loading="lazy">
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="categories">
    <div class="col">
      <p class="section-label">Categories</p>
      <h2 class="section-title">카테고리별 탐색</h2>

      <div class="cat-grid">
        <div class="cat-card">
          <div class="cat-emoji">🍘</div>
          <div class="cat-name">과자 / 칩</div>
          <div class="cat-count">128 items</div>
        </div>
        <div class="cat-card">
          <div class="cat-emoji">🍫</div>
          <div class="cat-name">초콜릿</div>
          <div class="cat-count">64 items</div>
        </div>
        <div class="cat-card">
          <div class="cat-emoji">🥬</div>
          <div class="cat-name">김 / 해초</div>
          <div class="cat-count">42 items</div>
        </div>
        <div class="cat-card">
          <div class="cat-emoji">🍬</div>
          <div class="cat-name">젤리 / 캔디</div>
          <div class="cat-count">89 items</div>
        </div>
        <div class="cat-card">
          <div class="cat-emoji">🍡</div>
          <div class="cat-name">떡 / 전통</div>
          <div class="cat-count">35 items</div>
        </div>
        <div class="cat-card">
          <div class="cat-emoji">🍜</div>
          <div class="cat-name">라면스낵</div>
          <div class="cat-count">47 items</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Picks -->
  <section class="picks">
    <div class="col">
      <p class="section-label">Best Sellers</p>
      <h2 class="section-title">이번 주 인기 과자 🔥</h2>

      <div class="picks-grid">
        <div class="pick-card">
          <div class="pick-visual">
            <img src={honeyButterImg.src} alt="허니버터칩" width="800" height="800" loading="lazy">
          </div>
          <div class="pick-info">
            <span class="pick-tag" style="background: var(--yellow-light); color: #B8860B;">BESTSELLER</span>
            <div class="pick-name">허니버터칩</div>
            <p class="pick-desc">진짜 버터와 꿀의 달콤한 조합. 한국에서 가장 사랑받는 감자칩.</p>
            <div class="pick-price">₩3,900 <span class="pick-price-old">₩4,500</span></div>
          </div>
        </div>

        <div class="pick-card">
          <div class="pick-visual">
            <img src={tteokbokkiImg.src} alt="떡볶이맛 스낵" width="800" height="800" loading="lazy">
          </div>
          <div class="pick-info">
            <span class="pick-tag" style="background: var(--red-light); color: var(--red);">🌶️ SPICY</span>
            <div class="pick-name">신당동 떡볶이맛</div>
            <p class="pick-desc">매콤달콤 떡볶이 양념을 그대로 입힌 바삭한 크래커.</p>
            <div class="pick-price">₩2,800</div>
          </div>
        </div>

        <div class="pick-card">
          <div class="pick-visual">
            <img src={seaweedImg.src} alt="바삭 김스낵" width="800" height="800" loading="lazy">
          </div>
          <div class="pick-info">
            <span class="pick-tag" style="background: var(--green-light); color: #1B8F35;">HEALTHY</span>
            <div class="pick-name">광천 바삭김</div>
            <p class="pick-desc">참기름으로 구워낸 전통 방식의 프리미엄 돌김 스낵.</p>
            <div class="pick-price">₩4,200 <span class="pick-price-old">₩5,000</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="why">
    <div class="col">
      <p class="section-label">Why Matnna</p>
      <h2 class="section-title">왜 맛나스낵일까요?</h2>

      <div class="why-layout">
        <div class="why-grid">
          <div class="why-card">
            <div class="why-num">01</div>
            <div class="why-title">서울 직배송</div>
            <p class="why-body">서울 물류센터에서 직접 포장, 신선도를 유지한 채 3일 내 배송합니다.</p>
          </div>
          <div class="why-card">
            <div class="why-num">02</div>
            <div class="why-title">300+ 종류</div>
            <p class="why-body">편의점 인기 과자부터 지역 한정판까지, 한국 과자의 모든 것.</p>
          </div>
          <div class="why-card">
            <div class="why-num">03</div>
            <div class="why-title">100% 정품</div>
            <p class="why-body">공식 유통채널에서만 소싱. 가품이나 리패키징 절대 없습니다.</p>
          </div>
          <div class="why-card">
            <div class="why-num">04</div>
            <div class="why-title">매주 신상</div>
            <p class="why-body">한국 편의점 신상품을 매주 업데이트. 현지에서도 못 본 과자를 먼저.</p>
          </div>
        </div>
        <div class="why-img-wrap">
