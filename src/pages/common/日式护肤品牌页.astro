---
// Premium Japanese Skincare Landing Page - AURA
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'AURA | Timeless Japanese Beauty & Skincare'
const description = 'Experience the essence of Japanese minimalism. Premium skincare formulated with traditional botanicals and modern science for a radiant, timeless glow.'
---

<BaseLayout title={title} description={description} lang="ja">
  <Fragment slot="head">
    <!-- Google Fonts: Playfair Display for Serifs, Inter for Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --color-gold: #D4AF37;
        --color-gold-light: #F4D03F;
        --color-slate-950: #0C0A09;
        --color-slate-900: #1C1917;
        --color-slate-800: #44403C;
      }

      body {
        font-family: 'Inter', 'Noto Sans JP', sans-serif;
        background-color: var(--color-slate-950);
        color: #FAFAF9;
        overflow-x: hidden;
      }

      h1, h2, h3, .serif {
        font-family: 'Playfair Display', serif;
      }

      .text-gold-gradient {
        background: linear-gradient(135deg, #D4AF37 0%, #F4D03F 50%, #D4AF37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .glass-card {
        background: rgba(28, 25, 23, 0.6);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(212, 175, 55, 0.1);
        border-radius: 1.5rem;
      }

      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      @keyframes slow-zoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.1); }
      }

      .animate-slow-zoom {
        animation: slow-zoom 20s linear infinite alternate;
      }
    </style>
  </Fragment>

  <div class="relative min-h-screen">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 flex justify-center pt-6 px-4">
      <div class="max-w-7xl w-full flex justify-between items-center px-8 py-4 glass-card shadow-2xl">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-linear-to-tr from-[#D4AF37] to-[#F4D03F] rounded-full flex items-center justify-center shadow-lg">
            <span class="text-slate-950 font-bold text-xl serif italic">A</span>
          </div>
          <span class="text-2xl font-bold tracking-[0.2em] serif uppercase text-gold-gradient">Aura</span>
        </div>
        <div class="hidden md:flex gap-8 text-sm uppercase tracking-widest font-medium">
          <a href="#philosophy" class="hover:text-amber-400 transition-colors">Philosophy</a>
          <a href="#collection" class="hover:text-amber-400 transition-colors">Collection</a>
          <a href="#rituals" class="hover:text-amber-400 transition-colors">Rituals</a>
        </div>
        <button onclick="window.onLinkBtnClick()" class="bg-[#D4AF37] text-slate-950 px-8 py-2.5 rounded-full font-bold hover:bg-white transition-all cursor-pointer shadow-[0_0_20px_rgba(212,175,55,0.3)]">
          Shop Now
        </button>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="relative h-screen flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1556229167-7313abc2c5c0?auto=format&fit=crop&q=80&w=2000" alt="Premium Skincare Background" class="w-full h-full object-cover opacity-40 animate-slow-zoom" />
        <div class="absolute inset-0 bg-linear-to-b from-slate-950/80 via-transparent to-slate-950"></div>
      </div>

      <div class="relative z-10 text-center px-4 max-w-5xl mx-auto space-y-12">
        <div class="inline-flex items-center gap-3 px-6 py-2 rounded-full border border-amber-500/30 bg-amber-500/5 text-amber-200 text-sm tracking-[0.2em] uppercase font-medium">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Artisanal Beauty from Japan
        </div>

        <h1 class="text-6xl md:text-9xl font-bold leading-tight tracking-tight reveal">
          Timeless <br />
          <span class="text-gold-gradient italic">Elegance</span>
        </h1>

        <p class="text-xl md:text-2xl text-slate-300 max-w-2xl mx-auto leading-relaxed font-light reveal" style="transition-delay: 200ms;">
          Where ancient botanical wisdom meets modern precision. Experience the ritual of ultimate skin transformation.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center pt-8 reveal" style="transition-delay: 400ms;">
          <button onclick="window.onLinkBtnClick()" class="px-12 py-5 bg-[#D4AF37] text-slate-950 font-bold text-lg rounded-full shadow-2xl hover:scale-105 active:scale-95 transition-all cursor-pointer">
            Explore the Collection
          </button>
          <button class="px-12 py-5 border border-white/20 text-white font-bold text-lg rounded-full hover:bg-white/10 transition-all cursor-pointer backdrop-blur-sm">
            Our Story
          </button>
        </div>
      </div>

      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-amber-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- Philosophy Section -->
    <section id="philosophy" class="py-32 px-4">
      <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-20 items-center">
        <div class="relative reveal">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-amber-500/10 rounded-full blur-3xl"></div>
          <img src="https://images.unsplash.com/photo-1590156206657-b18413697e08?auto=format&fit=crop&q=80&w=1000" alt="Japanese Garden" class="rounded-[2.5rem] shadow-2xl relative z-10" />
          <div class="absolute -bottom-10 -right-10 glass-card p-8 z-20 max-w-xs">
            <p class="text-amber-400 font-bold text-lg mb-2 serif italic">"Beauty is found in simplicity and the passage of time."</p>
            <p class="text-slate-400 text-sm">— Traditional Zen Proverb</p>
          </div>
        </div>

        <div class="space-y-8 reveal" style="transition-delay: 200ms;">
          <h2 class="text-5xl md:text-6xl font-bold leading-tight">The <span class="text-gold-gradient italic">Purest</span> Essence</h2>
          <p class="text-xl text-slate-400 leading-relaxed font-light">
            Aura is more than skincare; it is a philosophy of mindfulness. We believe that true radiance comes from a harmonious balance between inner peace and external care.
          </p>
          <ul class="space-y-6">
            <li class="flex gap-4 items-start">
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-bold mb-1">Sustainable Harvesting</h4>
                <p class="text-slate-500">Ethically sourced botanicals from local Japanese farmers.</p>
              </div>
            </li>
            <li class="flex gap-4 items-start">
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h4 class="text-xl font-bold mb-1">Cold-Pressed Precision</h4>
                <p class="text-slate-500">Preserving 98% of active nutrients for maximum efficacy.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Collection Section -->
    <section id="collection" class="py-32 px-4 bg-slate-900/30">
      <div class="max-w-7xl mx-auto space-y-20">
        <div class="text-center space-y-6 max-w-3xl mx-auto">
          <h2 class="text-5xl md:text-6xl font-bold reveal">The Signature <span class="text-gold-gradient italic">Ritual</span></h2>
          <p class="text-xl text-slate-400 font-light reveal" style="transition-delay: 100ms;">Each product in our collection is designed to work in synergy, creating a transformative experience for your skin.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-10">
          <!-- Product 1 -->
          <div class="glass-card p-4 group cursor-pointer reveal" style="transition-delay: 200ms;">
            <div class="relative overflow-hidden rounded-2xl aspect-4/5 mb-8">
              <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?auto=format&fit=crop&q=80&w=800" alt="Midnight Elixir" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors"></div>
            </div>
            <div class="px-4 pb-4 space-y-4">
              <div class="flex justify-between items-end">
                <div>
                  <h3 class="text-2xl font-bold serif tracking-tight">Midnight Elixir</h3>
                  <p class="text-amber-500 text-sm uppercase tracking-widest mt-1">Regenerative Oil</p>
                </div>
                <p class="text-2xl font-light text-slate-300">¥18,500</p>
              </div>
              <p class="text-slate-500 text-sm leading-relaxed">Infused with Rare Tsubaki Oil and Fermented Rice Water for deep overnight renewal.</p>
              <button onclick="window.onLinkBtnClick()" class="w-full py-4 rounded-xl border border-amber-500/20 text-amber-500 font-bold hover:bg-amber-500 hover:text-slate-950 transition-all">Add to Ritual</button>
            </div>
          </div>

          <!-- Product 2 -->
          <div class="glass-card p-4 group cursor-pointer reveal" style="transition-delay: 300ms;">
            <div class="relative overflow-hidden rounded-2xl aspect-4/5 mb-8">
              <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?auto=format&fit=crop&q=80&w=800" alt="Silk Cleansing Balm" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors"></div>
            </div>
            <div class="px-4 pb-4 space-y-4">
              <div class="flex justify-between items-end">
                <div>
                  <h3 class="text-2xl font-bold serif tracking-tight">Silk Balm</h3>
                  <p class="text-amber-500 text-sm uppercase tracking-widest mt-1">Purifying Cleanser</p>
                </div>
                <p class="text-2xl font-light text-slate-300">¥8,200</p>
              </div>
              <p class="text-slate-500 text-sm leading-relaxed">Melts away impurities while maintaining your skin's natural moisture barrier.</p>
              <button onclick="window.onLinkBtnClick()" class="w-full py-4 rounded-xl border border-amber-500/20 text-amber-500 font-bold hover:bg-amber-500 hover:text-slate-950 transition-all">Add to Ritual</button>
            </div>
          </div>

          <!-- Product 3 -->
          <div class="glass-card p-4 group cursor-pointer reveal" style="transition-delay: 400ms;">
            <div class="relative overflow-hidden rounded-2xl aspect-4/5 mb-8">
              <img src="https://images.unsplash.com/photo-1601049541289-9b1b7bcfe19b?auto=format&fit=crop&q=80&w=800" alt="Zen Mist" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/0 transition-colors"></div>
            </div>
            <div class="px-4 pb-4 space-y-4">
              <div class="flex justify-between items-end">
                <div>
                  <h3 class="text-2xl font-bold serif tracking-tight">Zen Mist</h3>
                  <p class="text-amber-500 text-sm uppercase tracking-widest mt-1">Hydrating Essence</p>
                </div>
                <p class="text-2xl font-light text-slate-300">¥6,800</p>
              </div>
              <p class="text-slate-500 text-sm leading-relaxed">A refreshing cloud of Green Tea and Lotus extract for instant revitalisation.</p>
              <button onclick="window.onLinkBtnClick()" class="w-full py-4 rounded-xl border border-amber-500/20 text-amber-500 font-bold hover:bg-amber-500 hover:text-slate-950 transition-all">Add to Ritual</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Section -->
    <section class="py-32 px-4 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-amber-500/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-4xl mx-auto text-center space-y-16 relative z-10">
        <div class="space-y-4">
          <h2 class="text-4xl md:text-6xl font-bold reveal">Expertly <span class="italic serif text-amber-500">Validated</span></h2>
          <p class="text-xl text-slate-400 font-light reveal" style="transition-delay: 100ms;">Recommended by leading dermatologists and featured in global luxury publications.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-12 items-center opacity-50 grayscale hover:grayscale-0 transition-all reveal" style="transition-delay: 200ms;">
          <span class="text-2xl font-bold serif tracking-tighter">VOGUE</span>
          <span class="text-2xl font-bold serif tracking-tighter">ELLE</span>
          <span class="text-2xl font-bold serif tracking-tighter">BAZAAR</span>
          <span class="text-2xl font-bold serif tracking-tighter">GLAMOUR</span>
        </div>

        <div class="grid md:grid-cols-3 gap-8 pt-12">
          <div class="glass-card p-8 reveal" style="transition-delay: 300ms;">
            <div class="flex justify-center mb-6">
              {[1, 2, 3, 4, 5].map(_ => (
                <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-slate-300 italic mb-6">"My skin has never felt more luminous. The ritualistic approach is a game-changer."</p>
            <div class="flex items-center justify-center gap-3">
              <img src="https://i.pravatar.cc/100?u=1" alt="Reviewer" class="w-10 h-10 rounded-full" />
              <div class="text-left">
                <p class="font-bold text-sm">Elena Miyake</p>
                <p class="text-slate-500 text-xs uppercase tracking-widest">Tokyo, Japan</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-8 reveal" style="transition-delay: 400ms;">
            <div class="flex justify-center mb-6">
              {[1, 2, 3, 4, 5].map(_ => (
                <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-slate-300 italic mb-6">"The attention to detail and quality of ingredients is unparalleled. Truly premium."</p>
            <div class="flex items-center justify-center gap-3">
              <img src="https://i.pravatar.cc/100?u=2" alt="Reviewer" class="w-10 h-10 rounded-full" />
              <div class="text-left">
                <p class="font-bold text-sm">Sarah Jenkins</p>
                <p class="text-slate-500 text-xs uppercase tracking-widest">Paris, France</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-8 reveal" style="transition-delay: 500ms;">
            <div class="flex justify-center mb-6">
              {[1, 2, 3, 4, 5].map(_ => (
                <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <p class="text-slate-300 italic mb-6">"Finally, a brand that respects both my skin and the environment. Pure perfection."</p>
            <div class="flex items-center justify-center gap-3">
              <img src="https://i.pravatar.cc/100?u=3" alt="Reviewer" class="w-10 h-10 rounded-full" />
              <div class="text-left">
                <p class="font-bold text-sm">Lina Chen</p>
                <p class="text-slate-500 text-xs uppercase tracking-widest">New York, USA</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="py-40 px-4 relative overflow-hidden bg-slate-900/20">
      <div class="max-w-4xl mx-auto text-center space-y-12 relative z-10">
        <h2 class="text-5xl md:text-8xl font-bold reveal">Ready to <span class="text-gold-gradient italic">Radiate?</span></h2>
        <p class="text-2xl text-slate-400 font-light reveal" style="transition-delay: 100ms;">Join our inner circle and receive an exclusive gift with your first ritual.</p>

        <div class="flex flex-col items-center gap-6 reveal" style="transition-delay: 200ms;">
          <button onclick="window.onLinkBtnClick()" class="px-16 py-6 bg-[#D4AF37] text-slate-950 font-bold text-2xl rounded-full shadow-[0_20px_60px_rgba(212,175,55,0.4)] hover:scale-105 transition-all cursor-pointer">
            Begin Your Journey
          </button>
          <div class="flex items-center gap-4 text-slate-500 text-sm tracking-widest uppercase">
            <span>Free Shipping Worldwide</span>
            <span class="w-1 h-1 bg-slate-700 rounded-full"></span>
            <span>Sustainable Packaging</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-24 border-t border-white/5 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-4 gap-16 mb-20">
        <div class="space-y-8 md:col-span-1">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-amber-500 rounded-full flex items-center justify-center">
              <span class="text-slate-950 font-bold serif italic text-sm">A</span>
            </div>
            <span class="text-xl font-bold tracking-[0.2em] serif uppercase text-gold-gradient">Aura</span>
          </div>
          <p class="text-slate-500 text-sm leading-relaxed">
            Timeless Japanese beauty, formulated for the modern world. Committed to purity, sustainability, and radiance.
          </p>
        </div>

        <div class="space-y-6">
          <h4 class="text-white font-bold uppercase tracking-widest text-xs">Explore</h4>
          <ul class="space-y-4 text-slate-500 text-sm">
            <li><a href="#" class="hover:text-amber-500 transition-colors">Our Philosophy</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">The Collection</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Skin Rituals</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Sustainability</a></li>
          </ul>
        </div>

        <div class="space-y-6">
          <h4 class="text-white font-bold uppercase tracking-widest text-xs">Support</h4>
          <ul class="space-y-4 text-slate-500 text-sm">
            <li><a href="#" class="hover:text-amber-500 transition-colors">Contact Us</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Shipping & Returns</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">FAQ</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Stockists</a></li>
          </ul>
        </div>

        <div class="space-y-6">
          <h4 class="text-white font-bold uppercase tracking-widest text-xs">Legal</h4>
          <ul class="space-y-4 text-slate-500 text-sm">
            <li><a href="#" class="hover:text-amber-500 transition-colors">Privacy Policy</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Terms of Service</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Cookie Policy</a></li>
            <li><a href="#" class="hover:text-amber-500 transition-colors">Accessibility</a></li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8">
        <p class="text-slate-600 text-xs tracking-widest uppercase">© 2026 Aura Skincare Japan Co., Ltd.</p>
        <div class="flex gap-8 opacity-30 grayscale hover:opacity-100 hover:grayscale-0 transition-all">
          <!-- Trust Badges placeholder -->
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5zm-1 15.5l-3.5-3.5 1.41-1.41L11 14.67l6.09-6.09 1.41 1.41L11 17.5z" /></svg>
            <span class="text-[10px] uppercase font-bold tracking-widest">Secure Checkout</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.59-12.42L10 14.17l-2.59-2.58L6 13l4 4 8-8z" /></svg>
            <span class="text-[10px] uppercase font-bold tracking-widest">Certified Organic</span>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline>
    // Intersection Observer for reveal animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active')
        }
      })
    }, { threshold: 0.1 })

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el))
  </script>
</BaseLayout>
