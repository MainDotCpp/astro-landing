  <script is:inline>
    // 이미지 갤러리 전환
    const thumbnails = document.querySelectorAll('.thumb-btn');
    const mainImage = document.getElementById('mainImage');
    const imageSources = [
      document.querySelector('.thumb-btn[data-index="0"] img').src,
      document.querySelector('.thumb-btn[data-index="1"] img').src,
      document.querySelector('.thumb-btn[data-index="2"] img').src,
      document.querySelector('.thumb-btn[data-index="3"] img').src,
      document.querySelector('.thumb-btn[data-index="4"] img').src,
      document.querySelector('.thumb-btn[data-index="5"] img').src,
      document.querySelector('.thumb-btn[data-index="6"] img').src,
    ];

    thumbnails.forEach((btn) => {
      btn.addEventListener('click', () => {
        thumbnails.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const index = parseInt(btn.getAttribute('data-index'));
        mainImage.src = imageSources[index];
      });
    });
  </script>
