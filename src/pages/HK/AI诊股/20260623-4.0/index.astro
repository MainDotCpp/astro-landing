---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'AI 股票診斷 · 即刻睇清手上隻股 | 港股智能分析'
const description = 'AI 即時分析港股走勢、資金流向同大市氣氛，幾秒鐘睇清你手上隻股嘅買賣訊號。加 WhatsApp 攞完整診斷報告。'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@400;500;700;900&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- ═══════════ 背景層 ═══════════ -->
  <canvas id="particles-bg" class="bg-particles"></canvas>
  <div class="bg-aurora" aria-hidden="true">
    <span class="aurora a1"></span>
    <span class="aurora a2"></span>
    <span class="aurora a3"></span>
  </div>
  <div class="bg-grid" aria-hidden="true"></div>

  <!-- ═══════════ 單屏 HERO ═══════════ -->
  <main class="hero">
    <div class="hero-inner">
      <div class="eyebrow">
        <span class="dot"></span>
        <span>AI 即時診斷 · 香港股市</span>
      </div>

      <h1 class="title">
        手上揸住嘅股<br />
        <span class="grad">而家係咪應該走？</span>
      </h1>
      <p class="subtitle">輸入股票代號，AI 幾秒鐘幫你睇清「買入」定「沽出」訊號</p>

      <div class="search">
        <div class="search-box" id="searchBox">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
          </svg>
          <input id="stockInput" type="text" autocomplete="off" inputmode="text" placeholder="輸入股號 / 股名，例 700" />
          <button id="diagBtn" class="diag-btn" type="button">
            即時診斷
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          </button>
        </div>
        <div id="dropdown" class="dropdown"></div>
      </div>

      <div class="hot">
        <span class="hot-lbl">熱門</span>
        <button class="chip" data-code="00700" data-name="騰訊控股" type="button">騰訊</button>
        <button class="chip" data-code="09988" data-name="阿里巴巴" type="button">阿里</button>
        <button class="chip" data-code="00005" data-name="滙豐控股" type="button">滙豐</button>
        <button class="chip" data-code="01211" data-name="比亞迪股份" type="button">比亞迪</button>
        <button class="chip" data-code="03690" data-name="美團" type="button">美團</button>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="num" id="userCount">12,847</div>
          <div class="lbl">今日已診斷</div>
        </div>
        <span class="sep"></span>
        <div class="stat">
          <div class="num up">91.4%</div>
          <div class="lbl">訊號命中率</div>
        </div>
        <span class="sep"></span>
        <div class="stat">
          <div class="num">3<span class="num-u">秒</span></div>
          <div class="lbl">出結果</div>
        </div>
      </div>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-track" id="tickerTrack"></div>
      </div>
    </div>
  </main>

  <!-- ═══════════ 診斷 MODAL ═══════════ -->
  <div id="modal" class="modal">
    <div class="modal-card">
      <button id="modalClose" class="modal-close" type="button" aria-label="關閉">×</button>

      <!-- Loading -->
      <div id="loading" class="m-loading">
        <div class="radar">
          <span class="radar-ring r1"></span>
          <span class="radar-ring r2"></span>
          <span class="radar-sweep"></span>
          <svg class="radar-core" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
        </div>
        <div class="scan-title">AI 分析緊 <span id="loadStock" class="scan-stock"></span></div>
        <div class="scan-sub">REAL-TIME AI DIAGNOSIS</div>
        <div class="progress"><span id="progressBar"></span></div>
        <div class="logs" id="logs">
          <div><i>01</i>連接交易所實時數據…</div>
          <div><i>02</i>掃描技術指標 RSI / MACD / 平均線…</div>
          <div><i>03</i>分析主力資金流向…</div>
          <div><i>04</i>追蹤大戶同外資動向…</div>
          <div><i>05</i>解讀大市氣氛同最新消息…</div>
          <div><i>06</i>生成 AI 綜合診斷報告…</div>
        </div>
      </div>

      <!-- Result -->
      <div id="result" class="m-result">
        <div class="res-head">
          <span class="res-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M5 13l4 4L19 7"></path></svg>
          </span>
          <div>
            <div class="res-done">診斷完成</div>
            <div class="res-stock" id="resStock"></div>
          </div>
        </div>

        <div class="metrics">
          <div class="metric">
            <div class="m-lbl">AI 評級</div>
            <div class="m-val cyan" id="mGrade">A</div>
          </div>
          <div class="metric">
            <div class="m-lbl">趨勢訊號</div>
            <div class="m-val up" id="mTrend">偏強 ▲</div>
          </div>
          <div class="metric">
            <div class="m-lbl">風險</div>
            <div class="m-val gold" id="mRisk">中</div>
          </div>
        </div>

        <div class="locked">
          <div class="locked-rows">
            <div class="lk-row"><span>建議買入區間</span><b>●●.●● – ●●.●●</b></div>
            <div class="lk-row"><span>AI 目標價</span><b class="up">▲ ●●.●●</b></div>
            <div class="lk-row"><span>止蝕位</span><b>●●.●●</b></div>
            <div class="lk-row"><span>短／中線部署建議</span><b>●●●●●●</b></div>
          </div>
          <div class="locked-mask">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>完整買賣點 · 目標價 · 止蝕位已鎖定</span>
          </div>
        </div>

        <a href="javascript:void(0)" onclick="onLinkBtnClick()" class="wa-cta" id="waCta">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.43 1.32-1.97 1.4-.5.08-1.14.11-1.84-.12-.42-.13-.97-.31-1.66-.61-2.93-1.27-4.84-4.22-4.99-4.41-.15-.2-1.19-1.58-1.19-3.01 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.25.59.83 2.02.9 2.17.07.15.12.32.02.51-.09.2-.14.32-.27.49-.14.17-.29.38-.41.51-.14.14-.28.29-.12.57.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.21 1.36.27.14.43.12.59-.07.16-.2.68-.79.86-1.07.18-.27.36-.22.61-.13.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.12.07.69-.18 1.38Z"></path></svg>
          加 WhatsApp 解鎖完整診斷報告
        </a>
        <p class="wa-note">傳低「<span id="resStock2"></span>」就收到完整 AI 診斷報告</p>
      </div>
    </div>
  </div>

  <!-- ═══════════ JS ═══════════ -->
  <script is:inline>
const HK_STOCKS = [
  { c: '00700', n: '騰訊控股' },
  { c: '09988', n: '阿里巴巴' },
  { c: '03690', n: '美團' },
  { c: '01810', n: '小米集團' },
  { c: '09618', n: '京東集團' },
  { c: '09999', n: '網易' },
  { c: '01024', n: '快手' },
  { c: '00981', n: '中芯國際' },
  { c: '00005', n: '滙豐控股' },
  { c: '01299', n: '友邦保險' },
  { c: '02318', n: '中國平安' },
  { c: '00388', n: '香港交易所' },
  { c: '00939', n: '建設銀行' },
  { c: '03988', n: '中國銀行' },
  { c: '01398', n: '工商銀行' },
  { c: '02388', n: '中銀香港' },
  { c: '01211', n: '比亞迪股份' },
  { c: '00175', n: '吉利汽車' },
  { c: '02015', n: '理想汽車' },
  { c: '09868', n: '小鵬汽車' },
  { c: '00941', n: '中國移動' },
  { c: '02020', n: '安踏體育' },
  { c: '02331', n: '李寧' },
  { c: '09633', n: '農夫山泉' },
  { c: '06862', n: '海底撈' },
  { c: '00027', n: '銀河娛樂' },
  { c: '01928', n: '金沙中國' },
  { c: '00883', n: '中國海洋石油' },
  { c: '00016', n: '新鴻基地產' },
  { c: '02269', n: '藥明生物' },
  { c: '06618', n: '京東健康' },
]

// ── 粒子背景（手寫 canvas 連線網絡，主線程渲染，零依賴、所有瀏覽器可見）──
function initParticles() {
  const canvas = document.getElementById('particles-bg')
  if (!canvas)
    return
  const ctx = canvas.getContext('2d')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const mouse = { x: -999, y: -999 }
  const LINK = 142
  let W = 0
  let H = 0
  let dpr = 1
  let pts = []

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = window.innerWidth
    H = window.innerHeight
    canvas.width = W * dpr
    canvas.height = H * dpr
    canvas.style.width = `${W}px`
    canvas.style.height = `${H}px`
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
  }
  function build() {
    const count = Math.max(34, Math.min(72, Math.round(W * H / 15000)))
    pts = []
    for (let i = 0; i < count; i++) {
      pts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * (reduce ? 0.12 : 0.5),
        vy: (Math.random() - 0.5) * (reduce ? 0.12 : 0.5),
        r: Math.random() * 1.5 + 0.9,
      })
    }
  }
  function frame() {
    ctx.clearRect(0, 0, W, H)
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i]
      p.x += p.vx
      p.y += p.vy
      if (p.x < 0 || p.x > W)
        p.vx *= -1
      if (p.y < 0 || p.y > H)
        p.vy *= -1
      for (let j = i + 1; j < pts.length; j++) {
        const q = pts[j]
        const d = Math.hypot(p.x - q.x, p.y - q.y)
        if (d < LINK) {
          ctx.globalAlpha = (1 - d / LINK) * 0.5
          ctx.strokeStyle = '#34d8ee'
          ctx.lineWidth = 1
          ctx.beginPath()
          ctx.moveTo(p.x, p.y)
          ctx.lineTo(q.x, q.y)
          ctx.stroke()
        }
      }
      const md = Math.hypot(p.x - mouse.x, p.y - mouse.y)
      if (md < 180) {
        ctx.globalAlpha = (1 - md / 180) * 0.75
        ctx.strokeStyle = '#7fe9ff'
        ctx.lineWidth = 1.1
        ctx.beginPath()
        ctx.moveTo(p.x, p.y)
        ctx.lineTo(mouse.x, mouse.y)
        ctx.stroke()
      }
    }
    for (const p of pts) {
      ctx.globalAlpha = 0.16
      ctx.fillStyle = '#34d8ee'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r * 3, 0, Math.PI * 2)
      ctx.fill()
      ctx.globalAlpha = 0.95
      ctx.fillStyle = '#bdf1ff'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.globalAlpha = 1
    if (!reduce)
      requestAnimationFrame(frame)
  }

  resize()
  build()
  frame()
  window.addEventListener('resize', () => {
    resize()
    build()
  })
  window.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX
    mouse.y = e.clientY
  })
  window.addEventListener('pointerleave', () => {
    mouse.x = -999
    mouse.y = -999
  })
}

// ── 自動完成 ──
function setupAutocomplete() {
  const input = document.getElementById('stockInput')
  const dd = document.getElementById('dropdown')
  input.addEventListener('input', function () {
    const v = this.value.trim().toUpperCase()
    if (!v) {
      dd.classList.remove('open')
      dd.innerHTML = ''
      return
    }
    const hits = HK_STOCKS.filter(s => s.c.includes(v) || s.n.toUpperCase().includes(v)).slice(0, 6)
    if (!hits.length) {
      dd.classList.remove('open')
      dd.innerHTML = ''
      return
    }
    dd.innerHTML = hits.map(s => `<button type="button" class="dd-item" data-code="${s.c}" data-name="${s.n}"><span class="dd-code">${s.c}</span><span class="dd-name">${s.n}</span></button>`).join('')
    dd.classList.add('open')
  })
  dd.addEventListener('click', (e) => {
    const item = e.target.closest('.dd-item')
    if (!item)
      return
    input.value = `${item.dataset.code} ${item.dataset.name}`
    dd.classList.remove('open')
    dd.innerHTML = ''
    startAnalysis()
  })
  document.addEventListener('click', (e) => {
    if (!document.getElementById('searchBox').contains(e.target) && !dd.contains(e.target)) {
      dd.classList.remove('open')
    }
  })
}

// ── 解析輸入 → 股票名 ──
function resolveStock(raw) {
  const v = raw.trim()
  if (!v)
    return null
  const up = v.toUpperCase()
  const hit = HK_STOCKS.find(s => s.c === up || s.n === v || up.includes(s.c) || v.includes(s.n))
  if (hit)
    return `${hit.n}（${hit.c}）`
  return v
}

// ── 診斷流程 ──
let busy = false
function startAnalysis() {
  if (busy)
    return
  const input = document.getElementById('stockInput')
  const label = resolveStock(input.value)
  if (!label) {
    const box = document.getElementById('searchBox')
    box.classList.add('shake')
    setTimeout(() => box.classList.remove('shake'), 500)
    input.focus()
    return
  }
  busy = true
  openModal(label)
}

function openModal(label) {
  const modal = document.getElementById('modal')
  const loading = document.getElementById('loading')
  const result = document.getElementById('result')
  const shortName = label.replace(/（.*?）/, '')

  document.getElementById('loadStock').textContent = label
  document.getElementById('resStock').textContent = label
  document.getElementById('resStock2').textContent = shortName

  // 依股票名生成穩定的「診斷結果」，令唔同股顯示唔同評級（更可信）
  const seed = [...label].reduce((a, c) => a + c.charCodeAt(0), 0)
  const grades = ['A+', 'A', 'A', 'A-', 'B+']
  const trends = ['強勢突破 ▲', '短線偏強 ▲', '資金流入 ▲', '回穩待升 ▲']
  const risks = ['中', '中', '中低', '中高']
  document.getElementById('mGrade').textContent = grades[seed % grades.length]
  document.getElementById('mTrend').textContent = trends[seed % trends.length]
  document.getElementById('mRisk').textContent = risks[seed % risks.length]

  loading.style.display = 'block'
  result.style.display = 'none'
  modal.classList.add('open')
  document.body.style.overflow = 'hidden'

  const bar = document.getElementById('progressBar')
  const logs = document.querySelectorAll('#logs > div')
  const stepMs = [950, 1150, 1500, 1150, 1350, 1150] // 各步耗時不均，更似真檢測
  const totalMs = stepMs.reduce((a, b) => a + b, 0)
  bar.style.transition = 'none'
  bar.style.width = '0%'
  logs.forEach(l => l.classList.remove('on', 'active', 'done'))

  if (openModal._timers)
    openModal._timers.forEach(clearTimeout)
  openModal._timers = []
  let acc = 0
  let cum = 0
  stepMs.forEach((ms, i) => {
    openModal._timers.push(setTimeout(() => {
      logs[i].classList.add('active')
    }, acc))
    cum += ms
    const pct = `${(cum / totalMs) * 100}%`
    openModal._timers.push(setTimeout(() => {
      logs[i].classList.remove('active')
      logs[i].classList.add('done')
      bar.style.transition = 'width .45s ease'
      bar.style.width = pct
    }, acc + ms))
    acc += ms
  })

  clearTimeout(openModal._t)
  openModal._t = setTimeout(() => {
    loading.style.display = 'none'
    result.style.display = 'block'
  }, totalMs + 350)
}

function closeModal() {
  const modal = document.getElementById('modal')
  modal.classList.remove('open')
  document.body.style.overflow = ''
  busy = false
}

// ── 統計數字滾動 ──
function runStats() {
  const el = document.getElementById('userCount')
  let n = 12847
  setInterval(() => {
    n += Math.floor(Math.random() * 3) + 1
    el.textContent = n.toLocaleString('en-US')
  }, 2600)
}

// ── Live ticker ──
function buildTicker() {
  const surnames = ['陳', '黃', '李', '張', '何', '劉', '林', '吳', '梁', '羅', '麥', '周']
  const tpls = [
    (sn, s) => `<span class="tk"><b>${sn}＊＊</b> 啱啱診斷咗 <em>${s.n}</em></span>`,
    (sn, s) => `<span class="tk"><b>${sn}＊＊</b> 攞咗 <em>${s.n}</em> 嘅 AI 報告</span>`,
    (sn, s) => `<span class="tk"><b>${sn}＊＊</b> 啱啱睇咗 <em>${s.n}</em> 訊號</span>`,
    (sn, s) => `<span class="tk"><b>${sn}＊＊</b> 解鎖咗 <em>${s.n}</em> 完整報告</span>`,
  ]
  const items = []
  for (let i = 0; i < 14; i++) {
    const s = HK_STOCKS[Math.floor(Math.random() * HK_STOCKS.length)]
    const sn = surnames[Math.floor(Math.random() * surnames.length)]
    const tpl = tpls[Math.floor(Math.random() * tpls.length)]
    items.push(tpl(sn, s))
  }
  const html = items.join('<span class="tk-dot">·</span>')
  document.getElementById('tickerTrack').innerHTML = `${html}<span class="tk-dot">·</span>${html}`
}

// ── init ──
document.addEventListener('DOMContentLoaded', () => {
  initParticles()
  setupAutocomplete()
  runStats()
  buildTicker()
  document.getElementById('diagBtn').addEventListener('click', startAnalysis)
  document.getElementById('stockInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter')
      startAnalysis()
  })
  document.querySelectorAll('.chip').forEach(ch => ch.addEventListener('click', () => {
    document.getElementById('stockInput').value = `${ch.dataset.code} ${ch.dataset.name}`
    startAnalysis()
  }))
  document.getElementById('modalClose').addEventListener('click', closeModal)
  document.getElementById('modal').addEventListener('click', (e) => {
    if (e.target.id === 'modal')
      closeModal()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape')
      closeModal()
  })
})
</script>

  <!-- ═══════════ CSS ═══════════ -->
  <style is:global>
    :root {
      --bg: #070b18;
      --cyan: #22d3ee;
      --sky: #38bdf8;
      --teal: #2dd4bf;
      --up: #ff5a6a;     /* 港股紅漲 */
      --gold: #fbbf24;
      --wa: #25d366;     /* WhatsApp 綠 */
      --wa2: #1fb457;
      --tx: #f1f5f9;
      --tx2: #9fb0c4;
      --tx3: #5a6b80;
      --line: rgba(34, 211, 238, .14);
    }

    html { -webkit-text-size-adjust: 100%; }
    body {
      background: var(--bg);
      color: var(--tx);
      font-family: 'Noto Sans HK', system-ui, -apple-system, sans-serif;
      margin: 0;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    .num, .eyebrow span, .scan-sub, .m-val, .dd-code, .logs i { font-family: 'Space Grotesk', 'Noto Sans HK', sans-serif; }

    /* ── 背景 ── */
    .bg-particles { position: fixed; inset: 0; z-index: 0; }
    .bg-aurora { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .aurora { position: absolute; border-radius: 50%; filter: blur(70px); }
    .aurora.a1 { top: -18%; left: -10%; width: 70vw; height: 70vw; max-width: 520px; max-height: 520px; background: radial-gradient(circle, rgba(34, 211, 238, .16), transparent 68%); animation: aurora1 16s ease-in-out infinite; }
