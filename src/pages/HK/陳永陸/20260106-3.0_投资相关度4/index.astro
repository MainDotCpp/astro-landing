---
import { ArrowRight, Award, BookOpen, CheckCircle, FileText, GraduationCap, Lightbulb, Menu, Star, Trophy, X, Users } from 'lucide-astro'
import ButtonAction from '@/components/ButtonAction.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '陳永陸 - 技術分析知識分享平台'
const description = '專業技術分析知識分享與學習交流平台，基於公開信息進行技術分析方法研究，專注於圖表分析與數據解讀的知識傳播'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  </Fragment>

  <div class="enterprise-site">
    <!-- Navigation -->
    <nav class="main-nav">
      <div class="nav-container">
        <div class="nav-brand">
          <span class="brand-text">陳永陸</span>
        </div>
        <div class="nav-overlay" id="navOverlay"></div>
        <div class="nav-menu" id="navMenu">
          <button class="nav-close" id="navClose" aria-label="Close navigation">
            <X />
          </button>
          <a href="#about" class="nav-link">關於</a>
          <a href="#knowledge" class="nav-link">知識內容</a>
          <a href="#learning" class="nav-link">學習資源</a>
          <a href="#community" class="nav-link">學習社區</a>
          <a href="javascript:void(0)" class="nav-cta link-btn">開始學習</a>
        </div>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
          <Menu id="menuIcon" />
          <X id="closeIcon" style="display: none;" />
        </button>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span>專業知識分享</span>
          </div>
          <h1 class="hero-title">技術分析知識分享與學習</h1>
          <p class="hero-subtitle">基於公開信息進行技術分析方法研究，專注於圖表分析與數據解讀的知識傳播。本網站僅提供學習及信息交流服務，不涉及任何商業推薦、投資建議或金融產品相關內容。</p>
          <div class="hero-actions">
            <a href="javascript:void(0)" class="btn-primary link-btn">
              <span>探索知識內容</span>
              <ArrowRight />
            </a>
            <a href="#profile" class="btn-secondary">
              <span>了解更多</span>
              <ArrowRight />
            </a>
          </div>
          <div class="hero-features">
            <div class="feature-item">
              <CheckCircle />
              <span>20+年專業經驗</span>
            </div>
            <div class="feature-item">
              <CheckCircle />
              <span>基於公開信息</span>
            </div>
            <div class="feature-item">
              <CheckCircle />
              <span>僅供學習目的</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Profile Section -->
    <section id="profile" class="section-profile">
      <div class="container">
        <div class="profile-container">
          <div class="profile-image-wrapper">
            <img src="/mjSFqQ/HK/images/陳永陸_avatar.png" alt="陳永陸" class="profile-image" />
            <div class="profile-badge">
              <Trophy />
              <span>20+年經驗</span>
            </div>
          </div>
          <div class="profile-content">
            <div class="profile-header">
              <div class="profile-name-wrapper">
                <h2 class="profile-name">陳永陸</h2>
                <p class="profile-title">資深技術分析師</p>
              </div>
              <div class="profile-tags">
                <span class="tag">技術分析</span>
                <span class="tag">圖表形態識別</span>
                <span class="tag">數據分析</span>
              </div>
            </div>
            <div class="profile-description">
              <p>陳永陸擁有超過20年的技術分析研究經驗，專注於圖表形態識別與技術指標應用的知識傳播。長期致力於基於公開信息進行技術分析方法研究，幫助學習者提升數據分析能力與技術研究水平。</p>
              <p>本網站所有內容均基於公開信息，僅供學習及信息交流目的，不涉及任何商業推薦、投資建議或金融產品相關內容。</p>
            </div>
            <div class="profile-stats">
              <div class="stat-item">
                <div class="stat-icon">
                  <Award />
                </div>
                <div class="stat-info">
                  <div class="stat-value">20+</div>
                  <div class="stat-label">年技術分析經驗</div>
                </div>
              </div>
              <div class="stat-item">
                <div class="stat-icon">
                  <Star />
                </div>
                <div class="stat-info">
                  <div class="stat-value">專業</div>
                  <div class="stat-label">圖表形態識別</div>
                </div>
              </div>
              <div class="stat-item">
                <div class="stat-icon">
                  <GraduationCap />
                </div>
                <div class="stat-info">
                  <div class="stat-value">系統化</div>
                  <div class="stat-label">知識傳播方法</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Platform -->
    <section id="about" class="section-about">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">關於</h2>
          <p class="section-description">專業的技術分析知識分享與學習交流</p>
        </div>
        <div class="about-grid">
          <div class="about-card">
            <div class="card-icon">
              <GraduationCap />
            </div>
            <h3 class="card-title">專業知識分享</h3>
            <p class="card-text">20年技術分析研究經驗，專注於圖表形態識別與技術指標應用的知識傳播。基於公開信息進行研究方法分享，不涉及任何商業推薦或投資建議。</p>
          </div>
          <div class="about-card">
            <div class="card-icon">
              <Users />
            </div>
            <h3 class="card-title">學習交流社區</h3>
            <p class="card-text">與其他學習者交流技術分析心得，分享圖表識別經驗，共同提升數據分析能力。本網站僅供學習及信息交流目的，不涉及任何交易相關內容。</p>
          </div>
          <div class="about-card">
            <div class="card-icon">
              <BookOpen />
            </div>
            <h3 class="card-title">系統化學習</h3>
            <p class="card-text">從基礎圖表分析到高級形態識別，系統化分享技術分析知識，適合不同水平的學習者。所有內容基於公開信息，僅供學習及研究目的。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Knowledge Content -->
    <section id="knowledge" class="section-knowledge">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">知識內容</h2>
          <p class="section-description">基於公開信息的技術分析方法研究與知識分享</p>
        </div>
        <div class="knowledge-grid">
          <div class="knowledge-card">
            <div class="card-number">01</div>
            <div class="card-content">
              <div class="card-icon-large">
                <FileText />
              </div>
              <h3 class="card-title">圖表形態識別</h3>
              <p class="card-text">學習頭肩頂、雙底、三角形、旗形等經典圖表形態的識別方法，了解形態分析的技術知識。基於公開信息進行學習研究，不涉及任何商業策略或投資建議。</p>
              <ul class="card-features">
                <li>形態識別方法</li>
                <li>圖表分析技巧</li>
                <li>數據解讀知識</li>
              </ul>
            </div>
          </div>

          <div class="knowledge-card">
            <div class="card-number">02</div>
            <div class="card-content">
              <div class="card-icon-large">
                <Lightbulb />
              </div>
              <h3 class="card-title">技術指標應用</h3>
              <p class="card-text">深入學習MACD、RSI、KDJ、布林帶等技術指標的組合應用方法，提升數據分析能力與技術研究水平。本內容僅供學習及研究目的，不涉及任何商業信號或投資建議。</p>
              <ul class="card-features">
                <li>指標組合應用</li>
                <li>數據分析方法</li>
                <li>技術研究技巧</li>
              </ul>
            </div>
          </div>

          <div class="knowledge-card">
            <div class="card-number">03</div>
            <div class="card-content">
              <div class="card-icon-large">
                <CheckCircle />
              </div>
              <h3 class="card-title">數據分析方法</h3>
              <p class="card-text">系統化學習數據分析的技術方法，了解價格波動的研究技巧，建立完善的技術分析知識體系。本內容僅供學習目的，不涉及任何商業策略或投資建議。</p>
              <ul class="card-features">
                <li>分析方法論</li>
                <li>研究技巧</li>
                <li>知識體系構建</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Resources -->
    <section id="learning" class="section-learning">
      <div class="container">
        <div class="learning-content">
          <div class="learning-text">
            <h2 class="section-title">學習資源</h2>
            <p class="section-description">豐富的技術分析知識資源，助您系統化學習</p>
            <div class="learning-list">
              <div class="learning-item">
                <div class="item-icon">
                  <CheckCircle />
                </div>
                <div class="item-content">
                  <h3 class="item-title">圖表分析知識</h3>
                  <p class="item-text">學習識別關鍵支撐位與阻力位的方法，了解突破形態的分析技巧。基於公開信息進行數據分析學習，不涉及任何商業建議。</p>
                </div>
              </div>
              <div class="learning-item">
                <div class="item-icon">
                  <CheckCircle />
                </div>
                <div class="item-content">
                  <h3 class="item-title">形態識別方法</h3>
                  <p class="item-text">學習識別頭肩頂、雙底等經典形態的方法，了解趨勢線繪製與斐波那契回調位的技術分析知識，僅供學習目的。</p>
                </div>
              </div>
              <div class="learning-item">
                <div class="item-icon">
                  <CheckCircle />
                </div>
                <div class="item-content">
                  <h3 class="item-title">指標組合研究</h3>
                  <p class="item-text">學習MACD、RSI、布林帶等指標的組合分析方法，了解成交量分析與價格動量的技術分析知識，基於公開信息進行學習。</p>
                </div>
              </div>
              <div class="learning-item">
                <div class="item-icon">
                  <CheckCircle />
                </div>
                <div class="item-content">
                  <h3 class="item-title">數據解讀技巧</h3>
                  <p class="item-text">學習貨幣對價格走勢的分析方法，了解數據波動的技術分析知識，基於公開信息進行學習，不涉及任何商業建議或投資建議。</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Community Section -->
    <section id="community" class="section-community">
      <div class="container">
        <div class="community-content">
          <div class="community-text">
            <h2 class="section-title">加入學習社區</h2>
            <p class="section-description">與其他學習者一起交流技術分析知識，分享圖表識別經驗，共同提升數據分析能力。本網站僅供學習及信息交流目的，不涉及任何商業推薦、投資建議或金融產品相關內容。</p>
            <a href="javascript:void(0)" class="btn-primary link-btn">
              <span>加入學習社區</span>
              <ArrowRight />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Section -->
    <section class="section-disclaimer">
      <div class="container">
        <div class="disclaimer-box">
          <h3 class="disclaimer-title">重要聲明</h3>
          <div class="disclaimer-content">
            <p>本網站僅提供技術分析知識分享與學習交流服務，基於公開信息進行技術分析方法研究。本網站不包含任何商業推薦、投資建議、金融產品推薦、交易建議、買賣建議或投資決定相關內容。</p>
            <p>本網站明確禁止任何形式的投資建議、金融產品推薦或交易建議。所有內容僅供學習及信息交流目的，不構成任何投資建議。請勿將本網站內容用於任何投資決策，投資決定應尋求專業投資顧問意見。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-column">
            <h4 class="footer-title">公司資訊</h4>
            <div class="footer-info">
              <p><strong>公司名稱：</strong>香港技術分析教育有限公司</p>
              <p><strong>註冊地址：</strong>香港中環</p>
              <p><strong>電話：</strong>+852 2876 3842</p>
              <p><strong>傳真：</strong>+852 2876 3843</p>
              <p><strong>電郵：</strong><a href="mailto:info@hktechanalysis.com">info@hktechanalysis.com</a></p>
              <p><strong>營業時間：</strong>週一至週五（香港時間）</p>
            </div>
          </div>
          <div class="footer-column">
            <h4 class="footer-title">知識內容</h4>
            <ul class="footer-links">
              <li><a href="javascript:void(0)">技術分析</a></li>
              <li><a href="javascript:void(0)">圖表形態識別</a></li>
              <li><a href="javascript:void(0)">數據分析方法</a></li>
              <li><a href="javascript:void(0)">技術指標研究</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h4 class="footer-title">學習資源</h4>
            <ul class="footer-links">
              <li><a href="javascript:void(0)">圖表分析知識</a></li>
              <li><a href="javascript:void(0)">形態識別方法</a></li>
              <li><a href="javascript:void(0)">指標組合研究</a></li>
              <li><a href="javascript:void(0)">數據解讀技巧</a></li>
            </ul>
          </div>
          <div class="footer-column">
            <h4 class="footer-title">關於</h4>
            <ul class="footer-links">
              <li><a href="#about">關於我哋</a></li>
              <li><a href="#knowledge">知識內容</a></li>
              <li><a href="#learning">學習資源</a></li>
              <li><a href="#community">學習社區</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p class="copyright">© 2026 香港技術分析教育有限公司. 版權所有.</p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<ButtonAction />

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }

  .enterprise-site {
    font-family: 'Inter', 'Noto Sans TC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #1a1a1a;
    line-height: 1.6;
    background: #ffffff;
    width: 100%;
    overflow-x: hidden;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Navigation */
  .main-nav {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.95);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .brand-text {
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    color: #4b5563;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #2563eb;
  }

  .nav-cta {
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: white;
    padding: 0.625rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: #1a1a1a;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle svg {
    width: 24px;
    height: 24px;
  }

  .nav-overlay {
    display: none;
  }

  .nav-close {
    display: none;
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: #1a1a1a;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .nav-close svg {
    width: 24px;
    height: 24px;
  }

  /* Hero Section */
  .hero-section {
    background: linear-gradient(135deg, #f8fafc 0%, #e0e7ff 50%, #f0f4ff 100%);
    padding: 6rem 0;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(37, 99, 235, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(124, 58, 237, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    padding: 0.625rem 1.25rem;
    border-radius: 24px;
    font-size: 0.875rem;
    font-weight: 600;
    width: fit-content;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #4b5563;
    line-height: 1.7;
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: white;
    padding: 1rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
  }

  .btn-primary:active {
