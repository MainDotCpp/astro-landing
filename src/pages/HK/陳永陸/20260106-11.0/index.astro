---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '陳永陸 - AI智能投資分析平台'
const description = '運用前沿AI技術同大數據分析，幫你提供專業市場洞察同投資策略'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  </Fragment>

  <div class="tech-landing">
    <!-- Animated Background -->
    <div class="animated-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>

    <div class="container">
      <!-- Header -->
      <header class="header-glass">
        <div class="header-content">
          <div class="profile-section">
            <div class="avatar-container">
              <img src="/HK/images/陳永陸_avatar.png" alt="陳永陸" class="avatar-img" />
              <div class="avatar-glow"></div>
              <div class="status-ring"></div>
            </div>
            <div class="profile-info">
              <h1 class="expert-name">陳永陸</h1>
              <div class="expert-badges">
                <span class="badge badge-primary">AI分析師</span>
                <span class="badge badge-secondary">港股專家</span>
              </div>
            </div>
          </div>
          <div class="header-stats">
            <div class="stat-item">
              <div class="stat-value">24/7</div>
              <div class="stat-label">實時監控</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">AI</div>
              <div class="stat-label">智能分析</div>
            </div>
          </div>
        </div>
      </header>

      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-glass">
          <div class="hero-content">
            <div class="hero-badge">
              <span class="badge-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                  <path d="M2 17L12 22L22 17" />
                  <path d="M2 12L12 17L22 12" />
                </svg>
              </span>
              <span class="badge-text">AI驅動 · 數據分析</span>
            </div>
            
            <h2 class="hero-headline">
              <span class="headline-line">智能投資</span>
              <span class="headline-line gradient-text">分析系統</span>
            </h2>

            <p class="hero-description">
              運用先進AI技術同大數據分析，實時監控市場變化，
              幫你提供資金流向、板塊強弱、關鍵價位同風險位置嘅深度分析
            </p>

            <div class="hero-cta">
              <a href="javascript:void(0)" class="cta-primary link-btn">
                <span>立即體驗</span>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7.5 15L12.5 10L7.5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a href="javascript:void(0)" class="cta-secondary link-btn">
                <span>了解更多</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats Section -->
      <section class="stats-section">
        <div class="stats-grid">
          <div class="stat-card-glass">
            <div class="stat-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" />
              </svg>
            </div>
            <div class="stat-content">
              <div class="stat-number">持續</div>
              <div class="stat-label">系統運作</div>
            </div>
          </div>

          <div class="stat-card-glass">
            <div class="stat-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                <path d="M2 17L12 22L22 17" />
                <path d="M2 12L12 17L22 12" />
              </svg>
            </div>
            <div class="stat-content">
              <div class="stat-number">24/7</div>
              <div class="stat-label">實時監控</div>
            </div>
          </div>

          <div class="stat-card-glass">
            <div class="stat-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 11L12 14L22 4" />
                <path d="M21 12V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H16" />
              </svg>
            </div>
            <div class="stat-content">
              <div class="stat-number">每日</div>
              <div class="stat-label">市場更新</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section class="features-section">
        <div class="section-header-glass">
          <h3 class="section-title">核心功能</h3>
          <p class="section-subtitle">專業分析工具，助你把握市場節奏</p>
        </div>

        <div class="features-grid">
          <div class="feature-card-glass">
            <div class="feature-number">01</div>
            <div class="feature-icon-wrapper">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 3V21H21" />
                <path d="M7 16L12 11L16 15L21 10" />
                <path d="M21 10V3H14" />
              </svg>
            </div>
            <h4 class="feature-title">資金流向分析</h4>
            <p class="feature-description">
              實時追蹤大資金動向，識別市場熱點同資金輪動節奏，
              幫你把握最佳投資時機
            </p>
            <div class="feature-highlight"></div>
          </div>

          <div class="feature-card-glass">
            <div class="feature-number">02</div>
            <div class="feature-icon-wrapper">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                <path d="M2 17L12 22L22 17" />
                <path d="M2 12L12 17L22 12" />
              </svg>
            </div>
            <h4 class="feature-title">板塊強弱判斷</h4>
            <p class="feature-description">
              深度分析各板塊相對強弱，了解市場結構變化，
              為投資決策提供專業參考
            </p>
            <div class="feature-highlight"></div>
          </div>

          <div class="feature-card-glass">
            <div class="feature-number">03</div>
            <div class="feature-icon-wrapper">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" />
                <path d="M12 6V12L16 14" />
              </svg>
            </div>
            <h4 class="feature-title">關鍵價位識別</h4>
            <p class="feature-description">
              智能標記重要技術位同風險位置，
              助你建立清晰嘅操作框架同止損策略
            </p>
            <div class="feature-highlight"></div>
          </div>

          <div class="feature-card-glass">
            <div class="feature-number">04</div>
            <div class="feature-icon-wrapper">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                <path d="M2 17L12 22L22 17" />
                <path d="M2 12L12 17L22 12" />
                <path d="M12 12L12 22" />
              </svg>
            </div>
            <h4 class="feature-title">風險評估系統</h4>
            <p class="feature-description">
              AI驅動風險評估，實時監控市場波動，
              幫你識別同規避潛在投資風險
            </p>
            <div class="feature-highlight"></div>
          </div>
        </div>
      </section>

      <!-- Data Visualization Section -->
      <section class="data-section">
        <div class="data-card-glass">
          <div class="data-header">
            <h3 class="data-title">實時市場數據</h3>
            <div class="data-status">
              <span class="status-dot"></span>
              <span>LIVE</span>
            </div>
          </div>

          <div class="metrics-grid">
            <div class="metric-item">
              <div class="metric-header">
                <span class="metric-label">資金流向</span>
                <span class="metric-value positive">持續監控</span>
              </div>
              <div class="metric-bar">
                <div class="metric-fill positive" style="width: 0%"></div>
              </div>
            </div>

            <div class="metric-item">
              <div class="metric-header">
                <span class="metric-label">板塊強弱</span>
                <span class="metric-value">實時分析</span>
              </div>
              <div class="metric-bar">
                <div class="metric-fill" style="width: 0%"></div>
              </div>
            </div>

            <div class="metric-item">
              <div class="metric-header">
                <span class="metric-label">關鍵價位</span>
                <span class="metric-value">每日更新</span>
              </div>
              <div class="metric-bar">
                <div class="metric-fill" style="width: 0%"></div>
              </div>
            </div>

            <div class="metric-item">
              <div class="metric-header">
                <span class="metric-label">風險評估</span>
                <span class="metric-value warning">持續評估</span>
              </div>
              <div class="metric-bar">
                <div class="metric-fill warning" style="width: 0%"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Value Proposition Section -->
      <section class="value-section">
        <div class="value-card-glass">
          <div class="value-content">
            <h3 class="value-title">點解選擇我哋？</h3>
            <div class="value-list">
              <div class="value-item">
                <div class="value-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 11L12 14L22 4" />
                    <path d="M21 12V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V5C3 3.9 3.9 3 5 3H16" />
                  </svg>
                </div>
                <div class="value-text">
                  <h4>專業分析框架</h4>
                  <p>基於多年市場經驗，建立系統化分析框架</p>
                </div>
              </div>

              <div class="value-item">
                <div class="value-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" />
                    <path d="M2 17L12 22L22 17" />
                    <path d="M2 12L12 17L22 12" />
                  </svg>
                </div>
                <div class="value-text">
                  <h4>AI技術驅動</h4>
                  <p>運用先進AI算法，提升分析準確度同效率</p>
                </div>
              </div>

              <div class="value-item">
                <div class="value-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21V19C17 17.9 16.1 17 15 17H9C7.9 17 7 17.9 7 19V21" />
                    <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" />
                  </svg>
                </div>
                <div class="value-text">
                  <h4>學習交流為主</h4>
                  <p>注重知識分享，助你建立獨立判斷能力</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section">
        <div class="cta-card-glass">
          <div class="cta-content">
            <h3 class="cta-title">準備好開始智能投資分析？</h3>
            <p class="cta-description">
              立即加入，獲取專業市場分析同投資建議，
              同我哋一齊探索市場機會
            </p>
            <div class="cta-buttons">
              <a href="javascript:void(0)" class="cta-button-primary link-btn">
                <span>立即加入</span>
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7.5 15L12.5 10L7.5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="footer-section">
        <div class="footer-glass">
          <p class="disclaimer">
            學習交流為主，投資有風險，請獨立判斷
          </p>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #0F172A;
    color: #F8FAFC;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .tech-landing {
    min-height: 100vh;
    position: relative;
    padding: 1.5rem 1.25rem;
  }

  /* Animated Background */
  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
    animation: floatOrb 20s infinite ease-in-out;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #8B5CF6 0%, transparent 70%);
    top: -300px;
    left: -300px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #3B82F6 0%, transparent 70%);
    top: 50%;
    right: -250px;
    animation-delay: 7s;
  }

  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #06B6D4 0%, transparent 70%);
    bottom: -200px;
    left: 50%;
    animation-delay: 14s;
  }

  @keyframes floatOrb {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(50px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-30px, 30px) scale(0.9);
    }
  }

  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridMove 30s linear infinite;
    opacity: 0.4;
  }

  @keyframes gridMove {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(60px, 60px);
    }
  }

  /* Glassmorphism Base */
  .glass-base {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Header */
  .header-glass {
    margin-bottom: 2rem;
  }

  .header-content {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 1.5rem;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .profile-section {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
  }

  .avatar-container {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(139, 92, 246, 0.5);
    position: relative;
    z-index: 2;
  }

  .avatar-glow {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.6) 0%, transparent 70%);
    animation: pulseGlow 3s infinite ease-in-out;
    z-index: 1;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .status-ring {
    position: absolute;
    top: -6px;
    left: -6px;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: #8B5CF6;
    border-right-color: #3B82F6;
    animation: rotateRing 3s linear infinite;
    z-index: 0;
  }

  @keyframes rotateRing {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .profile-info {
    flex: 1;
  }

  .expert-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .expert-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .badge-primary {
    background: rgba(139, 92, 246, 0.2);
    color: #C4B5FD;
    border: 1px solid rgba(139, 92, 246, 0.3);
  }

  .badge-secondary {
    background: rgba(59, 130, 246, 0.2);
    color: #93C5FD;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .header-stats {
    display: flex;
    gap: 1.5rem;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  /* Hero Section */
  .hero-section {
    margin-bottom: 2rem;
  }

  .hero-glass {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 28px;
    padding: 3rem 2rem;
    box-shadow:
      0 12px 48px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 20px;
    margin-bottom: 1.5rem;
  }

  .badge-icon {
    color: #C4B5FD;
  }

  .badge-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #C4B5FD;
    letter-spacing: 0.02em;
  }

  .hero-headline {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .headline-line {
    display: block;
    color: #FFFFFF;
  }

  .gradient-text {
    background: linear-gradient(135deg, #8B5CF6 0%, #3B82F6 50%, #06B6D4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 1rem 2rem;
    font-size: 1.0625rem;
    font-weight: 600;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease-out;
    cursor: pointer;
  }

