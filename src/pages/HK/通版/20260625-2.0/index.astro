    .asym-rows { display: flex; flex-direction: column; gap: 12px; padding: 16px 14px 0; }
    .asym-row { display: flex; align-items: center; gap: 11px; }
    .asym-side { flex-shrink: 0; width: 58px; display: flex; align-items: center; gap: 6px; font-size: .8rem; font-weight: 700; color: var(--tx); }
    .asym-ico { width: 18px; height: 18px; flex-shrink: 0; }
