    .steps { margin-top: 30px; display: flex; flex-direction: column; gap: 12px; }
    .step { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 14px; background: rgba(255, 255, 255, .02); border: 1px solid rgba(255, 255, 255, .05); }
    .step-n { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, var(--cyan), var(--sky)); color: #04121b; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: .9rem; }
