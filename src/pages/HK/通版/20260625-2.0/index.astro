    .sc-btn svg { width: 18px; height: 18px; }

    /* ── keyframes ── */
    @keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(.8); } }
    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
    @keyframes waPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.015); } }
    @keyframes aur1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(6%, 5%) scale(1.1); } }
    @keyframes aur2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-7%, -4%) scale(1.08); } }

    /* ── 桌面增強 ── */
    @media (min-width: 768px) {
      .hero-body, .hero-visual { max-width: 480px; }
      .title { font-size: 2.8rem; }
      .rec-amt { font-size: 2rem; }
      .rec-arrow svg { width: 62px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .aurora, .wa-cta, .tl-dot, .lp-led, .rec-led, .scroll-hint svg, .asym-caret { animation: none !important; }
