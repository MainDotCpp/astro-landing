    .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 200; display: flex; align-items: center; gap: 12px; padding: 11px 16px calc(11px + env(safe-area-inset-bottom)); background: rgba(8, 14, 28, .92); backdrop-filter: blur(14px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
    .sticky-cta.show { transform: none; }
    .sc-txt { flex: 1; min-width: 0; }
