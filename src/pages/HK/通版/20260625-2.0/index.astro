    .record { position: relative; margin-top: 0; border-radius: 14px; border: 1px solid var(--line); background: linear-gradient(165deg, rgba(34, 211, 238, .05), rgba(7, 11, 24, .45)); box-shadow: 0 20px 50px rgba(0, 0, 0, .4); overflow: hidden; }
    .rec-glow { position: absolute; top: -40%; right: -20%; width: 70%; height: 140%; background: radial-gradient(circle, rgba(255, 90, 106, .12), transparent 65%); pointer-events: none; }
