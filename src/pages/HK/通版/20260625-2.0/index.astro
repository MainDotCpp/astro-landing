    /* ── final CTA ── */
    .final-cta { margin-top: 36px; text-align: center; padding: 30px 22px; border-radius: 22px; border: 1px solid var(--line); background: linear-gradient(165deg, rgba(34, 211, 238, .06), rgba(45, 212, 191, .03) 50%, transparent); box-shadow: 0 0 70px rgba(34, 211, 238, .06); }
