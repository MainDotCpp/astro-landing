    .lp-stat.ok { color: var(--teal); background: rgba(45, 212, 191, .12); border: 1px solid rgba(45, 212, 191, .3); }
    .lp-stat.run { color: var(--cyan); background: rgba(34, 211, 238, .1); border: 1px solid rgba(34, 211, 238, .28); }
