    .hs-sep { width: 1px; height: 32px; background: rgba(255, 255, 255, .08); }

    .scroll-hint { display: flex; flex-direction: column; align-items: center; gap: 4px; margin: 34px auto 0; color: var(--tx3); font-size: .68rem; letter-spacing: .08em; }
    .scroll-hint svg { width: 18px; height: 18px; animation: bob 1.8s ease-in-out infinite; }

    /* ── 通用 section ── */
    .features, .proof { padding: 56px 22px; max-width: 480px; margin: 0 auto; }

    /* 終端標題行（取代 sec-head + eyebrow-txt chip）*/
    .term-title { position: relative; font-size: clamp(1.3rem, 5vw, 1.62rem); font-weight: 800; line-height: 1.4; color: #fff; margin: 0 0 22px; letter-spacing: -.01em; padding-left: 14px; border-left: 2px solid var(--cyan); }
