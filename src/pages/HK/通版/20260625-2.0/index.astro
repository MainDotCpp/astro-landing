    .asym-foot b { color: var(--cyan); font-weight: 700; }

    /* ── 解碼日誌 終端面板（取代通用卡片流）── */
    .logpanel { margin-bottom: 16px; border-radius: 14px; border: 1px solid var(--line); background: linear-gradient(180deg, rgba(7, 11, 24, .55), rgba(7, 11, 24, .35)); box-shadow: 0 18px 44px rgba(0, 0, 0, .4); overflow: hidden; }
