    .asym-bar { flex: 1; height: 10px; border-radius: 6px; background: rgba(255, 255, 255, .05); overflow: hidden; }
    .asym-fill { display: block; height: 100%; border-radius: 6px; width: 0; transition: width 1.2s cubic-bezier(.2, .7, .2, 1) .2s; }
    .reveal.in .asym-fill.inst, .asym .asym-fill.inst { background: linear-gradient(90deg, var(--cyan), var(--teal)); box-shadow: 0 0 12px rgba(34, 211, 238, .5); }
    .asym .asym-fill.retail { background: rgba(120, 140, 160, .4); }
    .asym-read { flex-shrink: 0; width: 46px; text-align: right; font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .asym-read small { font-size: .62rem; font-weight: 500; margin-left: 1px; }
