---
import { getImage } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import heroSrc from './images/hero.png'

const title = '破解機構交易密碼 · 散戶唔再輸喺資訊不對稱 | 港股科技股實戰社群'
const description = '專注一線 research，拆解機構 trade 嘅底層 logic，幫散戶早一步捉到科技股下一個升浪。每日實戰 re-cap、行情主線拆解，幫你建立屬於自己嘅 Trading System。'

const heroImg = await getImage({ src: heroSrc, format: 'webp', width: 880, quality: 76 })
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@400;500;700;900&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <!-- ═══════════ 背景層 ═══════════ -->
  <canvas id="particles-bg" class="bg-particles"></canvas>
  <div class="bg-aurora" aria-hidden="true">
    <span class="aurora a1"></span>
    <span class="aurora a2"></span>
  </div>
  <div class="bg-grid" aria-hidden="true"></div>

  <div class="page">
    <!-- ═══════════ 屏 1 · HERO ═══════════ -->
    <section class="hero">
      <div class="hero-visual reveal" id="heroVisual">
        <img src={heroImg.src} alt="機構交易密碼解碼示意" loading="eager" fetchpriority="high" />
      </div>

      <div class="hero-body">
        <h1 class="title reveal">
          破解機構交易密碼<br />
          散戶唔再輸喺<span class="grad scramble" data-final="資訊不對稱">資訊不對稱</span>
