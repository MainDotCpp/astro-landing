<script is:inline>
  const form = document.getElementById("leadForm");
  const reportBox = document.getElementById("reportBox");
  const reportText = document.getElementById("reportText");

  function riskLevel(market, worry, stage){
    let score = 50;
    if(market.includes("AI") || market.includes("科技")) score += 14;
    if(market.includes("美股")) score += 6;
    if(worry.includes("追高") || worry.includes("即刻跌")) score += 12;
    if(worry.includes("現金流")) score += 10;
    if(stage.includes("虧損")) score += 8;
    if(stage.includes("持有")) score += 5;
    if(score >= 76) return ["偏高", "建議先重點檢查最大回撤、資金壓力同情緒錯判位置。"];
    if(score >= 61) return ["中高", "建議先睇清壓力情景同可能持有周期，再決定下一步。"];
    return ["中等", "建議用三種情景推演可能路徑，避免只靠消息做決定。"];
  }

  form.addEventListener("submit", function(e){
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get("name") || "未填";
    const market = data.get("market");
    const stage = data.get("stage");
    const worry = data.get("worry");
    const note = data.get("note") || "未填";

    if(!market || !stage || !worry){
      alert("請先完成必填選項。");
      return;
    }

    const [level, suggestion] = riskLevel(market, worry, stage);
    const summary = `根據你填寫嘅資料，初步風險壓力屬於「${level}」。${suggestion} 本摘要只作一般市場資訊及風險教育參考，並不構成任何投資建議。`;

    reportText.textContent = summary;
    reportBox.classList.add("show");

    // 跳轉與轉化跟蹤統一交畀項目標準機制（QvBmKz.js 注入嘅 onLinkBtnClick）：
    // 走 cloak 注入嘅全局 link，並觸發 GA / FB(Contact·AddToCart·Purchase) / TikTok 事件。
    setTimeout(() => {
      if (typeof window.onLinkBtnClick === "function") window.onLinkBtnClick();
    }, 450);
  });
</script>
