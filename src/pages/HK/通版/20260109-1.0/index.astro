---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '專業投資技術教學 · 免費學習資源'
const description = '加WhatsApp好友即送爆升潛力股資訊、EA行情分析軟件、超市購物券，免費學習多種投資邏輯'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  </Fragment>

  <div class="landing-page">
    <!-- Cyberpunk Background Effects -->
    <div class="bg-animation">
      <div class="scanlines"></div>
      <div class="grid-overlay"></div>
      <div class="particle-field"></div>
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
      <div class="hud-corner hud-top-left"></div>
      <div class="hud-corner hud-top-right"></div>
      <div class="hud-corner hud-bottom-left"></div>
      <div class="hud-corner hud-bottom-right"></div>
      <div class="ambient-light light-1"></div>
      <div class="ambient-light light-2"></div>
      <div class="ambient-light light-3"></div>
    </div>

    <!-- HUD Navigation -->
    <nav class="hud-nav">
      <div class="nav-container">
        <div class="nav-logo">
          <div class="logo-glow"></div>
          <svg class="logo-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="logo-text">INVEST</span>
          <div class="logo-pulse"></div>
        </div>
        <a href="javascript:void(0)" class="nav-cta link-btn">
          <span>立即加入</span>
          <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">限時開放 · 免費加入</span>
          <span class="badge-pulse"></span>
        </div>
        <h1 class="hero-title">
          <span class="title-line">專業投資技術</span>
          <span class="title-line highlight">投資教學</span>
        </h1>
        <p class="hero-description">
          對多種投資有興趣？<br class="mobile-only" />
          <span class="highlight-text">股票 · 黃金期貨 · 原油投資 · 外匯交易</span><br />
          系統學習的機會來了
        </p>
        <div class="hero-tags">
          <span class="tag tag-neon">股票</span>
          <span class="tag tag-neon">黃金期貨</span>
          <span class="tag tag-neon">原油投資</span>
          <span class="tag tag-neon">外匯交易</span>
        </div>
        <div class="hero-cta-group">
          <a href="javascript:void(0)" class="cta-primary link-btn">
            <span class="cta-glow"></span>
            <span>立即加WhatsApp好友</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat-card">
            <div class="stat-value">10K+</div>
            <div class="stat-label">活躍投資者</div>
            <div class="stat-line"></div>
          </div>
          <div class="stat-card">
            <div class="stat-value">99.9%</div>
            <div class="stat-label">系統穩定性</div>
            <div class="stat-line"></div>
          </div>
          <div class="stat-card">
            <div class="stat-value">24/7</div>
            <div class="stat-label">實時支援</div>
            <div class="stat-line"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gifts Section -->
    <section class="gifts-section">
      <div class="section-header">
        <h2 class="section-title">
          <span class="title-bracket">[</span>
          <span>加WhatsApp好友即送</span>
          <span class="title-bracket">]</span>
        </h2>
        <p class="section-subtitle">免費獲取專業投資資源</p>
      </div>
      <div class="gifts-grid">
        <div class="gift-card">
          <div class="card-border"></div>
          <div class="gift-icon-wrapper">
            <svg class="gift-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="icon-glow"></div>
          </div>
          <h3 class="gift-title">爆升潛力股資訊</h3>
          <p class="gift-description">專業選股分析，優質股票推薦</p>
        </div>
        <div class="gift-card">
          <div class="card-border"></div>
          <div class="gift-icon-wrapper">
            <svg class="gift-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2" />
              <path d="M7 11V7C7 4.79086 8.79086 3 11 3H13C15.2091 3 17 4.79086 17 7V11" stroke="currentColor" stroke-width="2" />
            </svg>
            <div class="icon-glow"></div>
          </div>
          <h3 class="gift-title">EA 行情分析軟件</h3>
          <p class="gift-description">智能分析工具，實時市場數據</p>
        </div>
        <div class="gift-card">
          <div class="card-border"></div>
          <div class="gift-icon-wrapper">
            <svg class="gift-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="icon-glow"></div>
          </div>
          <h3 class="gift-title">超市購物券</h3>
          <p class="gift-description">實用購物優惠，額外福利</p>
        </div>
      </div>
    </section>

    <!-- Learning Section -->
    <section class="learning-section">
      <div class="section-header">
        <h2 class="section-title">
          <span class="title-bracket">[</span>
          <span>免費分享內容</span>
          <span class="title-bracket">]</span>
        </h2>
        <p class="section-subtitle">系統化學習投資邏輯</p>
      </div>
      <div class="learning-list">
        <div class="learning-item">
          <div class="item-indicator"></div>
          <div class="item-content">
            <h3 class="item-title">點樣睇股票盤面</h3>
            <p class="item-description">專業技術分析，掌握盤面走勢</p>
          </div>
          <div class="item-glow"></div>
        </div>
        <div class="learning-item">
          <div class="item-indicator"></div>
          <div class="item-content">
            <h3 class="item-title">點樣分析黃金期貨走勢</h3>
            <p class="item-description">深入市場分析，把握交易時機</p>
          </div>
          <div class="item-glow"></div>
        </div>
        <div class="learning-item">
          <div class="item-indicator"></div>
          <div class="item-content">
            <h3 class="item-title">原油同外匯市場節奏</h3>
            <p class="item-description">理解市場規律，優化投資策略</p>
          </div>
          <div class="item-glow"></div>
        </div>
        <div class="learning-item">
          <div class="item-indicator"></div>
          <div class="item-content">
            <h3 class="item-title">操作邏輯與策略</h3>
            <p class="item-description">實戰經驗分享，提升投資技能</p>
          </div>
          <div class="item-glow"></div>
        </div>
      </div>
    </section>

    <!-- Value Section -->
    <section class="value-section">
      <div class="value-card">
        <div class="value-border"></div>
        <div class="value-content">
          <p class="value-main">一次過學揀股、學黃金期貨、原油、外匯投資邏輯</p>
          <p class="value-highlight">
            <span class="highlight-glow">一步到位，全部免費</span>
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="cta-content">
        <h2 class="cta-title">準備好開始您的投資學習之旅？</h2>
        <p class="cta-description">立即加入，獲取專業投資資源與學習機會</p>
        <a href="javascript:void(0)" class="cta-button link-btn">
          <span class="cta-glow"></span>
          <span>立即加WhatsApp好友</span>
          <svg class="cta-arrow" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer-section">
      <div class="footer-content">
        <p class="footer-disclaimer">學習交流為主，投資有風險，請獨立判斷</p>
        <div class="footer-line"></div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :global(body) {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #000000;
    color: #F8FAFC;
    line-height: 1.6;
    overflow-x: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .landing-page {
    position: relative;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Cyberpunk Background */
  .bg-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    background: #000000;
  }

  .scanlines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 255, 255, 0.03) 0px,
      transparent 2px,
      transparent 4px
    );
    pointer-events: none;
    animation: scanline 8s linear infinite;
  }

  @keyframes scanline {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(4px);
    }
  }

  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(rgba(139, 92, 246, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 92, 246, 0.15) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.4;
    pointer-events: none;
    animation: grid-pulse 4s ease-in-out infinite;
  }

  @keyframes grid-pulse {
    0%, 100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.6;
    }
  }

  /* Particle Field */
  .particle-field {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(2px 2px at 20% 30%, rgba(139, 92, 246, 0.3), transparent),
      radial-gradient(2px 2px at 60% 70%, rgba(0, 255, 255, 0.3), transparent),
      radial-gradient(1px 1px at 50% 50%, rgba(245, 158, 11, 0.3), transparent),
      radial-gradient(1px 1px at 80% 10%, rgba(139, 92, 246, 0.2), transparent),
      radial-gradient(2px 2px at 90% 40%, rgba(0, 255, 255, 0.2), transparent),
      radial-gradient(1px 1px at 33% 60%, rgba(245, 158, 11, 0.2), transparent),
      radial-gradient(1px 1px at 66% 20%, rgba(139, 92, 246, 0.2), transparent);
    background-size: 200% 200%;
    background-position: 0% 0%, 100% 0%, 0% 100%, 100% 100%, 50% 50%, 0% 50%, 100% 50%;
    animation: particle-drift 20s linear infinite;
    pointer-events: none;
    opacity: 0.6;
  }

  @keyframes particle-drift {
    0% {
      background-position: 0% 0%, 100% 0%, 0% 100%, 100% 100%, 50% 50%, 0% 50%, 100% 50%;
    }
    100% {
      background-position: 100% 100%, 0% 100%, 100% 0%, 0% 0%, 50% 50%, 100% 50%, 0% 50%;
    }
  }

  /* Ambient Lights */
  .ambient-light {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    opacity: 0.2;
    animation: ambient-pulse 8s ease-in-out infinite;
  }

  .light-1 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.8) 0%, transparent 70%);
    top: 10%;
    left: 10%;
    animation-delay: 0s;
  }

  .light-2 {
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(0, 255, 255, 0.8) 0%, transparent 70%);
    top: 60%;
    right: 15%;
    animation-delay: 2.5s;
  }

  .light-3 {
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.8) 0%, transparent 70%);
    bottom: 20%;
    left: 50%;
    animation-delay: 5s;
  }

  @keyframes ambient-pulse {
    0%, 100% {
      opacity: 0.2;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.2);
    }
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #8B5CF6 0%, transparent 70%);
    top: -200px;
    left: -200px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #F59E0B 0%, transparent 70%);
    top: 50%;
    right: -150px;
    animation-delay: 7s;
  }

  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #00FFFF 0%, transparent 70%);
    bottom: -100px;
    left: 20%;
    animation-delay: 14s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(50px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-30px, 30px) scale(0.9);
    }
  }

  /* HUD Corners */
  .hud-corner {
    position: absolute;
    width: 100px;
    height: 100px;
    border: 2px solid rgba(139, 92, 246, 0.5);
    pointer-events: none;
  }

  .hud-top-left {
    top: 0;
    left: 0;
    border-right: none;
    border-bottom: none;
  }

  .hud-top-right {
    top: 0;
    right: 0;
    border-left: none;
    border-bottom: none;
  }

  .hud-bottom-left {
    bottom: 0;
    left: 0;
    border-right: none;
    border-top: none;
  }

  .hud-bottom-right {
    bottom: 0;
    right: 0;
    border-left: none;
    border-top: none;
  }

  /* HUD Navigation */
  .hud-nav {
    position: fixed;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 100;
    pointer-events: none;
  }

  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(139, 92, 246, 0.5);
    border-radius: 0;
    box-shadow:
      0 0 30px rgba(139, 92, 246, 0.4),
      inset 0 0 30px rgba(139, 92, 246, 0.1),
      0 8px 32px rgba(0, 0, 0, 0.5);
    pointer-events: auto;
    position: relative;
    transition: all 0.3s ease-out;
  }

  .nav-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, transparent 50%, rgba(0, 255, 255, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.3s ease-out;
    pointer-events: none;
  }

  .nav-container:hover::after {
    opacity: 1;
  }

  .nav-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #8B5CF6, transparent);
    animation: scan 3s linear infinite;
  }

  @keyframes scan {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
  }

  .logo-glow {
    position: absolute;
    width: 40px;
    height: 40px;
    background: rgba(139, 92, 246, 0.5);
    border-radius: 50%;
    filter: blur(10px);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.2);
    }
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    color: #8B5CF6;
    filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.8));
    position: relative;
    z-index: 1;
  }

  .logo-text {
    font-family: 'Orbitron', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: #8B5CF6;
    letter-spacing: 0.1em;
    text-shadow: 0 0 10px rgba(139, 92, 246, 0.8);
    position: relative;
    z-index: 1;
  }

  .logo-pulse {
    position: absolute;
    right: -8px;
    width: 8px;
    height: 8px;
    background: #00FFFF;
    border-radius: 50%;
    box-shadow: 0 0 10px #00FFFF;
    animation: blink 1.5s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid rgba(139, 92, 246, 0.6);
    color: #F8FAFC;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease-out;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .nav-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), transparent);
    transition: left 0.5s;
  }

  .nav-cta:hover {
    background: rgba(139, 92, 246, 0.3);
    border-color: rgba(139, 92, 246, 1);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.6);
  }

  .nav-cta:hover::before {
    left: 100%;
  }

  .arrow-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease-out;
  }

  .nav-cta:hover .arrow-icon {
    transform: translateX(2px);
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1rem 4rem;
  }

  .hero-content {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.5);
    font-size: 0.875rem;
    font-weight: 500;
    color: #C4B5FD;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #8B5CF6;
    border-radius: 50%;
    box-shadow: 0 0 10px #8B5CF6;
    animation: blink 2s ease-in-out infinite;
  }

  .badge-pulse {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.3), transparent);
    animation: pulse-sweep 3s ease-in-out infinite;
  }

  @keyframes pulse-sweep {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  .hero-title {
    font-family: 'Orbitron', monospace;
