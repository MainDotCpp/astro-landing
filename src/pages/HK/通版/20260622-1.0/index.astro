---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '免費港股學習群 · 跟住學睇市'
const description = '唔識睇市、唔知由邊度睇起？加入免費 WhatsApp 群，每晚跟住拆解今日港股，由零開始學睇資金流同板塊輪動。'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&family=Noto+Sans+HK:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, viewport-fit=cover" />
    <meta name="theme-color" content="#06131e" />
  </Fragment>

  <main class="page">
    <!-- 第一屏 -->
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow"><span class="dot"></span>今晚 9:00 開班 · 一星期七晚</p>
        <h1>日日睇住啲股升，<br />自己淨係識喺度乾睇？</h1>
        <p class="lead">
          唔識睇市、唔知由邊度睇起，好正常啫。加入免費 WhatsApp 群，每晚同你拆解今日港股，一步步教你自己睇得明走勢。
        </p>
        <a href="javascript:void(0)" class="cta link-btn" onclick="onLinkBtnClick()">免費入 WhatsApp 群，今晚開始學睇市 →</a>
        <p class="proof">已經有 <strong>8,300+</strong> 個香港新手喺群入面一齊學緊</p>
      </div>
    </section>

    <!-- 第二屏 -->
    <section class="learn">
      <p class="section-kicker">入咗群，你會學到</p>
      <h2>由零開始，睇住睇住就會明。</h2>
      <div class="learn-list">
        <article>
          <span>01</span>
          <h3>每晚拆解今日港股</h3>
          <p>用人話講返今日邊個板塊有戲、點解會郁，唔使你自己喺度估。</p>
        </article>
        <article>
          <span>02</span>
          <h3>教你睇資金流同板塊輪動</h3>
          <p>分得清係真係有錢推上嚟，定只係一時炒作，唔使再人哋話咩就信咩。</p>
        </article>
        <article>
          <span>03</span>
          <h3>新手由零都跟得上</h3>
          <p>唔識啲專業名詞都唔怕，一步步教，你淨係要肯每晚睇一睇。</p>
        </article>
      </div>

      <div class="closing">
        <p class="section-kicker">今晚就可以開始</p>
        <h2>唔好再淨係喺度乾睇，今晚就跟住學第一堂。</h2>
        <a href="javascript:void(0)" class="cta cta-light link-btn" onclick="onLinkBtnClick()">免費入群，今晚開始學 →</a>
      </div>

      <p class="disclaimer">
        本群內容僅供一般資訊及學習參考，不構成任何投資建議。投資涉及風險，價格可升可跌。
      </p>
    </section>
  </main>

  <!-- 底部常駐 CTA -->
  <div class="sticky">
    <a href="javascript:void(0)" class="cta link-btn" onclick="onLinkBtnClick()">免費入群一齊學 →</a>
  </div>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #06131e;
    color: #f4fbff;
    font-family: 'Noto Sans HK', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  .page {
    min-height: 100vh;
    padding-bottom: 88px;
    background:
      radial-gradient(circle at 14% 4%, rgba(39, 240, 206, 0.18), transparent 36%),
      radial-gradient(circle at 92% 30%, rgba(230, 180, 81, 0.1), transparent 34%),
      #06131e;
  }

  /* ---------- 第一屏 ---------- */
  .hero {
    display: grid;
    min-height: 100svh;
    align-items: center;
    padding: 28px 20px 40px;
  }

  .hero-inner {
    max-width: 680px;
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    color: #6df3e9;
    font-size: 0.84rem;
    font-weight: 800;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #27f0ce;
    box-shadow: 0 0 0 6px rgba(39, 240, 206, 0.16);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 18px;
    font-size: clamp(2.6rem, 12.5vw, 5.2rem);
    line-height: 1.02;
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .lead {
    max-width: 600px;
    margin-bottom: 28px;
    color: rgba(244, 251, 255, 0.86);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .cta {
    display: flex;
    width: min(100%, 380px);
    min-height: 58px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 10px;
    background: #27f0ce;
    box-shadow: 0 18px 46px rgba(39, 240, 206, 0.26);
    color: #03110f;
    font-size: 1.05rem;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
  }

  .proof {
    margin: 18px 0 0;
    color: rgba(244, 251, 255, 0.6);
    font-size: 0.92rem;
  }

  .proof strong {
    color: #ffd98a;
  }

  /* ---------- 第二屏 ---------- */
  .learn {
    padding: 56px 20px 40px;
  }

  .learn h2 {
    margin-bottom: 26px;
    font-size: clamp(1.95rem, 8.5vw, 3.8rem);
    line-height: 1.1;
    font-weight: 900;
  }

  .learn-list {
    display: grid;
    gap: 12px;
  }

  .learn-list article {
    padding: 22px 20px;
    border: 1px solid rgba(109, 243, 233, 0.18);
    border-radius: 12px;
    background: rgba(8, 31, 48, 0.72);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .learn-list span {
    display: block;
    margin-bottom: 14px;
    color: rgba(230, 180, 81, 0.9);
    font-size: 0.95rem;
    font-weight: 900;
  }

  .learn-list h3 {
    margin-bottom: 8px;
    font-size: 1.22rem;
    font-weight: 900;
  }

  .learn-list p {
    margin-bottom: 0;
    color: rgba(244, 251, 255, 0.74);
    line-height: 1.65;
  }

  .closing {
    margin-top: 40px;
    padding: 36px 24px;
    border-radius: 16px;
    background: #effefe;
    color: #06131e;
  }

  .closing .section-kicker {
    color: #0c8f83;
  }

  .closing h2 {
    margin-bottom: 22px;
  }

  .cta-light {
    background: #06131e;
    color: #ffffff;
    box-shadow: none;
  }

  .disclaimer {
    margin: 28px 0 0;
    color: rgba(244, 251, 255, 0.4);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  /* ---------- 底部常駐 CTA ---------- */
  .sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, rgba(6, 19, 30, 0.05), rgba(6, 19, 30, 0.96) 32%);
  }

  .sticky .cta {
    width: 100%;
    min-height: 54px;
    margin: 0 auto;
  }

  /* ---------- 桌面渐进增强 ---------- */
  @media (min-width: 760px) {
    .page {
      padding-bottom: 0;
    }

    .hero {
      padding: 64px;
    }

    .learn {
      padding: 96px 64px;
    }

    .learn-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .closing {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 24px;
      padding: 48px;
    }

    .closing h2 {
      margin-bottom: 0;
    }

    .sticky {
      display: none;
    }
  }
</style>
