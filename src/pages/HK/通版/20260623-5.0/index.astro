        <div class="step"><span class="step-n">2</span><div><b>每朝收 AI 精選</b><p>開市前自動推送潛力股 + 訊號</p></div></div>
        <div class="step"><span class="step-n">3</span><div><b>跟住部署</b><p>照入場 / 止蝕位做，唔使自己估</p></div></div>
      </div>

      <div class="final-cta reveal">
        <h2>今朝嘅精選股，仲嚟得切</h2>
        <p>免費加入，即刻收到今日 AI 精選港股 + 完整買賣訊號</p>
        <a href="javascript:void(0)" onclick="onLinkBtnClick()" class="wa-cta" data-evt="final">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.43 1.32-1.97 1.4-.5.08-1.14.11-1.84-.12-.42-.13-.97-.31-1.66-.61-2.93-1.27-4.84-4.22-4.99-4.41-.15-.2-1.19-1.58-1.19-3.01 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.25.59.83 2.02.9 2.17.07.15.12.32.02.51-.09.2-.14.32-.27.49-.14.17-.29.38-.41.51-.14.14-.28.29-.12.57.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.21 1.36.27.14.43.12.59-.07.16-.2.68-.79.86-1.07.18-.27.36-.22.61-.13.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.12.07.69-.18 1.38Z"></path></svg>
          免費攞今日 AI 精選
        </a>
        <p class="risk">投資涉及風險，AI 分析僅供參考，買賣決定請自行判斷。</p>
      </div>
    </section>
  </div>

  <!-- ═══════════ 底部 STICKY CTA ═══════════ -->
  <div class="sticky-cta" id="stickyCta">
    <div class="sc-txt"><b>今日 AI 精選港股</b><span>免費送到 WhatsApp</span></div>
    <a href="javascript:void(0)" onclick="onLinkBtnClick()" class="sc-btn" data-evt="sticky">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.43 1.32-1.97 1.4-.5.08-1.14.11-1.84-.12-.42-.13-.97-.31-1.66-.61-2.93-1.27-4.84-4.22-4.99-4.41-.15-.2-1.19-1.58-1.19-3.01 0-1.43.75-2.13 1.02-2.42.27-.29.58-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.25.59.83 2.02.9 2.17.07.15.12.32.02.51-.09.2-.14.32-.27.49-.14.17-.29.38-.41.51-.14.14-.28.29-.12.57.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.21 1.36.27.14.43.12.59-.07.16-.2.68-.79.86-1.07.18-.27.36-.22.61-.13.25.09 1.6.75 1.87.89.27.14.45.2.52.32.07.12.07.69-.18 1.38Z"></path></svg>
      免費攞
    </a>
  </div>

  <!-- ═══════════ JS ═══════════ -->
  <script is:inline>
// ── 粒子背景（手寫 canvas，主線程，可靠可見）──
function initParticles() {
  const canvas = document.getElementById('particles-bg')
  if (!canvas)
    return
  const ctx = canvas.getContext('2d')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const mouse = { x: -999, y: -999 }
  const LINK = 140
  let W = 0
  let H = 0
  let dpr = 1
  let pts = []

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = window.innerWidth
    H = window.innerHeight
    canvas.width = W * dpr
    canvas.height = H * dpr
    canvas.style.width = `${W}px`
    canvas.style.height = `${H}px`
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
  }
  function build() {
    const count = Math.max(30, Math.min(64, Math.round(W * H / 17000)))
    pts = []
    for (let i = 0; i < count; i++) {
      pts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * (reduce ? 0.12 : 0.45),
        vy: (Math.random() - 0.5) * (reduce ? 0.12 : 0.45),
        r: Math.random() * 1.5 + 0.8,
      })
    }
  }
  function froze(p, q) {
    const d = Math.hypot(p.x - q.x, p.y - q.y)
    if (d < LINK) {
      ctx.globalAlpha = (1 - d / LINK) * 0.42
      ctx.strokeStyle = '#34d8ee'
      ctx.lineWidth = 1
      ctx.beginPath()
      ctx.moveTo(p.x, p.y)
      ctx.lineTo(q.x, q.y)
      ctx.stroke()
    }
  }
  function frame() {
    ctx.clearRect(0, 0, W, H)
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i]
      p.x += p.vx
      p.y += p.vy
      if (p.x < 0 || p.x > W)
        p.vx *= -1
      if (p.y < 0 || p.y > H)
        p.vy *= -1
      for (let j = i + 1; j < pts.length; j++) froze(p, pts[j])
      const md = Math.hypot(p.x - mouse.x, p.y - mouse.y)
      if (md < 170) {
        ctx.globalAlpha = (1 - md / 170) * 0.7
        ctx.strokeStyle = '#7fe9ff'
        ctx.lineWidth = 1.1
        ctx.beginPath()
        ctx.moveTo(p.x, p.y)
        ctx.lineTo(mouse.x, mouse.y)
        ctx.stroke()
      }
    }
    for (const p of pts) {
      ctx.globalAlpha = 0.15
      ctx.fillStyle = '#34d8ee'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r * 3, 0, Math.PI * 2)
      ctx.fill()
      ctx.globalAlpha = 0.92
      ctx.fillStyle = '#bdf1ff'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.globalAlpha = 1
    if (!reduce)
      requestAnimationFrame(frame)
  }

  resize()
  build()
  frame()
  window.addEventListener('resize', () => {
    resize()
    build()
  })
  window.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX
    mouse.y = e.clientY
  })
  window.addEventListener('pointerleave', () => {
    mouse.x = -999
    mouse.y = -999
  })
}

// ── 滾動入場 ──
function initReveal() {
  const els = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
  function check() {
    const h = window.innerHeight
    for (let i = els.length - 1; i >= 0; i--) {
      if (els[i].getBoundingClientRect().top < h * 0.88) {
        els[i].classList.add('in')
        els.splice(i, 1)
      }
    }
  }
  check()
  window.addEventListener('scroll', check, { passive: true })
  window.addEventListener('resize', check, { passive: true })
}

// ── 統計數字 ──
function runStats() {
  const el = document.getElementById('userCount')
  if (!el)
    return
  let n = 12400
  setInterval(() => {
    n += Math.floor(Math.random() * 3) + 1
    el.textContent = n.toLocaleString('en-US')
  }, 2800)
}

// ── 日期 ──
function setDate() {
  const el = document.getElementById('pvDate')
  if (!el)
    return
  const d = new Date()
  const w = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()]
  el.textContent = `${d.getMonth() + 1}月${d.getDate()}日 · 星期${w}`
}

// ── 底部 sticky CTA：滾動超過 hero 先顯示 ──
function initSticky() {
  const sc = document.getElementById('stickyCta')
  const hero = document.querySelector('.hero')
  if (!sc || !hero)
    return
  function check() {
    sc.classList.toggle('show', window.scrollY > hero.offsetHeight - 120)
  }
  check()
  window.addEventListener('scroll', check, { passive: true })
}

document.addEventListener('DOMContentLoaded', () => {
  initParticles()
  initReveal()
  runStats()
  setDate()
  initSticky()
})
</script>

  <!-- ═══════════ CSS ═══════════ -->
  <style is:global>
    :root {
      --bg: #070b18;
      --cyan: #22d3ee;
      --sky: #38bdf8;
      --teal: #2dd4bf;
      --up: #ff5a6a;
      --gold: #fbbf24;
      --wa: #25d366;
      --wa2: #1fb457;
      --tx: #f1f5f9;
      --tx2: #9fb0c4;
      --tx3: #5a6b80;
      --line: rgba(34, 211, 238, .14);
    }

    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--tx);
      font-family: 'Noto Sans HK', system-ui, -apple-system, sans-serif;
      margin: 0;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    .hs-n, .eyebrow span, .eyebrow-txt, .step-n, .pv-stock span { font-family: 'Space Grotesk', 'Noto Sans HK', sans-serif; }

    /* ── 背景 ── */
    .bg-particles { position: fixed; inset: 0; z-index: 0; }
    .bg-aurora { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .aurora { position: absolute; border-radius: 50%; filter: blur(70px); }
    .aurora.a1 { top: -15%; left: -12%; width: 70vw; height: 70vw; max-width: 480px; max-height: 480px; background: radial-gradient(circle, rgba(34, 211, 238, .15), transparent 68%); animation: aur1 17s ease-in-out infinite; }
    .aurora.a2 { bottom: 8%; right: -14%; width: 65vw; height: 65vw; max-width: 440px; max-height: 440px; background: radial-gradient(circle, rgba(45, 212, 191, .12), transparent 68%); animation: aur2 21s ease-in-out infinite; }
    .bg-grid {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: linear-gradient(rgba(34, 211, 238, .04) 1px, transparent 1px), linear-gradient(90deg, rgba(34, 211, 238, .04) 1px, transparent 1px);
      background-size: 46px 46px;
      mask-image: radial-gradient(ellipse 75% 55% at 50% 30%, #000 30%, transparent 78%);
      -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 30%, #000 30%, transparent 78%);
    }

    .page { position: relative; z-index: 1; }

    /* ── reveal ── */
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
    .reveal.in { opacity: 1; transform: none; }

    /* ── HERO ── */
