---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import {
  AlertCircle,
  ArrowRight,
  Award,
  BarChart3,
  Brain,
  Check,
  CheckCircle,
  Clock,
  Code,
  Cpu,
  Database,
  Lightbulb,
  LineChart,
  Shield,
  Sparkles,
  Star,
  Target,
  TrendingUp,
  Users,
  Zap,
} from 'lucide-astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

// Import generated images
import bgPremium1 from './static/images/bg-premium-1-new.jpg'
import bgPremium2 from './static/images/bg-premium-2-new.jpg'
import bgPremium3 from './static/images/bg-premium-3.jpg'
import heroBg from './static/images/hero-bg-new.jpg'
import successIllustration from './static/images/success-illustration-new.jpg'
import techIllustration from './static/images/tech-illustration-new.jpg'

export const getStaticPaths = (() => {
  return [
    { params: { version: '1.0' }, props: { title: 'AI智能投資系統 | 專業投資分析工具' } },
  ]
}) satisfies GetStaticPaths

const { title } = Astro.props

// Generate data particles array
const dataParticles = Array.from({ length: 20 }, (_, i) => ({
  id: i,
  left: Math.random() * 100,
  top: Math.random() * 100,
  delay: Math.random() * 10,
}))
---

<BaseLayout title={title} description="運用AI技術的智能投資分析工具，提供專業市場分析和投資建議，免費試用">
  <style>
    :global(body) {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', sans-serif;
      overflow-x: hidden;
      color: #F8FAFC;
      background: #000000;
    }

    /* Professional Fintech Color Palette - Subtle & Elegant */
    :root {
      --color-primary: #3B82F6;
      --color-primary-light: #60A5FA;
      --color-accent: #6366F1;
      --color-accent-light: #818CF8;
      --color-success: #10B981;
      --color-text-primary: #F8FAFC;
      --color-text-secondary: #CBD5E1;
      --color-text-muted: #94A3B8;
      --color-bg-dark: #0F172A;
      --color-bg-darker: #020617;
      --color-border: #1E293B;
    }

    /* Grid Background - Subtle */
    .grid-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image:
        linear-gradient(rgba(59, 130, 246, 0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 130, 246, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: 0;
      pointer-events: none;
    }

    /* Scanline Effect */
    .scanlines {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.15),
        rgba(0, 0, 0, 0.15) 1px,
        transparent 1px,
        transparent 2px
      );
      z-index: 1;
      pointer-events: none;
      animation: scanline-move 8s linear infinite;
    }

    @keyframes scanline-move {
      0% { transform: translateY(0); }
      100% { transform: translateY(100px); }
    }

    /* Neon Glow Effects */
    @keyframes neon-glow {
      0%, 100% {
        text-shadow:
          0 0 2px currentColor,
          0 0 4px currentColor,
          0 0 6px currentColor;
      }
      50% {
        text-shadow:
          0 0 1px currentColor,
          0 0 2px currentColor,
          0 0 3px currentColor;
      }
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow:
          0 0 3px currentColor,
          0 0 6px currentColor;
      }
      50% {
        box-shadow:
          0 0 5px currentColor,
          0 0 10px currentColor,
          0 0 15px currentColor;
      }
    }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slide-up {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes data-flow {
      0% { transform: translateX(-100%) translateY(0); opacity: 0; }
      50% { opacity: 1; }
      100% { transform: translateX(100vw) translateY(-100px); opacity: 0; }
    }

    .animate-fade-in {
      animation: fade-in 0.8s ease-out forwards;
    }

    .animate-slide-up {
      animation: slide-up 0.8s ease-out forwards;
    }

    .animate-neon {
      animation: neon-glow 2s ease-in-out infinite;
    }

    .animate-pulse-glow {
      animation: pulse-glow 2s ease-in-out infinite;
    }

    .animate-float {
      animation: float 3s ease-in-out infinite;
    }

    /* Glassmorphism - Professional */
    .glass {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.4),
        inset 0 0 20px rgba(59, 130, 246, 0.05);
    }

    .glass-strong {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      border: 1px solid rgba(59, 130, 246, 0.3);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.5),
        inset 0 0 30px rgba(59, 130, 246, 0.08);
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #0F172A;
    }

    .hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
      opacity: 0.3;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        180deg,
        rgba(15, 23, 42, 0.95) 0%,
        rgba(15, 23, 42, 0.85) 50%,
        rgba(2, 6, 23, 0.95) 100%
      );
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 3;
      max-width: 72rem;
      margin: 0 auto;
      padding: 1.5rem;
      text-align: center;
    }

    @media (min-width: 768px) {
      .hero-content {
        padding: 2rem;
      }
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #93C5FD;
      margin-bottom: 1.5rem;
      cursor: default;
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
    }

    @media (min-width: 768px) {
      .badge {
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        margin-bottom: 2rem;
      }
    }

    .stat-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 0.625rem;
      padding: 0.875rem 0.5rem;
      text-align: center;
      transition: all 0.3s ease;
      cursor: default;
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 640px) {
      .stat-card {
        padding: 1rem 0.75rem;
        border-radius: 0.75rem;
      }
    }

    @media (min-width: 768px) {
      .stat-card {
        border-radius: 1rem;
        padding: 1.25rem 1rem;
      }
    }

    @media (min-width: 1024px) {
      .stat-card {
        padding: 1.5rem;
      }
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        45deg,
        transparent,
        rgba(59, 130, 246, 0.08),
        transparent
      );
      transform: rotate(45deg);
      transition: all 0.5s;
    }

    .stat-card:hover::before {
      animation: shimmer 1.5s infinite;
    }

    .stat-card:hover {
      background: rgba(15, 23, 42, 0.8);
      border-color: rgba(59, 130, 246, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.3);
    }

    @keyframes shimmer {
      0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
      100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    .cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.875rem 1.5rem;
      min-height: 44px;
      font-size: 1rem;
      font-weight: 600;
      color: #FFFFFF;
      background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
      border: none;
      border-radius: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      box-shadow:
        0 4px 20px rgba(59, 130, 246, 0.4),
        0 0 30px rgba(59, 130, 246, 0.2);
      position: relative;
      overflow: hidden;
      width: 100%;
      max-width: 100%;
    }

    @media (min-width: 640px) {
      .cta-button {
        width: auto;
        padding: 1rem 2rem;
        font-size: 1.0625rem;
      }
    }

    @media (min-width: 768px) {
      .cta-button {
        padding: 1rem 2.5rem;
        font-size: 1.125rem;
      }
    }

    .cta-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s;
    }

    .cta-button:hover::before {
      left: 100%;
    }

    .cta-button:hover {
      background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
      box-shadow:
        0 6px 30px rgba(59, 130, 246, 0.5),
        0 0 40px rgba(59, 130, 246, 0.3);
      transform: translateY(-2px);
    }

    .cta-button:active {
      transform: translateY(0);
    }

    /* Section with Background */
    .section-with-bg {
      position: relative;
      overflow: hidden;
      background: #0F172A;
    }

    .section-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
      opacity: 0.2;
    }

    .section-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        180deg,
        rgba(15, 23, 42, 0.95) 0%,
        rgba(15, 23, 42, 0.98) 100%
      );
      z-index: 1;
    }

    .section-content {
      position: relative;
      z-index: 2;
      max-width: 72rem;
      margin: 0 auto;
      padding: 2.5rem 1rem;
    }

    @media (min-width: 640px) {
      .section-content {
        padding: 3.5rem 1.5rem;
      }
    }

    @media (min-width: 768px) {
      .section-content {
        padding: 4.5rem 2rem;
      }
    }

    @media (min-width: 1024px) {
      .section-content {
        padding: 5rem 2.5rem;
      }
    }

    /* Feature Card */
    .feature-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 0.875rem;
      padding: 1.25rem;
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 640px) {
      .feature-card {
        padding: 1.5rem;
        border-radius: 1rem;
      }
    }

    @media (min-width: 768px) {
      .feature-card {
        border-radius: 1.25rem;
        padding: 1.75rem;
      }
    }

    @media (min-width: 1024px) {
      .feature-card {
        border-radius: 1.5rem;
        padding: 2rem;
      }
    }

    .feature-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border: 2px solid transparent;
      border-radius: 1.5rem;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(99, 102, 241, 0.2)) padding-box,
                  linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(99, 102, 241, 0.3)) border-box;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .feature-card:hover::after {
      opacity: 1;
    }

    .feature-card:hover {
      background: rgba(15, 23, 42, 0.8);
      transform: translateY(-4px);
      box-shadow:
        0 20px 40px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(59, 130, 246, 0.2);
    }

    .feature-icon {
      width: 3rem;
      height: 3rem;
      background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
      border-radius: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      box-shadow:
        0 10px 30px rgba(59, 130, 246, 0.3),
        0 0 20px rgba(59, 130, 246, 0.15);
      position: relative;
    }

    @media (min-width: 768px) {
      .feature-icon {
        width: 4rem;
        height: 4rem;
        border-radius: 1rem;
        margin: 0 auto 1.5rem;
      }
    }

    .feature-icon::before {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 1rem;
      padding: 2px;
      background: linear-gradient(135deg, #3B82F6, #6366F1);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.3s;
    }

    .feature-card:hover .feature-icon::before {
      opacity: 1;
    }

    /* Testimonial Card */
    .testimonial-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-left: 3px solid #3B82F6;
      border-radius: 0.75rem;
      padding: 1.25rem;
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
    }

    @media (min-width: 640px) {
      .testimonial-card {
        padding: 1.5rem;
        border-radius: 1rem;
      }
    }

    @media (min-width: 768px) {
      .testimonial-card {
        padding: 2rem;
      }
    }

    .testimonial-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, #3B82F6, #6366F1);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .testimonial-card:hover::before {
      opacity: 1;
    }

    .testimonial-card:hover {
      background: rgba(15, 23, 42, 0.8);
      border-color: rgba(59, 130, 246, 0.4);
      transform: translateY(-2px);
      box-shadow:
        0 20px 40px rgba(0, 0, 0, 0.4),
        0 0 25px rgba(59, 130, 246, 0.2);
    }

    /* Stats Section */
    .stats-section {
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 1rem;
      padding: 2rem 1rem;
      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.5),
        inset 0 0 40px rgba(59, 130, 246, 0.08);
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 640px) {
      .stats-section {
        border-radius: 1.5rem;
        padding: 3rem 2rem;
      }
    }

    @media (min-width: 768px) {
      .stats-section {
        border-radius: 2rem;
        padding: 4rem 3rem;
      }
    }

    .stats-section::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
      animation: rotate 20s linear infinite;
    }

    @keyframes rotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .section-title {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-text-primary);
      line-height: 1.3;
      margin-bottom: 0.75rem;
    }

    @media (min-width: 640px) {
      .section-title {
        font-size: 2.25rem;
        margin-bottom: 0.875rem;
      }
    }

    @media (min-width: 768px) {
      .section-title {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }
    }

    @media (min-width: 1024px) {
      .section-title {
        font-size: 3rem;
      }
    }

    .section-subtitle {
      font-size: 1rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    @media (min-width: 640px) {
      .section-subtitle {
        font-size: 1.125rem;
      }
    }

    @media (min-width: 768px) {
      .section-subtitle {
        font-size: 1.25rem;
      }
    }

    .accent-text {
      color: #60A5FA;
      text-shadow:
        0 0 5px rgba(96, 165, 250, 0.5),
        0 0 10px rgba(96, 165, 250, 0.3);
    }

    .check-item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin: 0 0.75rem;
    }

    .partner-logo {
      padding: 1rem;
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(59, 130, 246, 0.1);
      border-radius: 0.75rem;
      transition: all 0.3s ease;
      cursor: default;
    }

    @media (min-width: 768px) {
      .partner-logo {
        padding: 1.5rem;
        border-radius: 1rem;
      }
    }

    .partner-logo:hover {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(59, 130, 246, 0.3);
      transform: translateY(-2px);
    }

    .fixed-bottom-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      display: flex;
      justify-content: center;
      padding: 1rem 1.5rem;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(59, 130, 246, 0.2);
      box-shadow:
        0 -4px 20px rgba(0, 0, 0, 0.6),
        0 0 15px rgba(59, 130, 246, 0.08);
    }

    .fixed-cta-btn {
      width: 100%;
      max-width: 500px;
      font-size: 1rem;
      padding: 0.875rem 1.5rem;
      min-height: 44px;
      background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
      color: #FFFFFF;
      border: none;
      border-radius: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow:
        0 4px 20px rgba(59, 130, 246, 0.4),
        0 0 25px rgba(59, 130, 246, 0.2);
    }

    .fixed-cta-btn:hover {
      background: linear-gradient(135deg, #2563EB 0%, #4F46E5 100%);
      box-shadow:
        0 6px 30px rgba(59, 130, 246, 0.5),
        0 0 35px rgba(59, 130, 246, 0.3);
      transform: translateY(-2px);
    }

    /* Data Flow Particles */
    .data-particles {
      position: absolute;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
      pointer-events: none;
    }

    .data-particle {
      position: absolute;
      width: 2px;
      height: 20px;
      background: linear-gradient(180deg, transparent, #00FFFF, transparent);
      opacity: 0.6;
      animation: data-flow 10s linear infinite;
    }

    /* Mobile Optimizations */
    @media (max-width: 639px) {
      .hero-section {
        min-height: 100svh;
      }

      .check-item {
        display: block;
        margin: 0.5rem 0;
        width: 100%;
        justify-content: center;
      }

      .grid-bg {
        background-size: 30px 30px;
      }

      .stats-section {
        padding: 1.5rem 1rem;
      }

      .partner-logo {
        padding: 0.875rem;
      }

      .partner-logo div {
        font-size: 0.875rem;
      }
    }

    /* Tablet Optimizations */
    @media (min-width: 640px) and (max-width: 1023px) {
      .hero-content {
        padding: 2rem 1.5rem;
      }
    }

    /* Prevent horizontal scroll */
    * {
      max-width: 100%;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="grid-bg"></div>
    <div class="scanlines"></div>
    <div class="data-particles">
      {dataParticles.map(particle => (
        <div
          class="data-particle"
          style={`left: ${particle.left}%; top: ${particle.top}%; animation-delay: ${particle.delay}s;`}
        />
      ))}
    </div>
    <Image
      src={heroBg}
      alt="Premium Investment Platform Background"
      class="hero-bg"
      width={1920}
      height={1080}
      loading="eager"
    />
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="animate-fade-in" style="animation-delay: 0.1s; opacity: 0;">
        <div class="badge">
          <Sparkles size={14} style="width: 14px; height: 14px;" />
          <span>AI驅動 · 智能投資 · 專業平台</span>
        </div>
      </div>

