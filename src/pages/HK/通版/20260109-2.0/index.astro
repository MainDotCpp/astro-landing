---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '趨勢跟蹤策略深度解析 · 專業投資技術分享'
const description = '深入解析趨勢跟蹤策略的技術原理與實戰應用，加WhatsApp好友獲取更多專業投資知識與策略分析'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  </Fragment>

  <div class="landing-page">
    <!-- Navigation -->
    <nav class="main-nav">
      <div class="nav-container">
        <div class="nav-logo">
          <span class="logo-text">STRATEGY</span>
        </div>
        <a href="javascript:void(0)" class="nav-cta link-btn" onclick="onLinkBtnClick()">
          <span>獲取策略</span>
        </a>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-decorative-bg">
        <svg class="trend-chart-svg" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="trendGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:0.15" />
              <stop offset="100%" style="stop-color:#D4AF37;stop-opacity:0.05" />
            </linearGradient>
          </defs>
          <path d="M20,150 Q100,100 180,80 T340,50" stroke="#D4AF37" stroke-width="2" fill="none" opacity="0.4" stroke-linecap="round" />
          <path d="M20,150 Q100,100 180,80 T340,50" stroke="url(#trendGradient)" stroke-width="3" fill="none" opacity="0.3" />
          <circle cx="20" cy="150" r="3" fill="#D4AF37" opacity="0.5" />
          <circle cx="340" cy="50" r="3" fill="#D4AF37" opacity="0.5" />
        </svg>
      </div>
      <div class="hero-image-container">
        <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/021767943926038f819a70ccfcb34f701bfee049253c600e5f425_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073209Z&X-Tos-Expires=86400&X-Tos-Signature=ce1df51388a427e9d292564464b79a568db179d0e0276d20943e0c32274d32c2&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="趨勢跟蹤策略專業投資分析" class="hero-main-image" />
      </div>
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-label">專業投資策略</div>
          <h1 class="hero-title">
            <span class="title-line">趨勢跟蹤</span>
            <span class="title-line accent">策略解析</span>
          </h1>
          <p class="hero-description">
            市場趨勢是投資者最可靠的盟友。通過系統化的技術分析與嚴謹的風險管理，<br />
            掌握趨勢跟蹤策略的核心邏輯，在波動中尋找確定性機會。
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-value">68.5%</div>
              <div class="stat-label">策略勝率</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">2.8:1</div>
              <div class="stat-label">風險回報比</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">1.85</div>
              <div class="stat-label">夏普比率</div>
            </div>
          </div>
          <a href="javascript:void(0)" class="hero-cta link-btn" onclick="onLinkBtnClick()">
            <span>加WhatsApp好友獲取完整策略</span>
            <svg class="cta-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Strategy Overview -->
    <section class="overview-section">
      <div class="section-container">
        <div class="section-header">
          <div class="section-number">01</div>
          <div class="section-content">
            <span class="section-label">核心原理</span>
            <h2 class="section-title">趨勢跟蹤策略架構</h2>
          </div>
        </div>
        <div class="overview-grid">
          <div class="overview-card main-card">
            <div class="card-image-wrapper">
              <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/021767943930495e94dfd37f88856a39045f6d12708556f92c433_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073213Z&X-Tos-Expires=86400&X-Tos-Signature=1145998a86b574ff39cd8c336b917a2c911c9d8087170f7b24a4dce73c671b7b&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="趨勢識別" class="card-image" />
            </div>
            <div class="card-icon">
              <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                <path d="M10,45 L20,35 L30,40 L40,25 L50,30" stroke="#D4AF37" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
                <circle cx="20" cy="35" r="2.5" fill="#D4AF37" opacity="0.8" />
                <circle cx="40" cy="25" r="2.5" fill="#D4AF37" opacity="0.8" />
              </svg>
            </div>
            <div class="card-number">01</div>
            <h3 class="card-title">趨勢識別</h3>
            <p class="card-description">
              運用移動平均線（MA）、MACD、ADX等技術指標，精確識別市場趨勢方向。通過多時間框架分析，確認趨勢的強度與持續性，為後續交易決策提供可靠依據。
            </p>
            <div class="card-features">
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>MA均線系統：20、50、200日移動平均線</span>
              </div>
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>MACD指標：動量與趨勢轉換識別</span>
              </div>
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>ADX趨勢強度：量化趨勢可靠性</span>
              </div>
            </div>
          </div>
          <div class="overview-card">
            <div class="card-image-wrapper">
              <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/021767943930495e94dfd37f88856a39045f6d12708556f92c433_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073213Z&X-Tos-Expires=86400&X-Tos-Signature=1145998a86b574ff39cd8c336b917a2c911c9d8087170f7b24a4dce73c671b7b&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="進場時機" class="card-image" />
            </div>
            <div class="card-icon">
              <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                <rect x="15" y="20" width="30" height="25" stroke="#D4AF37" stroke-width="2" fill="none" opacity="0.6" rx="2" />
                <line x1="20" y1="30" x2="40" y2="30" stroke="#D4AF37" stroke-width="2" opacity="0.6" />
                <line x1="30" y1="20" x2="30" y2="45" stroke="#D4AF37" stroke-width="2" opacity="0.6" />
                <circle cx="30" cy="30" r="3" fill="#D4AF37" opacity="0.8" />
              </svg>
            </div>
            <div class="card-number">02</div>
            <h3 class="card-title">進場時機</h3>
            <p class="card-description">
              在趨勢確認後，等待回調至關鍵支撐位或突破阻力位時進場。結合成交量分析與價格行為，優化進場點位，提高交易成功率。
            </p>
            <div class="card-features">
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>支撐阻力分析</span>
              </div>
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>成交量確認</span>
              </div>
            </div>
          </div>
          <div class="overview-card">
            <div class="card-image-wrapper">
              <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/021767943934797d522dfe667f11f532747f925ca69749c7ae501_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073218Z&X-Tos-Expires=86400&X-Tos-Signature=771443e783b4253965ad7d8a0a9e15aa688c3911f8cfae6d2c13657c9eb14ca2&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="風險管理" class="card-image" />
            </div>
            <div class="card-icon">
              <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                <path d="M30,15 L40,25 L35,25 L35,40 L25,40 L25,25 L20,25 Z" stroke="#D4AF37" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
                <circle cx="30" cy="15" r="3" fill="#D4AF37" opacity="0.8" />
              </svg>
            </div>
            <div class="card-number">03</div>
            <h3 class="card-title">風險管理</h3>
            <p class="card-description">
              設置動態止損位，根據ATR（平均真實波幅）調整止損距離。採用金字塔加倉與分批減倉策略，在保護資本的同時最大化收益。
            </p>
            <div class="card-features">
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>ATR動態止損</span>
              </div>
              <div class="feature-item">
                <span class="feature-dot"></span>
                <span>倉位管理系統</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Indicators -->
    <section class="indicators-section">
      <div class="section-container">
        <div class="section-header">
          <div class="section-number">02</div>
          <div class="section-content">
            <span class="section-label">技術指標</span>
            <h2 class="section-title">核心分析工具</h2>
          </div>
        </div>
        <div class="indicators-grid">
          <div class="indicator-card">
            <div class="indicator-visual">
              <svg viewBox="0 0 120 60" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="maGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" style="stop-color:#D4AF37;stop-opacity:0.2" />
                    <stop offset="100%" style="stop-color:#D4AF37;stop-opacity:0.05" />
                  </linearGradient>
                </defs>
                <path d="M10,50 L30,45 L50,40 L70,35 L90,30 L110,25" stroke="#8B7355" stroke-width="1.5" fill="none" opacity="0.4" stroke-dasharray="3,3" />
                <path d="M10,45 L30,42 L50,38 L70,33 L90,28 L110,23" stroke="#D4AF37" stroke-width="2" fill="none" opacity="0.6" />
                <path d="M10,50 L30,48 L50,45 L70,42 L90,38 L110,35" stroke="#D4AF37" stroke-width="1.5" fill="none" opacity="0.5" />
              </svg>
            </div>
            <div class="indicator-header">
              <h3 class="indicator-name">移動平均線</h3>
              <span class="indicator-code">MA(20, 50, 200)</span>
            </div>
            <div class="indicator-content">
              <div class="indicator-values">
                <div class="value-row">
                  <span class="value-label">MA(20)</span>
                  <span class="value-number">28,420</span>
                </div>
                <div class="value-row">
                  <span class="value-label">MA(50)</span>
                  <span class="value-number">28,380</span>
                </div>
                <div class="value-row">
                  <span class="value-label">MA(200)</span>
                  <span class="value-number">28,320</span>
                </div>
                <div class="value-row highlight">
                  <span class="value-label">當前價格</span>
                  <span class="value-number">28,450</span>
                </div>
              </div>
              <p class="indicator-desc">
                通過多條均線的排列與交叉，判斷趨勢方向。金叉確認上升趨勢，死叉確認下降趨勢。當前均線呈多頭排列，顯示上升趨勢強勁。
              </p>
            </div>
          </div>
          <div class="indicator-card">
            <div class="indicator-visual">
              <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/0217679439389495630b2fa661ac131412e72f6bdd3759f13c083_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073222Z&X-Tos-Expires=86400&X-Tos-Signature=37c7323da59d1186943002caf8fbb88b593e4fd571ba3d8b89b97e29b22ca257&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="MACD指標" class="indicator-image" />
              <svg viewBox="0 0 120 60" xmlns="http://www.w3.org/2000/svg" class="indicator-svg-overlay">
                <path d="M10,30 Q30,25 50,20 T90,15" stroke="#D4AF37" stroke-width="2" fill="none" opacity="0.6" />
                <path d="M10,35 Q30,32 50,28 T90,25" stroke="#8B7355" stroke-width="1.5" fill="none" opacity="0.5" stroke-dasharray="2,2" />
                <rect x="20" y="18" width="3" height="8" fill="#D4AF37" opacity="0.6" />
                <rect x="40" y="15" width="3" height="10" fill="#D4AF37" opacity="0.6" />
                <rect x="60" y="12" width="3" height="12" fill="#D4AF37" opacity="0.6" />
                <rect x="80" y="10" width="3" height="14" fill="#D4AF37" opacity="0.6" />
              </svg>
            </div>
            <div class="indicator-header">
              <h3 class="indicator-name">MACD指標</h3>
              <span class="indicator-code">MACD(12, 26, 9)</span>
            </div>
            <div class="indicator-content">
              <div class="indicator-values">
                <div class="value-row">
                  <span class="value-label">MACD線</span>
                  <span class="value-number positive">+2.12</span>
                </div>
                <div class="value-row">
                  <span class="value-label">信號線</span>
                  <span class="value-number">+1.85</span>
                </div>
                <div class="value-row highlight">
                  <span class="value-label">柱狀圖</span>
                  <span class="value-number positive">+2.35</span>
                </div>
                <div class="value-row">
                  <span class="value-label">狀態</span>
                  <span class="value-status positive">多頭信號</span>
                </div>
              </div>
              <p class="indicator-desc">
                通過MACD線與信號線的交叉，以及柱狀圖的變化，識別趨勢動能與轉折點。當前MACD線位於信號線上方，柱狀圖為正值，顯示強勁的多頭動能。
              </p>
            </div>
          </div>
          <div class="indicator-card">
            <div class="indicator-visual">
              <svg viewBox="0 0 120 60" xmlns="http://www.w3.org/2000/svg">
                <line x1="10" y1="50" x2="110" y2="50" stroke="#E5E5E5" stroke-width="1" opacity="0.5" />
                <line x1="10" y1="40" x2="110" y2="40" stroke="#E5E5E5" stroke-width="1" opacity="0.3" />
                <line x1="10" y1="30" x2="110" y2="30" stroke="#E5E5E5" stroke-width="1" opacity="0.3" />
                <path d="M10,50 L30,45 L50,38 L70,32 L90,28 L110,25" stroke="#D4AF37" stroke-width="2.5" fill="none" opacity="0.7" />
                <circle cx="110" cy="25" r="3" fill="#D4AF37" opacity="0.8" />
              </svg>
            </div>
            <div class="indicator-header">
              <h3 class="indicator-name">ADX趨勢強度</h3>
              <span class="indicator-code">ADX(14)</span>
            </div>
            <div class="indicator-content">
              <div class="indicator-values">
                <div class="value-row highlight">
                  <span class="value-label">ADX值</span>
                  <span class="value-number large">35</span>
                </div>
                <div class="value-row">
                  <span class="value-label">+DI</span>
                  <span class="value-number">28</span>
                </div>
                <div class="value-row">
                  <span class="value-label">-DI</span>
                  <span class="value-number">22</span>
                </div>
                <div class="value-row">
                  <span class="value-label">趨勢狀態</span>
                  <span class="value-status">中等強度</span>
                </div>
              </div>
              <div class="adx-levels">
                <div class="level-item">
                  <span class="level-range">弱勢 (0-20)</span>
                  <span class="level-bar"><span class="level-fill" style="width: 0%;"></span></span>
                </div>
                <div class="level-item">
                  <span class="level-range">震盪 (20-25)</span>
                  <span class="level-bar"><span class="level-fill" style="width: 0%;"></span></span>
                </div>
                <div class="level-item active">
                  <span class="level-range">強勢 (25+)</span>
                  <span class="level-bar"><span class="level-fill" style="width: 35%;"></span></span>
                </div>
              </div>
              <p class="indicator-desc">
                ADX值高於25表示趨勢強勁，適合趨勢跟蹤策略。當前ADX值為35，顯示市場處於中等強度趨勢中，適合採用趨勢跟蹤策略。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Performance Metrics -->
    <section class="performance-section">
      <div class="section-container">
        <div class="section-header">
          <div class="section-number">03</div>
          <div class="section-content">
            <span class="section-label">策略表現</span>
            <h2 class="section-title">回測數據分析</h2>
          </div>
        </div>
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="metric-image-wrapper">
              <img src="https://ark-content-generation-v2-cn-beijing.tos-cn-beijing.volces.com/doubao-seedream-3-0-t2i/021767943943334c7348914d5b1871f6564269127b52d1d34ff4f_0.jpeg?X-Tos-Algorithm=TOS4-HMAC-SHA256&X-Tos-Credential=AKLTYWJkZTExNjA1ZDUyNDc3YzhjNTM5OGIyNjBhNDcyOTQ%2F20260109%2Fcn-beijing%2Ftos%2Frequest&X-Tos-Date=20260109T073226Z&X-Tos-Expires=86400&X-Tos-Signature=dc2855003eb23dea80a517eb367bc00bbff6db4bbc9c3422b9e382453bf36e0c&X-Tos-SignedHeaders=host&x-tos-process=image%2Fwatermark%2Cimage_YXNzZXRzL3dhdGVybWFya192MS5wbmc_eC10b3MtcHJvY2Vzcz1pbWFnZS9yZXNpemUscF83OA%3D%3D%2Cx_69%2Cy_69" alt="策略表現數據" class="metric-image" />
