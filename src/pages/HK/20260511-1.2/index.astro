---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '全面投資領域覆蓋'
const description = '獲取優質股票推薦、專業交易分析軟件及實用購物優惠。'
---

<BaseLayout title={title} description={description} lang="zh-HK">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+HK:wght@500;700;800;900&family=Poppins:wght@700;800;900&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  </Fragment>

  <main class="page">
    <section class="hero">
      <div class="hero-inner">
        <h1>全面投資領域覆蓋</h1>
        <p class="subtitle">獲取優質股票推薦、專業交易分析軟件及實用購物優惠。</p>

        <div class="countdown" aria-label="限時優惠倒計時">
          <div class="countdown-label">
            <span aria-hidden="true">⏰</span>
            <span>限時優惠倒計時</span>
          </div>
          <div class="timer">
            <div class="time-box">
              <strong id="hours">00</strong>
              <span>小時</span>
            </div>
            <b>:</b>
            <div class="time-box">
              <strong id="minutes">56</strong>
              <span>分鐘</span>
            </div>
            <b>:</b>
            <div class="time-box">
              <strong id="seconds">36</strong>
              <span>秒</span>
            </div>
          </div>
        </div>

        <div class="badges" aria-label="領取狀態">
          <div class="badge"><span>✓</span>已有 <strong id="claim-count">2,928</strong> 人領取</div>
          <div class="badge"><span>🎁</span>100% 免費領取</div>
          <div class="badge"><span>🔒</span>僅限本次開放</div>
        </div>

        <a href="javascript:void(0)" class="cta cta-main link-btn">加入諮詢關注</a>
      </div>
    </section>

    <section class="bottom-cta" aria-label="加入諮詢關注">
      <a href="javascript:void(0)" class="cta cta-bottom link-btn">加入諮詢關注</a>
    </section>
  </main>
</BaseLayout>

<script>
  let totalSeconds = 56 * 60 + 36
  let claimedCount = 2928

  function updateCountdown() {
    const hours = Math.floor(totalSeconds / 3600)
    const minutes = Math.floor((totalSeconds % 3600) / 60)
    const seconds = totalSeconds % 60

    document.getElementById('hours')!.textContent = String(hours).padStart(2, '0')
    document.getElementById('minutes')!.textContent = String(minutes).padStart(2, '0')
    document.getElementById('seconds')!.textContent = String(seconds).padStart(2, '0')

    totalSeconds = totalSeconds > 0 ? totalSeconds - 1 : 56 * 60 + 36
  }

  function updateClaimCount() {
    claimedCount += Math.floor(Math.random() * 3) + 1
    document.getElementById('claim-count')!.textContent = claimedCount.toLocaleString('en-US')
  }

  updateCountdown()
  setInterval(updateCountdown, 1000)
  setInterval(updateClaimCount, 8000)
</script>

<style>
  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #ffffff;
    color: #ffffff;
    font-family: 'Noto Sans HK', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  .page {
    min-height: 100vh;
    background: #ffffff;
  }

  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 16%, rgba(255, 255, 255, 0.2), transparent 26%),
      radial-gradient(circle at 6% 72%, rgba(255, 255, 255, 0.15), transparent 32%),
      linear-gradient(135deg, #086dff 0%, #0057e7 100%);
    padding: 34px 16px 46px;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: min(100%, 760px);
    margin: 0 auto;
    text-align: center;
  }

  h1 {
    margin: 0 0 16px;
    color: #ffffff;
    font-family: 'Poppins', 'Noto Sans HK', sans-serif;
    font-size: clamp(2.55rem, 12.5vw, 4.8rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.08;
    text-wrap: balance;
  }

  .subtitle {
    max-width: 720px;
    margin: 0 auto 30px;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.05rem, 4.6vw, 1.55rem);
    font-weight: 800;
    line-height: 1.55;
  }

  .countdown {
    width: min(100%, 600px);
    margin: 0 auto 24px;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 18px 42px rgba(0, 45, 130, 0.24);
    padding: 22px 16px 24px;
  }

  .countdown-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 18px;
    color: #1c2638;
    font-size: 1.02rem;
    font-weight: 900;
  }

  .timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .timer b {
    color: #076bff;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2rem, 8vw, 3.2rem);
    line-height: 1;
  }

  .time-box {
    display: grid;
    width: 82px;
    min-height: 100px;
    place-items: center;
    border: 2px solid #e4ecff;
    border-radius: 12px;
    background: #f5f8ff;
    padding: 12px 8px;
  }

  .time-box strong {
    color: #086dff;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.35rem, 11vw, 3.7rem);
    font-weight: 900;
    line-height: 1;
  }

  .time-box span {
    color: #657083;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    width: min(100%, 620px);
    margin: 0 auto 28px;
  }

  .badge {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 10px 16px;
    font-size: 0.9rem;
    font-weight: 900;
    line-height: 1.2;
  }

  .badge strong {
    color: #ffe85a;
    font-weight: 900;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 330px);
    min-height: 62px;
    margin: 0 auto;
    border-radius: 999px;
    font-size: 1.08rem;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
  }

  .cta-main {
    background: #ffffff;
    box-shadow: 0 14px 32px rgba(0, 35, 100, 0.24);
    color: #086dff;
  }

  .bottom-cta {
    padding: 14px 16px 18px;
    background: #ffffff;
    box-shadow: 0 -12px 32px rgba(0, 54, 135, 0.12);
  }

  .cta-bottom {
    background: #086dff;
    box-shadow: 0 12px 28px rgba(8, 109, 255, 0.34);
    color: #ffffff;
  }

  @media (min-width: 720px) {
    .hero {
      padding: 54px 22px 66px;
    }

    .countdown {
      padding: 30px;
    }

    .timer {
      gap: 14px;
    }

    .time-box {
      width: 108px;
      min-height: 112px;
    }

    .badge {
      padding-inline: 22px;
      font-size: 1rem;
    }

    .cta {
      width: 360px;
      min-height: 66px;
      font-size: 1.18rem;
    }
  }
</style>
