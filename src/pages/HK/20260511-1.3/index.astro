---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '限時領取！精選10只潛力牛股名單'
const description = '資深分析師團隊精心篩選，助你抓住 2026 年投資機會。限時免費領取精選 10 只潛力牛股名單。'
---

<BaseLayout title={title} description={description} lang="zh-TW">
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800;900&family=Poppins:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </Fragment>

  <!-- Hero Section -->
  <div class="hero-wrapper">
    <div class="container">
      <div class="hero">
        <div style="text-align: center">
          <div class="urgency-banner">
            <span class="urgency-icon">🔥</span>
            <span class="urgency-text">限時開放中！名額僅限 <span class="urgency-highlight">500人</span></span>
          </div>
        </div>

        <h1 class="hero-title" style="text-align: center">限時領取！<br />精選10只潛力牛股名單</h1>
        <p class="hero-subtitle" style="text-align: center">資深分析師團隊精心篩選，助你抓住2026年投資機會</p>

        <!-- Countdown Timer -->
        <div class="countdown-wrapper">
          <div class="countdown-label">
            <span>⏰</span>
            <span>限時優惠倒計時</span>
          </div>
          <div class="countdown-timer">
            <div class="time-unit">
              <div class="time-value" id="hours">01</div>
              <div class="time-label">小時</div>
            </div>
            <div class="time-separator">:</div>
            <div class="time-unit">
              <div class="time-value" id="minutes">00</div>
              <div class="time-label">分鐘</div>
            </div>
            <div class="time-separator">:</div>
            <div class="time-unit">
              <div class="time-value" id="seconds">00</div>
              <div class="time-label">秒</div>
            </div>
          </div>
        </div>

        <!-- Stats Badges -->
        <div class="stats-badges">
          <div class="stat-badge">
            <span class="stat-icon">✓</span>
            <span>已有 <span class="stat-highlight" id="claim-count">2,847</span> 人領取</span>
          </div>
          <div class="stat-badge">
            <span class="stat-icon">🎁</span>
            <span>100% 免費領取</span>
          </div>
          <div class="stat-badge">
            <span class="stat-icon">🔒</span>
            <span>僅限本次開放</span>
          </div>
        </div>

        <div style="text-align: center">
          <a href="javascript:void(0)" class="cta-button link-btn" onclick="onLinkBtnClick()">馬上領取潛力牛股名單</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Benefits Section (精簡) -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">領取後你會得到什麼？</h2>
      <p class="section-subtitle">這10只潛力股，經過5重嚴格篩選</p>

      <div class="benefits-grid">
        <div class="benefit-item">
          <div class="benefit-icon">📈</div>
          <h4 class="benefit-title">精選10只潛力股</h4>
          <p class="benefit-description">資深團隊把關，只留真正值得留意的標的</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-icon">🛡️</div>
          <h4 class="benefit-title">5重嚴格篩選</h4>
          <p class="benefit-description">基本面、技術面、機構動向全面把關</p>
        </div>
        <div class="benefit-item">
          <div class="benefit-icon">💡</div>
          <h4 class="benefit-title">清晰邏輯說明</h4>
          <p class="benefit-description">每只股票都附選股理由，新手也看得懂</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials (精簡為2則) -->
  <section class="section">
    <div class="container">
      <div class="testimonials-wrapper">
        <h3 class="testimonials-title">📣 用戶真實評價</h3>
        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">張</div>
              <div class="testimonial-info">
                <div class="testimonial-name">張志明</div>
                <div class="testimonial-meta">
                  <span class="testimonial-rating">⭐⭐⭐⭐⭐</span>
                  <span>3天前</span>
                </div>
              </div>
            </div>
            <div class="testimonial-content">
              領取名單後按照推薦的股票建倉，終於體會到什麼叫跟對方向！其中2只已經有不錯的收益，感謝專業團隊的篩選。
            </div>
            <div class="testimonial-tags">
              <span class="testimonial-tag">基本面扎實</span>
              <span class="testimonial-tag">已獲利</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">李</div>
              <div class="testimonial-info">
                <div class="testimonial-name">李雅婷</div>
                <div class="testimonial-meta">
                  <span class="testimonial-rating">⭐⭐⭐⭐⭐</span>
                  <span>5天前</span>
                </div>
              </div>
            </div>
            <div class="testimonial-content">
              作為新手，每只股票都有清晰的邏輯說明，讓我明白為什麼要選它。現在投資變得有方向，不再盲目跟風。
            </div>
            <div class="testimonial-tags">
              <span class="testimonial-tag">邏輯清晰</span>
              <span class="testimonial-tag">新手友好</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container">
      <div
        class="urgency-banner"
        style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--blue-dark) 100%); margin: 0 auto 30px;"
      >
        <span class="urgency-icon" style="color: white">⚡</span>
        <span class="urgency-text" style="color: white"><strong>剩餘名額有限！</strong>錯過本次需等待下一期</span>
      </div>

      <h2 class="final-cta-title">馬上加入我們</h2>

      <a
        href="javascript:void(0)"
        class="cta-button link-btn"
        style="background: var(--primary-blue); color: white; margin-top: 10px"
         onclick="onLinkBtnClick()">馬上領取潛力牛股名單</a
      >
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p style="max-width: 820px; margin: 0 auto 14px; font-size: 0.85rem; line-height: 1.7; opacity: 0.82">
      <strong>風險提示：</strong>投資涉及風險，價格可升可跌，過往表現並不代表未來回報。本網站內容僅供一般市場資訊及投資教育參考，並不構成任何證券買賣建議、招攬或收益承諾。使用者應根據自身情況獨立判斷，並在需要時諮詢持牌專業人士。
    </p>
    <p style="max-width: 820px; margin: 0 auto 12px; font-size: 0.85rem; line-height: 1.7; opacity: 0.82">
      公司名稱：恒富財經資訊有限公司（Hangfu Financial Information Ltd.）｜註冊地址：香港中環｜電郵：info@hangfu-finance.com｜電話：+852 2876 3842｜公司註冊編號：28473926｜商業登記證：BR-2847-39-26
    </p>
    <p>© 2026 恒富財經資訊有限公司. 版權所有.</p>
  </footer>

  <!-- Floating Bottom CTA -->
  <div class="floating-cta">
    <a href="javascript:void(0)" class="floating-cta-button link-btn" onclick="onLinkBtnClick()">馬上領取潛力牛股名單</a>
  </div>

  <!-- WhatsApp Floating Button -->
  <div class="whatsapp-float link-btn" onclick="onLinkBtnClick()">
    <div class="whatsapp-icon">
      <i class="fab fa-whatsapp"></i>
      <div class="whatsapp-badge">1</div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // 60分钟倒计时
  let totalSeconds = 60 * 60

  function updateCountdown() {
    const hours = Math.floor(totalSeconds / 3600)
    const minutes = Math.floor((totalSeconds % 3600) / 60)
    const seconds = totalSeconds % 60
    const hoursEl = document.getElementById('hours')
    const minutesEl = document.getElementById('minutes')
    const secondsEl = document.getElementById('seconds')
    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0')
    if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0')
    if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0')
    if (totalSeconds > 0) { totalSeconds-- } else { totalSeconds = 60 * 60 }
  }

  let claimedCount = 2847
  function updateClaimCount() {
    claimedCount += Math.floor(Math.random() * 4) + 1
    const element = document.getElementById('claim-count')
    if (element) { element.textContent = claimedCount.toLocaleString() }
  }

  window.addEventListener('load', function () {
    updateCountdown()
    setInterval(updateCountdown, 1000)
    updateClaimCount()
    setInterval(updateClaimCount, 8000)
  })
</script>

<style is:global>
  :root {
    --primary-blue: #0066ff;
    --blue-light: #4d94ff;
    --blue-dark: #0052cc;
    --bg-white: #ffffff;
    --bg-light: #f5f8ff;
    --text-dark: #1a1a1a;
    --text-gray: #666666;
    --border-light: #e0eaff;
    --shadow-md: 0 4px 16px rgba(0, 102, 255, 0.12);
    --shadow-lg: 0 8px 32px rgba(0, 102, 255, 0.16);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Noto Sans TC', sans-serif;
    background: var(--bg-white);
    color: var(--text-dark);
    line-height: 1.6;
    overflow-x: hidden;
    padding-bottom: 80px;
  }

  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

  /* Hero */
  .hero-wrapper {
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--blue-dark) 100%);
    padding: 54px 0 64px;
    position: relative;
    overflow: hidden;
  }
  .hero-wrapper::before {
    content: ''; position: absolute; top: -50%; right: -10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
  }
  .hero { position: relative; z-index: 1; }

  .urgency-banner {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: 12px 24px;
    display: inline-flex; align-items: center; gap: 10px;
    margin-bottom: 28px;
    animation: slideInDown 0.6s ease-out;
  }
  .urgency-icon { font-size: 1.2em; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
  .urgency-text { color: white; font-size: clamp(0.9rem, 2vw, 1rem); font-weight: 600; }
  .urgency-highlight { color: #ffd700; font-weight: 800; }

  .hero-title {
    font-family: 'Poppins', 'Noto Sans TC', sans-serif;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 900; color: white; line-height: 1.2;
    margin-bottom: 18px;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  .hero-subtitle {
    font-size: clamp(1.05rem, 2.5vw, 1.4rem);
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 32px; font-weight: 400;
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }

  /* Countdown */
  .countdown-wrapper {
    background: white; border-radius: 20px; padding: 28px;
    box-shadow: var(--shadow-lg); margin: 32px auto; max-width: 600px;
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }
  .countdown-label {
    text-align: center; font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-dark); font-weight: 700; margin-bottom: 18px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .countdown-timer { display: flex; justify-content: center; gap: 15px; }
  .time-unit {
    text-align: center; background: var(--bg-light); border-radius: 12px;
    padding: 18px 14px; min-width: 88px; border: 2px solid var(--border-light);
  }
  .time-value {
    font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 900;
    color: var(--primary-blue); line-height: 1; font-family: 'Poppins', monospace;
  }
  .time-label { font-size: clamp(0.8rem, 1.5vw, 0.95rem); color: var(--text-gray); margin-top: 8px; font-weight: 600; }
  .time-separator { font-size: clamp(2rem, 4vw, 3rem); color: var(--primary-blue); font-weight: 700; align-self: center; }

  /* Stats */
  .stats-badges {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px;
    animation: fadeInUp 0.8s ease-out 0.8s both;
  }
  .stat-badge {
    background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 50px;
    padding: 11px 20px; color: white; font-size: clamp(0.9rem, 1.8vw, 1rem);
    font-weight: 600; display: flex; align-items: center; gap: 8px;
  }
  .stat-icon { font-size: 1.2em; }
  .stat-highlight { color: #ffd700; font-weight: 800; }

  /* CTA Button */
  .cta-button {
    display: inline-block; background: white; color: var(--primary-blue);
    padding: 18px 44px; font-size: clamp(1.1rem, 2.5vw, 1.35rem); font-weight: 800;
    text-decoration: none; border-radius: 50px; transition: all 0.3s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15); margin-top: 28px;
    border: 3px solid transparent; cursor: pointer;
    animation: fadeInUp 0.8s ease-out 1s both;
  }
  .cta-button:hover {
    transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* Sections */
  .section { padding: 56px 0; }
  .section-alt { background: var(--bg-light); }
  .section-title {
    font-family: 'Poppins', 'Noto Sans TC', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800;
    color: var(--text-dark); text-align: center; margin-bottom: 14px;
  }
  .section-subtitle {
    text-align: center; font-size: clamp(1rem, 2vw, 1.15rem); color: var(--text-gray);
    margin: 0 auto 44px; max-width: 700px;
  }

  /* Benefits */
  .benefits-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 20px;
  }
  .benefit-item {
    background: white; border: 2px solid var(--border-light); border-radius: 16px;
    padding: 32px 24px; text-align: center; transition: all 0.3s ease;
  }
  .benefit-item:hover { border-color: var(--primary-blue); box-shadow: var(--shadow-md); transform: translateY(-5px); }
  .benefit-icon { font-size: 2.6rem; margin-bottom: 16px; }
  .benefit-title { font-size: clamp(1.15rem, 2vw, 1.35rem); font-weight: 700; color: var(--primary-blue); margin-bottom: 10px; }
  .benefit-description { font-size: clamp(0.95rem, 1.8vw, 1.02rem); color: var(--text-gray); line-height: 1.6; }

  /* Testimonials */
  .testimonials-wrapper {
    background: white; border-radius: 24px; padding: 44px 28px;
    box-shadow: var(--shadow-md);
  }
  .testimonials-title {
    font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800;
    color: var(--primary-blue); text-align: center; margin-bottom: 36px;
  }
  .testimonials-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;
  }
  .testimonial-card {
    background: var(--bg-light); border: 2px solid var(--border-light);
    border-radius: 16px; padding: 24px;
  }
  .testimonial-header { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .testimonial-avatar {
    width: 48px; height: 48px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--blue-light) 100%);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 1.3rem; font-weight: 700; flex-shrink: 0;
  }
  .testimonial-name { font-size: 1.05rem; font-weight: 700; color: var(--text-dark); margin-bottom: 3px; }
  .testimonial-meta { font-size: 0.85rem; color: var(--text-gray); display: flex; align-items: center; gap: 5px; }
  .testimonial-rating { color: #ffd700; font-size: 0.9rem; }
  .testimonial-content { font-size: clamp(0.95rem, 1.8vw, 1.02rem); color: var(--text-dark); line-height: 1.7; margin-bottom: 14px; }
  .testimonial-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .testimonial-tag {
    background: white; border: 1px solid var(--primary-blue); color: var(--primary-blue);
    padding: 4px 12px; border-radius: 20px; font-size: 0.82rem; font-weight: 600;
  }

  /* Final CTA */
  .final-cta { background: var(--bg-light); padding: 60px 0; text-align: center; }
  .final-cta-title { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 900; color: var(--primary-blue); margin-bottom: 22px; }

  /* Floating CTA */
  .floating-cta {
    position: fixed; bottom: 0; left: 0; right: 0; background: white;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1); padding: 14px 18px; z-index: 999;
    animation: slideUp 0.5s ease-out;
  }
  @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .floating-cta-button {
    display: block; width: 100%; max-width: 600px; margin: 0 auto;
    background: var(--primary-blue); color: white; padding: 16px 28px;
    font-size: clamp(1rem, 2.5vw, 1.25rem); font-weight: 800;
    text-decoration: none; border-radius: 50px; text-align: center;
    transition: all 0.3s ease; animation: breathe 2.5s ease-in-out infinite; cursor: pointer;
  }
  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 20px rgba(0, 102, 255, 0.4); transform: scale(1); }
    50% { box-shadow: 0 0 30px rgba(0, 102, 255, 0.7); transform: scale(1.02); }
  }
  .floating-cta-button:hover { background: var(--blue-dark); animation: none; transform: scale(1.03); }

  /* WhatsApp Float */
  .whatsapp-float {
    position: fixed; right: 24px; bottom: 96px; z-index: 1000; cursor: pointer;
    transition: all 0.3s ease; animation: fadeIn 1s ease-out 1.5s both;
  }
  .whatsapp-float:hover { transform: scale(1.1); }
  .whatsapp-icon {
    width: 62px; height: 62px; background: #25d366; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4); position: relative;
  }
  .whatsapp-icon i { font-size: 33px; color: white; }
  .whatsapp-badge {
    position: absolute; top: -5px; right: -5px; background: #ff3b30; color: white;
    width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-size: 13px; font-weight: 800; border: 3px solid white;
    animation: bounce 1s ease-in-out infinite;
  }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

  /* Footer */
  .footer { background: var(--text-dark); color: white; text-align: center; padding: 30px 20px; }

  /* Animations */
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideInDown { from { transform: translateY(-100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-wrapper { padding: 38px 0 52px; }
    .countdown-wrapper { padding: 24px 18px; }
    .time-unit { min-width: 74px; padding: 14px 10px; }
    .section { padding: 48px 0; }
    .testimonials-wrapper { padding: 36px 20px; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .whatsapp-float { right: 18px; top: 50%; bottom: auto; transform: translateY(-50%); }
    .whatsapp-icon { width: 54px; height: 54px; }
    .whatsapp-icon i { font-size: 27px; }
    .whatsapp-badge { width: 23px; height: 23px; font-size: 12px; }
  }
  @media (max-width: 480px) {
    .countdown-timer { gap: 10px; }
    .time-unit { min-width: 64px; padding: 12px 8px; }
    .stats-badges { gap: 10px; }
    .stat-badge { padding: 10px 16px; }
  }
</style>
