  <script is:inline>
// === Autocomplete ===
function setupAC(inputId, dropdownId) {
  const input = document.getElementById(inputId)
  const dd = document.getElementById(dropdownId)
  if (!input || !dd)
    return

  input.addEventListener('input', function () {
    const val = this.value.trim()
    if (!val) {
      dd.classList.add('hidden')
      return
    }
    const upper = val.toUpperCase()
    const matches = stockData.filter(s =>
      s.c.includes(upper) || s.n.toUpperCase().includes(upper),
    )
    if (matches.length === 0) {
      dd.classList.add('hidden')
      return
    }
    dd.innerHTML = matches.slice(0, 8).map(item =>
      `<div class="flex justify-between items-center px-4 py-3 cursor-pointer border-b border-slate-800/50 last:border-0 hover:bg-cyan-500/[0.04] transition-colors" data-name="${item.n}"><span class="text-cyan-400/60 text-xs font-mono">${item.c}</span><span class="text-white text-sm">${item.n}</span></div>`,
    ).join('')
    dd.classList.remove('hidden')

    dd.querySelectorAll('[data-name]').forEach((el) => {
      el.addEventListener('click', function () {
        input.value = this.getAttribute('data-name')
        dd.classList.add('hidden')
      })
    })
  })

  document.addEventListener('click', (e) => {
    if (!input.contains(e.target) && !dd.contains(e.target)) {
      dd.classList.add('hidden')
    }
  })
}

// === Modal ===
function openModal(stockName) {
  const modal = document.getElementById('modal')
  const modalLoading = document.getElementById('modalLoading')
  const modalResult = document.getElementById('modalResult')

  document.getElementById('resultStock').textContent = stockName
  modal.classList.remove('opacity-0', 'pointer-events-none')
  modal.classList.add('opacity-100', 'pointer-events-auto')
  modalLoading.classList.remove('hidden')
  modalResult.classList.add('hidden')
  document.body.style.overflow = 'hidden'

  const bar = document.getElementById('progressBar')
  bar.style.width = '0%'
  setTimeout(() => {
    bar.style.width = '100%'
  }, 50)

  const steps = document.querySelectorAll('#steps > div')
  steps.forEach((step, i) => {
    setTimeout(() => {
      step.style.opacity = '1'
      step.classList.remove('text-slate-600')
      step.classList.add('text-cyan-400/80')
    }, i * 650)
  })

  setTimeout(() => {
    modalLoading.classList.add('hidden')
    modalResult.classList.remove('hidden')
  }, 3500)
}

function closeModal() {
  const modal = document.getElementById('modal')
  modal.classList.add('opacity-0', 'pointer-events-none')
  modal.classList.remove('opacity-100', 'pointer-events-auto')
  document.body.style.overflow = ''
  document.querySelectorAll('#steps > div').forEach((step) => {
    step.style.opacity = '0'
    step.classList.add('text-slate-600')
    step.classList.remove('text-cyan-400/80')
  })
}

function startAnalysis(inputId) {
  const input = document.getElementById(inputId)
  if (!input)
    return
  const val = input.value.trim()
  if (!val) {
    // eslint-disable-next-line no-alert
    window.alert('종목을 입력해주세요')
    return
  }
  const valid = stockData.some(s => s.n === val || s.c === val)
  if (!valid) {
    // eslint-disable-next-line no-alert
    window.alert('종목을 찾을 수 없습니다')
    return
  }
  openModal(val)
}

// === Stats ===
function runStats() {
  const totalEl = document.getElementById('totalUsers')
  const limitEl = document.getElementById('limitSlots')
  const dateEl = document.getElementById('updateDate')

  if (totalEl) {
    let count = 12847
    setInterval(() => {
      count += Math.floor(Math.random() * 4) + 1
      totalEl.textContent = count.toLocaleString()
    }, 2800)
  }
  if (limitEl) {
    let slots = 150
    setInterval(() => {
      if (slots > 0) {
        slots -= Math.floor(Math.random() * 2) + 1
        if (slots < 0)
          slots = 0
        limitEl.textContent = slots
      }
    }, 3500)
  }
  if (dateEl) {
    const d = new Date()
    d.setDate(d.getDate() - 1)
    dateEl.textContent = `${d.getFullYear()}.${d.getMonth() + 1}.${d.getDate()} 15:00`
  }
}

// === Init ===
document.addEventListener('DOMContentLoaded', () => {
  setupAC('heroInput', 'heroDropdown')
  setupAC('ctaInput', 'ctaDropdown')
  runStats()

  document.getElementById('heroBtn').addEventListener('click', () => {
    startAnalysis('heroInput')
  })
  document.getElementById('ctaBtn').addEventListener('click', () => {
    startAnalysis('ctaInput')
  })
  document.getElementById('modalClose').addEventListener('click', closeModal)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape')
      closeModal()
  })
})
</script>

