---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'AI 종목 진단 · 내 주식 지금 팔아야 할까 | 한국증시 AI 분석'
const description = 'AI가 한국 증시 흐름, 수급, 시장 심리를 실시간 분석해 몇 초 만에 내 종목의 매수·매도 신호를 알려드립니다. 카카오톡 추가하고 전체 진단 리포트를 받아보세요.'
---

<BaseLayout title={title} description={description} lang="ko">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- ═══════════ 背景層 ═══════════ -->
  <canvas id="particles-bg" class="bg-particles"></canvas>
  <div class="bg-aurora" aria-hidden="true">
    <span class="aurora a1"></span>
    <span class="aurora a2"></span>
    <span class="aurora a3"></span>
  </div>
  <div class="bg-grid" aria-hidden="true"></div>

  <!-- ═══════════ 單屏 HERO ═══════════ -->
  <main class="hero">
    <div class="hero-inner">
      <div class="eyebrow">
        <span class="dot"></span>
        <span>AI 실시간 진단 · 한국 증시</span>
      </div>

      <h1 class="title">
        들고 있는 그 종목,<br />
        <span class="grad">지금 팔아야 할까요?</span>
      </h1>
      <p class="subtitle">종목명만 입력하면 AI가 몇 초 만에 '매수'인지 '매도'인지 알려드립니다</p>

      <div class="search">
        <div class="search-box" id="searchBox">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
          </svg>
          <input id="stockInput" type="text" autocomplete="off" inputmode="text" placeholder="종목명·코드 입력 (예: 삼성전자)" />
          <button id="diagBtn" class="diag-btn" type="button">
            즉시 진단
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          </button>
        </div>
        <div id="dropdown" class="dropdown"></div>
      </div>

      <div class="hot">
        <span class="hot-lbl">인기</span>
        <button class="chip" data-code="005930" data-name="삼성전자" type="button">삼성전자</button>
        <button class="chip" data-code="000660" data-name="SK하이닉스" type="button">SK하이닉스</button>
        <button class="chip" data-code="005380" data-name="현대차" type="button">현대차</button>
        <button class="chip" data-code="086520" data-name="에코프로" type="button">에코프로</button>
        <button class="chip" data-code="035720" data-name="카카오" type="button">카카오</button>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="num" id="userCount">12,847</div>
          <div class="lbl">오늘 진단 건수</div>
        </div>
        <span class="sep"></span>
        <div class="stat">
          <div class="num up">91.4%</div>
          <div class="lbl">신호 적중률</div>
        </div>
        <span class="sep"></span>
        <div class="stat">
          <div class="num">3<span class="num-u">초</span></div>
          <div class="lbl">평균 분석 시간</div>
        </div>
      </div>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-track" id="tickerTrack"></div>
      </div>
    </div>
  </main>

  <!-- ═══════════ 診斷 MODAL ═══════════ -->
  <div id="modal" class="modal">
    <div class="modal-card">
      <button id="modalClose" class="modal-close" type="button" aria-label="닫기">×</button>

      <!-- Loading -->
      <div id="loading" class="m-loading">
        <div class="radar">
          <span class="radar-ring r1"></span>
          <span class="radar-ring r2"></span>
          <span class="radar-sweep"></span>
          <svg class="radar-core" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
        </div>
        <div class="scan-title"><span id="loadStock" class="scan-stock"></span> AI 분석 중</div>
        <div class="scan-sub">REAL-TIME AI DIAGNOSIS</div>
        <div class="progress"><span id="progressBar"></span></div>
        <div class="logs" id="logs">
          <div><i>01</i>거래소 실시간 데이터 연결…</div>
          <div><i>02</i>보조지표 분석 RSI / MACD / 이평선…</div>
          <div><i>03</i>거래량·매물대 분석…</div>
          <div><i>04</i>기관·외국인 수급 추적…</div>
          <div><i>05</i>투자 심리·뉴스 공시 분석…</div>
          <div><i>06</i>AI 종합 진단 리포트 생성…</div>
        </div>
      </div>

      <!-- Result -->
      <div id="result" class="m-result">
        <div class="res-head">
          <span class="res-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path d="M5 13l4 4L19 7"></path></svg>
          </span>
          <div>
            <div class="res-done">진단 완료</div>
            <div class="res-stock" id="resStock"></div>
          </div>
        </div>

        <div class="metrics">
          <div class="metric">
            <div class="m-lbl">AI 등급</div>
            <div class="m-val cyan" id="mGrade">A</div>
          </div>
          <div class="metric">
            <div class="m-lbl">추세 신호</div>
            <div class="m-val up" id="mTrend">강세 ▲</div>
          </div>
          <div class="metric">
            <div class="m-lbl">리스크</div>
            <div class="m-val gold" id="mRisk">보통</div>
          </div>
        </div>

        <div class="locked">
          <div class="locked-rows">
            <div class="lk-row"><span>적정 매수 구간</span><b>●●,●●● – ●●,●●●</b></div>
            <div class="lk-row"><span>AI 목표가</span><b class="up">▲ ●●,●●●</b></div>
            <div class="lk-row"><span>손절가</span><b>●●,●●●</b></div>
            <div class="lk-row"><span>단기·중기 대응 전략</span><b>●●●●●●</b></div>
          </div>
          <div class="locked-mask">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>매수 타이밍 · 목표가 · 손절가 잠금</span>
          </div>
        </div>

        <a href="javascript:void(0)" onclick="mixinJump()" class="ka-cta" id="kaCta">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.48 3 2 6.58 2 11c0 2.84 1.87 5.33 4.68 6.75-.2.74-.73 2.68-.84 3.1-.13.52.19.51.4.37.17-.11 2.65-1.8 3.72-2.54.66.1 1.34.15 2.04.15 5.52 0 10-3.58 10-8s-4.48-8-10-8z"></path></svg>
          카톡 채널 추가하고 전체 리포트 받기
        </a>
        <p class="ka-note">'<span id="resStock2"></span>' 보내주시면 전체 AI 진단 리포트를 보내드려요</p>
      </div>
    </div>
  </div>

  <!-- ═══════════ JS ═══════════ -->
  <script is:inline>
const KR_STOCKS = [
  { c: '005930', n: '삼성전자' },
  { c: '000660', n: 'SK하이닉스' },
  { c: '373220', n: 'LG에너지솔루션' },
  { c: '207940', n: '삼성바이오로직스' },
  { c: '005380', n: '현대차' },
  { c: '000270', n: '기아' },
  { c: '068270', n: '셀트리온' },
  { c: '035420', n: 'NAVER' },
  { c: '035720', n: '카카오' },
  { c: '005490', n: 'POSCO홀딩스' },
  { c: '051910', n: 'LG화학' },
  { c: '006400', n: '삼성SDI' },
  { c: '105560', n: 'KB금융' },
  { c: '055550', n: '신한지주' },
  { c: '086790', n: '하나금융지주' },
  { c: '042700', n: '한미반도체' },
  { c: '034020', n: '두산에너빌리티' },
  { c: '267260', n: 'HD현대일렉트릭' },
  { c: '010120', n: 'LS일렉트릭' },
  { c: '298040', n: '효성중공업' },
  { c: '012450', n: '한화에어로스페이스' },
  { c: '064350', n: '현대로템' },
  { c: '086520', n: '에코프로' },
  { c: '247540', n: '에코프로비엠' },
  { c: '196170', n: '알테오젠' },
  { c: '277810', n: '레인보우로보틱스' },
  { c: '454910', n: '두산로보틱스' },
  { c: '259960', n: '크래프톤' },
  { c: '352820', n: '하이브' },
  { c: '003490', n: '대한항공' },
  { c: '011200', n: 'HMM' },
]

// ── 粒子背景（手寫 canvas 連線網絡，主線程渲染，零依賴、所有瀏覽器可見）──
function initParticles() {
  const canvas = document.getElementById('particles-bg')
  if (!canvas)
    return
  const ctx = canvas.getContext('2d')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const mouse = { x: -999, y: -999 }
  const LINK = 142
  let W = 0
  let H = 0
  let dpr = 1
  let pts = []

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2)
    W = window.innerWidth
    H = window.innerHeight
    canvas.width = W * dpr
    canvas.height = H * dpr
    canvas.style.width = `${W}px`
    canvas.style.height = `${H}px`
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
  }
  function build() {
    const count = Math.max(34, Math.min(72, Math.round(W * H / 15000)))
    pts = []
    for (let i = 0; i < count; i++) {
      pts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * (reduce ? 0.12 : 0.5),
        vy: (Math.random() - 0.5) * (reduce ? 0.12 : 0.5),
        r: Math.random() * 1.5 + 0.9,
      })
    }
  }
  function frame() {
    ctx.clearRect(0, 0, W, H)
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i]
      p.x += p.vx
      p.y += p.vy
      if (p.x < 0 || p.x > W)
        p.vx *= -1
      if (p.y < 0 || p.y > H)
        p.vy *= -1
      for (let j = i + 1; j < pts.length; j++) {
        const q = pts[j]
        const d = Math.hypot(p.x - q.x, p.y - q.y)
        if (d < LINK) {
          ctx.globalAlpha = (1 - d / LINK) * 0.5
          ctx.strokeStyle = '#34d8ee'
          ctx.lineWidth = 1
          ctx.beginPath()
          ctx.moveTo(p.x, p.y)
          ctx.lineTo(q.x, q.y)
          ctx.stroke()
        }
      }
      const md = Math.hypot(p.x - mouse.x, p.y - mouse.y)
      if (md < 180) {
        ctx.globalAlpha = (1 - md / 180) * 0.75
        ctx.strokeStyle = '#7fe9ff'
        ctx.lineWidth = 1.1
        ctx.beginPath()
        ctx.moveTo(p.x, p.y)
        ctx.lineTo(mouse.x, mouse.y)
        ctx.stroke()
      }
    }
    for (const p of pts) {
      ctx.globalAlpha = 0.16
      ctx.fillStyle = '#34d8ee'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r * 3, 0, Math.PI * 2)
      ctx.fill()
      ctx.globalAlpha = 0.95
      ctx.fillStyle = '#bdf1ff'
      ctx.beginPath()
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.globalAlpha = 1
    if (!reduce)
      requestAnimationFrame(frame)
  }

  resize()
  build()
  frame()
  window.addEventListener('resize', () => {
    resize()
    build()
  })
  window.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX
    mouse.y = e.clientY
  })
  window.addEventListener('pointerleave', () => {
    mouse.x = -999
    mouse.y = -999
  })
}

// ── 自動完成 ──
function setupAutocomplete() {
  const input = document.getElementById('stockInput')
  const dd = document.getElementById('dropdown')
  input.addEventListener('input', function () {
    const v = this.value.trim().toUpperCase()
    if (!v) {
      dd.classList.remove('open')
      dd.innerHTML = ''
      return
    }
    const hits = KR_STOCKS.filter(s => s.c.includes(v) || s.n.toUpperCase().includes(v)).slice(0, 6)
    if (!hits.length) {
      dd.classList.remove('open')
      dd.innerHTML = ''
      return
    }
    dd.innerHTML = hits.map(s => `<button type="button" class="dd-item" data-code="${s.c}" data-name="${s.n}"><span class="dd-code">${s.c}</span><span class="dd-name">${s.n}</span></button>`).join('')
    dd.classList.add('open')
  })
  dd.addEventListener('click', (e) => {
    const item = e.target.closest('.dd-item')
    if (!item)
      return
    input.value = `${item.dataset.name}`
    dd.classList.remove('open')
    dd.innerHTML = ''
    startAnalysis()
  })
  document.addEventListener('click', (e) => {
    if (!document.getElementById('searchBox').contains(e.target) && !dd.contains(e.target)) {
      dd.classList.remove('open')
    }
  })
}

// ── 解析輸入 → 股票名 ──
function resolveStock(raw) {
  const v = raw.trim()
  if (!v)
    return null
  const up = v.toUpperCase()
  const hit = KR_STOCKS.find(s => s.c === up || s.n === v || up.includes(s.c) || v.includes(s.n) || s.n.toUpperCase() === up)
  if (hit)
    return `${hit.n}(${hit.c})`
  return v
}

// ── 診斷流程 ──
let busy = false
function startAnalysis() {
  if (busy)
    return
  const input = document.getElementById('stockInput')
  const label = resolveStock(input.value)
  if (!label) {
    const box = document.getElementById('searchBox')
    box.classList.add('shake')
    setTimeout(() => box.classList.remove('shake'), 500)
    input.focus()
    return
  }
  busy = true
  openModal(label)
}

function openModal(label) {
  const modal = document.getElementById('modal')
  const loading = document.getElementById('loading')
  const result = document.getElementById('result')
  const shortName = label.replace(/\(.*?\)/, '')

  document.getElementById('loadStock').textContent = label
  document.getElementById('resStock').textContent = label
  document.getElementById('resStock2').textContent = shortName

  // 依股票名生成穩定的「診斷結果」，令唔同股顯示唔同評級（更可信）
  const seed = [...label].reduce((a, c) => a + c.charCodeAt(0), 0)
  const grades = ['A+', 'A', 'A', 'A-', 'B+']
  const trends = ['상승 돌파 ▲', '단기 강세 ▲', '매수세 유입 ▲', '반등 임박 ▲']
  const risks = ['보통', '보통', '낮은 편', '높은 편']
  document.getElementById('mGrade').textContent = grades[seed % grades.length]
  document.getElementById('mTrend').textContent = trends[seed % trends.length]
  document.getElementById('mRisk').textContent = risks[seed % risks.length]

  loading.style.display = 'block'
  result.style.display = 'none'
  modal.classList.add('open')
  document.body.style.overflow = 'hidden'

  const bar = document.getElementById('progressBar')
  const logs = document.querySelectorAll('#logs > div')
  const stepMs = [950, 1150, 1500, 1150, 1350, 1150] // 各步耗時不均，更似真檢測
  const totalMs = stepMs.reduce((a, b) => a + b, 0)
  bar.style.transition = 'none'
  bar.style.width = '0%'
  logs.forEach(l => l.classList.remove('on', 'active', 'done'))

  if (openModal._timers)
    openModal._timers.forEach(clearTimeout)
  openModal._timers = []
  let acc = 0
  let cum = 0
  stepMs.forEach((ms, i) => {
    openModal._timers.push(setTimeout(() => {
      logs[i].classList.add('active')
    }, acc))
    cum += ms
    const pct = `${(cum / totalMs) * 100}%`
    openModal._timers.push(setTimeout(() => {
      logs[i].classList.remove('active')
      logs[i].classList.add('done')
      bar.style.transition = 'width .45s ease'
      bar.style.width = pct
    }, acc + ms))
    acc += ms
  })

  clearTimeout(openModal._t)
  openModal._t = setTimeout(() => {
    loading.style.display = 'none'
    result.style.display = 'block'
  }, totalMs + 350)
}

function closeModal() {
  const modal = document.getElementById('modal')
  modal.classList.remove('open')
  document.body.style.overflow = ''
  busy = false
}

// ── 統計數字滾動 ──
function runStats() {
  const el = document.getElementById('userCount')
  let n = 12847
  setInterval(() => {
    n += Math.floor(Math.random() * 3) + 1
    el.textContent = n.toLocaleString('ko-KR')
  }, 2600)
}

// ── Live ticker ──
function buildTicker() {
  const surnames = ['김', '이', '박', '최', '정', '강', '조', '윤', '장', '임', '한', '오']
  const tpls = [
    (sn, s) => `<span class="tk"><b>${sn}**님</b> 방금 <em>${s.n}</em> 진단 완료</span>`,
    (sn, s) => `<span class="tk"><b>${sn}**님</b> <em>${s.n}</em> AI 리포트 받음</span>`,
    (sn, s) => `<span class="tk"><b>${sn}**님</b> 방금 <em>${s.n}</em> 신호 확인</span>`,
    (sn, s) => `<span class="tk"><b>${sn}**님</b> <em>${s.n}</em> 전체 리포트 잠금 해제</span>`,
  ]
  const items = []
  for (let i = 0; i < 14; i++) {
    const s = KR_STOCKS[Math.floor(Math.random() * KR_STOCKS.length)]
    const sn = surnames[Math.floor(Math.random() * surnames.length)]
    const tpl = tpls[Math.floor(Math.random() * tpls.length)]
    items.push(tpl(sn, s))
  }
  const html = items.join('<span class="tk-dot">·</span>')
  document.getElementById('tickerTrack').innerHTML = `${html}<span class="tk-dot">·</span>${html}`
}

// ── init ──
document.addEventListener('DOMContentLoaded', () => {
  initParticles()
  setupAutocomplete()
  runStats()
  buildTicker()
  document.getElementById('diagBtn').addEventListener('click', startAnalysis)
  document.getElementById('stockInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter')
      startAnalysis()
  })
  document.querySelectorAll('.chip').forEach(ch => ch.addEventListener('click', () => {
    document.getElementById('stockInput').value = `${ch.dataset.name}`
    startAnalysis()
  }))
  document.getElementById('modalClose').addEventListener('click', closeModal)
  document.getElementById('modal').addEventListener('click', (e) => {
    if (e.target.id === 'modal')
      closeModal()
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape')
      closeModal()
  })
})
</script>

  <!-- ═══════════ CSS ═══════════ -->
  <style is:global>
    :root {
      --bg: #070b18;
      --cyan: #22d3ee;
      --sky: #38bdf8;
      --teal: #2dd4bf;
      --up: #ff5a6a;     /* 韓股同樣紅漲 */
      --gold: #fbbf24;
      --ka: #fee500;     /* Kakao 黃 */
      --ka2: #f5d800;
      --ka-tx: #191919;  /* Kakao 官方深色字 */
      --tx: #f1f5f9;
      --tx2: #9fb0c4;
      --tx3: #5a6b80;
      --line: rgba(34, 211, 238, .14);
    }

    html { -webkit-text-size-adjust: 100%; }
    body {
      background: var(--bg);
      color: var(--tx);
      font-family: 'Noto Sans KR', system-ui, -apple-system, sans-serif;
      margin: 0;
      overflow-x: hidden;
      word-break: keep-all;
      -webkit-font-smoothing: antialiased;
    }
    .num, .eyebrow span, .scan-sub, .m-val, .dd-code, .logs i { font-family: 'Space Grotesk', 'Noto Sans KR', sans-serif; }

    /* ── 背景 ── */
    .bg-particles { position: fixed; inset: 0; z-index: 0; }
