<!-- ═══════════════ JS ═══════════════ -->
<script is:inline>
const stockData=[
  {c:'005930',n:'삼성전자'},{c:'000660',n:'SK하이닉스'},{c:'005380',n:'현대차'},
  {c:'035420',n:'NAVER'},{c:'035720',n:'카카오'},{c:'051910',n:'LG화학'},
  {c:'006400',n:'삼성SDI'},{c:'003670',n:'포스코홀딩스'},{c:'068270',n:'셀트리온'},
  {c:'000270',n:'기아'},{c:'207940',n:'삼성바이오로직스'},{c:'012330',n:'현대모비스'},
  {c:'028260',n:'삼성물산'},{c:'066570',n:'LG전자'},{c:'003550',n:'LG'},
  {c:'017670',n:'SK텔레콤'},{c:'096770',n:'SK이노베이션'},{c:'034730',n:'SK'},
  {c:'009150',n:'삼성전기'},{c:'055550',n:'신한지주'},{c:'105560',n:'KB금융'},
  {c:'086790',n:'하나금융지주'},{c:'316140',n:'우리금융지주'},{c:'015760',n:'한국전력'},
  {c:'036570',n:'엔씨소프트'},{c:'251270',n:'넷마블'},{c:'259960',n:'크래프톤'},
  {c:'352820',n:'하이브'},{c:'041510',n:'SM'},
]

// ── 파티클 캔버스 배경 ──
;(function initCanvas(){
  const canvas=document.getElementById('bgCanvas')
  if(!canvas)return
  const ctx=canvas.getContext('2d')
  let W,H,pts=[]
  const N=85,DIST=130,COL='rgba(6,182,212,'
  function resize(){
    W=canvas.width=window.innerWidth
    H=canvas.height=window.innerHeight
  }
  function makePts(){
    pts=[]
    for(let i=0;i<N;i++)pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.38,vy:(Math.random()-.5)*.38,r:Math.random()*1.5+.5})
  }
  function draw(){
    ctx.clearRect(0,0,W,H)
    // update
    pts.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy
      if(p.x<0||p.x>W)p.vx*=-1
      if(p.y<0||p.y>H)p.vy*=-1
    })
    // lines
    for(let i=0;i<pts.length;i++){
      for(let j=i+1;j<pts.length;j++){
        const dx=pts[i].x-pts[j].x, dy=pts[i].y-pts[j].y
        const d=Math.sqrt(dx*dx+dy*dy)
        if(d<DIST){
          ctx.beginPath()
          ctx.moveTo(pts[i].x,pts[i].y)
          ctx.lineTo(pts[j].x,pts[j].y)
          ctx.strokeStyle=COL+(1-d/DIST)*.18+')'
          ctx.lineWidth=.6
          ctx.stroke()
        }
      }
    }
    // dots
    pts.forEach(p=>{
      ctx.beginPath()
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2)
      ctx.fillStyle=COL+'.55)'
      ctx.fill()
    })
    requestAnimationFrame(draw)
  }
  resize(); makePts(); draw()
  window.addEventListener('resize',()=>{resize();makePts()})
})()

// ── 자동완성 ──
function setupAC(inputId,dropdownId){
  const input=document.getElementById(inputId), dd=document.getElementById(dropdownId)
  if(!input||!dd)return
  input.addEventListener('input',function(){
    const val=this.value.trim()
    if(!val){dd.style.display='none';return}
    const upper=val.toUpperCase()
    const matches=stockData.filter(s=>s.c.includes(upper)||s.n.toUpperCase().includes(upper))
    if(!matches.length){dd.style.display='none';return}
    dd.innerHTML=matches.slice(0,8).map(item=>
      `<div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;cursor:pointer;border-bottom:1px solid rgba(255,255,255,.04);transition:background .15s;" onmouseover="this.style.background='rgba(6,182,212,.06)'" onmouseout="this.style.background=''" data-name="${item.n}">
         <span style="color:rgba(6,182,212,.5);font-family:monospace;font-size:.72rem;">${item.c}</span>
         <span style="color:white;font-size:.85rem;">${item.n}</span>
       </div>`
    ).join('')
    dd.style.display='block'
    dd.querySelectorAll('[data-name]').forEach(el=>{
      el.addEventListener('click',function(){
        input.value=this.getAttribute('data-name')
        dd.style.display='none'
      })
    })
  })
  document.addEventListener('click',e=>{
    if(!input.contains(e.target)&&!dd.contains(e.target))dd.style.display='none'
  })
}

// ── 모달 ──
function openModal(name){
  const modal=document.getElementById('modal')
  const loading=document.getElementById('modalLoading')
  const result=document.getElementById('modalResult')
  document.getElementById('resultStock').textContent=name
  loading.style.display='block'
  result.style.display='none'
  document.body.style.overflow='hidden'
  requestAnimationFrame(()=>{
    modal.style.opacity='1'
    modal.style.pointerEvents='auto'
  })
  const bar=document.getElementById('progressBar')
  bar.style.width='0%'
  setTimeout(()=>bar.style.width='100%',80)
  document.querySelectorAll('#steps>div').forEach((s,i)=>{
    s.style.opacity='0'; s.style.color='#374151'
    setTimeout(()=>{s.style.opacity='1'; s.style.color='rgba(6,182,212,.75)'},i*680)
  })
  setTimeout(()=>{loading.style.display='none'; result.style.display='block'},3800)
}
function closeModal(){
  const modal=document.getElementById('modal')
  modal.style.opacity='0'
  setTimeout(()=>modal.style.pointerEvents='none',280)
  document.body.style.overflow=''
}
function startAnalysis(inputId){
  const input=document.getElementById(inputId)
  if(!input)return
  const val=input.value.trim()
  if(!val){alert('종목을 입력해주세요');return}
  const valid=stockData.some(s=>s.n===val||s.c===val)
  if(!valid){alert('종목을 찾을 수 없습니다');return}
  openModal(val)
}

// ── 통계 ──
function runStats(){
  const totalEl=document.getElementById('totalUsers')
  const limitEl=document.getElementById('limitSlots')
  const dateEl=document.getElementById('updateDate')
  if(totalEl){let n=12847;setInterval(()=>{n+=Math.floor(Math.random()*4)+1;totalEl.textContent=n.toLocaleString()},2800)}
  if(limitEl){let s=150;setInterval(()=>{if(s>0){s=Math.max(0,s-(Math.floor(Math.random()*2)+1));limitEl.textContent=s}},3500)}
  if(dateEl){const d=new Date();d.setDate(d.getDate()-1);dateEl.textContent=`${d.getFullYear()}.${d.getMonth()+1}.${d.getDate()} 15:00`}
}

// ── 초기화 ──
document.addEventListener('DOMContentLoaded',()=>{
  setupAC('heroInput','heroDropdown')
  setupAC('ctaInput','ctaDropdown')
  runStats()
  document.getElementById('heroBtn').addEventListener('click',()=>startAnalysis('heroInput'))
  document.getElementById('ctaBtn').addEventListener('click',()=>startAnalysis('ctaInput'))
  document.getElementById('heroInput').addEventListener('keydown',e=>{if(e.key==='Enter')startAnalysis('heroInput')})
  document.getElementById('ctaInput').addEventListener('keydown',e=>{if(e.key==='Enter')startAnalysis('ctaInput')})
  document.getElementById('modalClose').addEventListener('click',closeModal)
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()})
  document.getElementById('modal').addEventListener('click',e=>{if(e.target===document.getElementById('modal'))closeModal()})
  const wrap=document.getElementById('heroInputWrap'), inp=document.getElementById('heroInput')
  if(wrap&&inp){
    inp.addEventListener('focus',()=>{wrap.style.borderColor='rgba(6,182,212,.45)';wrap.style.boxShadow='0 0 0 3px rgba(6,182,212,.07),0 8px 40px rgba(0,0,0,.4)'})
    inp.addEventListener('blur',()=>{wrap.style.borderColor='rgba(71,85,105,.5)';wrap.style.boxShadow='0 8px 40px rgba(0,0,0,.4)'})
  }
})
</script>

