---
import bandIcon from '@/assets/band-icon.png'
import kakaoIcon from '@/assets/kakao-icon.png'
import KRRedirectCode from '@/components/KRRedirectCode.astro'

export function getStaticPaths() {
  return [
    { params: { t: '卡扣' } },
    { params: { t: '卡群' } },
    { params: { t: '棒群' } },
  ]
}

const { t = '卡扣' } = Astro.params
const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelShort = isBand ? '밴드' : '카카오톡'
const jumpFn = isBand ? 'jumpToBand()' : 'jumpToKakao()'
const bodyClass = isBand ? 'ch-band' : 'ch-kakao'
const ctaIcon = isBand ? bandIcon : kakaoIcon
const joinWord = isBand
  ? '밴드에서 무료 분석 받기'
  : needNumber
    ? '카카오톡으로 무료 분석 받기'
    : '카카오톡에서 바로 참여'

const title = '12,847명이 이미 함께하고 있습니다 — 반등 종목 무료 분석'
const description = '폭락장에서도 기회를 찾는 12,847명의 투자자 커뮤니티. 전문가가 매일 선별하는 반등 종목을 무료로 받아보세요.'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1018" />

    <KRRedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #0c1018;
        --bg-2: #141c28;
        --line: rgba(74, 222, 128, 0.1);
        --white: #e8eaf0;
        --dim: #7a8498;
        --green: #4ade80;
        --green-glow: rgba(74, 222, 128, 0.2);
        --cta: #fee500;
        --cta-ink: #191600;
      }

      .ch-band {
        --cta: #21c063;
        --cta-ink: #04210f;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        padding-bottom: 92px;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--white);
        font-family: 'Noto Sans KR', sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

      .shell { max-width: 720px; margin: 0 auto; }

      /* ── Hero ── */
      .hero {
        position: relative;
        overflow: hidden;
        padding: 64px 20px 48px;
        text-align: center;
        background:
          radial-gradient(ellipse 80% 50% at 50% 0%, var(--green-glow) 0%, transparent 70%),
          var(--bg);
      }

      .hero-number {
        font-size: 56px;
        font-weight: 900;
        line-height: 1;
        color: var(--green);
        letter-spacing: -1px;
      }

      .hero h1 {
        margin-top: 10px;
        font-size: 24px;
        font-weight: 900;
        line-height: 1.4;
      }

      .hero-sub {
        max-width: 340px;
        margin: 16px auto 0;
        color: var(--dim);
        font-size: 15px;
        line-height: 1.75;
      }

      /* ── CTA Button ── */
      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: 24px;
        padding: 17px 18px;
        border-radius: 14px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16.5px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
      }

      .btn img { width: 24px; height: 24px; }

      .btn .num {
        display: inline-grid;
        place-items: center;
        min-width: 26px;
        height: 24px;
        padding: 0 7px;
        border-radius: 7px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 14px;
        font-weight: 900;
      }

      .btn-hint {
        margin-top: 10px;
        color: var(--dim);
        font-size: 12.5px;
        text-align: center;
      }

      /* ── Sections ── */
      .sec { padding: 48px 20px 0; }

      .sec-title {
        font-size: 22px;
        font-weight: 900;
        line-height: 1.35;
        text-align: center;
      }

      .green { color: var(--green); }

      /* ── Activity Feed ── */
      .feed-wrap {
        margin-top: 24px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
        overflow: hidden;
        height: 220px;
        position: relative;
      }

      .feed-wrap::before,
      .feed-wrap::after {
        content: '';
        position: absolute;
        left: 0; right: 0;
        height: 32px;
        z-index: 2;
        pointer-events: none;
      }

      .feed-wrap::before {
        top: 0;
        background: linear-gradient(to bottom, var(--bg-2), transparent);
      }

      .feed-wrap::after {
        bottom: 0;
        background: linear-gradient(to top, var(--bg-2), transparent);
      }

      .feed-track {
        animation: feed-scroll 14s linear infinite;
      }

      @keyframes feed-scroll {
        0% { transform: translateY(0); }
        100% { transform: translateY(-50%); }
      }

      .feed-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 18px;
      }

      .feed-item + .feed-item {
        border-top: 1px solid rgba(74, 222, 128, 0.06);
      }

      .feed-dot {
        flex: 0 0 10px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--green);
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--green-glow); }
        50% { opacity: 0.7; box-shadow: 0 0 0 6px transparent; }
      }

      .feed-text {
        font-size: 14px;
        color: var(--white);
      }

      /* ── Testimonials ── */
      .testimonials {
        margin-top: 24px;
        display: grid;
        gap: 14px;
      }

      .tcard {
        padding: 20px;
        border-left: 3px solid var(--green);
        background: var(--bg-2);
        border-radius: 0 12px 12px 0;
        border-top: 1px solid rgba(74, 222, 128, 0.06);
        border-right: 1px solid rgba(74, 222, 128, 0.06);
        border-bottom: 1px solid rgba(74, 222, 128, 0.06);
      }

      .tcard p {
        font-size: 14.5px;
        line-height: 1.75;
      }

      .tcard cite {
        display: block;
        margin-top: 10px;
        color: var(--dim);
        font-size: 13px;
        font-style: normal;
      }

      /* ── Service Tags ── */
      .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
      }

      .tag {
        padding: 9px 16px;
        border: 1px solid var(--line);
        border-radius: 100px;
        background: var(--bg-2);
        font-size: 13.5px;
        font-weight: 700;
        color: var(--white);
        white-space: nowrap;
      }

      /* ── Steps ── */
      .steps {
        display: grid;
        gap: 10px;
        margin-top: 24px;
      }

      .step {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .sn {
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--green);
        color: var(--bg);
        font-size: 14px;
        font-weight: 900;
      }

      .step b { font-size: 15px; font-weight: 900; }
      .step p { margin-top: 2px; color: var(--dim); font-size: 13px; }

      /* ── Notice & Footer ── */
      .notice {
        margin-top: 48px;
        padding: 20px;
        border-top: 1px solid var(--line);
        color: #5a6580;
        font-size: 11.5px;
        line-height: 1.85;
      }

      .footer { padding: 4px 20px 40px; }
      .footer p { color: var(--dim); font-size: 12px; line-height: 1.7; }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 14px;
      }

      .footer-links a {
        color: var(--white);
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      /* ── Sticky CTA ── */
      .sticky {
        position: fixed;
        right: 0; bottom: 0; left: 0;
        z-index: 80;
        display: flex;
        justify-content: center;
        background: rgba(12, 16, 24, 0.92);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--line);
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      }

      .sticky a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        max-width: 692px;
        padding: 15px 18px;
        border-radius: 12px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
      }

      .sticky img { width: 22px; height: 22px; }

      .sticky .num {
        display: inline-grid;
        place-items: center;
        min-width: 24px;
        height: 22px;
        padding: 0 6px;
        border-radius: 6px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 13px;
        font-weight: 900;
      }

      /* ── Modal ── */
      .ov {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2, 5, 16, 0.78);
      }

      .ov.show { display: flex; }

      .mbox {
        position: relative;
        width: 100%;
        max-width: 520px;
        max-height: 80vh;
        overflow-y: auto;
        padding: 28px 22px 24px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .mclose {
        position: absolute;
        top: 12px; right: 14px;
        border: 0;
        background: none;
        color: var(--dim);
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
      }

      .mbox h3 { font-size: 17px; font-weight: 900; padding-right: 24px; }

      .mbody {
        margin-top: 14px;
        color: var(--dim);
        font-size: 13px;
        line-height: 1.8;
      }

      .mbody h4 { margin: 14px 0 4px; color: var(--white); font-size: 13.5px; font-weight: 700; }
      .mbody ul { margin: 6px 0 6px 18px; }

      /* ── Scroll Reveal ── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: none;
      }

      /* ── Desktop ── */
      @media (min-width: 760px) {
        .hero-number { font-size: 80px; }
        .hero h1 { font-size: 30px; }
        .feed-wrap { height: 260px; }
      }

      /* ── Reduced motion ── */
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .feed-track { animation: none; }
        .feed-dot { animation: none; }
      }
    </style>
  </head>

  <body class={bodyClass}>
    <div class="shell">
      <!-- Hero -->
      <header class="hero">
        <p class="hero-number">12,847명</p>
        <h1>이미 반등 종목을<br/>받고 있습니다</h1>
        <p class="hero-sub">
          폭락장에서도 기회를 찾는 투자자들.<br/>지금 합류하세요.
        </p>
        <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
          <img src={ctaIcon.src} alt="" />
          <span>{joinWord}</span>
          {needNumber && <span class="num">7</span>}
        </a>
        {needNumber
          ? <p class="btn-hint">친구 추가 후 숫자 7을 보내면 분석 자료를 받을 수 있어요</p>
          : <p class="btn-hint">{channelShort}에서 바로 참여할 수 있어요</p>}
      </header>

      <!-- Activity Feed -->
      <section class="sec">
        <h2 class="sec-title">실시간 <span class="green">참여 현황</span></h2>
        <div class="feed-wrap">
          <div class="feed-track">
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">김○○님이 방금 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">이○○님이 3분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">박○○님이 7분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">최○○님이 12분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">정○○님이 18분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">강○○님이 25분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">조○○님이 31분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">윤○○님이 42분 전 참여했습니다</span></div>
            <!-- duplicate for seamless loop -->
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">김○○님이 방금 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">이○○님이 3분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">박○○님이 7분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">최○○님이 12분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">정○○님이 18분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">강○○님이 25분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">조○○님이 31분 전 참여했습니다</span></div>
            <div class="feed-item"><span class="feed-dot"></span><span class="feed-text">윤○○님이 42분 전 참여했습니다</span></div>
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="sec reveal">
        <h2 class="sec-title">실제 참여자 후기</h2>
        <div class="testimonials">
          <div class="tcard">
            <p>폭락장에서 매수 타이밍 잡은 건 여기 분석 덕분이에요. 혼자였으면 못 샀을 종목들이에요.</p>
            <cite>— 투자 3년차</cite>
          </div>
          <div class="tcard">
            <p>하루 5분 읽는 건데 시장 보는 눈이 완전히 달라졌어요. 주변에도 많이 추천했어요.</p>
            <cite>— 주부 투자자</cite>
          </div>
          <div class="tcard">
            <p>남들 다 패닉셀 할 때 여기서 '지금 줍자'라는 분석이 올라왔고, 실제로 반등했어요.</p>
            <cite>— 직장인 투자자</cite>
          </div>
        </div>
      </section>

      <!-- Service -->
      <section class="sec reveal">
        <h2 class="sec-title">지금 받고 있는 <span class="green">분석</span></h2>
        <div class="tags">
          <span class="tag">전문가 매일 분석</span>
          <span class="tag">반등 후보 종목</span>
          <span class="tag">매수/매도 타이밍</span>
          <span class="tag">실시간 시장 속보</span>
        </div>
        <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
          <img src={ctaIcon.src} alt="" />
          <span>{joinWord}</span>
          {needNumber && <span class="num">7</span>}
        </a>
      </section>

      <!-- Steps -->
      <section class="sec reveal">
        <h2 class="sec-title">참여 방법</h2>
        <div class="steps">
          {needNumber ? (
            <>
              <div class="step"><span class="sn">1</span><div><b>{channelShort} 친구 추가</b><p>아래 버튼을 누르면 자동으로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>숫자 '7' 보내기</b><p>채팅창에 숫자 7만 입력해서 보내주세요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>분석 자료 받기</b><p>매일 반등 종목 분석을 바로 받아보실 수 있어요.</p></div></div>
            </>
          ) : (
            <>
              <div class="step"><span class="sn">1</span><div><b>아래 버튼 누르기</b><p>{channelShort + (isBand ? '로' : '으로')} 바로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>입장하기</b><p>가입 절차도, 결제도 없어요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>분석 자료 받기</b><p>매일 반등 종목 분석을 바로 받아보실 수 있어요.</p></div></div>
            </>
          )}
        </div>
      </section>

      <!-- Legal notice -->
      <p class="notice">
        ※ 본 페이지의 모든 콘텐츠는 정보 제공 목적이며, 특정 금융상품의 매수·매도를 권유하지 않습니다.<br />
        ※ 투자 판단과 그에 따른 결과는 전적으로 이용자 본인에게 있습니다.
      </p>

      <!-- Footer -->
      <footer class="footer">
        <p>문의: info@marketanalysis.kr</p>
        <div class="footer-links">
          <a data-modal="privacy">개인정보 처리방침</a>
          <a data-modal="terms">이용약관</a>
          <a data-modal="disclaimer">면책 조항</a>
        </div>
      </footer>
    </div>

    <!-- Sticky CTA -->
    <div class="sticky">
      <a class="link-btn" href="javascript:void(0)" onclick={jumpFn}>
        <img src={ctaIcon.src} alt="" />
        <span>{joinWord}</span>
        {needNumber && <span class="num">7</span>}
      </a>
    </div>

    <!-- Legal Modals -->
    <div class="ov" id="modal">
      <div class="mbox" role="dialog" aria-modal="true">
        <button class="mclose" type="button" aria-label="닫기">&times;</button>
        <h3 id="mt"></h3>
        <div class="mbody" id="mb"></div>
      </div>
    </div>

    <script is:inline>
      var modalContent = {
        privacy: {
          title: '개인정보 처리방침',
          body: '<p>운영자는 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p><h4>1. 수집 항목</h4><p>서비스 이용 시 메신저 아이디 등 최소한의 정보만 수집합니다.</p><h4>2. 이용 목적</h4><ul><li>분석 자료 전달</li><li>커뮤니티 운영 및 관리</li></ul><h4>3. 보유 기간</h4><p>이용 목적 달성 후 지체 없이 파기합니다.</p><h4>4. 제3자 제공</h4><p>이용자의 사전 동의 없이 개인정보를 외부에 제공하지 않습니다.</p><h4>5. 이용자의 권리</h4><p>언제든지 본인의 개인정보 열람·정정·삭제를 요청할 수 있습니다.</p>'
        },
        terms: {
          title: '이용약관',
          body: '<p>본 약관은 서비스 이용과 관련하여 운영자와 이용자 간의 권리·의무를 규정합니다.</p><h4>제1조 (서비스의 성격)</h4><p>본 서비스는 시장 분석 정보를 공유하는 커뮤니티이며, 특정 금융상품의 매매를 권유하거나 중개하지 않습니다.</p><h4>제2조 (이용자의 의무)</h4><ul><li>다른 이용자를 존중하고 예의를 지킵니다.</li><li>허위 정보, 광고, 비방 등 운영을 방해하는 행위를 하지 않습니다.</li></ul><h4>제3조 (면책)</h4><p>제공되는 분석 자료는 참고용이며, 이를 기반으로 한 투자 판단의 결과에 대해 운영자는 책임지지 않습니다.</p>'
        },
        disclaimer: {
          title: '면책 조항',
          body: '<p>본 서비스에서 제공하는 모든 콘텐츠는 <b style="color:#e8eaf0">정보 제공 목적</b>으로만 제공됩니다.</p><h4>1. 투자 유의</h4><p>본 콘텐츠는 특정 금융상품의 매수·매도를 권유하지 않으며 어떠한 수익도 보장하지 않습니다.</p><h4>2. 책임의 한계</h4><p>이용자가 본 콘텐츠를 참고하여 내린 모든 판단과 그 결과에 대한 책임은 전적으로 이용자 본인에게 있습니다.</p>'
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        var ov = document.getElementById('modal')
        var mt = document.getElementById('mt')
        var mb = document.getElementById('mb')
        var openModal = function (k) {
          var d = modalContent[k]
          if (!d || !ov || !mt || !mb) return
          mt.textContent = d.title
          mb.innerHTML = d.body
          ov.classList.add('show')
          document.body.style.overflow = 'hidden'
        }
        var closeModal = function () {
          if (!ov) return
          ov.classList.remove('show')
          document.body.style.overflow = ''
        }
        document.querySelectorAll('[data-modal]').forEach(function (el) {
          el.addEventListener('click', function (e) { e.preventDefault(); openModal(el.getAttribute('data-modal')) })
        })
        if (ov) {
          ov.querySelector('.mclose').addEventListener('click', closeModal)
          ov.addEventListener('click', function (e) { if (e.target === ov) closeModal() })
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal() })

        /* Scroll reveal */
        var reveal = function () {
          document.querySelectorAll('.reveal').forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight * 0.88) {
              el.classList.add('visible')
            }
          })
        }
        window.addEventListener('scroll', reveal, { passive: true })
        reveal()
      })
    </script>
  </body>
</html>
