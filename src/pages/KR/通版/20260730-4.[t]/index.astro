---
import bandIcon from '@/assets/band-icon.png'
import kakaoIcon from '@/assets/kakao-icon.png'
import KRRedirectCode from '@/components/KRRedirectCode.astro'

export function getStaticPaths() {
  return [
    { params: { t: '卡扣' } },
    { params: { t: '卡群' } },
    { params: { t: '棒群' } },
  ]
}

const { t = '卡扣' } = Astro.params
const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelShort = isBand ? '밴드' : '카카오톡'
const jumpFn = isBand ? "onLinkBtnClick('band')" : "onLinkBtnClick()"
const bodyClass = isBand ? 'ch-band' : 'ch-kakao'
const ctaIcon = isBand ? bandIcon : kakaoIcon
const joinWord = isBand
  ? '밴드에서 대응 전략 받기'
  : needNumber
    ? '카카오톡으로 대응 전략 받기'
    : '카카오톡에서 바로 참여'

const title = '폭락장 생존 가이드 — 지금 해야 할 3가지'
const description = '폭락장에서 살아남는 법. 패닉셀 방지, 종목 점검, 전문가 대응 전략까지. 무료로 받아보세요.'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f14" />

    <KRRedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #0d0f14;
        --bg-2: #14161d;
        --amber: #d4a34a;
        --amber-dim: rgba(212, 163, 74, 0.15);
        --white: #e2e0e6;
        --dim: #7d7a84;
        --cta: #fee500;
        --cta-ink: #191600;
      }

      .ch-band {
        --cta: #21c063;
        --cta-ink: #04210f;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        padding-bottom: 92px;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--white);
        font-family: 'Noto Sans KR', sans-serif;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

      .shell { max-width: 720px; margin: 0 auto; }

      /* ── Hero ── */
      .hero {
        padding: 80px 24px 52px;
        text-align: center;
        background:
          radial-gradient(ellipse 80% 55% at 50% 0%, rgba(212, 163, 74, 0.05) 0%, transparent 70%),
          var(--bg);
      }

      .hero h1 {
        font-size: 32px;
        font-weight: 900;
        line-height: 1.2;
        color: var(--white);
      }

      .hero-sub {
        margin-top: 14px;
        color: var(--amber);
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      /* ── Buttons ── */
      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: 28px;
        padding: 17px 18px;
        border-radius: 14px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16.5px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
      }

      .btn img { width: 24px; height: 24px; }

      .btn .num {
        display: inline-grid;
        place-items: center;
        min-width: 26px;
        height: 24px;
        padding: 0 7px;
        border-radius: 7px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 14px;
        font-weight: 900;
      }

      .btn-hint {
        margin-top: 10px;
        color: var(--dim);
        font-size: 12.5px;
        text-align: center;
      }

      /* ── Chapters ── */
      .chapters {
        padding: 0 20px;
      }

      .chapter {
        position: relative;
        padding: 48px 0 0;
      }

      .chapter + .chapter {
        border-top: 3px solid var(--amber);
        margin-top: 48px;
      }

      .chapter-num {
        position: absolute;
        top: -20px;
        right: 0;
        font-size: 120px;
        font-weight: 900;
        color: rgba(255, 255, 255, 0.03);
        line-height: 1;
        pointer-events: none;
        user-select: none;
      }

      .chapter-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--amber);
        text-transform: uppercase;
      }

      .chapter-title {
        margin-top: 10px;
        font-size: 24px;
        font-weight: 900;
        line-height: 1.3;
        color: var(--white);
      }

      .chapter-body {
        margin-top: 16px;
        font-size: 15px;
        font-weight: 400;
        color: var(--dim);
        line-height: 1.85;
      }

      /* chapter 03 community intro */
      .ch3-community {
        margin-top: 20px;
        font-size: 15px;
        font-weight: 700;
        color: var(--white);
        line-height: 1.7;
      }

      /* ── Steps ── */
      .steps-sec {
        padding: 48px 20px 0;
      }

      .sec-title {
        font-size: 20px;
        font-weight: 900;
        text-align: center;
        margin-bottom: 20px;
      }

      .steps {
        display: grid;
        gap: 10px;
      }

      .step {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 18px;
        border: 1px solid var(--amber-dim);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .sn {
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--amber);
        color: var(--bg);
        font-size: 14px;
        font-weight: 900;
      }

      .step b { font-size: 15px; font-weight: 900; }
      .step p { margin-top: 2px; color: var(--dim); font-size: 13px; line-height: 1.7; }

      /* ── Legal / Footer ── */
      .notice {
        margin-top: 48px;
        padding: 20px;
        border-top: 1px solid var(--amber-dim);
        color: #5a5760;
        font-size: 11.5px;
        line-height: 1.85;
      }

      .footer { padding: 4px 20px 40px; }
      .footer p { color: var(--dim); font-size: 12px; line-height: 1.7; }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 14px;
      }

      .footer-links a {
        color: var(--white);
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      /* ── Sticky CTA ── */
      .sticky {
        position: fixed;
        right: 0; bottom: 0; left: 0;
        z-index: 80;
        display: flex;
        justify-content: center;
        background: rgba(13, 15, 20, 0.92);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--amber-dim);
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      }

      .sticky a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        max-width: 692px;
        padding: 15px 18px;
        border-radius: 12px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
      }

      .sticky img { width: 22px; height: 22px; }

      .sticky .num {
        display: inline-grid;
        place-items: center;
        min-width: 24px;
        height: 22px;
        padding: 0 6px;
        border-radius: 6px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 13px;
        font-weight: 900;
      }

      /* ── Modals ── */
      .ov {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2, 4, 10, 0.78);
      }

      .ov.show { display: flex; }

      .mbox {
        position: relative;
        width: 100%;
        max-width: 520px;
        max-height: 80vh;
        overflow-y: auto;
        padding: 28px 22px 24px;
        border: 1px solid var(--amber-dim);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .mclose {
        position: absolute;
        top: 12px; right: 14px;
        border: 0;
        background: none;
        color: var(--dim);
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
      }

      .mbox h3 { font-size: 17px; font-weight: 900; padding-right: 24px; }

      .mbody {
        margin-top: 14px;
        color: var(--dim);
        font-size: 13px;
        line-height: 1.8;
      }

      .mbody h4 { margin: 14px 0 4px; color: var(--white); font-size: 13.5px; font-weight: 700; }
      .mbody ul { margin: 6px 0 6px 18px; }

      /* ── Scroll reveal ── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: none;
      }

      @media (min-width: 760px) {
        .hero h1 { font-size: 44px; }
        .hero-sub { font-size: 19px; }
        .chapter-title { font-size: 26px; }
        .chapter-body { font-size: 16px; }
        .chapter-num { font-size: 150px; top: -30px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>

  <body class={bodyClass}>
    <div class="shell">

      <!-- Hero -->
      <header class="hero">
        <h1>폭락장 생존 가이드</h1>
        <p class="hero-sub">지금 당장 해야 할 3가지</p>
        <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
          <img src={ctaIcon.src} alt="" />
          <span>{joinWord}</span>
          {needNumber && <span class="num">7</span>}
        </a>
        {needNumber
          ? <p class="btn-hint">친구 추가 후 숫자 7을 보내면 대응 전략을 받을 수 있어요</p>
          : <p class="btn-hint">{channelShort}에서 바로 참여할 수 있어요</p>}
      </header>

      <!-- Chapters -->
      <div class="chapters">

        <!-- Chapter 01 — no .reveal (above the fold) -->
        <section class="chapter">
          <span class="chapter-num">01</span>
          <p class="chapter-label">Chapter 01</p>
          <h2 class="chapter-title">패닉셀 하지 마라</h2>
          <p class="chapter-body">
            공포에 팔면 바닥에 파는 겁니다. 2008년, 2020년 — 급락 직후 패닉셀 한 투자자들이 가장 큰 손실을 봤습니다. 감정이 아니라 숫자를 보고 판단하십시오.
          </p>
        </section>

        <!-- Chapter 02 -->
        <section class="chapter reveal">
          <span class="chapter-num">02</span>
          <p class="chapter-label">Chapter 02</p>
          <h2 class="chapter-title">보유 종목을 점검하라</h2>
          <p class="chapter-body">
            지금 들고 있는 종목이 반등할 수 있는 건지, 비중을 줄여야 하는 건지. 이 구분을 하지 않으면 회복이 와도 내 계좌만 빠져 있게 됩니다.
          </p>
        </section>

        <!-- Chapter 03 -->
        <section class="chapter reveal">
          <span class="chapter-num">03</span>
          <p class="chapter-label">Chapter 03</p>
          <h2 class="chapter-title">전문가의 시각을 빌려라</h2>
          <p class="chapter-body">
            하락장에서 혼자 판단하면 감정에 휘둘립니다. 기준이 되는 분석이 있으면 흔들리지 않습니다. 12,000명의 투자자가 매일 전문가의 분석을 받으며 함께 대응하고 있습니다.
          </p>
          <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
            <img src={ctaIcon.src} alt="" />
            <span>{joinWord}</span>
            {needNumber && <span class="num">7</span>}
          </a>
          {needNumber
            ? <p class="btn-hint">친구 추가 후 숫자 7을 보내면 대응 전략을 받을 수 있어요</p>
            : <p class="btn-hint">{channelShort}에서 바로 참여할 수 있어요</p>}
        </section>

      </div>

      <!-- Steps -->
      <section class="steps-sec reveal">
        <h2 class="sec-title">참여 방법</h2>
        <div class="steps">
          {needNumber ? (
            <>
              <div class="step"><span class="sn">1</span><div><b>{channelShort} 친구 추가</b><p>아래 버튼을 누르면 자동으로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>숫자 '7' 보내기</b><p>채팅창에 숫자 7만 입력해서 보내주세요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>대응 전략 받기</b><p>매일 시장 분석과 실전 매매 포인트를 바로 받아볼 수 있어요.</p></div></div>
            </>
          ) : (
            <>
              <div class="step"><span class="sn">1</span><div><b>아래 버튼 누르기</b><p>{channelShort + (isBand ? '로' : '으로')} 바로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>입장하기</b><p>가입 절차도, 결제도 없어요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>대응 전략 받기</b><p>매일 시장 분석과 실전 매매 포인트를 바로 받아볼 수 있어요.</p></div></div>
            </>
          )}
        </div>
      </section>

      <!-- Legal notice -->
      <p class="notice">
        ※ 본 페이지의 모든 콘텐츠는 정보 제공 목적이며, 특정 금융상품의 매수·매도를 권유하지 않습니다.<br />
        ※ 투자 판단과 그에 따른 결과는 전적으로 이용자 본인에게 있습니다.
      </p>

      <!-- Footer -->
      <footer class="footer">
        <p>문의: info@marketanalysis.kr</p>
        <div class="footer-links">
          <a data-modal="privacy">개인정보 처리방침</a>
          <a data-modal="terms">이용약관</a>
          <a data-modal="disclaimer">면책 조항</a>
        </div>
      </footer>
    </div>

    <!-- Sticky CTA -->
    <div class="sticky">
      <a class="link-btn" href="javascript:void(0)" onclick={jumpFn}>
        <img src={ctaIcon.src} alt="" />
        <span>{joinWord}</span>
        {needNumber && <span class="num">7</span>}
      </a>
    </div>

    <!-- Modal -->
    <div class="ov" id="modal">
      <div class="mbox" role="dialog" aria-modal="true">
        <button class="mclose" type="button" aria-label="닫기">&times;</button>
        <h3 id="mt"></h3>
        <div class="mbody" id="mb"></div>
      </div>
    </div>

    <script is:inline>
      var modalContent = {
        privacy: {
          title: '개인정보 처리방침',
          body: '<p>운영자는 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p><h4>1. 수집 항목</h4><p>서비스 이용 시 메신저 아이디 등 최소한의 정보만 수집합니다.</p><h4>2. 이용 목적</h4><ul><li>분석 자료 전달</li><li>커뮤니티 운영 및 관리</li></ul><h4>3. 보유 기간</h4><p>이용 목적 달성 후 지체 없이 파기합니다.</p><h4>4. 제3자 제공</h4><p>이용자의 사전 동의 없이 개인정보를 외부에 제공하지 않습니다.</p><h4>5. 이용자의 권리</h4><p>언제든지 본인의 개인정보 열람·정정·삭제를 요청할 수 있습니다.</p>'
        },
        terms: {
          title: '이용약관',
          body: '<p>본 약관은 서비스 이용과 관련하여 운영자와 이용자 간의 권리·의무를 규정합니다.</p><h4>제1조 (서비스의 성격)</h4><p>본 서비스는 시장 분석 정보를 공유하는 커뮤니티이며, 특정 금융상품의 매매를 권유하거나 중개하지 않습니다.</p><h4>제2조 (이용자의 의무)</h4><ul><li>다른 이용자를 존중하고 예의를 지킵니다.</li><li>허위 정보, 광고, 비방 등 운영을 방해하는 행위를 하지 않습니다.</li></ul><h4>제3조 (면책)</h4><p>제공되는 분석 자료는 참고용이며, 이를 기반으로 한 투자 판단의 결과에 대해 운영자는 책임지지 않습니다.</p>'
        },
        disclaimer: {
          title: '면책 조항',
          body: '<p>본 서비스에서 제공하는 모든 콘텐츠는 <b style="color:#e2e0e6">정보 제공 목적</b>으로만 제공됩니다.</p><h4>1. 투자 유의</h4><p>본 콘텐츠는 특정 금융상품의 매수·매도를 권유하지 않으며 어떠한 수익도 보장하지 않습니다.</p><h4>2. 책임의 한계</h4><p>이용자가 본 콘텐츠를 참고하여 내린 모든 판단과 그 결과에 대한 책임은 전적으로 이용자 본인에게 있습니다.</p>'
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        var ov = document.getElementById('modal')
        var mt = document.getElementById('mt')
        var mb = document.getElementById('mb')
        var open = function (k) {
          var d = modalContent[k]
          if (!d || !ov || !mt || !mb) return
          mt.textContent = d.title
          mb.innerHTML = d.body
          ov.classList.add('show')
          document.body.style.overflow = 'hidden'
        }
        var close = function () {
          if (!ov) return
          ov.classList.remove('show')
          document.body.style.overflow = ''
        }
        document.querySelectorAll('[data-modal]').forEach(function (el) {
          el.addEventListener('click', function (e) { e.preventDefault(); open(el.getAttribute('data-modal')) })
        })
        if (ov) {
          ov.querySelector('.mclose').addEventListener('click', close)
          ov.addEventListener('click', function (e) { if (e.target === ov) close() })
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close() })

        var reveal = function () {
          document.querySelectorAll('.reveal').forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight * 0.88) {
              el.classList.add('visible')
            }
          })
        }
        window.addEventListener('scroll', reveal, { passive: true })
        reveal()
      })
    </script>
  </body>
</html>
