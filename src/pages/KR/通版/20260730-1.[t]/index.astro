---
import bandIcon from '@/assets/band-icon.png'
import kakaoIcon from '@/assets/kakao-icon.png'
import KRRedirectCode from '@/components/KRRedirectCode.astro'

export function getStaticPaths() {
  return [
    { params: { t: '卡扣' } },
    { params: { t: '卡群' } },
    { params: { t: '棒群' } },
  ]
}

const { t = '卡扣' } = Astro.params
const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelShort = isBand ? '밴드' : '카카오톡'
const jumpFn = isBand ? "onLinkBtnClick('band')" : "onLinkBtnClick()"
const bodyClass = isBand ? 'ch-band' : 'ch-kakao'
const ctaIcon = isBand ? bandIcon : kakaoIcon
const joinWord = isBand
  ? '밴드에서 반등 종목 받기'
  : needNumber
    ? '카카오톡으로 반등 종목 받기'
    : '카카오톡에서 바로 참여'

const title = '역사는 반복된다 — 폭락 뒤 반등 종목 분석'
const description = '2008, 2020, 2022 — 역사적 폭락 뒤에는 항상 강한 반등이 왔습니다. 전문가가 매일 선별하는 반등 종목을 무료로 받아보세요.'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c12" />

    <KRRedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #0a0c12;
        --bg-2: #12151e;
        --line: rgba(201, 168, 76, 0.15);
        --gold: #c9a84c;
        --gold-bright: #e8c955;
        --gold-glow: rgba(232, 201, 85, 0.35);
        --white: #e4e4e8;
        --dim: #6b7084;
        --red: #ff4d4d;
        --green: #22cc88;
        --cta: #fee500;
        --cta-ink: #191600;
      }

      .ch-band {
        --cta: #21c063;
        --cta-ink: #04210f;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        padding-bottom: 92px;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--white);
        font-family: 'Noto Sans KR', sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

      .shell { max-width: 720px; margin: 0 auto; }

      /* ── Hero ── */
      .hero {
        position: relative;
        padding: 72px 24px 48px;
        text-align: center;
        background:
          radial-gradient(ellipse 90% 50% at 50% 0%, rgba(201, 168, 76, 0.06) 0%, transparent 70%),
          var(--bg);
      }

      .hero h1 {
        font-family: 'Black Han Sans', sans-serif;
        font-size: 42px;
        font-weight: 400;
        line-height: 1.15;
        color: var(--gold-bright);
        text-shadow: 0 0 40px var(--gold-glow);
      }

      .hero-sub {
        max-width: 340px;
        margin: 20px auto 0;
        color: var(--dim);
        font-size: 15px;
        line-height: 1.8;
      }

      /* ── Buttons ── */
      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: 24px;
        padding: 17px 18px;
        border-radius: 14px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16.5px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
      }

      .btn img { width: 24px; height: 24px; }

      .btn .num {
        display: inline-grid;
        place-items: center;
        min-width: 26px;
        height: 24px;
        padding: 0 7px;
        border-radius: 7px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 14px;
        font-weight: 900;
      }

      .btn-hint {
        margin-top: 10px;
        color: var(--dim);
        font-size: 12.5px;
        text-align: center;
      }

      /* ── Timeline ── */
      .timeline-sec {
        padding: 48px 20px 0;
      }

      .timeline {
        position: relative;
        padding-left: 32px;
      }

      .timeline::before {
        content: '';
        position: absolute;
        left: 9px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: linear-gradient(180deg, var(--gold) 0%, var(--gold-bright) 100%);
        opacity: 0.4;
      }

      .node {
        position: relative;
        padding: 0 0 48px;
      }

      .node:last-child {
        padding-bottom: 0;
      }

      .node::before {
        content: '';
        position: absolute;
        left: -32px;
        top: 6px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--bg);
        border: 2px solid var(--gold);
        z-index: 1;
      }

      .node-year {
        font-size: 13px;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: 0.5px;
      }

      .node-label {
        margin-top: 4px;
        font-size: 18px;
        font-weight: 900;
        line-height: 1.35;
      }

      .node-data {
        display: flex;
        gap: 16px;
        margin-top: 12px;
      }

      .node-crash,
      .node-recovery {
        font-size: 14px;
        font-weight: 700;
        line-height: 1.5;
      }

      .node-crash {
        color: var(--red);
      }

      .node-recovery {
        color: var(--green);
      }

      .node-arrow {
        color: var(--dim);
        font-size: 14px;
        line-height: 1.5;
      }

      /* "지금" node */
      .node-now::before {
        width: 28px;
        height: 28px;
        left: -36px;
        top: 2px;
        border: 3px solid var(--gold-bright);
        background: var(--gold);
        box-shadow:
          0 0 16px var(--gold-glow),
          0 0 40px rgba(232, 201, 85, 0.2);
      }

      .node-now .node-year {
        font-family: 'Black Han Sans', sans-serif;
        font-size: 22px;
        color: var(--gold-bright);
        text-shadow: 0 0 20px var(--gold-glow);
      }

      .node-now .node-label {
        font-size: 20px;
        color: var(--gold-bright);
      }

      .node-now .node-question {
        margin-top: 8px;
        font-size: 17px;
        font-weight: 900;
        color: var(--white);
      }

      .node-now .node-cta-text {
        margin-top: 14px;
        font-size: 14px;
        color: var(--dim);
        line-height: 1.7;
      }

      /* ── Community section ── */
      .community {
        padding: 56px 20px 0;
      }

      .community-desc {
        font-size: 15px;
        color: var(--dim);
        line-height: 1.8;
        text-align: center;
        max-width: 380px;
        margin: 0 auto;
      }

      .benefits {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-top: 24px;
      }

      .benefit {
        padding: 18px 10px;
        text-align: center;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--bg-2);
      }

      .benefit-icon {
        width: 36px;
        height: 36px;
        margin: 0 auto 10px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--gold), var(--gold-bright));
        display: grid;
        place-items: center;
      }

      .benefit-icon svg {
        width: 18px;
        height: 18px;
        fill: var(--bg);
      }

      .benefit span {
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
      }

      /* ── Steps ── */
      .steps-sec {
        padding: 48px 20px 0;
      }

      .sec-title {
        font-size: 20px;
        font-weight: 900;
        text-align: center;
        margin-bottom: 20px;
      }

      .steps {
        display: grid;
        gap: 10px;
      }

      .step {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .sn {
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--gold);
        color: var(--bg);
        font-size: 14px;
        font-weight: 900;
      }

      .step b { font-size: 15px; font-weight: 900; }
      .step p { margin-top: 2px; color: var(--dim); font-size: 13px; }

      /* ── Legal / Footer ── */
      .notice {
        margin-top: 48px;
        padding: 20px;
        border-top: 1px solid var(--line);
        color: #5a6580;
        font-size: 11.5px;
        line-height: 1.85;
      }

      .footer { padding: 4px 20px 40px; }
      .footer p { color: var(--dim); font-size: 12px; line-height: 1.7; }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 14px;
      }

      .footer-links a {
        color: var(--white);
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      /* ── Sticky CTA ── */
      .sticky {
        position: fixed;
        right: 0; bottom: 0; left: 0;
        z-index: 80;
        display: flex;
        justify-content: center;
        background: rgba(10, 12, 18, 0.92);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--line);
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      }

      .sticky a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        max-width: 692px;
        padding: 15px 18px;
        border-radius: 12px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
      }

      .sticky img { width: 22px; height: 22px; }

      .sticky .num {
        display: inline-grid;
        place-items: center;
        min-width: 24px;
        height: 22px;
        padding: 0 6px;
        border-radius: 6px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 13px;
        font-weight: 900;
      }

      /* ── Modals ── */
      .ov {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2, 4, 10, 0.78);
      }

      .ov.show { display: flex; }

      .mbox {
        position: relative;
        width: 100%;
        max-width: 520px;
        max-height: 80vh;
        overflow-y: auto;
        padding: 28px 22px 24px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .mclose {
        position: absolute;
        top: 12px; right: 14px;
        border: 0;
        background: none;
        color: var(--dim);
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
      }

      .mbox h3 { font-size: 17px; font-weight: 900; padding-right: 24px; }

      .mbody {
        margin-top: 14px;
        color: var(--dim);
        font-size: 13px;
        line-height: 1.8;
      }

      .mbody h4 { margin: 14px 0 4px; color: var(--white); font-size: 13.5px; font-weight: 700; }
      .mbody ul { margin: 6px 0 6px 18px; }

      /* ── Scroll reveal ── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: none;
      }

      @media (min-width: 760px) {
        .hero h1 { font-size: 56px; }
        .hero-sub { font-size: 16px; max-width: 400px; }
        .timeline { padding-left: 44px; }
        .timeline::before { left: 13px; }
        .node::before { left: -44px; width: 24px; height: 24px; }
        .node-now::before { width: 32px; height: 32px; left: -48px; }
        .node-label { font-size: 20px; }
        .node-now .node-year { font-size: 26px; }
        .node-now .node-label { font-size: 22px; }
        .benefits { gap: 14px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>

  <body class={bodyClass}>
    <div class="shell">

      <!-- Hero -->
      <header class="hero">
        <h1>역사는 반복된다</h1>
        <p class="hero-sub">
          폭락 뒤에는 항상 반등이 왔다. 지금, 또 한 번의 기회가 열리고 있다.
        </p>
        <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
          <img src={ctaIcon.src} alt="" />
          <span>{joinWord}</span>
          {needNumber && <span class="num">7</span>}
        </a>
        {needNumber
          ? <p class="btn-hint">친구 추가 후 숫자 7을 보내면 분석 자료를 받을 수 있어요</p>
          : <p class="btn-hint">{channelShort}에서 바로 참여할 수 있어요</p>}
      </header>

      <!-- Timeline -->
      <section class="timeline-sec">
        <div class="timeline">

          <div class="node">
            <p class="node-year">2008</p>
            <p class="node-label">글로벌 금융위기</p>
            <div class="node-data">
              <span class="node-crash">KOSPI -56%</span>
              <span class="node-arrow">&rarr;</span>
              <span class="node-recovery">12개월 후 +82% 반등</span>
            </div>
          </div>

          <div class="node">
            <p class="node-year">2020</p>
            <p class="node-label">코로나 팬데믹</p>
            <div class="node-data">
              <span class="node-crash">KOSPI -38%</span>
              <span class="node-arrow">&rarr;</span>
              <span class="node-recovery">8개월 후 +108% 반등</span>
            </div>
          </div>

          <div class="node reveal">
            <p class="node-year">2022</p>
            <p class="node-label">글로벌 금리 인상</p>
            <div class="node-data">
              <span class="node-crash">KOSPI -33%</span>
              <span class="node-arrow">&rarr;</span>
              <span class="node-recovery">6개월 후 +28% 반등</span>
            </div>
          </div>

          <div class="node node-now reveal">
            <p class="node-year">2026년, 지금</p>
            <p class="node-label">KOSPI 급락 중</p>
            <p class="node-question">다음 반등의 시작점?</p>
            <p class="node-cta-text">반등을 준비하는 12,000명과 함께하세요</p>
            <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
              <img src={ctaIcon.src} alt="" />
              <span>{joinWord}</span>
              {needNumber && <span class="num">7</span>}
            </a>
          </div>

        </div>
      </section>

      <!-- Community -->
      <section class="community reveal">
        <p class="community-desc">
          매일 전문가가 골라낸 회복 유망 종목과 매수 타이밍을 알려드립니다
        </p>
        <div class="benefits">
          <div class="benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1 15l-5-5 1.4-1.4L11 14.2l7.6-7.6L20 8l-9 9z"/></svg>
            </div>
            <span>매일 전문가 분석</span>
          </div>
          <div class="benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></svg>
            </div>
            <span>저점 매수 종목 선별</span>
          </div>
          <div class="benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
            </div>
            <span>12,000명 커뮤니티</span>
          </div>
        </div>
      </section>

      <!-- Steps -->
      <section class="steps-sec reveal">
        <h2 class="sec-title">참여 방법</h2>
        <div class="steps">
          {needNumber ? (
            <>
              <div class="step"><span class="sn">1</span><div><b>{channelShort} 친구 추가</b><p>아래 버튼을 누르면 자동으로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>숫자 '7' 보내기</b><p>채팅창에 숫자 7만 입력해서 보내주세요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>분석 자료 받기</b><p>매일 반등 종목 분석을 바로 받아볼 수 있어요.</p></div></div>
            </>
          ) : (
            <>
              <div class="step"><span class="sn">1</span><div><b>아래 버튼 누르기</b><p>{channelShort + (isBand ? '로' : '으로')} 바로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>입장하기</b><p>가입 절차도, 결제도 없어요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>분석 자료 받기</b><p>매일 반등 종목 분석을 바로 받아볼 수 있어요.</p></div></div>
            </>
          )}
        </div>
      </section>

      <!-- Legal notice -->
      <p class="notice">
        ※ 본 페이지의 모든 콘텐츠는 정보 제공 목적이며, 특정 금융상품의 매수·매도를 권유하지 않습니다.<br />
        ※ 투자 판단과 그에 따른 결과는 전적으로 이용자 본인에게 있습니다.
      </p>

      <!-- Footer -->
      <footer class="footer">
        <p>문의: info@marketanalysis.kr</p>
        <div class="footer-links">
          <a data-modal="privacy">개인정보 처리방침</a>
          <a data-modal="terms">이용약관</a>
          <a data-modal="disclaimer">면책 조항</a>
        </div>
      </footer>
    </div>

    <!-- Sticky CTA -->
    <div class="sticky">
      <a class="link-btn" href="javascript:void(0)" onclick={jumpFn}>
        <img src={ctaIcon.src} alt="" />
        <span>{joinWord}</span>
        {needNumber && <span class="num">7</span>}
      </a>
    </div>

    <!-- Modal -->
    <div class="ov" id="modal">
      <div class="mbox" role="dialog" aria-modal="true">
        <button class="mclose" type="button" aria-label="닫기">&times;</button>
        <h3 id="mt"></h3>
        <div class="mbody" id="mb"></div>
      </div>
    </div>

    <script is:inline>
      var modalContent = {
        privacy: {
          title: '개인정보 처리방침',
          body: '<p>운영자는 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p><h4>1. 수집 항목</h4><p>서비스 이용 시 메신저 아이디 등 최소한의 정보만 수집합니다.</p><h4>2. 이용 목적</h4><ul><li>분석 자료 전달</li><li>커뮤니티 운영 및 관리</li></ul><h4>3. 보유 기간</h4><p>이용 목적 달성 후 지체 없이 파기합니다.</p><h4>4. 제3자 제공</h4><p>이용자의 사전 동의 없이 개인정보를 외부에 제공하지 않습니다.</p><h4>5. 이용자의 권리</h4><p>언제든지 본인의 개인정보 열람·정정·삭제를 요청할 수 있습니다.</p>'
        },
        terms: {
