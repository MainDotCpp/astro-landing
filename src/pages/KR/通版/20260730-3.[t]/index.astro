---
import bandIcon from '@/assets/band-icon.png'
import kakaoIcon from '@/assets/kakao-icon.png'
import KRRedirectCode from '@/components/KRRedirectCode.astro'

export function getStaticPaths() {
  return [
    { params: { t: '卡扣' } },
    { params: { t: '卡群' } },
    { params: { t: '棒群' } },
  ]
}

const { t = '卡扣' } = Astro.params
const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelShort = isBand ? '밴드' : '카카오톡'
const jumpFn = isBand ? "onLinkBtnClick('band')" : "onLinkBtnClick()"
const bodyClass = isBand ? 'ch-band' : 'ch-kakao'
const ctaIcon = isBand ? bandIcon : kakaoIcon
const joinWord = isBand
  ? '밴드에서 리스크 알림 받기'
  : needNumber
    ? '카카오톡으로 리스크 알림 받기'
    : '카카오톡에서 바로 참여'

const title = '당신의 계좌는 안전한가요? — 실시간 리스크 알림'
const description = '보유 종목이 마이너스라면, 지금 대응이 필요합니다. 전문가 리스크 분석과 대응 전략을 무료로 받아보세요.'
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0810" />

    <KRRedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #0b0810;
        --bg-2: #140f1e;
        --line: rgba(138, 125, 150, 0.12);
        --white: #ede8f0;
        --dim: #8a7d96;
        --red: #ff3b3b;
        --red-dim: rgba(255, 59, 59, 0.15);
        --teal: #0d9488;
        --teal-dim: rgba(13, 148, 136, 0.12);
        --cta: #fee500;
        --cta-ink: #191600;
      }

      .ch-band {
        --cta: #21c063;
        --cta-ink: #04210f;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        padding-bottom: 92px;
        overflow-x: hidden;
        background: var(--bg);
        color: var(--white);
        font-family: 'Noto Sans KR', sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      img { display: block; max-width: 100%; height: auto; }
      a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }

      .shell { max-width: 720px; margin: 0 auto; }

      /* ── Hero ── */
      .hero {
        position: relative;
        overflow: hidden;
        padding: 64px 20px 48px;
        text-align: center;
        background:
          radial-gradient(ellipse 80% 50% at 50% 0%, rgba(255, 59, 59, 0.04) 0%, transparent 70%),
          var(--bg);
      }

      .hero h1 {
        font-size: 26px;
        font-weight: 900;
        line-height: 1.4;
        letter-spacing: -0.02em;
      }

      .hero-sub {
        max-width: 340px;
        margin: 16px auto 0;
        color: var(--dim);
        font-size: 15px;
        line-height: 1.75;
      }

      /* ── Symptom Check ── */
      .sec { padding: 48px 20px 0; }

      .sec-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--red);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        text-align: center;
        margin-bottom: 20px;
      }

      .symptoms {
        display: grid;
        gap: 10px;
      }

      .symptom {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 18px;
        border-left: 3px solid var(--red);
        border-radius: 0 12px 12px 0;
        background: var(--bg-2);
        font-size: 15.5px;
        font-weight: 700;
        line-height: 1.45;
      }

      .symptom::before {
        content: '\2713';
        flex: 0 0 24px;
        display: grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 5px;
        background: var(--red);
        color: #fff;
        font-size: 14px;
        font-weight: 900;
      }

      /* ── Diagnosis Panel ── */
      .diagnosis {
        margin: 36px 20px 0;
        padding: 28px 22px;
        border: 1px solid rgba(255, 59, 59, 0.25);
        border-radius: 16px;
        background: linear-gradient(180deg, rgba(255, 59, 59, 0.15) 0%, rgba(255, 59, 59, 0.05) 100%);
        text-align: center;
      }

      .diagnosis-title {
        font-size: 22px;
        font-weight: 900;
        color: var(--red);
        line-height: 1.3;
      }

      .diagnosis p {
        margin-top: 12px;
        color: var(--white);
        font-size: 15px;
        line-height: 1.7;
      }

      /* ── Prescription (teal zone) ── */
      .rx-intro {
        padding: 48px 20px 0;
        text-align: center;
      }

      .rx-intro p {
        max-width: 380px;
        margin: 0 auto;
        color: var(--dim);
        font-size: 15px;
        line-height: 1.75;
      }

      .benefits {
        display: grid;
        gap: 12px;
        margin-top: 24px;
        padding: 0 20px;
      }

      .benefit {
        padding: 20px;
        border-left: 3px solid var(--teal);
        border-radius: 0 12px 12px 0;
        background: var(--bg-2);
      }

      .benefit h3 {
        font-size: 16px;
        font-weight: 900;
        color: var(--teal);
      }

      .benefit p {
        margin-top: 6px;
        color: var(--dim);
        font-size: 13.5px;
        line-height: 1.7;
      }

      /* ── CTA Button ── */
      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: 20px;
        padding: 17px 18px;
        border-radius: 14px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16.5px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
      }

      .btn img { width: 24px; height: 24px; }

      .btn .num {
        display: inline-grid;
        place-items: center;
        min-width: 26px;
        height: 24px;
        padding: 0 7px;
        border-radius: 7px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 14px;
        font-weight: 900;
      }

      .btn-hint {
        margin-top: 10px;
        color: var(--dim);
        font-size: 12.5px;
        text-align: center;
      }

      .cta-wrap { padding: 0 20px; }

      /* ── Steps ── */
      .sec-title {
        font-size: 20px;
        font-weight: 900;
        line-height: 1.3;
        text-align: center;
      }

      .steps {
        display: grid;
        gap: 10px;
        margin-top: 24px;
      }

      .step {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .sn {
        flex: 0 0 30px;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--teal);
        color: #fff;
        font-size: 14px;
        font-weight: 900;
      }

      .step b { font-size: 15px; font-weight: 900; }
      .step p { margin-top: 2px; color: var(--dim); font-size: 13px; }

      /* ── FAQ ── */
      .faq {
        margin-top: 24px;
        border-top: 1px solid var(--line);
      }

      .faq details { border-bottom: 1px solid var(--line); }

      .faq summary {
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 2px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }

      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after { content: '+'; color: var(--teal); font-size: 20px; font-weight: 400; }
      .faq details[open] summary::after { content: '\2212'; }
      .faq details p { padding: 0 2px 16px; color: var(--dim); font-size: 13.5px; line-height: 1.7; }

      /* ── Legal & Footer ── */
      .notice {
        margin-top: 48px;
        padding: 20px;
        border-top: 1px solid var(--line);
        color: #5a4e68;
        font-size: 11.5px;
        line-height: 1.85;
      }

      .footer { padding: 4px 20px 40px; }
      .footer p { color: var(--dim); font-size: 12px; line-height: 1.7; }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 14px;
      }

      .footer-links a {
        color: var(--white);
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      /* ── Sticky Bar ── */
      .sticky {
        position: fixed;
        right: 0; bottom: 0; left: 0;
        z-index: 80;
        display: flex;
        justify-content: center;
        background: rgba(11, 8, 16, 0.92);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--line);
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      }

      .sticky a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        max-width: 692px;
        padding: 15px 18px;
        border-radius: 12px;
        background: var(--cta);
        color: var(--cta-ink);
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
      }

      .sticky img { width: 22px; height: 22px; }

      .sticky .num {
        display: inline-grid;
        place-items: center;
        min-width: 24px;
        height: 22px;
        padding: 0 6px;
        border-radius: 6px;
        background: var(--cta-ink);
        color: var(--cta);
        font-size: 13px;
        font-weight: 900;
      }

      /* ── Modal ── */
      .ov {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(5, 3, 10, 0.78);
      }

      .ov.show { display: flex; }

      .mbox {
        position: relative;
        width: 100%;
        max-width: 520px;
        max-height: 80vh;
        overflow-y: auto;
        padding: 28px 22px 24px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--bg-2);
      }

      .mclose {
        position: absolute;
        top: 12px; right: 14px;
        border: 0;
        background: none;
        color: var(--dim);
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
      }

      .mbox h3 { font-size: 17px; font-weight: 900; padding-right: 24px; }

      .mbody {
        margin-top: 14px;
        color: var(--dim);
        font-size: 13px;
        line-height: 1.8;
      }

      .mbody h4 { margin: 14px 0 4px; color: var(--white); font-size: 13.5px; font-weight: 700; }
      .mbody ul { margin: 6px 0 6px 18px; }

      /* ── Scroll Reveal ── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.5s ease, transform 0.5s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: none;
      }

      @media (min-width: 760px) {
        .hero h1 { font-size: 32px; }
        .symptom { font-size: 16.5px; }
        .diagnosis { margin: 36px auto 0; max-width: 680px; }
        .diagnosis-title { font-size: 26px; }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>

  <body class={bodyClass}>
    <div class="shell">
      <!-- Hero (no .reveal — above the fold) -->
      <header class="hero">
        <h1>당신의 계좌는<br />지금 안전한가요?</h1>
        <p class="hero-sub">하나라도 맞다면, 지금 움직여야 합니다.</p>
      </header>

      <!-- Symptom Checklist (no .reveal — above the fold) -->
      <section class="sec">
        <p class="sec-label">증상 체크</p>
        <div class="symptoms">
          <div class="symptom">보유 종목 대부분이 마이너스다</div>
          <div class="symptom">손절할지 버틸지 매일 고민한다</div>
          <div class="symptom">뉴스만 보면 불안해진다</div>
          <div class="symptom">혼자 판단하는 게 점점 두렵다</div>
        </div>
      </section>

      <!-- Diagnosis Panel -->
      <div class="diagnosis reveal">
        <p class="diagnosis-title">위험 신호 감지</p>
        <p>해당되는 항목이 있으셨죠?<br />가만히 있으면, 손실은 계속 늘어납니다.</p>
      </div>

      <!-- Prescription Zone (teal) -->
      <div class="rx-intro reveal">
        <p>혼자 버티지 마세요. 전문가 분석이 옆에 있으면 대응이 달라집니다.</p>
      </div>

      <div class="benefits reveal">
        <div class="benefit">
          <h3>실시간 리스크 알림</h3>
          <p>급락 시그널이 감지되면 즉시 알려드립니다.</p>
        </div>
        <div class="benefit">
          <h3>전문가 대응 전략</h3>
          <p>손절 타이밍, 종목 비중 조절까지 매일 알려드립니다.</p>
        </div>
        <div class="benefit">
          <h3>12,000명의 투자자 커뮤니티</h3>
          <p>혼자 불안해하지 마세요. 같은 상황의 투자자들과 실시간으로 정보 공유하세요.</p>
        </div>
      </div>

      <section class="sec reveal">
        <div class="cta-wrap">
          <a class="btn link-btn" href="javascript:void(0)" onclick={jumpFn}>
            <img src={ctaIcon.src} alt="" />
            <span>{joinWord}</span>
            {needNumber && <span class="num">7</span>}
          </a>
          {needNumber
            ? <p class="btn-hint">친구 추가 후 숫자 7을 보내면 리스크 알림을 받을 수 있어요</p>
            : <p class="btn-hint">{channelShort}에서 바로 참여할 수 있어요</p>}
        </div>
      </section>

      <!-- Steps -->
      <section class="sec reveal">
        <h2 class="sec-title">참여 방법</h2>
        <div class="steps">
          {needNumber ? (
            <>
              <div class="step"><span class="sn">1</span><div><b>{channelShort} 친구 추가</b><p>아래 버튼을 누르면 자동으로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>숫자 '7' 보내기</b><p>채팅창에 숫자 7만 입력해서 보내주세요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>리스크 알림 받기</b><p>매일 시장 분석과 대응 전략을 바로 받아보실 수 있어요.</p></div></div>
            </>
          ) : (
            <>
              <div class="step"><span class="sn">1</span><div><b>아래 버튼 누르기</b><p>{channelShort + (isBand ? '로' : '으로')} 바로 연결돼요.</p></div></div>
              <div class="step"><span class="sn">2</span><div><b>입장하기</b><p>가입 절차도, 결제도 없어요.</p></div></div>
              <div class="step"><span class="sn">3</span><div><b>리스크 알림 받기</b><p>매일 시장 분석과 대응 전략을 바로 받아보실 수 있어요.</p></div></div>
            </>
          )}
        </div>
      </section>

      <!-- FAQ -->
      <section class="sec reveal">
        <h2 class="sec-title">자주 묻는 질문</h2>
        <div class="faq">
          <details>
            <summary>정말 무료인가요?</summary>
            <p>네, 비용은 전혀 없어요.</p>
          </details>
          <details>
            <summary>어떤 정보를 받을 수 있나요?</summary>
            <p>매일 시장 리스크 분석, 종목 점검 가이드, 대응 전략, 급변 시 실시간 알림을 받으실 수 있습니다.</p>
          </details>
          <details>
            <summary>이미 손실이 크면 늦은 건 아닌가요?</summary>
            <p>늦지 않았어요. 지금부터라도 제대로 대응하면 추가 손실을 막고 회복 구간을 잡을 수 있어요.</p>
          </details>
        </div>
      </section>

      <!-- Legal Notice -->
      <p class="notice">
        ※ 본 페이지의 모든 콘텐츠는 정보 제공 목적이며, 특정 금융상품의 매수·매도를 권유하지 않습니다.<br />
        ※ 투자 판단과 그에 따른 결과는 전적으로 이용자 본인에게 있습니다.
      </p>

      <!-- Footer -->
      <footer class="footer">
        <p>문의: info@marketanalysis.kr</p>
        <div class="footer-links">
          <a data-modal="privacy">개인정보 처리방침</a>
          <a data-modal="terms">이용약관</a>
          <a data-modal="disclaimer">면책 조항</a>
        </div>
      </footer>
    </div>

    <!-- Sticky CTA Bar -->
    <div class="sticky">
      <a class="link-btn" href="javascript:void(0)" onclick={jumpFn}>
        <img src={ctaIcon.src} alt="" />
        <span>{joinWord}</span>
        {needNumber && <span class="num">7</span>}
      </a>
    </div>

    <!-- Legal Modals -->
    <div class="ov" id="modal">
      <div class="mbox" role="dialog" aria-modal="true">
        <button class="mclose" type="button" aria-label="닫기">&times;</button>
        <h3 id="mt"></h3>
        <div class="mbody" id="mb"></div>
      </div>
    </div>

    <script is:inline>
      var modalContent = {
        privacy: {
          title: '개인정보 처리방침',
          body: '<p>운영자는 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p><h4>1. 수집 항목</h4><p>서비스 이용 시 메신저 아이디 등 최소한의 정보만 수집합니다.</p><h4>2. 이용 목적</h4><ul><li>분석 자료 전달</li><li>커뮤니티 운영 및 관리</li></ul><h4>3. 보유 기간</h4><p>이용 목적 달성 후 지체 없이 파기합니다.</p><h4>4. 제3자 제공</h4><p>이용자의 사전 동의 없이 개인정보를 외부에 제공하지 않습니다.</p><h4>5. 이용자의 권리</h4><p>언제든지 본인의 개인정보 열람·정정·삭제를 요청할 수 있습니다.</p>'
        },
        terms: {
          title: '이용약관',
          body: '<p>본 약관은 서비스 이용과 관련하여 운영자와 이용자 간의 권리·의무를 규정합니다.</p><h4>제1조 (서비스의 성격)</h4><p>본 서비스는 시장 분석 정보를 공유하는 커뮤니티이며, 특정 금융상품의 매매를 권유하거나 중개하지 않습니다.</p><h4>제2조 (이용자의 의무)</h4><ul><li>다른 이용자를 존중하고 예의를 지킵니다.</li><li>허위 정보, 광고, 비방 등 운영을 방해하는 행위를 하지 않습니다.</li></ul><h4>제3조 (면책)</h4><p>제공되는 분석 자료는 참고용이며, 이를 기반으로 한 투자 판단의 결과에 대해 운영자는 책임지지 않습니다.</p>'
        },
        disclaimer: {
          title: '면책 조항',
          body: '<p>본 서비스에서 제공하는 모든 콘텐츠는 <b style="color:#ede8f0">정보 제공 목적</b>으로만 제공됩니다.</p><h4>1. 투자 유의</h4><p>본 콘텐츠는 특정 금융상품의 매수·매도를 권유하지 않으며 어떠한 수익도 보장하지 않습니다.</p><h4>2. 책임의 한계</h4><p>이용자가 본 콘텐츠를 참고하여 내린 모든 판단과 그 결과에 대한 책임은 전적으로 이용자 본인에게 있습니다.</p>'
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        var ov = document.getElementById('modal')
        var mt = document.getElementById('mt')
        var mb = document.getElementById('mb')
        var open = function (k) {
          var d = modalContent[k]
          if (!d || !ov || !mt || !mb) return
          mt.textContent = d.title
          mb.innerHTML = d.body
          ov.classList.add('show')
          document.body.style.overflow = 'hidden'
        }
        var close = function () {
          if (!ov) return
          ov.classList.remove('show')
          document.body.style.overflow = ''
        }
        document.querySelectorAll('[data-modal]').forEach(function (el) {
          el.addEventListener('click', function (e) { e.preventDefault(); open(el.getAttribute('data-modal')) })
        })
        if (ov) {
          ov.querySelector('.mclose').addEventListener('click', close)
          ov.addEventListener('click', function (e) { if (e.target === ov) close() })
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close() })

        var reveal = function () {
          document.querySelectorAll('.reveal').forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight * 0.88) {
              el.classList.add('visible')
            }
          })
        }
        window.addEventListener('scroll', reveal, { passive: true })
        reveal()
      })
    </script>
  </body>
</html>
