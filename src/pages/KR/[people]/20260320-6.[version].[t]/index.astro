---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'
import stockLimitup from './static/stock_limitup.jpg'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
const dateStr = `${today.getFullYear()}. ${String(today.getMonth() + 1)}. ${String(today.getDate())}.`
---

<KRBaseLayout title={`네이버 블로그 | ${name}의 실전 투자 일지`} description={`${name}의 단기 급등주 포착 노하우 공개`}>
  <style is:global slot="head">
    @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");

    :root {
      --naver-green: #03C75A;
      --naver-text: #333333;
      --naver-sub: #8F8F8F;
      --naver-bg: #FFFFFF;
      --naver-gray: #F5F6F8;
      --naver-border: #E5E5E5;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #F0F0F0;
      color: var(--naver-text);
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
    }

    .nb-app {
      max-width: 420px;
      margin: 0 auto;
      background: var(--naver-bg);
      min-height: 100vh;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    /* GNB (Global Navigation Bar) */
    .nb-gnb {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 50px;
      padding: 0 16px;
      border-bottom: 1px solid var(--naver-border);
      position: sticky;
      top: 0;
      background: var(--naver-bg);
      z-index: 100;
    }
    .nb-logo {
      font-weight: 900;
      font-size: 18px;
      color: var(--naver-green);
      letter-spacing: -0.5px;
      font-family: 'Arial', sans-serif;
    }
    .nb-logo span { color: #000; font-weight: 400; font-size: 16px; margin-left: 2px; }
    .nb-icons {
      display: flex;
      gap: 14px;
      color: #333;
    }

    /* Blog Header */
    .nb-blog-header {
      padding: 24px 20px 0;
    }
    .nb-category {
      font-size: 13px;
      color: var(--naver-sub);
      margin-bottom: 8px;
    }
    .nb-title {
      font-size: 24px;
      font-weight: 400;
      line-height: 1.35;
      letter-spacing: -0.04em;
      margin-bottom: 24px;
    }
    .nb-author-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--naver-border);
    }
    .nb-avatar {
      width: 40px; height: 40px;
      border-radius: 50%;
      object-fit: cover;
    }
    .nb-author-info { flex: 1; }
    .nb-author-name {
      font-size: 14px; font-weight: 600; color: #000;
    }
    .nb-meta {
      font-size: 12px; color: var(--naver-sub); display: flex; gap: 8px; margin-top: 2px;
    }

    /* Post Content */
    .nb-content {
      padding: 30px 20px;
      font-size: 16px;
      line-height: 1.8;
      color: #000;
      word-break: keep-all;
    }
    .nb-p { margin-bottom: 24px; }
    .nb-highlight {
      background: rgba(3, 199, 90, 0.1);
      color: #009f47;
      font-weight: 700;
      padding: 2px 4px;
    }
    .nb-quote {
      border-left: 3px solid var(--naver-green);
      padding-left: 14px;
      margin: 30px 0;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.5;
      color: #222;
    }
    .nb-img-placeholder {
      width: 100%;
      height: 200px;
      background: var(--naver-gray);
      border-radius: 8px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--naver-sub);
      font-size: 13px;
    }
    .nb-img-wrap {
      width: 100%;
      margin-bottom: 24px;
      border-radius: 8px;
      overflow: hidden;
    }
    .nb-content-img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* Sticker (Naver Blog emotion) */
    .nb-sticker {
      text-align: center;
      margin: 40px 0;
      font-size: 50px;
    }

    /* Warning/Info Box */
    .nb-info-box {
      background: var(--naver-gray);
      padding: 20px;
      border-radius: 12px;
      margin: 30px 0;
      text-align: center;
    }
    .nb-info-title {
      font-size: 16px; font-weight: 700; color: #f23636; margin-bottom: 10px;
    }
    .nb-info-desc {
      font-size: 14px; line-height: 1.6; color: #555; margin-bottom: 20px;
    }

    /* Reactions */
    .nb-reactions {
      padding: 0 20px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      border-bottom: 8px solid var(--naver-gray);
    }
    .nb-reaction-btn {
      display: flex; align-items: center; gap: 6px; font-size: 14px; color: #555;
    }
    .nb-reaction-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; }

    /* Comments */
    .nb-comments { padding: 20px; }
    .nb-cmt-header { font-size: 16px; font-weight: 700; margin-bottom: 20px; }
    .nb-cmt { display: flex; gap: 12px; margin-bottom: 20px; }
    .nb-cmt-av { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
    .nb-cmt-name { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
    .nb-cmt-text { font-size: 14px; line-height: 1.5; color: #333; margin-bottom: 6px; }
    .nb-cmt-date { font-size: 12px; color: var(--naver-sub); }

    /* Floating CTA */
    .nb-floating {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 40px);
      max-width: 380px;
      z-index: 100;
    }
    .nb-floating .link-btn {
      width: 100%;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25) !important;
      border-radius: 50px !important;
      font-weight: 700 !important;
      font-size: 16px !important;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>

  <div class="nb-app">
    <!-- GNB -->
    <header class="nb-gnb">
      <div class="nb-logo">NAVER<span>블로그</span></div>
      <div class="nb-icons">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>
    </header>

    <!-- Post Header -->
    <div class="nb-blog-header">
      <div class="nb-category">주식/투자 일지</div>
      <h1 class="nb-title">어제 말씀드린 종목, 오늘 점상 갔습니다 (인증 O, 다음 타점 공개)</h1>
      <div class="nb-author-row">
        <Image src={headImg} alt={name} class="nb-avatar" width={40} height={40} />
        <div class="nb-author-info">
          <div class="nb-author-name">{name}의 실전투자</div>
          <div class="nb-meta">
            <span>{dateStr}</span>
            <span>조회 15,201</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Content -->
    <main class="nb-content">
      <p class="nb-p">안녕하세요. {name}입니다.</p>
      <p class="nb-p">어제 제 블로그와 톡방을 통해 공유해드린 <span class="nb-highlight">외인 매집주 (반도체 장비 관련)</span> 오늘 장 시작하자마자 갭 띄우고 바로 상한가 직행했네요.</p>

      <div class="nb-img-wrap">
        <Image src={stockLimitup} alt="영웅문 모바일 증권앱 상한가 캡처" class="nb-content-img" width={420} height={200} />
      </div>

      <p class="nb-p">개인투자자분들이 가장 힘들어하시는 게 <strong>수익 날 때는 찔끔 먹고, 손실 날 때는 크게 물리는 것</strong>입니다. 하지만 기관과 외인의 매동을 정확히 읽으면, 이런 상한가는 우연이 아니라 필연이 됩니다.</p>

      <div class="nb-quote">
        "다음 주 월요일 극비리 발표 예정된 M&A 관련주, 지금이 마지막 매수 기회입니다."
      </div>

      <div class="nb-sticker">🤩🚀📈</div>

      <p class="nb-p">이전 톡방에서 못 잡으신 분들이 쪽지로 너무 많이 문의를 주셔서, 블로그에는 공개하기 어려운 <strong>[제 2의 급등주]</strong> 정보는 카카오톡 정보방에서만 단독으로 풀어드리겠습니다.</p>
      <p class="nb-p">단순 정보 전달이 아닙니다. 정확한 <span class="nb-highlight">매수가, 목표가, 손절가</span>까지 전부 다 잡아드립니다.</p>

      <div class="nb-info-box">
        <div class="nb-info-title">🚨 선착순 50명 무료 입장 진행중 🚨</div>
        <div class="nb-info-desc">
          현재 방 인원이 거의 꽉 찼습니다.<br>입장 후 바로 종목명 먼저 확인하세요!
        </div>
        <CtaButton social={t} />
      </div>

      <p class="nb-p" style="text-align: center; font-size: 14px; color: #888;">
        (광고/홍보성 글이 아닌 순수 개인 투자 관점 공유입니다)
      </p>
    </main>

    <!-- Reactions -->
    <div class="nb-reactions">
      <div class="nb-reaction-btn">
        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        공감 1,204
      </div>
      <div class="nb-reaction-btn">
        <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        댓글 89
      </div>
      <div class="nb-reaction-btn" style="margin-left: auto;">
        <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
      </div>
    </div>

    <!-- Comments -->
    <div class="nb-comments">
      <div class="nb-cmt-header">댓글 (89)</div>

      <div class="nb-cmt">
        <img class="nb-cmt-av" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=100&h=100&fit=crop" alt="user" />
        <div>
          <div class="nb-cmt-name">별빛바다</div>
          <div class="nb-cmt-text">와 대표님 어제 알려주신거 진짜 상 가네요 ㄷㄷ 카톡방 아직 자리 있나요?</div>
          <div class="nb-cmt-date">30분 전</div>
        </div>
      </div>
      <div class="nb-cmt">
        <img class="nb-cmt-av" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&h=100&fit=crop" alt="user" />
        <div>
          <div class="nb-cmt-name">행복한부자</div>
          <div class="nb-cmt-text">저도 방금 들어갔습니다! 빨리 내일장 열렸으면 좋겠네요 ㅎㅎ</div>
          <div class="nb-cmt-date">1시간 전</div>
        </div>
      </div>
      <div class="nb-cmt">
        <img class="nb-cmt-av" src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&h=100&fit=crop" alt="user" />
        <div>
          <div class="nb-cmt-name">주린이아빠</div>
          <div class="nb-cmt-text">진짜 여기서 정보받고 마이너스 계좌가 플러스로 돌아섰습니다. 평생 은인입니다.</div>
          <div class="nb-cmt-date">2시간 전</div>
        </div>
      </div>
      <div style="height: 80px;"></div> <!-- Bottom padding for sticky CTA -->
    </div>

    <!-- Floating Bottom CTA -->
    <div class="nb-floating">
      <CtaButton social={t} />
    </div>

  </div>
</KRBaseLayout>
