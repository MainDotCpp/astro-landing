---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)
const chartImg = import(`../images/kr_stock_chart.png`)

const today = new Date()
const dateStr = `${today.getFullYear()}.${String(today.getMonth() + 1).padStart(2, '0')}.${String(today.getDate()).padStart(2, '0')}`
---

<KRBaseLayout title={`[긴급진단] ${name} 수석의 2026 하반기 투자 전략`} description="외국인 순매수 집중 종목 분석">
  <style is:global slot="head">
    @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");
    @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700;900&display=swap');
    
    :root {
      --primary-blue: #0A3668;
      --secondary-blue: #1A5296;
      --accent-red: #E22B2A;
      --bg-light: #F8F9FA;
      --border-color: #E6E8EA;
      --text-main: #111111;
      --text-muted: #666666;
      --text-light: #888888;
    }

    body {
      background: #E5E7EB; /* Gray background outside mobile container */
      color: var(--text-main);
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    .report-container {
      max-width: 480px;
      margin: 0 auto;
      background: #FFFFFF;
      min-height: 100vh;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
      position: relative;
    }

    /* Professional Topbar */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      border-bottom: 2px solid var(--primary-blue);
      background: #FFFFFF;
    }
    .topbar-logo {
      font-family: 'Noto Serif KR', serif;
      font-weight: 900;
      font-size: 22px;
      color: var(--primary-blue);
      letter-spacing: -0.5px;
    }
    .topbar-icons svg {
      width: 24px;
      height: 24px;
      stroke: #333;
      fill: none;
      stroke-width: 1.5;
    }

    /* Market Ticker */
    .ticker {
      background: var(--bg-light);
      padding: 10px 20px;
      font-size: 13px;
      display: flex;
      gap: 16px;
      border-bottom: 1px solid var(--border-color);
      overflow-x: hidden;
      white-space: nowrap;
    }
    .ticker-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      font-weight: 500;
    }
    .ticker-val {
      color: var(--accent-red);
      font-weight: 700;
      font-family: monospace;
      font-size: 14px;
    }

    /* Title Area */
    .title-area {
      padding: 28px 20px 20px;
    }
    .badge-urgent {
      display: inline-block;
      color: var(--accent-red);
      border: 1px solid var(--accent-red);
      padding: 3px 8px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .main-title {
      font-family: 'Noto Serif KR', serif;
      font-size: 28px;
      font-weight: 900;
      line-height: 1.35;
      color: #000;
      margin: 0 0 16px;
      letter-spacing: -0.5px;
      word-break: keep-all;
    }
    .meta-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }
    .author {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .author-img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border-color);
    }
    .author-details {
      display: flex;
      flex-direction: column;
    }
    .author-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
    }
    .author-role {
      font-size: 11px;
      color: var(--text-light);
    }
    .date-str {
      font-size: 12px;
      color: var(--text-light);
      font-family: monospace;
    }

    /* Content Area */
    .content-area {
      padding: 0 0 40px;
    }
    
    .content-lead {
      padding: 0 20px;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.6;
      color: var(--primary-blue);
      margin-bottom: 28px;
      word-break: keep-all;
    }

    .content-img-wrap {
      margin-bottom: 24px;
      position: relative;
    }
    .content-img {
      width: 100%;
      height: auto;
      display: block;
    }
    .img-caption {
      font-size: 12px;
      color: var(--text-light);
      text-align: right;
      padding: 8px 20px 0;
    }

    .content-text {
      padding: 0 20px;
      font-size: 16.5px;
      line-height: 1.8;
      color: #333333;
      margin-bottom: 20px;
      word-break: keep-all;
    }

    /* Key Points Box */
    .key-points {
      margin: 32px 20px;
      background: #F4F7FA;
      border-top: 2px solid var(--primary-blue);
      padding: 24px 20px;
    }
    .kp-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--primary-blue);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .kp-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .kp-list li {
      position: relative;
      padding-left: 14px;
      font-size: 15px;
      line-height: 1.5;
      margin-bottom: 12px;
      color: #222;
      word-break: keep-all;
    }
    .kp-list li::before {
      content: '■';
      position: absolute;
      left: 0;
      top: 3px;
      color: var(--secondary-blue);
      font-size: 10px;
    }

    /* Highlighted text */
    .highlight-red {
      color: var(--accent-red);
      font-weight: 700;
    }
    .highlight-bg {
      background: linear-gradient(to top, #FFE5E5 40%, transparent 40%);
      font-weight: 700;
    }

    /* Disclaimer / Footer */
    .disclaimer {
      margin: 0 20px 30px;
      padding: 16px;
      background: var(--bg-light);
      border-radius: 4px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-muted);
    }
    
    .footer {
      border-top: 1px solid var(--border-color);
      padding: 30px 20px;
      text-align: center;
      background: #FFFFFF;
    }
    .footer-logo {
      font-family: 'Noto Serif KR', serif;
      font-size: 18px;
      color: #CCCCCC;
      font-weight: 900;
      margin-bottom: 8px;
    }
    .footer-text {
      font-size: 11px;
      color: var(--text-light);
      line-height: 1.6;
    }

    /* Fixed CTA */
    .cta-wrapper {
      position: sticky;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--border-color);
      padding: 20px;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.05);
      z-index: 100;
      text-align: center;
    }
    .cta-message {
      font-size: 14px;
      font-weight: 700;
      color: var(--primary-blue);
      margin-bottom: 12px;
    }
  </style>

  <div class="report-container">
    <!-- Header -->
    <header class="topbar">
      <div class="topbar-logo">투자 인사이트</div>
      <div class="topbar-icons">
        <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>
    </header>

    <!-- Ticker -->
    <div class="ticker">
      <div class="ticker-item">KOSPI <span class="ticker-val">2,785.42 ▲12.5</span></div>
      <div class="ticker-item">KOSDAQ <span class="ticker-val">872.15 ▲6.3</span></div>
    </div>

    <!-- Title Section -->
    <section class="title-area">
      <div class="badge-urgent">단독 분석</div>
      <h1 class="main-title">“지금 안 사면 평생 후회한다”… 외국인·기관이 은밀히 쓸어담는 ‘이 종목’</h1>
      
      <div class="meta-info">
        <div class="author">
          <Image src={headImg} alt={name} class="author-img" width={36} height={36} />
          <div class="author-details">
            <span class="author-name">{name}</span>
            <span class="author-role">수석 애널리스트</span>
          </div>
        </div>
        <div class="date-str">{dateStr} 08:30</div>
      </div>
    </section>

    <!-- Main Content -->
    <main class="content-area">
      <div class="content-lead">
        - 외국인 순매수 1위… 시장 주도주 교체 신호탄<br>
        - 실적 턴어라운드 원년, 유통 주식수 품귀 현상 임박
      </div>

      <div class="content-text">
        시장은 항상 개인 투자자들이 알아채기 전에 먼저 움직인다. 최근 일주일간 코스피 시장에서 극히 이례적인 수급 쏠림 현상이 포착되었다. 조 단위 자금을 굴리는 외국인과 연기금이 단 하나의 섹터, 특히 특정 '한 종목'에 대해 강한 매수 집중을 보이고 있는 것이다.
      </div>

      <div class="content-img-wrap">
        <Image src={chartImg} alt="Market Analysis Chart" class="content-img" width={800} height={400} />
        <div class="img-caption">(자료: AI 투자 데이터 분석 센터)</div>
      </div>

      <div class="content-text">
        저명한 펀드매니저 출신이자 현 수석 애널리스트인 {name} 전문가는 이를 두고 <span class="highlight-bg">"단순한 기술적 반등이 아닌, 산업 구조 변화에 따른 대세 상승 초입"</span>이라고 강력히 주장했다.
      </div>

      <div class="content-text">
        현재 이 기업은 글로벌 빅테크와의 핵심 공급망 계약(NDA) 체결이 임박했다는 여의도 정보지의 소문이 돌면서, 기관 창구를 통한 매집이 가속화되고 있다. 매수 잔량이 기하급수적으로 늘어나며 조만간 <span class="highlight-red">거래 정지와 함께 상한가 직행</span>이 예상된다.
      </div>

      <div class="key-points">
        <div class="kp-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          긴급 점검: 왜 당장 주목해야 하는가?
        </div>
        <ul class="kp-list">
          <li><strong>절대적 저평가 구간:</strong> PER 현저히 낮음. 하반기 실적 반영 시 주가 리레이팅 필수.</li>
          <li><strong>초대형 수주 공시 임박:</strong> 미국 유력 AI 반도체 기업가의 독점 납품 파트너십.</li>
          <li><strong>완벽한 수급 장악:</strong> 최근 한 달간 유통 주식의 35%가 집중 매집 완료.</li>
        </ul>
      </div>

      <div class="content-text">
        경험상 이런 종목들은 공시가 나오는 순간 개인이 매수할 수 있는 기회를 주지 않고 점상한가로 직행한다. 망설이는 순간 수익률은 반토막이 난다. 철저한 분석 끝에 찾아낸 이 종목의 <span class="highlight-bg">정확한 종목명과 매수 타점</span>을 현재 한정적으로 무료 공개 중이다.
      </div>

      <!-- Disclaimer -->
      <div class="disclaimer">
        ※ 본 기사 형식의 페이지는 투자 참고용 정보 제공을 목적으로 하며, 실제 추천 종목 정보는 하단 링크를 통해 확인하실 수 있습니다. 투자 결정은 전적으로 본인의 책임 하에 이루어져야 합니다.
      </div>

      <!-- Footer -->
      <footer class="footer">
        <div class="footer-logo">투자 인사이트</div>
        <div class="footer-text">
          본 페이지의 모든 콘텐츠는 저작권법의 보호를 받습니다.<br>
          무단 전재, 복사, 배포 등을 금합니다.<br>
          Copyright © 투자 인사이트. All Rights Reserved.
        </div>
      </footer>
    </main>

    <!-- Sticky CTA -->
    <div class="cta-wrapper">
      <div class="cta-message">
        ▼ 지금 즉시 '확실한 폭등 주도주' 확인하기 ▼
      </div>
      <CtaButton social={t} />
    </div>
  </div>
</KRBaseLayout>
