---
import { Image } from 'astro:assets'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
// On Blind, posts often show time relative like '10분 전' or '오늘 10:24'
// We can use a static '15분 전' (15 mins ago) for realism
---

<KRBaseLayout title="블라인드 | 주식/투자" description="여의도 현직입니다. 이번 주 무조건 쓸어담아야 할 종목 딱 하나 풉니다.">
  <style is:global slot="head">
    @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");
    
    :root {
      --blind-blue: #37ADCF;
      --blind-dark: #222222;
      --blind-gray: #94969B;
      --blind-lightgray: #F4F4F4;
      --blind-border: #E8E8E8;
    }

    body {
      background: #E5E5EA; /* gray background outside the app wrapper */
      font-family: 'Pretendard', -apple-system, sans-serif;
      color: var(--blind-dark);
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    .blind-app {
      max-width: 480px;
      margin: 0 auto;
      background: #FFFFFF;
      min-height: 100vh;
      box-shadow: 0 0 20px rgba(0,0,0,0.05);
      position: relative;
    }

    /* Header */
    .header {
      height: 54px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      border-bottom: 1px solid var(--blind-border);
      position: sticky;
      top: 0;
      background: #fff;
      z-index: 100;
    }
    .header-left, .header-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .header-title {
      font-size: 16px;
      font-weight: 700;
    }
    .icon-btn {
      width: 24px;
      height: 24px;
      fill: none;
      stroke: var(--blind-dark);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      cursor: pointer;
    }

    /* Post Container */
    .post-container {
      padding: 20px 16px;
    }

    /* Post Header */
    .post-category {
      display: inline-block;
      font-size: 12px;
      color: var(--blind-gray);
      margin-bottom: 12px;
      background: var(--blind-lightgray);
      padding: 4px 8px;
      border-radius: 4px;
      font-weight: 600;
    }
    .post-title {
      font-size: 20px;
      font-weight: 700;
      line-height: 1.4;
      margin: 0 0 20px;
      word-break: keep-all;
    }

    /* Author Box */
    .author-box {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
    }
    .author-thumb {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--blind-lightgray);
      object-fit: cover;
      border: 1px solid var(--blind-border);
    }
    .author-details {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .author-name-row {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .company-name {
      font-weight: 700;
      font-size: 15px;
    }
    .verified-badge {
      width: 14px;
      height: 14px;
      margin-top: 1px;
    }
    .author-name {
      color: var(--blind-gray);
      font-size: 13px;
    }
    .post-meta {
      font-size: 12px;
      color: var(--blind-gray);
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .post-meta span {
      display: flex;
      align-items: center;
      gap: 3px;
    }

    /* Post Content */
    .post-content {
      font-size: 16px;
      line-height: 1.6;
      color: #333;
      margin-bottom: 32px;
      word-break: keep-all;
    }
    .post-content p {
      margin: 0 0 20px;
    }
    .post-content strong {
      font-weight: 700;
    }

    /* Extracted Clickbait classes just for the text */
    .cb-highlight {
      color: var(--blind-blue);
    }
    .cb-red {
      color: #E53935;
    }
    .cb-large {
      font-size: 18px;
    }

    /* Read More / Fade styling */
    .read-more-wrapper {
      position: relative;
      text-align: center;
      margin-top: 10px;
    }
    .read-more-fade {
      position: absolute;
      bottom: 100%;
      left: 0;
      right: 0;
      height: 140px;
      background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.8) 60%, rgba(255,255,255,1) 100%);
      pointer-events: none;
    }
    .btn-more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: #FFFFFF;
      color: var(--blind-dark);
      border: 1px solid var(--blind-border);
      border-radius: 8px;
      padding: 14px 24px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      width: 100%;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
      transition: background 0.2s;
    }
    .btn-more:hover {
      background: #FAFAFA;
    }
    .btn-more svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
    }

    /* Actions */
    .post-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px 0;
      border-top: 1px solid var(--blind-border);
      border-bottom: 1px solid var(--blind-lightgray);
      margin-bottom: 16px;
    }
    .action-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--blind-gray);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
    }
    .action-item svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
    }
    .action-item.active {
      color: var(--blind-blue);
    }
    
    /* Comments mock */
    .comment-list {
      padding-bottom: 40px;
    }
    .comment-item {
      padding: 16px 0;
      border-bottom: 1px solid var(--blind-lightgray);
      display: flex;
      gap: 12px;
    }
    .c-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--blind-lightgray);
      object-fit: cover;
      flex-shrink: 0;
    }
    .c-body {
      flex: 1;
    }
    .c-author {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-bottom: 4px;
    }
    .c-author .company {
      font-size: 13px;
      font-weight: 700;
    }
    .c-text {
      font-size: 14px;
      line-height: 1.5;
    }
  </style>

  <div class="blind-app">
    <!-- Header -->
    <header class="header">
      <div class="header-left">
        <svg class="icon-btn" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <div class="header-title">주식/투자</div>
      </div>
      <div class="header-right">
        <svg class="icon-btn" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <svg class="icon-btn" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>
    </header>

    <div class="post-container">
      <div class="post-category">토픽 > 주식/투자</div>
      <h1 class="post-title">여의도 현직입니다. 이번 주 무조건 쓸어담아야 할 종목 딱 하나 풉니다.</h1>
      
      <div class="author-box">
        <Image src={headImg} alt={name} class="author-thumb" width={40} height={40} />
        <div class="author-details">
          <div class="author-name-row">
            <span class="company-name">{name}</span>
            <svg class="verified-badge" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" fill="#37ADCF" />
              <path d="M9 12.5l2 2 4-4.5" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="post-meta">
            <span>15분 전</span>
            <span>조회 43,291</span>
          </div>
        </div>
      </div>

      <div class="post-content">
        <p>최근 반도체 섹터 수급이 꼬이면서 시장 분위기가 많이 어수선하네요. 다들 계좌 관리하시느라 힘드실 텐데, 오늘은 저희 운용본부에서도 조용히 비중을 싣고 있는 종목 하나 공유해 드리려고 합니다.</p>
        
        <p>단순한 텍스트 기반 테마주가 아니라, 당장 내일 오전부터 글로벌 빅테크와의 <strong>'핵심 부품 독점 공급 공시'</strong>가 예정되어 있는 알짜 기업입니다.</p>

        <p>현재 차트상 완벽한 매집봉이 뜬 상태고, 이전 저항대 돌파를 완전히 눈앞에 두고 있습니다. 유통 물량도 많이 잠겨 있어서 기관 자금 조금만 들어와도 바로 점상한가로 직행할 자리죠. 이번 주 내로 최소 30~50%는 아주 안전하게 먹고 나올 수 있는 구간이라고 확신합니다.</p>
        
        <p>저도 리스크 관리가 최우선인 사람이라 단 한 번도 아무 종목이나 추천드린 적 없습니다. 해당 기업의 정확한 종목명과 1차 목표가, 그리고 진입 타이밍은...</p>

        <div class="read-more-wrapper">
          <div class="read-more-fade"></div>
          <a href="javascript:{mixinJump()}" class="btn-more">
            더 보기
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
        </div>
      </div>

      <div class="post-actions">
        <div class="action-item active">
          <svg viewBox="0 0 24 24"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
          추천 1,842
        </div>
        <div class="action-item">
          <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          댓글 356
        </div>
        <div class="action-item">
          <svg viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
          스크랩
        </div>
      </div>
      
