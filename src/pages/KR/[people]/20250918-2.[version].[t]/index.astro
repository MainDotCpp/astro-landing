---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'

import { Filters, generateKrConfig } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(undefined, undefined, { requireImages: ['img1'] })
}


const { t = '棒群' } = Astro.params
const { img_prefix, name } = Astro.props

// 配图
const mainImage = import(`../images/${img_prefix}img1.jpg`)
---

<KRBaseLayout title={`${name} 투자 혁신`} description="혁신적인 투자 방법으로 3억원 수익을 달성하는 현대적 접근법">
  <style>
    .hero-bg {
      background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-bg::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 20% 30%, rgba(251, 191, 36, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(59, 130, 246, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(239, 68, 68, 0.1) 0%, transparent 50%);
      pointer-events: none;
      animation: pulse 8s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }
    .geometric-shape {
      animation: float 6s ease-in-out infinite;
      filter: blur(1px);
    }
    .geometric-shape:nth-child(1) { animation-delay: 0s; }
    .geometric-shape:nth-child(2) { animation-delay: 1.5s; }
    .geometric-shape:nth-child(3) { animation-delay: 3s; }
    .geometric-shape:nth-child(4) { animation-delay: 4.5s; }
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(180deg); }
    }
    .title-gradient {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .problem-card {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2) 0%, rgba(220, 38, 38, 0.15) 100%);
      backdrop-filter: blur(20px);
      border: 2px solid rgba(239, 68, 68, 0.4);
      transition: all 0.3s ease;
    }
    .problem-card:hover {
      transform: translateX(8px);
      border-color: rgba(239, 68, 68, 0.6);
      box-shadow: 0 10px 40px rgba(239, 68, 68, 0.3);
    }
    .solution-card {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(37, 99, 235, 0.15) 100%);
      backdrop-filter: blur(20px);
      border: 3px solid rgba(59, 130, 246, 0.4);
      transition: all 0.3s ease;
    }
    .solution-card:hover {
      transform: scale(1.02);
      border-color: rgba(59, 130, 246, 0.6);
      box-shadow: 0 15px 50px rgba(59, 130, 246, 0.3);
    }
    .learning-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .learning-card:hover {
      transform: translateY(-8px) scale(1.03);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }
    .success-card {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
      box-shadow: 0 20px 60px rgba(251, 191, 36, 0.4);
      transition: all 0.3s ease;
    }
    .success-card:hover {
      transform: rotate(-2deg) scale(1.02);
      box-shadow: 0 30px 80px rgba(251, 191, 36, 0.5);
    }
    .cta-button-modern {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .cta-button-modern::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.6s ease;
    }
    .cta-button-modern:hover::before {
      left: 100%;
    }
    .cta-button-modern:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }
    .trust-badge {
      backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }
    .trust-badge:hover {
      background: rgba(255, 255, 255, 0.25);
      transform: translateY(-4px);
    }
    @media (max-width: 768px) {
      .hero-bg::before {
        background-image:
          radial-gradient(circle at 50% 50%, rgba(251, 191, 36, 0.1) 0%, transparent 60%);
      }
      .geometric-shape {
        display: none;
      }
    }
  </style>
  <div class="min-h-screen hero-bg text-white overflow-hidden">
    <!-- Hero Section - Asymmetric Layout -->
    <section class="min-h-screen relative flex items-center justify-center px-4 py-20">
      <!-- Background Geometric Shapes -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="geometric-shape absolute top-20 left-10 w-32 h-32 bg-yellow-400 transform rotate-45 opacity-20"></div>
        <div class="geometric-shape absolute top-40 right-20 w-24 h-24 bg-blue-500 rounded-full opacity-30"></div>
        <div class="geometric-shape absolute bottom-32 left-1/4 w-16 h-16 bg-red-500 transform rotate-12 opacity-25"></div>
        <div class="geometric-shape absolute bottom-20 right-1/3 w-20 h-20 bg-green-500 transform -rotate-45 opacity-20"></div>
      </div>

      <div class="relative z-10 max-w-sm mx-auto text-center">
        <!-- Asymmetric Title Layout -->
        <div class="mb-10 relative z-10">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-6">
            <span class="block text-white mb-2">진짜로</span>
            <span class="block title-gradient mb-2">주식 투자를</span>
            <span class="block text-white">배우고 싶으신가요?</span>
          </h1>
          <p class="text-lg md:text-xl lg:text-2xl text-gray-300 leading-relaxed max-w-lg mx-auto">
            뉴스와 소문만으로는 결코<br >
            시장을 따라잡을 수 없습니다
          </p>
        </div>

        <!-- Geometric CTA Button -->
        <div class="relative z-10">
          <CtaButton
            social={t}
            size="lg"
            class="cta-button-modern w-full max-w-md mx-auto text-base md:text-lg bg-gradient-to-r from-yellow-400 to-orange-500 text-black font-black py-5 md:py-6 px-8 md:px-10 rounded-2xl shadow-2xl"
          />
        </div>
      </div>
    </section>

    <!-- Problem Section - Triangular Design -->
    <section class="py-16 md:py-20 px-4 relative">
      <div class="max-w-2xl mx-auto">
        <!-- Triangular Background -->
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 to-transparent transform -skew-y-2"></div>

        <div class="relative z-10">
          <div class="problem-card p-8 md:p-10 rounded-2xl">
            <h2 class="text-3xl md:text-4xl font-black text-red-400 mb-6">⚠️ 문제</h2>
            <p class="text-xl md:text-2xl text-white leading-relaxed">
              더 이상 무작정 따라가지 마십시오.<br >
              진짜 투자는 미리 준비하는 것입니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Solution Section - Circular Design -->
    <section class="py-16 md:py-20 px-4 relative">
      <div class="max-w-2xl mx-auto">
        <!-- Circular Background -->
        <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-full transform scale-110"></div>

        <div class="relative z-10 text-center">
          <div class="solution-card p-8 md:p-10 rounded-3xl">
            <h2 class="text-3xl md:text-4xl font-black text-blue-400 mb-6">💡 해결책</h2>
            <p class="text-lg md:text-xl text-white leading-relaxed mb-8">
              우리는 지금 학습 자료를 제공하고 있습니다.<br >
              여기에는 체계적인 투자 방법뿐 아니라,<br >
              최근 가장 주목해야 할 폭등주와 성장주도 담겨 있습니다.
            </p>

            <!-- Main Image with Geometric Frame -->
            <div class="relative">
              <div class="absolute -inset-4 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-2xl transform rotate-3 opacity-80"></div>
              <div class="relative bg-black p-2 rounded-2xl shadow-2xl">
                <Image src={mainImage} alt="투자 학습 자료" class="w-full rounded-xl" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Content Section - Asymmetric Grid -->
    <section class="py-16 md:py-20 px-4 relative">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-black text-center mb-12 text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
          핵심 학습 내용
        </h2>

        <div class="space-y-6 md:space-y-8">
          <!-- Learning Point 1 - Asymmetric -->
          <div class="learning-card flex items-center bg-gradient-to-r from-green-500/20 to-teal-500/20 p-6 md:p-8 rounded-2xl backdrop-blur-sm border border-green-500/30">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-green-500 rounded-full flex items-center justify-center mr-6 transform -rotate-12 shadow-lg flex-shrink-0">
              <span class="text-2xl md:text-3xl">📊</span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl md:text-2xl font-bold text-white mb-2">시장 신호를 읽는 방법 학습</h3>
              <p class="text-gray-300 text-sm md:text-base">데이터 기반의 정확한 시장 분석</p>
            </div>
          </div>

          <!-- Learning Point 2 - Asymmetric -->
          <div class="learning-card flex items-center bg-gradient-to-r from-purple-500/20 to-pink-500/20 p-6 md:p-8 rounded-2xl backdrop-blur-sm border border-purple-500/30 ml-0 md:ml-8">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-purple-500 rounded-full flex items-center justify-center mr-6 transform rotate-12 shadow-lg flex-shrink-0">
              <span class="text-2xl md:text-3xl">🏭</span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl md:text-2xl font-bold text-white mb-2">핵심 산업의 성장 논리 이해</h3>
              <p class="text-gray-300 text-sm md:text-base">산업별 성장 동력과 투자 기회 파악</p>
            </div>
          </div>

          <!-- Learning Point 3 - Asymmetric -->
          <div class="learning-card flex items-center bg-gradient-to-r from-orange-500/20 to-red-500/20 p-6 md:p-8 rounded-2xl backdrop-blur-sm border border-orange-500/30">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-orange-500 rounded-full flex items-center justify-center mr-6 transform -rotate-6 shadow-lg flex-shrink-0">
              <span class="text-2xl md:text-3xl">💎</span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl md:text-2xl font-bold text-white mb-2">잠재력 있는 종목 직접 수령</h3>
              <p class="text-gray-300 text-sm md:text-base">검증된 우수 종목 정보 제공</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Story Section - Large Numbers -->
    <section class="py-16 md:py-20 px-4 relative">
      <div class="max-w-2xl mx-auto">
        <!-- Geometric Background -->
        <div class="absolute inset-0 bg-gradient-to-br from-yellow-500/20 to-orange-500/20 transform skew-y-1"></div>

        <div class="relative z-10 text-center">
          <div class="success-card p-8 md:p-10 rounded-3xl">
            <h2 class="text-3xl md:text-4xl font-black text-black mb-8">💰 실제 성공 사례</h2>
            <div class="space-y-4 md:space-y-6">
              <p class="text-lg md:text-xl font-semibold text-black">
                👉 올바른 방법을 익힌 한 투자자는
              </p>
              <div class="text-5xl md:text-6xl lg:text-7xl font-black text-black">단 2주 만에</div>
              <div class="text-7xl md:text-8xl lg:text-9xl font-black text-black">3억 원</div>
              <div class="text-xl md:text-2xl font-semibold text-black">의 수익을 올렸습니다!</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section - Multiple Creative Buttons -->
    <section class="py-16 md:py-20 px-4 relative">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-black text-center mb-8 text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-500">
          지금 바로 시작하세요!
        </h2>

        <p class="text-lg md:text-xl lg:text-2xl text-gray-300 text-center mb-12 leading-relaxed">
          기회는 기다려주지 않습니다.<br >
          투자는 준비한 사람의 것입니다.<br >
          투자 성장과 자산 도약을 시작하십시오!
        </p>

        <!-- Creative Button Layout -->
        <div class="space-y-6">
          <!-- Button 1 - Square -->
          <CtaButton
            social={t}
            size="lg"
            class="cta-button-modern w-full text-base md:text-lg bg-gradient-to-r from-blue-500 to-purple-500 text-white font-black py-5 md:py-6 px-8 md:px-10 rounded-2xl shadow-2xl"
          />
        </div>

        <!-- Trust Indicators with Geometric Design -->
        <div class="flex flex-wrap justify-center gap-4 mt-10">
          <div class="trust-badge rounded-full px-5 md:px-6 py-3 text-white text-sm md:text-base font-bold transform hover:-rotate-12 transition-transform">
            🔒 100% 무료
          </div>
          <div class="trust-badge rounded-full px-5 md:px-6 py-3 text-white text-sm md:text-base font-bold transform hover:rotate-12 transition-transform">
            ⚡ 즉시 제공
          </div>
          <div class="trust-badge rounded-full px-5 md:px-6 py-3 text-white text-sm md:text-base font-bold transform hover:-rotate-6 transition-transform">
            ✅ 검증됨
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <div class="text-center text-gray-400 text-xs pb-8">
      <p>투자에는 위험이 따릅니다. 신중한 투자 결정을 하시기 바랍니다.</p>
    </div>
  </div>
</KRBaseLayout>
