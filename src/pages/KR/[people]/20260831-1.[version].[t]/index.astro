---
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'
import avatarImg from './assets/avatar.jpg'
import heroImg from './assets/hero.jpg'
import teachingImg from './assets/teaching.jpg'

export function getStaticPaths() {
  return generateKrConfig(['约翰李_0'])
}

const { t = '卡扣' } = Astro.params
const { name } = Astro.props as { name: string, img_prefix: string }

const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelName = isBand ? '밴드' : '카카오톡'
const ctaLabel = isBand
  ? '무료 커뮤니티 참여하기'
  : needNumber
    ? '카카오톡 추가하고 종목 받기'
    : '무료 커뮤니티 참여하기'
---

<KRBaseLayout
  title={`${name} | 매일 급등 종목 무료 공유 커뮤니티`}
  description="존리 전 메리츠자산운용 대표의 가치투자 분석 커뮤니티. 장기 투자 전략과 급등 종목 정보를 매일 무료로 공유합니다."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800;900&display=swap"
  />

  <main class="page">
    <section class="hero" style={`background-image: linear-gradient(180deg, rgba(8,22,32,0) 0%, rgba(8,22,32,0.15) 30%, rgba(8,22,32,0.75) 58%, rgba(8,22,32,0.94) 100%), url(${heroImg.src})`}>
      <div class="hero-content">
        <div class="eyebrow">매일 급등 종목 무료 공유</div>
        <h1>주식 고수의 매매 전략<br>무료로 받아보세요</h1>
        <p>28년 글로벌 시장 경험을 가진 투자 전문가가 엄선한 급등 종목 정보와 매매 전략을 매일 무료로 공유합니다. 지금 참여하세요.</p>
        <div class="hero-metrics">
          <div class="metric">
            <strong>28년</strong>
            <span>글로벌 투자 경력</span>
          </div>
          <div class="metric">
            <strong>메리츠</strong>
            <span>자산운용 前 대표</span>
          </div>
          <div class="metric">
            <strong>매일</strong>
            <span>급등 종목 무료 공유</span>
          </div>
        </div>
        <div class="btn-wrap">
          <CtaButton social={t} />
        </div>
        <div class="note">무료 참여 · 투자 참고용 정보 제공</div>
      </div>
    </section>

    <section class="section">
      <div class="section-title"><span class="mark">1</span>커뮤니티에서 무엇을 받을 수 있나요?</div>
      <p class="lead-text">투자 전문가가 직접 분석한 급등 유망 종목과 매매 전략을 매일 공유합니다. 혼자 고민하지 마시고, 검증된 전문가의 분석을 무료로 받아보세요.</p>
      <div class="feature-list">
        <article class="feature-item">
          <span class="feature-icon">✓</span>
          <div>
            <h3>매일 급등 종목 분석</h3>
            <p>전문 분석팀이 엄선한 급등 유망 종목을 매일 아침 공유합니다. 매주 300% 이상 수익이 기대되는 우량 종목 정보를 놓치지 마세요.</p>
          </div>
        </article>
        <article class="feature-item">
          <span class="feature-icon">!</span>
          <div>
            <h3>실시간 시장 분석</h3>
            <p>시장 흐름을 빠르게 파악하고, 매수·매도 타이밍을 놓치지 않도록 실시간으로 분석 내용을 전달합니다.</p>
          </div>
        </article>
        <article class="feature-item">
          <span class="feature-icon">V</span>
          <div>
            <h3>가치투자 전략 공유</h3>
            <p>단기 시세 차익이 아닌, 기업 가치에 기반한 장기 투자 전략을 함께 공유하고 토론합니다.</p>
          </div>
        </article>
        <article class="feature-item">
          <span class="feature-icon">R</span>
          <div>
            <h3>리스크 관리 노하우</h3>
            <p>손절 기준, 포트폴리오 배분, 시장 하락기 대응 전략까지. 수익보다 중요한 건 잃지 않는 것입니다.</p>
          </div>
        </article>
      </div>
      <div class="image-panel">
        <img src={teachingImg.src} alt="투자 커뮤니티 활동">
      </div>
    </section>

    <section class="section alt">
      <div class="section-title"><span class="mark">2</span>투자, 혼자 하면 불안하지 않으세요?</div>
      <div class="pain-grid">
        <div class="pain-item"><span>불</span>매일 차트만 보다가 불안해지는 일상</div>
        <div class="pain-item"><span>혼</span>정보가 넘쳐나는데 뭘 믿어야 할지 모르겠다</div>
        <div class="pain-item"><span>급</span>좋은 종목을 찾아도 타이밍을 놓친다</div>
      </div>
      <div class="quote">전문가가 분석한 종목 정보를 매일 받아보면, 시장을 더 명확하게 볼 수 있습니다. 혼자 고민하지 마시고, 검증된 분석과 함께 투자하세요.</div>
      <div class="btn-wrap" style="margin-top:18px;">
        <CtaButton social={t} />
      </div>
    </section>

    <section class="section author">
      <div class="section-title"><span class="mark">3</span>투자 전문가 소개</div>
      <div class="author-head">
        <div class="author-avatar" style={`background-image: url(${avatarImg.src})`}></div>
        <div>
          <div class="author-name">존리 (John Lee)</div>
          <div class="author-meta">前 메리츠자산운용 대표 / 가치투자 교육자 / 베스트셀러 작가</div>
        </div>
      </div>
      <p class="lead-text">존리는 한국을 대표하는 가치투자 전문가입니다. 미국 CPA 자격을 취득한 뒤 Scudder, Lazard 등 글로벌 운용사에서 펀드매니저로 28년간 활동했으며, 귀국 후 메리츠자산운용 대표를 역임했습니다.</p>
      <p class="lead-text" style="margin-top: 10px;">「존리의 부자학교」를 설립해 금융문맹 탈출을 위한 교육 활동을 이어가고 있으며, 《존리의 금융문맹 탈출》《왜 주식인가》《존리의 부자되기 습관》 등 다수의 베스트셀러를 집필했습니다.</p>
      <div class="tags">
        <span class="tag">가치투자</span>
        <span class="tag">장기 투자</span>
        <span class="tag">글로벌 시장 분석</span>
        <span class="tag">금융 교육</span>
        <span class="tag">포트폴리오 전략</span>
      </div>
      <div class="inline-counter">현재 <strong id="totalCount">8,200</strong>명 이상 참여 중</div>
    </section>

    <section class="comment-section">
      <h2>커뮤니티 회원 후기</h2>
      <div id="commentList">
        <div class="comment">
          <div class="avatar">김</div>
          <div class="comment-body">
            <div class="comment-name">김** 님</div>
            매일 아침 종목 분석 받아보는데, 진짜 도움이 많이 됩니다. 혼자 투자할 때보다 훨씬 마음이 편해요.
            <div class="comment-meta"><span>어제</span><span>좋아요 38</span></div>
          </div>
        </div>
        <div class="comment">
          <div class="avatar" style="background:#0f766e;">이</div>
          <div class="comment-body">
            <div class="comment-name">이** 님</div>
            가치투자 전략이 구체적이라 실전에 바로 적용할 수 있어요. 무료인 게 신기할 정도입니다.
            <div class="comment-meta"><span>4시간 전</span><span>좋아요 26</span></div>
          </div>
        </div>
      </div>
      <div class="comment-input">
        <input id="commentInput" type="text" placeholder="질문이나 의견을 남겨주세요..." autocomplete="off">
        <button id="sendCommentBtn">전송</button>
      </div>
      <div class="note">매일 많은 투자자들이 종목 분석과 투자 전략을 공유하고 있습니다</div>
    </section>
  </main>

  <div class="fixed-btn link-btn" onclick="onLinkBtnClick()">{ctaLabel}</div>

  <aside class="floating-tools" aria-label="참여 현황">
    <div class="counter-card" id="counterCard">
      <div class="counter-number" id="liveNumber">8,247</div>
      <div class="counter-label">커뮤니티 참여 인원</div>
    </div>
    <div class="timer-card">
      <div class="timer-label">한정 무료 공개</div>
      <div class="timer-value" id="countdownTimer">09:59</div>
    </div>
  </aside>

  <div class="popup-container" id="popup"></div>

  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-box">
      <button class="modal-close" id="modalClose" type="button" aria-label="닫기">&times;</button>
      <div class="modal-badge">무료 투자 커뮤니티 개방 중</div>
      <h2 id="modalTitle">급등 종목 분석을 매일 무료로 받아보세요</h2>
      <p>투자 전문가가 엄선한 종목 정보와 매매 전략을 매일 공유합니다. 지금 참여하세요.</p>
      <div class="btn-wrap" style="margin-top:18px;">
        <CtaButton social={t} />
      </div>
      <div class="note">투자 학습 및 정보 공유 목적이며, 수익을 보장하지 않습니다.</div>
    </div>
  </div>
</KRBaseLayout>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    padding-bottom: 92px;
    background: #eef1f4;
    color: #1f2933;
    font-family: 'Noto Sans KR', system-ui, -apple-system, sans-serif;
  }

  .page {
    width: 100%;
    max-width: 540px;
    min-height: 100vh;
    margin: 0 auto;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 0 26px rgba(21, 32, 43, 0.08);
  }

  .hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    padding: 28px 22px 32px;
    color: #ffffff;
    background-size: cover;
    background-position: 72% 20%;
    background-repeat: no-repeat;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    padding: 7px 12px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 12px;
    font-weight: 700;
    backdrop-filter: blur(4px);
  }

  .hero h1 {
    margin-bottom: 12px;
    font-size: 28px;
    font-weight: 900;
    line-height: 1.3;
    word-break: keep-all;
  }

  .hero p {
    margin-bottom: 18px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 15px;
    line-height: 1.72;
    word-break: keep-all;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 16px 0 18px;
  }

  .metric {
    min-height: 62px;
    padding: 9px 6px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background: rgba(9, 19, 29, 0.5);
    text-align: center;
  }

  .metric strong {
    display: block;
    margin-bottom: 2px;
    color: #f7c948;
    font-size: 18px;
    line-height: 1.2;
  }

  .metric span {
    display: block;
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
    line-height: 1.35;
  }

  .btn-wrap {
    width: 100%;
  }

  .note {
    margin-top: 10px;
    color: #778491;
    text-align: center;
    font-size: 12px;
    line-height: 1.55;
  }

  .hero .note {
    color: rgba(255, 255, 255, 0.7);
  }

  .section {
    padding: 28px 20px;
    border-bottom: 1px solid #e7edf3;
    background: #ffffff;
  }

  .section.alt {
    background: #f7f9fb;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 13px;
    color: #132f4c;
    font-size: 20px;
    font-weight: 900;
    line-height: 1.35;
    word-break: keep-all;
  }

  .section-title .mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    background: #132f4c;
    color: #ffffff;
    font-size: 14px;
  }

  .lead-text {
    color: #4b5c6b;
    font-size: 14px;
    line-height: 1.78;
    word-break: keep-all;
  }

  .feature-list {
    display: grid;
    gap: 12px;
    margin-top: 16px;
  }

  .feature-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px;
    border: 1px solid #dfe8f1;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(31, 45, 61, 0.04);
  }

  .feature-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
    background: linear-gradient(135deg, #0f766e, #1d4ed8);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
  }

  .feature-item h3 {
    margin-bottom: 4px;
    color: #17212b;
    font-size: 15px;
    line-height: 1.45;
    word-break: keep-all;
  }

  .feature-item p {
    color: #5d6b78;
    font-size: 13px;
    line-height: 1.62;
    word-break: keep-all;
  }

  .image-panel {
    margin: 18px 0 10px;
    overflow: hidden;
    border-radius: 8px;
    background: #e7edf3;
    box-shadow: 0 12px 24px rgba(31, 45, 61, 0.09);
  }

  .image-panel img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 16px;
  }

  .pain-item {
    min-height: 112px;
    padding: 13px 8px;
    border-radius: 8px;
    background: #eef4f8;
    color: #263846;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.55;
    word-break: keep-all;
  }

  .pain-item span {
    display: block;
    margin-bottom: 8px;
    color: #b42318;
    font-size: 20px;
  }

  .quote {
    margin-top: 18px;
    padding: 15px;
    border-left: 4px solid #c78a2f;
    border-radius: 8px;
    background: #fff7e8;
    color: #7a4b08;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.72;
    word-break: keep-all;
  }

  .author {
    background: linear-gradient(180deg, #f7f9fb 0%, #ffffff 100%);
  }

  .author-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }

  .author-avatar {
    width: 76px;
    height: 76px;
    border: 2px solid #c78a2f;
    border-radius: 50%;
    flex: 0 0 76px;
    background-color: #f2f4f7;
    background-size: cover;
    background-position: center center;
    box-shadow: 0 8px 18px rgba(199, 138, 47, 0.18);
  }

  .author-name {
    color: #111827;
    font-size: 20px;
    font-weight: 900;
    line-height: 1.38;
  }

  .author-meta {
    margin-top: 4px;
    color: #52616f;
    font-size: 13px;
    line-height: 1.55;
    word-break: keep-all;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .tag {
    padding: 7px 10px;
    border: 1px solid rgba(19, 47, 76, 0.14);
    border-radius: 999px;
    background: #ffffff;
    color: #132f4c;
    font-size: 12px;
    font-weight: 700;
  }

  .inline-counter {
    display: inline-block;
    margin-top: 16px;
    padding: 9px 12px;
    border-radius: 999px;
    background: #eaf3ef;
    color: #087443;
    font-size: 13px;
    font-weight: 800;
  }

  .comment-section {
    padding: 24px 20px 30px;
    background: #ffffff;
    border-top: 8px solid #eef1f4;
  }

  .comment-section h2 {
    margin-bottom: 14px;
    color: #132f4c;
    font-size: 19px;
    line-height: 1.35;
  }

  :global(.comment) {
    display: flex;
    gap: 11px;
    margin-bottom: 16px;
  }

  :global(.avatar) {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 42px;
    background: #132f4c;
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
  }

  :global(.comment-body) {
    flex: 1;
    padding: 12px 13px;
    border-radius: 8px;
    background: #f1f5f8;
    color: #344250;
    font-size: 14px;
    line-height: 1.55;
    word-break: keep-all;
  }

  :global(.comment-name) {
    margin-bottom: 4px;
    color: #182635;
    font-weight: 800;
  }

  :global(.comment-meta) {
    display: flex;
    gap: 12px;
    margin-top: 7px;
    color: #8492a0;
    font-size: 11px;
  }

  .comment-input {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    padding: 6px;
    border: 1px solid #dce5ed;
    border-radius: 999px;
    background: #ffffff;
  }

  .comment-input input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    padding: 11px 8px 11px 12px;
    background: transparent;
    color: #1f2933;
    font-size: 14px;
  }

  .comment-input button {
    border: 0;
    border-radius: 999px;
    padding: 0 18px;
    background: #132f4c;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
  }

  .fixed-btn {
    position: fixed;
    z-index: 1000;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    padding: 13px 18px calc(13px + env(safe-area-inset-bottom));
    background: #06c755;
    color: #ffffff;
    text-align: center;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.25;
    box-shadow: 0 -8px 22px rgba(21, 32, 43, 0.16);
    cursor: pointer;
  }

  .floating-tools {
    position: fixed;
    z-index: 1002;
    right: 12px;
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .counter-card,
  .timer-card {
    min-width: 112px;
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(10, 22, 34, 0.93);
    color: #ffffff;
    text-align: center;
    box-shadow: 0 10px 24px rgba(21, 32, 43, 0.24);
    pointer-events: auto;
  }

  .counter-card {
    border: 1px solid rgba(247, 201, 72, 0.48);
  }

  .counter-number {
    color: #f7c948;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
  }

  .counter-label,
  .timer-label {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 10px;
    font-weight: 700;
  }

  .timer-value {
    margin-top: 4px;
    display: inline-block;
    padding: 4px 8px;
    border-radius: 999px;
    background: #243447;
    color: #ffffff;
    font-family: Consolas, "Courier New", monospace;
    font-size: 16px;
    font-weight: 900;
  }

  .flash {
    animation: flash 0.42s ease-out;
  }

  @keyframes flash {
    0% { transform: scale(1); }
    50% { transform: scale(1.08); color: #fff4c2; }
    100% { transform: scale(1); }
  }

  .popup-container {
    position: fixed;
    z-index: 1001;
    bottom: 96px;
    left: 50%;
    width: min(90vw, 360px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  :global(.popup-item) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border-left: 4px solid #c78a2f;
    border-radius: 999px;
    background: #ffffff;
    color: #263846;
    box-shadow: 0 8px 22px rgba(21, 32, 43, 0.16);
    font-size: 13px;
    line-height: 1.45;
    animation: fadeUp 0.24s ease;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .modal {
    position: fixed;
    z-index: 2000;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(7, 13, 20, 0.72);
    backdrop-filter: blur(3px);
  }

  .modal-box {
    position: relative;
    width: min(100%, 340px);
    padding: 28px 20px 30px;
    border-radius: 8px;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.26);
    animation: scaleIn 0.22s ease;
  }

  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: #eef1f4;
    color: #536271;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .modal-badge {
    display: inline-flex;
    margin-bottom: 14px;
    padding: 7px 11px;
    border-radius: 999px;
    background: #fff7e8;
    color: #8a5a12;
    font-size: 12px;
    font-weight: 900;
  }

  .modal-box h2 {
    color: #111827;
    font-size: 22px;
    line-height: 1.42;
    word-break: keep-all;
  }

  .modal-box p {
    margin-top: 10px;
    color: #52616f;
    font-size: 14px;
    line-height: 1.72;
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .hero { min-height: 500px; }
    .hero h1 { font-size: 25px; }
    .floating-tools {
      top: auto;
      right: 8px;
      bottom: 92px;
      flex-direction: row;
      transform: none;
    }
    .counter-card,
    .timer-card { min-width: 94px; padding: 8px 9px; }
    .counter-number { font-size: 21px; }
    .timer-value { font-size: 14px; }
  }

  @media (max-width: 390px) {
    .hero-metrics,
    .pain-grid { gap: 7px; }
    .metric strong { font-size: 16px; }
    .pain-item { padding: 11px 6px; font-size: 11px; }
    .fixed-btn { font-size: 16px; }
  }
</style>

<script is:inline>
(function () {
  "use strict";

  var currentCount = 8247;
  var liveNumber = document.getElementById("liveNumber");
  var counterCard = document.getElementById("counterCard");

  function updateCounter() {
    currentCount += Math.floor(Math.random() * 4) + 1;
    if (liveNumber) {
      liveNumber.textContent = currentCount.toLocaleString();
      liveNumber.classList.add("flash");
      window.setTimeout(function () { liveNumber.classList.remove("flash"); }, 420);
    }
    if (counterCard) {
      counterCard.style.borderColor = "rgba(6, 199, 85, 0.65)";
      window.setTimeout(function () { counterCard.style.borderColor = "rgba(247, 201, 72, 0.48)"; }, 260);
    }
  }

  function initCountdown() {
    var timer = document.getElementById("countdownTimer");
    if (!timer) return;
    var remain = 9 * 60 + 59;
    function render() {
      var minutes = String(Math.floor(remain / 60)).padStart(2, "0");
      var seconds = String(remain % 60).padStart(2, "0");
      timer.textContent = minutes + ":" + seconds;
      if (remain > 0) remain -= 1;
    }
    render();
    window.setInterval(render, 1000);
  }

  var popupUsers = [
    { name: "김**", msg: "급등 종목 정보 받았습니다", initial: "김", color: "#132f4c" },
    { name: "이**", msg: "매매 전략이 정확하네요", initial: "이", color: "#0f766e" },
    { name: "박**", msg: "커뮤니티 참여했습니다", initial: "박", color: "#8a5a12" },
    { name: "최**", msg: "종목 분석 퀄리티가 다릅니다", initial: "최", color: "#9f1239" }
  ];

  function escapeHtml(text) {
    return String(text).replace(/[&<>"]/g, function (c) {
      if (c === "&") return "&amp;";
      if (c === "<") return "&lt;";
      if (c === ">") return "&gt;";
      return "&quot;";
    });
  }

  function showPopup() {
    var container = document.getElementById("popup");
    if (!container) return;
    var item = popupUsers[Math.floor(Math.random() * popupUsers.length)];
    var bubble = document.createElement("div");
    bubble.className = "popup-item";
    bubble.innerHTML =
      '<div style="width:32px;height:32px;flex:0 0 32px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:' + item.color + ';color:#fff;font-size:13px;font-weight:900;">' + escapeHtml(item.initial) + '</div>' +
      '<div><strong>' + escapeHtml(item.name) + '</strong> ' + escapeHtml(item.msg) + '</div>';
    container.appendChild(bubble);
    window.setTimeout(function () { bubble.remove(); }, 7600);
  }

  var autoNames = ["투자초보", "주식러버", "직장인투자자", "가치투자생", "장기보유파", "수익왕"];
  var autoMsgs = [
    "매일 종목 분석 받아보는데 진짜 유용합니다",
    "전문가 분석이라 확실히 다르네요",
    "혼자 투자할 때보다 훨씬 안정적이에요",
    "리스크 관리 노하우가 특히 도움됩니다",
    "무료로 이 퀄리티면 안 할 이유가 없죠"
  ];

  function addAutoComment() {
    var list = document.getElementById("commentList");
    if (!list) return;
    var name = autoNames[Math.floor(Math.random() * autoNames.length)];
    var msg = autoMsgs[Math.floor(Math.random() * autoMsgs.length)];
    var comment = document.createElement("div");
    comment.className = "comment";
    comment.innerHTML =
      '<div class="avatar" style="background:#344250;">' + escapeHtml(name.charAt(0)) + '</div>' +
      '<div class="comment-body"><div class="comment-name">' + escapeHtml(name) + '</div>' +
      escapeHtml(msg) +
      '<div class="comment-meta"><span>방금</span><span>좋아요 ' + (Math.floor(Math.random() * 36) + 12) + '</span></div></div>';
    list.appendChild(comment);
    if (list.children.length > 24) list.removeChild(list.children[0]);
  }

  var modal = null;
  var modalTimer = null;
  var scrollTriggered = false;

  function showModal() { if (modal) modal.style.display = "flex"; }

  function hideModal() {
    if (!modal) return;
    modal.style.display = "none";
    if (modalTimer) clearTimeout(modalTimer);
    modalTimer = window.setTimeout(showModal, 13000);
  }

  function submitComment() {
    var input = document.getElementById("commentInput");
    var list = document.getElementById("commentList");
    var text = input ? input.value.trim() : "";
    if (!text || !list) return;
    var comment = document.createElement("div");
    comment.className = "comment";
    comment.innerHTML =
      '<div class="avatar" style="background:#1d4ed8;">나</div>' +
      '<div class="comment-body"><div class="comment-name">나</div>' +
      escapeHtml(text) +
      '<div class="comment-meta"><span>방금</span><span>좋아요 1</span></div></div>';
    list.appendChild(comment);
    input.value = "";
    window.setTimeout(function () {
      var reply = document.createElement("div");
      reply.className = "comment";
      reply.innerHTML =
        '<div class="avatar" style="background:#c78a2f;">운</div>' +
        '<div class="comment-body"><div class="comment-name">운영팀 <span style="padding:2px 6px;border-radius:999px;background:#fff7e8;color:#8a5a12;font-size:10px;">공식 답변</span></div>' +
        '감사합니다. 커뮤니티에 참여하시면 매일 급등 종목 분석과 매매 전략을 무료로 받아보실 수 있습니다.' +
        '<div class="comment-meta"><span>방금</span></div></div>';
      list.appendChild(reply);
    }, 900);
    showModal();
  }

  function init() {
    initCountdown();

    var sendButton = document.getElementById("sendCommentBtn");
    var commentInput = document.getElementById("commentInput");
    if (sendButton) sendButton.addEventListener("click", submitComment);
    if (commentInput) commentInput.addEventListener("keydown", function (e) { if (e.key === "Enter") submitComment(); });

    modal = document.getElementById("modal");
    var close = document.getElementById("modalClose");
    if (close) close.addEventListener("click", hideModal);
    if (modal) modal.addEventListener("click", function (e) { if (e.target === modal) hideModal(); });

    window.addEventListener("scroll", function () {
      if (scrollTriggered) return;
      var denom = document.body.scrollHeight - window.innerHeight;
      var pct = denom > 0 ? window.scrollY / denom : 0;
      if (pct > 0.58) { scrollTriggered = true; showModal(); }
    }, { passive: true });

    updateCounter();
    window.setInterval(updateCounter, 5200);
    window.setTimeout(showPopup, 1000);
    window.setInterval(showPopup, 5200);
    window.setTimeout(function () { addAutoComment(); addAutoComment(); }, 3600);
    window.setInterval(addAutoComment, 11000);
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
})();
</script>
