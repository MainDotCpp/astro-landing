---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'
import briefSheet from './assets/brief.jpg'
import heroImg from './assets/hero.jpg'

export function getStaticPaths() {
  return generateKrConfig(['廉承煥_0'])
}

const { t = '卡扣' } = Astro.params
const { name, img_prefix } = Astro.props as { name: string, img_prefix: string }

const headImg = (await import(`../images/${img_prefix}head.jpg`)).default

const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelName = isBand ? '밴드' : '카카오톡'
const ctaNote = needNumber
  ? '무료 · 1분이면 끝납니다'
  : isBand
    ? '무료 · 밴드 가입, 1분이면 끝납니다'
    : '무료 · 오픈채팅방 바로 입장'
const roomWord = isBand ? '밴드' : '방'

const step2 = isBand
  ? '밴드 가입하기'
  : needNumber
    ? '카카오톡 채널 추가하기'
    : '오픈채팅방 입장하기'
const step3 = isBand
  ? '눈팅만 해도 됩니다'
  : needNumber
    ? '채팅창에 \'7\' 한 글자만 보내기'
    : '인사도 자기소개도 필요 없습니다'
---

<KRBaseLayout
  title={`RIA 계좌 12월 31일 마감 | ${name} 무료 투자 커뮤니티`}
  description="해외주식 양도세를 덜어주는 RIA 계좌는 2026년 한 해만 열립니다. 12월 31일이면 닫힙니다. 자격과 한도를 정리했습니다."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700;900&family=Noto+Sans+KR:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap"
  />

  <style is:global slot="head" define:vars={{ heroBg: `url(${heroImg.src})` }}>
    :root {
      --paper: #fbfaf7;
      --card: #ffffff;
      --ink: #16181c;
      --mut: #55595f;
      --dim: #8b8f95;
      --rule: #e2e0da;
      --rule-2: #efeee9;
      --up: #c0392f;
      --serif: 'Noto Serif KR', Georgia, serif;
      --sans: 'Pretendard', 'Noto Sans KR', -apple-system, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
      --maxw: 520px;
      --gap: 20px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--ink);
      font-size: 16px;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      word-break: keep-all;
      padding-bottom: calc(92px + env(safe-area-inset-bottom));
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; -webkit-tap-highlight-color: transparent; }
    ::selection { background: var(--up); color: #fff; }
    :focus-visible { outline: 2px solid var(--up); outline-offset: 3px; }

    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gap); }

    /* ================= HERO ================= */
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100svh;
      padding-top: calc(env(safe-area-inset-top) + 40px);
      padding-bottom: calc(108px + env(safe-area-inset-bottom));
      background-image:
        linear-gradient(
          180deg,
          rgba(10, 14, 20, 0.52) 0%,
          rgba(10, 14, 20, 0.3) 26%,
          rgba(10, 14, 20, 0.68) 62%,
          rgba(10, 14, 20, 0.95) 100%
        ),
        var(--heroBg);
      background-size: cover, cover;
      background-position: center, 50% 55%;
      background-repeat: no-repeat;
      color: #f5f3ef;
    }

    .stamp {
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      color: rgba(245, 243, 239, 0.68);
    }

    .hero h1 {
      margin-top: 16px;
      font-family: var(--serif);
      font-weight: 700;
      font-size: clamp(1.88rem, 8.2vw, 2.55rem);
      line-height: 1.3;
      letter-spacing: -0.035em;
    }

    .hero .lede {
      margin-top: 16px;
      font-size: 15.5px;
      line-height: 1.72;
      color: rgba(245, 243, 239, 0.84);
    }
    .hero .lede b { color: #fff; font-weight: 700; }

    .hero .cta-slot { margin-top: 26px; }
    .cta-slot :global(a),
    .cta-slot :global(button) { width: 100%; }
    .cta-note {
      margin-top: 10px;
      font-size: 12.5px;
      text-align: center;
      color: rgba(245, 243, 239, 0.6);
    }

    .figs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid rgba(245, 243, 239, 0.2);
    }
    .figs .v {
      font-family: var(--mono);
      font-weight: 600;
      font-size: clamp(15px, 4.7vw, 19px);
      letter-spacing: -0.04em;
      line-height: 1.15;
      white-space: nowrap;
    }
    .figs .v.pos { color: #ff8a7a; }
    .figs .k {
      margin-top: 5px;
      font-size: 11.5px;
      line-height: 1.4;
      color: rgba(245, 243, 239, 0.6);
    }
    .src {
      margin-top: 16px;
      font-size: 11px;
      color: rgba(245, 243, 239, 0.44);
    }

    /* ================= 본문 ================= */
    .sec { padding: 54px 0; }
    .sec + .sec { border-top: 1px solid var(--rule-2); }

    .kicker {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--dim);
    }

    h2 {
      margin-top: 12px;
      font-family: var(--serif);
      font-weight: 700;
      font-size: clamp(1.5rem, 6.4vw, 1.85rem);
      line-height: 1.36;
      letter-spacing: -0.035em;
    }

    .sec p { margin-top: 16px; color: var(--mut); font-size: 15.5px; }
    .sec p b { color: var(--ink); font-weight: 700; }

    /* 시트 */
    .sheet { margin: 0; padding: 46px 0 54px; background: #efece5; }
    .sheet .wrap { max-width: 460px; }
    .sheet-head { text-align: center; margin-bottom: 22px; }
    .sheet-head h2 { margin-top: 10px; }
    .sheet figure { margin: 0; }
    .sheet img {
      width: 100%;
      border-radius: 2px;
      box-shadow: 0 18px 44px rgba(20, 16, 10, 0.22);
    }
    .sheet figcaption {
      margin-top: 18px;
      font-size: 13px;
      line-height: 1.65;
      color: #7a7469;
      text-align: center;
    }

    /* 인물 */
    .who { display: grid; grid-template-columns: 92px 1fr; gap: 18px; align-items: center; }
    .who img { width: 92px; border-radius: 2px; }
    .who-name { font-family: var(--serif); font-size: 22px; font-weight: 700; letter-spacing: -0.03em; }
    .who-role { margin-top: 3px; font-size: 13px; color: var(--dim); line-height: 1.5; }

    /* 강조 수치열 */
    .esc {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px 9px;
      margin-top: 22px;
      font-family: var(--mono);
      font-weight: 600;
      font-size: 16px;
    }
    .esc i { font-style: normal; color: #c9c5bc; }
    .esc .s1 { color: #a9a49a; }
    .esc .s2 { color: #b0857a; }
    .esc .s3 { color: #bf6355; }
    .esc .s4 { color: var(--up); font-size: 21px; }
    .esc-cap { margin-top: 8px; font-size: 12.5px; color: var(--dim); }

    /* 참여 */
    .steps { margin-top: 22px; counter-reset: s; }
    .step {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--rule-2);
      counter-increment: s;
    }
    .step::before {
      content: counter(s);
      font-family: var(--mono);
      font-size: 12.5px;
      font-weight: 600;
      color: var(--up);
      padding-top: 4px;
    }
    .step p { margin: 0; font-size: 15.5px; color: var(--ink); }

    .sec .cta-slot { margin-top: 28px; }
    .sec .cta-note { color: var(--dim); }

    /* 하단 */
    .notice { padding: 34px 0 22px; font-size: 11.5px; line-height: 1.75; color: #9b9690; }
    .footer { padding: 20px 0 30px; border-top: 1px solid var(--rule); font-size: 11.5px; line-height: 1.8; color: #9b9690; }
    .footer-title { font-size: 12px; font-weight: 700; color: var(--dim); margin-bottom: 6px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .footer-links a {
      color: var(--mut);
      font-size: 12px;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .footer-links .sep { color: var(--rule); }

    /* 스티키 */
    .sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      padding: 10px var(--gap) calc(11px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(251, 250, 247, 0) 0%, rgba(251, 250, 247, 0.97) 40%);
      backdrop-filter: blur(6px);
    }
    .sticky-in { max-width: var(--maxw); margin: 0 auto; }
    .sticky-hint { margin-bottom: 7px; font-size: 12.5px; color: var(--dim); text-align: center; }
    .sticky-in :global(a),
    .sticky-in :global(button) { width: 100%; }

    /* 모달 */
    .ov {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(14, 18, 24, 0.76);
    }
    .ov.show { display: flex; }
    .mbox {
      position: relative;
      width: 100%;
      max-width: 520px;
      max-height: 80vh;
      overflow-y: auto;
      padding: 26px 20px 22px;
      border: 1px solid var(--rule);
      background: var(--card);
    }
    .mclose {
      position: absolute;
      top: 8px;
      right: 12px;
      border: 0;
      background: none;
      color: var(--mut);
      cursor: pointer;
      font-size: 26px;
      line-height: 1;
    }
    .mbox h3 { font-family: var(--serif); font-size: 17px; font-weight: 700; padding-right: 24px; }
    .mbody { margin-top: 12px; color: var(--mut); font-size: 13.5px; line-height: 1.8; }
    .mbody h4 { margin: 13px 0 3px; color: var(--ink); font-size: 13.5px; font-weight: 700; }
    .mbody ul { margin: 5px 0 5px 17px; }

    .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .rv.in { opacity: 1; transform: none; }

    @media (min-width: 600px) {
      :root { --maxw: 560px; --gap: 26px; }
      .sec { padding: 70px 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      .rv { opacity: 1; transform: none; }
    }
  </style>

  <header class="hero">
    <div class="wrap">
      <p class="stamp">2026년 한시 제도 · RIA</p>

      <h1>12월 31일이 지나면<br />이 혜택은 없습니다</h1>

      <p class="lede">
        해외주식을 팔 때 내는 양도소득세를 덜어주는 제도입니다.
        정부가 해외로 나간 돈을 국내로 돌리려고 <b>2026년 한 해만</b> 열었습니다. 내년에는 없습니다.
      </p>

      <div class="cta-slot">
        <CtaButton social={t} size="lg" />
      </div>
      <p class="cta-note">{ctaNote}</p>

      <div class="figs">
        <div>
          <p class="v pos">D-<span id="dd">144</span></p>
          <p class="k">12월 31일<br />마감까지</p>
        </div>
        <div>
          <p class="v">5,000만</p>
          <p class="k">매도금액 기준<br />공제 한도</p>
        </div>
        <div>
          <p class="v">1년</p>
          <p class="k">계좌 유지<br />조건</p>
        </div>
      </div>

      <p class="src">출처: 기획재정부 발표·증권사 안내 정리 (2026년 8월 기준)</p>
    </div>
  </header>

  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">운영자</p>
      <div class="who" style="margin-top:16px">
        <Image src={headImg} alt={name} widths={[92, 184]} sizes="92px" loading="lazy" />
        <div>
          <div class="who-name">{name}</div>
          <div class="who-role">현직 증권맨<br />제도 바뀔 때마다 계산기 두드리는 사람</div>
        </div>
      </div>
      <p>
        제도가 바뀔 때마다 <b>내 계좌에 실제로 무슨 차이가 생기는지</b>를 계산해서 {roomWord}에 올립니다.
        세무사 설명은 어렵고, 증권사 공지는 안 읽힙니다. 그 사이를 메우는 게 제가 하는 일입니다.
      </p>
    </div>
  </section>

  <section class="sheet rv">
    <div class="wrap">
      <div class="sheet-head">
        <p class="kicker">RIA 안내</p>
        <h2>마감일과 한도,<br />이 한 장이 전부입니다</h2>
      </div>
      <figure>
        <Image
          src={briefSheet}
          alt="RIA 계좌 마감일 12월 31일, 공제 한도 5,000만 원이 적힌 안내 인쇄물"
          widths={[460, 920]}
          sizes="(max-width: 600px) 100vw, 460px"
          loading="lazy"
        />
        <figcaption>
          제도는 조용히 끝납니다.<br />증권사도, 국세청도 마감 안내 문자는 안 보냅니다.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">해당되는지 확인</p>
      <h2>이 셋 중 하나라도<br />해당되면 한 번은 보셔야 합니다</h2>

      <p>
        하나, 2025년 12월 23일 이전부터 해외주식이나 ETF를 들고 있다. 테슬라, 엔비디아, S&amp;P500 ETF 전부 포함됩니다.
      </p>
      <p>
        둘, 평가차익이 붙어 있어서 팔면 양도세가 나온다. 연 250만 원 기본공제를 넘는 순간부터 22%.
        차익 3,000만 원이면 세금만 <b>605만 원</b>입니다.
      </p>
      <p>
        셋, 어차피 국내 시장으로 일부 옮길 생각이 있었다. 옮기는 김에 세금까지 줄일 수 있습니다.
      </p>
    </div>
  </section>

  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">2026.08 기준</p>
      <h2>대부분은 안 쓰고<br />그냥 넘기고 있습니다</h2>
      <p>
        RIA는 7월에 처음으로 순유출로 돌아섰습니다. 한 달 동안 <b>5,268억 원</b>이 빠져나갔습니다.
        1년을 채워야 받는 혜택인데, 그걸 깨고서라도 나간 겁니다. 그만큼 다들 급했다는 뜻입니다.
      </p>
      <p>
        공제율은 결제 시점에 따라 다릅니다. 6~7월 결제분이 80%로 가장 높았고, 지금 파시면 그보다 낮은 공제율이 적용됩니다.
        정확한 적용률은 거래 증권사 공지에서 확인하셔야 합니다.
      </p>
      <p>
        여기에 환율까지 겹칩니다. 원·달러 환율은 8월 6일 장중 <b>1,414원</b>까지 내려가 10개월 만의 최저였습니다.
        원화가 더 강해지면 달러 자산을 원화로 바꿀 때 손해가 커집니다. 세금은 늦을수록 불리하고, 환율도 지금은 기다릴 이유가 안 됩니다.
      </p>
    </div>
  </section>

  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">참여 방법</p>
      <h2>{channelName}, 3단계면 끝</h2>
      <div class="steps">
        <div class="step"><p>아래 버튼 누르기</p></div>
        <div class="step"><p>{step2}</p></div>
        <div class="step"><p>{step3}</p></div>
      </div>

      <div class="cta-slot">
        <CtaButton social={t} size="lg" />
      </div>
      <p class="cta-note">참가비 없습니다. 카드 정보도 안 받습니다.</p>
    </div>
  </section>

  <div class="wrap">
    <p class="notice">
      ※ 세제 관련 설명은 언론 보도와 공개 자료를 정리한 것으로 세무 자문이 아닙니다. 적용 요건·세율·기한은 관련 법령에 따라 달라질 수 있고,
      실제 적용 여부와 세액은 개인의 보유·소득 현황에 따라 다르므로 반드시 거래 증권사 또는 세무 전문가에게 확인하시기 바랍니다.
      제공되는 정보는 일반적인 참고용이며, 특정 종목의 매수·매도를 권유하지 않고 수익을 보장하지 않습니다.
      투자 판단과 그 결과에 대한 책임은 이용자 본인에게 있습니다.
    </p>

    <footer class="footer">
      <p class="footer-title">운영 안내</p>
      <p>
        상호: 골든인사이트 커뮤니티 &nbsp;|&nbsp; 사업자 등록번호: 412-88-01735<br />
        주소: 서울특별시 영등포구 국제금융로 10, 23층 &nbsp;|&nbsp; 문의: help@goldeninsight.kr
      </p>
      <nav class="footer-links" aria-label="운영 정책">
        <a data-modal="privacy" tabindex="0" role="button">개인정보 처리방침</a>
        <span class="sep">|</span>
        <a data-modal="terms" tabindex="0" role="button">이용약관</a>
        <span class="sep">|</span>
        <a data-modal="disclaimer" tabindex="0" role="button">투자 위험 고지</a>
      </nav>
    </footer>
  </div>

  <div class="sticky">
    <div class="sticky-in">
      <p class="sticky-hint">내 계좌가 해당되는지 확인하기</p>
      <CtaButton social={t} size="md" />
    </div>
  </div>

  <div class="ov" id="modal">
    <div class="mbox" role="dialog" aria-modal="true">
      <button class="mclose" type="button" aria-label="닫기">×</button>
      <h3 id="mt"></h3>
      <div class="mbody" id="mb"></div>
    </div>
  </div>

  <script is:inline>
    window.__lpModal = {
      privacy: {
        title: '개인정보 처리방침',
        body: `
          <p>본 커뮤니티 운영자(이하 "운영자")는 「개인정보 보호법」 등 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p>
