    document.addEventListener('DOMContentLoaded', () => {
      const ov = document.getElementById('modal')
      const mt = document.getElementById('mt')
      const mb = document.getElementById('mb')
      const open = (k) => {
        const d = window.__lpModal[k]
        if (!d || !ov)
          return
        mt.textContent = d.title
        mb.innerHTML = d.body
        ov.classList.add('show')
        document.body.style.overflow = 'hidden'
      }
      const close = () => {
        ov.classList.remove('show')
        document.body.style.overflow = ''
      }
      document.querySelectorAll('[data-modal]').forEach((el) => {
        const fire = (e) => {
          e.preventDefault()
          open(el.getAttribute('data-modal'))
        }
        el.addEventListener('click', fire)
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ')
            fire(e)
        })
      })
      ov?.querySelector('.mclose')?.addEventListener('click', close)
      ov?.addEventListener('click', (e) => {
        if (e.target === ov)
          close()
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape')
          close()
      })

      // 마감까지 남은 날짜를 보는 시점 기준으로 다시 계산한다
      const dd = document.getElementById('dd')
      if (dd) {
        const now = new Date()
        const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
        const left = Math.max(0, Math.ceil((Date.UTC(2026, 11, 31) - today) / 86400000))
        dd.textContent = String(left)
      }

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const items = Array.from(document.querySelectorAll('.rv'))
      const reveal = () => {
        const h = window.innerHeight
        for (let i = items.length - 1; i >= 0; i--) {
          const el = items[i]
          if (el.getBoundingClientRect().top < h - 60) {
            el.classList.add('in')
            items.splice(i, 1)
          }
        }
        if (!items.length)
          window.removeEventListener('scroll', reveal)
      }
      if (reduced) {
        items.forEach(el => el.classList.add('in'))
      }
      else {
        reveal()
        window.addEventListener('scroll', reveal, { passive: true })
        window.addEventListener('resize', reveal, { passive: true })
      }
    })
  </script>
