---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), ['安迪李_0'])
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
const dateStr = `${today.getFullYear()}년 ${today.getMonth() + 1}월 ${today.getDate()}일`
const days = ['일요일', '월요일', '화요일', '수요일', '목요일', '금요일', '토요일']
const dayStr = days[today.getDay()]
---

<KRBaseLayout title={`${name} — 오늘의 주식 긴급진단`} description="AI 기반 실시간 주식 분석으로 더 나은 투자 결정을 내리세요">
  <style is:global slot="head">
    @import url('https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Noto+Serif+KR:wght@300;400;500;600&display=swap');

    :root {
      --paper: #F3EDD8;
      --paper-dark: #E8DEC4;
      --ink: #1A1200;
      --ink-mid: #3A2E10;
      --ink-light: #6B5B35;
      --red: #B91C1C;
      --gold: #92700A;
      --rule: rgba(26,18,0,0.15);
      --rule-gold: rgba(146,112,10,0.2);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: 'Noto Serif KR', serif;
      max-width: 420px;
      margin: 0 auto;
      min-height: 100vh;
    }
    body::before {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none; z-index: 1000; opacity: 0.35;
    }
    a { color: inherit; }
    /* MASTHEAD */
    .sn-masthead { border-bottom: 3px double var(--ink); }
    .sn-masthead-top {
      display: flex; justify-content: space-between; align-items: center;
      padding: 6px 14px; border-bottom: 1px solid var(--rule);
      font-size: 9px; letter-spacing: 0.06em; color: var(--ink-light);
    }
    .sn-masthead-title { text-align: center; padding: 10px 14px 8px; border-bottom: 1px solid var(--rule); }
    .sn-masthead-title h1 {
      font-family: 'Nanum Myeongjo', serif; font-size: 32px; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1; color: var(--ink);
    }
    .sn-tagline { font-size: 9px; letter-spacing: 0.25em; color: var(--ink-light); margin-top: 3px; text-transform: uppercase; }
    .sn-masthead-meta { display: flex; justify-content: space-between; padding: 5px 14px; font-size: 9px; color: var(--ink-light); }
    /* BREAKING */
    .sn-breaking { background: var(--red); color: white; display: flex; align-items: center; overflow: hidden; height: 28px; }
    .sn-breaking-label {
      background: var(--ink); color: white; font-family: 'Nanum Myeongjo', serif;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      padding: 0 10px; height: 100%; display: flex; align-items: center; white-space: nowrap; flex-shrink: 0;
    }
    .sn-breaking-ticker { font-size: 10px; font-weight: 500; padding: 0 14px; white-space: nowrap; animation: sn-ticker 25s linear infinite; }
    @keyframes sn-ticker { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
    /* MAIN */
    .sn-main { padding: 14px 14px 0; }
    /* HERO */
    .sn-hero { border-bottom: 2px solid var(--ink); padding-bottom: 14px; margin-bottom: 14px; }
    .sn-category { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); font-weight: 600; margin-bottom: 6px; }
    .sn-headline { font-family: 'Nanum Myeongjo', serif; font-size: 26px; font-weight: 800; line-height: 1.18; letter-spacing: -0.02em; margin-bottom: 8px; }
    .sn-subhead { font-size: 12px; font-weight: 500; line-height: 1.55; color: var(--ink-mid); border-left: 3px solid var(--red); padding-left: 10px; margin-bottom: 12px; }
    /* TICKER STRIP */
    .sn-ticker-strip {
      display: flex; gap: 8px; overflow-x: auto; -ms-overflow-style: none; scrollbar-width: none;
      margin-bottom: 12px; padding: 8px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    }
    .sn-ticker-strip::-webkit-scrollbar { display: none; }
    .sn-tick { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 1px; }
    .sn-tick-name { font-size: 9px; color: var(--ink-light); }
    .sn-tick-price { font-family: 'Nanum Myeongjo', serif; font-size: 13px; font-weight: 700; }
    .sn-tick-up { color: var(--red); font-size: 9px; font-weight: 600; }
    .sn-tick-down { color: #1d4ed8; font-size: 9px; font-weight: 600; }
    /* EXPERT CARD */
    .sn-expert-card {
      display: flex; gap: 12px; background: var(--paper-dark);
      border: 1px solid var(--rule); padding: 12px; margin-bottom: 12px;
    }
    .sn-expert-img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 2px solid var(--ink); }
    .sn-expert-info { flex: 1; }
    .sn-expert-name { font-family: 'Nanum Myeongjo', serif; font-size: 16px; font-weight: 800; color: var(--ink); }
    .sn-expert-title { font-size: 9.5px; letter-spacing: 0.1em; color: var(--red); font-weight: 600; text-transform: uppercase; margin-bottom: 4px; }
    .sn-expert-stats { display: flex; gap: 12px; }
    .sn-stat { text-align: center; }
    .sn-stat-val { font-family: 'Nanum Myeongjo', serif; font-size: 15px; font-weight: 800; color: var(--ink); display: block; }
    .sn-stat-label { font-size: 8px; color: var(--ink-light); text-transform: uppercase; letter-spacing: 0.08em; }
    /* TWO COL */
    .sn-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
    .sn-col-divider { border-right: 1px solid var(--rule); padding-right: 12px; }
    .sn-small-headline { font-family: 'Nanum Myeongjo', serif; font-size: 14px; font-weight: 700; line-height: 1.35; color: var(--ink); margin-bottom: 5px; }
    .sn-small-body { font-size: 10.5px; line-height: 1.65; color: var(--ink-mid); }
    .sn-rule { height: 1px; background: var(--rule); margin: 12px 0; }
    /* QUOTE BOX */
    .sn-quote {
      background: var(--ink); color: var(--paper); padding: 14px;
      margin-bottom: 14px; position: relative; overflow: hidden;
    }
    .sn-quote::before {
      content: '❝'; position: absolute; top: -8px; left: 8px;
      font-size: 60px; font-family: 'Nanum Myeongjo', serif; opacity: 0.12; line-height: 1;
    }
    .sn-quote-text { font-family: 'Nanum Myeongjo', serif; font-size: 15px; font-style: italic; line-height: 1.6; position: relative; z-index: 1; margin-bottom: 8px; }
    .sn-quote-attr { font-size: 10px; letter-spacing: 0.08em; color: rgba(243,237,216,0.5); text-transform: uppercase; position: relative; z-index: 1; }
    /* TABLE */
    .sn-section-title { font-family: 'Nanum Myeongjo', serif; font-size: 16px; font-weight: 800; border-bottom: 2px solid var(--ink); padding-bottom: 4px; margin-bottom: 10px; }
    .sn-table { width: 100%; border-collapse: collapse; font-size: 10.5px; }
    .sn-table th { text-align: left; padding: 4px 0; color: var(--ink-light); font-weight: 600; letter-spacing: 0.06em; border-bottom: 1px solid var(--rule); font-size: 9px; text-transform: uppercase; }
    .sn-table td { padding: 5px 0; border-bottom: 1px solid var(--rule); color: var(--ink-mid); }
    .sn-table td:last-child { text-align: right; }
    .sn-up { color: var(--red); font-weight: 600; }
    .sn-down { color: #1d4ed8; font-weight: 600; }
    /* CTA SECTION */
    .sn-cta {
      background: var(--paper-dark); border: 2px solid var(--ink);
      padding: 18px 16px; margin: 14px 0; text-align: center; position: relative;
    }
    .sn-cta::before, .sn-cta::after { content: '✦'; position: absolute; font-size: 10px; color: var(--gold); }
    .sn-cta::before { top: 6px; left: 8px; }
    .sn-cta::after { bottom: 6px; right: 8px; }
    .sn-cta-kicker { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--red); font-weight: 600; margin-bottom: 6px; }
    .sn-cta-title { font-family: 'Nanum Myeongjo', serif; font-size: 19px; font-weight: 800; line-height: 1.3; color: var(--ink); margin-bottom: 8px; }
    .sn-cta-body { font-size: 11px; color: var(--ink-mid); line-height: 1.6; margin-bottom: 14px; }
    .sn-cta-note { font-size: 9px; color: var(--ink-light); margin-top: 8px; letter-spacing: 0.05em; }
    /* TESTIMONIALS */
    .sn-test { padding: 10px 0; border-bottom: 1px solid var(--rule); display: flex; gap: 10px; }
    .sn-test-avatar {
      width: 32px; height: 32px; border-radius: 50%; background: var(--paper-dark);
      border: 1px solid var(--rule); display: flex; align-items: center; justify-content: center;
      font-family: 'Nanum Myeongjo', serif; font-weight: 700; font-size: 13px; color: var(--ink-mid); flex-shrink: 0;
    }
    .sn-test-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 3px; }
    .sn-test-name { font-size: 11px; font-weight: 600; color: var(--ink); }
    .sn-test-return { font-size: 10px; color: var(--red); font-weight: 700; }
    .sn-test-text { font-size: 10.5px; line-height: 1.55; color: var(--ink-mid); font-style: italic; }
    /* FOOTER */
    footer.sn-footer { border-top: 3px double var(--ink); padding: 12px 14px; text-align: center; }
    .sn-footer-logo { font-family: 'Nanum Myeongjo', serif; font-size: 16px; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
    .sn-footer-disc { font-size: 8.5px; color: var(--ink-light); line-height: 1.6; }
    /* Custom link-btn style override — invisible so our styles show */
    .sn-cta .link-btn, .sn-cta-wrap .link-btn { display: block; width: 100%; }
  </style>

  <!-- MASTHEAD -->
  <header class="sn-masthead">
    <div class="sn-masthead-top">
      <span>대한민국 투자 정보 채널</span>
      <span>SINCE 2019</span>
    </div>
    <div class="sn-masthead-title">
      <h1>韓國投資日報</h1>
      <div class="sn-tagline">한국 주식 투자 전문 분석 채널</div>
    </div>
    <div class="sn-masthead-meta">
      <span>{dateStr} {dayStr}</span>
      <span>무료 구독 중</span>
    </div>
  </header>

  <!-- BREAKING TICKER -->
  <div class="sn-breaking">
    <div class="sn-breaking-label">긴급</div>
    <div class="sn-breaking-ticker">
      삼성전자 +3.2% ↑ &nbsp;|&nbsp; SK하이닉스 +5.7% ↑ &nbsp;|&nbsp; NAVER -1.1% ↓ &nbsp;|&nbsp; 현대차 +2.3% ↑ &nbsp;|&nbsp; 카카오 +4.0% ↑ &nbsp;|&nbsp; 코스피 2,847.33 ↑ &nbsp;|&nbsp; 외국인 순매수 2조 2천억원 돌파
    </div>
  </div>

  <main class="sn-main">

    <!-- HERO -->
    <div class="sn-hero">
      <div class="sn-category">📌 오늘의 긴급 포착</div>
      <h2 class="sn-headline">AI 분석이 포착한<br>"지금 바로 매수"<br>종목 3가지</h2>
      <p class="sn-subhead">
        기관 매집 신호 + 기술적 돌파구 + 실적 서프라이즈가 동시에 겹친 이례적 신호 포착 — {name} 전문가가 즉시 확인 권고
      </p>

      <!-- STOCK TICKER -->
      <div class="sn-ticker-strip">
        <div class="sn-tick"><span class="sn-tick-name">삼성전자</span><span class="sn-tick-price" id="p1">84,200</span><span class="sn-tick-up">▲3.2%</span></div>
        <div class="sn-tick"><span class="sn-tick-name">SK하이닉스</span><span class="sn-tick-price" id="p2">198,500</span><span class="sn-tick-up">▲5.7%</span></div>
        <div class="sn-tick"><span class="sn-tick-name">현대차</span><span class="sn-tick-price" id="p3">241,000</span><span class="sn-tick-up">▲2.3%</span></div>
        <div class="sn-tick"><span class="sn-tick-name">카카오</span><span class="sn-tick-price" id="p4">52,300</span><span class="sn-tick-up">▲4.0%</span></div>
        <div class="sn-tick"><span class="sn-tick-name">NAVER</span><span class="sn-tick-price" id="p5">178,000</span><span class="sn-tick-down">▼1.1%</span></div>
      </div>

      <!-- EXPERT CARD -->
      <div class="sn-expert-card">
        <Image src={headImg} alt={name} class="sn-expert-img" width={72} height={72} />
        <div class="sn-expert-info">
          <div class="sn-expert-title">주식투자 전문가</div>
          <div class="sn-expert-name">{name}</div>
          <div class="sn-expert-stats">
            <div class="sn-stat"><span class="sn-stat-val">15<span style="font-size:10px">년+</span></span><span class="sn-stat-label">경력</span></div>
            <div class="sn-stat"><span class="sn-stat-val">85<span style="font-size:10px">%</span></span><span class="sn-stat-label">적중률</span></div>
            <div class="sn-stat"><span class="sn-stat-val">5000<span style="font-size:10px">+</span></span><span class="sn-stat-label">회원</span></div>
          </div>
        </div>
      </div>

      <p style="font-size:11px; line-height:1.7; color:var(--ink-mid);">
        오늘 오전 9시 27분, 코스피 시장에서 이례적인 패턴이 관측되었다. 기관 투자자들이 장 초반 집중 매수에 나선 3개 종목에서 모두 기술적 저항선 돌파와 실적 상향 조정이 동반 확인됐다. {name}이 즉각 분석을 시작했다.
      </p>
    </div>

    <!-- TWO COLUMN -->
    <div class="sn-two-col">
      <div class="sn-col-divider">
        <div>
          <div class="sn-category" style="font-size:8px;">시장 동향</div>
          <h3 class="sn-small-headline">외국인, 반도체 집중 매수 재개</h3>
          <p class="sn-small-body">외국인 투자자가 5거래일 연속 반도체 업종 순매수를 지속하며 수급 환경이 급격히 개선되고 있다.</p>
        </div>
        <div class="sn-rule"></div>
        <div>
          <div class="sn-category" style="font-size:8px;">기업 공시</div>
          <h3 class="sn-small-headline">삼성SDI, 2분기 실적 전망 상향</h3>
          <p class="sn-small-body">증권사 4곳이 목표주가를 동반 상향 조정, 평균 괴리율 38%.</p>
        </div>
      </div>
      <div>
        <div>
          <div class="sn-category" style="font-size:8px;">전략 인사이트</div>
          <h3 class="sn-small-headline">{name} "지금이 마지막 기회"</h3>
          <p class="sn-small-body">15년 경력 전문가가 꼽은 '한 달 안에 오를 종목', 카카오톡 채널에서 독점 공개.</p>
        </div>
        <div class="sn-rule"></div>
        <div>
          <div class="sn-category" style="font-size:8px;">구독자 성과</div>
          <h3 class="sn-small-headline">3월 추천 평균 수익률 +27.3%</h3>
          <p class="sn-small-body">구독자 1,240명의 이번 달 평균 수익률이 코스피 대비 24.1%p 초과 달성.</p>
        </div>
      </div>
    </div>

    <!-- QUOTE -->
    <div class="sn-quote">
      <p class="sn-quote-text">
        "이런 신호가 세 가지 동시에 겹치는 건 1년에 한두 번도 없습니다. 지금 놓치면 6개월 후에 후회합니다."
      </p>
      <div class="sn-quote-attr">— {name}, 수석 애널리스트</div>
    </div>

    <!-- TABLE -->
    <div style="margin-bottom:14px;">
      <div class="sn-section-title">이번 주 주목 종목</div>
      <table class="sn-table">
        <thead>
          <tr><th>종목명</th><th>현재가</th><th>목표가</th><th>등급</th></tr>
        </thead>
        <tbody>
          <tr><td>삼성전자</td><td>84,200</td><td>110,000</td><td class="sn-up">매수 ▲</td></tr>
          <tr><td>SK하이닉스</td><td>198,500</td><td>260,000</td><td class="sn-up">강매수 ▲</td></tr>
          <tr><td>카카오</td><td>52,300</td><td>71,000</td><td class="sn-up">매수 ▲</td></tr>
          <tr><td>NAVER</td><td>178,000</td><td>165,000</td><td class="sn-down">중립 —</td></tr>
        </tbody>
      </table>
    </div>

    <!-- CTA 1 -->
    <div class="sn-cta">
      <div class="sn-cta-kicker">⬤ 독점 무료 구독 신청</div>
      <h3 class="sn-cta-title">
        {name}의 리포트를<br>직접 받아보세요
      </h3>
      <p class="sn-cta-body">
        매일 아침 7시, 오늘 주목해야 할 종목 분석이 자동 발송됩니다. 구독 즉시 지난 리포트 30일치도 함께 제공됩니다.
      </p>
      <CtaButton social={t} />
      <div class="sn-cta-note">무료 · 언제든 구독 해지 가능 · 스팸 없음</div>
    </div>

    <!-- TESTIMONIALS -->
    <div style="margin-bottom:14px;">
      <div class="sn-section-title">구독자 후기</div>
      <div class="sn-test">
        <div class="sn-test-avatar">김</div>
        <div>
          <div class="sn-test-header"><span class="sn-test-name">김○○ 님 · 직장인</span><span class="sn-test-return">+38%</span></div>
          <p class="sn-test-text">"처음엔 반신반의했는데 첫 번째 추천 종목에서 3주 만에 22% 수익. 그 이후로 매일 꼭 읽습니다."</p>
        </div>
      </div>
      <div class="sn-test">
        <div class="sn-test-avatar">이</div>
        <div>
          <div class="sn-test-header"><span class="sn-test-name">이○○ 님 · 주부</span><span class="sn-test-return">+51%</span></div>
          <p class="sn-test-text">"주식 완전 초보였는데 용어 설명부터 매매 타이밍까지 너무 친절하게 알려줘요."</p>
        </div>
      </div>
      <div class="sn-test">
        <div class="sn-test-avatar">박</div>
        <div>
          <div class="sn-test-header"><span class="sn-test-name">박○○ 님 · 자영업</span><span class="sn-test-return">+29%</span></div>
          <p class="sn-test-text">"6개월 구독했는데 추천 종목 평균 수익률이 29%. 주변에도 다 권유하고 있습니다."</p>
        </div>
      </div>
    </div>

    <!-- FINAL CTA -->
    <div style="text-align:center; padding: 16px 0 20px; border-top: 2px solid var(--ink);">
      <p style="font-size:11px; color:var(--ink-mid); margin-bottom:10px; line-height:1.6;">
        지금 바로 구독하면 <strong style="color:var(--red);">{name}의 오늘 아침 긴급 리포트</strong>를 즉시 받으실 수 있습니다
      </p>
      <CtaButton social={t} />
    </div>

  </main>

  <footer class="sn-footer">
    <div class="sn-footer-logo">韓國投資日報</div>
    <p class="sn-footer-disc">
      본 리포트는 투자 권유를 목적으로 하지 않으며, 정보 제공만을 위한 것입니다.<br>
      투자 결정에 대한 책임은 전적으로 투자자 본인에게 있습니다.
    </p>
  </footer>

  <script is:inline>
    // Animate ticker prices
    const prices = [
      { id: 'p1', base: 84200 },
      { id: 'p2', base: 198500 },
      { id: 'p3', base: 241000 },
      { id: 'p4', base: 52300 },
      { id: 'p5', base: 178000 },
    ]
    setInterval(() => {
      prices.forEach(p => {
        const el = document.getElementById(p.id)
        if (el) {
          const change = Math.floor(Math.random() * 300) - 150
          p.base += change
          el.textContent = p.base.toLocaleString()
        }
      })
    }, 3000)
  </script>
