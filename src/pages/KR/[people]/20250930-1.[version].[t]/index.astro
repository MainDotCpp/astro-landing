---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import BaseLayout from '@/layouts/KRBaseLayout.astro'
import { Filters, generateKrConfig } from '@/utils/kr_config'
// Import CSS files
import './static/css/style2.css'

import './static/css/animate.min.css'
import './static/css/slick-theme.css'

export function getStaticPaths() {
 return generateKrConfig()
}

const { t = '棒群' } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }
const headImg = (await import(`../images/${img_prefix}head.jpg`)).default

const socialOptions = ['卡扣', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined
---


<BaseLayout title={`${name} 주식투자`} description={`${name} 주식투자 전문가`}>
  <style>
    .hero-gradient {
      background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-gradient::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(251, 191, 36, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(251, 191, 36, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }
    .expert-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), 0 8px 30px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    .expert-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4), 0 12px 40px rgba(0, 0, 0, 0.3);
    }
    .stat-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(251, 191, 36, 0.3);
      transition: all 0.3s ease;
    }
    .stat-card:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(251, 191, 36, 0.5);
      transform: scale(1.05);
    }
    .benefit-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.08) 100%);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    .benefit-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
    }
    .avatar-frame {
      position: relative;
      display: inline-block;
    }
    .avatar-frame::before {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 1rem;
      padding: 4px;
      background: linear-gradient(135deg, #fbbf24, #f59e0b, #d97706);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0.6;
    }
    @media (max-width: 768px) {
      .expert-card {
        padding: 1.5rem;
      }
      .stat-card {
        padding: 0.75rem;
      }
    }
  </style>
  <div class="min-h-screen hero-gradient">
    {/* Hero Section */}
    <section class="text-white py-16 md:py-24 px-4 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-center">
          {/* Expert Card */}
          <div class="expert-card rounded-3xl p-8 md:p-12 w-full max-w-2xl">
            <div class="text-center">
              <div class="avatar-frame mb-8">
                <Image 
                  src={headImg} 
                  alt={name} 
                  class="w-48 h-48 md:w-64 md:h-64 mx-auto rounded-xl object-cover shadow-2xl"
                />
              </div>

              <h3 class="text-4xl md:text-5xl font-bold text-white mb-3 tracking-tight">{name}</h3>
              <p class="text-yellow-400 mb-8 text-xl md:text-2xl font-semibold">당신의 재테크 전문가</p>

              <div class="grid grid-cols-2 gap-4 md:gap-6 mb-8">
                <div class="stat-card text-center p-4 md:p-6 rounded-xl">
                  <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">35+</div>
                  <div class="text-base md:text-lg text-emerald-100 font-medium">년</div>
                </div>
                <div class="stat-card text-center p-4 md:p-6 rounded-xl">
                  <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">65만+</div>
                  <div class="text-base md:text-lg text-emerald-100 font-medium">팬</div>
                </div>
                <div class="stat-card text-center p-4 md:p-6 rounded-xl">
                  <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">85%</div>
                  <div class="text-base md:text-lg text-emerald-100 font-medium">승률</div>
                </div>
                <div class="stat-card text-center p-4 md:p-6 rounded-xl">
                  <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">300%</div>
                  <div class="text-base md:text-lg text-emerald-100 font-medium">평균수익률</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-12 text-center">
          <CtaButton social={social} />
        </div>
      </div>
    </section>

    {/* Benefits Section */}
    <section class="text-white py-12 md:py-16 px-4 relative z-10">
      <div class="max-w-4xl mx-auto">
        <div class="benefit-card rounded-3xl p-8 md:p-10 w-full">
          <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-6 md:mb-8 text-center">
            나를 친구 추가하면 얻을 수 있는 것들:
          </h3>
          <div class="space-y-4 md:space-y-5 text-lg md:text-xl lg:text-2xl text-emerald-50">
            <div class="flex items-start gap-3">
              <span class="text-2xl md:text-3xl flex-shrink-0">✅</span>
              <span class="leading-relaxed">일일 상한가 추세 정보, 참고 학습.</span>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-2xl md:text-3xl flex-shrink-0">✅</span>
              <span class="leading-relaxed">24시간 자문과 질의응답, 무료 맞춤형 방안.</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
