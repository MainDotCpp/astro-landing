---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import BaseLayout from '@/layouts/KRBaseLayout.astro'
import { Filters, generateKrConfig } from '@/utils/kr_config'
// Import CSS files
import './static/css/style2.css'

import './static/css/animate.min.css'
import './static/css/slick-theme.css'

export function getStaticPaths() {
 return generateKrConfig()
}

const { t = '棒群' } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }
const headImg = (await import(`../images/${img_prefix}head.jpg`)).default

const socialOptions = ['卡扣', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined
---


<BaseLayout title={`${name} 주식투자`} description={`${name} 주식투자 전문가`}>
  <div class="min-h-screen bg-emerald-950">
        {/* Hero Section */}
    <section class="bg-emerald-950 text-white py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex justify-center">

          {/* Right Expert Card */}
          <div class=" rounded-2xl p-8 w-full">
            <div class="text-center">
              <Image src={headImg} alt={name} class="w-64 h-64 mx-auto mb-6 bg-slate-200 rounded-xl object-cover flex items-center justify-center">
              </Image>

              <h3 class="text-3xl md:text-4xl font-bold text-white mb-2">{name}</h3>
              <p class="text-yellow-400 mb-6 text-lg md:text-xl">당신의 재테크 전문가</p>

              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">35+</div>
                  <div class="text-base md:text-lg text-emerald-100">년</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">65만+</div>
                  <div class="text-base md:text-lg text-emerald-100">팬</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">85%</div>
                  <div class="text-base md:text-lg text-emerald-100">승률</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">300%</div>
                  <div class="text-base md:text-lg text-emerald-100">평균수익률</div>
                </div>
              </div>

            </div>
          </div>
        </div>
        <div class="mt-10 text-center">
          <CtaButton social={social} />
        </div>
      </div>
      <section class="bg-emerald-950 text-white py-10 px-4">
        <div class="max-w-3xl mx-auto">
          <div class="bg-white bg-opacity-10 rounded-2xl p-8 backdrop-blur-sm border border-emerald-700/30 w-full">
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-4 text-center">나를 친구 추가하면 얻을 수 있는 것들:</h3>
            <div class="space-y-3 text-base md:text-lg text-emerald-100">
              <div>✅일일 상한가 추세 정보, 참고 학습.</div>
              <div>✅24시간 자문과 질의응답, 무료 맞춤형 방안.</div>
            </div>
          </div>
        </div>
      </section>
    </section>

  </div>
</BaseLayout>
