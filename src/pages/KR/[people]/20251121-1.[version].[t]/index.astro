---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import BaseLayout from '@/layouts/KRBaseLayout.astro'
import { Filters, generateKrConfig } from '@/utils/kr_config'
// Import CSS files
import './static/css/style.css'


export function getStaticPaths() {
 return generateKrConfig(['宣大仁_0', '孔炳浩_0'])
}

const { t = '棒群', people } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }
const headImg = (await import(`../images/${img_prefix}head.jpg`)).default
const img1 = (await import(`./static/images/${people}_1.png`)).default
const img2 = (await import(`./static/images/${people}_2.png`)).default
const img3 = (await import(`./static/images/${people}_3.png`)).default

const socialOptions = ['卡扣', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined
---

<BaseLayout title={`${name} - 주식 투자 커뮤니티 | 무료 참여`} description={`${name} 전문가가 직접 운영하는 무료 주식 투자 교류 플랫폼`} plugins={{ 'google-fonts-kr': {} }}>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background">
        <div class="stock-chart"></div>
        <div class="floating-numbers">
          <span class="number up">+15.2%</span>
          <span class="number down">-3.8%</span>
          <span class="number up">+22.1%</span>
          <span class="number down">-7.3%</span>
        </div>
      </div>
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            <span class="highlight">{name}</span>과 함께하는<br />
            <span class="gradient-text">주식 투자 커뮤니티</span>
          </h1>
          <p class="hero-subtitle">
            미래에셋자산운용 출신 전문가가 직접 운영하는<br />
            <strong>무료 주식 투자 교류 플랫폼</strong>
          </p>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-number">10,000+</span>
              <span class="stat-label">활성 회원</span>
            </div>
            <div class="stat">
              <span class="stat-number">95%</span>
              <span class="stat-label">만족도</span>
            </div>
            <div class="stat">
              <span class="stat-number">무료</span>
              <span class="stat-label">참여비</span>
            </div>
          </div>
          <CtaButton social={social} class="hero-cta" />
        </div>
      </div>
    </section>

    <!-- Expert Introduction -->
    <section class="expert-intro">
      <div class="container">
        <div class="expert-content">
          <div class="expert-image">
            <Image
              src={headImg}
              alt={name}
              style="width: 100%; height: 100%; object-fit: cover; border-radius: 15px"
            />
          </div>
          <div class="expert-text">
            <h2>투자 및 자산운용 전문가</h2>
            <h3>{name}</h3>
            <p class="expert-description">
              대한민국의 대표적인 경제·금융 전문가로, 오랜 기간 미래에셋자산운용에서 임원으로 활동하며 국내 투자자들에게
              합리적인 자산관리 해법을 제시해 왔습니다.
            </p>
            <div class="expert-credentials">
              <div class="credential">
                <span class="credential-icon">🏦</span>
                <span>미래에셋자산운용 임원 출신</span>
              </div>
              <div class="credential">
                <span class="credential-icon">📚</span>
                <span>연금, 자산배분, 장기 투자 전략 전문</span>
              </div>
              <div class="credential">
                <span class="credential-icon">📺</span>
                <span>다수 강연, 방송, 저서 활동</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Community Benefits -->
    <section class="benefits">
      <div class="container">
        <h2 class="section-title">커뮤니티 혜택</h2>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-icon">📖</div>
            <h3>전문 투자 매뉴얼</h3>
            <p>{name} 전문가가 직접 제작한 초보자부터 고수까지 모든 레벨의 투자자들을 위한 상세한 투자 가이드</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">📈</div>
            <h3>급등주 정보</h3>
            <p>무료로 제공되는 검증된 급등주 정보와 실시간 시장 분석 자료</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">👥</div>
            <h3>전문가 네트워킹</h3>
            <p>동일한 관심사를 가진 투자자들과의 활발한 정보 교환 및 네트워킹</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">🎯</div>
            <h3>맞춤형 투자 전략</h3>
            <p>개인의 투자 성향과 목표에 맞는 맞춤형 투자 전략 상담</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Image-Text Module 1 -->
    <section class="image-text-module">
      <div class="container">
        <div class="module-content">
          <div class="module-image">
            <Image
              src={img1}
              alt="체계적인 투자 교육"
              style="width: 100%; height: 100%; object-fit: cover; border-radius: 15px"
            />
          </div>
          <div class="module-text">
            <h2>체계적인 투자 교육</h2>
            <p>
              {name} 전문가가 20년간의 경험을 바탕으로 제작한 투자 매뉴얼을 통해 체계적이고 안정적인 투자 방법을 학습할
              수 있습니다.
            </p>
            <ul class="feature-list">
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">기초부터 고급까지 단계별 학습 과정</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">실전 투자 사례와 분석 방법</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">리스크 관리 및 포트폴리오 구성 전략</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">장기 투자와 단기 투자의 균형점</span>
              </li>
            </ul>
            <CtaButton social={social} text="매뉴얼 받기" />
          </div>
        </div>
      </div>
    </section>

    <!-- Image-Text Module 2 -->
    <section class="image-text-module reverse">
      <div class="container">
        <div class="module-content">
          <div class="module-text">
            <h2>실시간 시장 분석</h2>
            <p>전문가의 시각으로 분석한 실시간 시장 동향과 급등주 정보를 무료로 제공받으세요.</p>
            <ul class="feature-list">
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">일일 시장 분석 리포트</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">검증된 급등주 추천</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">섹터별 투자 기회 분석</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">경제 지표 해석 및 투자 전략</span>
              </li>
            </ul>
            <CtaButton social={social} text="분석 받기" />
          </div>
          <div class="module-image">
            <Image
              src={img2}
              alt="실시간 시장 분석"
              style="width: 100%; height: 100%; object-fit: cover; border-radius: 15px"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Image-Text Module 3 -->
    <section class="image-text-module">
      <div class="container">
        <div class="module-content">
          <div class="module-image">
            <Image
              src={img3}
              alt="활발한 투자자 커뮤니티"
              style="width: 100%; height: 100%; object-fit: cover; border-radius: 15px"
            />
          </div>
          <div class="module-text">
            <h2>활발한 투자자 커뮤니티</h2>
            <p>같은 목표를 가진 투자자들과 함께 정보를 공유하고 서로 도움을 주고받는 활발한 커뮤니티입니다.</p>
            <ul class="feature-list">
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">24시간 실시간 채팅 및 토론</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">투자 아이디어 공유 및 피드백</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">성공 사례 및 실패 사례 학습</span>
              </li>
              <li>
                <span class="feature-icon">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M16.7071 5.29289C17.0976 5.68342 17.0976 6.31658 16.7071 6.70711L8.70711 14.7071C8.31658 15.0976 7.68342 15.0976 7.29289 14.7071L3.29289 10.7071C2.90237 10.3166 2.90237 9.68342 3.29289 9.29289C3.68342 8.90237 4.31658 8.90237 4.70711 9.29289L8 12.5858L15.2929 5.29289C15.6834 4.90237 16.3166 4.90237 16.7071 5.29289Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="feature-text">정기 온라인 세미나 및 Q&A</span>
              </li>
            </ul>
            <CtaButton social={social} text="커뮤니티 참여" />
          </div>
        </div>
      </div>
    </section>

    <!-- Investment Philosophy -->
    <section class="philosophy">
      <div class="container">
        <h2 class="section-title">{name}의 투자 철학</h2>
        <div class="philosophy-content">
          <div class="philosophy-quote">
            <blockquote>
              "단기적 시세 차익이 아닌 장기적 관점에서의<br />
              안정적인 자산 성장에 초점을 맞춥니다"
            </blockquote>
          </div>
          <div class="philosophy-points">
            <div class="point">
              <div class="point-icon">🎯</div>
              <h3>장기 투자 전략</h3>
              <p>꾸준하고 안정적인 자산 축적을 위한 장기적 관점</p>
            </div>
            <div class="point">
              <div class="point-icon">🌍</div>
              <h3>글로벌 분산 투자</h3>
              <p>리스크를 분산시키는 글로벌 포트폴리오 구성</p>
            </div>
            <div class="point">
              <div class="point-icon">📊</div>
              <h3>ETF & 연금펀드</h3>
              <p>개인 투자자에게 적합한 실질적인 투자 방법론</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials">
      <div class="container">
        <h2 class="section-title">실제 회원들의 생생한 후기</h2>
        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="testimonial-content">
              <div class="stars">★★★★★</div>
              <p>
                "{name} 전문가의 매뉴얼 덕분에 주식 투자에 대한 두려움이 사라졌어요. 특히 장기 투자 전략 부분이 정말
                도움이 되었습니다. 3개월 만에 15% 수익을 올렸어요!"
              </p>
              <div class="testimonial-author">
                <div class="author-avatar">박</div>
                <div class="author-info">
                  <span class="author-name">박**님</span>
                  <span class="author-title">직장인 투자자</span>
                </div>
              </div>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-content">
              <div class="stars">★★★★★</div>
              <p>
                "급등주 정보가 정말 정확해요. 커뮤니티에서 공유된 종목으로 한 달에 20% 이상 수익을 냈습니다. 무료인데
                이런 퀄리티라니 믿기지 않아요."
              </p>
              <div class="testimonial-author">
                <div class="author-avatar">김</div>
                <div class="author-info">
                  <span class="author-name">김**님</span>
                  <span class="author-title">개인투자자</span>
                </div>
              </div>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-content">
              <div class="stars">★★★★★</div>
              <p>
