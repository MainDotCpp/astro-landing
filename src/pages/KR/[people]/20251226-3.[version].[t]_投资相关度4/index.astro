---
import { Image } from 'astro:assets'
import avatarImg from '@/assets/avatar/安迪李_avatar.png'
import CtaButton from '@/components/CtaButton.astro'
import KRRedirectCode from '@/components/KRRedirectCode.astro'
import { generateKrConfig } from '@/utils/kr_config'
// Import CSS
import './static/css/style.css'

export function getStaticPaths() {
  return generateKrConfig(['安迪李_0'])
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }

// 使用头像图片
const heroImg = avatarImg

const socialOptions = ['卡扣', '卡群', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined

// 公司信息
const companyInfo = {
  name: '한국시장연구소 주식회사',
  nameEn: 'Korea Market Research Institute Co., Ltd.',
  business: '정보 정리, 연구 내용 공유, 학습 교류 서비스',
  serviceType: '학습 및 정보 참고 용도',
  serviceArea: '한국 및 기타 지역',
  address: '서울특별시 강남구 테헤란로 123',
  ceo: '안디 이',
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} | 비즈니스 트렌드 관찰과 학습</title>
    <meta name="description" content="15년간의 관찰 경험을 바탕으로 비즈니스 트렌드와 변화를 함께 학습하는 커뮤니티입니다." />
    <KRRedirectCode />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-background"></div>
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <i class="fas fa-lightbulb"></i>
            <span>트렌드 관찰자</span>
          </div>
          <h1 class="hero-title">
            비즈니스 트렌드를<br />
            <span class="highlight">함께 관찰하고 학습</span>하는 공간
          </h1>
          <p class="hero-description">
            15년간 다양한 산업과 비즈니스 모델을 관찰해온 경험을 바탕으로,<br />
            변화하는 트렌드와 패턴을 함께 분석하고 이해하는 학습 커뮤니티입니다.
          </p>
          <div class="hero-profile">
            <div class="profile-avatar">
              <Image src={heroImg} alt={`${name} 프로필`} />
            </div>
            <div class="profile-text">
              <span class="profile-name">{name}</span>
              <span class="profile-role">비즈니스 트렌드 관찰자</span>
            </div>
          </div>
          <div class="hero-cta">
            <CtaButton social={social} size="lg" class="hero-btn">
              <span slot="content">커뮤니티 참여하기</span>
            </CtaButton>
            <p class="cta-hint">추가 후 7을 보내주시면 안내드립니다</p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="section about-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">소개</span>
          <h2 class="section-title">이 커뮤니티는 무엇인가요?</h2>
        </div>
        <div class="about-content">
          <div class="about-text">
            <p class="lead-paragraph">
              비즈니스 환경의 변화와 트렌드를 관찰하고, 그 의미를 함께 탐구하는 학습 공간입니다.
            </p>
            <p class="regular-paragraph">
              우리는 다양한 산업 분야에서 일어나는 변화를 관찰하고, 
              공개된 정보와 데이터를 바탕으로 패턴과 트렌드를 분석합니다. 
              이를 통해 비즈니스 환경에 대한 이해를 깊게 하고, 
              구조적 사고력을 기를 수 있도록 돕습니다.
            </p>
            <div class="highlight-box">
              <p class="highlight-text">
                <i class="fas fa-info-circle"></i>
                본 커뮤니티는 학습 및 정보 교류를 목적으로 하며, 
                어떠한 형태의 상업적 권유나 특정 서비스 추천을 포함하지 않습니다.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Do Section -->
    <section class="section activities-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">활동 내용</span>
          <h2 class="section-title">함께 하는 활동</h2>
        </div>
        <div class="activities-grid">
          <div class="activity-card">
            <div class="card-icon">
              <i class="fas fa-chart-bar"></i>
            </div>
            <h3 class="card-title">트렌드 데이터 정리</h3>
            <p class="card-description">
              매주 주요 비즈니스 트렌드와 변화를 정리하여 공유합니다. 
              공개된 데이터와 정보를 바탕으로 패턴을 분석하고 이해합니다.
            </p>
          </div>
          <div class="activity-card">
            <div class="card-icon">
              <i class="fas fa-users"></i>
            </div>
            <h3 class="card-title">의견 교류와 토론</h3>
            <p class="card-description">
              다양한 관점에서 트렌드를 바라보고, 
              합리적이고 구조적인 사고를 중심으로 의견을 나눕니다.
            </p>
          </div>
          <div class="activity-card">
            <div class="card-icon">
              <i class="fas fa-book-reader"></i>
            </div>
            <h3 class="card-title">학습 자료 공유</h3>
            <p class="card-description">
              비즈니스와 트렌드 이해에 도움이 되는 학습 자료와 
              분석 방법론을 함께 공유하고 학습합니다.
            </p>
          </div>
          <div class="activity-card">
            <div class="card-icon">
              <i class="fas fa-comments"></i>
            </div>
            <h3 class="card-title">1:1 학습 상담</h3>
            <p class="card-description">
              개인의 관심 분야와 이해 수준에 맞춰 
              학습 방향과 접근 방법을 함께 고민합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Approach Section -->
    <section class="section approach-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">학습 접근법</span>
          <h2 class="section-title">우리의 학습 방식</h2>
        </div>
        <div class="approach-list">
          <div class="approach-item">
            <div class="approach-number">01</div>
            <div class="approach-content">
              <h3>관찰 중심의 학습</h3>
              <p>
                실제 비즈니스 환경에서 일어나는 변화를 관찰하고, 
                그 의미와 패턴을 함께 분석합니다.
              </p>
            </div>
          </div>
          <div class="approach-item">
            <div class="approach-number">02</div>
            <div class="approach-content">
              <h3>공개 정보 기반</h3>
              <p>
                모든 분석과 학습은 공개된 정보와 데이터를 기반으로 하며, 
                참고 학습 목적으로만 활용됩니다.
              </p>
            </div>
          </div>
          <div class="approach-item">
            <div class="approach-number">03</div>
            <div class="approach-content">
              <h3>장기적 관점</h3>
              <p>
                단기적인 변화보다는 장기적인 트렌드와 구조적 변화에 
                집중하여 이해를 깊게 합니다.
              </p>
            </div>
          </div>
          <div class="approach-item">
            <div class="approach-number">04</div>
            <div class="approach-content">
              <h3>구조적 사고</h3>
              <p>
                표면적인 현상보다는 그 배경과 구조를 이해하는 
                사고력을 기르는 것을 목표로 합니다.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Community Stats Section -->
    <section class="section stats-section">
      <div class="container">
        <div class="stats-content">
          <h2 class="stats-title">함께 학습하는 커뮤니티</h2>
          <p class="stats-description">
            5,000명 이상의 회원이 다양한 관심사와 배경을 가지고 
            함께 학습하고 있습니다.
          </p>
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon">
                <i class="fas fa-users"></i>
              </div>
              <div class="stat-value">5,000+</div>
              <div class="stat-label">활성 회원</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">
                <i class="fas fa-calendar-alt"></i>
              </div>
              <div class="stat-value">15년</div>
              <div class="stat-label">관찰 경험</div>
            </div>
            <div class="stat-card">
              <div class="stat-icon">
                <i class="fas fa-file-alt"></i>
              </div>
              <div class="stat-value">매주</div>
              <div class="stat-label">자료 공유</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Join Section -->
    <section class="section benefits-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">참여 혜택</span>
          <h2 class="section-title">왜 이 커뮤니티에 참여해야 할까요?</h2>
        </div>
        <div class="benefits-list">
          <div class="benefit-item">
            <div class="benefit-icon">
              <i class="fas fa-check-circle"></i>
            </div>
            <div class="benefit-text">
              <h3>체계적인 트렌드 이해</h3>
              <p>
                비즈니스 트렌드와 변화를 체계적으로 이해하고 
                분석하는 방법을 학습할 수 있습니다.
              </p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-icon">
              <i class="fas fa-check-circle"></i>
            </div>
            <div class="benefit-text">
              <h3>다양한 관점의 교류</h3>
              <p>
                서로 다른 배경과 경험을 가진 회원들과의 
                의견 교류를 통해 시야를 넓힐 수 있습니다.
              </p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-icon">
              <i class="fas fa-check-circle"></i>
            </div>
            <div class="benefit-text">
              <h3>지속적인 학습 자료</h3>
              <p>
                정기적으로 업데이트되는 학습 자료와 
                분석 내용을 받아볼 수 있습니다.
              </p>
            </div>
          </div>
          <div class="benefit-item">
            <div class="benefit-icon">
              <i class="fas fa-check-circle"></i>
            </div>
            <div class="benefit-text">
              <h3>개인 맞춤 학습 지원</h3>
              <p>
                개인의 관심 분야와 학습 목표에 맞춘 
                방향 제시와 학습 지원을 받을 수 있습니다.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">지금 바로 시작하세요</h2>
          <p class="cta-description">
            비즈니스 트렌드를 함께 관찰하고 학습하는 커뮤니티에 참여하여,<br />
            변화하는 환경에 대한 이해를 깊게 해보세요.
          </p>
          <div class="cta-box">
            <CtaButton social={social} size="lg" class="cta-btn">
              <span slot="content">커뮤니티 참여하기</span>
            </CtaButton>
            <p class="cta-note">
              추가 후 7을 보내주시면 안내드립니다
            </p>
          </div>
          <div class="disclaimer-box">
            <p class="disclaimer-text">
              ※ 본 커뮤니티는 학습 및 정보 교류를 목적으로 하며, 
              어떠한 형태의 상업적 권유나 특정 서비스 추천을 포함하지 않습니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Info Section -->
    <section id="company" class="section company-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">회사 정보</span>
          <h2 class="section-title">회사 정보</h2>
        </div>
        <div class="company-info">
          <div class="info-row">
            <strong>회사명:</strong>
            <span>{companyInfo.name}</span>
            <span class="info-en">({companyInfo.nameEn})</span>
          </div>
          <div class="info-row">
            <strong>운영 내용:</strong>
            <span>{companyInfo.business}</span>
          </div>
          <div class="info-row">
            <strong>서비스 성격:</strong>
            <span>{companyInfo.serviceType}</span>
          </div>
          <div class="info-row">
            <strong>서비스 지역:</strong>
            <span>{companyInfo.serviceArea}</span>
          </div>
          <div class="info-row">
            <strong>주소:</strong>
            <span>{companyInfo.address}</span>
          </div>
          <div class="info-row">
            <strong>대표이사:</strong>
            <span>{companyInfo.ceo}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Policy Section -->
    <section id="privacy" class="section privacy-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">개인정보 보호</span>
          <h2 class="section-title">개인정보 보호 정책</h2>
        </div>
        <div class="policy-content">
          <p class="policy-intro">
            본 플랫폼은 사용자의 개인정보 보호를 중요하게 생각합니다.
          </p>
          <div class="policy-details">
            <h3>1. 개인정보 수집 및 이용</h3>
            <p>
              우리는 사용자가 자발적으로 제공하는 경우에만 필요한 정보를 수집하며,
              이는 커뮤니케이션, 콘텐츠 전송 및 서비스 개선을 위해 사용됩니다.
            </p>

            <h3>2. 개인정보 보호</h3>
            <p>
              수집된 정보는 내부적으로만 사용되며,
              어떠한 제3자에게도 판매, 공유 또는 공개되지 않습니다.
            </p>

            <h3>3. 보안 조치</h3>
            <p>
              플랫폼은 합리적인 기술 및 관리 조치를 통해
              사용자 정보의 안전성과 완전성을 보장합니다.
            </p>

            <h3>4. 사용자 권리</h3>
            <p>
              사용자는 언제든지 정보 수신 중단을 요청하거나
              관련 데이터 삭제를 요구할 수 있습니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Section -->
    <section id="disclaimer" class="section disclaimer-section">
      <div class="container">
        <div class="section-intro">
          <span class="section-label">면책 조항</span>
          <h2 class="section-title">면책 조항</h2>
        </div>
        <div class="disclaimer-content">
          <p>
            본 플랫폼에서 제공하는 모든 콘텐츠는 <strong>학습 및 참고 용도로만 제공</strong>되며,
            어떠한 형태의 조언, 약속 또는 보증을 구성하지 않습니다.
          </p>
          <p>
            사용자는 자신의 상황에 따라 독립적으로 판단하고 관련 책임을 부담해야 합니다.
          </p>
          <p>
            본 플랫폼의 정보를 사용하여 발생한 결과에 대해
            플랫폼은 어떠한 직접적 또는 간접적 책임도 지지 않습니다.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-brand">
            <span class="footer-logo">{name}</span>
            <span class="footer-tagline">비즈니스 트렌드 관찰자 · 학습 커뮤니티 운영</span>
          </div>
          <div class="footer-links">
            <a href="#company">회사 정보</a>
            <a href="#privacy">개인정보 보호</a>
            <a href="#disclaimer">면책 조항</a>
          </div>
        </div>
        <div class="footer-disclaimer">
          <p>
            본 웹사이트에서 제공하는 모든 정보 및 콘텐츠는 교육 및 정보 제공 목적으로만 사용되며,
            어떠한 형태의 상업적 권유나 특정 서비스 추천을 포함하지 않습니다.
            모든 자료는 공개 정보를 기반으로 한 참고 학습용이며,
            사용 결정 및 그에 따른 모든 책임은 사용자 본인에게 귀속됩니다.
          </p>
        </div>
        <div class="footer-bottom">
          <p>© 2025 {companyInfo.name}. All Rights Reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Fixed Bottom CTA -->
    <div class="fixed-cta">
      <CtaButton social={social} class="fixed-cta-btn">
        <span slot="content">커뮤니티 참여하기</span>
      </CtaButton>
    </div>

    <script is:inline>
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault()
          const target = document.querySelector(this.getAttribute('href'))
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            })
          }
        })
      })

      // Intersection Observer for animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px',
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in')
            observer.unobserve(entry.target)
          }
        })
      }, observerOptions)

      document.addEventListener('DOMContentLoaded', () => {
        const animateElements = document.querySelectorAll(
          '.activity-card, .approach-item, .benefit-item, .stat-card',
        )
        animateElements.forEach((el) => {
          el.style.opacity = '0'
          el.style.transform = 'translateY(30px)'
          el.style.transition = 'opacity 0.6s ease, transform 0.6s ease'
          observer.observe(el)
        })
      })

      const style = document.createElement('style')
      style.textContent = `
        .animate-in {
          opacity: 1 !important;
          transform: translateY(0) !important;
        }
      `
      document.head.appendChild(style)
    </script>
  </body>
</html>

