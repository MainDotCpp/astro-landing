---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(['柳秀真_0', '闵秀雅_0', '宣大仁_0', '朴斗焕_0', '廉承煥_0'])
}

const { t = '卡扣' } = Astro.params
const { name, img_prefix } = Astro.props as { name: string, img_prefix: string }

const posterImg = (await import(`../images/${img_prefix}poster.jpg`)).default
const headImg = (await import(`../images/${img_prefix}head.jpg`)).default
---

<KRBaseLayout title={`${name} · 100만 원으로 시작하는 무료 투자 커뮤니티`} description={`${name}과 함께하는 무료 주식 투자 소통방. 실시간 종목 정보와 투자 전략을 무료로 받아보세요.`}>
  <style is:global slot="head">
    :root {
      --bg: #0a0a0c;
      --bg-2: #131015;
      --panel: #1a1612;
      --line: rgba(212, 175, 95, 0.22);
      --gold: #e7c06a;
      --gold-2: #f7e3a1;
      --gold-dk: #b8893a;
      --red: #ff4d4d;
      --red-dk: #e02f2f;
      --ink: #f4efe6;
      --ink-soft: #b8b0a2;
      --ink-dim: #847c6f;
      --maxw: 480px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      padding-bottom: 96px;
      overflow-x: hidden;
      background:
        radial-gradient(900px 480px at 50% -5%, rgba(231, 192, 106, 0.16), transparent 60%),
        linear-gradient(180deg, var(--bg-2) 0%, var(--bg) 55%, #060507 100%);
      background-attachment: fixed;
      color: var(--ink);
      font-family: 'Pretendard', 'Noto Sans KR', -apple-system, sans-serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; -webkit-tap-highlight-color: transparent; }

    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 16px; }

    b { color: var(--gold-2); font-weight: 800; }

    .gold-text {
      background: linear-gradient(180deg, var(--gold-2) 0%, var(--gold) 45%, var(--gold-dk) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ---- hero ---- */
    .hero { padding: 26px 0 8px; text-align: center; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 16px;
      padding: 6px 15px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(231, 192, 106, 0.08);
      color: var(--gold);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .eyebrow .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 8px 1px var(--red);
      animation: blink 1.3s steps(2) infinite;
    }

    .poster {
      position: relative;
      display: block;
      margin: 0 auto;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 20px;
      box-shadow: 0 24px 60px -24px rgba(231, 192, 106, 0.35), 0 8px 26px rgba(0, 0, 0, 0.6);
      cursor: pointer;
    }

    .poster:active { transform: scale(0.99); }

    .poster img { width: 100%; height: auto; }

    .hero-title {
      margin: 24px 0 0;
      font-size: clamp(27px, 8.4vw, 38px);
      font-weight: 900;
      line-height: 1.25;
      letter-spacing: -0.02em;
    }

    .hero-title .big {
      display: inline-block;
      margin-top: 4px;
      font-size: 1.32em;
      line-height: 1.05;
    }

    .hero-sub {
      margin: 14px auto 0;
      max-width: 30ch;
      color: var(--ink-soft);
      font-size: 14.5px;
    }

    .hero-sub b { color: var(--red); }

    .hero-cta { margin-top: 22px; }

    .cta-note {
      margin: 12px auto 0;
      max-width: 28ch;
      color: var(--ink-dim);
      font-size: 12px;
    }

    /* ---- section frame ---- */
    .sec { padding: 38px 0 4px; }

    .sec-head { text-align: center; margin-bottom: 22px; }

    .sec-kicker {
      color: var(--gold);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.16em;
    }

    .sec-title {
      margin-top: 8px;
      font-size: clamp(21px, 6vw, 27px);
      font-weight: 900;
      letter-spacing: -0.01em;
    }

    .sec-title .gold-text { font-weight: 900; }

    /* ---- stats ---- */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .stat {
      padding: 18px 8px 16px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: linear-gradient(180deg, var(--panel) 0%, rgba(10, 10, 12, 0.9) 100%);
      text-align: center;
    }

    .stat .label {
      color: var(--ink-soft);
      font-size: 11px;
      font-weight: 600;
    }

    .stat .num {
      margin-top: 6px;
      font-size: clamp(26px, 9vw, 38px);
      font-weight: 900;
      line-height: 1;
    }

    .stat .unit { font-size: 0.5em; }

    .stat .sub {
      margin-top: 5px;
      color: var(--ink-dim);
      font-size: 10.5px;
    }

    /* ---- proof / testimonials ---- */
    .proof-list { display: grid; gap: 12px; }

    .proof {
      padding: 16px 16px 14px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel);
    }

    .proof-top {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .proof-av {
      display: grid;
      width: 38px; height: 38px;
      flex: 0 0 38px;
      place-items: center;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold), var(--gold-dk));
      color: #1a1206;
      font-size: 15px;
      font-weight: 900;
    }

    .proof-who b { display: block; color: var(--ink); font-size: 13.5px; font-weight: 700; }
    .proof-who span { color: var(--ink-dim); font-size: 11.5px; }

    .proof-badge {
      margin-left: auto;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(255, 77, 77, 0.14);
      color: var(--red);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .proof p {
      color: var(--ink-soft);
      font-size: 13px;
      line-height: 1.7;
    }

    .proof .stars { color: var(--gold); font-size: 12px; letter-spacing: 1px; margin-bottom: 6px; }

    /* ---- benefits ---- */
    .benefits { display: grid; gap: 11px; }

    .benefit {
      display: flex;
      gap: 13px;
      align-items: center;
      padding: 15px 16px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--panel);
    }

    .benefit .ic {
      display: grid;
      width: 44px; height: 44px;
      flex: 0 0 44px;
      place-items: center;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(231, 192, 106, 0.2), rgba(184, 137, 58, 0.12));
      color: var(--gold);
    }

    .benefit .ic svg { width: 22px; height: 22px; }
    .benefit h3 { font-size: 14.5px; font-weight: 800; }
    .benefit p { margin-top: 2px; color: var(--ink-soft); font-size: 12.5px; }

    /* ---- steps ---- */
    .steps { display: grid; gap: 0; }

    .step {
      display: flex;
      gap: 14px;
      padding: 15px 4px;
      border-bottom: 1px solid var(--line);
    }
    .step:last-child { border-bottom: 0; }

    .step .sn {
      display: grid;
      width: 30px; height: 30px;
      flex: 0 0 30px;
      place-items: center;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold), var(--gold-dk));
      color: #1a1206;
      font-size: 14px;
      font-weight: 900;
    }

    .step b { display: block; color: var(--ink); font-size: 14.5px; font-weight: 800; }
    .step p { margin-top: 2px; color: var(--ink-soft); font-size: 12.5px; }
    .step .num7 { color: var(--red); font-weight: 900; }

    /* ---- cta band ---- */
    .cta-band {
      margin-top: 34px;
      padding: 30px 20px 32px;
      border: 1px solid var(--line);
      border-radius: 22px;
      background:
        radial-gradient(600px 200px at 50% 0%, rgba(231, 192, 106, 0.18), transparent 70%),
        linear-gradient(180deg, var(--panel), rgba(10, 10, 12, 0.9));
      text-align: center;
    }

    .cta-band h2 {
      font-size: clamp(22px, 6.4vw, 30px);
      font-weight: 900;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }

    .cta-band p {
      margin: 12px auto 0;
      max-width: 30ch;
      color: var(--ink-soft);
      font-size: 13.5px;
    }

    .cta-band .hero-cta { margin-top: 20px; }

    /* ---- notice / footer ---- */
    .notice {
      margin: 28px 0 0;
      color: var(--ink-dim);
      font-size: 11px;
      line-height: 1.8;
      text-align: center;
    }

    .footer {
      margin-top: 26px;
      padding: 26px 0 34px;
      border-top: 1px solid var(--line);
      text-align: center;
    }

    .footer-title { color: var(--gold); font-size: 12.5px; font-weight: 800; }
    .footer p { margin-top: 8px; color: var(--ink-dim); font-size: 11.5px; line-height: 1.7; }

    .footer-links {
      display: flex; flex-wrap: wrap; gap: 8px 14px;
      align-items: center; justify-content: center;
      margin-top: 16px;
    }
    .footer-links a {
      color: var(--ink-soft); font-size: 12px;
      text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
    }
    .footer-links .sep { color: var(--line); }

    /* ---- sticky ---- */
    .sticky-cta {
      position: fixed;
      left: 0; right: 0; bottom: 0;
      z-index: 90;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 10px 14px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(6, 5, 7, 0) 0%, rgba(6, 5, 7, 0.96) 34%);
      backdrop-filter: blur(5px);
    }

    .sticky-hint {
      margin-bottom: 8px;
      color: var(--gold);
      font-size: 11.5px;
      font-weight: 700;
    }

    .sticky-cta .hero-cta { margin: 0; width: 100%; max-width: var(--maxw); }

    /* CtaButton 도금색 강조 (덮어쓰기) */
    .hero-cta :global(.cta-button),
    .hero-cta :global(a),
    .hero-cta :global(button) { width: 100%; }

    /* ---- modal ---- */
    .ov {
      position: fixed; inset: 0; z-index: 200;
      display: none; align-items: center; justify-content: center;
      padding: 20px; background: rgba(0, 0, 0, 0.78);
    }
    .ov.show { display: flex; }
    .mbox {
      position: relative; width: 100%; max-width: 520px; max-height: 80vh;
      overflow-y: auto; padding: 28px 22px 24px;
      border: 1px solid var(--line); border-radius: 18px; background: var(--bg-2);
    }
    .mclose {
      position: absolute; top: 12px; right: 14px;
      border: 0; background: none; color: var(--ink-soft);
      cursor: pointer; font-size: 26px; line-height: 1;
    }
    .mbox h3 { font-size: 17px; font-weight: 900; padding-right: 24px; color: var(--ink); }
    .mbody { margin-top: 14px; color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
    .mbody h4 { margin: 14px 0 4px; color: var(--gold); font-size: 13.5px; font-weight: 800; }
    .mbody ul { margin: 6px 0 6px 18px; }

    .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .reveal.in { opacity: 1; transform: none; }

    @keyframes blink { 50% { opacity: 0.25; } }

    @media (min-width: 520px) {
      :root { --maxw: 500px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>

  <main class="wrap">
    <!-- HERO -->
    <section class="hero">
      <span class="eyebrow"><span class="dot"></span>실제 회원 수익 인증</span>
      <a class="poster link-btn" href="javascript:void(0)" role="button" aria-label="무료로 입장하기">
        <Image src={posterImg} alt={`${name} 무료 투자 커뮤니티`} widths={[480, 960]} sizes="(max-width: 520px) 100vw, 500px" />
      </a>
      <h1 class="hero-title">
        단 <span class="gold-text">100만 원</span>으로 시작해
        <span class="big gold-text">일주일 만에 수억 원까지</span>
      </h1>
      <p class="hero-sub">
        실제 회원들이 직접 낸 수익이에요. <b>{name}</b> 소통방에서
        오늘의 종목과 매매 전략, 지금 <b>무료로</b> 받아보세요.
      </p>
      <div class="hero-cta">
        <CtaButton social={t} size="lg" />
      </div>
      <p class="cta-note">가입비·결제 없이 100% 무료 · 지금 바로 입장</p>
    </section>

    <!-- STATS -->
    <section class="sec reveal">
      <div class="sec-head">
        <p class="sec-kicker">REAL PERFORMANCE</p>
        <h2 class="sec-title">회원들이 만든 <span class="gold-text">진짜 숫자</span></h2>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="label">주간 목표 수익률</div>
          <div class="num gold-text">300<span class="unit">%</span></div>
          <div class="sub">단기 집중 전략</div>
        </div>
        <div class="stat">
          <div class="label">회원 평균 수익률</div>
          <div class="num gold-text">168<span class="unit">%</span></div>
          <div class="sub">월 누적 기준</div>
        </div>
        <div class="stat">
          <div class="label">연간 투자 수익률</div>
          <div class="num gold-text">330<span class="unit">%</span></div>
          <div class="sub">지난해 실적</div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="sec reveal">
      <div class="sec-head">
        <p class="sec-kicker">MEMBER REVIEW</p>
        <h2 class="sec-title">먼저 들어온 회원들의 후기</h2>
      </div>
      <div class="proof-list">
        <div class="proof">
          <div class="proof-top">
            <span class="proof-av">김</span>
            <div class="proof-who"><b>김** 회원</b><span>직장인 · 가입 2주차</span></div>
            <span class="proof-badge">+1,180만</span>
          </div>
          <div class="stars">★★★★★</div>
          <p>"반신반의하며 100만 원으로 시작했는데, 알려주신 종목 그대로 따라가니 2주 만에 진짜 +1,000 넘겼습니다. 매일 아침 정리해주셔서 초보도 따라가기 어렵지 않아요."</p>
        </div>
        <div class="proof">
          <div class="proof-top">
            <span class="proof-av">이</span>
            <div class="proof-who"><b>이** 회원</b><span>자영업 · 가입 1개월</span></div>
            <span class="proof-badge">+4,300만</span>
          </div>
          <div class="stars">★★★★★</div>
          <p>"혼자 할 때는 늘 고점에 물렸는데, 진입가랑 손절까지 딱딱 짚어주시니까 마음이 편하더라고요. 무료인 게 아직도 안 믿겨요 ㅎㅎ"</p>
        </div>
        <div class="proof">
          <div class="proof-top">
            <span class="proof-av">박</span>
            <div class="proof-who"><b>박** 회원</b><span>주부 · 가입 3주차</span></div>
            <span class="proof-badge">+920만</span>
          </div>
          <div class="stars">★★★★★</div>
          <p>"투자 진짜 처음이었는데 매니저님이 하나하나 챙겨주셔서 그냥 따라만 했어요. 작은 돈으로 시작해 조금씩 불려가는 재미가 쏠쏠합니다."</p>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="sec reveal">
      <div class="sec-head">
        <p class="sec-kicker">FREE BENEFITS</p>
        <h2 class="sec-title">입장하면 <span class="gold-text">무료로</span> 받는 것</h2>
      </div>
      <div class="benefits">
        <div class="benefit">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/></svg>
          </span>
          <div><h3>실시간 급등주 정보</h3><p>장 시작 전, 오늘 주목할 종목을 매일 정리해 공유</p></div>
        </div>
        <div class="benefit">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </span>
          <div><h3>진입가 · 손절 기준</h3><p>"얼마에 사고 어디서 끊을지"까지 함께 알려드려요</p></div>
        </div>
        <div class="benefit">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <div><h3>매니저 1:1 소통</h3><p>궁금한 종목은 채팅방에서 바로 질문하세요</p></div>
        </div>
        <div class="benefit">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <div><h3>초보도 따라가기 쉽게</h3><p>어려운 용어 없이 핵심만, 매일 같은 시간에</p></div>
        </div>
      </div>
    </section>

    <!-- STEPS -->
    <section class="sec reveal">
      <div class="sec-head">
        <p class="sec-kicker">HOW TO JOIN</p>
        <h2 class="sec-title">입장 방법, 30초면 끝</h2>
      </div>
      <div class="steps">
        <div class="step">
          <span class="sn">1</span>
          <div><b>아래 버튼 누르기</b><p>버튼을 누르면 입장 채널로 바로 연결돼요.</p></div>
        </div>
        <div class="step">
          <span class="sn">2</span>
          <div><b>채널 추가 후 숫자 <span class="num7">'7'</span> 전송</b><p>안내에 따라 숫자 7만 보내면 끝(채널별 안내 제공).</p></div>
        </div>
        <div class="step">
          <span class="sn">3</span>
          <div><b>소통방 입장</b><p>오늘의 종목 정보와 전략을 바로 받아보세요.</p></div>
        </div>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="cta-band reveal">
      <h2>지금 안 들어오면<br /><span class="gold-text">오늘의 종목</span>을 놓칩니다</h2>
      <p>시장은 매일 움직여요. 가입비도, 결제도 없이 지금 바로 무료로 입장하세요.</p>
      <div class="hero-cta">
        <CtaButton social={t} size="lg" />
      </div>
    </section>

    <p class="notice">
      ※ 본 콘텐츠에 표기된 수익률·후기는 일부 회원의 사례이며, 모든 회원의 수익을 보장하지 않습니다.
      주식 등 금융상품 투자에는 원금 손실의 위험이 있으며, 과거의 성과가 미래의 수익을 보장하지 않습니다.
      제공되는 정보는 일반적인 참고용이며, 투자 판단과 그 결과에 대한 책임은 이용자 본인에게 있습니다.
    </p>

    <footer class="footer">
      <p class="footer-title">운영 안내</p>
      <p>
        상호: 골든인사이트 커뮤니티 &nbsp;|&nbsp; 사업자 등록번호: 412-88-01735<br />
        주소: 서울특별시 영등포구 국제금융로 10, 23층 &nbsp;|&nbsp; 문의: help@goldeninsight.kr
      </p>
      <nav class="footer-links" aria-label="운영 정책">
        <a data-modal="privacy">개인정보 처리방침</a>
        <span class="sep">|</span>
        <a data-modal="terms">이용약관</a>
        <span class="sep">|</span>
        <a data-modal="disclaimer">투자 위험 고지</a>
      </nav>
    </footer>
  </main>

  <!-- STICKY CTA -->
  <div class="sticky-cta">
    <p class="sticky-hint">⚡ 오늘의 종목, 지금 무료로 받기</p>
    <div class="hero-cta">
      <CtaButton social={t} size="md" />
    </div>
  </div>

  <!-- MODAL -->
  <div class="ov" id="modal">
    <div class="mbox" role="dialog" aria-modal="true">
      <button class="mclose" type="button" aria-label="닫기">×</button>
      <h3 id="mt"></h3>
      <div class="mbody" id="mb"></div>
    </div>
  </div>

  <script is:inline>
    window.__lpModal = {
      privacy: {
        title: '개인정보 처리방침',
        body: `
          <p>본 커뮤니티(이하 "운영자")는 「개인정보 보호법」 등 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p>
          <h4>1. 수집 항목</h4><p>가입 시 닉네임, 연락 가능한 메신저 아이디 등 최소한의 정보만 수집합니다.</p>
          <h4>2. 이용 목적</h4><ul><li>커뮤니티 가입 및 멤버 관리</li><li>투자 정보 및 공지 전달</li><li>고객 문의 응대</li></ul>
          <h4>3. 보유 및 이용 기간</h4><p>이용 목적 달성 후 지체 없이 파기하며, 관련 법령에서 정한 기간 동안만 보관합니다.</p>
          <h4>4. 제3자 제공</h4><p>이용자의 사전 동의 없이 개인정보를 외부에 제공하지 않습니다. 단, 법령에 따른 요청이 있는 경우는 예외로 합니다.</p>
          <h4>5. 이용자의 권리</h4><p>이용자는 언제든지 본인의 개인정보 열람·정정·삭제·처리정지를 요청할 수 있습니다.</p>
          <h4>6. 문의처</h4><p>help@goldeninsight.kr</p>
        `,
      },
      terms: {
        title: '이용약관',
        body: `
          <p>본 약관은 커뮤니티 이용과 관련하여 운영자와 이용자 간의 권리·의무 및 책임 사항을 규정합니다.</p>
          <h4>제1조 (목적)</h4><p>본 커뮤니티는 주식 등 투자 정보 공유 및 교류를 목적으로 하는 무료 소통 모임입니다.</p>
          <h4>제2조 (이용자의 의무)</h4><ul><li>다른 회원을 존중하고 예의를 지킵니다.</li><li>허위 정보, 광고, 비방 등 운영을 방해하는 행위를 하지 않습니다.</li><li>제공되는 정보를 무단으로 외부에 배포하지 않습니다.</li></ul>
          <h4>제3조 (콘텐츠의 성격)</h4><p>제공되는 모든 정보는 일반적인 참고용이며, 특정 종목의 매수·매도를 권유하거나 수익을 보장하지 않습니다.</p>
          <h4>제4조 (책임의 한계)</h4><p>이용자는 본인의 판단과 책임 하에 정보를 이용하며, 투자 결과에 대한 책임은 이용자 본인에게 있습니다.</p>
          <h4>제5조 (서비스 변경·중단)</h4><p>운영자는 사정에 따라 운영 내용을 변경하거나 중단할 수 있습니다.</p>
        `,
      },
      disclaimer: {
        title: '투자 위험 고지',
        body: `
          <p>본 사이트와 커뮤니티에서 제공하는 모든 콘텐츠는 <b style="color:#f4efe6">교육 및 정보 제공 목적</b>으로 제공됩니다.</p>
          <h4>1. 수익률·후기 안내</h4><p>표기된 수익률과 회원 후기는 일부 사례이며, 모든 이용자의 동일한 수익을 보장하지 않습니다.</p>
          <h4>2. 투자 위험</h4><p>주식 등 금융상품 투자에는 원금 손실의 위험이 있으며, 과거의 성과가 미래의 수익을 보장하지 않습니다.</p>
          <h4>3. 책임의 한계</h4><p>제공되는 정보는 특정 금융상품의 매매 권유가 아니며, 모든 투자 판단과 그 결과에 대한 책임은 전적으로 이용자 본인에게 있습니다.</p>
          <p style="margin-top:14px;">※ 투자 전 본인의 투자 목적과 리스크 수용 능력을 충분히 고려하시기 바랍니다.</p>
        `,
      },
    }

    document.addEventListener('DOMContentLoaded', () => {
      const ov = document.getElementById('modal')
      const mt = document.getElementById('mt')
      const mb = document.getElementById('mb')
      const open = (k) => {
        const d = window.__lpModal[k]
        if (!d || !ov) return
        mt.textContent = d.title
        mb.innerHTML = d.body
        ov.classList.add('show')
        document.body.style.overflow = 'hidden'
      }
      const close = () => { ov.classList.remove('show'); document.body.style.overflow = '' }
      document.querySelectorAll('[data-modal]').forEach((el) => {
        el.addEventListener('click', (e) => { e.preventDefault(); open(el.getAttribute('data-modal')) })
      })
      ov?.querySelector('.mclose')?.addEventListener('click', close)
      ov?.addEventListener('click', (e) => { if (e.target === ov) close() })
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })

      const io = new IntersectionObserver((ents) => {
        ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target) } })
      }, { threshold: 0.1 })
      document.querySelectorAll('.reveal').forEach(el => io.observe(el))
    })
  </script>
</KRBaseLayout>
