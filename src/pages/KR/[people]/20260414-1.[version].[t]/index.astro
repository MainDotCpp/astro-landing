  <script is:inline>
    // Smooth ticker animation
    const ticker1 = document.getElementById('ticker1');
    const ticker2 = document.getElementById('ticker2');

    // Auto-update prices slightly for live effect
    setInterval(() => {
      const vals = document.querySelectorAll('.tick-val');
      vals.forEach(val => {
        let current = parseInt(val.innerText.replace(/,/g, ''));
        if(Math.random() > 0.5) {
          const change = Math.floor(Math.random() * 500) - 250;
          val.innerText = (current + change).toLocaleString();
        }
      });
    }, 4000);
  </script>

