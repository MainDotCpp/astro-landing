---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

// Move image imports here, before other code!
import bgHero from './static/images/bg-hero.png'
import bgAccent from './static/images/bg-accent.png'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
const dateStr = `${today.getFullYear()}년 ${today.getMonth() + 1}월 ${today.getDate()}일`
---

<KRBaseLayout title={`${name} — 프리미엄 투자 시그널`} description="최상위 1%를 위한 하이엔드 투자 분석과 실시간 시장 통찰력">
  <style is:global slot="head">
    @import url('https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Noto+Sans+KR:wght@300;400;500;700&display=swap');

    :root {
      --bg-deep: #0a0e17;
      --bg-surface: #121826;
      --bg-surface-light: #1b2436;
      --nav-bg: rgba(10, 14, 23, 0.85);

      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dark: #64748b;

      --gold: #D4AF37;
      --gold-glow: rgba(212, 175, 55, 0.3);
      --cyan: #00E5FF;
      --cyan-glow: rgba(0, 229, 255, 0.3);
      --red-up: #ef4444;
      --blue-down: #3b82f6;

      --border-thin: rgba(255, 255, 255, 0.08);
      --border-gold: rgba(212, 175, 55, 0.3);
      --border-cyan: rgba(0, 229, 255, 0.2);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-deep);
      color: var(--text-main);
      font-family: 'Noto Sans KR', sans-serif;
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    /* GLASSMORPHISM UTILS */
    .glass-panel {
      background: rgba(18, 24, 38, 0.6);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-thin);
      border-radius: 12px;
    }

    .gold-accent {
      color: var(--gold);
      text-shadow: 0 0 10px var(--gold-glow);
    }

    .cyan-accent {
      color: var(--cyan);
      text-shadow: 0 0 10px var(--cyan-glow);
    }

    /* HEADER */
    .luxe-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--nav-bg);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-thin);
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .luxe-logo {
      font-family: 'Nanum Myeongjo', serif;
      font-weight: 800;
      font-size: 16px;
      letter-spacing: 0.1em;
      color: var(--gold);
    }
    .luxe-date {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 300;
      letter-spacing: 0.05em;
    }

    /* HERO AREA */
    .luxe-hero {
      position: relative;
      padding: 60px 20px 40px;
      text-align: center;
      overflow: hidden;
    }
    .hero-bg-wrapper {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      z-index: -1;
      opacity: 0.6;
    }
    .hero-bg-wrapper img {
      width: 100%; height: 100%; object-fit: cover;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 100%);
    }
    .hero-kicker {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      color: var(--cyan);
      margin-bottom: 16px;
      font-weight: 500;
    }
    .hero-title {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 32px;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 0%, #a1a1aa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-muted);
      font-weight: 300;
      margin-bottom: 32px;
      padding: 0 10px;
    }

    /* TICKER */
    .luxe-ticker {
      background: linear-gradient(90deg, rgba(10,14,23,1) 0%, rgba(18,24,38,1) 50%, rgba(10,14,23,1) 100%);
      border-top: 1px solid var(--border-thin);
      border-bottom: 1px solid var(--border-thin);
      padding: 12px 0;
      display: flex;
      overflow: hidden;
      white-space: nowrap;
    }
    .ticker-content {
      display: inline-flex;
      gap: 30px;
      animation: luxe-scroll 20s linear infinite;
    }
    .tick-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .tick-name { font-size: 12px; font-weight: 500; color: #fff; }
    .tick-val { font-family: monospace; font-size: 13px; color: var(--text-muted); }
    .tick-change.up { color: var(--red-up); }
    .tick-change.down { color: var(--blue-down); }
    @keyframes luxe-scroll {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* MAIN CONTENT */
    .luxe-main {
      padding: 30px 20px;
    }

    /* EXPERT PROFILE */
    .expert-glass {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
    }
    .expert-glass::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background: linear-gradient(to bottom, var(--gold), var(--cyan));
    }
    .expert-img-wrap {
      width: 80px; height: 80px;
      border-radius: 50%;
      padding: 2px;
      background: linear-gradient(135deg, var(--gold), transparent, var(--cyan));
      flex-shrink: 0;
    }
    .expert-img {
      width: 100%; height: 100%;
      border-radius: 50%;
      object-fit: cover;
      background: var(--bg-deep);
    }
    .expert-role {
      font-size: 10px;
      letter-spacing: 0.15em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .expert-name {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }
    .expert-stats {
      display: flex;
      gap: 16px;
    }
    .stat-item {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .stat-num {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 16px;
      font-weight: 700;
      color: #fff;
    }
    .stat-lbl {
      font-size: 10px;
      color: var(--text-dark);
    }

    /* DATA VISUALIZATION AREA */
    .data-vis-section {
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-title::before {
      content: '';
      display: inline-block;
      width: 12px; height: 12px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan-glow);
    }
    .data-card {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 16px;
      border: 1px solid var(--border-thin);
    }
    .data-card img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      display: block;
      opacity: 0.7;
      transition: opacity 0.3s;
    }
    .data-card:hover img {
      opacity: 1;
    }
    .data-card-overlay {
      position: absolute;
      bottom: 0; left: 0; width: 100%;
      padding: 20px 16px 16px;
      background: linear-gradient(to top, rgba(10,14,23,0.95), transparent);
    }
    .data-card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--gold);
      margin-bottom: 4px;
    }
    .data-card-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* GRID INFO */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 30px;
    }
    .info-cell {
      padding: 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border-thin);
      border-radius: 8px;
      transition: transform 0.2s, background 0.2s;
    }
    .info-cell:hover {
      background: var(--bg-surface-light);
      transform: translateY(-2px);
      border-color: var(--border-gold);
    }
    .cell-icon {
      font-size: 18px;
      margin-bottom: 10px;
    }
    .cell-title {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 6px;
    }
    .cell-desc {
      font-size: 11px;
      line-height: 1.5;
      color: var(--text-dark);
    }

    /* QUOTE */
    .luxe-quote {
      text-align: center;
      padding: 40px 20px;
      background: radial-gradient(circle at center, var(--bg-surface-light) 0%, transparent 70%);
      margin-bottom: 30px;
      border-top: 1px solid var(--border-thin);
      border-bottom: 1px solid var(--border-thin);
    }
    .luxe-quote p {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 18px;
      font-style: italic;
      color: #fff;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .luxe-quote span {
      font-size: 11px;
      color: var(--gold);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* TABLE */
    .luxe-table-wrap {
      background: var(--bg-surface);
      border: 1px solid var(--border-thin);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 30px;
    }
    .luxe-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .luxe-table th {
      text-align: left;
      padding: 10px 4px;
      color: var(--text-dark);
      font-weight: 500;
      border-bottom: 1px solid var(--border-thin);
    }
    .luxe-table td {
      padding: 12px 4px;
      color: var(--text-main);
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    .luxe-table tr:last-child td { border-bottom: none; }
    .td-right { text-align: right; }
    .val-up { color: var(--red-up); font-weight: 700; }

    /* CTA AREA */
    .cta-box {
      position: relative;
      padding: 30px 20px;
      text-align: center;
      overflow: hidden;
      margin-bottom: 40px;
      border-radius: 16px;
      border: 1px solid var(--border-gold);
      background: linear-gradient(180deg, rgba(212,175,55,0.05) 0%, rgba(10,14,23,0) 100%);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);
    }
    .cta-glow {
      position: absolute;
      top: -50px; left: 50%; transform: translateX(-50%);
      width: 150px; height: 150px;
      background: var(--gold);
      filter: blur(80px);
      opacity: 0.15;
      z-index: 0;
      pointer-events: none;
    }
    .cta-box > * { position: relative; z-index: 1; }
    .cta-box h3 {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 24px;
      color: #fff;
      margin-bottom: 12px;
      font-weight: 800;
    }
    .cta-box p {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 24px;
    }
    .cta-safe {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 10px;
      color: var(--text-dark);
      margin-top: 16px;
    }

    /* FOOTER */
    .luxe-footer {
      padding: 40px 20px;
      text-align: center;
      border-top: 1px solid var(--border-thin);
      background: var(--bg-surface);
    }
    .footer-logo {
      font-family: 'Nanum Myeongjo', serif;
      font-size: 18px;
      color: var(--text-muted);
      margin-bottom: 12px;
      letter-spacing: 0.1em;
    }
    .footer-text {
      font-size: 10px;
      color: var(--text-dark);
      line-height: 1.6;
    }

    /* OVERRIDING BUTTON STYLES FOR LUXE FEEL */
    .link-btn {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 10px !important;
      width: 100% !important;
      background: linear-gradient(135deg, var(--gold) 0%, #b8962e 100%) !important;
      color: #0a0e17 !important;
      font-weight: 700 !important;
      border: none !important;
      border-radius: 8px !important;
      padding: 16px !important;
      font-size: 16px !important;
      text-align: center !important;
      box-shadow: 0 4px 15px var(--gold-glow), inset 0 1px 0 rgba(255,255,255,0.4) !important;
      transition: transform 0.2s, box-shadow 0.2s !important;
      text-decoration: none !important;
    }
    .link-btn:active {
      transform: scale(0.98) !important;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5) !important;
    }
  </style>

  <!-- HEADER -->
  <header class="luxe-header">
    <div class="luxe-logo">PRESTIGE <span style="color:#fff;">CAPITAL</span></div>
    <div class="luxe-date">{dateStr}</div>
  </header>

  <!-- HERO -->
  <section class="luxe-hero">
    <div class="hero-bg-wrapper">
      <img src={bgHero.src} alt="Financial Background" />
    </div>
    <div class="hero-kicker">Exclusive Market Intel</div>
    <h1 class="hero-title">상위 1%를 위한<br>프리미엄 투자 시그널</h1>
    <p class="hero-desc">
      기관 투자자의 매집 데이터와 AI 알고리즘이 포착한 압도적 상승률의 비밀. 지금 바로 확인하십시오.
    </p>
    <div style="max-width: 320px; margin: 0 auto; position: relative;">
      <CtaButton social={t as any} />
    </div>
  </section>

  <!-- TICKER -->
  <div class="luxe-ticker">
    <div class="ticker-content" id="ticker1">
      <div class="tick-item"><span class="tick-name">삼성전자</span> <span class="tick-val">84,500</span> <span class="tick-change up">▲ 2.4%</span></div>
      <div class="tick-item"><span class="tick-name">SK하이닉스</span> <span class="tick-val">192,000</span> <span class="tick-change up">▲ 4.1%</span></div>
      <div class="tick-item"><span class="tick-name">현대차</span> <span class="tick-val">245,500</span> <span class="tick-change up">▲ 1.8%</span></div>
      <div class="tick-item"><span class="tick-name">NAVER</span> <span class="tick-val">181,200</span> <span class="tick-change down">▼ 0.5%</span></div>
      <div class="tick-item"><span class="tick-name">카카오</span> <span class="tick-val">53,400</span> <span class="tick-change up">▲ 3.2%</span></div>
    </div>
    <div class="ticker-content" id="ticker2">
      <!-- Clone for seamless scroll -->
      <div class="tick-item"><span class="tick-name">삼성전자</span> <span class="tick-val">84,500</span> <span class="tick-change up">▲ 2.4%</span></div>
      <div class="tick-item"><span class="tick-name">SK하이닉스</span> <span class="tick-val">192,000</span> <span class="tick-change up">▲ 4.1%</span></div>
      <div class="tick-item"><span class="tick-name">현대차</span> <span class="tick-val">245,500</span> <span class="tick-change up">▲ 1.8%</span></div>
      <div class="tick-item"><span class="tick-name">NAVER</span> <span class="tick-val">181,200</span> <span class="tick-change down">▼ 0.5%</span></div>
      <div class="tick-item"><span class="tick-name">카카오</span> <span class="tick-val">53,400</span> <span class="tick-change up">▲ 3.2%</span></div>
    </div>
  </div>

  <main class="luxe-main">

    <!-- EXPERT -->
    <div class="glass-panel expert-glass">
      <div class="expert-img-wrap">
        <Image src={headImg} alt={name} class="expert-img" width={80} height={80} />
      </div>
      <div>
        <div class="expert-role">Chief Analyst</div>
        <div class="expert-name">{name}</div>
        <div class="expert-stats">
          <div class="stat-item"><span class="stat-num">18</span><span class="stat-lbl">년 경력</span></div>
          <div class="stat-item"><span class="stat-num">87%</span><span class="stat-lbl">평균 승률</span></div>
        </div>
      </div>
    </div>

    <!-- DATA VISUALIZATION -->
    <section class="data-vis-section">
      <h2 class="section-title">AI 딥러닝 트렌드 분석</h2>

      <div class="data-card">
        <img src={bgAccent.src} alt="Market Analysis Chart" />
        <div class="data-card-overlay">
          <div class="data-card-title">기관 외국인 쌍끌이 매집 패턴 포착</div>
          <div class="data-card-desc">대형 기술주 중심의 강력한 반등 시그널 확인. 거래량 동반한 저항선 돌파 임박.</div>
        </div>
      </div>
    </section>

    <!-- INFO GRID -->
    <div class="info-grid">
      <div class="info-cell">
        <div class="cell-icon">📈</div>
        <div class="cell-title">독점 정보망</div>
        <div class="cell-description">일반 투자자에게 공개되기 전 핵심 재료를 선점합니다.</div>
      </div>
      <div class="info-cell">
        <div class="cell-icon">⚡</div>
        <div class="cell-title">실시간 대응</div>
        <div class="cell-description">시장 변동성에 맞춘 정확한 매수/매도 타이밍.</div>
      </div>
      <div class="info-cell">
        <div class="cell-icon">🔒</div>
        <div class="cell-title">리스크 관리</div>
        <div class="cell-description">철저한 포트폴리오 분산과 손절매 원칙 준수.</div>
      </div>
      <div class="info-cell">
        <div class="cell-icon">💎</div>
        <div class="cell-title">VIP 전용</div>
        <div class="cell-description">엄선된 소수의 회원에게만 제공되는 프라이빗 서비스.</div>
      </div>
    </div>

    <!-- QUOTE -->
    <div class="luxe-quote">
      <p>"성공적인 투자는 타이밍과 정보력의 결합이다. 우리의 목표는 당신이 그 두 가지를 모두 갖추는 것이다."</p>
      <span>— {name} 대표 애널리스트</span>
    </div>

    <!-- TABLE -->
    <div class="luxe-table-wrap">
      <h3 style="font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 12px; display:flex; justify-content:space-between;">
        <span>최근 수익 실현 내역</span>
        <span class="gold-accent" style="font-size:11px;">VERIFIED</span>
      </h3>
      <table class="luxe-table">
        <thead>
          <tr>
            <th>종목명</th>
            <th class="td-right">매수가</th>
            <th class="td-right">매도가</th>
            <th class="td-right">수익률</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>에코프로머티</td>
            <td class="td-right">132,000</td>
            <td class="td-right">168,500</td>
            <td class="td-right val-up">+27.6%</td>
          </tr>
          <tr>
            <td>한미반도체</td>
            <td class="td-right">86,500</td>
            <td class="td-right">112,000</td>
            <td class="td-right val-up">+29.4%</td>
          </tr>
          <tr>
            <td>알테오젠</td>
            <td class="td-right">154,000</td>
            <td class="td-right">241,000</td>
            <td class="td-right val-up">+56.4%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- FINAL CTA -->
    <div class="cta-box">
      <div class="cta-glow"></div>
      <h3>내일 급등할 VVIP 종목<br>지금 바로 확인하세요</h3>
      <p>
        상위 1% 투자자들만이 공유하는 시크릿 포트폴리오. 더 이상 감에 의존하지 마십시오. 데이터가 증명합니다.
      </p>
      <CtaButton social={t as any} />
      <div class="cta-safe">
        <span>🔒 100% 무료 제공</span>
        <span>·</span>
        <span>언제든 해지 가능</span>
      </div>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="luxe-footer">
    <div class="footer-logo">PRESTIGE CAPITAL</div>
