---
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'

import headImg from './static/images/5122.jpg'
import headImgXdr from '../images/xdr_head.jpg'
import bannerXdr1 from '../images/xdr_banner1.jpg'
import bannerXdr2 from '../images/xdr_banner2.jpg'
import headImgMxy from '../images/mxy_head.jpg'
import bannerMxy1 from '../images/mxy_banner1.jpg'
import bannerMxy2 from '../images/mxy_banner2.jpg'
import headImgLch from '../images/lch_head.jpg'
import bannerLch1 from '../images/lch_banner1.jpg'
import bannerLch2 from '../images/lch_banner2.jpg'
import bandIcon from './static/images/band.png'
import kakaoIcon from '@/assets/kakao-icon.png'
import banner1 from './static/images/banner1.jpg'
import banner2 from './static/images/banner2.jpg'
import banner3 from './static/images/banner3.jpg'

export function getStaticPaths() {
  const xdrBase = generateKrConfig('宣大仁_0').filter(p => p.params.t === '卡扣' || p.params.t === '棒群')
  const xdrKaqun = xdrBase
    .filter(p => p.params.t === '卡扣')
    .map(p => ({ ...p, params: { ...p.params, t: '卡群' } }))
  const mxyBase = generateKrConfig('闵秀雅_0').filter(p => p.params.t === '卡扣' || p.params.t === '棒群')
  const mxyKaqun = mxyBase
    .filter(p => p.params.t === '卡扣')
    .map(p => ({ ...p, params: { ...p.params, t: '卡群' } }))
  const lchBase = generateKrConfig('廉承煥_0').filter(p => p.params.t === '卡扣' || p.params.t === '棒群')
  const lchKaqun = lchBase
    .filter(p => p.params.t === '卡扣')
    .map(p => ({ ...p, params: { ...p.params, t: '卡群' } }))
  return [
    ...generateKrConfig('朴斗焕_0'),
    ...xdrBase,
    ...xdrKaqun,
    ...mxyBase,
    ...mxyKaqun,
    ...lchBase,
    ...lchKaqun,
  ]
}

const { name, img_prefix } = Astro.props
const { t } = Astro.params
const isXdr = img_prefix === 'xdr_'
const isMxy = img_prefix === 'mxy_'
const isLch = img_prefix === 'lch_'
const hasCustomBanner = isXdr || isMxy || isLch
const profileImg = isLch ? headImgLch : isMxy ? headImgMxy : isXdr ? headImgXdr : headImg
const bannerA = isLch ? bannerLch1 : isMxy ? bannerMxy1 : isXdr ? bannerXdr1 : banner1
const bannerB = isLch ? bannerLch2 : isMxy ? bannerMxy2 : isXdr ? bannerXdr2 : banner2

// 底部悬浮按钮按路由渠道适配平台（卡扣/卡群=카카오톡, 棒群=BAND）
const isBand = t === '棒群'
const isKakaoGroup = t === '卡群'
const secondIcon = isBand ? bandIcon : kakaoIcon
const secondIconAlt = isBand ? 'BAND 아이콘' : '카카오톡 아이콘'
const secondLabel = isBand
  ? 'BAND를 무료로 추가하고 최신 주가 급등 정보를 받아보세요.'
  : isKakaoGroup
    ? '카카오톡 오픈채팅에 무료로 입장하고 최신 주가 급등 정보를 받아보세요.'
    : '카카오톡을 무료로 추가하고 최신 주가 급등 정보를 받아보세요.'
---

<KRBaseLayout title={name} description="무료 주식 투자 커뮤니티">
  <style is:global slot="head">
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #0f1424 0%, #181f34 45%, #2b3550 100%);
        font-family: 'Inter', 'Noto Sans KR', Arial, sans-serif;
        color: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .page-card {
        width: 100%;
        max-width: 800px;
        background: rgba(255, 255, 255, 0.96);
        border-radius: 32px;
        box-shadow: 0 32px 90px rgba(0, 0, 0, 0.24), 0 8px 32px rgba(0, 0, 0, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.45);
        overflow: hidden;
        padding: 32px;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .image-container {
        width: 118px;
        height: 118px;
        margin: 0 auto 24px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid #f7d18f;
        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.16), 0 8px 16px rgba(247, 209, 143, 0.2);
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
    }

    .image-container:hover {
        transform: scale(1.05);
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .text-container {
        text-align: center;
        margin-bottom: 32px;
        padding: 0 12px;
    }

    .text-container h1 {
        font-size: 2.2rem;
        margin: 0 0 14px;
        color: #111;
        letter-spacing: -0.04em;
        line-height: 1.1;
        background: linear-gradient(135deg, #111 0%, #3c3c3c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .text-container p {
        margin: 0;
        font-size: 1rem;
        line-height: 1.85;
        color: #3c3c3c;
        text-align: justify;
        white-space: pre-wrap;
        letter-spacing: 0.3px;
    }

    .banner {
        display: block;
        width: 100%;
        margin: 28px 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .banner:hover {
        transform: translateY(-2px);
        box-shadow: 0 26px 52px rgba(0, 0, 0, 0.26);
    }

    .banner img {
        width: 100%;
        height: auto;
        display: block;
    }

    .text-container .button {
        margin-top: 26px;
    }

    .button, .second-button {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 16px 22px;
        font-size: 18px;
        font-weight: 700;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        box-shadow: 0 18px 36px rgba(39, 51, 79, 0.18);
    }

    .button {
        background: linear-gradient(91deg, #f8e29e 0%, #d6a14c 42%, #8d6838 100%);
        color: #1f1f1f;
    }

    .button:hover,
    .button:focus {
        transform: translateY(-2px);
        box-shadow: 0 28px 56px rgba(39, 51, 79, 0.32);
        opacity: 1;
    }

    .second-button {
        background: linear-gradient(135deg, #14151e 0%, #1a1b2e 100%);
        color: #fff;
        gap: 12px;
        padding: 16px 20px;
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        max-width: 680px;
        z-index: 1000;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .second-button:hover,
    .second-button:focus {
        transform: translateX(-50%) translateY(-2px);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5), 0 4px 12px rgba(0, 0, 0, 0.3);
        opacity: 1;
    }

    .second-button img {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .second-button img:hover {
        transform: scale(1.1);
    }

    @media (max-width: 700px) {
        body {
            padding: 16px;
            padding-bottom: 120px;
        }

        .page-card {
            padding: 24px;
            border-radius: 28px;
        }

        .image-container {
            width: 104px;
            height: 104px;
            margin-bottom: 20px;
        }

        .text-container h1 {
            font-size: 1.9rem;
        }

        .text-container p {
            font-size: 0.98rem;
            line-height: 1.8;
        }

        .button {
            font-size: 16px;
            padding: 14px 18px;
        }

        .second-button {
            font-size: 14px;
            padding: 12px 16px;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            max-width: calc(100% - 32px);
        }

        .second-button img {
            width: 38px;
            height: 38px;
        }
    }

    @media (min-width: 701px) {
        body {
            padding-bottom: 140px;
        }
    }
  </style>

  <div class="page-card">
    <div class="image-container">
      <img src={profileImg.src} alt={`${name} 프로필 이미지`} />
    </div>

    <div class="text-container">
      <h1>{name}</h1>
      <p>저는 무료로 주식 동호인 교류 그룹을 만들었습니다. 1주일 만에 1,000만 원에서 수억 원을 번 신규 회원도 있었고, 5월 말까지 절반 이상의 회원이 목표인 주간 수익률 300%를 달성했다. 전체 회원의 평균 주간 복리 수익률은 무려 168%에 달했다.</p>

      <a class="banner link-btn" onclick="onLinkBtnClick()">
        <img src={bannerA.src} alt={hasCustomBanner ? `${name} 투자 인사이트 — 무료 입장` : 'VIP 투자 인사이트 — 수익을 만드는 투자 기준, 무료 BAND 입장'} />
      </a>

      <p>평소에도 자산의 일부를 쪼개어 주식에 투자하고 있는데, 작년 한 해만 해도 주식 투자 수익률이 330%나 되었기 때문에 내 투자 전략으로 수익을 낼 수 있다고 믿는다.</p>

      <a class="banner link-btn" onclick="onLinkBtnClick()">
        <img src={bannerB.src} alt={hasCustomBanner ? `${name} 최신 투자 정보 — 무료 입장` : '지난해 투자 수익률 330% — 최신 투자 정보 무료 제공, 무료 BAND 입장'} />
      </a>

      <p>투자를 시작하기로 결정한 분이나 투자를 하고 있는 분들에게 도움이 되고자 무료 투자 소통방을 개설했는데, 그 대화방에서 저의 투자전략을 매니저를 통해 안정적으로 수익을 낼 수 있으니 도움이 되었으면 좋겠습니다. 저의 투자전략을 배우고 싶은 분은 저의 대화방에 가입하여 투자전략과 최신 급등 종목에 대한 정보를 무료로 공유할 수 있도록 숫자 '7'을 매니저에게 보내주세요. 버튼을 클릭하여 지금 바로 무료로 가입하세요!</p>

      {!hasCustomBanner && (
        <a class="banner link-btn" onclick="onLinkBtnClick()">
          <img src={banner3.src} alt="성공한 투자자들이 조용히 모이는 곳 — VIP 투자 인사이트, 무료 입장" />
        </a>
      )}

      <button class="button link-btn" onclick="onLinkBtnClick()">특별한 투자 정보를 전해드립니다!</button>
    </div>
  </div>

  <button class="second-button link-btn" onclick="onLinkBtnClick()">
    <img src={secondIcon.src} alt={secondIconAlt} />
    {secondLabel}
  </button>
</KRBaseLayout>
