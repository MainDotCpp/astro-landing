---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'
import briefSheet from './assets/brief-0731.jpg'
import heroDawn from './assets/hero-dawn.jpg'

export function getStaticPaths() {
  return generateKrConfig(['廉承煥_0'])
}

const { t = '卡扣' } = Astro.params
const { name, img_prefix } = Astro.props as { name: string, img_prefix: string }

const headImg = (await import(`../images/${img_prefix}head.jpg`)).default

const isBand = t === '棒群'
const needNumber = t === '卡扣'
const channelName = isBand ? '밴드' : '카카오톡'
const ctaNote = needNumber
  ? '무료 · 1분이면 끝납니다'
  : isBand
    ? '무료 · 밴드 가입, 1분이면 끝납니다'
    : '무료 · 오픈채팅방 바로 입장'
const roomWord = isBand ? '밴드' : '방'

const step2 = isBand
  ? '밴드 가입하기'
  : needNumber
    ? '카카오톡 채널 추가하기'
    : '오픈채팅방 입장하기'
const step3 = isBand
  ? '눈팅만 해도 됩니다'
  : needNumber
    ? '채팅창에 \'7\' 한 글자만 보내기'
    : '인사도 자기소개도 필요 없습니다'
---

<KRBaseLayout
  title={`7월 31일, 하루에 +17.91% | ${name} 무료 투자 커뮤니티`}
  description="코스피가 하루에 17.91% 오른 날, 대부분의 개인 계좌는 그 자리에 없었습니다. 그날 무슨 일이 있었는지 한 장으로 정리했습니다."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700;900&family=Noto+Sans+KR:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap"
  />

  <style is:global slot="head" define:vars={{ dawnImg: `url(${heroDawn.src})` }}>
    :root {
      --paper: #fbfaf7;
      --card: #ffffff;
      --ink: #16181c;
      --mut: #55595f;
      --dim: #8b8f95;
      --rule: #e2e0da;
      --rule-2: #efeee9;
      --up: #c0392f;
      --deep: #0e1218;
      --serif: 'Noto Serif KR', Georgia, serif;
      --sans: 'Pretendard', 'Noto Sans KR', -apple-system, sans-serif;
      --mono: 'IBM Plex Mono', ui-monospace, monospace;
      --maxw: 520px;
      --gap: 20px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      background: var(--paper);
      color: var(--ink);
      font-size: 16px;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      word-break: keep-all;
      padding-bottom: calc(92px + env(safe-area-inset-bottom));
    }

    img { display: block; max-width: 100%; }
    a { color: inherit; -webkit-tap-highlight-color: transparent; }
    ::selection { background: var(--up); color: #fff; }
    :focus-visible { outline: 2px solid var(--up); outline-offset: 3px; }

    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gap); }

    /* ================= HERO ================= */
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100svh;
      padding-top: calc(env(safe-area-inset-top) + 40px);
      padding-bottom: calc(108px + env(safe-area-inset-bottom));
      background-image:
        linear-gradient(
          180deg,
          rgba(10, 14, 20, 0.5) 0%,
          rgba(10, 14, 20, 0.28) 26%,
          rgba(10, 14, 20, 0.66) 62%,
          rgba(10, 14, 20, 0.95) 100%
        ),
        var(--dawnImg);
      background-size: cover, cover;
      background-position: center, 50% 50%;
      background-repeat: no-repeat;
      color: #f5f3ef;
    }

    .stamp {
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      color: rgba(245, 243, 239, 0.68);
    }

    .hero h1 {
      margin-top: 16px;
      font-family: var(--serif);
      font-weight: 700;
      font-size: clamp(2.1rem, 9.4vw, 2.9rem);
      line-height: 1.24;
      letter-spacing: -0.035em;
    }

    .hero .lede {
      margin-top: 16px;
      font-size: 15.5px;
      line-height: 1.72;
      color: rgba(245, 243, 239, 0.84);
    }
    .hero .lede b { color: #fff; font-weight: 700; }

    .hero .cta-slot { margin-top: 26px; }
    .cta-slot :global(a),
    .cta-slot :global(button) { width: 100%; }
    .cta-note {
      margin-top: 10px;
      font-size: 12.5px;
      text-align: center;
      color: rgba(245, 243, 239, 0.6);
    }

    .figs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid rgba(245, 243, 239, 0.2);
    }
    .figs .v {
      font-family: var(--mono);
      font-weight: 600;
      font-size: clamp(15px, 4.7vw, 19px);
      letter-spacing: -0.04em;
      line-height: 1.15;
      white-space: nowrap;
    }
    .figs .v.pos { color: #ff8a7a; }
    .figs .k {
      margin-top: 5px;
      font-size: 11.5px;
      line-height: 1.4;
      color: rgba(245, 243, 239, 0.6);
    }
    .src {
      margin-top: 16px;
      font-size: 11px;
      color: rgba(245, 243, 239, 0.44);
    }

    /* ================= 본문 ================= */
    .sec { padding: 54px 0; }
    .sec + .sec { border-top: 1px solid var(--rule-2); }

    .kicker {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--dim);
    }

    h2 {
      margin-top: 12px;
      font-family: var(--serif);
      font-weight: 700;
      font-size: clamp(1.5rem, 6.4vw, 1.85rem);
      line-height: 1.36;
      letter-spacing: -0.035em;
    }

    .sec p { margin-top: 16px; color: var(--mut); font-size: 15.5px; }
    .sec p b { color: var(--ink); font-weight: 700; }

    /* 시트: 이 페이지의 주인공 */
    .sheet { margin: 0; padding: 46px 0 54px; background: #efece5; }
    .sheet .wrap { max-width: 460px; }
    .sheet-head { text-align: center; margin-bottom: 22px; }
    .sheet-head h2 { margin-top: 10px; }
    .sheet figure { margin: 0; }
    .sheet img {
      width: 100%;
      border-radius: 2px;
      box-shadow: 0 18px 44px rgba(20, 16, 10, 0.22);
    }
    .sheet figcaption {
      margin-top: 18px;
      font-size: 13px;
      line-height: 1.65;
      color: #7a7469;
      text-align: center;
    }

    /* 인물 */
    .who { display: grid; grid-template-columns: 92px 1fr; gap: 18px; align-items: center; }
    .who img { width: 92px; border-radius: 2px; }
    .who-name { font-family: var(--serif); font-size: 22px; font-weight: 700; letter-spacing: -0.03em; }
    .who-role { margin-top: 3px; font-size: 13px; color: var(--dim); line-height: 1.5; }

    /* 반대매매 추이 */
    .esc {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px 9px;
      margin-top: 22px;
      font-family: var(--mono);
      font-weight: 600;
      font-size: 16px;
    }
    .esc i { font-style: normal; color: #c9c5bc; }
    .esc .s1 { color: #a9a49a; }
    .esc .s2 { color: #b0857a; }
    .esc .s3 { color: #bf6355; }
    .esc .s4 { color: var(--up); font-size: 21px; }
    .esc-cap { margin-top: 8px; font-size: 12.5px; color: var(--dim); }

    /* 참여 */
    .steps { margin-top: 22px; counter-reset: s; }
    .step {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--rule-2);
      counter-increment: s;
    }
    .step::before {
      content: counter(s);
      font-family: var(--mono);
      font-size: 12.5px;
      font-weight: 600;
      color: var(--up);
      padding-top: 4px;
    }
    .step p { margin: 0; font-size: 15.5px; color: var(--ink); }

    .sec .cta-slot { margin-top: 28px; }
    .sec .cta-note { color: var(--dim); }

    /* 하단 */
    .notice { padding: 34px 0 22px; font-size: 11.5px; line-height: 1.75; color: #9b9690; }
    .footer { padding: 20px 0 30px; border-top: 1px solid var(--rule); font-size: 11.5px; line-height: 1.8; color: #9b9690; }
    .footer-title { font-size: 12px; font-weight: 700; color: var(--dim); margin-bottom: 6px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .footer-links a {
      color: var(--mut);
      font-size: 12px;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .footer-links .sep { color: var(--rule); }

    /* 스티키 */
    .sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      padding: 10px var(--gap) calc(11px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(251, 250, 247, 0) 0%, rgba(251, 250, 247, 0.97) 40%);
      backdrop-filter: blur(6px);
    }
    .sticky-in { max-width: var(--maxw); margin: 0 auto; }
    .sticky-hint { margin-bottom: 7px; font-size: 12.5px; color: var(--dim); text-align: center; }
    .sticky-in :global(a),
    .sticky-in :global(button) { width: 100%; }

    /* 모달 */
    .ov {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(14, 18, 24, 0.76);
    }
    .ov.show { display: flex; }
    .mbox {
      position: relative;
      width: 100%;
      max-width: 520px;
      max-height: 80vh;
      overflow-y: auto;
      padding: 26px 20px 22px;
      border: 1px solid var(--rule);
      background: var(--card);
    }
    .mclose {
      position: absolute;
      top: 8px;
      right: 12px;
      border: 0;
      background: none;
      color: var(--mut);
      cursor: pointer;
      font-size: 26px;
      line-height: 1;
    }
    .mbox h3 { font-family: var(--serif); font-size: 17px; font-weight: 700; padding-right: 24px; }
    .mbody { margin-top: 12px; color: var(--mut); font-size: 13.5px; line-height: 1.8; }
    .mbody h4 { margin: 13px 0 3px; color: var(--ink); font-size: 13.5px; font-weight: 700; }
    .mbody ul { margin: 5px 0 5px 17px; }

    .rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
    .rv.in { opacity: 1; transform: none; }

    @media (min-width: 600px) {
      :root { --maxw: 560px; --gap: 26px; }
      .sec { padding: 70px 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
      .rv { opacity: 1; transform: none; }
    }
  </style>

  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="wrap">
      <p class="stamp">2026.07.31 · KOSPI</p>

      <h1>그날, 내 계좌만<br />비어 있었다</h1>

      <p class="lede">
        29일에 반대매매로 털렸거나, 손절하고 나왔거나, 아직 물려서 못 팔고 있거나, 아예 앱을 지웠거나.
        이유는 달라도 결과는 하나였습니다. <b>시장이 하루 만에 17.91% 오른 날, 그 자리에 없었다는 것.</b>
      </p>

      <div class="cta-slot">
        <CtaButton social={t} size="lg" />
      </div>
      <p class="cta-note">{ctaNote}</p>

      <div class="figs">
        <div>
          <p class="v pos">+17.91%</p>
          <p class="k">코스피 일간<br />사상 최대</p>
        </div>
        <div>
          <p class="v">8.79조</p>
          <p class="k">외국인 순매수<br />역대 최대</p>
        </div>
        <div>
          <p class="v">5,665</p>
          <p class="k">이틀 전<br />장중 저점</p>
        </div>
      </div>

      <p class="src">출처: 한국거래소·언론 보도 (2026년 7월 29일 · 31일 기준)</p>
    </div>
  </header>

  <!-- ============ 인물 ============ -->
  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">운영자</p>
      <div class="who" style="margin-top:16px">
        <Image src={headImg} alt={name} widths={[92, 184]} sizes="92px" loading="lazy" />
        <div>
          <div class="who-name">{name}</div>
          <div class="who-role">현직 증권맨<br />개미 눈높이 시장 해설</div>
        </div>
      </div>
      <p>
        장 열기 전에 봐야 할 것, 수급이 돌아서는 지점, 오늘 제가 보고 있는 지표.
        <b>매일 아침 7시 40분</b>, 아래 같은 한 장으로 {roomWord}에 올립니다.
      </p>
    </div>
  </section>

  <!-- ============ 브리프 시트 (주인공) ============ -->
  <section class="sheet rv">
    <div class="wrap">
      <div class="sheet-head">
        <p class="kicker">2026.07.31 브리프</p>
        <h2>그날 아침에 나간 한 장</h2>
      </div>
      <figure>
        <Image
          src={briefSheet}
          alt="2026년 7월 31일 코스피 +17.91%, 외국인 순매수 8조 7,927억, 반대매매 1,422억이 적힌 모닝 브리프 인쇄물"
          widths={[460, 920]}
          sizes="(max-width: 600px) 100vw, 460px"
          loading="lazy"
        />
        <figcaption>
          숫자 세 줄과 설명 세 문장. 이걸 그날 아침에 본 사람과<br />
          며칠 뒤 뉴스로 본 사람의 계좌가 갈렸습니다.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ 왜 ============ -->
  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">구조</p>
      <h2>멘탈이 약해서가<br />아니었습니다</h2>

      <div class="esc" aria-label="반대매매 규모 추이">
        <span class="s1">71억</span><i>›</i>
        <span class="s2">262억</span><i>›</i>
        <span class="s3">527억</span><i>›</i>
        <span class="s4">1,422억</span>
      </div>
      <p class="esc-cap">작년 말 · 3월 · 6월은 일평균, 7월 9일은 하루 기준</p>

      <p>
        7월 한 달에 코스피가 <b>22.19%</b> 빠졌습니다. 월중 최대 낙폭은 <b>34.01%</b>.
        1997년 외환위기가 27.25%, 2008년 금융위기가 23.13%였으니 그 둘을 다 넘었습니다.
      </p>
      <p>
        빚내서 산 계좌는 방향이 맞아도 시간을 못 견딥니다.
        종목 보는 눈이 없어서 당한 게 아닙니다. 흔들릴 때 옆에서 같은 화면을 보는 사람이 없었던 게 컸습니다.
      </p>
    </div>
  </section>

  <!-- ============ 지금 ============ -->
  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">지금</p>
      <h2>7월은 끝났습니다.<br />문제는 다음입니다</h2>
      <p>
        31일 반등은 하루 만에 끝났습니다. 그날 화면을 안 보고 있던 사람은 그냥 지나갔습니다.
      </p>
      <p>
        코스피는 8월 7일 <b>6,258</b>에 마감했습니다. 증권사 8월 예상 밴드는 <b>5,500에서 8,000</b>.
        위아래로 2,500포인트가 열려 있습니다. 다음 신호도 하루짜리일 겁니다.
      </p>
    </div>
  </section>

  <!-- ============ 참여 ============ -->
  <section class="sec rv">
    <div class="wrap">
      <p class="kicker">참여 방법</p>
      <h2>{channelName}, 3단계면 끝</h2>
      <div class="steps">
        <div class="step"><p>아래 버튼 누르기</p></div>
        <div class="step"><p>{step2}</p></div>
        <div class="step"><p>{step3}</p></div>
      </div>

      <div class="cta-slot">
        <CtaButton social={t} size="lg" />
      </div>
      <p class="cta-note">참가비 없습니다. 카드 정보도 안 받습니다.</p>
    </div>
  </section>

  <div class="wrap">
    <p class="notice">
      ※ 본 페이지에 인용된 지수·수급·반대매매 수치는 언론 보도 기준이며, 집계 시점과 기관에 따라 차이가 있을 수 있습니다.
      제공되는 정보는 일반적인 참고용이며, 특정 종목의 매수·매도를 권유하지 않고 수익을 보장하지 않습니다.
      주식 등 금융상품 투자에는 원금 손실 위험이 있고 과거 성과가 미래 수익을 보장하지 않습니다.
      투자 판단과 그 결과에 대한 책임은 이용자 본인에게 있습니다.
    </p>

    <footer class="footer">
      <p class="footer-title">운영 안내</p>
      <p>
        상호: 골든인사이트 커뮤니티 &nbsp;|&nbsp; 사업자 등록번호: 412-88-01735<br />
        주소: 서울특별시 영등포구 국제금융로 10, 23층 &nbsp;|&nbsp; 문의: help@goldeninsight.kr
      </p>
      <nav class="footer-links" aria-label="운영 정책">
        <a data-modal="privacy" tabindex="0" role="button">개인정보 처리방침</a>
        <span class="sep">|</span>
        <a data-modal="terms" tabindex="0" role="button">이용약관</a>
        <span class="sep">|</span>
        <a data-modal="disclaimer" tabindex="0" role="button">투자 위험 고지</a>
      </nav>
    </footer>
  </div>

  <div class="sticky">
    <div class="sticky-in">
      <p class="sticky-hint">내일 아침 브리프부터 받기</p>
      <CtaButton social={t} size="md" />
    </div>
  </div>

  <div class="ov" id="modal">
    <div class="mbox" role="dialog" aria-modal="true">
      <button class="mclose" type="button" aria-label="닫기">×</button>
      <h3 id="mt"></h3>
      <div class="mbody" id="mb"></div>
    </div>
  </div>

  <script is:inline>
    window.__lpModal = {
      privacy: {
        title: '개인정보 처리방침',
        body: `
          <p>본 커뮤니티 운영자(이하 "운영자")는 「개인정보 보호법」 등 관련 법령을 준수하며, 이용자의 개인정보를 안전하게 관리합니다.</p>
