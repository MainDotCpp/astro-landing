---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
const dateStr = `${today.getFullYear()}.${String(today.getMonth() + 1).padStart(2, '0')}.${String(today.getDate()).padStart(2, '0')}`
---

<KRBaseLayout title={`Insight / ${name} Analyst`} description="정제된 데이터, 명확한 분석. 상위 투자자를 위한 데일리 리포트.">
  <style is:global slot="head">
    @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,600&display=swap');

    :root {
      --bg: #ffffff;
      --text: #111111;
      --text-mute: #666666;
      --accent: #8b0000; /* Deep burgundy */
      --line: #e5e5e5;
      --line-dark: #111111;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Pretendard', sans-serif;
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 60px;
    }

    /* TYPOGRAPHY */
    .serif {
      font-family: 'Playfair Display', serif;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    /* GRID & LAYOUT */
    .wrapper {
      padding: 0 24px;
    }

    .border-top { border-top: 1px solid var(--line-dark); }
    .border-bottom { border-bottom: 1px solid var(--line-dark); }
    .border-thin-bottom { border-bottom: 1px solid var(--line); }

    /* HEADER */
    .header {
      padding: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .brand {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .date-vol {
      text-align: right;
      font-size: 11px;
      color: var(--text-mute);
      letter-spacing: 0.02em;
    }

    /* HERO */
    .hero {
      padding: 40px 24px 48px;
    }
    .label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 16px;
      display: block;
    }
    .headline {
      font-size: 32px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.03em;
      margin-bottom: 24px;
      word-break: keep-all;
    }
    .subheadline {
      font-size: 15px;
      color: var(--text-mute);
      line-height: 1.7;
      word-break: keep-all;
      margin-bottom: 40px;
    }

    /* EXPERT MOD */
    .expert-module {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 24px;
    }
    .expert-img {
      width: 48px;
      height: 48px;
      border-radius: 0; /* Square for editorial look */
      object-fit: cover;
      filter: grayscale(100%) contrast(1.1); /* Black and white photo */
    }
    .expert-detail .name {
      font-size: 14px;
      font-weight: 700;
    }
    .expert-detail .title {
      font-size: 11px;
      color: var(--text-mute);
    }

    /* CONTENT SECTIONS */
    .section {
      padding: 40px 24px;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 24px;
      padding-bottom: 12px;
    }
    .section-title {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .section-idx {
      font-family: 'Playfair Display', serif;
      color: var(--text-mute);
      font-style: italic;
    }

    /* DATA LIST */
    .data-list {
      list-style: none;
    }
    .data-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
    }
    .data-col-1 {
      flex: 1;
    }
    .data-name {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .data-desc {
      font-size: 12px;
      color: var(--text-mute);
    }
    .data-col-2 {
      text-align: right;
    }
    .data-price {
      font-size: 15px;
      font-weight: 500;
      color: var(--text);
    }
    .data-change {
      font-size: 12px;
      font-weight: 600;
    }
    .up { color: var(--accent); }
    .down { color: var(--text-mute); }

    /* QUOTE (EDITORIAL PULL QUOTE) */
    .pull-quote {
      padding: 48px 32px;
      text-align: center;
      background: #f9f9f9;
      margin: 24px 0;
    }
    .pull-quote-text {
      font-size: 20px;
      line-height: 1.6;
      font-weight: 600;
      margin-bottom: 16px;
      word-break: keep-all;
    }
    .pull-quote-mark {
      font-family: 'Playfair Display', serif;
      font-size: 40px;
      color: var(--accent);
      line-height: 0;
      display: block;
      margin-bottom: 24px;
    }

    /* KEY POINTS */
    .point-item {
      margin-bottom: 24px;
    }
    .point-num {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 4px;
    }
    .point-text {
      font-size: 14px;
      color: var(--text);
      line-height: 1.6;
    }

    /* CTA AREA */
    .cta-container {
      padding: 40px 24px;
      background: #f9f9f9;
    }
    .cta-headline {
      font-size: 20px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 24px;
      letter-spacing: -0.02em;
    }
    .cta-note {
      font-size: 11px;
      text-align: center;
      color: var(--text-mute);
      margin-top: 16px;
      line-height: 1.6;
    }

    /* BUTTON OVERRIDE */
    .link-btn {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 12px !important;
      width: 100% !important;
      background: var(--text) !important;
      color: var(--bg) !important;
      font-weight: 600 !important;
      border: none !important;
      border-radius: 0 !important; /* Sharp corners */
      padding: 18px !important;
      font-size: 15px !important;
      letter-spacing: 0.05em !important;
      text-transform: uppercase !important;
      transition: background-color 0.2s !important;
      text-decoration: none !important;
      box-shadow: none !important;
      animation: none !important;
    }
    .link-btn:active {
      background: var(--accent) !important;
    }

    /* Target inner span explicitly because BaseCtaButton gives it an explicit color */
    .link-btn .cta-text {
      color: var(--bg) !important;
      text-shadow: none !important;
    }

    .link-btn::before, .link-btn::after {
      display: none !important;
    }

    /* FOOTER */
    .footer {
      padding: 40px 24px;
      text-align: center;
    }
    .footer p {
      font-size: 11px;
      color: var(--text-mute);
      line-height: 1.6;
    }
  </style>

  <!-- HEADER -->
  <header class="header border-bottom">
    <div class="brand">Market Insight</div>
    <div class="date-vol">
      <div>Vol. 402</div>
      <div>{dateStr}</div>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero border-bottom">
    <span class="label">Daily Briefing</span>
    <h1 class="headline">단기 변동성을 돌파할<br>폭등 예정 3선 선공개</h1>
    <p class="subheadline">
      상위 1%의 정보력. 외국인과 기관의 자본 흐름을 역추적하여 내일 아침 가장 강하게 돋보일 핵심 종목을 마감 직전 선별했습니다.
    </p>

    <!-- EXPERT INFO -->
    <div class="expert-module border-top">
      <Image src={headImg} alt={name} class="expert-img" width={48} height={48} />
      <div class="expert-detail">
        <div class="name">{name}</div>
        <div class="title">Chief Equity Analyst</div>
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <div class="pull-quote border-bottom">
    <span class="pull-quote-mark">“</span>
    <h2 class="pull-quote-text">
      수익은 예측하는 것이 아닌 대응에서 나옵니다. 지금 당장 포트폴리오를 구출할 가장 확실한 가이드라인을 제시해 드립니다.
    </h2>
  </div>

  <!-- HIGHLIGHT DATA -->
  <section class="section border-bottom">
    <div class="section-head border-thin-bottom">
      <h3 class="section-title">Focus Equities</h3>
      <span class="section-idx">01</span>
    </div>

    <ul class="data-list">
      <li class="data-row border-thin-bottom">
        <div class="data-col-1">
          <div class="data-name">삼성전자</div>
          <div class="data-desc">반도체 수급 불균형 수혜</div>
        </div>
        <div class="data-col-2">
          <div class="data-price">84,500</div>
          <div class="data-change up">+ 2.4%</div>
        </div>
      </li>
      <li class="data-row border-thin-bottom">
        <div class="data-col-1">
          <div class="data-name">SK하이닉스</div>
          <div class="data-desc">차세대 메모리 패권</div>
        </div>
        <div class="data-col-2">
          <div class="data-price">192,000</div>
          <div class="data-change up">+ 4.1%</div>
        </div>
      </li>
      <li class="data-row">
        <div class="data-col-1">
          <div class="data-name">NAVER</div>
          <div class="data-desc">플랫폼 고도화 모멘텀</div>
        </div>
        <div class="data-col-2">
          <div class="data-price">181,200</div>
          <div class="data-change down">- 0.5%</div>
        </div>
      </li>
    </ul>
  </section>

  <!-- METHODOLOGY -->
  <section class="section border-bottom">
    <div class="section-head border-thin-bottom">
      <h3 class="section-title">Analysis Approach</h3>
      <span class="section-idx">02</span>
    </div>

    <div class="point-item">
      <div class="point-num">01 / DATA DRIVEN</div>
      <div class="point-text">
        자체 개발한 알고리즘 시그널을 바탕으로 글로벌 매크로 지표와 기업 펀더멘털을 교차 검증합니다.
      </div>
    </div>
    <div class="point-item">
      <div class="point-num">02 / RISK PARITY</div>
      <div class="point-text">
        단일 섹터에 과도하게 집중되지 않도록 포트폴리오 가중치를 배분하여 철저하게 하방 리스크를 통제합니다.
      </div>
    </div>
    <div class="point-item">
      <div class="point-num">03 / TIMING</div>
      <div class="point-text">
        기관과 외국인의 수급이 유입되기 직전의 변곡점을 선행하여 포착, 정확한 매수 타점을 제시합니다.
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-container border-bottom">
    <h3 class="cta-headline">지금 친구 추가 시 제공되는 혜택</h3>

    <div class="point-item" style="margin-bottom: 32px">
      <div class="point-num">BENEFIT 01.</div>
      <div class="point-text" style="font-weight: 600;">내일 아침 시초가 공략 3선 즉시 발송</div>
    </div>

    <div class="point-item" style="margin-bottom: 32px">
      <div class="point-num">BENEFIT 02.</div>
      <div class="point-text" style="font-weight: 600;">보유 종목 무료 진단 및 손절/목표가 컨설팅</div>
    </div>

    <div class="point-item" style="margin-bottom: 32px">
      <div class="point-num">BENEFIT 03.</div>
      <div class="point-text" style="font-weight: 600;">실시간 매수/매도 VIP 알림방 평생 무료 초대</div>
    </div>

    <CtaButton social={t as any} />
    <div class="cta-note">
      선착순 100명 한정 무료 제공<br>(신청 마감 시 알림 없이 종료될 수 있습니다)
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <p>
      Market Insight | 대표: {name} | 발행일: {dateStr}<br><br>
      이 문서에 포함된 정보는 신뢰할 만한 자료를 바탕으로 작성되었으나, 그 정확성이나 무결성을 보장하지 않습니다.
      모든 투자 결정에 대한 최종적인 책임은 투자자 본인에게 있습니다.
    </p>
  </footer>

</KRBaseLayout>
