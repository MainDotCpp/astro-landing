---
import { Image } from 'astro:assets'
import CtaButton from '@/components/CtaButton.astro'
import KRBaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig, Filters } from '@/utils/kr_config'

export function getStaticPaths() {
  return generateKrConfig(Filters.byVersion(0), undefined, { requireImages: ['head'] })
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../images/${img_prefix}head.jpg`)

const today = new Date()
const dateStr = `${today.getFullYear()}.${String(today.getMonth() + 1).padStart(2, '0')}.${String(today.getDate()).padStart(2, '0')}`
---

<KRBaseLayout title={`[SIGNATURE] ${name} 대표 특별 포트폴리오`} description="VVIP를 위한 하이엔드 자산 관리 솔루션">
  <style is:global slot="head">
    @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Noto+Serif+KR:wght@300;400;600&display=swap');

    :root {
      /* Warm Alabaster & Pearl */
      --bg: #FDFBFA;
      --bg-alt: #FFFFFF;

      /* Rich Inks */
      --text-main: #1A1C20;
      --text-muted: #6B6862;
      --navy: #0A1426;

      /* Signature Gold */
      --gold-light: #F2E3C6;
      --gold-main: #C2A470;
      --gold-dark: #8F7243;

      --border: rgba(194, 164, 112, 0.2);
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Pretendard', sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      word-break: keep-all;
    }

    .app-container {
      max-width: 540px;
      margin: 0 auto;
      background: var(--bg-alt);
      min-height: 100vh;
      box-shadow: 0 0 50px rgba(10, 20, 38, 0.03);
      position: relative;
    }

    /* Typographic Helpers */
    .serif-kr {
      font-family: 'Noto Serif KR', serif;
    }
    .serif-en {
      font-family: 'Cinzel', serif;
    }

    /* Header */
    .header {
      padding: 2rem 2rem 1rem;
      text-align: center;
      background: var(--bg-alt);
    }

    .brand-mark {
      font-size: 1.2rem;
      letter-spacing: 0.2em;
      color: var(--navy);
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .brand-mark::after {
      content: '';
      width: 24px;
      height: 1px;
      background: var(--gold-main);
    }

    /* Hero */
    .hero {
      padding: 3rem 2rem 4rem;
      text-align: center;
      position: relative;
    }

    .hero-badge {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.15em;
      color: var(--gold-dark);
      margin-bottom: 2rem;
      text-transform: uppercase;
      font-weight: 500;
      border: 1px solid var(--border);
      padding: 0.4rem 1rem;
      border-radius: 20px;
      background: var(--bg);
    }

    .hero-title {
      font-size: 2.2rem;
      font-weight: 300;
      line-height: 1.4;
      margin-bottom: 1.5rem;
      color: var(--navy);
    }

    .hero-title strong {
      font-weight: 600;
    }

    .hero-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.8;
      font-weight: 400;
      margin: 0 auto;
    }

    /* Gallery Style Portrait */
    .portrait-section {
      padding: 0 2rem 2rem;
    }

    .portrait-frame {
      width: 100%;
      /* The "Arch" window shape - very elegant, avoids the "memorial" square look */
      border-radius: 140px 140px 0 0;
      overflow: hidden;
      position: relative;
      background: var(--gold-light);
      padding: 4px 4px 0 4px;
      box-shadow: 0 20px 40px rgba(194, 164, 112, 0.15);
    }

    .portrait-inner {
      border-radius: 136px 136px 0 0;
      overflow: hidden;
      position: relative;
      background: var(--bg);
      aspect-ratio: 3/4;
    }

    .portrait-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Vibrant, rich colors, maybe slightly warm but NOT grayscale */
      filter: contrast(105%) saturate(110%);
      transform: scale(1.02);
    }

    .portrait-meta {
      text-align: center;
      padding: 2.5rem 0 1rem;
    }

    .portrait-name {
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 0.5rem;
    }

    .portrait-title {
      font-size: 0.85rem;
      color: var(--gold-dark);
      letter-spacing: 0.1em;
    }

    /* Elegant Stats Display */
    .metrics-board {
      display: flex;
      margin: 0 2rem 4rem;
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 2rem 0;
      position: relative;
    }

    /* Decorative corners */
    .metrics-board::before,
    .metrics-board::after {
      content: '';
      position: absolute;
      width: 6px;
      height: 6px;
      border: 1px solid var(--gold-main);
    }
    .metrics-board::before { top: 4px; left: 4px; border-right: none; border-bottom: none; }
    .metrics-board::after { bottom: 4px; right: 4px; border-left: none; border-top: none; }

    .metric-item {
      flex: 1;
      text-align: center;
    }

    .metric-item:first-child {
      border-right: 1px solid var(--border);
    }

    .metric-value {
      font-size: 2.8rem;
      color: var(--navy);
      margin-bottom: 0.5rem;
      line-height: 1;
    }

    .metric-value span {
      font-size: 1.2rem;
      color: var(--gold-dark);
    }

    .metric-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    /* Portfolio Section - "Private Menu" style */
    .portfolio-section {
      padding: 0 2rem 4rem;
    }

    .section-header {
      margin-bottom: 2.5rem;
      text-align: center;
    }

    .section-header h2 {
      font-size: 1.3rem;
      color: var(--navy);
      font-weight: 400;
      margin-bottom: 0.5rem;
      letter-spacing: 0.05em;
    }

    .section-header p {
      font-size: 0.85rem;
      color: var(--gold-dark);
      letter-spacing: 0.1em;
    }

    .item-card {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border);
      position: relative;
      transition: padding-left 0.3s ease;
    }

    .item-card:hover {
      padding-left: 1rem;
    }

    .item-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 0;
      background: var(--gold-main);
      transition: height 0.3s ease;
    }

    .item-card:hover::before {
      height: 50%;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.8rem;
    }

    .item-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--navy);
    }

    .item-blur {
      display: inline-block;
      min-width: 50px;
      height: 1.2rem;
      background: var(--gold-light);
      border-radius: 2px;
      vertical-align: middle;
      margin-left: 0.5rem;
      position: relative;
      overflow: hidden;
    }

    .item-blur::after {
      content: 'CONFIDENTIAL';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 0.5rem;
      color: var(--gold-dark);
      letter-spacing: 0.2em;
    }

    .item-badge {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--gold-dark);
      background: rgba(194, 164, 112, 0.1);
      padding: 0.3rem 0.6rem;
      letter-spacing: 0.05em;
    }

    .item-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Final Message */
    .philosophy {
      background: var(--navy);
      color: var(--bg);
      padding: 4rem 2rem;
      text-align: center;
    }

    .philosophy p {
      font-size: 1.15rem;
      line-height: 2.2;
      font-weight: 300;
      margin: 0;
    }

    .philosophy strong {
      color: var(--gold-main);
      font-weight: 400;
    }

    /* Action Panel */
    .action-panel {
      position: sticky;
      bottom: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(10px);
      padding: 1.5rem 2rem 2.5rem;
      border-top: 1px solid var(--border);
      z-index: 100;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.03);
    }

    .action-note {
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 1.2rem;
    }

    .action-note span {
      color: var(--gold-dark);
      font-weight: 600;
      border-bottom: 1px solid var(--gold-dark);
      padding-bottom: 2px;
    }

    /* Premium Override for Default Kakao/Band Buttons */
    :global(body) :global(.cta-button) {
      width: 100% !important;
      font-family: 'Pretendard', sans-serif !important;
      border-radius: 4px !important; /* Sharp elegant corners */
      height: 4.5rem !important;
    }

    :global(body) :global(.cta-button-kakao), :global(body) :global(.cta-button-band) {
      background: var(--navy) !important;
      color: var(--gold-main) !important;
      box-shadow: none !important;
      border: 1px solid var(--gold-main) !important;
      transition: all 0.4s ease-out !important;
    }

    :global(body) :global(.cta-button-kakao::after), :global(body) :global(.cta-button-band::after),
    :global(body) :global(.cta-button-kakao::before), :global(body) :global(.cta-button-band::before) {
      display: none !important; /* Remove glossy effects */
    }

    :global(body) :global(.cta-button-kakao:hover), :global(body) :global(.cta-button-band:hover) {
      background: var(--gold-main) !important;
      color: var(--bg) !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 15px 30px rgba(194, 164, 112, 0.2) !important;
      border-color: var(--gold-main) !important;
    }

    :global(body) :global(.cta-button-kakao:active), :global(body) :global(.cta-button-band:active) {
      transform: translateY(0) scale(0.99) !important;
      box-shadow: none !important;
    }

    :global(body) :global(.cta-button-kakao .cta-text), :global(body) :global(.cta-button-band .cta-text) {
      font-weight: 500 !important;
      letter-spacing: 0.1em !important;
      text-shadow: none !important;
      color: inherit !important;
    }

    :global(body) :global(.cta-icon) {
      /* Make the Kakao/Band icons monochrome gold/navy to match the theme */
      filter: brightness(0) saturate(100%) invert(73%) sepia(21%) saturate(735%) hue-rotate(3deg) brightness(96%) contrast(90%) !important;
      transition: filter 0.4s ease !important;
    }

    :global(body) :global(.cta-button-kakao:hover .cta-icon), :global(body) :global(.cta-button-band:hover .cta-icon) {
      filter: brightness(0) saturate(100%) invert(3%) sepia(10%) saturate(6743%) hue-rotate(185deg) brightness(94%) contrast(90%) !important;
    }
  </style>

  <div class="app-container">
    <header class="header">
      <div class="brand-mark serif-en">SIGNATURE WEALTH</div>
    </header>

    <section class="hero">
      <div class="hero-badge">VVIP Private Edition</div>
      <h1 class="hero-title serif-kr">
        격이 다른 자본의<br/>
        <strong>프라이빗 시그널</strong>
      </h1>
      <p class="hero-desc">
        상위 0.1%만이 향유하는 정제된 정보.<br/>
        완벽하게 통제된 데이터로 당신의 자산을 재설계합니다.
      </p>
    </section>

    <!-- Vibrant, Elegant Portrait inside an Arch -->
    <section class="portrait-section">
      <div class="portrait-frame">
        <div class="portrait-inner">
          <Image src={headImg} alt={name} width={600} height={800} />
        </div>
      </div>
      <div class="portrait-meta">
        <h2 class="portrait-name serif-kr">{name} <span style="font-size:1.1rem; font-weight:400;">대표</span></h2>
        <div class="portrait-title">시그니처 자산운용 수석 전략가</div>
      </div>
    </section>

    <section class="metrics-board">
      <div class="metric-item">
        <div class="metric-value serif-en">87.4<span>%</span></div>
        <div class="metric-label">연간 누적 알고리즘 승률</div>
      </div>
      <div class="metric-item">
        <div class="metric-value serif-en">Top 1<span>%</span></div>
        <div class="metric-label">기관 수익률 극상위 랭크</div>
      </div>
    </section>

    <section class="portfolio-section">
      <div class="section-header">
        <h2 class="serif-kr">시크릿 포트폴리오</h2>
        <p class="serif-en">TARGET SELECTION : 03 / 26</p>
      </div>

      <div class="item-card">
        <div class="item-header">
          <div class="item-title">차세대 AI 반도체<span class="item-blur"></span></div>
          <div class="item-badge">전략 매집형</div>
        </div>
        <div class="item-desc">
          글로벌 HBM 벤더사 진입 완료. 외국인 자본 5거래일 연속 집중 유입으로 강력한 상승 동력 확보.
        </div>
      </div>

      <div class="item-card">
        <div class="item-header">
          <div class="item-title">전고체 배터리 소재<span class="item-blur"></span></div>
          <div class="item-badge">가치 돌파형</div>
        </div>
        <div class="item-desc">
          비밀 유지 계약(NDA) 해제 직전. 스마트 머니의 바닥권 대량 매집 시그널이 시스템에 완전 포착됨.
        </div>
      </div>

      <div class="item-card">
        <div class="item-header">
          <div class="item-title">양자암호 통신<span class="item-blur"></span></div>
          <div class="item-badge">모멘텀 극대형</div>
        </div>
        <div class="item-desc">
          독점적 시장 지배력 확보. 알고리즘 상 역사적 신고가를 돌파하는 초기 수급 패턴 완성.
        </div>
      </div>
    </section>

    <section class="philosophy">
      <p class="serif-kr">
        우리는 시류에 흔들리지 않습니다.<br/><br/>
        오직 <strong>검증된 데이터와 압도적인 수익률</strong>이<br/>
        우리가 증명하는 유일한 가치입니다.
      </p>
    </section>

    <div class="action-panel">
      <div class="action-note">
        자산의 품격을 높일 특별한 기회, <span>소수 한정 VIP석</span>만 배정됩니다.
      </div>
      <CtaButton social={t} />
    </div>
  </div>
</KRBaseLayout>
