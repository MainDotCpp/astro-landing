---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { MessageCircle } from 'lucide-astro'
import CtaButton from '@/components/CtaButton.astro'

import { Button } from '@/components/ui/button'
import BaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'
// Import simple CSS
import './static/css/simple.css'

export function getStaticPaths() {
  return generateKrConfig(undefined, undefined, { requireImages: ['head', 'header', 'img1'] })
}

const { t = '棒群' } = Astro.params
const { img_prefix, name } = Astro.props

const headImg = import(`../../images/${img_prefix}head.jpg`)
const img1Img = import(`../../images/${img_prefix}img1.jpg`)
---

<BaseLayout title={`${name} - 투자 전문가`} description={`${name}과 함께하는 투자 여정`}>
  <div class="simple-page">

    <!-- Avatar -->
    <div class="avatar-section">
      <Image src={headImg} alt={name} class="avatar" />
    </div>

    <!-- Title -->
    <h1 class="title">{name} 투자 전문가</h1>

    <!-- Description -->
    <div class="description">
      <p class="intro-text">
        <strong>15년 투자 경력의 검증된 전문가</strong>와 함께<br >
        당신의 자산을 <span class="highlight">3배 이상 늘려보세요!</span>
      </p>

      <div class="benefits">
        <h3 class="benefits-title">나를 친구 추가하면 얻을 수 있는 것들:</h3>
        <ul class="benefits-list">
          <li>✅ <strong>월 평균 25% 수익률</strong> 달성 가능한 투자 신호</li>
          <li>✅ <strong>실시간 매매 타이밍</strong> 알림으로 손실 최소화</li>
          <li>✅ <strong>개인 맞춤형 포트폴리오</strong> 무료 설계 서비스</li>
          <li>✅ <strong>24시간 투자 상담</strong> 및 질의응답 지원</li>
          <li>✅ <strong>검증된 투자 노하우</strong> 전수로 장기 수익 보장</li>
        </ul>
      </div>

          <!-- Image -->
    <div class="content-image w-full flex justify-center">
      <Image src={img1Img} alt="투자 성과" class="main-image w-full" />
    </div>


      <div class="success-stats">
        <div class="stat-item">
          <span class="stat-number">+847%</span>
          <span class="stat-label">최고 수익률</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">89%</span>
          <span class="stat-label">성공률</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">12430명</span>
          <span class="stat-label">만족 고객</span>
        </div>
      </div>

      <p class="urgency-text">
        <span class="urgent">⚡ 지금 친구 추가하면</span><br >
        <strong>오늘의 급상승 예상 종목 정보를</strong><br >
        <span class="highlight">무료로 즉시 받아보세요!</span>
      </p>
    </div>


    <!-- Button -->
    <div class="cta-section w-full flex justify-center fixed bottom-8 left-0 right-0">
     <CtaButton social={t} />
    </div>

  </div>
</BaseLayout>
