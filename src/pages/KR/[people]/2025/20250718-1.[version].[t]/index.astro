---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { Award, BarChart3, Clock, DollarSign, MessageCircle, Phone, Shield, Target, TrendingUp } from 'lucide-astro'
import CtaButton from '@/components/CtaButton.astro'
import BaseLayout from '@/layouts/KRBaseLayout.astro'
import { generateKrConfig } from '@/utils/kr_config'
// Import CSS files
import '@/styles/globals.css'
import './static/css/style2.css'
import './static/css/animate.min.css'
import './static/css/slick-theme.css'

export function getStaticPaths() {
 return generateKrConfig(undefined, undefined, { requireImages: ['head', 'header', 'img1'] })
}

const { t = '棒群' } = Astro.params
const { img_prefix, name } = Astro.props
const headImg = import(`../../images/${img_prefix}head.jpg`)
const headerImg = import(`../../images/${img_prefix}header.jpg`)
const img1Img = import(`../../images/${img_prefix}img1.jpg`)
---


<BaseLayout title={`${name} 주식투자`} description={`${name} 주식투자 전문가`}>
  <style>
    .hero-section {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(251, 191, 36, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }
    .expert-card-modern {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), 0 8px 30px rgba(0, 0, 0, 0.3);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .expert-card-modern:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 12px 40px rgba(0, 0, 0, 0.4);
      border-color: rgba(251, 191, 36, 0.4);
    }
    .service-card {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-top: 4px solid transparent;
    }
    .service-card:hover {
      transform: translateY(-8px) scale(1.02);
      border-top-color: currentColor;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    }
    .intro-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 250, 252, 0.98) 100%);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      transition: all 0.3s ease;
    }
    .intro-card:hover {
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
      transform: translateY(-4px);
    }
    .trust-card {
      background: linear-gradient(135deg, rgba(249, 250, 251, 0.95) 0%, rgba(241, 245, 249, 0.95) 100%);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }
    .trust-card:hover {
      transform: scale(1.02);
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
    }
    .cta-section-modern {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 50%, #1e40af 100%);
      position: relative;
      overflow: hidden;
    }
    .cta-section-modern::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image:
        radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 70% 70%, rgba(255, 255, 255, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }
    .cta-card-gradient {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.15) 100%);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }
    .cta-card-gradient:hover {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0.25) 100%);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    .feature-icon-wrapper {
      transition: all 0.3s ease;
    }
    .feature-item:hover .feature-icon-wrapper {
      transform: scale(1.1) rotate(5deg);
    }
    @media (max-width: 768px) {
      .expert-card-modern {
        padding: 1.5rem;
      }
      .service-card {
        margin-bottom: 1.5rem;
      }
    }
  </style>
  <div class="min-h-screen bg-slate-900">
        {/* Hero Section */}
    <section class="hero-section text-white py-16 md:py-24 px-4 relative z-10">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          {/* Left Content */}
          <div>
            <div class="flex items-center gap-2 mb-6">
              <DollarSign class="h-6 w-6 md:h-7 md:w-7 text-yellow-400" />
              <span class="text-yellow-400 font-medium text-lg md:text-xl">주식투자 전문가</span>
            </div>

            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-white leading-tight">
              매일 기대되는 상승 종목, 편하게 받아보세요!
            </h1>

            <p class="text-xl md:text-2xl lg:text-3xl mb-10 text-blue-200 leading-relaxed">
              친구 추가만 해두시면, 매일 기대해볼 만한 종목을 편하게 받아보실 수 있어요.
              요즘 어떤 주식을 사야 할지 고민되신다면, 언제든지 편하게 문의 주세요.
              함께 투자도 배우고 자산도 천천히 키워가보아요!
            </p>

            {/* Features */}
            <div class="space-y-6 mb-10">
              <div class="feature-item flex items-start gap-4 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="feature-icon-wrapper">
                  <BarChart3 class="h-7 w-7 md:h-8 md:w-8 text-yellow-400 mt-1" />
                </div>
                <span class="text-blue-100 text-lg md:text-xl lg:text-2xl">매일 상승 가능성 높은 종목을 추천해드려요</span>
              </div>
              <div class="feature-item flex items-start gap-4 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="feature-icon-wrapper">
                  <TrendingUp class="h-7 w-7 md:h-8 md:w-8 text-yellow-400 mt-1" />
                </div>
                <span class="text-blue-100 text-lg md:text-xl lg:text-2xl">매수와 매도 시점도 정확하게 안내해드려요</span>
              </div>
              <div class="feature-item flex items-start gap-4 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="feature-icon-wrapper">
                  <Target class="h-7 w-7 md:h-8 md:w-8 text-yellow-400 mt-1" />
                </div>
                <span class="text-blue-100 text-lg md:text-xl lg:text-2xl">회원님 투자 스타일에 맞는 투자 전략도 알려드려요</span>
              </div>
              <div class="feature-item flex items-start gap-4 p-4 rounded-xl hover:bg-white/5 transition-all duration-300">
                <div class="feature-icon-wrapper">
                  <Shield class="h-7 w-7 md:h-8 md:w-8 text-yellow-400 mt-1" />
                </div>
                <span class="text-blue-100 text-lg md:text-xl lg:text-2xl">손실은 최소화하고 자산을 안정적으로 늘릴 수 있는 방법을 함께 찾아봐요</span>
              </div>
            </div>

            {/* CTA Button */}
            <CtaButton social={t} />
          </div>

          {/* Right Expert Card */}
          <div class="expert-card-modern rounded-3xl p-8 md:p-10">
            <div class="text-center">
              <div class="flex justify-center mb-6">
                <Image src={headImg} alt={name} class="w-32 h-32 bg-slate-200 rounded-full object-cover block">
                </Image>
              </div>

              <h3 class="text-3xl md:text-4xl font-bold text-white mb-2">{name}</h3>
              <p class="text-yellow-400 mb-6 text-lg md:text-xl">주식투자 전문가</p>

              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">15+</div>
                  <div class="text-base md:text-lg text-blue-200">년</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">5000+</div>
                  <div class="text-base md:text-lg text-blue-200">회원</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">85%</div>
                  <div class="text-base md:text-lg text-blue-200">승률</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl md:text-4xl font-bold text-yellow-400">300%</div>
                  <div class="text-base md:text-lg text-blue-200">평균수익률</div>
                </div>
              </div>

              <p class="text-blue-100 text-base md:text-lg italic">
                15년 동안 주식 투자로 자산을 키워온 경험을 바탕으로, 매일 상승 여력이 있는 종목을 추천해드려요. 저와 함께하면 여러분도 꾸준히 수익을 올릴 수 있어요!
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Services Section */}
    <section class="bg-white py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-slate-800">
            주식 투자 성공을 위한 전문 서비스
          </h2>
          <p class="text-xl md:text-2xl lg:text-3xl text-slate-600 max-w-4xl mx-auto">
            매일 상승 가능성이 높은 종목을 추천받고, 체계적인 투자 전략으로 꾸준한 수익을 실현해보세요
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div class="service-card bg-white border border-gray-200 shadow-lg rounded-2xl">
            <div class="p-8 text-center">
              <div class="w-20 h-20 md:w-24 md:h-24 mx-auto mb-6 bg-blue-500 rounded-full flex items-center justify-center">
                <TrendingUp class="h-10 w-10 md:h-12 md:w-12 text-white" />
              </div>
              <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 text-slate-800">매일 종목 추천</h3>
              <p class="text-slate-600 leading-relaxed text-lg md:text-xl">
                매일 상승 여력이 있는 종목을 분석하여 추천해드리며, 최적의 매수 타이밍을 알려드립니다
              </p>
            </div>
          </div>

          <div class="service-card bg-white border border-gray-200 shadow-lg rounded-2xl">
            <div class="p-8 text-center">
              <div class="w-20 h-20 md:w-24 md:h-24 mx-auto mb-6 bg-green-500 rounded-full flex items-center justify-center shadow-lg">
                <Target class="h-10 w-10 md:h-12 md:w-12 text-white" />
              </div>
              <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 text-slate-800">매수/매도 타이밍</h3>
              <p class="text-slate-600 leading-relaxed text-lg md:text-xl">
                정확한 기술적 분석을 통해 최적의 매수와 매도 시점을 정확하게 안내해드립니다
              </p>
            </div>
          </div>

          <div class="service-card bg-white border border-gray-200 shadow-lg rounded-2xl">
            <div class="p-8 text-center">
              <div class="w-20 h-20 md:w-24 md:h-24 mx-auto mb-6 bg-yellow-500 rounded-full flex items-center justify-center shadow-lg">
                <BarChart3 class="h-10 w-10 md:h-12 md:w-12 text-white" />
              </div>
              <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 text-slate-800">맞춤형 투자 전략</h3>
              <p class="text-slate-600 leading-relaxed text-lg md:text-xl">
                회원님의 투자 스타일과 자금 규모에 맞는 개인별 맞춤 투자 전략을 제공합니다
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

        {/* Expert Introduction Section */}
    <section class="bg-gray-50 py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-slate-800">주식투자 전문가 소개</h2>
          <p class="text-xl md:text-2xl lg:text-3xl text-slate-600 max-w-4xl mx-auto">
            15년 이상의 주식 투자 경험을 바탕으로 매일 수익성 높은 종목을 추천해드립니다
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
          <div class="intro-card rounded-3xl p-10 md:p-12">
            <h3 class="text-4xl md:text-5xl font-bold mb-8 text-slate-800">{name} 투자 전문가</h3>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-4 h-4 md:w-5 md:h-5 bg-blue-500 rounded-full mt-2"></div>
                <div>
                  <p class="text-xl md:text-2xl font-bold text-slate-800 mb-1">15년 주식투자 경력</p>
                  <p class="text-slate-600 text-lg md:text-xl">국내외 주식시장에서 쌓은 풍부한 실전 경험과 노하우</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-4 h-4 md:w-5 md:h-5 bg-green-500 rounded-full mt-2"></div>
                <div>
                  <p class="text-xl md:text-2xl font-bold text-slate-800 mb-1">5000명+ 회원 관리</p>
                  <p class="text-slate-600 text-lg md:text-xl">다양한 투자 성향의 회원들에게 맞춤형 종목 추천 서비스 제공</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-4 h-4 md:w-5 md:h-5 bg-purple-500 rounded-full mt-2"></div>
                <div>
                  <p class="text-xl md:text-2xl font-bold text-slate-800 mb-1">85% 높은 승률</p>
                  <p class="text-slate-600 text-lg md:text-xl">정확한 기술적 분석과 시장 분석을 통한 높은 성공률 달성</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-4 h-4 md:w-5 md:h-5 bg-yellow-500 rounded-full mt-2"></div>
                <div>
                  <p class="text-xl md:text-2xl font-bold text-slate-800 mb-1">300% 평균 수익률</p>
                  <p class="text-slate-600 text-lg md:text-xl">회원들의 연평균 수익률로 입증된 투자 실력</p>
                </div>
              </div>
            </div>

            <div class="mt-8 bg-blue-50 p-6 rounded-xl border-l-4 border-blue-500">
              <h4 class="font-bold text-xl md:text-2xl mb-2 text-slate-800">투자 철학</h4>
              <p class="text-slate-700 italic text-lg md:text-xl">
                "매일 꾸준히 상승 가능성이 높은 종목을 발굴하여 회원님들과 공유합니다. 함께 투자하며 안정적으로 자산을 늘려가는 것이 제 목표입니다."
              </p>
            </div>
          </div>

          <div class="intro-card rounded-3xl p-8 md:p-10">
            <Image src={headerImg} alt="header" class="w-full rounded-2xl mb-6 flex items-center justify-center shadow-lg">
            </Image>
            <div class="bg-yellow-500 text-white p-4 rounded-xl text-center">
              <div class="text-2xl font-bold mb-1">15+</div>
              <div class="text-sm">년 투자 경력</div>
            </div>
          </div>
        </div>

        {/* Success Story Highlight */}
        <div class="intro-card rounded-3xl p-10 md:p-12">
          <div class="grid lg:grid-cols-2 gap-10 items-center">
            <div>
              <h3 class="text-4xl md:text-5xl font-bold mb-6 text-slate-800">실제 투자 성과</h3>
              <div class="space-y-6">
                <div class="flex items-center gap-4">
                  <div class="w-5 h-5 md:w-6 md:h-6 bg-green-500 rounded-full"></div>
                  <span class="text-xl md:text-2xl text-slate-700">
                    지난해 추천 종목 <strong class="text-green-600">평균 85% 상승</strong>
                  </span>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-5 h-5 md:w-6 md:h-6 bg-blue-500 rounded-full"></div>
                  <span class="text-xl md:text-2xl text-slate-700">
                    회원 평균 <strong class="text-blue-600">연 300% 수익률 달성</strong>
                  </span>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-5 h-5 md:w-6 md:h-6 bg-purple-500 rounded-full"></div>
                  <span class="text-xl md:text-2xl text-slate-700">
                    매일 종목 추천으로 <strong class="text-purple-600">꾸준한 수익 실현</strong>
                  </span>
                </div>
              </div>
              <p class="mt-6 text-slate-600 italic text-xl md:text-2xl">"매일 30초만 투자하면 내일의 유망 종목을 확인할 수 있습니다"</p>
            </div>
            <div class="text-center">
              <Image src={img1Img} alt="img1" class="w-full bg-slate-200 rounded-xl flex items-center justify-center" />
            </div>
          </div>
        </div>
      </div>
    </section>

        {/* Trust Section */}
    <section class="bg-white py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold text-center mb-16 text-slate-800">
          검증된 투자 전문가
        </h2>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-4xl md:text-5xl font-bold mb-10 text-slate-800">투자 실력 입증</h3>
            <div class="space-y-8">
              <div class="flex items-center gap-6">
                <div class="w-20 h-20 md:w-24 md:h-24 bg-green-500 rounded-xl flex items-center justify-center font-bold text-white text-lg md:text-xl">
                  85%
                </div>
                <div>
                  <p class="text-2xl md:text-3xl font-bold text-slate-800 mb-1">높은 투자 성공률</p>
                  <p class="text-slate-600 text-lg md:text-xl">정확한 시장 분석과 종목 선별로 85% 이상의 높은 성공률 달성</p>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-500 rounded-xl flex items-center justify-center font-bold text-white text-lg md:text-xl">
                  15+
                </div>
                <div>
                  <p class="text-2xl md:text-3xl font-bold text-slate-800 mb-1">15년 투자 경력</p>
                  <p class="text-slate-600 text-lg md:text-xl">국내외 주식시장에서 쌓은 풍부한 실전 투자 경험</p>
                </div>
              </div>

              <div class="flex items-center gap-6">
                <div class="w-20 h-20 md:w-24 md:h-24 bg-yellow-500 rounded-xl flex items-center justify-center font-bold text-white text-lg md:text-xl">
                  5K+
                </div>
                <div>
                  <p class="text-2xl md:text-3xl font-bold text-slate-800 mb-1">5000명 이상 회원</p>
                  <p class="text-slate-600 text-lg md:text-xl">다양한 투자자들에게 맞춤형 종목 추천 및 투자 가이드 제공</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-4xl md:text-5xl font-bold mb-10 text-slate-800">회원 만족도</h3>
            <div class="trust-card rounded-3xl p-10 md:p-12 text-center">
              <div class="text-7xl md:text-8xl font-bold text-yellow-500 mb-4">96%</div>
