---
import { Image } from 'astro:assets'
import avatarImg from '@/assets/avatar/安迪李_avatar.png'
import CtaButton from '@/components/CtaButton.astro'
import KRRedirectCode from '@/components/KRRedirectCode.astro'
import { generateKrConfig } from '@/utils/kr_config'
// Import CSS
import './static/css/style.css'

export function getStaticPaths() {
  return generateKrConfig(['安迪李_0'])
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }

// 使用头像图片
const heroImg = avatarImg

const socialOptions = ['卡扣', '卡群', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined

// 公司信息
const companyInfo = {
  name: '한국시장연구소 주식회사',
  nameEn: 'Korea Market Research Institute Co., Ltd.',
  business: '정보 정리, 연구 내용 공유, 학습 교류 서비스',
  serviceType: '학습 및 정보 참고 용도',
  serviceArea: '한국 및 기타 지역',
  address: '서울특별시 강남구 테헤란로 123',
  ceo: '안디 이',
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} | 시장 분석 연구자와 함께하는 학습 채널</title>
    <meta name="description" content="15년간의 시장 분석 경험을 바탕으로 매일 주요 데이터를 정리하여 학습 자료로 공유하는 학습형 채널입니다." />
    <KRRedirectCode />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Minimal Header -->
    <header class="minimal-header">
      <div class="header-line"></div>
      <div class="header-content">
        <h1 class="main-title">시장 분석 연구자와 함께하는<br />학습 채널</h1>
        <p class="subtitle">학습 및 연구 자료 공유 플랫폼</p>
      </div>
    </header>

    <!-- Document Style Hero -->
    <section class="document-hero">
      <div class="document-container">
        <div class="author-section">
          <div class="author-image">
            <Image src={heroImg} alt={`${name} 프로필`} />
          </div>
          <div class="author-info">
            <h2 class="author-name">{name}</h2>
            <p class="author-title">시장 분석 연구자</p>
            <div class="author-meta">
              <span>15년간 시장 관찰 및 분석 경험</span>
              <span class="separator">·</span>
              <span>국내 환경 기반 연구 사례 축적</span>
            </div>
          </div>
        </div>
        <div class="hero-divider"></div>
        <div class="intro-text">
          <p class="lead-text">
            본 채널은 <strong>학습 및 연구 목적</strong>으로 운영되며, 
            공개된 정보를 바탕으로 시장 구조와 변화 방향을 이해하는 데 도움을 드립니다.
          </p>
          <p class="intro-note">
            모든 자료는 참고 학습용이며, 어떠한 형태의 투자 권유나 수익 보장을 포함하지 않습니다.
          </p>
        </div>
        <div class="cta-section">
          <CtaButton social={social} size="lg" class="document-cta">
            <span slot="content">학습 자료 받기</span>
          </CtaButton>
          <p class="cta-note">추가 후 7을 보내주시면 안내드립니다</p>
        </div>
      </div>
    </section>

    <!-- Core Description Section -->
    <section class="document-section">
      <div class="document-container">
        <div class="section-number">01</div>
        <h2 class="document-title">핵심 설명</h2>
        <div class="document-divider"></div>
        <div class="document-content">
          <p class="document-paragraph">
            시장에 대한 연구와 관찰 내용을 꾸준히 공유합니다.
          </p>
          <p class="document-paragraph">
            전문가 관점의 분석 자료를 바탕으로, 시장 구조와 흐름을 이해하는 데 도움을 드립니다.
          </p>
          <p class="document-note">
            ※ 모든 자료는 공개 정보를 기반으로 한 참고 학습용입니다.
          </p>
        </div>
      </div>
    </section>

    <!-- Learning Focus Section -->
    <section class="document-section alt-section">
      <div class="document-container">
        <div class="section-number">02</div>
        <h2 class="document-title">학습 방향</h2>
        <div class="document-divider"></div>
        <div class="document-list">
          <div class="list-item">
            <span class="list-marker">•</span>
            <div class="list-content">
              <p>전문가의 관찰을 통해 시장 변화의 방향과 구조를 이해합니다.</p>
            </div>
          </div>
          <div class="list-item">
            <span class="list-marker">•</span>
            <div class="list-content">
              <p>모든 자료는 공개 정보를 기반으로 한 참고 학습용입니다.</p>
            </div>
          </div>
          <div class="list-item">
            <span class="list-marker">•</span>
            <div class="list-content">
              <p>단기 판단보다 장기적인 관점의 축적을 중요하게 생각합니다.</p>
            </div>
          </div>
          <div class="list-item">
            <span class="list-marker">•</span>
            <div class="list-content">
              <p>합리적이고 구조적인 사고를 중심으로 의견 교류를 환영합니다.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Operation Method Section -->
    <section class="document-section">
      <div class="document-container">
        <div class="section-number">03</div>
        <h2 class="document-title">운영 방식</h2>
        <div class="document-divider"></div>
        <div class="document-content">
          <p class="document-paragraph">
            15년간의 시장 분석 경험을 바탕으로 매일 주요 데이터를 정리하여 학습 자료로 공유합니다.
          </p>
          <p class="document-paragraph">
            정보와 관점을 함께 나누는 학습형 채널로 운영됩니다.
          </p>
        </div>
      </div>
    </section>

    <!-- What You Get Section -->
    <section class="document-section alt-section">
      <div class="document-container">
        <div class="section-number">04</div>
        <h2 class="document-title">제공 내용</h2>
        <div class="document-divider"></div>
        <div class="services-list">
          <div class="service-item">
            <div class="service-header">
              <span class="service-number">①</span>
              <h3 class="service-title">매일 자료 제공</h3>
            </div>
            <p class="service-description">
              매일 트렌드 관련 데이터를 정리해 관찰과 이해에 도움이 되도록 제공합니다.
            </p>
          </div>
          <div class="service-item">
            <div class="service-header">
              <span class="service-number">②</span>
              <h3 class="service-title">개별 학습 소통</h3>
            </div>
            <p class="service-description">
              전문가와의 1:1 소통을 통해 기초 개념과 분석 관점을 함께 학습합니다.
            </p>
          </div>
          <div class="service-item">
            <div class="service-header">
              <span class="service-number">③</span>
              <h3 class="service-title">개인별 접근 방식</h3>
            </div>
            <p class="service-description">
              학습 내용을 바탕으로 각자의 이해 수준에 맞는 방향을 안내합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Community Section -->
    <section class="document-section">
      <div class="document-container">
        <div class="section-number">05</div>
        <h2 class="document-title">커뮤니티</h2>
        <div class="document-divider"></div>
        <div class="document-content">
          <p class="document-paragraph">
            5,000명 이상이 참여하는 학습형 커뮤니티를 운영하며, 다양한 관심사와 학습 성향에 맞춰 정보를 정리합니다.
          </p>
          <div class="info-box">
            <p class="info-text">
              본 커뮤니티는 학습 및 정보 교류를 목적으로 하며, 
              어떠한 형태의 투자 권유나 금융 상품 추천을 포함하지 않습니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing Section -->
    <section class="document-section closing-section">
      <div class="document-container">
        <div class="closing-content">
          <h2 class="closing-title">정리된 자료를 통해<br />시장 흐름을 보다 명확하게 이해해 보세요</h2>
          <div class="document-divider"></div>
          <p class="closing-text">
            체계적으로 정리된 학습 자료와 전문가의 관점을 통해 시장 구조와 변화 방향을 더 깊이 이해할 수 있습니다.
          </p>
          <p class="closing-note-text">
            ※ 본 채널의 모든 내용은 학습 및 연구 목적으로만 제공되며, 
            투자 결정에 대한 책임은 사용자 본인에게 있습니다.
          </p>
          <div class="closing-cta">
            <CtaButton social={social} size="lg" class="document-cta">
              <span slot="content">학습 자료 받기</span>
            </CtaButton>
            <p class="cta-note">추가 후 7을 보내주시면 안내드립니다</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Info Section -->
    <section id="company" class="document-section company-section">
      <div class="document-container">
        <div class="section-number">06</div>
        <h2 class="document-title">회사 정보</h2>
        <div class="document-divider"></div>
        <div class="company-info">
          <div class="info-row">
            <strong>회사명:</strong>
            <span>{companyInfo.name}</span>
            <span class="info-en">({companyInfo.nameEn})</span>
          </div>
          <div class="info-row">
            <strong>운영 내용:</strong>
            <span>{companyInfo.business}</span>
          </div>
          <div class="info-row">
            <strong>서비스 성격:</strong>
            <span>{companyInfo.serviceType}</span>
          </div>
          <div class="info-row">
            <strong>서비스 지역:</strong>
            <span>{companyInfo.serviceArea}</span>
          </div>
          <div class="info-row">
            <strong>주소:</strong>
            <span>{companyInfo.address}</span>
          </div>
          <div class="info-row">
            <strong>대표이사:</strong>
            <span>{companyInfo.ceo}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Policy Section -->
    <section id="privacy" class="document-section privacy-section">
      <div class="document-container">
        <div class="section-number">07</div>
        <h2 class="document-title">개인정보 보호</h2>
        <div class="document-divider"></div>
        <div class="policy-content">
          <p class="policy-intro">
            본 플랫폼은 사용자의 개인정보 보호를 중요하게 생각합니다.
          </p>
          <div class="policy-details">
            <h3>1. 개인정보 수집 및 이용</h3>
            <p>
              우리는 사용자가 자발적으로 제공하는 경우에만 필요한 정보를 수집하며,
              이는 커뮤니케이션, 콘텐츠 전송 및 서비스 개선을 위해 사용됩니다.
            </p>

            <h3>2. 개인정보 보호</h3>
            <p>
              수집된 정보는 내부적으로만 사용되며,
              어떠한 제3자에게도 판매, 공유 또는 공개되지 않습니다.
            </p>

            <h3>3. 보안 조치</h3>
            <p>
              플랫폼은 합리적인 기술 및 관리 조치를 통해
              사용자 정보의 안전성과 완전성을 보장합니다.
            </p>

            <h3>4. 사용자 권리</h3>
            <p>
              사용자는 언제든지 정보 수신 중단을 요청하거나
              관련 데이터 삭제를 요구할 수 있습니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Section -->
    <section id="disclaimer" class="document-section disclaimer-section">
      <div class="document-container">
        <div class="section-number">08</div>
        <h2 class="document-title">면책 조항</h2>
        <div class="document-divider"></div>
        <div class="disclaimer-content">
          <p>
            본 플랫폼에서 제공하는 모든 콘텐츠는 <strong>학습 및 참고 용도로만 제공</strong>되며,
            어떠한 형태의 조언, 약속 또는 보증을 구성하지 않습니다.
          </p>
          <p>
            사용자는 자신의 상황에 따라 독립적으로 판단하고 관련 책임을 부담해야 합니다.
          </p>
          <p>
            본 플랫폼의 정보를 사용하여 발생한 결과에 대해
            플랫폼은 어떠한 직접적 또는 간접적 책임도 지지 않습니다.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-brand">
            <span class="footer-logo">{name}</span>
            <span class="footer-tagline">시장 분석 연구자 · 학습 채널 운영</span>
          </div>
          <div class="footer-links">
            <a href="#company">회사 정보</a>
            <a href="#privacy">개인정보 보호</a>
            <a href="#disclaimer">면책 조항</a>
          </div>
        </div>
        <div class="footer-disclaimer">
          <p>
            본 웹사이트에서 제공하는 모든 정보 및 콘텐츠는 교육 및 정보 제공 목적으로만 사용되며,
            특정 투자 상품에 대한 매수·매도 권유가 아닙니다.
            모든 자료는 공개 정보를 기반으로 한 참고 학습용이며,
            투자 결정 및 그에 따른 모든 손익은 사용자 본인에게 귀속됩니다.
          </p>
        </div>
        <div class="footer-bottom">
          <p>© 2025 {companyInfo.name}. All Rights Reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Fixed Bottom CTA -->
    <div class="fixed-cta">
      <CtaButton social={social} class="fixed-cta-btn">
        <span slot="content">학습 채널 참여하기</span>
      </CtaButton>
    </div>

    <script is:inline>
      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault()
          const target = document.querySelector(this.getAttribute('href'))
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            })
          }
        })
      })

      // Intersection Observer for animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px',
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in')
            observer.unobserve(entry.target)
          }
        })
      }, observerOptions)

      document.addEventListener('DOMContentLoaded', () => {
        const animateElements = document.querySelectorAll(
          '.description-item, .learning-item, .benefit-card, .stat-box',
        )
        animateElements.forEach((el) => {
          el.style.opacity = '0'
          el.style.transform = 'translateY(30px)'
          el.style.transition = 'opacity 0.6s ease, transform 0.6s ease'
          observer.observe(el)
        })
      })

      const style = document.createElement('style')
      style.textContent = `
        .animate-in {
          opacity: 1 !important;
          transform: translateY(0) !important;
        }
      `
      document.head.appendChild(style)
    </script>
  </body>
</html>

