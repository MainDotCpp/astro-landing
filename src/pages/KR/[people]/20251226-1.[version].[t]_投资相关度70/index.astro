---
import { Image } from 'astro:assets'
import avatarImg from '@/assets/avatar/安迪李_avatar.png'
import CtaButton from '@/components/CtaButton.astro'
import KRRedirectCode from '@/components/KRRedirectCode.astro'
import { generateKrConfig } from '@/utils/kr_config'
// Import CSS
import './static/css/style.css'

export function getStaticPaths() {
  return generateKrConfig(['安迪李_0'])
}

const { t = '卡扣' } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }

// 使用头像图片
const heroImg = avatarImg

// 尝试加载其他图片
let aboutImg
try {
  aboutImg = (await import(`../images/${img_prefix}header.jpg`)).default
}
 catch {
  aboutImg = null
}

const socialOptions = ['卡扣', '卡群', '棒群', '混合', '引导弹窗'] as const
type Social = typeof socialOptions[number]
const social: Social | undefined = socialOptions.includes(t as Social) ? (t as Social) : undefined

// 公司信息
const companyInfo = {
  name: '한국시장연구소 주식회사',
  nameEn: 'Korea Market Research Institute Co., Ltd.',
  business: '정보 정리, 연구 내용 공유, 학습 교류 서비스',
  serviceType: '학습 및 정보 참고 용도',
  serviceArea: '한국 및 기타 지역',
  address: '서울특별시 강남구 테헤란로 123',
  ceo: '안디 이',
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} | 시장 분석 연구자와 함께하는 학습 채널</title>
    <meta name="description" content="15년간의 시장 분석 경험을 바탕으로 매일 주요 데이터를 정리하여 학습 자료로 공유하는 학습형 채널입니다." />
    <KRRedirectCode />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-background"></div>
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <i class="fas fa-chart-line"></i>
            <span>시장 분석 연구자</span>
          </div>
          <h1 class="hero-title">
            <span class="highlight">{name}</span>과 함께하는<br />
            <span class="sub-title">시장 분석 학습 채널</span>
          </h1>
          <p class="hero-description">
            15년간의 시장 분석 경험을 바탕으로<br />
            <strong>매일 주요 데이터를 정리하여 학습 자료로 공유</strong>합니다.<br />
            정보와 관점을 함께 나누는 학습형 커뮤니티입니다.
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <span class="stat-number">15</span>
              <span class="stat-label">년 경력</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">5,000</span>
              <span class="stat-label">명 이상 참여</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-number">매일</span>
              <span class="stat-label">데이터 정리</span>
            </div>
          </div>
          <div class="hero-cta-wrapper">
            <CtaButton social={social} class="hero-cta">
              <span slot="content">학습 채널 참여하기</span>
            </CtaButton>
            <p class="cta-note">추가 후 7을 보내주시면 안내드립니다</p>
          </div>
        </div>
        {heroImg && (
          <div class="hero-image">
            <div class="image-frame">
              <Image src={heroImg} alt={`${name} 프로필`} />
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="section intro-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-book-open"></i> 채널 소개</span>
          <h2 class="section-title">시장 분석 연구자와 함께하는 학습 채널</h2>
        </div>
        <div class="intro-grid">
          <div class="intro-card">
            <div class="intro-icon">
              <i class="fas fa-search"></i>
            </div>
            <h3>시장 연구와 관찰</h3>
            <p>시장에 대한 연구와 관찰 내용을 꾸준히 공유합니다.</p>
          </div>
          <div class="intro-card">
            <div class="intro-icon">
              <i class="fas fa-user-tie"></i>
            </div>
            <h3>전문가 관점의 분석</h3>
            <p>전문가 관점의 분석 자료를 바탕으로, 시장 구조와 흐름을 이해하는 데 도움을 드립니다.</p>
          </div>
          <div class="intro-card">
            <div class="intro-icon">
              <i class="fas fa-shield-alt"></i>
            </div>
            <h3>공개 정보 기반</h3>
            <p>모든 자료는 공개 정보를 기반으로 한 참고 학습용입니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="section features-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-star"></i> 채널 특징</span>
          <h2 class="section-title">왜 이 채널을 선택해야 할까요?</h2>
        </div>
        <div class="features-content">
          <div class="feature-item">
            <div class="feature-number">01</div>
            <div class="feature-text">
              <h3>전문가의 관찰을 통한 시장 이해</h3>
              <p>전문가의 관찰을 통해 시장 변화의 방향과 구조를 이해합니다.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-number">02</div>
            <div class="feature-text">
              <h3>공개 정보 기반의 학습 자료</h3>
              <p>모든 자료는 공개 정보를 기반으로 한 참고 학습용입니다.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-number">03</div>
            <div class="feature-text">
              <h3>장기적인 관점의 축적</h3>
              <p>단기 판단보다 장기적인 관점의 축적을 중요하게 생각합니다.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-number">04</div>
            <div class="feature-text">
              <h3>합리적이고 구조적인 사고</h3>
              <p>합리적이고 구조적인 사고를 중심으로 의견 교류를 환영합니다.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Daily Data Section -->
    <section class="section daily-section">
      <div class="container">
        <div class="daily-content">
          <div class="daily-text">
            <h2 class="daily-title">
              <i class="fas fa-calendar-day"></i>
              매일 트렌드 관련 데이터를 정리해<br />
              관찰과 이해에 도움이 되도록 제공합니다
            </h2>
            <p class="daily-description">
              15년간의 시장 분석 경험을 바탕으로<br />
              매일 주요 데이터를 정리하여 학습 자료로 공유합니다.
            </p>
            <ul class="daily-list">
              <li><i class="fas fa-check-circle"></i> 시장 동향 분석</li>
              <li><i class="fas fa-check-circle"></i> 주요 지표 정리</li>
              <li><i class="fas fa-check-circle"></i> 트렌드 데이터 제공</li>
              <li><i class="fas fa-check-circle"></i> 학습 자료 공유</li>
            </ul>
          </div>
          {aboutImg && (
            <div class="daily-image">
              <Image src={aboutImg} alt="시장 분석 자료" />
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Community Section -->
    <section class="section community-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-users"></i> 커뮤니티</span>
          <h2 class="section-title">5,000명 이상이 참여하는 학습형 커뮤니티</h2>
          <p class="section-desc">
            다양한 관심사와 학습 성향에 맞춰 정보를 정리합니다.
          </p>
        </div>
        <div class="community-features">
          <div class="community-feature">
            <i class="fas fa-book-reader"></i>
            <h4>체계적인 학습 자료</h4>
            <p>전문가가 정리한 체계적인 학습 자료를 제공합니다.</p>
          </div>
          <div class="community-feature">
            <i class="fas fa-comments"></i>
            <h4>의견 교류</h4>
            <p>합리적이고 구조적인 사고를 중심으로 의견을 교류합니다.</p>
          </div>
          <div class="community-feature">
            <i class="fas fa-chart-bar"></i>
            <h4>시장 분석</h4>
            <p>시장 구조와 흐름을 이해하는 데 도움을 드립니다.</p>
          </div>
          <div class="community-feature">
            <i class="fas fa-clock"></i>
            <h4>장기적 관점</h4>
            <p>단기 판단보다 장기적인 관점의 축적을 중요하게 생각합니다.</p>
          </div>
        </div>
        <div class="community-cta">
          <CtaButton social={social} size="lg">
            <span slot="content">지금 커뮤니티 참여하기</span>
          </CtaButton>
        </div>
      </div>
    </section>

    <!-- Company Info Section -->
    <section id="company" class="section company-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-building"></i> 회사 정보</span>
          <h2 class="section-title">회사 정보</h2>
        </div>
        <div class="company-info">
          <div class="info-item">
            <strong>회사명:</strong>
            <span>{companyInfo.name}</span>
            <span class="info-en">({companyInfo.nameEn})</span>
          </div>
          <div class="info-item">
            <strong>운영 내용:</strong>
            <span>{companyInfo.business}</span>
          </div>
          <div class="info-item">
            <strong>서비스 성격:</strong>
            <span>{companyInfo.serviceType}</span>
          </div>
          <div class="info-item">
            <strong>서비스 지역:</strong>
            <span>{companyInfo.serviceArea}</span>
          </div>
          <div class="info-item">
            <strong>주소:</strong>
            <span>{companyInfo.address}</span>
          </div>
          <div class="info-item">
            <strong>대표이사:</strong>
            <span>{companyInfo.ceo}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Privacy Policy Section -->
    <section id="privacy" class="section privacy-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-shield-alt"></i> 개인정보 보호</span>
          <h2 class="section-title">개인정보 보호 정책</h2>
        </div>
        <div class="policy-content">
          <p class="policy-intro">
            본 플랫폼은 사용자의 개인정보 보호를 중요하게 생각합니다.
          </p>
          <div class="policy-details">
            <h3>1. 개인정보 수집 및 이용</h3>
            <p>
              우리는 사용자가 자발적으로 제공하는 경우에만 필요한 정보를 수집하며,
              이는 커뮤니케이션, 콘텐츠 전송 및 서비스 개선을 위해 사용됩니다.
            </p>

            <h3>2. 개인정보 보호</h3>
            <p>
              수집된 정보는 내부적으로만 사용되며,
              어떠한 제3자에게도 판매, 공유 또는 공개되지 않습니다.
            </p>

            <h3>3. 보안 조치</h3>
            <p>
              플랫폼은 합리적인 기술 및 관리 조치를 통해
              사용자 정보의 안전성과 완전성을 보장합니다.
            </p>

            <h3>4. 사용자 권리</h3>
            <p>
              사용자는 언제든지 정보 수신 중단을 요청하거나
              관련 데이터 삭제를 요구할 수 있습니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Section -->
    <section id="disclaimer" class="section disclaimer-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-exclamation-triangle"></i> 면책 조항</span>
          <h2 class="section-title">면책 조항</h2>
        </div>
        <div class="disclaimer-content">
          <p>
            본 플랫폼에서 제공하는 모든 콘텐츠는 <strong>학습 및 참고 용도로만 제공</strong>되며,
            어떠한 형태의 조언, 약속 또는 보증을 구성하지 않습니다.
          </p>
          <p>
            사용자는 자신의 상황에 따라 독립적으로 판단하고 관련 책임을 부담해야 합니다.
          </p>
          <p>
            본 플랫폼의 정보를 사용하여 발생한 결과에 대해
            플랫폼은 어떠한 직접적 또는 간접적 책임도 지지 않습니다.
          </p>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-content">
          <h2>지금 바로 시작하세요</h2>
          <p>{name}과 함께 시장 분석을 배우고 이해하는 첫 걸음을 내딛어 보세요</p>
          <div class="cta-features">
            <span><i class="fas fa-check-circle"></i> 무료 참여</span>
            <span><i class="fas fa-check-circle"></i> 매일 데이터 제공</span>
            <span><i class="fas fa-check-circle"></i> 학습 자료 공유</span>
          </div>
          <CtaButton social={social} size="lg" class="cta-large">
            <span slot="content">학습 채널 참여하기</span>
          </CtaButton>
          <p class="cta-note">추가 후 7을 보내주시면 안내드립니다</p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-brand">
            <span class="footer-logo">{name}</span>
            <span class="footer-tagline">시장 분석 연구자 · 학습 채널 운영</span>
          </div>
          <div class="footer-links">
            <a href="#company">회사 정보</a>
            <a href="#privacy">개인정보 보호</a>
            <a href="#disclaimer">면책 조항</a>
          </div>
        </div>
        <div class="footer-disclaimer">
          <p>
            본 웹사이트에서 제공하는 모든 정보 및 콘텐츠는 교육 및 정보 제공 목적으로만 사용되며,
            특정 투자 상품에 대한 매수·매도 권유가 아닙니다.
            모든 자료는 공개 정보를 기반으로 한 참고 학습용이며,
            투자 결정 및 그에 따른 모든 손익은 사용자 본인에게 귀속됩니다.
          </p>
        </div>
        <div class="footer-bottom">
          <p>© 2025 {companyInfo.name}. All Rights Reserved.</p>
        </div>
      </div>
    </footer>

    <!-- Fixed Bottom CTA -->
    <div class="fixed-cta">
      <CtaButton social={social} class="fixed-cta-btn">
        <span slot="content">학습 채널 참여하기</span>
      </CtaButton>
    </div>

    <script is:inline>
// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
  anchor.addEventListener('click', function (e) {
    e.preventDefault()
    const target = document.querySelector(this.getAttribute('href'))
    if (target) {
      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      })
    }
  })
})

// Intersection Observer for animations
const observerOptions = {
  threshold: 0.1,
  rootMargin: '0px 0px -50px 0px',
}

const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      entry.target.classList.add('animate-in')
      observer.unobserve(entry.target)
    }
  })
}, observerOptions)

document.addEventListener('DOMContentLoaded', () => {
  const animateElements = document.querySelectorAll(
    '.intro-card, .feature-item, .community-feature, .daily-content',
  )
  animateElements.forEach((el) => {
    el.style.opacity = '0'
    el.style.transform = 'translateY(30px)'
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease'
    observer.observe(el)
  })
})

const style = document.createElement('style')
style.textContent = `
  .animate-in {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
`
document.head.appendChild(style)
</script>
  </body>
</html>

