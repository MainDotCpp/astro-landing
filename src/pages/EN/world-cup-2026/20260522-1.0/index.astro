  <script is:inline>
// ───── Reveal on scroll (with safety fallback) ─────
;(function () {
  const els = document.querySelectorAll('.reveal')
  if (!('IntersectionObserver' in window)) {
    els.forEach(el => el.classList.add('active'))
    return
  }
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active')
          observer.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
  )
  els.forEach(el => observer.observe(el))
  setTimeout(() => {
    document.querySelectorAll('.reveal:not(.active)').forEach(el => el.classList.add('active'))
  }, 2500)
})()

// ───── Countdown to World Cup 2026 kickoff (June 11, 2026 18:00 UTC) ─────
;(function () {
  // Opening match: Mexico vs South Africa, Estadio Azteca, 2026-06-11 19:00 UTC (8pm BST / 13:00 CDT)
  const target = new Date(Date.UTC(2026, 5, 11, 19, 0, 0)).getTime()
  const dEl = document.getElementById('cd-d')
  const hEl = document.getElementById('cd-h')
  const mEl = document.getElementById('cd-m')
  const sEl = document.getElementById('cd-s')
  if (!dEl)
    return
  const pad = n => String(n).padStart(2, '0')
  function tick() {
    const diff = Math.max(0, target - Date.now())
    const d = Math.floor(diff / 86400000)
    const h = Math.floor((diff % 86400000) / 3600000)
    const m = Math.floor((diff % 3600000) / 60000)
    const s = Math.floor((diff % 60000) / 1000)
    dEl.textContent = pad(d)
    hEl.textContent = pad(h)
    mEl.textContent = pad(m)
    sEl.textContent = pad(s)
  }
  tick()
  setInterval(tick, 1000)
})()

// ───── Live "players claiming" counter — gently jittering ─────
;(function () {
  const el = document.getElementById('wc-live-count')
  if (!el)
    return
  let n = 2847
  setInterval(() => {
    n += Math.floor(Math.random() * 7) - 2
    if (n < 2700)
      n = 2700
    if (n > 3100)
      n = 3100
    el.textContent = n.toLocaleString('en-US')
  }, 2200)
})()

// ───── Sticky CTA — show when hero is out of viewport ─────
;(function () {
  const sticky = document.getElementById('wc-sticky-cta')
  const hero = document.querySelector('.wc-hero-full')
  if (!sticky || !hero || !('IntersectionObserver' in window)) {
    if (sticky)
      sticky.classList.add('is-visible')
    return
  }
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        sticky.classList.remove('is-visible')
        sticky.setAttribute('aria-hidden', 'true')
      }
      else {
        sticky.classList.add('is-visible')
        sticky.setAttribute('aria-hidden', 'false')
      }
    })
  }, { threshold: 0, rootMargin: '0px 0px -60% 0px' })
  io.observe(hero)
})()

// ───── Winners feed — staggered injection with rotation ─────
;(function () {
  const root = document.getElementById('wc-winners-list')
  if (!root)
    return
  const pool = [
    { handle: 'MikeJ', amt: 215, match: 'Brazil x Argentina · Acca', time: 'Just now', mega: false },
    { handle: 'Sara_K', amt: 48, match: 'France ML', time: '14s ago', mega: false },
    { handle: 'DavidR', amt: 2380, match: 'England vs Germany · O 2.5', time: '32s ago', mega: true },
    { handle: 'LucaP', amt: 92, match: 'Portugal x Norway', time: '48s ago', mega: false },
    { handle: 'YukiT', amt: 310, match: 'Japan x Korea · BTTS', time: '1m ago', mega: false },
    { handle: 'AhmedB', amt: 1840, match: 'Morocco DBL chance', time: '1m ago', mega: true },
    { handle: 'PaulM', amt: 165, match: 'Netherlands x Belgium', time: '2m ago', mega: false },
    { handle: 'JorgeS', amt: 420, match: 'USA x Mexico · Acca', time: '3m ago', mega: false },
    { handle: 'KimDH', amt: 4150, match: 'Korea Outright · MEGA', time: '4m ago', mega: true },
    { handle: 'EmmaF', amt: 73, match: 'Spain Win', time: '5m ago', mega: false },
  ]
  function rowHtml(w, i) {
    const initial = w.handle.slice(0, 1).toUpperCase()
    return `
      <div class="wc-winrow${w.mega ? ' mega' : ''}" style="animation-delay:${i * 90}ms;">
        <div class="wc-win-avatar">${initial}</div>
        <div class="wc-win-text">
          <b>@${w.handle}</b> won on <span class="match">${w.match}</span>${w.mega ? '<span class="wc-win-mega-tag">Mega</span>' : ''}
        </div>
        <div class="wc-win-amount">+$${w.amt.toLocaleString('en-US')}</div>
        <div class="wc-win-time">${w.time}</div>
      </div>`
  }
  function render() {
    root.innerHTML = pool.map(rowHtml).join('')
  }
  // Initial render on first scroll into view, otherwise after 1s
  let rendered = false
  function show() {
    if (rendered)
      return
    rendered = true
    render()
  }
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          show()
          io.disconnect()
        }
      })
    }, { threshold: 0.1 })
    io.observe(root)
  }
  setTimeout(show, 1500)
})()
</script>
