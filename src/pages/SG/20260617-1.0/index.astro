    <script is:inline>
      document.querySelectorAll('.link-btn').forEach((btn) => {
        btn.addEventListener('click', (event) => {
          event.preventDefault()
          if (typeof window.onLinkBtnClick === 'function') window.onLinkBtnClick()
          else if (typeof link !== 'undefined') window.location.href = link
        })
      })

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add('in')
          revealObserver.unobserve(entry.target)
        })
      }, { threshold: 0.14 })
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el))

      let scored = false
      function animateScore() {
        if (scored) return
        scored = true
        const target = 82
        const arc = document.getElementById('gaugeArc')
        const numEl = document.getElementById('scoreNum')
        const circumference = 207
        let start = null
        function step(timestamp) {
          if (!start) start = timestamp
          const progress = Math.min((timestamp - start) / 1100, 1)
          const eased = 1 - Math.pow(1 - progress, 3)
          const value = Math.round(target * eased)
          if (numEl) numEl.textContent = String(value)
          if (arc) arc.style.strokeDashoffset = String(circumference - (circumference * (value / 100)))
          if (progress < 1) requestAnimationFrame(step)
        }
        requestAnimationFrame(step)
      }

      const gaugeObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) animateScore()
        })
      }, { threshold: 0.5 })
      const gauge = document.querySelector('.gauge')
      if (gauge) gaugeObserver.observe(gauge)

      ;(() => {
        const svg = document.getElementById('kline')
        if (!svg) return
        const width = 340
        const height = 92
        const count = 20
        const gap = width / count
        const bodyWidth = gap * 0.5
        let price = 10
        const points = []
        let seed = 7
        function rnd() {
          seed = (seed * 9301 + 49297) % 233280
          return seed / 233280
        }
        for (let i = 0; i < count; i += 1) {
          const open = price
          const drift = (i / count) * 0.9
          const close = open + (rnd() - 0.42 + drift * 0.18) * 0.9
          const high = Math.max(open, close) + rnd() * 0.5
          const low = Math.min(open, close) - rnd() * 0.5
          points.push({ open, close, high, low })
          price = close
        }
        const all = points.flatMap((point) => [point.high, point.low])
        const max = Math.max(...all)
        const min = Math.min(...all)
        const pad = 6
        const y = (value) => height - pad - ((value - min) / (max - min)) * (height - pad * 2)
        let markup = ''
        points.forEach((point, index) => {
          const x = index * gap + gap / 2
          const up = point.close >= point.open
          const color = up ? '#ff4b5c' : '#1fc093'
          markup += `<line x1="${x}" y1="${y(point.high)}" x2="${x}" y2="${y(point.low)}" stroke="${color}" stroke-width="1.3"/>`
          const openY = y(point.open)
          const closeY = y(point.close)
          const top = Math.min(openY, closeY)
          const candleHeight = Math.max(Math.abs(openY - closeY), 1.5)
          markup += `<rect x="${x - bodyWidth / 2}" y="${top}" width="${bodyWidth}" height="${candleHeight}" fill="${color}" rx="1"/>`
        })
        svg.innerHTML = markup
      })()
    </script>
