---
import RedirectCode from '@/components/RedirectCode.astro'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Free Stock Research Report · SGX · US · HK</title>
    <meta
      name="description"
      content="Get a free weekly stock research report covering high-potential ideas our analysts are watching across SGX, US and HK markets. Educational research — not investment advice."
    />
    <RedirectCode />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #070c1a;
        --bg-2: #0b1430;
        --panel: #101c3c;
        --gold: #e8c25a;
        --gold-bright: #f7da8a;
        --up: #ff4b5c;
        --down: #1fc093;
        --text: #eef2fb;
        --muted: #94a2c4;
        --line: rgb(255 255 255 / 9%);
        --line-gold: rgb(232 194 90 / 35%);
        --shadow: 0 24px 60px -20px rgb(0 0 0 / 70%);
        --r: 18px;
        --maxw: 1120px;
        --sans: 'Manrope', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --display: 'Sora', var(--sans);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.6;
        overflow-x: hidden;
        padding-bottom: 84px;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
      }

      .num,
      h1,
      h2,
      h3,
      .logo,
      .btn-primary,
      .eyebrow,
      .sec-kicker,
      .stat b {
        font-family: var(--display);
      }

      .wrap {
        width: min(100% - 40px, var(--maxw));
        margin: 0 auto;
      }

      .bg-fx {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .bg-fx .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.5;
      }

      .bg-fx .g1 {
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgb(232 194 90 / 22%), transparent 70%);
        top: -150px;
        right: -180px;
      }

      .bg-fx .g2 {
        width: 430px;
        height: 430px;
        background: radial-gradient(circle, rgb(43 90 200 / 30%), transparent 70%);
        bottom: -190px;
        left: -190px;
      }

      .grid-lines {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 42px 42px;
        opacity: 0.22;
        mask-image: radial-gradient(ellipse 90% 62% at 50% 0%, #000, transparent 76%);
      }

      header {
        position: relative;
        z-index: 5;
        padding: calc(env(safe-area-inset-top) + 14px) 0 12px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.01em;
      }

      .logo .mark {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: linear-gradient(145deg, var(--gold-bright), var(--gold));
        box-shadow: 0 6px 18px -6px rgb(232 194 90 / 60%);
        color: #1a1405;
        font-size: 18px;
        font-weight: 900;
      }

      .logo .name b {
        color: var(--gold-bright);
      }

      .badge-sg {
        display: none;
      }

      .badge-sg .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--up);
        box-shadow: 0 0 10px var(--up);
      }

      .hero {
        position: relative;
        z-index: 2;
        padding: 26px 0 46px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 34px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 20px;
        padding: 8px 14px;
        border: 1px solid var(--line-gold);
        border-radius: 999px;
        background: rgb(232 194 90 / 8%);
        color: var(--gold-bright);
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .eyebrow svg {
        width: 14px;
        height: 14px;
      }

      h1 {
        margin-bottom: 18px;
        font-size: clamp(33px, 12vw, 52px);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -0.035em;
      }

      h1 .hl,
      .final-card h2 .hl {
        color: var(--gold-bright);
      }

      .lede {
        max-width: 520px;
        margin-bottom: 16px;
        color: var(--muted);
        font-size: 16.5px;
      }

      .lede b {
        color: var(--text);
        font-weight: 800;
      }

      .note-line {
        margin-bottom: 24px;
        color: var(--muted);
        font-size: 13px;
        opacity: 0.86;
      }

      .ticks {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 28px;
      }

      .tick {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 15px;
        font-weight: 600;
      }

      .tick .ic {
        width: 24px;
        height: 24px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 50%;
        background: rgb(31 192 147 / 14%);
      }

      .tick .ic svg {
        width: 14px;
        height: 14px;
        fill: none;
        stroke: var(--down);
        stroke-width: 2.4;
      }

      .btn-primary {
        min-height: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: none;
        border-radius: 13px;
        background: linear-gradient(135deg, var(--gold-bright), var(--gold));
        box-shadow: 0 14px 32px -10px rgb(232 194 90 / 55%);
        color: #1a1405;
        cursor: pointer;
        font-size: 16.5px;
        font-weight: 900;
        letter-spacing: 0.01em;
        padding: 16px 26px;
        transition: transform 0.15s, box-shadow 0.2s;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 42px -10px rgb(232 194 90 / 72%);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-primary svg {
        width: 18px;
        height: 18px;
      }

      .hero-cta {
        display: grid;
        gap: 13px;
      }

      .hero-cta .btn-primary {
        width: 100%;
      }

      .hero-cta .sub-cta {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--muted);
        font-size: 13px;
      }

      .hero-cta .sub-cta svg {
        width: 14px;
        height: 14px;
        stroke: var(--down);
      }

      .hero-visual {
        position: relative;
      }

      .report-card {
        position: relative;
        border: 1px solid var(--line-gold);
        border-radius: 22px;
        background: linear-gradient(165deg, #13224a, #0a1430);
        box-shadow: var(--shadow);
        padding: 20px;
      }

      .sample-flag {
        display: inline-block;
        margin-bottom: 14px;
        padding: 4px 9px;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: rgb(255 255 255 / 6%);
        color: var(--muted);
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .rc-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 18px;
      }

      .rc-stock {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .rc-stock .tk {
        width: 46px;
        height: 46px;
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 12px;
        background: rgb(232 194 90 / 14%);
        color: var(--gold-bright);
        font-family: var(--display);
        font-weight: 900;
      }

      .rc-stock .meta b {
        display: block;
        font-size: 14.5px;
        font-weight: 800;
        line-height: 1.25;
      }

      .rc-stock .meta span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.25;
      }

      .rc-price {
        flex: 0 0 auto;
        text-align: right;
      }

      .rc-price b {
        display: block;
        font-family: var(--display);
        font-size: 18px;
        font-weight: 800;
      }

      .rc-price .chg {
        color: var(--up);
        font-size: 12.5px;
        font-weight: 800;
      }

      .score-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
        padding: 15px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgb(255 255 255 / 3%);
      }

      .gauge {
        position: relative;
        width: 78px;
        height: 78px;
        flex: 0 0 auto;
      }

      .gauge svg {
        transform: rotate(-90deg);
      }

      .gauge .val {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-family: var(--display);
        font-weight: 800;
        line-height: 1;
        text-align: center;
      }

      .gauge .val b {
        color: var(--gold-bright);
        font-size: 24px;
        line-height: 1;
      }

      .gauge .val span {
        margin-top: 2px;
        color: var(--muted);
        font-size: 11px;
      }

      .score-text b {
        color: var(--gold-bright);
        font-size: 14.5px;
        font-weight: 800;
      }

      .score-text p {
        margin-top: 3px;
        color: var(--muted);
        font-size: 12.5px;
      }

      .chart-box {
        margin-bottom: 14px;
        padding: 13px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgb(255 255 255 / 2%);
      }

      .chart-box .clab {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 11px;
      }

      .ind-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 9px;
      }

      .ind {
        padding: 10px 8px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: rgb(255 255 255 / 3%);
        text-align: center;
      }

      .ind span {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 11px;
      }

      .ind b {
        font-size: 13.5px;
        font-weight: 800;
      }

      .ind .pos {
        color: var(--up);
      }

      .ind .neu {
        color: var(--gold-bright);
      }

      .illus {
        margin-top: 13px;
        color: var(--muted);
        font-size: 11px;
        text-align: center;
        opacity: 0.82;
      }

      section.block {
        position: relative;
        z-index: 2;
        padding: 46px 0;
      }

      .sec-head {
        max-width: 660px;
        margin: 0 auto 34px;
        text-align: center;
      }

      .sec-kicker {
        margin-bottom: 14px;
        color: var(--gold-bright);
        font-size: 12.5px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .sec-head h2 {
        font-size: clamp(26px, 9vw, 36px);
        font-weight: 900;
        line-height: 1.16;
        letter-spacing: -0.025em;
      }

      .sec-head p {
        margin-top: 14px;
        color: var(--muted);
        font-size: 16px;
      }

      .cards,
      .steps {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .card,
      .step {
        border: 1px solid var(--line);
        border-radius: var(--r);
        background: linear-gradient(170deg, var(--panel), var(--bg-2));
        padding: 24px 20px;
      }

      .card {
        transition: transform 0.25s, border-color 0.25s;
      }

      .card:hover {
        border-color: var(--line-gold);
        transform: translateY(-6px);
      }

      .card .ic-box {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        margin-bottom: 18px;
        border: 1px solid var(--line-gold);
        border-radius: 14px;
        background: rgb(232 194 90 / 12%);
      }

      .card .ic-box svg {
        width: 26px;
        height: 26px;
        fill: none;
        stroke: var(--gold-bright);
        stroke-width: 1.8;
      }

      .card h3,
      .step h3 {
        margin-bottom: 9px;
        font-size: 18px;
        font-weight: 800;
      }

      .card p,
      .step p {
        color: var(--muted);
        font-size: 14.5px;
      }

      .steps {
        counter-reset: s;
      }

      .step .n {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        margin-bottom: 18px;
        border-radius: 11px;
        background: linear-gradient(145deg, var(--gold-bright), var(--gold));
        color: #1a1405;
        font-family: var(--display);
        font-size: 15px;
        font-weight: 900;
        counter-increment: s;
      }

      .step .n::before {
        content: '0' counter(s);
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px 16px;
        padding: 28px 18px;
        border: 1px solid var(--line-gold);
        border-radius: 22px;
        background: linear-gradient(170deg, var(--panel), var(--bg-2));
      }

      .stat {
        text-align: center;
      }

      .stat b {
        display: block;
        color: var(--gold-bright);
        font-size: clamp(23px, 7vw, 32px);
        font-weight: 900;
        line-height: 1;
      }

      .stat span {
        display: block;
        margin-top: 9px;
        color: var(--muted);
        font-size: 13px;
      }

      .faq {
        max-width: 740px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 0 auto;
      }

      .qa {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel);
      }

      .qa summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 19px 18px;
        cursor: pointer;
        font-size: 15.5px;
        font-weight: 800;
        list-style: none;
      }

      .qa summary::-webkit-details-marker {
        display: none;
      }

      .qa summary .pl {
        position: relative;
        width: 22px;
        height: 22px;
        flex: 0 0 auto;
        transition: transform 0.25s;
      }

      .qa summary .pl::before,
      .qa summary .pl::after {
        content: '';
        position: absolute;
        border-radius: 2px;
        background: var(--gold-bright);
      }

      .qa summary .pl::before {
        top: 10px;
        right: 3px;
        left: 3px;
        height: 2px;
      }

      .qa summary .pl::after {
        top: 3px;
        bottom: 3px;
        left: 10px;
        width: 2px;
        transition: opacity 0.25s;
      }

      .qa[open] summary .pl {
        transform: rotate(180deg);
      }

      .qa[open] summary .pl::after {
        opacity: 0;
      }

      .qa .ans {
        padding: 0 18px 20px;
        color: var(--muted);
        font-size: 14.5px;
      }

      .final {
        position: relative;
        z-index: 2;
        padding: 52px 0 62px;
      }

      .final-card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--line-gold);
        border-radius: 28px;
        background: linear-gradient(135deg, #1a2c5e, #0c1736);
        box-shadow: var(--shadow);
        padding: 40px 22px;
        text-align: center;
      }

      .final-card::after {
        content: '';
        position: absolute;
        top: -120px;
        right: -110px;
        width: 260px;
        height: 260px;
        background: radial-gradient(circle, rgb(232 194 90 / 25%), transparent 70%);
        filter: blur(40px);
      }

      .final-card h2 {
        position: relative;
        margin-bottom: 16px;
        font-size: clamp(26px, 9vw, 38px);
        font-weight: 900;
        line-height: 1.16;
      }

      .final-card p {
        position: relative;
        max-width: 500px;
        margin: 0 auto 30px;
        color: var(--muted);
        font-size: 16px;
      }

      .final-card .btn-primary {
        position: relative;
        width: 100%;
      }

      footer {
        position: relative;
        z-index: 2;
        border-top: 1px solid var(--line);
        margin-top: 10px;
        padding: 34px 0 46px;
      }

      .disclaimer {
        margin-bottom: 26px;
        padding: 18px 18px;
        border: 1px solid rgb(255 75 92 / 22%);
        border-radius: 14px;
        background: rgb(255 75 92 / 5%);
      }

      .disclaimer b {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--up);
        font-size: 13.5px;
        font-weight: 900;
      }

      .disclaimer b svg {
        width: 15px;
        height: 15px;
        fill: none;
        stroke: var(--up);
      }

      .disclaimer p {
        color: var(--muted);
        font-size: 12.5px;
        line-height: 1.7;
      }

      .foot-bot {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        color: var(--muted);
        font-size: 12.5px;
      }

      .foot-bot .logo {
        font-size: 16px;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .foot-links a:hover {
        color: var(--gold-bright);
      }

      .mobile-cta {
        position: fixed;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 30;
        display: block;
        padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
        background: linear-gradient(0deg, var(--bg) 60%, transparent);
      }

      .mobile-cta .btn-primary {
        width: 100%;
      }

      .reveal {
        opacity: 0;
        transform: translateY(26px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }

      .reveal.in {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      @media (min-width: 520px) {
        .ind-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .final-card .btn-primary,
        .hero-cta .btn-primary {
          width: auto;
        }

        .hero-cta {
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 18px;
        }
      }

      @media (min-width: 760px) {
        body {
          padding-bottom: 0;
        }

        .wrap {
          width: min(100% - 56px, var(--maxw));
        }

        .badge-sg {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          border: 1px solid var(--line);
          border-radius: 999px;
          background: rgb(255 255 255 / 3%);
          color: var(--muted);
          font-size: 12.5px;
          padding: 7px 12px;
        }

        .hero {
          padding: 34px 0 56px;
        }

        section.block {
          padding: 60px 0;
        }

        .cards,
        .steps {
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
        }

        .card,
        .step {
          padding: 28px 24px;
        }

        .stats {
          grid-template-columns: repeat(4, 1fr);
          gap: 18px;
          padding: 34px 24px;
        }

        .final {
          padding: 70px 0;
        }

        .final-card {
          padding: 54px 40px;
        }

        .foot-bot {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }

        .mobile-cta {
          display: none;
        }
      }

      @media (min-width: 920px) {
        .hero-grid {
          grid-template-columns: 1.02fr 0.98fr;
          gap: 48px;
        }
      }
    </style>
  </head>

  <body>
    <div class="bg-fx" aria-hidden="true">
      <div class="grid-lines"></div>
      <div class="glow g1"></div>
      <div class="glow g2"></div>
    </div>

    <header>
      <div class="wrap topbar">
        <div class="logo"><span class="mark">S</span><span class="name">Smart<b>Stock</b></span></div>
        <span class="badge-sg"><span class="dot"></span>SGX · US · HK Markets</span>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="reveal">
            <span class="eyebrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"></path><path d="M21 7v5h-5"></path></svg>
              Weekly Research · Free
            </span>
            <h1>Claim Your Free <span class="hl">Stock Research Report</span></h1>
            <p class="lede">Every week, our analysts share the <b>high-potential stocks they're watching</b> across SGX, US and HK markets — with the data, charts and reasoning behind each idea.</p>
