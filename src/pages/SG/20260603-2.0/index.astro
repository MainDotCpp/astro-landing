---
import RedirectCode from '@/components/RedirectCode.astro'
import heroLifestyle from './assets/images/hero-lifestyle.png'
import phoneBrief from './assets/images/phone-brief.png'
import finalSkyline from './assets/images/final-skyline.png'
import proofBg from './assets/images/proof-bg.png'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Free Singapore Market Briefings on WhatsApp — Join 9,000+ Investors</title>
    <meta
      name="description"
      content="Join 9,000+ Singaporeans who get a free 3-minute market brief every trading morning on WhatsApp — SGX, S-REITs, local banks, CPF & SRS. No hot tips, no guaranteed wins. Free, leave anytime."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style define:vars={{ hero: `url(${heroLifestyle.src})`, phone: `url(${phoneBrief.src})`, final: `url(${finalSkyline.src})`, proof: `url(${proofBg.src})` }}>
      /* =========================================================
         MOBILE-FIRST — base styles = ~390px phone.
         Larger layouts added with @media (min-width: …) only.
         ========================================================= */
      :root {
        --bg:       #F4F6F9;
        --surface:  #FFFFFF;
        --ink:      #0E1729;
        --ink-mut:  #5A6577;
        --indigo:   #10245C;
        --indigo-2: #1A327A;
        --blue:     #2D6BFF;
        --wa:       #25D366;
        --wa-d:     #1FB855;
        --gold:     #F5A623;
        --green:    #16A34A;
        --line:     #E4E8EF;
        --line-2:   #D2D9E4;
        --sans:     'Plus Jakarta Sans', system-ui, sans-serif;
        --mono:     'IBM Plex Mono', ui-monospace, monospace;
        --maxw:     1140px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

      body {
        font-family: var(--sans);
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
        font-size: 16.5px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: 82px; /* sticky CTA room on phones */
      }

      .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: 18px; }
      a { color: inherit; text-decoration: none; }
      h1, h2, h3 { line-height: 1.12; letter-spacing: -0.02em; font-weight: 800; }

      .mono { font-family: var(--mono); }
      .hl { color: var(--blue); }
      .hl-gold { background: linear-gradient(transparent 58%, rgba(245,166,35,.38) 58%); }

      /* ===== buttons ===== */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        font-family: var(--sans); font-weight: 800; font-size: 1.08rem; color: #fff;
        background: var(--wa); padding: 17px 26px; border-radius: 14px; cursor: pointer; border: none;
        transition: background .2s ease, transform .15s ease, box-shadow .25s ease;
        white-space: nowrap; box-shadow: 0 14px 30px -10px rgba(37, 211, 102, .6);
        width: 100%; /* full-width on phones */
      }
      .btn svg { width: 23px; height: 23px; flex-shrink: 0; }
      .btn:hover { background: var(--wa-d); transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn.pulse { animation: pulse 2.6s ease-in-out infinite; }
      @keyframes pulse { 0%,100% { box-shadow: 0 14px 30px -10px rgba(37,211,102,.55) } 50% { box-shadow: 0 16px 40px -6px rgba(37,211,102,.8) } }

      .micro { font-size: .82rem; color: var(--ink-mut); display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
      .micro .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--gold); }
      .micro svg { width: 15px; height: 15px; color: var(--green); }

      section { position: relative; }
      .sec { padding-block: clamp(44px, 10vw, 88px); }

      .kicker { font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); }
      .sec-head { max-width: 640px; margin-bottom: 30px; }
      .sec-head h2 { font-size: clamp(1.7rem, 6.5vw, 2.55rem); margin-top: 10px; }
      .sec-head p { color: var(--ink-mut); margin-top: 12px; font-size: 1.02rem; }

      /* ===== HERO (base: single column) ===== */
      .hero { padding-top: 26px; }
      .hero h1 { font-size: clamp(2.1rem, 9.5vw, 3.05rem); }
      .hero h1 .wa-word { color: var(--wa-d); }
      .hero .lead { font-size: 1.08rem; color: var(--ink-mut); margin-top: 18px; max-width: 540px; }
      .hero .lead b { color: var(--ink); font-weight: 700; }
      .hero-cta { margin-top: 24px; }
      .hero-cta .micro { margin-top: 14px; }

      .hero-photo {
        margin-top: 30px; border-radius: 20px; overflow: hidden; position: relative;
        aspect-ratio: 1024 / 1180; background-image: var(--hero); background-size: cover; background-position: center 22%;
        box-shadow: 0 30px 60px -28px rgba(16, 36, 92, .5);
      }
      /* ===== SOCIAL PROOF (parallax bg via fixed) ===== */
      .proof {
        background-image: linear-gradient(rgba(16,36,92,.72), rgba(11,24,64,.86)), var(--proof);
        background-size: cover; background-position: center; background-repeat: no-repeat;
        background-attachment: scroll; /* mobile: static (iOS fixed unreliable) */
        color: #fff;
      }
      .stats { display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.14); border-radius: 16px; overflow: hidden; }
      .stat { background: var(--indigo); padding: 20px; text-align: center; }
      .stat .v { font-family: var(--mono); font-weight: 600; font-size: clamp(1.8rem, 8vw, 2.4rem); color: #fff; }
      .stat .v .pl { color: var(--gold); }
      .stat .v .stars { color: var(--gold); font-size: 1.4rem; letter-spacing: 2px; }
      .stat .l { font-size: .84rem; color: #AEBBD6; margin-top: 5px; }

      .reviews { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 26px; }
      .review { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 20px; }
      .review .stars { color: var(--gold); letter-spacing: 1px; font-size: .9rem; }
      .review p { margin-top: 10px; font-size: .98rem; line-height: 1.55; color: #EAEFF9; }
      .review .who { display: flex; align-items: center; gap: 11px; margin-top: 15px; }
      .review .who .av { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: .9rem; color: #fff; flex-shrink: 0; }
      .review .who .n { font-weight: 700; font-size: .9rem; }
      .review .who .t { font-size: .76rem; color: #AEBBD6; }

      /* ===== LOCAL CHIPS ===== */
      .local { text-align: center; }
      .local .kicker { color: var(--blue); }
      .local h2 { font-size: clamp(1.5rem, 5.5vw, 2.1rem); margin: 10px auto 22px; max-width: 620px; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
      .chip { font-family: var(--mono); font-weight: 500; font-size: .9rem; color: var(--indigo); background: #fff; border: 1px solid var(--line-2); border-radius: 10px; padding: 9px 15px; }
      .chip b { color: var(--blue); }

      /* ===== BENEFITS ===== */
      .benefits-layout { display: grid; grid-template-columns: 1fr; gap: 28px; margin-top: 30px; }
      .benefits-aside { order: -1; }
      .benefits-phone { width: 100%; max-width: 264px; margin-inline: auto; aspect-ratio: 1024 / 1536; background-image: var(--phone); background-size: cover; background-position: center; border-radius: 20px; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(16,36,92,.5); }
      .phone-cap { text-align: center; font-size: .85rem; color: var(--ink-mut); margin: 12px auto 0; max-width: 280px; }
      .benefits { display: grid; grid-template-columns: 1fr; gap: 14px; }
      .benefit { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 22px; display: flex; gap: 15px; align-items: flex-start; transition: transform .2s ease, box-shadow .2s ease; }
      .benefit:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -26px rgba(16,36,92,.4); }
      .benefit .ic { width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0; display: grid; place-items: center; background: #EAF0FF; color: var(--blue); }
      .benefit .ic svg { width: 23px; height: 23px; }
      .benefit h3 { font-size: 1.1rem; font-weight: 700; }
      .benefit p { color: var(--ink-mut); font-size: .94rem; margin-top: 5px; }
      .benefit.free .ic { background: #E6F8EE; color: var(--green); }

      /* ===== STEPS ===== */
      .steps { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 30px; counter-reset: s; }
      .step { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px; position: relative; }
      .step .no { font-family: var(--mono); font-weight: 600; font-size: 1.6rem; color: #fff; background: var(--blue); width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; margin-bottom: 13px; }
      .step h3 { font-size: 1.12rem; font-weight: 700; }
      .step p { color: var(--ink-mut); font-size: .94rem; margin-top: 6px; }

      /* ===== STRAIGHT TALK ===== */
      .straight { background: linear-gradient(150deg, var(--indigo), var(--indigo-2)); color: #fff; border-radius: 20px; padding: clamp(28px, 7vw, 52px); }
      .straight .kicker { color: var(--gold); }
      .straight h2 { font-size: clamp(1.5rem, 5.5vw, 2.2rem); margin-top: 12px; max-width: 720px; }
      .straight p { color: #C7D2EA; margin-top: 16px; max-width: 680px; font-size: 1.02rem; }
      .straight p b { color: #fff; font-weight: 700; }

      /* ===== FINAL (full-bleed, no radius) ===== */
      .final { text-align: center; position: relative; overflow: hidden; padding-block: clamp(54px, 11vw, 100px); color: #fff; }
      .final-body { position: relative; z-index: 2; }
      .final::before { content: ''; position: absolute; inset: 0; background-image: var(--final); background-size: cover; background-position: center 30%; z-index: 0; }
      .final::after { content: ''; position: absolute; inset: 0; background: linear-gradient(165deg, rgba(16,36,92,.82), rgba(10,22,58,.93)); z-index: 1; }
      .final > * { position: relative; z-index: 2; }
      .final .kicker { color: var(--gold); }
      .final h2 { font-size: clamp(1.9rem, 7vw, 2.9rem); max-width: 680px; margin-inline: auto; color: #fff; }
      .final h2 .hl { color: var(--gold); }
      .final p { color: #C7D2EA; max-width: 500px; margin: 14px auto 0; }
      .final-cta { margin-top: 26px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .final-cta .btn { max-width: 440px; }
      .final-cta .micro { color: #AEBBD6; }

      /* ===== footer ===== */
      .foot { border-top: 1px solid var(--line); padding-block: 26px 8px; margin-top: clamp(40px, 8vw, 64px); }
      .foot .disc { color: var(--ink-mut); font-size: .78rem; line-height: 1.7; max-width: 880px; }
      .foot .row { display: flex; flex-wrap: wrap; gap: 10px 20px; justify-content: space-between; align-items: center; margin-top: 16px; font-size: .76rem; color: var(--ink-mut); }

      /* ===== sticky CTA (base: visible on phones) ===== */
      .sticky { position: fixed; bottom: 0; inset-inline: 0; z-index: 60; display: block; padding: 9px 14px calc(9px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.95); backdrop-filter: blur(12px); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px -16px rgba(16,36,92,.4); }
      .sticky .btn { padding: 14px; }

      /* ===== reveal ===== */
      .reveal { opacity: 0; transform: translateY(20px); transition: opacity .65s cubic-bezier(.2,.7,.3,1), transform .65s cubic-bezier(.2,.7,.3,1); }
      .reveal.in { opacity: 1; transform: none; }
      .reveal[data-d="1"] { transition-delay: .07s; }
      .reveal[data-d="2"] { transition-delay: .14s; }
      .reveal[data-d="3"] { transition-delay: .21s; }

      /* =========================================================
         ≥ 600px — tablets
         ========================================================= */
      @media (min-width: 600px) {
        .wrap { padding-inline: 24px; }
        body { padding-bottom: 0; }
        .btn { width: auto; }
        .stats { grid-template-columns: repeat(3, 1fr); }
        .reviews { grid-template-columns: repeat(2, 1fr); }
        .benefits { grid-template-columns: repeat(2, 1fr); }
        .steps { grid-template-columns: repeat(3, 1fr); }
        .sticky { display: none; }
        .hero-cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
        .hero-cta .btn { width: auto; }
        .hero-cta .micro { margin-top: 0; }
      }

      /* =========================================================
         ≥ 980px — desktop: hero two-column, reviews three-up
         ========================================================= */
      @media (min-width: 980px) {
        .hero { padding-top: 44px; }
        .hero-grid { display: grid; grid-template-columns: 1.06fr 0.94fr; gap: 56px; align-items: center; }
        .hero h1 { font-size: clamp(3rem, 4.2vw, 3.7rem); }
        .hero .lead { font-size: 1.18rem; }
        .hero-photo { margin-top: 0; aspect-ratio: 1024 / 1320; }
        .reviews { grid-template-columns: repeat(3, 1fr); }
        .benefits-layout { grid-template-columns: 0.82fr 1.18fr; gap: 46px; align-items: center; }
        .benefits-aside { order: 0; }
        .benefits-phone { max-width: none; }
        .benefits { grid-template-columns: repeat(2, 1fr); }
        .proof { background-attachment: fixed; } /* desktop: parallax */
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .btn.pulse { animation: none; }
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body>
    <main>
      <!-- ===== HERO (no top nav) ===== -->
      <section class="hero wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <h1 class="reveal" data-d="1">
              A free Singapore market brief, <span class="hl-gold">every morning</span> — on <span class="wa-word">WhatsApp</span>.
            </h1>
            <p class="lead reveal" data-d="2">
              Join <b>9,000+ Singaporeans</b> who start the day with a 3-minute brief: what moved overnight, why <b>S-REITs and the local banks</b> are moving, and one thing to watch. No hot tips. No sure-win. Just clarity — <b>free</b>, and leave anytime.
            </p>
            <div class="hero-cta reveal" data-d="3">
              <a class="btn pulse link-btn" onclick="mixinJump()">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z"/></svg>
                Join free on WhatsApp
              </a>
              <span class="micro">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                Free forever <span class="dot"></span> No spam <span class="dot"></span> Leave anytime
              </span>
            </div>
          </div>

          <div class="hero-photo reveal" data-d="2"></div>
        </div>
      </section>

      <!-- ===== SOCIAL PROOF ===== -->
      <section class="proof sec">
        <div class="wrap">
          <div class="stats reveal">
            <div class="stat"><div class="v"><span class="count" data-to="9000" data-suffix="+">0</span></div><div class="l">Singapore investors</div></div>
            <div class="stat"><div class="v">4.8<span class="stars"> ★</span></div><div class="l">Average member rating</div></div>
            <div class="stat"><div class="v">Daily</div><div class="l">A fresh brief each morning</div></div>
          </div>

          <div class="reviews">
            <div class="review reveal" data-d="1">
              <div class="stars">★★★★★</div>
              <p>"Finally a group that explains the why, not just 'buy this.' I've actually stopped panic-selling my REITs."</p>
              <div class="who"><span class="av" style="background:#2D6BFF">MT</span><span><span class="n">Marcus T.</span><span class="t">Bedok</span></span></div>
            </div>
            <div class="review reveal" data-d="2">
              <div class="stars">★★★★★</div>
              <p>"The morning brief is the only finance thing I read daily. Three minutes and I know what's going on. That's it."</p>
              <div class="who"><span class="av" style="background:#16A34A">PS</span><span><span class="n">Priya S.</span><span class="t">CPF / SRS investor</span></span></div>
            </div>
            <div class="review reveal" data-d="3">
              <div class="stars">★★★★★</div>
              <p>"No one's pushing a course or a 'sure-win' stock. Just solid, local discussion about SGX and the banks. Refreshing."</p>
              <div class="who"><span class="av" style="background:#F5A623">WL</span><span><span class="n">Wei Lin</span><span class="t">long-time OCBC shareholder</span></span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== LOCAL TRUST CHIPS ===== -->
      <section class="sec wrap local">
        <span class="kicker reveal">Built for Singapore</span>
        <h2 class="reveal">Around what you actually hold — not generic US content</h2>
        <div class="chips reveal" data-d="1">
          <span class="chip"><b>SGX</b> stocks</span>
          <span class="chip"><b>S-REITs</b></span>
          <span class="chip">STI <b>ETF</b></span>
          <span class="chip"><b>CPF</b> / SRS</span>
          <span class="chip">DBS</span>
          <span class="chip">OCBC</span>
          <span class="chip">UOB</span>
          <span class="chip">SGD &amp; rates</span>
        </div>
      </section>

      <!-- ===== BENEFITS ===== -->
      <section class="sec wrap">
        <div class="sec-head reveal">
          <span class="kicker">What you get — free</span>
          <h2>Everything that helps, <span class="hl">nothing that sells.</span></h2>
        </div>
        <div class="benefits-layout">
          <div class="benefits-aside reveal">
            <div class="benefits-phone"></div>
            <p class="phone-cap">This is the morning brief — short, clear, and in your chat by the time you're up.</p>
          </div>
          <div class="benefits">
          <div class="benefit reveal" data-d="1">
            <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <div><h3>A morning brief, every trading day</h3><p>What happened on Wall Street overnight, the Asia open, rates and FX — the day's backdrop in about 3 minutes.</p></div>
          </div>
          <div class="benefit reveal" data-d="1">
            <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16h16"/><path d="M4 14l4-4 4 3 7-7"/></svg></span>
            <div><h3>S-REITs &amp; bank moves, explained</h3><p>When a REIT or the banks move, we talk rates, gearing, occupancy and DPU — the why, not just buy or sell.</p></div>
          </div>
          <div class="benefit reveal" data-d="2">
            <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16M8 16l3-4 3 2 4-6"/></svg></span>
            <div><h3>Weekly recaps &amp; monthly deep-dives</h3><p>The week in review, plus one theme done properly — REITs 101, ETF allocation, CPF/SRS, managing risk.</p></div>
          </div>
          <div class="benefit reveal" data-d="2">
            <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><h3>A risk-first community</h3><p>Position sizing, diversification and the long view — the habits that keep beginners out of the usual traps.</p></div>
          </div>
          <div class="benefit free reveal" data-d="3">
            <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7"/><path d="M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
            <div><h3>Zero cost, zero pressure</h3><p>Join free, read the next brief, and stay only if it's useful. Not for you? Leave anytime — no fuss.</p></div>
          </div>
          </div>
        </div>
      </section>

      <!-- ===== STEPS ===== -->
      <section class="sec wrap">
        <div class="sec-head reveal">
          <span class="kicker">Takes 10 seconds</span>
          <h2>How to join</h2>
        </div>
        <div class="steps">
          <div class="step reveal" data-d="1">
            <div class="no">1</div>
            <h3>Tap the button</h3>
            <p>Opens WhatsApp in one tap. No long forms, no sign-up.</p>
          </div>
          <div class="step reveal" data-d="2">
            <div class="no">2</div>
            <h3>You're in</h3>
