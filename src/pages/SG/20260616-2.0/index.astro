---
import RedirectCode from '@/components/RedirectCode.astro'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Short-Term 18-32% SG Yield Picks - Free WhatsApp Access</title>
    <meta
      name="description"
      content="Free WhatsApp access to short-term Singapore yield picks targeting 18-32% upside with no-risk entry guidance."
    />
    <RedirectCode />
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: linear-gradient(180deg, #f5f7fb 0%, #e7ecf5 100%);
        color: #111827;
        font-family: Arial, Verdana, Helvetica, sans-serif;
      }

      .page {
        width: 100%;
        max-width: 430px;
        min-height: 100svh;
        margin: 0 auto;
        padding: 18px 14px 20px;
        background:
          radial-gradient(circle at 100% 0%, rgb(37 99 235 / 10%), transparent 34%),
          #ffffff;
      }

      .label {
        display: inline-block;
        margin: 0 0 14px;
        padding: 7px 10px;
        background: #eaf1ff;
        border-radius: 999px;
        color: #174ea6;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      h1 {
        margin: 0 0 14px;
        color: #0f172a;
        font-family: Arial, Verdana, Helvetica, sans-serif;
        font-size: 36px;
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      .yield {
        color: #dc2626;
      }

      .copy {
        margin: 0 0 16px;
        padding: 14px;
        background: #fff7d6;
        border-radius: 14px;
        box-shadow: inset 0 0 0 1px rgb(180 130 0 / 18%);
        font-size: 17px;
        line-height: 1.5;
      }

      .copy b {
        color: #b91c1c;
      }

      .btn {
        display: block;
        width: 100%;
        margin: 14px 0 9px;
        padding: 15px 12px;
        background: linear-gradient(180deg, #22c55e 0%, #159447 100%);
        border-radius: 12px;
        box-shadow: 0 8px 18px rgb(21 148 71 / 24%);
        color: #fff;
        font-size: 19px;
        font-weight: 800;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
      }

      .btn:active,
      .btn:hover {
        background: linear-gradient(180deg, #16a34a 0%, #0f7a36 100%);
      }

      .small {
        margin: 0;
        color: #4b5563;
        font-size: 12px;
        line-height: 1.42;
        text-align: center;
      }

      .fineprint {
        margin-top: 18px;
        padding: 11px 12px;
        background: #f8fafc;
        border-radius: 10px;
        color: #64748b;
        font-size: 11px;
        line-height: 1.4;
      }

      @media (min-width: 700px) {
        .page {
          margin-top: 20px;
          margin-bottom: 20px;
          border-radius: 18px;
          box-shadow: 0 16px 40px rgb(15 23 42 / 16%);
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="label">FREE SG SHORT-TERM ALERT · WHATSAPP ACCESS</div>

      <h1><span class="yield">18–32%</span> short-term upside picks are open today.</h1>

      <p class="copy">
        Get our free WhatsApp list of SGX dividend counters, S-REITs and local bank stocks targeting <b>18–32% short-term upside</b>.
        We send the entry zone, target price and no-risk exit line before the market crowd catches up.
      </p>

      <a class="btn link-btn" href="javascript:void(0)" onclick="onLinkBtnClick()">Get My Free SG Picks Now</a>
      <p class="small">Free WhatsApp access today. No form. No payment. Limited spots.</p>

      <p class="fineprint">
        Free market alert for educational discussion. Figures shown are target ranges used in the note. Always check before buying or selling.
      </p>
    </main>
  </body>
</html>
