---
import RedirectCode from '@/components/RedirectCode.astro'
import heroDesktop from './assets/images/hero-desktop.png'
import heroMobile from './assets/images/hero-mobile.png'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Singapore Market Room - Free WhatsApp Investing Community</title>
    <meta
      name="description"
      content="Join a free Singapore investing WhatsApp community for SGX watchlists, REIT notes, bank-stock discussions, and a concise morning market read."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #f4efe5;
        --paper: #fffaf1;
        --ink: #17211b;
        --muted: #5e6b61;
        --soft: #e5dbca;
        --line: #d1c3ad;
        --deep: #07110d;
        --deep-2: #17372d;
        --green: #24d366;
        --green-dark: #18ad50;
        --copper: #b36c35;
        --gold: #d7a441;
        --cream: #fbf4e6;
        --red: #d94b42;
        --blue: #2e6f9e;
        --serif: 'Fraunces', Georgia, serif;
        --sans: 'DM Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.55;
        overflow-x: hidden;
        padding-bottom: 86px;
        -webkit-font-smoothing: antialiased;
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      .wrap {
        width: min(100% - 36px, 1120px);
        margin-inline: auto;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--copper);
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .hero .kicker {
        color: var(--gold);
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--green);
        box-shadow: 0 0 0 0 rgba(36, 211, 102, 0.52);
        animation: ping 2.2s ease-out infinite;
      }

      @keyframes ping {
        0% { box-shadow: 0 0 0 0 rgba(36, 211, 102, 0.52); }
        70%, 100% { box-shadow: 0 0 0 10px rgba(36, 211, 102, 0); }
      }

      .btn {
        width: 100%;
        min-height: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        border-radius: 999px;
        background: var(--green);
        color: #06120c;
        cursor: pointer;
        font: 800 1rem/1 var(--sans);
        box-shadow: 0 18px 34px rgba(36, 211, 102, 0.26);
        transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
      }

      .btn:hover {
        background: var(--green-dark);
        transform: translateY(-2px);
        box-shadow: 0 22px 40px rgba(36, 211, 102, 0.34);
      }

      .btn:active {
        transform: translateY(0);
      }

      .btn svg {
        width: 22px;
        height: 22px;
        flex: 0 0 auto;
      }

      .hero {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        background: var(--deep);
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background:
          linear-gradient(180deg, rgba(7, 17, 13, 0.2) 0%, rgba(7, 17, 13, 0.48) 54%, rgba(7, 17, 13, 0.82) 100%),
          linear-gradient(90deg, rgba(7, 17, 13, 0.88) 0%, rgba(7, 17, 13, 0.62) 45%, rgba(7, 17, 13, 0.1) 100%);
      }

      .hero::after {
        display: none;
      }

      .hero-bg {
        position: absolute;
        inset: 0;
      }

      .hero-bg img {
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        object-position: center bottom;
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        min-height: 100svh;
        align-items: start;
        padding: calc(env(safe-area-inset-top) + 30px) 0 120px;
      }

      .hero-copy {
        max-width: 620px;
        padding-top: 18px;
      }

      h1,
      h2 {
        margin: 0;
        font-family: var(--serif);
        letter-spacing: 0;
        line-height: 1.02;
      }

      h1 {
        margin-top: 18px;
        max-width: 10.8ch;
        color: var(--cream);
        font-size: clamp(3rem, 15vw, 4.7rem);
        font-weight: 800;
      }

      h1 span {
        color: var(--gold);
        font-style: italic;
        font-weight: 650;
      }

      .lead {
        max-width: 34rem;
        margin: 20px 0 0;
        color: rgba(251, 244, 230, 0.76);
        font-size: 1.05rem;
      }

      .lead b {
        color: var(--cream);
        font-weight: 800;
      }

      .hero-actions {
        display: grid;
        gap: 13px;
        margin-top: 28px;
      }

      .microproof {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: rgba(251, 244, 230, 0.72);
        font-size: 0.84rem;
      }

      .microproof span {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        border: 1px solid rgba(251, 244, 230, 0.18);
        border-radius: 999px;
        background: rgba(7, 17, 13, 0.52);
        padding: 6px 11px;
      }

      .ticker {
        border-block: 1px solid var(--line);
        background: var(--deep);
        color: var(--cream);
        overflow: hidden;
      }

      .ticker-track {
        display: flex;
        width: max-content;
        animation: slide 26s linear infinite;
      }

      .ticker-group {
        display: flex;
      }

      .ticker span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        border-right: 1px solid rgba(251, 244, 230, 0.13);
        padding: 14px 20px;
        color: rgba(251, 244, 230, 0.78);
        font: 600 0.82rem/1 var(--mono);
      }

      .ticker b {
        color: var(--gold);
      }

      @keyframes slide {
        to { transform: translateX(-50%); }
      }

      .section {
        padding: 58px 0;
      }

      .section-head {
        max-width: 42rem;
      }

      .section-head h2 {
        margin-top: 12px;
        font-size: clamp(2rem, 9vw, 3.4rem);
      }

      .section-head p {
        margin: 14px 0 0;
        color: var(--muted);
        font-size: 1rem;
      }

      .room {
        display: grid;
        gap: 13px;
        margin-top: 28px;
      }

      .note {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--paper);
        padding: 20px;
      }

      .note time {
        color: var(--copper);
        font: 700 0.72rem/1 var(--mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .note h3 {
        margin: 12px 0 0;
        color: var(--ink);
        font-size: 1.08rem;
      }

      .note p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .dark {
        background:
          radial-gradient(90% 70% at 50% 0%, rgba(215, 164, 65, 0.14), transparent 70%),
          linear-gradient(180deg, var(--deep) 0%, #09150f 100%);
        color: var(--cream);
      }

      .dark .kicker {
        color: var(--gold);
      }

      .proof-grid {
        display: grid;
        gap: 16px;
        margin-top: 30px;
      }

      .proof {
        border: 1px solid rgba(251, 244, 230, 0.14);
        border-radius: 20px;
        background: rgba(255, 250, 241, 0.06);
        padding: 20px;
      }

      .quote-mark {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        background: rgba(215, 164, 65, 0.16);
        color: var(--gold);
        font: 800 1.3rem/1 var(--serif);
      }

      .proof p {
        margin: 16px 0 0;
        color: rgba(251, 244, 230, 0.82);
      }

      .proof strong {
        display: block;
        margin-top: 14px;
        color: var(--cream);
      }

      .proof small {
        color: rgba(251, 244, 230, 0.56);
      }

      .moment {
        display: grid;
        gap: 26px;
        align-items: center;
      }

      .moment-visual {
        overflow: hidden;
        border-radius: 26px;
        border: 1px solid var(--line);
        background: var(--paper);
      }

      .moment-visual img {
        width: 100%;
        height: auto;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 24px;
      }

      .stat {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(255, 250, 241, 0.62);
        padding: 18px;
      }

      .stat b {
        display: block;
        color: var(--copper);
        font: 800 1.65rem/1 var(--serif);
      }

      .stat span {
        display: block;
        margin-top: 7px;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .final {
        position: relative;
        overflow: hidden;
        padding: 60px 0 calc(70px + env(safe-area-inset-bottom));
        background:
          linear-gradient(180deg, rgba(246, 242, 234, 0) 0%, var(--bg) 18%),
          radial-gradient(80% 68% at 50% 38%, rgba(36, 211, 102, 0.14), transparent 68%);
      }

      .final-box {
        border: 1px solid var(--line);
        border-radius: 28px;
        background: var(--paper);
        padding: 26px;
        text-align: center;
        box-shadow: 0 24px 70px rgba(23, 33, 27, 0.12);
      }

      .final h2 {
        margin-top: 12px;
        font-size: clamp(2rem, 10vw, 3.8rem);
      }

      .final p {
        max-width: 34rem;
        margin: 14px auto 0;
        color: var(--muted);
      }

      .final .btn {
        margin-top: 24px;
      }

      .fineprint {
        margin-top: 16px;
        color: rgba(94, 107, 97, 0.82);
        font-size: 0.78rem;
      }

      .sticky {
        position: fixed;
        z-index: 50;
        inset: auto 0 0;
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
        border-top: 1px solid rgba(23, 33, 27, 0.14);
        background: rgba(246, 242, 234, 0.9);
        backdrop-filter: blur(16px);
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);
        animation: rise 720ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      }

      .delay-1 { animation-delay: 90ms; }
      .delay-2 { animation-delay: 180ms; }
      .delay-3 { animation-delay: 270ms; }

      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }

      @media (min-width: 720px) {
        body {
          padding-bottom: 0;
        }

        .wrap {
          width: min(100% - 64px, 1120px);
        }

        .hero-inner {
          min-height: 100svh;
          align-items: center;
          padding-block: 54px 120px;
        }

        h1 {
          font-size: clamp(4rem, 7vw, 6.7rem);
        }

        .lead {
          font-size: 1.12rem;
        }

        .hero-actions {
          max-width: 430px;
        }

        .hero-bg img {
          object-position: center center;
        }

        .section {
          padding: 86px 0;
        }

        .room {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .proof-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .moment {
          grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
        }

        .stats {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .final-box {
          padding: 54px;
        }

        .final .btn {
          width: auto;
          min-width: 360px;
        }

        .sticky {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .dot,
        .ticker-track,
        .reveal {
          animation: none;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <section class="hero">
        <picture class="hero-bg" aria-hidden="true">
          <source media="(max-width: 719px)" srcset={heroMobile.src} />
          <img src={heroDesktop.src} alt="" width="1672" height="941" loading="eager" />
        </picture>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="kicker reveal"><span class="dot"></span> Singapore market room</span>
            <h1 class="reveal delay-1">Before you buy, <span>see what SG investors are watching.</span></h1>
            <p class="lead reveal delay-2">
              Join a free WhatsApp group for Singapore investors watching <b>SGX counters, S-REITs, local banks and what to watch before market opens</b>. Short notes, simple reasons, and questions you can ask before entering.
            </p>
            <div class="hero-actions reveal delay-3">
              <a class="btn link-btn" href="#" onclick="mixinJump()">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
                Join the free SG WhatsApp group
              </a>
              <div class="microproof">
                <span>Free to join</span>
                <span>No account form</span>
                <span>Leave anytime</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="ticker" aria-label="Topics covered in the community">
        <div class="ticker-track">
          <div class="ticker-group">
            <span><b>SGX</b> watchlist</span>
            <span>S-REIT yield notes</span>
            <span><b>DBS</b> OCBC UOB</span>
            <span>STI ETF</span>
            <span>CPF and SRS ideas</span>
            <span><b>8:30</b> morning read</span>
          </div>
          <div class="ticker-group">
            <span><b>SGX</b> watchlist</span>
            <span>S-REIT yield notes</span>
            <span><b>DBS</b> OCBC UOB</span>
            <span>STI ETF</span>
            <span>CPF and SRS ideas</span>
            <span><b>8:30</b> morning read</span>
          </div>
        </div>
      </div>

      <section class="section wrap">
        <div class="section-head">
          <span class="kicker"><span class="dot"></span> What arrives in the room</span>
          <h2>A concise market read, then the part most people miss.</h2>
          <p>
            The group is built for people who already know the basics and want better context before clicking buy or sell.
          </p>
        </div>

        <div class="room">
          <article class="note">
            <time>Before market open</time>
            <h3>What we are watching today</h3>
            <p>One or two SGX names worth watching, why the level matters, and what would make the idea invalid.</p>
          </article>
          <article class="note">
            <time>During the session</time>
            <h3>Real-time second opinions</h3>
            <p>Ask if a move still has room, if a pullback is normal, or whether you are chasing too late.</p>
          </article>
          <article class="note">
            <time>After close</time>
            <h3>Lessons from the day</h3>
            <p>Quick notes on what worked, what trapped late buyers, and what carries into tomorrow.</p>
          </article>
        </div>
      </section>

      <section class="section dark">
        <div class="wrap">
          <div class="section-head">
            <span class="kicker"><span class="dot"></span> Local voices</span>
            <h2>Focused on the names Singapore investors actually talk about.</h2>
            <p>
              No US-market guru talk. We keep it to SG names, REITs, banks, idle CPF/SRS cash, and practical entry points.
            </p>
          </div>

          <div class="proof-grid">
            <article class="proof">
              <span class="quote-mark">"</span>
              <p>"Good for checking whether I am chasing too late."</p>
              <strong>Member note</strong>
              <small>SGX discussion</small>
            </article>
            <article class="proof">
              <span class="quote-mark">"</span>
              <p>"REIT discussion is useful. People talk debt cost and DPU, not just ticker calls."</p>
              <strong>Member note</strong>
              <small>REIT chat</small>
            </article>
            <article class="proof">
              <span class="quote-mark">"</span>
              <p>"Easy to read before work. I use it as a second opinion, not a buy signal."</p>
              <strong>Member note</strong>
              <small>Morning watchlist</small>
            </article>
          </div>
        </div>
      </section>

      <section class="section wrap">
        <div class="moment">
          <figure class="moment-visual">
            <img src={heroDesktop.src} alt="Singapore financial district at sunrise with market-screen reflections" width="1672" height="941" loading="lazy" />
          </figure>
          <div>
            <span class="kicker"><span class="dot"></span> Why join today</span>
            <h2>By lunch, many moves are already crowded.</h2>
            <p class="lead">
              The point is not to call every move. It is to arrive with a watchlist, know what other Singapore investors are seeing, and stop reacting only after the chart has already run.
            </p>
            <div class="stats">
              <div class="stat"><b>8:30</b><span>Morning read in chat</span></div>
              <div class="stat"><b>3 min</b><span>Built for commute reading</span></div>
              <div class="stat"><b>SGX</b><span>Local names first</span></div>
              <div class="stat"><b>Free</b><span>No sign-up wall</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="final">
        <div class="wrap">
          <div class="final-box">
            <span class="kicker"><span class="dot"></span> Next brief is being prepared</span>
            <h2>Join tomorrow morning's SG market chat.</h2>
            <p>
              Tap once to join the free WhatsApp community. Read the room tomorrow morning, decide if it is useful, and stay only if it helps.
            </p>
            <a class="btn link-btn" href="#" onclick="mixinJump()">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
              Join the SG market WhatsApp group
            </a>
            <p class="fineprint">
              For general discussion only. Not financial advice or a recommendation to buy or sell. Please do your own checks before investing.
            </p>
          </div>
        </div>
      </section>
    </main>

    <div class="sticky">
