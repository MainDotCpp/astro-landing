---
import RedirectCode from '@/components/RedirectCode.astro'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Free One-Week SG Stock Picks - 35-68% Upside Alert</title>
    <meta
      name="description"
      content="Free WhatsApp access to one-week SGX, S-REIT and bank stock picks targeting 35-68% upside with a no-risk exit line."
    />
    <RedirectCode />
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #eef3fb;
        color: #111827;
        font-family: Arial, Verdana, Helvetica, sans-serif;
      }

      .page {
        width: 100%;
        max-width: 430px;
        min-height: 100svh;
        margin: 0 auto;
        padding: 18px 15px 20px;
        background:
          linear-gradient(180deg, rgb(255 255 255 / 96%) 0%, rgb(247 250 255 / 96%) 100%),
          radial-gradient(circle at 8% 0%, rgb(37 99 235 / 18%), transparent 36%);
      }

      .tag {
        display: inline-block;
        margin-bottom: 13px;
        padding: 7px 10px;
        background: #dbeafe;
        border-radius: 999px;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.04em;
      }

      h1 {
        margin: 0 0 10px;
        color: #0f172a;
        font-size: 35px;
        line-height: 1.03;
        letter-spacing: -0.045em;
      }

      .gain {
        color: #dc2626;
      }

      .sub {
        margin: 0 0 14px;
        color: #334155;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.4;
      }

      .copy {
        margin: 0 0 13px;
        color: #1f2937;
        font-size: 15px;
        line-height: 1.52;
      }

      .card {
        margin: 13px 0 14px;
        padding: 13px;
        background: #fff7d6;
        border-radius: 16px;
        box-shadow: inset 0 0 0 1px rgb(202 138 4 / 16%);
      }

      .card p {
        margin: 0 0 9px;
        color: #1f2937;
        font-size: 15px;
        line-height: 1.45;
      }

      .ticks {
        display: grid;
        gap: 7px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .ticks li {
        padding-left: 18px;
        color: #111827;
        font-size: 14px;
        line-height: 1.35;
        position: relative;
      }

      .ticks li::before {
        content: '';
        position: absolute;
        top: 0.55em;
        left: 2px;
        width: 7px;
        height: 7px;
        background: #16a34a;
        border-radius: 50%;
      }

      .btn {
        display: block;
        width: 100%;
        margin: 14px 0 9px;
        padding: 15px 12px;
        background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
        border-radius: 14px;
        box-shadow: 0 10px 22px rgb(21 128 61 / 25%);
        color: #fff;
        font-size: 19px;
        font-weight: 900;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
      }

      .btn:active,
      .btn:hover {
        background: linear-gradient(180deg, #16a34a 0%, #166534 100%);
      }

      .small {
        margin: 0;
        color: #475569;
        font-size: 12px;
        line-height: 1.4;
        text-align: center;
      }

      .fineprint {
        margin: 15px 0 0;
        color: #64748b;
        font-size: 10.5px;
        line-height: 1.35;
        text-align: center;
      }

      @media (min-width: 700px) {
        .page {
          margin-top: 20px;
          margin-bottom: 20px;
          border-radius: 20px;
          box-shadow: 0 18px 44px rgb(15 23 42 / 16%);
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="tag">FREE 7-DAY SGX WATCHLIST ON WHATSAPP</div>

      <h1><span class="gain">35–68%</span> upside targets within one week.</h1>

      <p class="sub">
        Get the SGX names we are watching before every chat group starts chasing the same move.
      </p>

      <p class="copy">
        Today’s free WhatsApp list focuses on fast-moving SGX counters, hot S-REIT rebounds and local bank names with
        one-week upside targets, entry area and a no-risk exit line before you make any move.
      </p>

      <div class="card">
        <p><b>This week’s free list includes:</b></p>
        <ul class="ticks">
          <li>SGX counters targeting 35–68% upside within 7 days</li>
          <li>High-yield S-REITs and bank counters ready to move</li>
          <li>Exact entry area plus one-week target range</li>
          <li>No-risk exit line before you enter</li>
          <li>Free WhatsApp access today, no payment and no form to fill</li>
        </ul>
      </div>

      <a class="btn link-btn" href="javascript:void(0)">Get This Week’s Free SGX Picks</a>
      <p class="small">Opens WhatsApp. Free 7-day watchlist access today only.</p>

      <p class="fineprint">
        Free market alert for educational discussion. Target figures are used in the note. Always check before buying or selling.
      </p>
    </main>
  </body>
</html>
