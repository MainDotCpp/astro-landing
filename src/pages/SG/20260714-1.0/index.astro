      </a>
    </div>

    <script is:inline>
      document.documentElement.classList.add('js')

      const rvEls = Array.prototype.slice.call(document.querySelectorAll('.rv'))
      const hero = document.querySelector('.hero')
      const sticky = document.getElementById('stickyCta')
      const finalSec = document.querySelector('.final')

      function tick() {
        const vh = window.innerHeight
        for (let i = rvEls.length - 1; i >= 0; i--) {
          if (rvEls[i].getBoundingClientRect().top < vh * 0.9) {
            rvEls[i].classList.add('in')
            rvEls.splice(i, 1)
          }
        }
        // sticky CTA: show after hero, hide when final CTA is on screen
        const pastHero = hero.getBoundingClientRect().bottom < 0
        const finalVisible = finalSec.getBoundingClientRect().top < vh * 0.85
        sticky.classList.toggle('show', pastHero && !finalVisible)
      }
      window.addEventListener('scroll', tick, { passive: true })
      window.addEventListener('resize', tick, { passive: true })
      tick()

      // fallback: never leave content hidden (previews / webviews that don't fire scroll)
      setTimeout(() => {
        for (let i = 0; i < rvEls.length; i++) rvEls[i].classList.add('in')
        rvEls.length = 0
      }, 2200)
    </script>
