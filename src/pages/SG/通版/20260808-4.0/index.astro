---
import RedirectCode from '@/components/RedirectCode.astro'
import heroHdb from './assets/images/hero-hdb.png'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Your Home Loan Is Priced in Washington — What September Does to Singapore Money</title>
    <meta
      name="description"
      content="SORA follows US rates, and so does what your T-bill pays, what the banks earn and what S-REITs pay to refinance. Two columns for the September Fed decision: what happens if rates go higher, and what happens if this is the peak."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Spline+Sans+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style
      define:vars={{
        hdbImg: `url(${heroHdb.src})`,
      }}
    >
      :root {
        --paper: #f7f5f0;
        --card: #fffdf9;
        --ink: #1c1a17;
        --mut: #5f5a52;
        --dim: #8d877c;
        --rule: #e4e0d6;
        --hike: #a8412f;
        --hike-bg: #fbf0ed;
        --hold: #2f6b5e;
        --hold-bg: #eef5f2;
        --night: #14171c;
        --wa: #25d366;
        --wa-d: #1bae52;
        --sans: 'Figtree', system-ui, -apple-system, sans-serif;
        --mono: 'Spline Sans Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        font-family: var(--sans);
        background: var(--paper);
        color: var(--ink);
        line-height: 1.56;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: calc(84px + env(safe-area-inset-bottom));
      }
      img { display: block; max-width: 100%; }

      .wrap { width: 100%; padding-inline: 21px; }

      /* ---------- hero ---------- */
      .hero {
        display: flex;
        align-items: center;
        min-height: 100svh;
        padding-top: calc(env(safe-area-inset-top) + 40px);
        padding-bottom: calc(104px + env(safe-area-inset-bottom));
        background-image:
          linear-gradient(
            182deg,
            rgba(14, 16, 20, 0.86) 0%,
            rgba(14, 16, 20, 0.55) 34%,
            rgba(14, 16, 20, 0.88) 100%
          ),
          var(--hdbImg);
        background-size: cover, auto 130%;
        background-position: center, 50% 72%;
        background-repeat: no-repeat;
        color: #f6f4ef;
      }
      .dateline {
        margin-bottom: 18px;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(246, 244, 239, 0.62);
      }
      .hero h1 {
        font-weight: 800;
        font-size: clamp(2.15rem, 9.6vw, 2.95rem);
        line-height: 1.06;
        letter-spacing: -0.032em;
        text-wrap: balance;
      }
      .hero h1 span { color: #f0b45c; }
      .hero .lede {
        margin-top: 19px;
        font-size: 1.03rem;
        color: rgba(246, 244, 239, 0.8);
        max-width: 43ch;
      }
      .acts { margin-top: 28px; }

      /* ---------- buttons ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 16px 24px;
        border: none;
        border-radius: 10px;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.14s ease;
      }
      .btn svg { width: 17px; height: 17px; flex: none; }
      .btn-light {
        background: #faf8f4;
        color: var(--night);
        box-shadow: 0 16px 36px -16px rgba(0, 0, 0, 0.85);
      }
      .btn-light:hover { background: #fff; transform: translateY(-2px); }
      .btn-dark { background: var(--night); color: #f7f6f2; }
      .btn-dark:hover { background: #232830; transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn:focus-visible { outline: 3px solid #f0b45c; outline-offset: 3px; }

      /* ---------- sections ---------- */
      .sec { padding-block: 54px; }
      .sec h2 {
        font-weight: 800;
        font-size: clamp(1.72rem, 7.4vw, 2.2rem);
        line-height: 1.13;
        letter-spacing: -0.028em;
        max-width: 20ch;
        text-wrap: balance;
      }
      .sec .lead { margin-top: 15px; color: var(--mut); font-size: 1rem; max-width: 47ch; }

      /* ---------- the split ---------- */
      .split { border-top: 1px solid var(--rule); }
      .two-up { margin-top: 30px; display: grid; gap: 13px; }
      .side {
        padding: 22px 20px 24px;
        border-radius: 12px;
        border: 1px solid var(--rule);
      }
      .side.a { background: var(--hike-bg); border-color: #eddbd6; }
      .side.b { background: var(--hold-bg); border-color: #d9e7e1; }
      .side .who {
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }
      .side.a .who { color: var(--hike); }
      .side.b .who { color: var(--hold); }
      .side h3 {
        margin-top: 9px;
        font-weight: 700;
        font-size: 1.16rem;
        letter-spacing: -0.02em;
        line-height: 1.24;
      }
      .side p { margin-top: 8px; color: var(--mut); font-size: 0.97rem; }

      /* ---------- ledger ---------- */
      .ledger-sec { background: var(--card); border-top: 1px solid var(--rule); }
      .lg-head { display: none; }
      .ledger { margin-top: 34px; }
      .lg-row { padding-block: 26px; border-top: 1px solid var(--rule); }
      .lg-row:first-child { border-top: 2px solid var(--ink); }
      .lg-row:last-child { border-bottom: 1px solid var(--rule); }
      .lg-row h3 {
        font-weight: 700;
        font-size: 1.18rem;
        letter-spacing: -0.022em;
        line-height: 1.26;
      }
      .lg-row .note {
        margin-top: 5px;
        font-family: var(--mono);
        font-size: 0.71rem;
        color: var(--dim);
        letter-spacing: 0.01em;
      }
      .cell { margin-top: 15px; padding-left: 14px; border-left: 3px solid; }
      .cell.hike { border-color: var(--hike); }
      .cell.hold { border-color: var(--hold); }
      .cell .cl {
        font-family: var(--mono);
        font-size: 0.67rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      .cell.hike .cl { color: var(--hike); }
      .cell.hold .cl { color: var(--hold); }
      .cell p:not(.cl) { margin-top: 6px; color: var(--mut); font-size: 0.96rem; }

      /* ---------- close ---------- */
      .close { background: var(--night); color: #f6f4ef; border-top: 1px solid var(--rule); }
      .close h2 { color: #faf8f4; }
      .close .lead { color: rgba(246, 244, 239, 0.76); }
      .close .acts { margin-top: 28px; }
      .fine {
        margin-top: 17px;
        font-family: var(--mono);
        font-size: 0.71rem;
        color: rgba(246, 244, 239, 0.5);
      }

      /* ---------- foot ---------- */
      .foot { padding-block: 30px 38px; }
      .foot p { font-size: 0.76rem; color: var(--dim); max-width: 64ch; line-height: 1.6; }

      /* ---------- whatsapp bar ---------- */
      .wa-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 12px 21px calc(12px + env(safe-area-inset-bottom));
        background: rgba(247, 245, 240, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1px solid var(--rule);
      }
      .wa-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 15px 22px;
        border: none;
        border-radius: 10px;
        background: var(--wa);
        color: #04210f;
        cursor: pointer;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1.02rem;
        box-shadow: 0 12px 28px -14px rgba(37, 211, 102, 0.95);
        transition: background 0.2s ease, transform 0.14s ease;
      }
      .wa-btn svg { width: 22px; height: 22px; flex: none; }
      .wa-btn:hover { background: var(--wa-d); transform: translateY(-2px); }
      .wa-btn:active { transform: translateY(0); }
      .wa-btn:focus-visible { outline: 3px solid var(--night); outline-offset: 3px; }

      /* ---------- motion ---------- */
      .rise { animation: rise 0.62s cubic-bezier(0.22, 0.72, 0.3, 1) both; }
      .d1 { animation-delay: 0.07s; }
      .d2 { animation-delay: 0.16s; }
      @keyframes rise {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: none; }
      }
      .js .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 0.72, 0.3, 1);
      }
      .js .reveal.in { opacity: 1; transform: none; }

      /* ---------- larger screens ---------- */
      @media (min-width: 800px) {
        .wrap { max-width: 1080px; margin-inline: auto; padding-inline: clamp(32px, 5vw, 60px); }
        body { padding-bottom: 96px; }

        .hero {
          padding-top: calc(env(safe-area-inset-top) + 76px);
          padding-bottom: 124px;
          background-size: cover, cover;
          background-position: center, center 58%;
        }
        .hero h1 { font-size: clamp(2.9rem, 4.6vw, 3.9rem); max-width: 17ch; }
        .hero .lede { font-size: 1.13rem; }
        .btn { width: auto; min-width: 260px; }

        .sec { padding-block: 98px; }
        .sec h2 { font-size: clamp(2.25rem, 3.3vw, 2.9rem); }

        .two-up { grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 42px; }
        .side { padding: 30px 28px 32px; }

        .ledger { margin-top: 46px; }
        .lg-head {
          display: grid;
          grid-template-columns: 16rem 1fr 1fr;
          gap: 0 32px;
          padding-bottom: 12px;
        }
        .lg-head div {
          font-family: var(--mono);
          font-size: 0.7rem;
          font-weight: 600;
          letter-spacing: 0.1em;
          text-transform: uppercase;
        }
        .lg-head .col-hike { color: var(--hike); }
        .lg-head .col-hold { color: var(--hold); }
        .lg-row {
          display: grid;
          grid-template-columns: 16rem 1fr 1fr;
          gap: 0 32px;
          align-items: start;
          padding-block: 30px;
        }
        .cell { margin-top: 0; border-left-width: 3px; }
        .cell .cl { display: none; }
        .cell p:not(.cl) { margin-top: 0; }

        .wa-bar { padding-inline: 0; }
        .wa-bar .wrap { display: flex; justify-content: flex-end; }
        .wa-btn { width: auto; min-width: 300px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise { animation: none; }
        .js .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <!-- ============ HERO ============ -->
    <header class="hero">
      <div class="wrap">
        <p class="dateline rise">8 August 2026</p>

        <h1 class="rise d1">
          Your home loan is priced in <span>Washington</span>
        </h1>

        <p class="lede rise d1">
          If your loan is with a bank, it's pegged to SORA, and SORA follows US rates. So do your
          T-bills, the margin the three local banks earn, and what S-REITs pay to refinance. In
          September the Fed picks a direction and every one of those goes with it.
        </p>

        <div class="acts rise d2">
          <button type="button" class="btn btn-light link-btn" onclick="onLinkBtnClick()">
            Get it free on WhatsApp
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- ============ THE SPLIT ============ -->
    <section class="sec split">
      <div class="wrap">
        <h2 class="reveal">The Fed is choosing which problem to make worse</h2>
        <p class="lead reveal">
          The July US jobs report showed 23,000 jobs lost against a forecast of 83,000 added, and two
          earlier months were revised down by another 103,000. Inflation, meanwhile, still isn't
          beaten. Both halves of the Fed's job are pulling in opposite directions, and September is
          where it has to pick.
        </p>

        <div class="two-up">
          <div class="side a reveal">
            <p class="who">The case to hike</p>
            <h3>Inflation hasn't come down enough</h3>
            <p>
              Core PCE is still running above 3% and August is expected to tick back up. Several
              officials have argued for another hike, and the futures market is now pointing to about
              4% by year end.
            </p>
          </div>

          <div class="side b reveal">
            <p class="who">The case to hold</p>
            <h3>The labour market is cracking</h3>
            <p>
              Hiring has gone backwards, the revisions were brutal, and wage growth has fallen to
              3.2%, the slowest since 2021. Raising rates on top of that is how a slowdown turns into
              something worse.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ THE LEDGER ============ -->
    <section class="sec ledger-sec">
      <div class="wrap">
        <h2 class="reveal">What each outcome does to your money</h2>
        <p class="lead reveal">
          You don't get to pick which one happens. You do get to know what each one does to you
          before it does.
        </p>

        <div class="ledger">
          <div class="lg-head reveal">
            <div></div>
            <div class="col-hike">If rates go higher</div>
            <div class="col-hold">If this is the peak</div>
          </div>

          <article class="lg-row reveal">
            <div>
              <h3>Your floating home loan</h3>
              <p class="note">SORA-pegged</p>
            </div>
            <div class="cell hike">
              <p class="cl">If higher</p>
              <p>
                The monthly repayment goes up again. SORA reprices off US rates, not off anything
                decided in Singapore.
              </p>
            </div>
            <div class="cell hold">
              <p class="cl">If peak</p>
              <p>
                The bleeding stops. Nothing comes back yet — you keep paying at roughly today's level
                until the Fed actually moves the other way.
              </p>
            </div>
          </article>

          <article class="lg-row reveal">
            <div>
              <h3>T-bills and fixed deposits</h3>
              <p class="note">Six-month rolls</p>
            </div>
            <div class="cell hike">
              <p class="cl">If higher</p>
              <p>
                The rate you've been getting holds up, and rolling it over is still worth the hassle.
              </p>
            </div>
            <div class="cell hold">
              <p class="cl">If peak</p>
              <p>
                Every roll from here pays a little less than the last one, and it happens slowly
                enough that most people only notice a year later.
              </p>
            </div>
          </article>

          <article class="lg-row reveal">
            <div>
              <h3>DBS, UOB and OCBC</h3>
              <p class="note">Net interest margin</p>
            </div>
            <div class="cell hike">
              <p class="cl">If higher</p>
              <p>
                The gap between what they pay you and what they charge borrowers stays wide. NIM
                holds, and so does the dividend story.
              </p>
            </div>
            <div class="cell hold">
              <p class="cl">If peak</p>
              <p>
                Margins start compressing from here. The market usually sells that well before the
                results confirm it.
              </p>
            </div>
          </article>

          <article class="lg-row reveal">
            <div>
              <h3>S-REITs</h3>
              <p class="note">Refinancing costs</p>
            </div>
            <div class="cell hike">
              <p class="cl">If higher</p>
              <p>
                Debt keeps rolling into expensive money. It comes out of your distributions long
                before it ever shows up in rents.
              </p>
            </div>
            <div class="cell hold">
              <p class="cl">If peak</p>
              <p>
                The re-rating S-REITs have been waiting years for finally gets a reason to start.
              </p>
            </div>
          </article>

          <article class="lg-row reveal">
            <div>
              <h3>The US stocks you hold</h3>
              <p class="note">In SGD terms</p>
            </div>
            <div class="cell hike">
              <p class="cl">If higher</p>
              <p>
                A firmer dollar flatters your SGD return even on flat days, while the high-growth
                stocks get marked down harder.
              </p>
            </div>
            <div class="cell hold">
              <p class="cl">If peak</p>
              <p>
                The dollar gives some of that back. High-growth stocks tend to recover their rating
                first, before anything shows up in earnings.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="sec close">
      <div class="wrap">
        <h2 class="reveal">Nobody knows which column you'll be living in by October</h2>
        <p class="lead reveal">
          A fortnight ago the market put a September hike at 57%. After Friday it's 44%. Nobody has a
          firm answer, including them — that's what makes September a decision rather than an
          announcement. Every inflation number and every jobs report between now and then moves it
          again. We follow them and send three points to the group each trading morning, by 9.00am,
          before the Singapore market opens.
        </p>

        <div class="acts reveal">
          <button type="button" class="btn btn-light link-btn" onclick="onLinkBtnClick()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>

        <p class="fine reveal">Free · nothing to download · leave whenever you like</p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <p>
          Everything here is general market commentary and educational research. It does not take
          your objectives or financial situation into account, and it is not a recommendation to buy
          or sell anything. Markets carry risk. Do your own research before you invest.
        </p>
      </div>
    </footer>

    <!-- ============ FLOATING WHATSAPP ============ -->
    <div class="wa-bar">
      <div class="wrap">
        <button type="button" class="wa-btn link-btn" onclick="onLinkBtnClick()">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
          Join the free group
        </button>
      </div>
    </div>

    <script is:inline>
      ;(function () {
        const items = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!items.length)
          return

        function tick() {
          const vh = window.innerHeight || document.documentElement.clientHeight
          for (let i = items.length - 1; i >= 0; i--) {
            const r = items[i].getBoundingClientRect()
            if (r.top < vh - 70) {
              items[i].classList.add('in')
              items.splice(i, 1)
            }
          }
          if (!items.length) {
            window.removeEventListener('scroll', tick)
            window.removeEventListener('resize', tick)
          }
        }

        window.addEventListener('scroll', tick, { passive: true })
        window.addEventListener('resize', tick)
        tick()
        setTimeout(tick, 300)
      })()
    </script>
  </body>
</html>
