    <!-- MODAL -->
    <div class="ov" id="modal">
      <div class="mbox" role="dialog" aria-modal="true">
        <button class="mclose" type="button" aria-label="Close">×</button>
        <h3 id="mt"></h3>
        <div class="mbody" id="mb"></div>
      </div>
    </div>

    <script>
      const modalContent = {
        privacy: {
          title: 'Privacy Policy',
          body: `
            <p>The Market Challenge Committee (the "Organiser") handles participants' personal data in accordance with applicable data protection laws, including Singapore's Personal Data Protection Act (PDPA).</p>
            <h4>1. What we collect</h4><p>Only the minimum needed to run the event: a nickname and a reachable messenger ID at registration. Winners may be asked separately, with consent, for additional details (name, contact number) so prizes can be delivered.</p>
            <h4>2. How we use it</h4><ul><li>Processing registrations and managing participants</li><li>Sending event schedules, results and announcements</li><li>Selecting winners and delivering prizes</li></ul>
            <h4>3. How long we keep it</h4><p>Personal data is deleted without undue delay once these purposes are fulfilled, and retained only as long as required by applicable law.</p>
            <h4>4. Sharing with third parties</h4><p>We do not share personal data with third parties without prior consent, except where required by law.</p>
            <h4>5. Your rights</h4><p>You may request access to, correction of, or deletion of your personal data, or ask us to stop processing it, at any time.</p>
            <h4>6. Contact</h4><p>help@marketchallenge.co</p>
          `,
        },
        terms: {
          title: 'Terms of Use',
          body: `
            <p>These terms set out the rights, obligations and responsibilities between the Organiser and participants of the Market Challenge (the "Event").</p>
            <h4>1. Purpose</h4><p>The Event is a participation-based simulated trading event, run for educational and community purposes. It does not solicit, recommend or broker the purchase or sale of any financial product.</p>
            <h4>2. Participant conduct</h4><ul><li>Treat other participants with respect.</li><li>Do not manipulate rankings through dishonest means.</li><li>Do not post false information, advertising or abusive content, or otherwise disrupt the Event.</li></ul>
            <h4>3. Nature of the Event</h4><p>The Event runs on a simulated basis. In-event returns and rankings are unrelated to actual investment performance, and no outcome of any kind is guaranteed.</p>
            <h4>4. Changes and cancellation</h4><p>The Organiser may change or suspend the Event schedule or content where unavoidable, with notice given through the registration channel.</p>
            <h4>5. Limitation of liability</h4><p>Participants join the Event at their own discretion and are responsible for their own decisions and outcomes.</p>
          `,
        },
        disclaimer: {
          title: 'Disclaimer',
          body: `
            <p>All content on this site and in the Event is provided <b style="color:#f4f7ff">for event information purposes only</b>.</p>
            <h4>1. Nature of the Event</h4><p>The Event is run on a simulated trading basis and is unrelated to actual investment returns. In-event rankings and returns do not represent any investment performance.</p>
            <h4>2. Investment caution</h4><p>Nothing here constitutes an offer, recommendation or invitation to buy or sell any financial product, and no returns of any kind are guaranteed. All investment decisions, and their outcomes, are solely the responsibility of the individual.</p>
            <h4>3. Prizes</h4><p>Travel vouchers and other benefits are provided to winners under the Event's operating policy; detailed conditions are communicated through the registration channel.</p>
            <h4>4. Limitation of liability</h4><p>Any decisions made in reliance on this content, and their consequences, rest entirely with the user.</p>
          `,
        },
      }

      document.addEventListener('DOMContentLoaded', () => {
        // countdown → registration closes 26 July, 23:59 SGT
        const end = new Date('2026-07-26T23:59:59+08:00').getTime()
        const pad = (n) => String(n).padStart(2, '0')
        const tick = () => {
          const diff = Math.max(0, end - Date.now())
          const d = Math.floor(diff / 86400000)
          const h = Math.floor((diff % 86400000) / 3600000)
          const m = Math.floor((diff % 3600000) / 60000)
          const s = Math.floor((diff % 60000) / 1000)
          const set = (id, v) => {
            const el = document.getElementById(id)
            if (el) el.textContent = v
          }
          set('cd-d', pad(d))
          set('cd-h', pad(h))
          set('cd-m', pad(m))
          set('cd-s', pad(s))
        }
        tick()
        setInterval(tick, 1000)

        // modals
        const ov = document.getElementById('modal')
        const mt = document.getElementById('mt')
        const mb = document.getElementById('mb')
        const open = (k) => {
          const d = modalContent[k]
          if (!d || !ov || !mt || !mb) return
          mt.textContent = d.title
          mb.innerHTML = d.body
          ov.classList.add('show')
          document.body.style.overflow = 'hidden'
        }
        const close = () => {
          if (!ov) return
          ov.classList.remove('show')
          document.body.style.overflow = ''
        }
        document.querySelectorAll('[data-modal]').forEach((el) => {
          el.addEventListener('click', (e) => { e.preventDefault(); open(el.getAttribute('data-modal')) })
        })
        ov?.querySelector('.mclose')?.addEventListener('click', close)
        ov?.addEventListener('click', (e) => { if (e.target === ov) close() })
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
      })
    </script>
  </body>
</html>
