---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Image } from 'astro:assets'

import heroBg from './images/hero-bg.jpg'
import heroPhone from './images/hero-phone.png'
import communityImg from './images/community.jpg'

const title = "Institutional Trading Strategies & Advanced Stock Screening | SG Wealth Forum"
const description = "Learn professional stock picking techniques: Volume Profile, MACD divergence, and Institutional Accumulation. Join our exclusive WhatsApp group for Singapore investors."
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Custom Fonts & Styles -->
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --c-surface: #f8fafc;
        --c-surface-elevated: #ffffff;
        --c-primary: #0f172a;
        --c-accent: #0284c7;
        --c-gold: #c29b62;
        --c-text: #334155;
        --c-text-light: #64748b;
        --font-serif: 'Playfair Display', serif;
        --font-sans: 'Inter', sans-serif;
      }
      body {
        font-family: var(--font-sans);
        background-color: var(--c-surface);
        color: var(--c-text);
        -webkit-font-smoothing: antialiased;
      }
      .font-serif { font-family: var(--font-serif); }
      
      .bg-primary { background-color: var(--c-primary); }
      .text-primary { color: var(--c-primary); }
      .text-accent { color: var(--c-accent); }
      .text-gold { color: var(--c-gold); }
      
      .premium-card {
        background: var(--c-surface-elevated);
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .premium-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -10px rgba(0,0,0,0.12);
      }

      .btn-whatsapp {
        background-color: #25D366;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
      }
      .btn-whatsapp:hover {
        background-color: #128C7E;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
        transform: translateY(-2px);
      }
      
      .metric-box {
        border-left: 3px solid var(--c-accent);
        padding-left: 1rem;
      }
    </style>
  </Fragment>

  <!-- Navigation -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-slate-900 border border-slate-700 flex items-center justify-center text-white font-serif font-bold text-xl rounded-md shadow-sm">
          W
        </div>
        <div>
          <span class="block text-sm font-bold tracking-widest uppercase text-slate-900">SG Wealth Forum</span>
          <span class="block text-[10px] tracking-widest text-slate-500">Advanced Trading Strategies</span>
        </div>
      </div>
      <a href="javascript:void(0)" class="link-btn btn-whatsapp px-6 py-2 rounded-full font-semibold text-sm hidden sm:flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Join Group
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white pt-20 pb-24 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Image src={heroBg} alt="Financial District" class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/90 to-transparent"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-blue-400/30 bg-blue-500/10 text-blue-300 text-xs font-semibold tracking-wide uppercase mb-6">
          Advanced Stock Screening & Analysis
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold leading-[1.15] mb-6">
          Trade with <span class="text-gold italic">Institutional</span> Precision.
        </h1>
        
        <p class="text-lg text-slate-300 mb-8 max-w-2xl leading-relaxed">
          Stop relying on retail sentiment. Learn how to identify <strong>Volume Profile accumulation</strong>, decode <strong>Options Flow</strong>, and spot <strong>MACD Divergences</strong> before the breakout occurs.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center md:justify-start">
          <a href="javascript:void(0)" class="link-btn btn-whatsapp text-lg font-bold py-4 px-8 rounded-full flex justify-center items-center gap-3 w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Unlock Strategies via WhatsApp
          </a>
          <span class="text-slate-400 text-sm">Free access. Hand-picked case studies daily.</span>
        </div>
      </div>
      
      <div class="flex-1 hidden md:block relative">
        <Image src={heroPhone} alt="Trading Platform UI" class="w-full max-w-[400px] mx-auto drop-shadow-2xl relative z-10" />
      </div>
    </div>
  </section>

  <!-- Technical Methodologies Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mb-4">Our Institutional Screening Playbook</h2>
        <p class="text-slate-500 max-w-2xl mx-auto">We do not gamble on headlines. We share exact technical breakdowns and quantitative data to identify high-probability Risk/Reward asymmetrical trades.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Technique 1 -->
        <div class="premium-card p-8 rounded-xl">
          <div class="w-12 h-12 bg-blue-50 text-blue-600 flex items-center justify-center rounded-lg mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 block">1. Volume Profile & VPVR</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            We identify Point of Control (POC) and High Volume Nodes (HVN) to locate where institutional money has built massive supply/demand walls. Never buy into resistance again.
          </p>
          <div class="metric-box bg-slate-50 py-2">
            <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Key Indicator</div>
            <div class="text-sm font-bold text-slate-800">Volume by Price (VPVR)</div>
          </div>
        </div>

        <!-- Technique 2 -->
        <div class="premium-card p-8 rounded-xl">
          <div class="w-12 h-12 bg-purple-50 text-purple-600 flex items-center justify-center rounded-lg mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 block">2. VWAP Mean Reversion</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Institutions use Volume Weighted Average Price (VWAP) as their execution benchmark. Learn how to spot when a stock is statistically over-extended and ripe for a mean-reversion trade.
          </p>
          <div class="metric-box bg-slate-50 py-2">
            <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Key Indicator</div>
            <div class="text-sm font-bold text-slate-800">Standard Deviation Bands</div>
          </div>
        </div>

        <!-- Technique 3 -->
        <div class="premium-card p-8 rounded-xl border-t-4 border-t-gold">
          <div class="w-12 h-12 bg-orange-50 text-orange-600 flex items-center justify-center rounded-lg mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 20 5-5-5-5"/><path d="M21 15H9a6 6 0 0 1 0-12h3"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 block">3. Hidden Divergences</h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Price makes a higher high, but momentum indicators drop? We teach you how to read bearish/bullish divergences across RSI and MACD histograms to anticipate trend reversals early.
          </p>
          <div class="metric-box bg-slate-50 py-2">
            <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Key Indicator</div>
            <div class="text-sm font-bold text-slate-800">MACD Histogram & RSI</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Briefing / Deep Dive -->
  <section class="py-24 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        
        <div class="flex-1 lg:order-2">
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mb-6">Stop Reacting. Start Anticipating.</h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="mt-1 flex-shrink-0 w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-sm">1</div>
              <div>
                <h4 class="text-lg font-bold text-slate-900">Sector Rotation Models</h4>
                <p class="text-slate-600 text-sm mt-1">Capital flows in cycles. We analyze yield curves and relative strength (RS) to identify which sectors (e.g., Tech, Financials, Energy) are secretly accumulating capital before the broader market catches on.</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="mt-1 flex-shrink-0 w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-sm">2</div>
              <div>
                <h4 class="text-lg font-bold text-slate-900">Options Flow & Dark Pools</h4>
                <p class="text-slate-600 text-sm mt-1">Whales leave footprints. We share interpretations of unusual options activity, implied volatility (IV) crush scenarios, and Dark Pool prints that affect underlying equities.</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="mt-1 flex-shrink-0 w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-sm">3</div>
              <div>
                <h4 class="text-lg font-bold text-slate-900">Strict Risk Management</h4>
                <p class="text-slate-600 text-sm mt-1">No setup is 100% accurate. We emphasize asymmetric R/R (Risk/Reward) ratios, calculating proper position sizing, and trailing stop placements based on Average True Range (ATR).</p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex-1 lg:order-1 w-full relative">
          <div class="absolute inset-0 bg-blue-600 translate-x-4 translate-y-4 rounded-xl opacity-10"></div>
          <Image src={communityImg} alt="Boardroom Analysis" class="relative z-10 w-full h-auto rounded-xl shadow-2xl object-cover" />
          
          <!-- Insight Card Overlay -->
          <div class="absolute -bottom-6 -right-6 bg-white p-6 rounded-xl shadow-xl border border-slate-100 max-w-sm hidden md:block z-20">
            <div class="text-xs uppercase tracking-wider text-slate-500 font-bold mb-2">Daily Briefing Sample</div>
            <div class="text-sm text-slate-800 font-medium leading-relaxed">
              "NVDA approaching the $125 HVN zone from volume profile. RSI showing bearish divergence on the 4H chart. Recommended action: tighten trailing stops below VWAP..."
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 bg-slate-900 text-center">
    <div class="max-w-3xl mx-auto px-4 relative z-10">
      <h2 class="text-3xl md:text-5xl font-serif font-bold text-white mb-6">Upgrade Your Financial Literacy</h2>
      <p class="text-lg text-slate-400 mb-10">
        Join fellow Singaporean investors in our WhatsApp channel. Get access to our daily chart markups, technical analysis PDFs, and real-time market commentary.
      </p>
      
      <a href="javascript:void(0)" class="link-btn btn-whatsapp inline-flex text-white text-xl font-bold py-5 px-10 rounded-full items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Join Free WhatsApp Group
      </a>
      <p class="mt-4 text-sm text-slate-500">100% Free. No subscription required.</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-[#05080f] py-8 border-t border-slate-800 text-center text-slate-500 text-xs">
    <div class="max-w-6xl mx-auto px-4">
      <p class="mb-4 text-slate-400 font-bold">SG Wealth Forum</p>
      <p class="max-w-3xl mx-auto leading-relaxed mb-4">
        Disclaimer: The technical analysis, concepts, and market summaries provided in our community are for educational purposes only and do not constitute financial advice. Technical indicators represent past market behavior and are not guaranteed predictors of future performance. Always manage your risk properly and consult a licensed professional.
      </p>
      <p>&copy; {new Date().getFullYear()} SG Wealth Forum. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
