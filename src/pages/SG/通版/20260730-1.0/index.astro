---
import RedirectCode from '@/components/RedirectCode.astro'

const title = 'STI Down 14% — Recovery Stocks Analysis'
const description = 'Global markets are selling off. Our analysts identify SGX recovery stocks daily. Join 12,000+ investors — free WhatsApp group.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1729" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <RedirectCode />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0f1729;
        color: #f8fafc;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 480px;
        margin: 0 auto;
      }

      /* ── Hero ── */
      .hero {
        padding: 48px 24px 40px;
        text-align: center;
      }

      .hero-metric {
        font-family: 'Space Grotesk', monospace;
        font-size: 72px;
        font-weight: 700;
        color: #ef4444;
        line-height: 1;
        letter-spacing: -2px;
      }

      .hero-label {
        font-family: 'Space Grotesk', monospace;
        font-size: 14px;
        color: #94a3b8;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-top: 8px;
      }

      .hero-sub {
        font-size: 16px;
        line-height: 1.65;
        color: #cbd5e1;
        margin-top: 20px;
        padding: 0 4px;
      }

      .btn {
        display: block;
        background: #25D366;
        color: #fff;
        text-decoration: none;
        text-align: center;
        padding: 16px;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        width: 100%;
        transition: opacity 0.2s;
      }

      .btn:active {
        opacity: 0.85;
      }

      .hero .btn {
        margin-top: 28px;
      }

      /* ── Market Snapshot ── */
      .snapshot {
        padding: 0 20px 36px;
      }

      .snapshot-title {
        font-family: 'Space Grotesk', monospace;
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 16px;
      }

      .metric-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .metric-card {
        padding: 20px 16px;
        background: #1e293b;
        border-radius: 12px;
        border-left: 3px solid #38bdf8;
      }

      .metric-name {
        font-family: 'Space Grotesk', monospace;
        font-size: 12px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .metric-value {
        font-family: 'Space Grotesk', monospace;
        font-size: 28px;
        font-weight: 700;
        color: #ef4444;
        margin-top: 6px;
      }

      .metric-sub {
        font-size: 12px;
        color: #64748b;
        margin-top: 4px;
      }

      .snapshot-footer {
        font-size: 14px;
        line-height: 1.6;
        color: #94a3b8;
        margin-top: 20px;
        padding: 0 2px;
      }

      /* ── Ticker ── */
      .ticker {
        overflow: hidden;
        padding: 14px 0;
        border-top: 1px solid #1e293b;
        border-bottom: 1px solid #1e293b;
      }

      .ticker-track {
        display: flex;
        gap: 32px;
        animation: ticker 20s linear infinite;
        white-space: nowrap;
      }

      .ticker-item {
        font-family: 'Space Grotesk', monospace;
        font-size: 14px;
        font-weight: 500;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }

      .ticker-item .down {
        color: #ef4444;
      }

      .ticker-item .up {
        color: #22c55e;
      }

      @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      @media (prefers-reduced-motion: reduce) {
        .ticker-track {
          animation: none;
        }
      }

      /* ── Analyst Insights ── */
      .insights {
        padding: 36px 20px;
      }

      .insights-title {
        font-family: 'Space Grotesk', monospace;
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 20px;
      }

      .insight-card {
        background: #1e293b;
        border-radius: 12px;
        padding: 20px;
        border-left: 3px solid #38bdf8;
        margin-bottom: 12px;
      }

      .insight-card:last-of-type {
        margin-bottom: 0;
      }

      .insight-card p {
        font-size: 15px;
        line-height: 1.65;
        color: #cbd5e1;
      }

      .insights .btn {
        margin-top: 28px;
      }

      /* ── Steps ── */
      .steps {
        padding: 36px 20px;
        border-top: 1px solid #1e293b;
      }

      .steps-title {
        font-family: 'Space Grotesk', monospace;
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 24px;
      }

      .step {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
      }

      .step:last-of-type {
        margin-bottom: 0;
      }

      .step-num {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        background: #1e293b;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Space Grotesk', monospace;
        font-size: 16px;
        font-weight: 700;
        color: #38bdf8;
      }

      .step-text h3 {
        font-size: 16px;
        font-weight: 600;
        color: #f8fafc;
        margin-bottom: 4px;
      }

      .step-text p {
        font-size: 14px;
        color: #94a3b8;
        line-height: 1.5;
      }

      /* ── Legal + Footer ── */
      .legal {
        padding: 28px 20px;
        border-top: 1px solid #1e293b;
      }

      .legal-text {
        font-size: 11px;
        color: #64748b;
        line-height: 1.6;
        text-align: center;
      }

      .footer {
        padding: 0 20px 100px;
        text-align: center;
      }

      .footer-contact {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 8px;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-links a {
        font-size: 12px;
        color: #64748b;
        text-decoration: underline;
        cursor: pointer;
      }

      /* ── Sticky CTA ── */
      .sticky-cta {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 90;
        background: linear-gradient(transparent, #0f1729 30%);
        padding: 20px 20px 16px;
      }

      .sticky-cta .btn {
        max-width: 480px;
        margin: 0 auto;
        box-shadow: 0 -4px 20px rgba(37, 211, 102, 0.25);
      }

      /* ── Scroll Reveal ── */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* ── Modal ── */
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 200;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .modal-overlay.active {
        display: flex;
      }

      .modal {
        background: #1e293b;
        border-radius: 16px;
        max-width: 440px;
        width: 100%;
        max-height: 80vh;
        overflow-y: auto;
        padding: 28px 24px;
      }

      .modal h2 {
        font-family: 'Space Grotesk', monospace;
        font-size: 18px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 16px;
      }

      .modal p {
        font-size: 13px;
        line-height: 1.7;
        color: #94a3b8;
        margin-bottom: 12px;
      }

      .modal-close {
        display: block;
        margin-top: 20px;
        background: #0f1729;
        color: #f8fafc;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 12px;
        width: 100%;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
      }

      /* ── Desktop ── */
      @media (min-width: 760px) {
        .container {
          max-width: 520px;
        }

        .hero {
          padding: 60px 32px 48px;
        }

        .hero-metric {
          font-size: 88px;
        }

        .snapshot {
          padding: 0 28px 44px;
        }

        .metric-value {
          font-size: 32px;
        }

        .insights {
          padding: 44px 28px;
        }

        .steps {
          padding: 44px 28px;
        }

        .legal {
          padding: 32px 28px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Hero -->
      <section class="hero">
        <div class="hero-metric">-14.2%</div>
        <div class="hero-label">STI in the last 30 days</div>
        <p class="hero-sub">
          Every major crash in Singapore's history was followed by a recovery. The question is — will you be positioned for it?
        </p>
        <a href="javascript:void(0)" class="btn link-btn">Join Free WhatsApp Group</a>
      </section>

      <!-- Market Snapshot -->
      <section class="snapshot reveal">
        <div class="snapshot-title">Market Snapshot</div>
        <div class="metric-grid">
          <div class="metric-card">
            <div class="metric-name">STI</div>
            <div class="metric-value">-14.2%</div>
            <div class="metric-sub">Straits Times Index</div>
          </div>
          <div class="metric-card">
            <div class="metric-name">S&P 500</div>
            <div class="metric-value">-11.8%</div>
            <div class="metric-sub">US Large Cap</div>
          </div>
          <div class="metric-card">
            <div class="metric-name">HSI</div>
            <div class="metric-value">-18.3%</div>
            <div class="metric-sub">Hang Seng Index</div>
          </div>
          <div class="metric-card">
            <div class="metric-name">Nikkei</div>
            <div class="metric-value">-9.7%</div>
            <div class="metric-sub">Japan 225</div>
          </div>
        </div>
        <p class="snapshot-footer">
          When global markets sell off together, recovery stocks emerge. Knowing which ones — that's the edge.
        </p>
      </section>

      <!-- Ticker -->
      <div class="ticker reveal">
        <div class="ticker-track">
          <span class="ticker-item">DBS <span class="down">-8.2%</span></span>
          <span class="ticker-item">UOB <span class="down">-6.1%</span></span>
          <span class="ticker-item">OCBC <span class="down">-5.8%</span></span>
          <span class="ticker-item">Singtel <span class="down">-12.4%</span></span>
          <span class="ticker-item">CapitaLand <span class="down">-15.1%</span></span>
          <span class="ticker-item">Keppel <span class="down">-11.3%</span></span>
          <span class="ticker-item">Mapletree <span class="down">-9.7%</span></span>
          <span class="ticker-item">SIA <span class="down">-7.5%</span></span>
          <!-- duplicate for seamless loop -->
          <span class="ticker-item">DBS <span class="down">-8.2%</span></span>
          <span class="ticker-item">UOB <span class="down">-6.1%</span></span>
          <span class="ticker-item">OCBC <span class="down">-5.8%</span></span>
          <span class="ticker-item">Singtel <span class="down">-12.4%</span></span>
          <span class="ticker-item">CapitaLand <span class="down">-15.1%</span></span>
          <span class="ticker-item">Keppel <span class="down">-11.3%</span></span>
          <span class="ticker-item">Mapletree <span class="down">-9.7%</span></span>
          <span class="ticker-item">SIA <span class="down">-7.5%</span></span>
        </div>
      </div>

      <!-- Analyst Insights -->
      <section class="insights reveal">
        <div class="insights-title">What Our Analysts See</div>
        <div class="insight-card">
          <p>Blue-chip SGX stocks are trading at 5-year lows. Our analysts are flagging specific names that historically rebound strongest.</p>
        </div>
        <div class="insight-card">
          <p>REIT yields have spiked above 7%. Analysts are identifying which trusts have the balance sheet to sustain these payouts through the downturn.</p>
        </div>
        <div class="insight-card">
          <p>DBS, UOB, OCBC — Singapore's big 3 banks are down double digits. Analysts break down which ones offer the best risk-reward right now.</p>
        </div>
        <a href="javascript:void(0)" class="btn link-btn">Join Free WhatsApp Group</a>
      </section>

      <!-- Steps -->
      <section class="steps reveal">
        <div class="steps-title">How to Join</div>
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-text">
            <h3>Tap the button below</h3>
            <p>Opens WhatsApp directly — no app download needed.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-text">
            <h3>Join the group</h3>
            <p>No sign-up, no fees. Instant access.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-text">
            <h3>Get daily analysis</h3>
            <p>Expert stock picks and market insights delivered every morning.</p>
          </div>
        </div>
      </section>

      <!-- Legal -->
      <div class="legal">
        <p class="legal-text">
          This page is for informational purposes only and does not constitute financial advice. All investment decisions and their outcomes are the sole responsibility of the individual investor.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p class="footer-contact">Contact: info@marketanalysis.sg</p>
        <div class="footer-links">
          <a data-modal="privacy">Privacy Policy</a>
          <a data-modal="terms">Terms of Use</a>
          <a data-modal="disclaimer">Disclaimer</a>
        </div>
      </div>
    </div>

    <!-- Sticky CTA -->
    <div class="sticky-cta">
      <a href="javascript:void(0)" class="btn link-btn">Join Free WhatsApp Group</a>
    </div>

    <!-- Privacy Modal -->
    <div class="modal-overlay" id="modal-privacy">
      <div class="modal">
        <h2>Privacy Policy</h2>
        <p>We collect minimal personal data necessary to operate this service. Information shared within the WhatsApp group is subject to WhatsApp's own privacy policy.</p>
        <p>We do not sell, trade, or share your personal information with third parties for marketing purposes. Any data collected is used solely for communication within the group and service improvement.</p>
        <p>You may request deletion of your data at any time by contacting us at info@marketanalysis.sg.</p>
        <button class="modal-close">Close</button>
      </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal-overlay" id="modal-terms">
      <div class="modal">
        <h2>Terms of Use</h2>
        <p>By accessing this page and joining our WhatsApp group, you agree to receive market analysis and educational content. This service is provided free of charge.</p>
        <p>All content shared is for educational and informational purposes only. It does not constitute personalised financial advice, and should not be relied upon as a basis for making investment decisions.</p>
        <p>We reserve the right to modify or discontinue the service at any time without prior notice. Continued participation constitutes acceptance of any updated terms.</p>
        <button class="modal-close">Close</button>
      </div>
    </div>

    <!-- Disclaimer Modal -->
    <div class="modal-overlay" id="modal-disclaimer">
      <div class="modal">
        <h2>Disclaimer</h2>
        <p>The information provided on this page and within our WhatsApp group is for general informational and educational purposes only. It is not intended as, and should not be construed as, financial advice.</p>
        <p>Past performance is not indicative of future results. All investments carry risk, including the potential loss of principal. You should conduct your own research and consult a qualified financial advisor before making any investment decisions.</p>
        <p>The data, figures, and market references on this page are illustrative and may not reflect real-time market conditions. We make no representations or warranties regarding the accuracy, completeness, or timeliness of any information provided.</p>
        <button class="modal-close">Close</button>
      </div>
    </div>

    <script is:inline>
      // Scroll reveal
      (function () {
        var els = document.querySelectorAll('.reveal');
        function check() {
          var vh = window.innerHeight;
          for (var i = 0; i < els.length; i++) {
            var rect = els[i].getBoundingClientRect();
            if (rect.top < vh - 60) {
              els[i].classList.add('visible');
            }
          }
        }
        window.addEventListener('scroll', check, { passive: true });
        check();
      })();

      // Modal logic
      (function () {
        var links = document.querySelectorAll('[data-modal]');
        for (var i = 0; i < links.length; i++) {
          links[i].addEventListener('click', function (e) {
            e.preventDefault();
            var id = 'modal-' + this.getAttribute('data-modal');
            var overlay = document.getElementById(id);
            if (overlay) overlay.classList.add('active');
          });
        }

        var closes = document.querySelectorAll('.modal-close');
        for (var j = 0; j < closes.length; j++) {
          closes[j].addEventListener('click', function () {
            this.closest('.modal-overlay').classList.remove('active');
          });
        }

        document.addEventListener('click', function (e) {
          if (e.target.classList.contains('modal-overlay')) {
            e.target.classList.remove('active');
          }
        });
      })();
    </script>
  </body>
</html>
