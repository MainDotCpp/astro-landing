  <!-- Quiz script -->
  <script>
    function handleQuiz(btn: HTMLButtonElement) {
      const parent = btn.closest('#quiz-1')
      if (!parent) return
      const answered = parent.getAttribute('data-answered')
      if (answered) return

      parent.setAttribute('data-answered', 'true')
      const buttons = parent.querySelectorAll('.quiz-option') as NodeListOf<HTMLButtonElement>
      const feedback = document.getElementById('quiz-feedback')

      buttons.forEach(b => {
        b.style.cursor = 'default'
        if (b.dataset.answer === 'correct') {
          b.classList.add('correct')
        }
      })

      if (btn.dataset.answer === 'correct') {
        if (feedback) {
          feedback.classList.remove('hidden')
          feedback.innerHTML = '<strong style="color: #27ae60;">Correct.</strong> The small body means open and close were similar. The long wicks mean the price went much higher and lower during the day. This describes what happened — it says nothing about what will happen next.'
        }
      } else {
        btn.classList.add('wrong')
        if (feedback) {
          feedback.classList.remove('hidden')
          feedback.innerHTML = '<strong style="color: #c0392b;">Not quite.</strong> Remember: candles describe what happened, not what will happen. The correct answer is C — the price moved a lot but ended near the open. No candle pattern can tell you to buy or predict tomorrow\'s price.'
        }
      }
    }
  </script>

