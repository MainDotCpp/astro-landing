---
import BaseLayout from '@/layouts/BaseLayout.astro'
import heroBg from './images/hero-bg.png'
import dashboardImg from './images/dashboard.png'

const title = "AI Wealth System | Elite Data Algorithm Trading"
const description = "Discover how to leverage AI big data for exponential returns. Exclusive access for Singapore investors."
---

<BaseLayout title={title} description={description} lang="en">
  <!-- Custom Fonts & Styles -->
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Outfit', sans-serif;
        background-color: #020617; /* slate-950 */
        color: #f8fafc;
        -webkit-font-smoothing: antialiased;
      }

      .text-gradient {
        background: linear-gradient(to right, #38bdf8, #818cf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .glass-panel {
        background: rgba(30, 41, 59, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .btn-glow {
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
        transition: all 0.3s ease;
      }

      .btn-glow:hover {
        box-shadow: 0 0 35px rgba(56, 189, 248, 0.7);
        transform: translateY(-2px);
      }

      .btn-whatsapp {
        background-color: #25D366;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.4);
      }

      .btn-whatsapp:hover {
        background-color: #128C7E;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
        transform: translateY(-2px);
      }

      @keyframes whatsapp-breathe {
        0% {
          transform: scale(1);
          box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
        }
        70% {
          transform: scale(1.05);
          box-shadow: 0 0 0 20px rgba(37, 211, 102, 0);
        }
        100% {
          transform: scale(1);
          box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
        }
      }

      .btn-whatsapp-floating {
        animation: whatsapp-breathe 2.5s infinite ease-in-out;
        box-shadow: 0 8px 30px rgba(37, 211, 102, 0.4);
      }
    </style>
  </Fragment>

  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img src={heroBg.src} alt="AI Data Network" class="w-full h-full object-cover opacity-50 object-top mix-blend-screen" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#020617]/40 via-[#020617]/70 to-slate-950"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-block px-4 py-1.5 rounded-full border border-sky-500/30 bg-sky-500/10 text-sky-400 font-semibold text-sm mb-8 animate-pulse">
        🚨 Singapore Exclusive: 2026 AI Algorithm Release
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 leading-[1.1]">
        The AI Big Data Model That Turned <br class="hidden md:block" />
        <span class="text-gradient">Market Noise Into $5.8M SGD.</span>
      </h1>

      <p class="text-lg md:text-2xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed font-light">
        Stop trading on human emotion. Discover the exact quantitative algorithm responsible for identifying <strong>100x return opportunities</strong> in days, entirely powered by artificial intelligence.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="javascript:void(0)" class="link-btn btn-glow bg-gradient-to-r from-sky-500 to-indigo-600 border border-sky-400/50 text-white font-bold text-lg py-4 px-10 rounded-full flex items-center justify-center gap-3 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Claim Free Access Now
        </a>
      </div>
      <p class="mt-5 text-slate-400 text-sm">Spots strictly limited to 50 active users this week.</p>
    </div>
  </section>

  <!-- Key Methodologies Section -->
  <section class="py-20 bg-slate-900 border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">Why Smart Money is Shifting to AI</h2>
        <p class="text-slate-400 max-w-2xl mx-auto text-lg leading-relaxed">Traditional analysis takes days. Our machine learning infrastructure scans global markets in milliseconds, identifying asymmetrical risk-reward setups before retail investors wake up.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="glass-panel p-8 rounded-2xl transition hover:bg-slate-800/80">
          <div class="w-14 h-14 bg-sky-500/10 rounded-xl flex items-center justify-center text-sky-400 text-2xl mb-6 border border-sky-500/20">🧠</div>
          <h3 class="text-xl font-bold mb-3 text-white">Predictive Big Data</h3>
          <p class="text-slate-400 leading-relaxed">Processing over 10T data points daily across news sentiment, dark pool prints, and option flows to mathematically predict breakouts.</p>
        </div>

        <!-- Feature 2 -->
        <div class="glass-panel p-8 rounded-2xl relative overflow-hidden transition hover:bg-slate-800/80">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-sky-400 to-indigo-500"></div>
          <div class="w-14 h-14 bg-indigo-500/10 rounded-xl flex items-center justify-center text-indigo-400 text-2xl mb-6 border border-indigo-500/20">⚡</div>
          <h3 class="text-xl font-bold mb-3 text-white">100x Pattern Recognition</h3>
          <p class="text-slate-400 leading-relaxed">Neural networks trained on 40 years of market cycles instantly recognize the precise setups proven to yield monumental short-term returns.</p>
        </div>

        <!-- Feature 3 -->
        <div class="glass-panel p-8 rounded-2xl transition hover:bg-slate-800/80">
          <div class="w-14 h-14 bg-purple-500/10 rounded-xl flex items-center justify-center text-purple-400 text-2xl mb-6 border border-purple-500/20">🛡️</div>
          <h3 class="text-xl font-bold mb-3 text-white">Flawless Execution</h3>
          <p class="text-slate-400 leading-relaxed">Completely removes fear, greed, and hesitation. Receive high-probability AI-generated trade alerts delivered directly to your device.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The $5.8M Case Study -->
  <section class="py-24 bg-[#020617]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col lg:flex-row items-center gap-16">

      <div class="flex-1 w-full relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-sky-500 to-indigo-600 rounded-2xl blur opacity-30"></div>
        <img src={dashboardImg.src} alt="Trading AI Dashboard" class="relative z-10 w-full h-auto rounded-xl shadow-2xl border border-slate-800 object-cover" />
      </div>

      <div class="flex-1 space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 text-indigo-400 font-bold tracking-widest text-sm uppercase mb-3">
            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
            Verified Case Study
          </div>
          <h2 class="text-3xl md:text-5xl font-bold leading-tight mb-4 text-white">The 5.8 Million SGD Short-Term Blueprint</h2>
          <p class="text-slate-400 text-lg leading-relaxed">In recent cycles, while traditional analysts were debating macroeconomics, our AI parsed algorithmic buying pressure on specific anomalies. The results speak for themselves.</p>
        </div>

        <ul class="space-y-5">
          <li class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full bg-sky-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <div class="w-2 h-2 rounded-full bg-sky-400"></div>
            </div>
            <div>
              <strong class="text-white block mb-1">Data points analyzed: 4.2 Billion</strong>
              <span class="text-slate-400 text-sm">Combined sentiment analysis, order book imbalances, and on-chain metrics within milliseconds.</span>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full bg-indigo-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
            </div>
            <div>
              <strong class="text-white block mb-1">Execution timeline: 22 Days</strong>
              <span class="text-slate-400 text-sm">Identifying the exact accumulation bottom before the impulsive wave triggered.</span>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
              <div class="w-2 h-2 rounded-full bg-purple-400"></div>
            </div>
            <div>
              <strong class="text-white block mb-1 text-xl text-sky-300">Result: $5.8M Profit</strong>
              <span class="text-slate-400 text-sm">Automated precision resulting in life-changing ROI that manual trading simply cannot match.</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-24 relative overflow-hidden bg-slate-900 border-t border-slate-800">
    <div class="absolute inset-0 bg-gradient-to-b from-sky-900/10 to-indigo-900/20"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">Ready to let AI do the heavy lifting?</h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">We are opening temporary access to our AI insights channel for Singapore residents. Gain access to the same signals driving institutional wealth.</p>

      <div class="p-8 md:p-12 glass-panel rounded-3xl max-w-2xl mx-auto border border-sky-400/30 shadow-2xl relative mt-4">
        <div class="inline-block bg-sky-500/20 border border-sky-500/50 text-sky-400 font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-widest mb-6">
          Limited Time Offer
        </div>

        <h3 class="text-2xl md:text-3xl font-bold mb-4 text-white">Free Algorithm Access</h3>
        <p class="text-slate-400 mb-8 text-lg">Receive 3 high-probability AI setups this week directly to your phone.</p>

        <a href="javascript:void(0)" class="link-btn btn-whatsapp text-white font-bold text-xl py-5 px-8 rounded-full flex items-center justify-center gap-3 mx-auto max-w-md w-full">
           <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
           Tap to Join WhatsApp Group
        </a>
      </div>
    </div>
  </section>

  <!-- Floating WhatsApp Button -->
  <div class="fixed bottom-6 right-6 z-50">
    <div class="relative">
      <a href="javascript:void(0)" class="link-btn btn-whatsapp-floating flex items-center justify-center w-16 h-16 rounded-full" style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); box-shadow: 0 8px 32px rgba(37, 211, 102, 0.45);">
        <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      </a>
      <span class="absolute -top-2 -right-2 min-w-[22px] h-[22px] px-1 flex items-center justify-center rounded-full bg-red-500 text-white text-[11px] font-bold border-2 border-[#020617] pointer-events-none">1</span>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-black py-12 text-center text-slate-500 text-sm border-t border-slate-900">
    <div class="max-w-5xl mx-auto px-4">
      <div class="flex justify-center items-center gap-2 mb-6 opacity-50">
        <div class="w-6 h-6 rounded bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center font-bold text-white text-xs">AI</div>
        <span class="font-bold tracking-wide text-white">Nexus<span class="text-sky-400">Wealth</span></span>
      </div>
      <p class="max-w-4xl mx-auto leading-relaxed text-[11px] md:text-xs">
        Disclaimer: All trading involves risk. The figures discussed (e.g., $5.8M SGD, 100x returns) are based on simulated algorithmic models, historical backtesting, and specific case studies; past performance is not indicative of future results. Our AI tools provide market intelligence and data, but do not constitute personalized financial advice or guaranteed profit. The case studies represent extraordinary outcomes over specific timeframes rather than average user experiences. Please seek guidance from a licensed financial advisor in Singapore before making investment decisions.
      </p>
      <p class="mt-6">&copy; {new Date().getFullYear()} NexusWealth AI. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
