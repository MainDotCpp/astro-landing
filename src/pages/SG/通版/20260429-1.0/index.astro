---
import BaseLayout from '@/layouts/BaseLayout.astro'
import featureImage from './images/landing-template-finance-hero-bg.png'
import heroImage from './images/landing-template-finance-research.png'
import mobileHeroImage from './images/landing-template-mobile-hero-bg.png'

const title = 'Singapore Stock Investment Community | WhatsApp Discussion Group'
const description = 'Join a Singapore-focused WhatsApp investment discussion community for stock ideas, market views, watchlist conversations, and risk-aware investing exchange.'

const benefits = [
  ['01', 'Stock idea exchange', 'Discuss Singapore, US, and Asia market opportunities with investors who are actively watching the market.'],
  ['02', 'Daily discussion topics', 'Get group prompts on market movers, earnings, sectors, charts, and news that investors are talking about.'],
  ['03', 'WhatsApp community', 'Join from your phone and follow practical investment conversations without scrolling through noisy feeds.'],
]

const noteTypes = [
  'Stock watchlist chat',
  'Market mover discussion',
  'SG & US sector themes',
  'Risk control reminders',
]

const discussionTopics = [
  ['Watchlist', 'Stock watchlist chat', 'Compare what members are tracking before the next market open.'],
  ['Momentum', 'Market mover discussion', 'Follow the names, sectors, and news catalysts getting attention today.'],
  ['Themes', 'SG & US sector themes', 'Connect Singapore, US, and Asia market narratives in one mobile room.'],
  ['Discipline', 'Risk control reminders', 'Keep every stock idea tied to position sizing, timing, and downside risk.'],
]

const steps = [
  ['Tap to join the group', 'Open WhatsApp and request access to the Singapore investment discussion community.'],
  ['Follow today’s topics', 'See what members are discussing: market news, watchlists, chart levels, and portfolio risk.'],
  ['Exchange views before acting', 'Use the conversation to compare perspectives, ask questions, and make your own informed decision.'],
]

const faqs = [
  ['What is this community for?', 'It is a WhatsApp investment exchange group for discussing stocks, market themes, watchlists, and risk-aware investing ideas.'],
  ['Which markets are discussed?', 'The group is built for Singapore readers and may discuss Singapore, US, Hong Kong, and broader Asia market opportunities.'],
  ['Will members share stock ideas?', 'Yes. The community may discuss watchlists and market opinions, but every view is for discussion only and not a guaranteed result.'],
  ['Is there any guaranteed return?', 'No. Investing involves risk, including possible loss of capital. Past performance never guarantees future results.'],
]
---

<BaseLayout title={title} description={description} lang="en">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #05070b;
        --panel: rgba(255, 255, 255, 0.075);
        --panel-strong: rgba(255, 255, 255, 0.13);
        --line: rgba(255, 255, 255, 0.16);
        --text: #f8fafc;
        --muted: #a8b3c7;
        --soft: #dbe7ff;
        --gold: #f4c96b;
        --green: #25d366;
        --cyan: #3be8ff;
        --sans: 'Manrope', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 9% 8%, rgba(59, 232, 255, 0.18), transparent 28rem),
          radial-gradient(circle at 95% 4%, rgba(244, 201, 107, 0.15), transparent 30rem),
          linear-gradient(135deg, #05070b 0%, #0b1220 48%, #081416 100%);
        color: var(--text);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .page {
        position: relative;
        isolation: isolate;
      }

      .page::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -2;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
        background-size: 80px 80px;
        mask-image: linear-gradient(to bottom, #000 0%, transparent 75%);
        pointer-events: none;
      }

      .shell {
        width: min(1180px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .hero {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        background: #020617;
        box-shadow: inset 0 -120px 120px rgba(5, 7, 11, 0.88);
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(90deg, rgba(2, 6, 23, 0.9) 0%, rgba(2, 6, 23, 0.62) 44%, rgba(2, 6, 23, 0.08) 100%);
        pointer-events: none;
      }

      .hero-media {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .hero-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        min-height: inherit;
        display: grid;
        grid-template-columns: minmax(0, 0.7fr) minmax(17rem, 0.3fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: end;
        padding: clamp(5rem, 10vw, 8rem) 0 clamp(2.5rem, 6vw, 4.5rem);
      }

      .hero-content {
        max-width: 46rem;
      }

      .hero-panel {
        align-self: end;
        margin-bottom: clamp(0.2rem, 2vw, 1.2rem);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.82rem;
        border: 1px solid rgba(244, 201, 107, 0.34);
        border-radius: 999px;
        background: rgba(244, 201, 107, 0.09);
        color: #fde68a;
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .eyebrow-dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 0 0.45rem rgba(37, 211, 102, 0.14);
      }

      .hero-title {
        max-width: 13ch;
        margin: 1.35rem 0 1.2rem;
        font-family: var(--sans);
        font-size: clamp(3.4rem, 7vw, 7.2rem);
        font-weight: 800;
        line-height: 0.92;
        letter-spacing: -0.065em;
      }

      .hero-title span {
        display: inline-block;
        background: linear-gradient(120deg, #fff 0%, var(--gold) 45%, var(--cyan) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .lead {
        max-width: 40rem;
        margin: 0;
        color: var(--muted);
        font-size: clamp(1.05rem, 1.5vw, 1.28rem);
        line-height: 1.82;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 2rem;
      }

      .cta,
      .ghost-cta {
        display: inline-flex;
        min-height: 3.85rem;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      .cta {
        padding: 0 1.5rem;
        background: linear-gradient(135deg, #25d366 0%, #11a685 45%, #0ea5e9 100%);
        color: white;
        box-shadow: 0 22px 70px rgba(37, 211, 102, 0.32);
      }

      .ghost-cta {
        padding: 0 1.35rem;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.075);
        color: var(--soft);
      }

      .cta:hover,
      .ghost-cta:hover {
        transform: translateY(-2px);
      }

      .cta:hover {
        box-shadow: 0 28px 80px rgba(37, 211, 102, 0.42);
      }

      .wa-icon {
        width: 1.25rem;
        height: 1.25rem;
      }

      .mini-note {
        max-width: 34rem;
        margin: 1rem 0 0;
        color: #8190aa;
        font-size: 0.86rem;
        line-height: 1.6;
      }

      .floating-ticket {
        padding: 1rem;
        border: 1px solid rgba(37, 211, 102, 0.28);
        border-radius: 1.35rem;
        background: rgba(2, 6, 23, 0.84);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.34);
        backdrop-filter: blur(18px);
      }

      .floating-ticket strong {
        display: block;
        color: white;
        font-size: 1rem;
      }

      .floating-ticket span {
        display: block;
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.84rem;
        line-height: 1.55;
      }

      .metric-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 1rem;
      }

      .metric {
        padding: 0.8rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.07);
      }

      .metric b {
        display: block;
        color: var(--gold);
        font-size: 0.88rem;
      }

      .metric small {
        color: #8ea0bc;
      }

      .topic-strip {
        display: grid;
        grid-template-columns: minmax(16rem, 0.38fr) minmax(0, 0.62fr);
        gap: clamp(1rem, 3vw, 2rem);
        align-items: stretch;
        padding: clamp(2.25rem, 5vw, 4.5rem) 0 clamp(3rem, 6vw, 5rem);
      }

      .topic-intro,
      .topic-card,
      .benefit-card,
      .step-card,
      .faq-card {
        border: 1px solid var(--line);
        background: var(--panel);
        backdrop-filter: blur(16px);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
      }

      .topic-intro {
        position: relative;
        overflow: hidden;
        min-height: 18rem;
        padding: clamp(1.4rem, 3vw, 2rem);
        border-radius: 1.8rem;
        background:
          radial-gradient(circle at 18% 18%, rgba(244, 201, 107, 0.24), transparent 12rem),
          linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.035));
      }

      .topic-intro::after {
        content: 'SG';
        position: absolute;
        right: -0.55rem;
        bottom: -1.25rem;
        color: rgba(255, 255, 255, 0.05);
        font-size: clamp(7rem, 18vw, 13rem);
        font-weight: 800;
        letter-spacing: -0.12em;
        line-height: 0.8;
      }

      .topic-intro h2 {
        position: relative;
        z-index: 1;
        max-width: 9ch;
        margin: 0;
        font-size: clamp(2.1rem, 4vw, 4.2rem);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.06em;
      }

      .topic-intro p:last-child {
        position: relative;
        z-index: 1;
        max-width: 24rem;
        margin: 1.1rem 0 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .topic-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .topic-card {
        position: relative;
        overflow: hidden;
        min-height: 13.5rem;
        padding: 1.15rem;
        border-radius: 1.5rem;
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.045)),
          radial-gradient(circle at 100% 0%, rgba(59, 232, 255, 0.15), transparent 12rem);
      }

      .topic-card::before {
        content: '';
        position: absolute;
        inset: auto 1.1rem 0 1.1rem;
        height: 3px;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--green), var(--gold), transparent);
        opacity: 0.75;
      }

      .topic-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.8rem;
      }

      .topic-number {
        color: rgba(255, 255, 255, 0.32);
        font-size: 2.35rem;
        font-weight: 800;
        line-height: 0.85;
        letter-spacing: -0.08em;
      }

      .topic-tag {
        padding: 0.38rem 0.62rem;
        border: 1px solid rgba(244, 201, 107, 0.25);
        border-radius: 999px;
        color: #fde68a;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .topic-card h3 {
        margin: 0;
        color: white;
        font-size: 1.12rem;
        letter-spacing: -0.04em;
      }

      .topic-card p {
        margin: 0.72rem 0 0;
        color: var(--muted);
        line-height: 1.62;
      }

      .section {
        padding: clamp(3.5rem, 8vw, 7rem) 0;
      }

      .section-head {
        max-width: 48rem;
        margin-bottom: clamp(1.8rem, 4vw, 3rem);
      }

      .section-kicker {
        margin: 0 0 0.8rem;
        color: var(--gold);
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .section-title {
        margin: 0;
        font-family: var(--sans);
        font-size: clamp(2.45rem, 5vw, 4.8rem);
        font-weight: 800;
        line-height: 0.98;
        letter-spacing: -0.06em;
      }

      .section-copy {
        margin: 1rem 0 0;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
      }

      .benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .benefit-card {
        min-height: 20rem;
        padding: 1.2rem;
        border-radius: 1.5rem;
      }

      .benefit-index {
        display: block;
        margin-bottom: 3.4rem;
        color: var(--gold);
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 0.8;
        letter-spacing: -0.06em;
      }

      .benefit-card h3,
      .step-card h3,
      .faq-card h3 {
        margin: 0;
        color: white;
        font-size: 1.14rem;
        letter-spacing: -0.04em;
      }

      .benefit-card p,
      .step-card p,
      .faq-card p {
        margin: 0.85rem 0 0;
        color: var(--muted);
        line-height: 1.72;
      }

      .image-section {
        background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.035) 42%, transparent 100%);
      }

      .image-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
        gap: clamp(1.2rem, 3vw, 2.4rem);
        align-items: center;
      }

      .desk-frame {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 2rem;
        box-shadow: 0 34px 110px rgba(0, 0, 0, 0.42);
      }

      .desk-frame img {
        width: 100%;
        height: 34rem;
        object-fit: cover;
        object-position: center;
      }

      .note-panel {
        padding: clamp(1.4rem, 4vw, 2.6rem);
        border: 1px solid rgba(244, 201, 107, 0.24);
        border-radius: 2rem;
        background:
          radial-gradient(circle at 100% 0%, rgba(37, 211, 102, 0.14), transparent 18rem),
          rgba(255, 255, 255, 0.075);
        backdrop-filter: blur(18px);
      }

      .note-list {
        display: grid;
        gap: 0.65rem;
        margin-top: 1.4rem;
      }

      .note-chip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.82rem 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.06);
        color: var(--soft);
        font-weight: 800;
      }

      .note-chip::after {
        content: '→';
        color: var(--gold);
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .step-card {
        padding: 1.25rem;
        border-radius: 1.45rem;
      }

      .step-number {
        display: inline-grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        margin-bottom: 1.4rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--gold), var(--cyan));
        color: #06111f;
        font-weight: 900;
      }

      .faq-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .faq-card {
        padding: 1.2rem;
        border-radius: 1.35rem;
      }

      .final {
        padding: clamp(3.5rem, 8vw, 7rem) 0;
      }

      .final-card {
        position: relative;
        overflow: hidden;
        padding: clamp(2rem, 6vw, 4.5rem);
        border: 1px solid rgba(37, 211, 102, 0.28);
        border-radius: 2.2rem;
        background:
          linear-gradient(90deg, rgba(2, 6, 23, 0.92), rgba(2, 6, 23, 0.72)),
          var(--final-bg);
        background-size: cover;
        background-position: center;
        text-align: center;
        box-shadow: 0 36px 120px rgba(0, 0, 0, 0.45);
      }

      .final-card h2 {
        max-width: 13ch;
        margin: 0 auto;
        font-family: var(--sans);
        font-size: clamp(2.8rem, 6vw, 5.6rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .final-card p {
        max-width: 42rem;
        margin: 1.1rem auto 2rem;
        color: var(--muted);
        line-height: 1.78;
      }

      .footer {
        padding: 2.5rem 0 5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.09);
        color: #7f8da6;
        font-size: 0.82rem;
        line-height: 1.7;
      }

      .footer strong {
        color: var(--soft);
      }

      .floating-cta {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 30;
        display: none;
        width: 3.65rem;
        height: 3.65rem;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #25d366, #128c7e);
        color: white;
        box-shadow: 0 18px 54px rgba(37, 211, 102, 0.38);
        text-decoration: none;
      }

      @media (max-width: 980px) {
        .hero-inner,
        .image-layout {
          grid-template-columns: 1fr;
        }

        .hero-media img {
          object-position: 58% center;
        }

        .topic-strip {
          grid-template-columns: 1fr;
        }

        .benefit-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 680px) {
        .shell {
          width: min(100% - 1.2rem, 1180px);
        }

        .hero {
          min-height: 100svh;
        }

        .hero::before {
          background: linear-gradient(180deg, rgba(2, 6, 23, 0.18) 0%, rgba(2, 6, 23, 0.46) 38%, rgba(2, 6, 23, 0.94) 100%);
        }

        .hero-media img {
          object-position: center top;
        }

        .hero-inner {
          gap: 1.25rem;
          min-height: inherit;
          padding: 5.2rem 0 1.4rem;
        }

        .hero-title {
          max-width: 11ch;
          font-size: clamp(2.55rem, 12vw, 3.45rem);
          line-height: 0.98;
          letter-spacing: -0.055em;
        }

        .section-title,
        .final-card h2 {
          font-size: clamp(2.05rem, 10vw, 2.9rem);
          line-height: 1.02;
          letter-spacing: -0.05em;
        }

        .lead {
          font-size: 1rem;
          line-height: 1.68;
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
          margin-top: 1.35rem;
        }

        .cta,
        .ghost-cta {
          width: 100%;
          min-height: 3.45rem;
        }

        .hero-panel {
          align-self: stretch;
        }

        .floating-ticket {
          width: 100%;
          border-radius: 1.15rem;
        }

        .metric-row {
          grid-template-columns: 1fr;
          gap: 0.55rem;
        }

        .topic-grid,
        .benefit-grid,
        .steps,
        .faq-grid {
          grid-template-columns: 1fr;
        }

        .topic-strip {
          padding-bottom: 2rem;
        }

        .topic-intro,
        .topic-card {
          border-radius: 1.25rem;
        }

        .topic-intro {
          min-height: 14rem;
        }

        .topic-card {
          min-height: auto;
        }

        .section {
          padding: 3rem 0;
        }

        .benefit-card {
          min-height: auto;
        }

        .benefit-index {
          margin-bottom: 2rem;
        }

        .desk-frame {
          border-radius: 1.35rem;
        }

        .desk-frame img {
          height: 18rem;
        }

        .note-panel,
        .final-card {
          border-radius: 1.35rem;
        }

        .footer {
          padding-bottom: 5.8rem;
        }

        .floating-cta {
          display: inline-flex;
        }
      }
    </style>
  </Fragment>

  <main class="page">
    <section class="hero">
      <picture class="hero-media" aria-hidden="true">
        <source media="(max-width: 680px)" srcset={mobileHeroImage.src} />
        <img src={heroImage.src} alt="" width="1536" height="1024" loading="eager" fetchpriority="high" />
      </picture>
      <div class="shell hero-inner">
        <div class="hero-content">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Singapore investment community</div>
          <h1 class="hero-title">Talk stocks with <span>sharper investors.</span></h1>
          <p class="lead">Join a WhatsApp investment exchange community for Singapore readers who want active stock discussions, market watchlists, sector themes, and risk-aware viewpoints before making their own moves.</p>
          <div class="hero-actions">
            <a href="javascript:void(0)" class="link-btn cta" data-umami-event="cta-click" data-umami-event-platform="whatsapp">
