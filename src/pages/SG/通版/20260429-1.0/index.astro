        <h2 id="topic-heading">What the room talks about.</h2>
        <p>Designed for investors who want sharper context before acting, not another noisy feed of random tips.</p>
      </div>
      <div class="topic-grid">
        {discussionTopics.map((topic, index) => (
          <article class="topic-card">
            <div class="topic-card-top">
              <span class="topic-number">0{index + 1}</span>
              <span class="topic-tag">{topic[0]}</span>
            </div>
            <h3>{topic[1]}</h3>
            <p>{topic[2]}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="learn" class="shell section">
      <div class="section-head">
        <p class="section-kicker">Why investors join</p>
        <h2 class="section-title">A sharper room for stock conversation.</h2>
        <p class="section-copy">Instead of reading the market alone, join a focused WhatsApp room where investors exchange watchlists, compare interpretations, and discuss risk before taking action.</p>
      </div>
      <div class="benefit-grid">
        {benefits.map(benefit => (
          <article class="benefit-card">
            <span class="benefit-index">{benefit[0]}</span>
            <h3>{benefit[1]}</h3>
            <p>{benefit[2]}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="image-section section">
