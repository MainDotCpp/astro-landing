---
import BaseLayout from '@/layouts/BaseLayout.astro'
import communityBriefing from './images/community-briefing.png'
import heroDesktop from './images/hero-desktop.png'
import heroMobile from './images/hero-mobile.png'
import marketDesk from './images/market-desk.png'

const title = 'Singapore Market Briefing Room | WhatsApp Investor Community'
const description = 'Join a Singapore-focused WhatsApp investor community for market briefings, watchlist discussion, stock themes, and risk-aware learning.'

const briefCards = [
  ['Morning map', 'Overnight market movers, SGX context, and the sectors worth watching before the day starts.'],
  ['Watchlist exchange', 'Compare stocks members are tracking across Singapore, US, Hong Kong, and Asia markets.'],
  ['Risk lens', 'Discuss entries, exits, sizing, and downside scenarios before turning an idea into action.'],
]

const dayFlow = [
  ['08:15', 'Pre-market pulse', 'Global headlines, futures tone, and local themes for Singapore investors.'],
  ['12:30', 'Midday check', 'What is moving, what is fading, and where the group is asking sharper questions.'],
  ['20:00', 'US open prep', 'Key charts, earnings reactions, and risk notes before the next session begins.'],
]

const topics = [
  'SG banks and REITs',
  'US technology leaders',
  'Hong Kong momentum',
  'Earnings reactions',
  'Dividend watchlists',
  'Macro headlines',
  'Chart levels',
  'Risk planning',
]

const proofPoints = [
  ['Focused room', 'No noisy broadcast feed — just structured prompts and member discussion.'],
  ['Singapore lens', 'Built around the questions local investors ask when global markets move.'],
  ['Education first', 'Every discussion is for learning and comparison, not personalized financial advice.'],
]

const faqs = [
  ['Is this financial advice?', 'No. The group is for general education and market discussion only. It does not provide personalized financial advice.'],
  ['Which markets are discussed?', 'Members may discuss Singapore, US, Hong Kong, and broader Asia market ideas from a Singapore investor perspective.'],
  ['Will stock ideas be shared?', 'Members may share watchlists and opinions, but outcomes are never guaranteed and every investor must make their own decision.'],
  ['Is there investment risk?', 'Yes. Investing can lead to loss of capital. Treat all discussion as educational and manage risk carefully.'],
]
---

<BaseLayout title={title} description={description} lang="en-SG">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --obsidian: #07110f;
        --ink: #0d211c;
        --green: #0d6b4f;
        --mint: #7ef0c2;
        --gold: #d8a947;
        --cream: #f8efd8;
        --paper: #fffbef;
        --muted: #6f7d75;
        --line: rgba(13, 33, 28, 0.15);
        --glass: rgba(255, 251, 239, 0.72);
        --display: 'Instrument Serif', Georgia, serif;
        --sans: 'Manrope', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--obsidian);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        overflow-x: hidden;
        background:
          radial-gradient(circle at 12% 0%, rgba(126, 240, 194, 0.26), transparent 26rem),
          radial-gradient(circle at 96% 10%, rgba(216, 169, 71, 0.24), transparent 26rem),
          linear-gradient(180deg, #06110f 0%, #10251e 34%, #f5ead0 34.1%, #fff8e8 100%);
        color: var(--ink);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }

      img {
        display: block;
        max-width: 100%;
      }

      .page {
        position: relative;
        min-height: 100vh;
        isolation: isolate;
      }

      .shell {
        width: min(1140px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .hero {
        position: relative;
        min-height: 100svh;
        padding: clamp(1rem, 2vw, 1.4rem);
        color: var(--paper);
      }

      .hero-card {
        position: relative;
        display: grid;
        min-height: calc(100svh - clamp(2rem, 4vw, 2.8rem));
        overflow: hidden;
        border: 1px solid rgba(255, 251, 239, 0.18);
        border-radius: clamp(1.5rem, 4vw, 3rem);
        background: #0b1814;
        box-shadow: 0 2rem 7rem rgba(0, 0, 0, 0.42);
      }

      .hero-card::after {
        position: absolute;
        inset: 0;
        content: '';
        background:
          linear-gradient(90deg, rgba(6, 17, 15, 0.9) 0%, rgba(6, 17, 15, 0.68) 38%, rgba(6, 17, 15, 0.18) 72%),
          linear-gradient(0deg, rgba(6, 17, 15, 0.84) 0%, transparent 36%);
        z-index: 1;
      }

      .hero-picture {
        position: absolute;
        inset: 0;
      }

      .hero-picture img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-picture .mobile {
        display: none;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        display: grid;
        align-content: end;
        max-width: 47rem;
        padding: clamp(1.5rem, 5vw, 4.5rem);
      }

      .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.55rem;
        margin: 0 0 1rem;
        padding: 0.48rem 0.75rem;
        border: 1px solid rgba(248, 239, 216, 0.28);
        border-radius: 999px;
        background: rgba(248, 239, 216, 0.11);
        color: var(--mint);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        backdrop-filter: blur(18px);
      }

      .eyebrow::before {
        width: 0.48rem;
        height: 0.48rem;
        border-radius: 50%;
        background: var(--mint);
        box-shadow: 0 0 24px var(--mint);
        content: '';
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      .hero-title {
        max-width: 10ch;
        margin-bottom: 1.1rem;
        font-family: var(--display);
        font-size: clamp(4rem, 12vw, 10.5rem);
        font-weight: 400;
        line-height: 0.82;
        letter-spacing: -0.075em;
      }

      .hero-copy {
        max-width: 38rem;
        margin-bottom: 1.6rem;
        color: rgba(255, 251, 239, 0.78);
        font-size: clamp(1.02rem, 2vw, 1.28rem);
        line-height: 1.75;
      }

      .hero-actions,
      .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        align-items: center;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.4rem;
        padding: 0.95rem 1.35rem;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, #25d366, #0ba66e);
        color: #04100c;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 1rem 2.5rem rgba(37, 211, 102, 0.25);
        transition: transform 180ms ease, box-shadow 180ms ease;
      }

      .cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 1.25rem 3rem rgba(37, 211, 102, 0.34);
      }

      .ghost {
        border: 1px solid rgba(255, 251, 239, 0.2);
        background: rgba(255, 251, 239, 0.1);
        color: var(--paper);
        box-shadow: none;
        backdrop-filter: blur(14px);
      }

      .hero-stats {
        position: absolute;
        right: clamp(1.2rem, 4vw, 4rem);
        bottom: clamp(1.2rem, 4vw, 4rem);
        z-index: 2;
        display: grid;
        width: min(24rem, calc(100% - 2.4rem));
        gap: 0.8rem;
      }

      .stat-card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.9rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border: 1px solid rgba(248, 239, 216, 0.16);
        border-radius: 1.2rem;
        background: rgba(7, 17, 15, 0.58);
        color: rgba(255, 251, 239, 0.76);
        backdrop-filter: blur(18px);
      }

      .stat-card strong {
        display: grid;
        width: 2.5rem;
        height: 2.5rem;
        place-items: center;
        border-radius: 0.9rem;
        background: rgba(126, 240, 194, 0.14);
        color: var(--mint);
      }

      .ticker {
        overflow: hidden;
        border-block: 1px solid rgba(248, 239, 216, 0.18);
        background: var(--obsidian);
        color: var(--cream);
      }

      .ticker-track {
        display: flex;
        width: max-content;
        gap: 2rem;
        padding: 0.85rem 0;
        animation: ticker 30s linear infinite;
      }

      .ticker span {
        color: rgba(255, 251, 239, 0.78);
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .section {
        padding: clamp(4rem, 8vw, 7rem) 0;
      }

      .section-head {
        display: grid;
        grid-template-columns: minmax(0, 0.66fr) minmax(18rem, 0.34fr);
        gap: clamp(1rem, 4vw, 3rem);
        align-items: end;
        margin-bottom: clamp(1.8rem, 4vw, 3.2rem);
      }

      .kicker {
        margin-bottom: 0.75rem;
        color: var(--green);
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .section-title {
        max-width: 12ch;
        font-family: var(--display);
        font-size: clamp(3.2rem, 8vw, 7.4rem);
        font-weight: 400;
        line-height: 0.86;
        letter-spacing: -0.065em;
      }

      .section-copy {
        color: var(--muted);
        font-size: 1.03rem;
        line-height: 1.82;
      }

      .brief-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 1rem;
      }

      .image-panel,
      .content-panel,
      .flow-card,
      .proof-card,
      .faq-card {
        border: 1px solid var(--line);
        border-radius: 2rem;
        background: var(--glass);
        box-shadow: 0 1.5rem 5rem rgba(50, 36, 12, 0.1);
        backdrop-filter: blur(18px);
      }

      .image-panel {
        overflow: hidden;
      }

      .image-panel img {
        width: 100%;
        height: 100%;
        min-height: 34rem;
        object-fit: cover;
      }

      .content-panel {
        display: grid;
        gap: 0.9rem;
        padding: clamp(1rem, 3vw, 1.4rem);
      }

      .brief-card {
        padding: 1.15rem;
        border-radius: 1.45rem;
        background: rgba(255, 255, 255, 0.46);
      }

      .brief-card h3,
      .flow-card h3,
      .proof-card h3,
      .faq-card h3 {
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
        letter-spacing: -0.035em;
      }

      .brief-card p,
      .flow-card p,
      .proof-card p,
      .faq-card p {
        margin-bottom: 0;
        color: var(--muted);
        line-height: 1.72;
      }

      .desk-section {
        background: linear-gradient(180deg, transparent, rgba(13, 107, 79, 0.08));
      }

      .desk-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: clamp(1rem, 3vw, 1.5rem);
        align-items: stretch;
      }

      .flow-list {
        display: grid;
        gap: 0.85rem;
      }

      .flow-card {
        display: grid;
        grid-template-columns: 5rem 1fr;
        gap: 1rem;
        padding: 1.05rem;
      }

      .time {
        display: grid;
        height: 4rem;
        place-items: center;
        border-radius: 1.2rem;
        background: var(--ink);
        color: var(--mint);
        font-weight: 900;
      }

      .topic-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.6rem;
      }

      .topic-cloud span {
        padding: 0.75rem 1rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 251, 239, 0.74);
        color: var(--ink);
        font-size: 0.9rem;
        font-weight: 800;
      }

      .proof-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .proof-card {
        padding: 1.35rem;
      }

      .proof-card::before {
        display: block;
        width: 2.75rem;
        height: 0.25rem;
        margin-bottom: 1.2rem;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--green), var(--gold));
        content: '';
      }

      .cta-section {
        padding: clamp(4rem, 8vw, 7rem) 0 calc(clamp(4rem, 8vw, 7rem) + 4rem);
        background: var(--obsidian);
        color: var(--paper);
      }

      .cta-box {
        position: relative;
        overflow: hidden;
        padding: clamp(1.5rem, 5vw, 4rem);
        border: 1px solid rgba(255, 251, 239, 0.16);
        border-radius: 2.5rem;
        background:
          radial-gradient(circle at 80% 20%, rgba(126, 240, 194, 0.2), transparent 23rem),
          linear-gradient(135deg, rgba(13, 107, 79, 0.46), rgba(7, 17, 15, 0.96));
        box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.32);
      }

      .cta-box h2 {
        max-width: 11ch;
        margin-bottom: 1rem;
        font-family: var(--display);
        font-size: clamp(3.4rem, 8vw, 7rem);
        font-weight: 400;
        line-height: 0.86;
        letter-spacing: -0.065em;
      }

      .cta-box p {
        max-width: 39rem;
        color: rgba(255, 251, 239, 0.76);
        font-size: 1.08rem;
        line-height: 1.78;
      }

      .faq-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-top: 2rem;
      }

      .faq-card {
        background: rgba(255, 251, 239, 0.08);
        border-color: rgba(255, 251, 239, 0.14);
        padding: 1.2rem;
      }

      .faq-card h3 {
        color: var(--paper);
      }

      .faq-card p {
        color: rgba(255, 251, 239, 0.68);
      }

      .disclaimer {
        margin-top: 1.6rem;
        color: rgba(255, 251, 239, 0.5);
        font-size: 0.8rem;
        line-height: 1.7;
      }

      .floating-cta {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.2rem;
        padding: 0.85rem 1.2rem;
        border-radius: 999px;
        background: #25d366;
        color: #03100b;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.22);
      }

      @keyframes ticker {
        to {
          transform: translateX(-50%);
        }
      }

      @media (max-width: 900px) {
        body {
          background: linear-gradient(180deg, #06110f 0%, #10251e 38%, #f5ead0 38.1%, #fff8e8 100%);
        }

        .hero {
          min-height: auto;
          padding: 0;
        }

        .hero-card {
          min-height: 94svh;
          border-radius: 0 0 2rem 2rem;
          border-inline: 0;
          border-top: 0;
        }

        .hero-card::after {
          background:
            linear-gradient(180deg, rgba(6, 17, 15, 0.08) 0%, rgba(6, 17, 15, 0.35) 38%, rgba(6, 17, 15, 0.94) 100%);
        }

        .hero-picture .desktop {
          display: none;
        }

        .hero-picture .mobile {
          display: block;
        }

        .hero-content {
          align-content: end;
          padding: 1.15rem 1rem 16.25rem;
        }

        .hero-title {
          font-size: clamp(4.7rem, 21vw, 7.4rem);
        }

        .hero-stats {
          right: 1rem;
          bottom: 1rem;
          width: calc(100% - 2rem);
          grid-template-columns: 1fr;
        }

        .stat-card {
          min-height: 3.65rem;
          padding: 0.65rem 0.8rem;
        }

        .stat-card strong {
          width: 2.1rem;
          height: 2.1rem;
          border-radius: 0.72rem;
        }

        .section-head,
        .brief-grid,
        .desk-grid,
        .proof-grid,
        .faq-grid {
          grid-template-columns: 1fr;
        }

        .section-title,
        .cta-box h2 {
          max-width: 9ch;
        }

        .image-panel img {
          min-height: 22rem;
        }

        .flow-card {
          grid-template-columns: 4.4rem 1fr;
        }

        .ghost {
          display: none;
        }
      }

      @media (max-width: 520px) {
        .shell {
          width: min(100% - 1.2rem, 1140px);
        }

        .hero-copy {
          font-size: 0.98rem;
          line-height: 1.65;
        }

        .cta,
        .floating-cta {
          width: 100%;
        }

        .floating-cta {
          right: 0.75rem;
          bottom: 0.75rem;
          width: calc(100% - 1.5rem);
        }
      }
    </style>
  </Fragment>

  <main class="page">
    <section class="hero" aria-label="Singapore market briefing hero">
      <div class="hero-card">
        <picture class="hero-picture">
          <img class="desktop" src={heroDesktop.src} alt="Singapore financial district market briefing desk at sunrise" />
          <img class="mobile" src={heroMobile.src} alt="Mobile view of a Singapore investor community briefing" />
        </picture>

        <div class="hero-content">
          <p class="eyebrow">Singapore investor briefing</p>
          <h1 class="hero-title">Start the market day sharper.</h1>
          <p class="hero-copy">Join a focused WhatsApp room for Singapore readers who want clearer stock discussion, daily watchlist context, and risk-aware market learning before making their own decisions.</p>
          <div class="hero-actions">
            <a class="cta link-btn" href="javascript:void(0)" aria-label="Join the WhatsApp investor community">Join WhatsApp Room</a>
            <a class="cta ghost" href="#briefing">See what is inside</a>
          </div>
        </div>

        <div class="hero-stats" aria-label="Community highlights">
          {briefCards.map((card, index) => (
            <div class="stat-card">
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <span>{card[0]}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[...topics, ...topics].map((topic) => <span>{topic}</span>)}
      </div>
    </div>

    <section class="section" id="briefing">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">Briefing format</p>
            <h2 class="section-title">A calmer way to read the market.</h2>
          </div>
          <p class="section-copy">Instead of chasing scattered tips, use a structured community rhythm: headlines, watchlists, questions, and risk notes that help you compare views before taking action.</p>
        </div>

        <div class="brief-grid">
          <div class="image-panel">
            <img src={communityBriefing.src} alt="Singapore investors reviewing market ideas together" />
          </div>
          <div class="content-panel">
            {briefCards.map((card) => (
              <article class="brief-card">
                <h3>{card[0]}</h3>
                <p>{card[1]}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section desk-section">
      <div class="shell desk-grid">
        <div>
          <p class="kicker">Daily rhythm</p>
          <h2 class="section-title">Three useful check-ins.</h2>
          <p class="section-copy">The room is designed around moments when investors actually need context — before Singapore opens, during active moves, and before the US session changes the tone.</p>
          <div class="topic-cloud" aria-label="Common discussion topics">
            {topics.map((topic) => <span>{topic}</span>)}
          </div>
        </div>

        <div class="image-panel">
          <img src={marketDesk.src} alt="Market analysis desk with risk checklist and charts" />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">Inside the room</p>
            <h2 class="section-title">From market noise to useful notes.</h2>
          </div>
          <div class="flow-list">
            {dayFlow.map((item) => (
              <article class="flow-card">
                <div class="time">{item[0]}</div>
                <div>
                  <h3>{item[1]}</h3>
                  <p>{item[2]}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="proof-grid">
          {proofPoints.map((point) => (
            <article class="proof-card">
              <h3>{point[0]}</h3>
              <p>{point[1]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="shell">
        <div class="cta-box">
          <p class="eyebrow">Free community access</p>
          <h2>Join before the next market open.</h2>
          <p>Tap below to request access to the Singapore WhatsApp investor briefing room. Read the discussion, compare perspectives, and keep risk in view before making your own investment choices.</p>
          <div class="cta-actions">
            <a class="cta link-btn" href="javascript:void(0)" aria-label="Join the WhatsApp room now">Join WhatsApp Room</a>
          </div>

          <div class="faq-grid">
            {faqs.map((faq) => (
              <article class="faq-card">
                <h3>{faq[0]}</h3>
                <p>{faq[1]}</p>
              </article>
            ))}
          </div>

          <p class="disclaimer">Important: This page and community are for general educational discussion only and do not constitute financial advice, investment recommendations, or any guarantee of results. Markets are risky and you may lose money.</p>
        </div>
      </div>
    </section>

    <a class="floating-cta link-btn" href="javascript:void(0)" aria-label="Join WhatsApp investor community">Join WhatsApp</a>
  </main>
</BaseLayout>
