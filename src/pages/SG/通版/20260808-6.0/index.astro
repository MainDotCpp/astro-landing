---
import RedirectCode from '@/components/RedirectCode.astro'
import heroFibre from './assets/images/hero-fibre.png'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Everyone's Counting GPUs — The AI Bottleneck Is the Cables Between Them</title>
    <meta
      name="description"
      content="Washington is drafting a ban on Chinese optical modules that would cut 60% of the supply US AI data centres run on. Building them in the West needs indium phosphide, which China restricted last year. A look at the chokepoint nobody is watching."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Chivo+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style
      define:vars={{
        fibreImg: `url(${heroFibre.src})`,
      }}
    >
      :root {
        --void: #07090c;
        --panel: #0e1216;
        --panel-2: #141b23;
        --cyan: #40d9c4;
        --cyan-d: #22a894;
        --text: #e9ecef;
        --mut: #939aa3;
        --dim: #6a7079;
        --edge: rgba(233, 236, 239, 0.12);
        --wa: #25d366;
        --wa-d: #1bae52;
        --sans: 'Manrope', system-ui, -apple-system, sans-serif;
        --mono: 'Chivo Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        font-family: var(--sans);
        background: var(--void);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: calc(84px + env(safe-area-inset-bottom));
      }
      img { display: block; max-width: 100%; }

      .wrap { width: 100%; padding-inline: 21px; }

      .dateline {
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--dim);
      }

      /* ---------- hero ---------- */
      .hero {
        display: flex;
        align-items: center;
        min-height: 100svh;
        padding-top: calc(env(safe-area-inset-top) + 40px);
        padding-bottom: calc(108px + env(safe-area-inset-bottom));
        background-image:
          linear-gradient(
            183deg,
            rgba(7, 9, 12, 0.88) 0%,
            rgba(7, 9, 12, 0.6) 36%,
            rgba(7, 9, 12, 0.9) 100%
          ),
          var(--fibreImg);
        background-size: cover, auto 128%;
        background-position: center, 50% 66%;
        background-repeat: no-repeat;
      }
      .hero h1 {
        margin-top: 18px;
        font-weight: 800;
        font-size: clamp(2.05rem, 8.8vw, 2.8rem);
        line-height: 1.1;
        letter-spacing: -0.032em;
        text-wrap: balance;
      }
      .hero h1 span { color: var(--cyan); }
      .hero .lede {
        margin-top: 19px;
        font-size: 1.03rem;
        color: var(--mut);
        max-width: 45ch;
      }
      .acts { margin-top: 28px; }

      /* ---------- buttons ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 16px 24px;
        border: none;
        border-radius: 6px;
        background: var(--cyan);
        color: #04231e;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.14s ease;
        box-shadow: 0 16px 40px -18px rgba(64, 217, 196, 0.85);
      }
      .btn svg { width: 17px; height: 17px; flex: none; }
      .btn:hover { background: #5ce3d1; transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }

      /* ---------- sections ---------- */
      .sec { padding-block: 58px; border-top: 1px solid var(--edge); }
      .sec h2 {
        font-weight: 800;
        font-size: clamp(1.68rem, 7.2vw, 2.2rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        max-width: 20ch;
        text-wrap: balance;
      }
      .sec p.body { margin-top: 16px; color: var(--mut); font-size: 1rem; max-width: 49ch; }
      .sec p.body + p.body { margin-top: 14px; }
      .sec strong { color: var(--text); font-weight: 600; }

      /* ---------- deadlock ---------- */
      .lock { background: var(--panel); }
      .lock-grid { margin-top: 34px; }
      .jaw {
        padding: 24px 21px 26px;
        border: 1px solid var(--edge);
        border-radius: 8px;
        background: var(--panel-2);
      }
      .jaw.b { border-color: rgba(64, 217, 196, 0.3); }
      .side-label {
        font-family: var(--mono);
        font-size: 0.67rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--dim);
      }
      .jaw.b .side-label { color: var(--cyan); }
      .jaw h3 {
        margin-top: 10px;
        font-weight: 700;
        font-size: 1.2rem;
        line-height: 1.26;
        letter-spacing: -0.024em;
      }
      .jaw ul { margin-top: 15px; }
      .jaw li {
        list-style: none;
        padding-left: 16px;
        position: relative;
        color: var(--mut);
        font-size: 0.96rem;
      }
      .jaw li + li { margin-top: 11px; }
      .jaw li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.65em;
        width: 6px;
        height: 1px;
        background: var(--dim);
      }
      .jaw.b li::before { background: var(--cyan); }
      .jaw li b { color: var(--text); font-weight: 600; }

      .clash {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding-block: 18px;
        color: var(--dim);
      }
      .clash svg { width: 20px; height: 20px; }
      .clash span {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      .verdict {
        margin-top: 30px;
        padding: 22px 21px 24px;
        border-left: 3px solid var(--cyan);
        background: rgba(64, 217, 196, 0.06);
        font-size: 1.06rem;
        font-weight: 600;
        line-height: 1.44;
        letter-spacing: -0.014em;
        max-width: 44ch;
      }

      /* ---------- numbers ---------- */
      .nums { margin-top: 32px; display: grid; gap: 1px; background: var(--edge); }
      .nums > div { background: var(--void); padding: 20px 0 18px; }
      .nums .nn {
        font-family: var(--mono);
        font-weight: 600;
        font-size: 1.62rem;
        letter-spacing: -0.035em;
        line-height: 1.1;
        color: var(--cyan);
      }
      .nums .nl { margin-top: 9px; font-size: 0.92rem; color: var(--mut); }

      /* ---------- close ---------- */
      .close { background: var(--panel); }
      .fine {
        margin-top: 17px;
        font-family: var(--mono);
        font-size: 0.71rem;
        color: var(--dim);
      }
      .close .acts { margin-top: 28px; }

      /* ---------- foot ---------- */
      .foot { padding-block: 30px 38px; border-top: 1px solid var(--edge); }
      .foot p { font-size: 0.76rem; color: var(--dim); max-width: 64ch; line-height: 1.6; }

      /* ---------- whatsapp bar ---------- */
      .wa-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 12px 21px calc(12px + env(safe-area-inset-bottom));
        background: rgba(7, 9, 12, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-top: 1px solid var(--edge);
      }
      .wa-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 15px 22px;
        border: none;
        border-radius: 6px;
        background: var(--wa);
        color: #04210f;
        cursor: pointer;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1.02rem;
        box-shadow: 0 12px 30px -14px rgba(37, 211, 102, 0.9);
        transition: background 0.2s ease, transform 0.14s ease;
      }
      .wa-btn svg { width: 22px; height: 22px; flex: none; }
      .wa-btn:hover { background: var(--wa-d); transform: translateY(-2px); }
      .wa-btn:active { transform: translateY(0); }
      .wa-btn:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }

      /* ---------- motion ---------- */
      .rise { animation: rise 0.64s cubic-bezier(0.22, 0.72, 0.3, 1) both; }
      .d1 { animation-delay: 0.08s; }
      .d2 { animation-delay: 0.18s; }
      @keyframes rise {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: none; }
      }
      .js .reveal {
        opacity: 0;
        transform: translateY(17px);
        transition: opacity 0.58s ease, transform 0.58s cubic-bezier(0.22, 0.72, 0.3, 1);
      }
      .js .reveal.in { opacity: 1; transform: none; }

      /* ---------- larger screens ---------- */
      @media (min-width: 820px) {
        .wrap { max-width: 1060px; margin-inline: auto; padding-inline: clamp(32px, 5vw, 60px); }
        body { padding-bottom: 96px; }

        .hero {
          padding-top: calc(env(safe-area-inset-top) + 80px);
          padding-bottom: 126px;
          background-size: cover, cover;
          background-position: center, center 56%;
        }
        .hero h1 { font-size: clamp(2.8rem, 4.4vw, 3.7rem); max-width: 18ch; }
        .hero .lede { font-size: 1.13rem; }
        .btn { width: auto; min-width: 260px; }

        .sec { padding-block: 100px; }
        .sec h2 { font-size: clamp(2.15rem, 3.1vw, 2.8rem); }

        .lock-grid {
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          gap: 0;
          align-items: stretch;
          margin-top: 48px;
        }
        .jaw { padding: 32px 30px 34px; }
        .clash { flex-direction: column; padding: 0 22px; justify-content: center; }
        .clash span { writing-mode: vertical-rl; letter-spacing: 0.2em; }
        .verdict { margin-top: 40px; padding: 28px 30px 30px; font-size: 1.24rem; }

        .nums { grid-template-columns: repeat(4, 1fr); margin-top: 46px; }
        .nums > div { padding: 26px 22px 24px; }
        .nums .nn { font-size: 1.75rem; }

        .wa-bar { padding-inline: 0; }
        .wa-bar .wrap { display: flex; justify-content: flex-end; }
        .wa-btn { width: auto; min-width: 300px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise { animation: none; }
        .js .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <!-- ============ HERO ============ -->
    <header class="hero">
      <div class="wrap">
        <p class="dateline rise">8 August 2026</p>

        <h1 class="rise d1">
          Everyone's counting GPUs.<br />
          Nobody's counting <span>the cables between them.</span>
        </h1>

        <p class="lede rise d1">
          A regulator in Washington is drafting a rule that would cut roughly 60% of the optical
          modules American AI data centres run on. The obvious answer is to build them in the West.
          Except the raw material comes from China, and China restricted exports of it last year.
        </p>

        <div class="acts rise d2">
          <button type="button" class="btn link-btn">
            Get tomorrow's briefing, free
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- ============ WHY IT'S THE BOTTLENECK ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">A chip that can't talk to the next chip is very expensive dead weight</h2>
        <p class="body reveal">
          Training a large model doesn't happen on one processor. It happens across tens of thousands
          of them, and every one has to talk to the others constantly. A cluster runs at the speed of
          its slowest link, not its fastest chip.
        </p>
        <p class="body reveal">
          Past a certain distance that talking is done in light. Optical modules — the plug-in parts
          that turn electricity into light at each end of a cable — carry it rack to rack, row to
          row, building to building across the campus. <strong>An AI cluster needs them in numbers
          nothing before it ever did</strong>, which is why modules running at 800G (800 gigabits
          down a single link) and above went from under a fifth of shipments in 2024 to more than 60%
          this year.
        </p>
        <p class="body reveal">
          If you hold an S&amp;P 500 tracker, or anything with Nvidia in it, you already own a slice
          of this fight. You just own it through the chips — not through the part that's actually
          short.
        </p>
      </div>
    </section>

    <!-- ============ THE DEADLOCK ============ -->
    <section class="sec lock">
      <div class="wrap">
        <h2 class="reveal">Each side is holding something the other needs</h2>
        <p class="body reveal">
          This is usually reported as one country restricting another. One side has already moved.
          The other is still drafting. That's what makes it a standoff rather than a headline.
        </p>

        <div class="lock-grid">
          <article class="jaw a reveal">
            <p class="side-label">Washington · drafting</p>
            <h3>An import ban on Chinese optical modules</h3>
            <ul>
              <li>Chinese manufacturers supply <b>more than half</b> of the world's high-speed optical links</li>
              <li>Estimates put the hit at around <b>60% of module supply</b> for US AI data centres</li>
              <li>Coherent and Lumentum, the two American suppliers everyone points to, <b>can't cover the gap</b> at current capacity</li>
              <li>The rule is <b>still a draft</b> under review, and officials have said it could be changed or shelved</li>
            </ul>
          </article>

          <div class="clash reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
            <span>Locked</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M18 13l-6 6-6-6" /></svg>
          </div>

          <article class="jaw b reveal">
            <p class="side-label">Beijing · already done</p>
            <h3>Export limits on indium phosphide</h3>
            <ul>
              <li>Restricted in <b>February 2025</b>, well before the American draft appeared</li>
              <li><b>Nearly every high-speed laser</b> inside these modules starts life on an indium phosphide wafer</li>
              <li>A six-inch wafer — the disc the lasers are cut from — went from roughly <b>US$1,400 to US$5,000</b></li>
              <li>So the Western replacement plan <b>still starts with a Chinese supplier</b></li>
            </ul>
          </article>
        </div>

        <p class="verdict reveal">
          Ban the modules and you still need the wafers. And the wafers come from the same place.
        </p>
      </div>
    </section>

    <!-- ============ DEMAND ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">The demand curve hasn't read the news</h2>
        <p class="body reveal">
          Whatever gets decided, the clusters still have to be wired. Chinese makers have already
          started moving capacity offshore — into Malaysia, Thailand and Vietnam, a couple of hours'
          flight from here and the same neighbourhood our own supply chain sits in.
        </p>

        <div class="nums">
          <div class="reveal">
            <p class="nn">US$16.5B → US$26B</p>
            <p class="nl">AI optical module market, 2025 to 2026</p>
          </div>
          <div class="reveal">
            <p class="nn">33.5M</p>
            <p class="nl">800G units forecast for 2026, after Goldman raised its estimate 58%</p>
          </div>
          <div class="reveal">
            <p class="nn">7M</p>
            <p class="nl">1.6T (1.6 terabit) units expected in 2026, the next speed step up</p>
          </div>
          <div class="reveal">
            <p class="nn">19.5% → 60%</p>
            <p class="nl">Share of shipments at 800G and above, 2024 to 2026</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT IT MEANS ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">Nobody needs another hot tip</h2>
        <p class="body reveal">
          Anyone can list the companies involved. The harder question is which layer keeps its
          pricing power when politics reroutes the chain: the module assemblers, the laser makers,
          the wafer suppliers, or the switch makers who have to sign off on whatever gets used
          instead.
        </p>
        <p class="body reveal">
          That's the part worth following — <strong>where the bottleneck moves next</strong>, rather
          than which ticker moved yesterday.
        </p>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="sec close">
      <div class="wrap">
        <h2 class="reveal">We follow this chain every trading morning</h2>
        <p class="body reveal">
          Where the rule ends up, who's moving capacity where, and which part of the chain the money
          is actually chasing. Three things in the group by 9.00am, before SGX opens.
        </p>

        <div class="acts reveal">
          <button type="button" class="btn link-btn">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>

        <p class="fine reveal">Free · nothing to download · leave whenever you like</p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <p>
          Everything here is general market commentary and educational research. It does not take
          your objectives or financial situation into account, and it is not a recommendation to buy
          or sell anything. Markets carry risk. Do your own research before you invest.
        </p>
      </div>
    </footer>

    <!-- ============ FLOATING WHATSAPP ============ -->
    <div class="wa-bar">
      <div class="wrap">
        <button type="button" class="wa-btn link-btn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
          Join the free group
        </button>
      </div>
    </div>

    <script is:inline>
      ;(function () {
        const items = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!items.length)
          return

        function tick() {
          const vh = window.innerHeight || document.documentElement.clientHeight
          for (let i = items.length - 1; i >= 0; i--) {
            const r = items[i].getBoundingClientRect()
            if (r.top < vh - 70) {
              items[i].classList.add('in')
              items.splice(i, 1)
            }
          }
          if (!items.length) {
            window.removeEventListener('scroll', tick)
            window.removeEventListener('resize', tick)
          }
        }

        window.addEventListener('scroll', tick, { passive: true })
        window.addEventListener('resize', tick)
        tick()
        setTimeout(tick, 300)
      })()
    </script>
  </body>
</html>
