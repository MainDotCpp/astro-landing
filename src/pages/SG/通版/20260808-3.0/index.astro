    </div>

    <script is:inline>
      ;(function () {
        /* ---- countdown ---- */
        const box = document.getElementById('count')
        if (box) {
          const target = new Date(box.getAttribute('data-target')).getTime()
          const elD = document.getElementById('cd-d')
          const elH = document.getElementById('cd-h')
          const elM = document.getElementById('cd-m')
          const pad = n => (n < 10 ? '0' + n : String(n))

          function draw() {
            const diff = target - Date.now()
            if (diff <= 0) {
              box.classList.add('done')
              elD.textContent = 'The decision is out. The full read is already in the group.'
              return false
            }
            elD.textContent = String(Math.floor(diff / 86400000))
            elH.textContent = pad(Math.floor(diff / 3600000) % 24)
            elM.textContent = pad(Math.floor(diff / 60000) % 60)
            return true
          }

          if (draw()) {
            const timer = setInterval(function () {
              if (!draw())
                clearInterval(timer)
            }, 20000)
          }
        }

        /* ---- scroll reveal ---- */
        const items = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!items.length)
          return

        function tick() {
          const vh = window.innerHeight || document.documentElement.clientHeight
          for (let i = items.length - 1; i >= 0; i--) {
            const r = items[i].getBoundingClientRect()
            if (r.top < vh - 70) {
              items[i].classList.add('in')
              items.splice(i, 1)
            }
          }
          if (!items.length) {
            window.removeEventListener('scroll', tick)
            window.removeEventListener('resize', tick)
          }
        }

        window.addEventListener('scroll', tick, { passive: true })
        window.addEventListener('resize', tick)
        tick()
        setTimeout(tick, 300)
      })()
    </script>
