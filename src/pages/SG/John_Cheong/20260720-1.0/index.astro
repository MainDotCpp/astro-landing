---
import RedirectCode from '@/components/RedirectCode.astro'
import heroNight from './assets/images/hero-night.png'
import av1 from './assets/images/avatar-1.png'
import av2 from './assets/images/avatar-2.png'
import av3 from './assets/images/avatar-3.png'
import av4 from './assets/images/avatar-4.png'
import johnPhoto from './assets/images/john-cheong.jpg'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Learn the Market with John Cheong — Join 11,000+ Singapore Investors, Free on WhatsApp</title>
    <meta
      name="description"
      content="Learn to invest in SGX stocks, S-REITs and the local banks with 11,000+ Singaporeans — guided by John Cheong, Head of Small & Mid Cap Research at UOB Kay Hian. Free morning brief, join on WhatsApp in one tap."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,900&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <style define:vars={{ hero: `url(${heroNight.src})` }}>
      /* =========================================================
         Near-single-screen landing with analyst intro up top.
         Mobile-first: base = ~390px phone; wider screens enhanced.
         ========================================================= */
      :root {
        --bg:      #07100D;
        --ink:     #F3F7F4;
        --ink-mut: #A6BCAF;
        --ink-dim: #6E8579;
        --gold:    #E9B949;
        --gold-d:  #C9952A;
        --wa:      #25D366;
        --wa-d:    #1FB855;
        --up:      #3FD07A;
        --line:    #234234;
        --serif:   'Fraunces', Georgia, serif;
        --sans:    'Hanken Grotesk', system-ui, sans-serif;
        --mono:    'JetBrains Mono', ui-monospace, monospace;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        font-family: var(--sans); color: var(--ink); background: var(--bg);
        -webkit-font-smoothing: antialiased; overflow-x: hidden; line-height: 1.5;
      }
      a { color: inherit; text-decoration: none; }

      .stage {
        position: relative; min-height: 100svh;
        display: flex; flex-direction: column;
        padding: calc(env(safe-area-inset-top) + 26px) 22px calc(env(safe-area-inset-bottom) + 22px);
        background:
          linear-gradient(180deg, rgba(7,16,13,.62) 0%, rgba(7,16,13,.78) 46%, rgba(7,16,13,.96) 100%),
          radial-gradient(80% 50% at 50% 108%, rgba(233,185,73,.16), transparent 70%),
          var(--hero);
        background-size: cover; background-position: center 30%;
      }

      /* ---- top: eyebrow + social proof ---- */
      .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      .eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--mono); font-weight: 500; font-size: .68rem;
        letter-spacing: .12em; text-transform: uppercase; color: var(--gold);
      }
      .eyebrow .live { width: 7px; height: 7px; border-radius: 50%; background: var(--up);
        animation: ping 2.2s ease-out infinite; }
      @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(63,208,122,.55) } 70%,100% { box-shadow: 0 0 0 8px rgba(63,208,122,0) } }
      .rating { font-family: var(--mono); font-size: .72rem; color: var(--ink-mut); white-space: nowrap; }
      .rating b { color: var(--gold); }

      /* ---- analyst intro ---- */
      .analyst {
        display: flex; align-items: center; gap: 15px;
      }
      .analyst-photo {
        width: 74px; height: 74px; border-radius: 50%; object-fit: cover; display: block;
        border: 2px solid var(--gold);
        box-shadow: 0 0 0 4px rgba(233,185,73,.16), 0 14px 30px -10px rgba(0,0,0,.6);
        background: #1a2c22; flex-shrink: 0;
      }
      .analyst-name { display: block; font-family: var(--serif); font-weight: 700; font-size: 1.22rem; line-height: 1.15; }
      .analyst-role { display: block; margin-top: 3px; font-size: .82rem; color: var(--ink-mut); }
      .analyst-creds {
        display: block; margin-top: 6px; font-family: var(--mono); font-weight: 500;
        font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gold);
      }
      /* ---- middle: the hook ---- */
      .core { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-block: 10px; max-width: 600px; }
      .core h1 {
        margin-top: 14px;
        font-family: var(--serif); font-weight: 900; line-height: 1.04; letter-spacing: -0.02em;
        font-size: clamp(2.4rem, 12vw, 3.3rem);
      }
      .core h1 .g { color: var(--gold); font-style: italic; font-weight: 600;
        background: linear-gradient(transparent 62%, rgba(233,185,73,.28) 62%); }
      .core .sub {
        margin-top: 13px; font-size: 1rem; color: var(--ink-mut); max-width: 32ch;
      }
      .core .sub b { color: var(--ink); font-weight: 700; }
      .topics {
        margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px;
      }
      .topics span {
        font-family: var(--mono); font-weight: 500; font-size: .76rem; color: var(--ink-mut);
        border: 1px solid var(--line); border-radius: 8px; padding: 6px 11px; background: rgba(15,33,26,.5);
      }
      .topics b { color: var(--gold); font-weight: 700; }

      /* ---- bottom: avatars + CTA ---- */
      .bottom { display: flex; flex-direction: column; gap: 16px; }
      .members { display: flex; align-items: center; gap: 12px; }
      .avatars { display: flex; }
      .avatars img {
        width: 36px; height: 36px; border-radius: 50%; margin-left: -11px; border: 2px solid var(--bg);
        object-fit: cover; object-position: 50% 22%; display: block; background: #1a2c22;
      }
      .avatars img:first-child { margin-left: 0; }
      .members .m-txt { font-size: .86rem; color: var(--ink-mut); }
      .members .m-txt b { color: var(--ink); font-weight: 700; }

      .btn {
        display: flex; align-items: center; justify-content: center; gap: 11px; width: 100%;
        font-family: var(--sans); font-weight: 800; font-size: 1.1rem; color: #06120C;
        background: var(--wa); padding: 18px 24px; border-radius: 14px; cursor: pointer; border: none;
        box-shadow: 0 18px 40px -12px rgba(37,211,102,.7);
        transition: background .2s ease, transform .15s ease, box-shadow .25s ease;
        animation: pulse 2.6s ease-in-out infinite;
      }
      .btn svg { width: 24px; height: 24px; flex-shrink: 0; }
      .btn:hover { background: var(--wa-d); transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      @keyframes pulse { 0%,100% { box-shadow: 0 18px 40px -12px rgba(37,211,102,.55) } 50% { box-shadow: 0 20px 52px -8px rgba(37,211,102,.9) } }

      .reassure { text-align: center; font-size: .8rem; color: var(--ink-dim);
        display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 12px; }
      .reassure .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--gold-d); }
      .reassure svg { width: 14px; height: 14px; color: var(--up); }

      /* ---- enter animation (one orchestrated load) ---- */
      .fade { opacity: 0; transform: translateY(16px); animation: rise .7s cubic-bezier(.2,.7,.3,1) forwards; }
      .fade.d1 { animation-delay: .08s }
      .fade.d2 { animation-delay: .18s }
      .fade.d3 { animation-delay: .28s }
      .fade.d4 { animation-delay: .40s }
      @keyframes rise { to { opacity: 1; transform: none; } }

      /* =========================================================
         ≥ 760px — desktop / tablet: center the content block
         ========================================================= */
      @media (min-width: 760px) {
        .stage { padding-inline: clamp(40px, 7vw, 96px); background-position: center 26%; }
        .core { margin-inline: auto; width: 100%; align-items: center; text-align: center; }
        .analyst { justify-content: center; text-align: left; }
        .analyst-photo { width: 86px; height: 86px; }
        .core h1 { font-size: clamp(3rem, 5.4vw, 4.4rem); max-width: 17ch; }
        .core .sub { max-width: 46ch; font-size: 1.14rem; }
        .topics { justify-content: center; }
        .bottom { max-width: 460px; margin-inline: auto; width: 100%; }
        .top { max-width: 1100px; margin-inline: auto; width: 100%; }
      }

      @media (prefers-reduced-motion: reduce) {
        .fade { opacity: 1; transform: none; animation: none; }
        .btn { animation: none; }
        .eyebrow .live { animation: none; }
      }
    </style>
  </head>

  <body>
    <main class="stage">
      <!-- top bar -->
      <div class="top">
        <span class="eyebrow fade"><span class="live"></span> Singapore · investing community</span>
        <span class="rating fade">★★★★★ <b>4.9</b> · 11,000+ members</span>
      </div>

      <!-- the hook -->
      <div class="core">
        <div class="analyst fade d1">
          <img class="analyst-photo" src={johnPhoto.src} width="74" height="74" alt="John Cheong, Head of Small & Mid Cap Research at UOB Kay Hian" />
          <div class="analyst-id">
            <b class="analyst-name">John Cheong</b>
            <span class="analyst-role">Head of Small &amp; Mid Cap Research, UOB Kay Hian</span>
            <span class="analyst-creds">CFA · ACCA · 15+ yrs</span>
          </div>
        </div>
        <h1 class="fade d2">Learn the market <span class="g">before you risk a dollar.</span></h1>
        <p class="sub fade d2">
          Join <b>11,000+ Singaporeans</b> making sense of SGX stocks, S-REITs and the three local banks — with John's free morning brief and a chat group that actually explains the <i>why.</i>
        </p>
        <div class="topics fade d3">
          <span><b>SGX</b> stocks</span>
          <span><b>S-REITs</b></span>
          <span>DBS · OCBC · UOB</span>
          <span><b>CPF</b> / SRS</span>
        </div>
      </div>

      <!-- bottom CTA -->
      <div class="bottom">
        <div class="members fade d3">
          <div class="avatars">
            <img src={av1.src} alt="" width="36" height="36" loading="lazy" />
            <img src={av2.src} alt="" width="36" height="36" loading="lazy" />
            <img src={av3.src} alt="" width="36" height="36" loading="lazy" />
            <img src={av4.src} alt="" width="36" height="36" loading="lazy" />
          </div>
          <span class="m-txt"><b>11,000+</b> investors already inside — free, and growing daily.</span>
        </div>
        <a class="btn fade d4 link-btn" onclick="mixinJump()">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z"/></svg>
          Join the community — free
        </a>
        <span class="reassure fade d4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          Free to join <span class="dot"></span> No sign-up <span class="dot"></span> Leave anytime
        </span>
      </div>
    </main>
  </body>
</html>
