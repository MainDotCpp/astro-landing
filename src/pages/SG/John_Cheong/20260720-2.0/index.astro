---
import RedirectCode from '@/components/RedirectCode.astro'
import johnPhoto from './assets/images/john-cheong.jpg'
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>SG Market Watchlist with John Cheong - Free WhatsApp Group</title>
    <meta
      name="description"
      content="Join a free Singapore WhatsApp group led by John Cheong, Head of Small & Mid Cap Research at UOB Kay Hian — SGX watchlists, S-REIT notes, local bank updates and daily market risk reminders."
    />
    <RedirectCode />
    <style>
      * {
        box-sizing: border-box;
      }

      html {
        background: #d9d9d9;
        color: #111;
        font-family: Arial, Verdana, Helvetica, sans-serif;
        font-size: 16px;
      }

      body {
        margin: 0;
        background: #d9d9d9;
      }

      a {
        color: #0000cc;
      }

      .page {
        width: 100%;
        max-width: 430px;
        min-height: 100svh;
        margin: 0 auto;
        background: #fff;
        border-right: 1px solid #777;
        border-left: 1px solid #777;
      }

      .topbar {
        padding: 9px 12px;
        background: #003399;
        border-bottom: 3px solid #cc0000;
        color: #fff;
      }

      .site-name {
        display: block;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.1;
      }

      .site-line {
        display: block;
        margin-top: 3px;
        font-size: 12px;
      }

      .content {
        padding: 13px 12px 18px;
      }

      .analyst {
        margin: 0 0 13px;
        padding: 10px;
        background: #e8eef8;
        border: 1px solid #999;
      }

      .analyst-row {
        display: flex;
        align-items: center;
        gap: 11px;
      }

      .analyst-row img {
        display: block;
        width: 66px;
        height: 66px;
        border: 1px solid #777;
        background: #fff;
        padding: 2px;
        flex-shrink: 0;
      }

      .analyst-name {
        display: block;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.15;
      }

      .analyst-role {
        display: block;
        margin-top: 3px;
        color: #333;
        font-size: 12px;
        line-height: 1.3;
      }

      .analyst-creds {
        display: block;
        margin-top: 4px;
        color: #003399;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      h1 {
        margin: 0 0 8px;
        color: #111;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 30px;
        line-height: 1.04;
      }

      .lead {
        margin: 0 0 11px;
        font-size: 16px;
        line-height: 1.45;
      }

      .red {
        color: #cc0000;
        font-weight: 700;
      }

      .alert {
        margin: 12px 0;
        padding: 10px;
        background: #fff7c2;
        border: 1px solid #c8a600;
        font-size: 14px;
        line-height: 1.45;
      }

      .btn {
        display: block;
        width: 100%;
        margin: 12px 0;
        padding: 12px 10px;
        background: #19a84c;
        border: 2px solid #0b6f2e;
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        text-align: center;
        text-decoration: none;
      }

      .btn:active,
      .btn:hover {
        background: #10883b;
      }

      .small {
        margin: 7px 0 0;
        color: #444;
        font-size: 12px;
        line-height: 1.35;
      }

      .section-title {
        margin: 15px 0 7px;
        padding: 5px 7px;
        background: #eeeeee;
        border: 1px solid #999;
        color: #000;
        font-size: 15px;
        font-weight: 700;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 14px;
      }

      th,
      td {
        padding: 8px 7px;
        border: 1px solid #999;
        vertical-align: top;
      }

      th {
        width: 34%;
        background: #e8eef8;
        color: #003399;
        font-size: 13px;
        text-align: left;
      }

      td {
        line-height: 1.35;
      }

      .warning {
        margin: 13px 0;
        padding: 10px;
        border: 2px solid #cc0000;
        background: #fff;
        font-size: 15px;
        line-height: 1.45;
      }

      .topics {
        margin: 0;
        padding: 0;
        list-style: none;
        border: 1px solid #999;
        border-bottom: 0;
      }

      .topics li {
        padding: 8px 9px;
        border-bottom: 1px solid #999;
        font-size: 14px;
      }

      .topics b {
        color: #003399;
      }

      .final-box {
        margin-top: 14px;
        padding: 10px;
        background: #f4f4f4;
        border: 1px solid #999;
      }

      .final-box p {
        margin: 0 0 8px;
        font-size: 15px;
        line-height: 1.45;
      }

      .fineprint {
        margin-top: 14px;
        padding-top: 10px;
        border-top: 1px solid #bbb;
        color: #555;
        font-size: 11px;
        line-height: 1.4;
      }

      @media (min-width: 700px) {
        .page {
          margin-top: 20px;
          margin-bottom: 20px;
          box-shadow: 0 2px 8px rgb(0 0 0 / 18%);
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <div class="topbar">
        <span class="site-name">SG Market Watchlist</span>
        <span class="site-line">Free WhatsApp Group · SGX / S-REITs / Banks</span>
      </div>

      <div class="content">
        <div class="analyst">
          <div class="analyst-row">
            <img src={johnPhoto.src} width="66" height="66" alt="John Cheong, Head of Small & Mid Cap Research at UOB Kay Hian" />
            <div>
              <b class="analyst-name">John Cheong</b>
              <span class="analyst-role">Head of Small &amp; Mid Cap Research, UOB Kay Hian</span>
              <span class="analyst-creds">CFA · ACCA · 15+ years equity research</span>
            </div>
          </div>
        </div>

        <h1>Don’t buy SG stocks blind.</h1>
        <p class="lead">
          Get John’s short morning watchlist for SGX names, S-REITs, DBS, OCBC, UOB and STI ETF.
          <span class="red">Reason. Risk. What to watch.</span>
        </p>

        <div class="alert">
          Before you buy or chase a moving counter, read the note first. Free to join. No payment. No form to fill in.
          Leave anytime.
        </div>

        <a class="btn link-btn" href="javascript:void(0)" onclick="onLinkBtnClick()">Get Today’s Watchlist</a>
        <p class="small">Opens in WhatsApp. No extra app needed.</p>

        <div class="section-title">Inside the group</div>
        <table aria-label="What members receive in the stock watchlist group">
          <tbody>
            <tr>
              <th>Before market opens</th>
              <td>Counters worth watching, and why they are on the list.</td>
            </tr>
            <tr>
              <th>Market hours</th>
              <td>A quick check before you chase a fast-moving counter.</td>
            </tr>
            <tr>
              <th>After close</th>
              <td>Short notes, risk reminders and the next day’s watchlist.</td>
            </tr>
          </tbody>
        </table>

        <div class="warning">
          <b class="red">Don’t wait until every chat is shouting the same counter.</b>
          This is for Singapore investors who want the idea, the reason and the risk clearly laid out before making a move.
        </div>

        <div class="section-title">What we track</div>
        <ul class="topics">
          <li><b>SGX counters</b> with clear news or volume change</li>
          <li><b>S-REITs and local banks</b>: DBS, OCBC and UOB</li>
          <li><b>STI ETF</b>, CPF / SRS angles and market risk reminders</li>
        </ul>

        <div class="final-box">
          <p>
            Want the list before the next noisy move?
          </p>
          <a class="btn link-btn" href="javascript:void(0)" onclick="onLinkBtnClick()">Join the SG Watchlist Group</a>
          <p class="small">Already use WhatsApp? You’re ready.</p>
        </div>

        <p class="fineprint">
          Education and discussion only. Not financial advice. Not a buy or sell recommendation. Markets carry risk.
          Do your own checks before investing.
        </p>
      </div>
    </main>
  </body>
</html>
