// ===== DOM Content Loaded =====
document.addEventListener('DOMContentLoaded', () => {
  initializeAnimations()
  initializeScrollEffects()
  initializeParticles()
  initializeMobileMenu()
  initializeCounters()
  initializeTestimonialsSlider()
