---
// Import Image component
import { Image } from 'astro:assets'

// Import images
import avatarImg from '@/assets/avatar/三橋貴明_avatar.png'
import img3 from './static/images/3.jpg'
import img5 from './static/images/5.jpg'
import lineIcon from './static/images/line.png'

// Import CSS
import './static/css/style.css'
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>三橋貴明 投資コミュニティ | 無料参加で投資スキルアップ</title>
    <meta
      name="description"
      content="三橋貴明が主催する投資者公益社群。初心者から上級者まで、一緒に学べる投資コミュニティです。今なら無料で参加可能！"
    />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
      rel="stylesheet"
    />

     <!---------------------------⬇⬇⬇⬇跟踪代码粘贴在这里⬇⬇⬇⬇------------------------------------>

    <!---------------------------⬆⬆⬆⬆跟踪代码粘贴在这里⬆⬆⬆⬆----------------------------------->
    <script is:inline>
      function onLinkBtnClick() {
        const link = 'https://line.me/R/ti/p/@your-line-id'
        if (typeof gtag_report_conversion === 'function') {
          gtag_report_conversion()
        }
        setTimeout(() => {
          window.location.href = link
        }, 100)
      }
    </script>
  </head>
  <body>
    <!-- Fixed CTA Button -->
    <div class="fixed-cta">
      <button onclick="onLinkBtnClick()" class="cta-button">
        <Image src={lineIcon} alt="LINE" class="line-icon" />
        <span>LINEをクリックして学習グループに参加</span>
      </button>
    </div>

    <!-- Header -->
    <header class="header">
      <nav class="nav">
        <div class="nav-brand">
          <i class="fas fa-chart-line"></i>
          <span>三橋貴明投資コミュニティ</span>
        </div>
        <div class="nav-links">
          <a href="#about">プロフィール</a>
          <a href="#benefits">特典</a>
          <a href="#testimonials">体験談</a>
          <a href="#join">参加方法</a>
        </div>
      </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-particles"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <div class="hero-left">
            <div class="hero-badge">
              <i class="fas fa-star"></i>
              <span>限定公開</span>
            </div>
            <h1 class="hero-title">
              <span class="highlight">三橋貴明</span>と一緒に学ぶ<br />
              <span class="gradient-text">投資コミュニティ</span>
            </h1>
            <p class="hero-subtitle">
              経済評論家・投資アドバイザーとして<br />
              長年の経験と実績を持つ三橋貴明が、<br />
              <strong>無料で投資の知識とノウハウを共有</strong>
            </p>
            <div class="hero-stats">
              <div class="stat-item">
                <div class="stat-number">20年+</div>
                <div class="stat-label">投資経験</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">100冊+</div>
                <div class="stat-label">著書・監修</div>
              </div>
              <div class="stat-item">
                <div class="stat-number">50万+</div>
                <div class="stat-label">フォロワー</div>
              </div>
            </div>
            <div class="hero-cta">
              <div class="cta-note">
                <i class="fas fa-gift"></i>
                <span>参加特典：投資指南プレゼント</span>
              </div>
            </div>
          </div>
          <div class="hero-right">
            <div class="hero-image">
              <div class="profile-card">
                <div class="profile-avatar">
                  <Image
                    src={avatarImg}
                    alt="三橋貴明"
                    style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%"
                  />
                </div>
                <div class="profile-info">
                  <h3>三橋貴明</h3>
                  <p>経済評論家・投資アドバイザー</p>
                  <div class="profile-tags">
                    <span class="tag">経済評論家</span>
                    <span class="tag">投資顧問</span>
                    <span class="tag">著作家</span>
                  </div>
                </div>
              </div>
              <div class="floating-elements">
                <div class="float-item stock-chart">
                  <i class="fas fa-chart-area"></i>
                  <span>+15.2%</span>
                </div>
                <div class="float-item portfolio">
                  <i class="fas fa-wallet"></i>
                  <span>ポートフォリオ</span>
                </div>
                <div class="float-item dividend">
                  <i class="fas fa-coins"></i>
                  <span>配当収入</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
      <div class="container">
        <div class="section-header">
          <h2>三橋貴明について</h2>
          <p>経済評論家として長年活動し、投資アドバイザーとして実績を積む</p>
        </div>
        <div class="about-content">
          <div class="about-left">
            <div class="about-image">
              <div class="achievement-badges">
                <div class="badge">
                  <i class="fas fa-trophy"></i>
                  <span>経済評論家として実績</span>
                </div>
                <div class="badge">
                  <i class="fas fa-book"></i>
                  <span>著書100冊以上</span>
                </div>
              </div>
            </div>
          </div>
          <div class="about-right">
            <div class="timeline">
              <div class="timeline-item">
                <div class="timeline-icon">
                  <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="timeline-content">
                  <h4>経済学の専門知識</h4>
                  <p>経済学を学び、経済評論家としてのキャリアをスタート</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-icon">
                  <i class="fas fa-book"></i>
                </div>
                <div class="timeline-content">
                  <h4>著書・監修多数</h4>
                  <p>投資・経済に関する著書を100冊以上出版し、実績を積む</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-icon">
                  <i class="fas fa-chart-line"></i>
                </div>
                <div class="timeline-content">
                  <h4>投資アドバイザーとして</h4>
                  <p>長年の経験を活かし、投資アドバイザーとして活動</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="timeline-icon">
                  <i class="fas fa-users"></i>
                </div>
                <div class="timeline-content">
                  <h4>コミュニティ運営</h4>
                  <p>投資コミュニティを運営し、多くの投資家をサポート</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section id="benefits" class="benefits">
      <div class="container">
        <div class="section-header">
          <h2>コミュニティ参加のメリット</h2>
          <p>初心者から上級者まで、みんなで学べる投資コミュニティです</p>
        </div>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-book-open"></i>
            </div>
            <h3>投資指南プレゼント</h3>
            <p>三橋貴明が制作した投資指南を無料でプレゼント。基礎から応用まで分かりやすく解説</p>
            <div class="benefit-highlight">
              <i class="fas fa-gift"></i>
              <span>参加特典</span>
            </div>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-users"></i>
            </div>
            <h3>定期勉強会</h3>
            <p>三橋貴明が不定期で開催する勉強会に参加可能。リアルタイムで質問もできます</p>
            <div class="benefit-highlight">
              <i class="fas fa-calendar"></i>
              <span>月2-3回開催</span>
            </div>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-newspaper"></i>
            </div>
            <h3>最新市況情報</h3>
            <p>株式市場の最新ニュースや注目銘柄の情報をコミュニティ内で共有</p>
            <div class="benefit-highlight">
              <i class="fas fa-clock"></i>
              <span>リアルタイム更新</span>
            </div>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-comments"></i>
            </div>
            <h3>質問・相談サポート</h3>
            <p>投資に関する疑問や悩みを気軽に相談。メンバー同士で情報交換も活発</p>
            <div class="benefit-highlight">
              <i class="fas fa-heart"></i>
              <span>24時間対応</span>
            </div>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-chart-pie"></i>
            </div>
            <h3>ポートフォリオ相談</h3>
            <p>あなたの投資ポートフォリオについて、三橋貴明や経験豊富なメンバーからアドバイス</p>
            <div class="benefit-highlight">
              <i class="fas fa-star"></i>
              <span>個別対応</span>
            </div>
          </div>
          <div class="benefit-card">
            <div class="benefit-icon">
              <i class="fas fa-graduation-cap"></i>
            </div>
            <h3>初心者向けサポート</h3>
            <p>投資未経験者でも安心。基礎から丁寧に学べる環境を提供</p>
            <div class="benefit-highlight">
              <i class="fas fa-seedling"></i>
              <span>初心者歓迎</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Investment Topics Section -->
    <section class="investment-topics">
      <div class="container">
        <div class="section-header">
          <h2>学べる投資テーマ</h2>
          <p>幅広い投資知識を体系的に学習</p>
        </div>
        <div class="topics-grid">
          <div class="topic-item">
            <div class="topic-left">
              <div class="topic-icon">
                <i class="fas fa-chart-line"></i>
              </div>
              <div class="topic-content">
                <h3>株式投資の基礎</h3>
                <p>銘柄選択から売買タイミングまで、株式投資の基本を分かりやすく解説</p>
                <ul>
                  <li>企業分析の方法</li>
                  <li>チャートの読み方</li>
                  <li>リスク管理</li>
                </ul>
              </div>
            </div>
            <div class="topic-right">
              <div class="topic-visual">
                <Image
                  src={img3}
                  alt=""
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px"
                />
              </div>
            </div>
          </div>

          <div class="topic-item reverse">
            <div class="topic-left">
              <div class="topic-visual">
                <Image
                  src={avatarImg}
                  alt=""
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px"
                />
              </div>
            </div>
            <div class="topic-right">
              <div class="topic-icon">
                <i class="fas fa-coins"></i>
              </div>
              <div class="topic-content">
                <h3>積立投資・NISA活用</h3>
                <p>つみたてNISAやiDeCoを活用した長期資産形成の戦略</p>
                <ul>
                  <li>積立投資のメリット</li>
                  <li>NISA制度の活用法</li>
                  <li>税制優遇の最大化</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="topic-item">
            <div class="topic-left">
              <div class="topic-icon">
                <i class="fas fa-balance-scale"></i>
              </div>
              <div class="topic-content">
                <h3>ポートフォリオ構築</h3>
                <p>リスクとリターンのバランスを考えた資産配分の方法</p>
                <ul>
                  <li>分散投資の重要性</li>
                  <li>アセットアロケーション</li>
                  <li>リバランシング</li>
                </ul>
              </div>
            </div>
            <div class="topic-right">
              <div class="topic-visual">
                <Image
                  src={img5}
                  alt=""
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 20px"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="testimonials">
      <div class="container">
        <div class="section-header">
          <h2>メンバーの声</h2>
          <p>実際にコミュニティに参加している方々の体験談</p>
        </div>

        <!-- Desktop Grid View -->
        <div class="testimonials-grid">
          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>田中さん (30代・会社員)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「投資初心者でしたが、三橋さんの分かりやすい説明とコミュニティの温かいサポートのおかげで、安心して投資を始めることができました。特に積立NISAの活用法が参考になりました。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-arrow-up"></i>
              <span>6ヶ月で+12%の運用成績</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>佐藤さん (40代・主婦)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「経済の基礎から投資まで、三橋さんの専門的なアドバイスがとても参考になります。初心者でも無理なく続けられる投資方法を教えてもらい、将来への不安が軽減されました。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-piggy-bank"></i>
              <span>月3万円の投資を継続中</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>山田さん (20代・学生)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「アルバイト代から少しずつ投資を始めました。同世代のメンバーとも情報交換ができて、モチベーションが続きます。三橋さんの専門知識に基づくアドバイスは本当に勉強になります。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-seedling"></i>
              <span>月1万円から投資スタート</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>鈴木さん (50代・自営業)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「退職後の資産運用について相談できる場所を探していました。年齢に関係なく参加でき、経験豊富なメンバーからも学べるのが魅力です。三橋さんのリスク管理の重要性を改めて学びました。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-shield-alt"></i>
              <span>リスク分散でポートフォリオ改善</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>高橋さん (60代・退職者)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「定年後の資産運用に不安がありましたが、三橋さんのアドバイスで安定した投資戦略を学べました。年金以外の収入源を作ることができ、老後の生活に安心感が生まれました。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-chart-line"></i>
              <span>年間配当収入50万円達成</span>
            </div>
          </div>

          <div class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <i class="fas fa-user"></i>
              </div>
              <div class="testimonial-info">
                <h4>中村さん (35代・フリーランス)</h4>
                <div class="rating">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                </div>
              </div>
            </div>
            <p>
              「フリーランスで収入が不安定でしたが、コミュニティで学んだ分散投資の考え方で、リスクを抑えながら資産を増やすことができています。同じような境遇の仲間との交流も励みになります。」
            </p>
            <div class="testimonial-result">
              <i class="fas fa-balance-scale"></i>
              <span>リスク分散投資で安定運用</span>
            </div>
          </div>
        </div>

        <!-- Mobile Slider View -->
        <div class="testimonials-slider">
          <div class="testimonials-track" id="testimonialsTrack">
            <div class="testimonial-card">
              <div class="testimonial-header">
                <div class="testimonial-avatar">
                  <i class="fas fa-user"></i>
                </div>
                <div class="testimonial-info">
                  <h4>田中さん (30代・会社員)</h4>
                  <div class="rating">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                  </div>
                </div>
              </div>
              <p>
                「投資初心者でしたが、三橋さんの分かりやすい説明とコミュニティの温かいサポートのおかげで、安心して投資を始めることができました。」
              </p>
              <div class="testimonial-result">
                <i class="fas fa-arrow-up"></i>
                <span>6ヶ月で+12%の運用成績</span>
              </div>
            </div>

            <div class="testimonial-card">
              <div class="testimonial-header">
                <div class="testimonial-avatar">
                  <i class="fas fa-user"></i>
                </div>
                <div class="testimonial-info">
                  <h4>佐藤さん (40代・主婦)</h4>
                  <div class="rating">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                  </div>
                </div>
              </div>
              <p>
                「家計管理から投資まで、女性目線でのアドバイスがとても参考になります。子育て中でも無理なく続けられる投資方法を学べました。」
              </p>
              <div class="testimonial-result">
                <i class="fas fa-piggy-bank"></i>
                <span>月3万円の投資を継続中</span>
              </div>
            </div>

            <div class="testimonial-card">
              <div class="testimonial-header">
                <div class="testimonial-avatar">
                  <i class="fas fa-user"></i>
