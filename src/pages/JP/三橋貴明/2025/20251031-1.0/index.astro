---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet" />

    <RedirectCode />
    <script type="module" src="/src/utils/jump.ts"></script>
    <script is:inline>
function onScroll() {
  const elm = document.querySelector('.floating_area')
  if (!elm)
    return
  const scroll = window.pageYOffset
  if (scroll > 500) {
    elm.style.opacity = '1'
    elm.style.zIndex = '999'
  }
  else {
    elm.style.opacity = '0'
    elm.style.zIndex = '-1'
  }
}
window.addEventListener('scroll', onScroll)
</script>
    <title>金融の本当のプロから学ぶ資産倍速セミナー</title>
  </head>

  <body>
    <div class="floating_area">
      <div class="frame">
        <div class="btn">
          <a href="javascript:void(0)" onclick="onLinkBtnClick()">
            <img src={btn1} alt="" />
          </a>
        </div>
      </div>
    </div>
    <div id="mv">
      <picture><source media="(max-width: 768px)" srcset={mv2s} />
        <img src={mv2s} alt="" />
      </picture>
    </div>
    <div class="mv_cta">
      <div class="btn">
        <a href="javascript:void(0)" onclick="onLinkBtnClick()">
          <img src={btn1} alt="" />
        </a>
      </div>
    </div>
    <div id="mf31" class="mf">
      <div class="frame">
        <h2><img src={mf31t1} alt="" loading="lazy" /></h2>
        <div class="fbox flex">
          <img src={mf31i1} alt="" loading="lazy" />
          <img src={mf31i2} alt="" loading="lazy" />
        </div>
      </div>
    </div>
    <div id="mf2" class="mf">
      <div class="frame">
        <h2><img src={mf1t1} alt="" loading="lazy" /></h2>
        <div class="cbox">
          <!-- <div class="ttl1 ac"><img src={mf1t2} alt="" loading="lazy" /></div>
          <div class="cboxs">
            <img src={mf1i1} alt="" loading="lazy" />
          </div> -->
          <!-- <p class="t_600 ac">急騰銘柄研究所に掲載されました</p> -->
          <div class="ttl2 ac"><img src={mf1t3} alt="" loading="lazy" /></div>
          <div class="cboxs">
            <img src={mf1i6jpg} alt="" loading="lazy" />
          </div>
          <p class="t_600 ac">国民の金融リテラシー向上を<br class="sp" />目的とした企業団体に参画</p>
        </div>
        <div class="fbox">
          <div class="fboxs">
            <img src={mf1i2} alt="" loading="lazy" />
          </div>
          <div class="fboxs">
            <img src={mf1i3} alt="" loading="lazy" />
          </div>
          <div class="fboxs">
            <img src={mf1i4} alt="" loading="lazy" />
          </div>
          <div class="fboxs">
            <img src={mf1i5} alt="" loading="lazy" />
          </div>
          <div class="fboxs">
            <img src={mf1i6} alt="" loading="lazy" />
          </div>
          <div class="fboxs">
            <img src={mf1i7} alt="" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
    <div id="mf32" class="mf">
      <div class="frame">
        <h2><img src={mf32t1} alt="" loading="lazy" /></h2>
        <div class="fbox">
          <img src={mf32i1} alt="" loading="lazy" />
          <img src={mf32i2} alt="" loading="lazy" />
          <img src={mf32i3} alt="" loading="lazy" />
          <img src={mf32i4} alt="" loading="lazy" />
          <img src={mf32i5} alt="" loading="lazy" />
        </div>
      </div>
    </div>
    <div id="mf33" class="mf">
      <div class="arr"><img src={mf33i3} alt="" loading="lazy" /></div>
      <div class="frame">
        <h2><img src={mf33t1} alt="" loading="lazy" /></h2>
        <div class="cbox">
          <h3 class="t_white"><img src={mf33i1} alt="" loading="lazy" />長期で見て成績が良いから</h3>
          <p>
            S&P500は、過去30年以上にわたって年平均7〜10％の成長を続けてきました。また、全世界株式（通称：オルカン）は、世界経済全体の成長をまるごと取り込める投資先として注目されており、安定したリターンが期待できるため。
          </p>
        </div>
        <div class="cbox">
          <h3 class="t_white">
            <img src={mf33i2} alt="" loading="lazy" />分散投資ができ、手間がかからないから
          </h3>
          <p>
            1つの企業に賭けるより、数百・数千の企業に分散する方が安全であるため。またS&P500はアメリカ企業500社、オルカンは世界中の約3,000社以上が対象のため分散投資ができ手間がかからないため・・・
          </p>
        </div>
      </div>
    </div>
    <div id="mf34" class="mf">
      <div class="arr"><img src={mf34i1} alt="" loading="lazy" /></div>
      <div class="frame">
        <div class="tbox1 t_white t_800">
          <p>
            S&P500やオルカンは多数の企業を<br />広く分散して保有しているため<br /><span class="t_yellow">資産が増えるのに<br class="sp" />時間がかかってしまう・・・</span
