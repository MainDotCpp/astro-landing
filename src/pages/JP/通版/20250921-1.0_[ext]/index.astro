---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = (() => {
  return [
   { params: { ext: '普通' } },
   { params: { ext: '弹窗' } },
   { params: { ext: '跳转' } },
  ]
}) satisfies GetStaticPaths

const { ext } = Astro.params || {}
---

<BaseLayout title="AI株式診断 - 無料でプロ分析を入手" description="銘柄コードを入力すると、AIが株価を分析し、投資レポートを無料提供">
  <main class="min-h-screen bg-gradient-to-br from-blue-900 via-purple-900 to-indigo-900">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-transparent to-purple-500/10"></div>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 container mx-auto px-4 py-8">
      <div class="max-w-md mx-auto">

        <!-- Header -->
        <div class="text-center mb-8">
          <div class="relative inline-block mb-6">
            <div class="w-20 h-20 bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full flex items-center justify-center shadow-2xl">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <div class="absolute -inset-1 bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full blur opacity-30 animate-pulse"></div>
          </div>

          <h1 class="text-3xl font-bold text-white mb-3">
            AI株式診断
          </h1>
          <p class="text-gray-300 text-lg">
            銘柄コードを入力して、AI分析レポートを受け取ろう
          </p>
        </div>

        <!-- Input Form -->
        <div id="inputFormCard" class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 mb-8 border border-white/20">
          <form id="stockForm" class="space-y-4">
            <div>
              <label for="stockCode" class="block text-sm font-medium text-gray-200 mb-2">
                銘柄コードを入力してください
              </label>
              <div class="relative">
                <input
                  type="text"
                  id="stockCode"
                  name="stockCode"
                  placeholder="例: 7203, AAPL"
                  class="w-full px-4 py-3 bg-white/20 border border-white/30 rounded-xl focus:border-cyan-400 focus:outline-none transition-all duration-300 text-center text-lg font-mono text-white placeholder-gray-400 focus:bg-white/30"
                  maxlength="10"
                  required
                />
                <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                  <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
              </div>
              <p class="text-xs text-gray-400 mt-1">
                日本株・米国株など主要市場に対応
              </p>
            </div>

            <button
              type="submit"
              id="analyzeBtn"
              class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white py-3 px-6 rounded-xl font-semibold text-lg transition-all duration-300 hover:from-cyan-400 hover:to-blue-500 hover:shadow-lg hover:shadow-cyan-500/25 transform hover:scale-105 active:scale-95"
            >
              AI分析を開始
            </button>
          </form>
        </div>

        <!-- Features -->
        <div id="featuresSection" class="space-y-3 mb-8">
          <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-lg rounded-xl p-4 border border-white/20">
            <div class="w-8 h-8 bg-green-500 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-gray-200 font-medium">リアルタイム分析</span>
          </div>
          <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-lg rounded-xl p-4 border border-white/20">
            <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <span class="text-gray-200 font-medium">プロの投資アドバイス</span>
          </div>
          <div class="flex items-center space-x-3 bg-white/10 backdrop-blur-lg rounded-xl p-4 border border-white/20">
            <div class="w-8 h-8 bg-purple-500 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="text-gray-200 font-medium">24時間迅速対応</span>
          </div>
        </div>
      </div>

      <!-- Analysis Progress Section -->
      <div id="analysisSection" class="hidden max-w-md mx-auto">
        <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20">
          <div class="text-center mb-6">
            <div class="w-16 h-16 mx-auto bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full flex items-center justify-center mb-4 animate-pulse">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-white mb-2">AIが分析中...</h2>
            <p class="text-gray-300 text-sm">少々お待ちください。専門的な分析レポートを生成しています</p>
          </div>

          <!-- Progress Steps -->
          <div class="space-y-4">
            <div class="flex items-center space-x-3">
              <div id="step1" class="w-6 h-6 bg-gray-600 rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span id="step1Text" class="text-sm text-gray-300">株式データを取得中...</span>
            </div>
            <div class="flex items-center space-x-3">
              <div id="step2" class="w-6 h-6 bg-gray-600 rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span id="step2Text" class="text-sm text-gray-300">テクニカル指標を分析中...</span>
            </div>
            <div class="flex items-center space-x-3">
              <div id="step3" class="w-6 h-6 bg-gray-600 rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span id="step3Text" class="text-sm text-gray-300">市場トレンドを評価中...</span>
            </div>
            <div class="flex items-center space-x-3">
              <div id="step4" class="w-6 h-6 bg-gray-600 rounded-full flex items-center justify-center">
                <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <span id="step4Text" class="text-sm text-gray-300">投資提案を作成中...</span>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="mt-6">
            <div class="w-full bg-gray-600 rounded-full h-2">
              <div id="progressBar" class="bg-gradient-to-r from-cyan-400 to-blue-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
            <p class="text-center text-xs text-gray-400 mt-2">
              <span id="progressText">0%</span> 完了
            </p>
          </div>
        </div>
      </div>

      <!-- Results Section -->
      <div id="resultsSection" class="hidden max-w-md mx-auto">
        <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 text-center border border-white/20">
          <div class="w-16 h-16 mx-auto bg-green-500 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2">分析が完了しました！</h2>
              <p class="text-gray-300 text-sm mb-6">
            AIの分析レポートが生成されました。下のボタンからLINEで友だち追加し、チャットで「レポート受取」と送信してください。
          </p>
          <button
            id="getResultsBtn"
            class="w-full bg-gradient-to-r from-green-500 to-blue-600 text-white py-3 px-6 rounded-xl font-semibold text-lg transition-all duration-300 hover:from-green-400 hover:to-blue-500 hover:shadow-lg transform hover:scale-105 active:scale-95"
          >
            LINE友だち追加して受け取る
          </button>
        </div>
      </div>
    </div>

    <!-- Modal -->
    <div id="lineModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 opacity-0 invisible transition-all duration-300">
      <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 transform scale-95 transition-all duration-300">
        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-green-500 to-blue-600 px-6 py-4 rounded-t-2xl">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-white font-semibold text-lg">AI投資アドバイザー</h3>
                <p class="text-white/90 text-sm">オンライン</p>
              </div>
            </div>
            <button id="closeModal" class="text-white/80 hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Modal Content -->
        <div class="p-6">
          <div class="bg-gray-50 rounded-xl p-4 mb-6">
            <p class="text-gray-800 text-sm leading-relaxed">
              こんにちは。AI投資アドバイザーです 🤖<br><br>
              分析レポートの準備ができました。<br><br>
              次のステップ：下のボタンからLINEで友だち追加し、チャットで「レポート受取」と送信してください。完全版のレポートと今後の通知をお届けします。<br><br>
              📊 テクニカル分析：強い買いシグナル<br>
              📈 トレンド予測：今後30日で+15〜25%を想定<br>
              💰 投資提案：適切な買付と損切り設定を推奨
            </p>
          </div>

          <!-- Modal Buttons -->
          <div class="space-y-3">
            <button
              id="getReportBtn"
              class="w-full bg-gradient-to-r from-green-500 to-blue-600 text-white py-3 px-6 rounded-xl font-semibold text-lg transition-all duration-300 hover:from-green-600 hover:to-blue-700 hover:shadow-lg transform hover:scale-105 active:scale-95 animate-breathing"
            >
              LINE友だち追加してレポートを受け取る
            </button>
            <button
              id="dismissModal"
              class="w-full bg-gray-100 text-gray-600 py-3 px-6 rounded-xl font-medium transition-all duration-300 hover:bg-gray-200 transform hover:scale-105 active:scale-95"
            >
              あとで見る
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ ext }}>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('stockForm')
  const analyzeBtn = document.getElementById('analyzeBtn')
  const analysisSection = document.getElementById('analysisSection')
  const resultsSection = document.getElementById('resultsSection')
  const getResultsBtn = document.getElementById('getResultsBtn')
  const stockCodeInput = document.getElementById('stockCode')

  if (!form || !analyzeBtn || !analysisSection || !resultsSection || !getResultsBtn || !stockCodeInput) {
    console.error('Required elements not found')
    return
  }

  // Form submission
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const stockCode = stockCodeInput.value.trim()

    if (!stockCode) {
      // eslint-disable-next-line no-alert
      alert('銘柄コードを入力してください')
      return
    }

    // Block Hong Kong stocks (e.g., 0001.HK)
    if (/\.HK$/i.test(stockCode)) {
      // eslint-disable-next-line no-alert
      alert('香港株はサポート対象外です')
      return
    }

    startAnalysis(stockCode)
  })

  // Get results button
  getResultsBtn.addEventListener('click', () => {
    if (ext === '跳转') {
      if (typeof onLinkBtnClick === 'function')
        onLinkBtnClick()
    }
    else {
      showLineModal()
    }
  })

  // Modal functions
  function showLineModal() {
    const modal = document.getElementById('lineModal')
    const modalContent = modal?.querySelector('.bg-white')

    if (modal && modalContent) {
      modal.classList.remove('opacity-0', 'invisible')
      modal.classList.add('opacity-100', 'visible')
      modalContent.classList.remove('scale-95')
      modalContent.classList.add('scale-100')
    }
  }

  function hideLineModal() {
    const modal = document.getElementById('lineModal')
    const modalContent = modal?.querySelector('.bg-white')

    if (modal && modalContent) {
      modalContent.classList.remove('scale-100')
      modalContent.classList.add('scale-95')

      setTimeout(() => {
        modal.classList.remove('opacity-100', 'visible')
        modal.classList.add('opacity-0', 'invisible')
      }, 200)
    }
  }

  // Modal event listeners
  const closeModalBtn = document.getElementById('closeModal')
  const dismissModalBtn = document.getElementById('dismissModal')
  const getReportBtn = document.getElementById('getReportBtn')

  closeModalBtn?.addEventListener('click', hideLineModal)
  dismissModalBtn?.addEventListener('click', hideLineModal)

  getReportBtn?.addEventListener('click', () => {
    if (typeof onLinkBtnClick === 'function')
      onLinkBtnClick()
    hideLineModal()
  })

  // Close modal when clicking outside
  const modal = document.getElementById('lineModal')
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      hideLineModal()
    }
  })

  function startAnalysis(_stockCode) {
    // Hide form, show analysis
    form.style.display = 'none'
    const inputFormCard = document.getElementById('inputFormCard')
    const featuresSection = document.getElementById('featuresSection')
    if (inputFormCard)
      inputFormCard.style.display = 'none'
    if (featuresSection)
      featuresSection.style.display = 'none'
    analysisSection.classList.remove('hidden')

    // Disable button
    analyzeBtn.disabled = true
    analyzeBtn.textContent = '分析中...'

    // Simulate analysis steps
    simulateAnalysisSteps()
  }

  function simulateAnalysisSteps() {
    const steps = [
      { id: 'step1', text: '正在获取股票数据...', delay: 1000 },
      { id: 'step2', text: '分析技术指标...', delay: 2000 },
      { id: 'step3', text: '评估市场趋势...', delay: 2000 },
      { id: 'step4', text: '生成投资建议...', delay: 1500 },
    ]

    let currentStep = 0
    let progress = 0

    function executeStep() {
      if (currentStep < steps.length) {
        const step = steps[currentStep]

        // Update step UI
        const stepElement = document.getElementById(step.id)
        const stepText = document.getElementById(`${step.id}Text`)

        if (stepElement && stepText) {
          stepElement.classList.remove('bg-gray-600')
          stepElement.classList.add('bg-green-500')
          stepText.classList.remove('text-gray-300')
          stepText.classList.add('text-green-300')
        }

        // Update progress
        progress += 25
        updateProgress(progress)

        currentStep++

        if (currentStep < steps.length) {
          setTimeout(executeStep, step.delay)
        }
        else {
          // Analysis complete
          setTimeout(() => {
            analysisSection.classList.add('hidden')
            resultsSection.classList.remove('hidden')
          }, 1000)
        }
      }
    }

    // Start first step
    setTimeout(executeStep, 500)
  }

  function updateProgress(percentage) {
    const progressBar = document.getElementById('progressBar')
    const progressText = document.getElementById('progressText')

    if (progressBar) {
      progressBar.style.width = `${percentage}%`
    }

    if (progressText) {
      progressText.textContent = `${percentage}%`
    }
  }

  // Input validation
  stockCodeInput.addEventListener('input', (e) => {
    const target = e.target
    if (target) {
      // Remove non-alphanumeric characters except dots and dashes
      target.value = target.value.replace(/[^a-z0-9.-]/gi, '').toUpperCase()
    }
  })
})
</script>

  <style>
    /* Custom animations */
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    /* Mobile optimizations */
    @media (max-width: 375px) {
      .max-w-md {
        max-width: 100%;
        margin: 0 1rem;
      }

      .px-4 {
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }

    /* Touch optimizations */
    button, input {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    /* Smooth transitions */
    * {
      transition: all 0.3s ease;
    }
  </style>
</BaseLayout>
