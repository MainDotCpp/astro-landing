---
import LineButton from '@/components/button/LineButton.tsx'
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI株式診断 - 無料でプロ分析を入手"
  description="最新のAI技術で株式を分析。銘柄コードを入力するだけで、専門的な投資レポートを無料で受け取れます。"
  lang="ja"
  plugins={{
    aos: {},
  }}
>
  <!-- Google Fonts for Japanese -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&family=M+PLUS+1p:wght@400;500;700;800;900&family=M+PLUS+Code+Latin:wght@400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --font-primary: 'Noto Sans JP', 'M PLUS 1p', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-numbers: 'M PLUS Code Latin', 'Inter', 'Noto Sans JP', monospace;
      --font-display: 'Orbitron', 'Rajdhani', 'Noto Sans JP', sans-serif;
      --font-tech: 'M PLUS Code Latin', 'Inter', monospace;

      --color-primary: #06C755;
      --color-primary-dark: #05b44d;
      --color-gradient-start: #0a0e27;
      --color-gradient-mid: #1a1a2e;
      --color-gradient-end: #16213e;
      --color-accent: #00d4ff;
      --color-accent-glow: #00d4ff;
      --color-neon-cyan: #00ffff;
      --color-neon-green: #00ff88;
      --color-text: #2c3e50;
      --color-text-light: #6c757d;
      --color-bg: #0a0e27;
    }

    body {
      font-family: var(--font-primary);
      line-height: 1.7;
      color: var(--color-text);
      background: var(--color-bg);
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      position: relative;
      overflow-x: hidden;
    }

    /* 科技感网格背景 */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image:
        linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 212, 255, 0.1) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: 0;
      pointer-events: none;
      animation: gridMove 20s linear infinite;
    }

    @keyframes gridMove {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(50px, 50px);
      }
    }

    /* 粒子动画背景 */
    .particles-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 2px;
      height: 2px;
      background: var(--color-accent);
      border-radius: 50%;
      opacity: 0.6;
      animation: float 15s infinite ease-in-out;
    }

    @keyframes float {
      0%, 100% {
        transform: translate(0, 0) scale(1);
        opacity: 0;
      }
      50% {
        transform: translate(100px, -100px) scale(1.5);
        opacity: 0.8;
      }
    }


    /* Hero Section */
    .hero {
      padding: 80px 0 60px;
      background: linear-gradient(135deg, var(--color-gradient-start) 0%, var(--color-gradient-mid) 50%, var(--color-gradient-end) 100%);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 20% 30%, rgba(0, 212, 255, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(6, 199, 85, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(0, 255, 255, 0.05) 0%, transparent 70%);
      z-index: 1;
      animation: pulseGlow 4s ease-in-out infinite;
    }

    .hero::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background:
        conic-gradient(from 0deg, transparent 0deg, rgba(0, 212, 255, 0.1) 90deg, transparent 180deg),
        conic-gradient(from 180deg, transparent 0deg, rgba(6, 199, 85, 0.1) 90deg, transparent 180deg);
      z-index: 1;
      animation: rotate 20s linear infinite;
    }

    @keyframes pulseGlow {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.8;
      }
    }

    @keyframes rotate {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .hero-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
      position: relative;
      z-index: 10;
      text-align: center;
    }

    .diagnosis-form-container,
    .analysis-progress,
    .diagnosis-results {
      position: relative;
      z-index: 10;
    }

    .hero-badge {
      display: inline-block;
      padding: 8px 20px;
      background: rgba(0, 212, 255, 0.15);
      border: 1px solid rgba(0, 212, 255, 0.5);
      border-radius: 50px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
      position: relative;
      box-shadow:
        0 0 10px rgba(0, 212, 255, 0.3),
        inset 0 0 10px rgba(0, 212, 255, 0.1);
      animation: badgeGlow 2s ease-in-out infinite;
      font-family: var(--font-tech);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    @keyframes badgeGlow {
      0%, 100% {
        box-shadow:
          0 0 10px rgba(0, 212, 255, 0.3),
          inset 0 0 10px rgba(0, 212, 255, 0.1);
      }
      50% {
        box-shadow:
          0 0 20px rgba(0, 212, 255, 0.6),
          inset 0 0 15px rgba(0, 212, 255, 0.2);
      }
    }

    .hero h1 {
      font-size: 48px;
      font-weight: 800;
      margin-bottom: 24px;
      line-height: 1.2;
      background: linear-gradient(135deg, #ffffff 0%, #00d4ff 50%, #06c755 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      animation: textShine 3s ease-in-out infinite;
      filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.5));
      font-family: var(--font-display);
      letter-spacing: 0.05em;
    }

    .hero h1::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      animation: shimmer 2s infinite;
    }

    @keyframes textShine {
      0%, 100% {
        filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.5));
      }
      50% {
        filter: drop-shadow(0 0 30px rgba(0, 212, 255, 0.8));
      }
    }

    @keyframes shimmer {
      0% {
        transform: translateX(-100%);
      }
      100% {
        transform: translateX(100%);
      }
    }

    .hero-subtitle {
      font-size: 22px;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 40px;
      font-weight: 400;
    }

    .hero-features {
      display: flex;
      justify-content: center;
      gap: 32px;
      flex-wrap: wrap;
      margin-top: 48px;
    }

    .hero-feature {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 24px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(0, 212, 255, 0.3);
      position: relative;
      transition: all 0.3s ease;
      overflow: hidden;
    }

    .hero-feature::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.2), transparent);
      transition: left 0.5s ease;
    }

    .hero-feature:hover {
      border-color: rgba(0, 212, 255, 0.6);
      box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
      transform: translateY(-2px);
    }

    .hero-feature:hover::before {
      left: 100%;
    }

    .hero-feature-icon {
      width: 24px;
      height: 24px;
      color: var(--color-accent);
    }

    /* Diagnosis Form */
    .diagnosis-form-container {
      max-width: 600px;
      margin: 48px auto 0;
      padding: 40px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border-radius: 24px;
      border: 1px solid rgba(0, 212, 255, 0.3);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.3),
        0 0 0 1px rgba(0, 212, 255, 0.1),
        inset 0 0 30px rgba(0, 212, 255, 0.05);
      position: relative;
      overflow: hidden;
    }

    .diagnosis-form-container::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background:
        radial-gradient(circle, rgba(0, 212, 255, 0.1) 0%, transparent 70%);
      animation: formGlow 4s ease-in-out infinite;
    }

    .diagnosis-form-container::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border-radius: 24px;
      padding: 1px;
      background: linear-gradient(135deg, rgba(0, 212, 255, 0.5), rgba(6, 199, 85, 0.5));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      animation: borderRotate 3s linear infinite;
    }

    @keyframes formGlow {
      0%, 100% {
        opacity: 0.5;
        transform: scale(1);
      }
      50% {
        opacity: 0.8;
        transform: scale(1.1);
      }
    }

    @keyframes borderRotate {
      0% {
        background-position: 0% 0%;
      }
      100% {
        background-position: 100% 100%;
      }
    }

    .diagnosis-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-label {
      font-size: 16px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
    }

    .form-input-wrapper {
      position: relative;
    }

    .form-input {
      width: 100%;
      padding: 16px 20px;
      background: rgba(0, 0, 0, 0.3);
      border: 2px solid rgba(0, 212, 255, 0.4);
      border-radius: 12px;
      color: white;
      font-size: 18px;
      font-family: var(--font-tech);
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      z-index: 2;
      letter-spacing: 0.05em;
    }

    .form-input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .form-input::placeholder {
      color: rgba(255, 255, 255, 0.6);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--color-accent);
      background: rgba(0, 0, 0, 0.5);
      box-shadow:
        0 0 0 4px rgba(0, 212, 255, 0.2),
        0 0 20px rgba(0, 212, 255, 0.4),
        inset 0 0 10px rgba(0, 212, 255, 0.1);
    }

    .form-hint {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.7);
      text-align: center;
    }

    .analyze-btn {
      width: 100%;
      padding: 18px 32px;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      border: none;
      border-radius: 12px;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow:
        0 4px 20px rgba(6, 199, 85, 0.4),
        0 0 30px rgba(0, 212, 255, 0.3);
      position: relative;
      z-index: 2;
      overflow: hidden;
      font-family: var(--font-display);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .analyze-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .analyze-btn:hover::before {
      left: 100%;
    }

    .analyze-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow:
        0 8px 30px rgba(6, 199, 85, 0.6),
        0 0 40px rgba(0, 212, 255, 0.5);
    }

    .analyze-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    /* Analysis Progress Section */
    .analysis-progress {
      display: none;
      max-width: 600px;
      margin: 48px auto 0;
      padding: 40px;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .analysis-progress.active {
      display: block;
    }

    .progress-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .progress-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: pulse 2s ease-in-out infinite;
      position: relative;
      box-shadow:
        0 0 20px rgba(0, 212, 255, 0.5),
        inset 0 0 20px rgba(255, 255, 255, 0.1);
    }

    .progress-icon::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      border-radius: 50%;
      background: linear-gradient(45deg, var(--color-primary), var(--color-accent), var(--color-primary));
      z-index: -1;
      animation: rotate 3s linear infinite;
    }

    .progress-icon svg {
      width: 40px;
      height: 40px;
      color: white;
    }

    .progress-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
      font-family: var(--font-display);
      letter-spacing: 0.05em;
    }

    .progress-subtitle {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.8);
    }

    .progress-steps {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 32px;
    }

    .progress-step {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .progress-step.completed {
      background: rgba(6, 199, 85, 0.2);
    }

    .step-indicator {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .progress-step.completed .step-indicator {
      background: var(--color-primary);
    }

    .step-indicator svg {
      width: 18px;
      height: 18px;
      color: white;
      display: none;
    }

    .progress-step.completed .step-indicator svg {
      display: block;
    }

    .step-text {
      flex: 1;
      font-size: 16px;
      color: rgba(255, 255, 255, 0.8);
      transition: all 0.3s ease;
    }

    .progress-step.completed .step-text {
      color: rgba(255, 255, 255, 0.95);
      font-weight: 600;
    }

    .progress-bar-container {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 12px;
    }

    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent) 100%);
      border-radius: 4px;
      transition: width 0.5s ease;
      width: 0%;
    }

    .progress-percentage {
      text-align: center;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.8);
      font-family: var(--font-tech);
      letter-spacing: 0.05em;
    }

    /* Results Section */
    .diagnosis-results {
      display: none;
      max-width: 800px;
      margin: 48px auto 0;
      padding: 40px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border-radius: 24px;
      border: 1px solid rgba(0, 212, 255, 0.3);
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.3),
        0 0 0 1px rgba(0, 212, 255, 0.1),
        inset 0 0 30px rgba(0, 212, 255, 0.05);
      position: relative;
      overflow: hidden;
    }

    .diagnosis-results::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at top left, rgba(0, 212, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at bottom right, rgba(6, 199, 85, 0.1) 0%, transparent 50%);
      z-index: 0;
      animation: resultGlow 4s ease-in-out infinite;
    }

    @keyframes resultGlow {
      0%, 100% {
        opacity: 0.5;
      }
      50% {
        opacity: 0.8;
      }
    }

    .diagnosis-results.active {
      display: block;
    }

    .results-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .results-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow:
        0 0 20px rgba(6, 199, 85, 0.5),
        inset 0 0 20px rgba(255, 255, 255, 0.1);
      animation: resultIconPulse 2s ease-in-out infinite;
    }

    .results-icon::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      border-radius: 50%;
      background: linear-gradient(45deg, var(--color-primary), var(--color-accent), var(--color-primary));
      z-index: -1;
      animation: rotate 3s linear infinite;
    }

    @keyframes resultIconPulse {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.1);
      }
    }

    .results-icon svg {
      width: 40px;
      height: 40px;
      color: white;
    }

    .results-title {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 8px;
      font-family: var(--font-display);
      letter-spacing: 0.05em;
    }

    .results-subtitle {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.8);
    }

    .results-content {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 32px;
      position: relative;
      z-index: 1;
    }

    .result-item {
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
      padding: 16px;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 12px;
      border-left: 3px solid var(--color-accent);
      transition: all 0.3s ease;
    }

    .result-item:hover {
      background: rgba(0, 0, 0, 0.3);
      border-left-color: var(--color-primary);
      transform: translateX(4px);
    }

    .result-item:last-child {
      margin-bottom: 0;
    }

    .result-label {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 8px;
      font-weight: 600;
      font-family: var(--font-tech);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .result-value {
      font-size: 20px;
      font-weight: 700;
      color: white;
      font-family: var(--font-tech);
      letter-spacing: 0.05em;
    }

    .result-value.positive {
      color: #4ade80;
    }

    .result-value.negative {
      color: #f87171;
    }

    .result-description {
      display: none; /* 隐藏详细描述，引导用户添加LINE好友 */
    }

    .results-cta {
      text-align: center;
      margin-top: 32px;
      padding: 32px;
      background: rgba(6, 199, 85, 0.15);
      border-radius: 16px;
      border: 2px solid rgba(6, 199, 85, 0.5);
      position: relative;
      z-index: 1;
      box-shadow:
        0 0 20px rgba(6, 199, 85, 0.3),
        inset 0 0 20px rgba(6, 199, 85, 0.1);
      animation: ctaPulse 3s ease-in-out infinite;
    }

    /* 结果区域CTA按钮文字大小调整 */
    .results-cta button {
      font-size: 18px !important;
    }

    .results-cta button img {
      width: 24px !important;
      height: 24px !important;
    }

    @media (min-width: 768px) {
      .results-cta button {
        font-size: 20px !important;
      }

      .results-cta button img {
        width: 28px !important;
        height: 28px !important;
      }
    }

    @keyframes ctaPulse {
      0%, 100% {
        box-shadow:
          0 0 20px rgba(6, 199, 85, 0.3),
          inset 0 0 20px rgba(6, 199, 85, 0.1);
      }
      50% {
        box-shadow:
          0 0 30px rgba(6, 199, 85, 0.5),
          inset 0 0 30px rgba(6, 199, 85, 0.2);
      }
    }

    .results-cta-text {
      font-size: 18px;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 24px;
      line-height: 1.8;
      font-weight: 600;
    }

    .results-cta-highlight {
      display: block;
      font-size: 20px;
      color: #ffd700;
