  <script>
// 生成粒子效果
function createParticles() {
  const particlesBg = document.getElementById('particlesBg')
  if (!particlesBg)
    return

  const particleCount = 50
  for (let i = 0; i < particleCount; i++) {
    const particle = document.createElement('div')
    particle.className = 'particle'
    particle.style.left = `${Math.random() * 100}%`
    particle.style.top = `${Math.random() * 100}%`
    particle.style.animationDelay = `${Math.random() * 15}s`
    particle.style.animationDuration = `${10 + Math.random() * 10}s`
    particlesBg.appendChild(particle)
  }
}

document.addEventListener('DOMContentLoaded', () => {
  // 初始化粒子效果
  createParticles()
  const form = document.getElementById('diagnosisForm') as HTMLFormElement | null
  const analyzeBtn = document.getElementById('analyzeBtn') as HTMLButtonElement | null
  const stockCodeInput = document.getElementById('stockCode') as HTMLInputElement | null
  const diagnosisFormContainer = document.getElementById('diagnosisFormContainer') as HTMLElement | null
  const analysisProgress = document.getElementById('analysisProgress') as HTMLElement | null
  const diagnosisResults = document.getElementById('diagnosisResults') as HTMLElement | null
  const analyzedStockCode = document.getElementById('analyzedStockCode') as HTMLElement | null

  if (!form || !analyzeBtn || !stockCodeInput || !diagnosisFormContainer || !analysisProgress || !diagnosisResults) {
    return
  }

  // 表单提交处理
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const stockCode = stockCodeInput.value.trim().toUpperCase()

    if (!stockCode) {
      // eslint-disable-next-line no-alert
      alert('銘柄コードを入力してください')
      return
    }

    // 阻止香港股票
    if (/\.HK$/i.test(stockCode)) {
      // eslint-disable-next-line no-alert
      alert('香港株はサポート対象外です')
      return
    }

    startAnalysis(stockCode)
  })

  // 开始分析
  function startAnalysis(code: string) {
    if (!diagnosisFormContainer || !analysisProgress || !diagnosisResults || !analyzeBtn) {
      return
    }
    // 隐藏表单，显示进度
    diagnosisFormContainer.style.display = 'none'
    analysisProgress.classList.add('active')
    diagnosisResults.classList.remove('active')

    // 禁用按钮
    analyzeBtn.disabled = true
    analyzeBtn.textContent = '分析中...'

    // 滚动到进度区域
    analysisProgress.scrollIntoView({ behavior: 'smooth', block: 'center' })

    // 模拟分析步骤
    simulateAnalysisSteps(code)
  }

  // 模拟分析步骤
  function simulateAnalysisSteps(_stockCode: string) {
    const steps = [
      { id: 'step1', text: '株式データを取得中...', delay: 1000 },
      { id: 'step2', text: 'テクニカル指標を分析中...', delay: 2000 },
      { id: 'step3', text: '市場トレンドを評価中...', delay: 2000 },
      { id: 'step4', text: '投資提案を作成中...', delay: 1500 },
    ]

    let currentStep = 0
    let progress = 0

    function executeStep() {
      if (currentStep < steps.length) {
        const step = steps[currentStep]
        const stepElement = document.getElementById(step.id)

        if (stepElement) {
          stepElement.classList.add('completed')
        }

        // 更新进度
        progress += 25
        updateProgress(progress)

        currentStep++

        if (currentStep < steps.length) {
          setTimeout(executeStep, step.delay)
        }
        else {
          // 分析完成
          setTimeout(() => {
            showResults(_stockCode)
          }, 1000)
        }
      }
    }

    // 开始第一步
    setTimeout(executeStep, 500)
  }

  // 更新进度条
  function updateProgress(percentage: number) {
    const progressBar = document.getElementById('progressBar') as HTMLElement | null
    const progressText = document.getElementById('progressText') as HTMLElement | null

    if (progressBar) {
      progressBar.style.width = `${percentage}%`
    }

    if (progressText) {
      progressText.textContent = `${percentage}%`
    }
  }

  // 显示结果
  function showResults(stockCode: string) {
    if (!analysisProgress || !diagnosisResults || !analyzeBtn) {
      return
    }
    analysisProgress.classList.remove('active')
    diagnosisResults.classList.add('active')

    // 设置分析的股票代码
    if (analyzedStockCode) {
      analyzedStockCode.textContent = stockCode
    }

    // 生成随机但合理的诊断结果
    generateRandomResults()

    // 滚动到结果区域
    diagnosisResults.scrollIntoView({ behavior: 'smooth', block: 'center' })

    // 重置按钮状态
    analyzeBtn.disabled = false
    analyzeBtn.textContent = 'AI分析を開始'
  }

  // 生成随机诊断结果
  function generateRandomResults() {
    // 随机生成推荐度（70%概率为买入推荐）
    const recommendations = ['買い推奨', '強力買い推奨', '買い推奨', '様子見', '買い推奨']
    const recommendation = recommendations[Math.floor(Math.random() * recommendations.length)]
    const isPositive = recommendation.includes('買い')

    // 随机生成价格预测
    const priceForecasts = ['+15% 〜 +25%', '+10% 〜 +20%', '+20% 〜 +30%', '+5% 〜 +15%', '-5% 〜 +5%']
    const priceForecast = isPositive
      ? priceForecasts[Math.floor(Math.random() * 4)]
      : priceForecasts[4]

    // 随机生成风险级别
    const riskLevels = ['低', '中程度', '中程度', 'やや高', '中程度']
    const riskLevel = riskLevels[Math.floor(Math.random() * riskLevels.length)]

    // 随机生成置信度（80-95%）
    const confidenceScore = Math.floor(Math.random() * 16) + 80

    // 更新UI
    const recommendationEl = document.getElementById('recommendation')
    const priceForecastEl = document.getElementById('priceForecast')
    const riskLevelEl = document.getElementById('riskLevel')
    const confidenceScoreEl = document.getElementById('confidenceScore')

    if (recommendationEl) {
      recommendationEl.textContent = recommendation
      recommendationEl.className = `result-value ${isPositive ? 'positive' : ''}`
    }

    if (priceForecastEl) {
      priceForecastEl.textContent = priceForecast
      priceForecastEl.className = `result-value ${priceForecast.startsWith('+') ? 'positive' : ''}`
    }

    if (riskLevelEl) {
      riskLevelEl.textContent = riskLevel
    }

    if (confidenceScoreEl) {
      confidenceScoreEl.textContent = `${confidenceScore}%`
    }
    // 详细描述已隐藏，引导用户添加LINE好友查看详细报告
  }

  // 输入验证 - 只允许字母数字和点号
  stockCodeInput.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement
    if (target) {
      target.value = target.value.replace(/[^a-z0-9.-]/gi, '').toUpperCase()
    }
  })

  // 重置功能 - 允许用户重新分析
  const resetBtn = document.createElement('button')
  resetBtn.textContent = '別の銘柄を診断する'
  resetBtn.style.cssText = `
        display: block;
        margin: 20px auto 0;
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        color: white;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
      `
  resetBtn.addEventListener('mouseenter', () => {
    resetBtn.style.background = 'rgba(255, 255, 255, 0.2)'
  })
  resetBtn.addEventListener('mouseleave', () => {
    resetBtn.style.background = 'rgba(255, 255, 255, 0.1)'
  })
  resetBtn.addEventListener('click', () => {
    // 重置所有状态
    diagnosisFormContainer.style.display = 'block'
    analysisProgress.classList.remove('active')
    diagnosisResults.classList.remove('active')
    stockCodeInput.value = ''

    // 重置进度步骤
    for (let i = 1; i <= 4; i++) {
      const step = document.getElementById(`step${i}`)
      if (step) {
        step.classList.remove('completed')
      }
    }

    // 重置进度条
    updateProgress(0)

    // 滚动到表单
    diagnosisFormContainer.scrollIntoView({ behavior: 'smooth', block: 'center' })
  })

  // 将重置按钮添加到结果区域
  const resultsCta = diagnosisResults.querySelector('.results-cta')
  if (resultsCta) {
    resultsCta.appendChild(resetBtn)
  }
})
</script>
</BaseLayout>
