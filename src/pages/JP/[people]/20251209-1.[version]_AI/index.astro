            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="section target-section alt-bg">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-user-check"></i> プロフィール</span>
