    <!-- Scripts -->
    <script>
document.addEventListener('DOMContentLoaded', () => {
  // 初始化所有功能
  initScrollAnimations()
  initSmoothScroll()
  initStatsCounter()
  initAIParticles()
})

/**
 * 滚动动画 - 元素进入视口时添加动画效果
 */
function initScrollAnimations() {
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px',
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in')
        observer.unobserve(entry.target)
      }
    })
  }, observerOptions)

  // 观察需要动画的元素
  const animateElements = document.querySelectorAll(
    '.feature-row, .target-card, .testimonial-card, .section-header',
  )

  animateElements.forEach((el) => {
    el.classList.add('animate-element')
    observer.observe(el)
  })

  // 添加动画样式
  const style = document.createElement('style')
  style.textContent = `
    .animate-element {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .animate-element.animate-in {
      opacity: 1;
      transform: translateY(0);
    }
    .target-card.animate-element {
      transition-delay: calc(var(--index, 0) * 0.1s);
    }
    .testimonial-card.animate-element {
      transition-delay: calc(var(--index, 0) * 0.15s);
    }
  `
  document.head.appendChild(style)

  // 为卡片添加索引以实现交错动画
  document.querySelectorAll('.target-card').forEach((card, index) => {
    card.style.setProperty('--index', index)
  })
  document.querySelectorAll('.testimonial-card').forEach((card, index) => {
    card.style.setProperty('--index', index)
  })
}

/**
 * 平滑滚动
 */
function initSmoothScroll() {
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault()
      const target = document.querySelector(this.getAttribute('href'))
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        })
      }
    })
  })
}

/**
 * 统计数字动画
 */
function initStatsCounter() {
  const stats = document.querySelectorAll('.stat-number')

  const observerOptions = {
    threshold: 0.5,
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateCounter(entry.target)
        observer.unobserve(entry.target)
      }
    })
  }, observerOptions)

  stats.forEach(stat => observer.observe(stat))
}

/**
 * 数字递增动画
 */
function animateCounter(element) {
  const text = element.textContent
  const hasPlus = text.includes('+')
  const hasPercent = text.includes('%')
  const numericValue = Number.parseInt(text.replace(/\D/g, ''), 10)

  if (Number.isNaN(numericValue))
    return

  const duration = 2000
  const steps = 60
  const stepDuration = duration / steps
  const increment = numericValue / steps

  let current = 0
  let step = 0

  const timer = setInterval(() => {
    step++
    current = Math.min(Math.round(increment * step), numericValue)

    let displayValue = current.toLocaleString()
    if (hasPlus)
      displayValue += '+'
    if (hasPercent)
      displayValue += '%'

    element.textContent = displayValue

    if (step >= steps) {
      clearInterval(timer)
    }
  }, stepDuration)
}

/**
 * AI粒子动画效果
 */
function initAIParticles() {
  const heroParticles = document.querySelector('.hero-particles')
  if (!heroParticles)
    return

  // 添加AI风格的粒子
  for (let i = 0; i < 15; i++) {
    const particle = document.createElement('span')
    particle.style.cssText = `
            position: absolute;
            width: ${Math.random() * 6 + 2}px;
            height: ${Math.random() * 6 + 2}px;
            background: linear-gradient(45deg, rgba(138, 43, 226, 0.8), rgba(30, 144, 255, 0.8));
            border-radius: 50%;
            left: ${Math.random() * 100}%;
            top: ${Math.random() * 100}%;
            animation: aiFloat ${Math.random() * 8 + 6}s infinite ease-in-out;
            animation-delay: ${Math.random() * 3}s;
      box-shadow: 0 0 10px rgba(138, 43, 226, 0.5);
    `
    heroParticles.appendChild(particle)
  }

  // 添加AI粒子动画样式
  const aiStyle = document.createElement('style')
  aiStyle.textContent = `
    @keyframes aiFloat {
      0%, 100% {
        transform: translateY(0px) translateX(0px) scale(1);
        opacity: 0.6;
      }
      25% {
        transform: translateY(-20px) translateX(10px) scale(1.2);
        opacity: 1;
      }
      50% {
        transform: translateY(-40px) translateX(-10px) scale(0.8);
        opacity: 0.8;
      }
      75% {
        transform: translateY(-20px) translateX(5px) scale(1.1);
        opacity: 0.9;
      }
    }
  `
  document.head.appendChild(aiStyle)
}

/**
 * 添加按钮点击波纹效果
 */
document.querySelectorAll('.cta-button').forEach((button) => {
  button.addEventListener('click', function (e) {
    const rect = this.getBoundingClientRect()
    const ripple = document.createElement('span')
    const size = Math.max(rect.width, rect.height)

    ripple.style.cssText = `
            position: absolute;
            width: ${size}px;
            height: ${size}px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transform: scale(0);
            animation: ripple 0.6s ease-out;
            pointer-events: none;
            left: ${e.clientX - rect.left - size / 2}px;
            top: ${e.clientY - rect.top - size / 2}px;
    `

    this.style.position = 'relative'
    this.style.overflow = 'hidden'
    this.appendChild(ripple)

    setTimeout(() => ripple.remove(), 600)
  })
})

// 添加波纹动画样式
const rippleStyle = document.createElement('style')
rippleStyle.textContent = `
  @keyframes ripple {
    to {
      transform: scale(2.5);
      opacity: 0;
    }
  }
`
document.head.appendChild(rippleStyle)
</script>
  </body>
