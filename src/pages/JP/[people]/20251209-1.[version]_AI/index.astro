---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'

// Import CSS and JS
import './static/css/style.css'

// Network images for features (AI investment related)
const networkImages = {
  aiAnalysis: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop',
  aiStrategy: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop',
  aiMarket: 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&h=600&fit=crop',
}

export const getStaticPaths = (() => {
  return [
    {
      params: { people: '堀江貴文', version: '0' },
      props: {
        name: '堀江貴文',
        avatarPath: '@/assets/avatar/堀江貴文_avatar.png',
        title: '堀江貴文 AI投資コミュニティ | AI分析で投資スキルアップ',
        description: '堀江貴文が主催するAI投資コミュニティ。AI技術を活用した投資分析と戦略を無料で学べます。',
        heroTitle: 'AI投資の未来',
        heroSubtitle: 'AI技術と実業家の経験を融合した',
        heroDescription: '実業家・投資家として長年の経験を持つ堀江貴文が、AI技術を活用した投資分析と戦略を無料で共有',
        aboutTitle: '堀江貴文について',
        aboutDescription: '実業家・投資家として長年活動し、AI技術を投資に活用する先駆者',
        profileTitle: '実業家・投資家・AI投資パイオニア',
        profileTags: ['実業家', '投資家', 'AI投資'],
      },
    },
    {
      params: { people: '馬渕磨理子', version: '0' },
      props: {
        name: '馬渕磨理子',
        avatarPath: '@/assets/avatar/馬渕磨理子_avatar.png',
        title: '馬渕磨理子 AI投資コミュニティ | AI分析で投資スキルアップ',
        description: '馬渕磨理子が主催するAI投資コミュニティ。AI技術を活用した投資分析と戦略を無料で学べます。',
        heroTitle: 'AI投資の未来',
        heroSubtitle: 'AI技術と投資アドバイザーの経験を融合した',
        heroDescription: '投資アドバイザーとして長年の経験を持つ馬渕磨理子が、AI技術を活用した投資分析と戦略を無料で共有',
        aboutTitle: '馬渕磨理子について',
        aboutDescription: '投資アドバイザーとして長年活動し、AI技術を投資に活用する専門家',
        profileTitle: '投資アドバイザー・AI投資コンサルタント',
        profileTags: ['投資アドバイザー', 'FP', 'AI投資'],
      },
    },
  ]
}) satisfies GetStaticPaths

const { name, avatarPath, title, description, heroTitle, heroSubtitle, heroDescription, aboutTitle, aboutDescription, profileTitle, profileTags } = Astro.props

// Dynamically import avatar image based on name
let avatarImg
if (name === '堀江貴文') {
  const avatarModule = await import('../../../../assets/avatar/堀江貴文_avatar.png')
  avatarImg = avatarModule.default
}
else if (name === '馬渕磨理子') {
  const avatarModule = await import('../../../../assets/avatar/馬渕磨理子_avatar.png')
  avatarImg = avatarModule.default
}
else {
  // Fallback
  const filename = avatarPath.split('/').pop()
  const avatarModule = await import(`../../../../assets/avatar/${filename}`)
  avatarImg = avatarModule.default
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700;900&amp;display=swap"
      rel="stylesheet"
    />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <script is:inline>
      function handleCTAClick() {
        window.location.href = 'https://dkfck.top'
      }

      // Modal 弹窗函数
      function openModal(type) {
        const modal = document.getElementById(`modal-${type}`)
        if (modal) {
          modal.classList.add('active')
          document.body.style.overflow = 'hidden'
        }
      }

      function closeModal(type) {
        const modal = document.getElementById(`modal-${type}`)
        if (modal) {
          modal.classList.remove('active')
          document.body.style.overflow = ''
        }
      }

      // ESC键关闭弹窗
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.modal.active').forEach((modal) => {
            modal.classList.remove('active')
            document.body.style.overflow = ''
          })
        }
      })
    </script>
  </head>
  <body>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-particles">
          <span></span><span></span><span></span> <span></span><span></span><span></span> <span></span><span></span
          ><span></span>
        </div>
        <div class="hero-gradient"></div>
      </div>
      <div class="container">
        <div class="hero-content">
          <div class="hero-badge">
            <i class="fas fa-robot"></i>
            <span>AI投資コミュニティ</span>
          </div>
          <!-- Profile Avatar -->
          <div class="hero-avatar">
            <Image
              src={avatarImg}
              alt={name}
              width={120}
              height={120}
              style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid rgba(255, 255, 255, 0.3); object-fit: cover; margin: 0 auto 20px; display: block; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);"
            />
            <div class="profile-info" style="text-align: center; margin-bottom: 20px;">
              <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; color: white;">{name}</h3>
              <p style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.9); margin-bottom: 12px;">{profileTitle}</p>
              <div class="profile-tags" style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                {profileTags.map(tag => (
                  <span style="background: rgba(255, 255, 255, 0.2); padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; color: white; backdrop-filter: blur(10px);">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
          <h1 class="hero-title">
            <span class="highlight">{heroTitle}</span>を<br />
            {heroSubtitle}<br />
            共に創り上げます
          </h1>
          <p class="hero-subtitle">
            {heroDescription}
          </p>
          <!-- 福利文案 - PC端和手机端都显示 -->
          <div class="hero-benefits">
            <div class="benefit-item">
              <i class="fas fa-robot"></i>
              <span>AI投資分析ツール無料提供</span>
            </div>
            <div class="benefit-item">
              <i class="fas fa-brain"></i>
              <span>AIが生成する投資戦略レポート</span>
            </div>
            <div class="benefit-item">
              <i class="fas fa-chart-line"></i>
              <span>AI予測による市場分析</span>
            </div>
          </div>
          <button class="cta-button hero-cta" onclick="handleCTAClick()">
            <i class="fas fa-robot"></i>
            <span>AI投資ツールを無料で体験</span>
            <i class="fas fa-arrow-right"></i>
          </button>
        </div>
      </div>
      <div class="hero-scroll">
        <i class="fas fa-chevron-down"></i>
      </div>
    </section>

    <!-- AI Features Section -->
    <section class="section features-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag"><i class="fas fa-robot"></i> AI特典</span>
          <h2 class="section-title">AI技術を活用した投資支援</h2>
        </div>

        <div class="feature-row">
          <div class="feature-image">
            <img
              src={networkImages.aiAnalysis}
              alt="AI投資ガイド"
              style="width: 100%; height: 100%; object-fit: cover"
            />
          </div>
          <div class="feature-content">
            <h3 class="feature-title">
              <i class="fas fa-brain"></i>
              AI投資分析ツール無料提供
