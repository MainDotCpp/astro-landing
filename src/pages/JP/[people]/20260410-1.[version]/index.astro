export const getStaticPaths = (() => {
  return [
    {
      params: { people: '三橋貴明', version: '0' },
      props: {
        name: '三橋貴明',
        title: '三橋貴明 投資サロン｜本質を見抜く経済思考',
        description: '経済評論家・三橋貴明が主宰する投資学習コミュニティ。マクロ経済の本質から投資判断力を鍛える。',
        role: '経済評論家・作家',
        heroQuote: '数字の裏にある真実を、\n読み解く力を。',
        expertise: ['マクロ経済分析', 'デフレ経済論', '財政政策研究'],
        achievement: { number: '100', unit: '冊+', label: '著書・監修' },
        philosophy: '経済の本質を理解することが、投資の第一歩です。メディアに流されない、自分の頭で考える力を養いましょう。',
      },
    },
    {
      params: { people: '馬渕磨理子', version: '0' },
      props: {
        name: '馬渕磨理子',
        title: '馬渕磨理子 投資サロン｜データが導く確かな投資判断',
        description: '経済アナリスト・馬渕磨理子が主宰する投資学習コミュニティ。データに基づく投資戦略を学ぶ。',
        role: '経済アナリスト・投資アドバイザー',
        heroQuote: 'データが語る未来を、\nあなたの資産に変える。',
        expertise: ['株式市場分析', 'ファンダメンタル分析', 'ポートフォリオ戦略'],
        achievement: { number: '50', unit: '万+', label: 'フォロワー' },
        philosophy: '感覚ではなくデータに基づいた投資判断が、長期的な資産形成の鍵です。一緒に学んでいきましょう。',
      },
    },
    {
      params: { people: '堀江貴文', version: '0' },
      props: {
        name: '堀江貴文',
        title: '堀江貴文 投資サロン｜時代を先読みする投資眼',
        description: '実業家・堀江貴文が主宰する投資学習コミュニティ。テクノロジーと経済の交差点から投資機会を探る。',
        role: '実業家・投資家',
        heroQuote: '常識を疑え。\n未来は、動く者のもの。',
        expertise: ['テクノロジー投資', 'スタートアップ分析', 'グローバル経済'],
        achievement: { number: '300', unit: '万+', label: 'フォロワー' },
        philosophy: '投資とは、未来を信じて行動すること。情報を集め、自分で判断し、恐れずに動く。それが最大のリターンを生む。',
      },
    },
  ]
}) satisfies GetStaticPaths

const { name, title, description, role, heroQuote, expertise, achievement, philosophy } = Astro.props

let avatarImg
if (name === '三橋貴明') {
  const m = await import('../../../../assets/avatar/三橋貴明_avatar.png')
  avatarImg = m.default
}
 else if (name === '馬渕磨理子') {
  const m = await import('../../../../assets/avatar/馬渕磨理子_avatar.png')
  avatarImg = m.default
}
 else if (name === '堀江貴文') {
  const m = await import('../../../../assets/avatar/堀江貴文_avatar.png')
  avatarImg = m.default
}
