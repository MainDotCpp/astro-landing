    <script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  initReveal()
  initCarousel()
  initScrollHint()
})

function initReveal() {
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('revealed')
        obs.unobserve(e.target)
      }
    })
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' })

  document.querySelectorAll('.phil-quote, .exp-card, .ben-item, .test-card, .join-inner').forEach((el) => {
    obs.observe(el)
  })
}

function initCarousel() {
  const track = document.getElementById('carouselTrack')
  const dotsWrap = document.getElementById('carouselDots')
  if (!track || !dotsWrap)
    return

  const cards = track.querySelectorAll('.test-card')
  let current = 0

  cards.forEach((_, i) => {
    const dot = document.createElement('button')
    dot.className = `c-dot${i === 0 ? ' active' : ''}`
    dot.addEventListener('click', () => goTo(i))
    dotsWrap.appendChild(dot)
  })

  const dots = dotsWrap.querySelectorAll('.c-dot')

  function goTo(idx) {
    current = Math.max(0, Math.min(idx, cards.length - 1))
    const gap = 20
    const cardW = cards[0].offsetWidth + gap
    const containerW = track.parentElement.offsetWidth
    const offset = (containerW - cards[0].offsetWidth) / 2
    track.style.transform = `translateX(${offset - current * cardW}px)`
    dots.forEach((d, i) => d.classList.toggle('active', i === current))
  }

  let sx = 0; let ex = 0
  track.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX })
  track.addEventListener('touchend', (e) => {
    ex = e.changedTouches[0].clientX
    const diff = sx - ex
    if (Math.abs(diff) > 40) {
      diff > 0 ? goTo(current + 1) : goTo(current - 1)
    }
  })

  goTo(0)
  window.addEventListener('resize', () => goTo(current))

  setInterval(() => {
    goTo(current < cards.length - 1 ? current + 1 : 0)
  }, 5000)
}

function initScrollHint() {
  const hint = document.querySelector('.hero-scroll-hint')
  if (!hint)
    return
  window.addEventListener('scroll', () => {
    hint.style.opacity = window.scrollY > 80 ? '0' : '1'
  }, { passive: true })
}
</script>
