    <script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  initReveal()
  initVoiceCarousel()
  initFloatCta()
})

function initReveal() {
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in-view')
        obs.unobserve(e.target)
      }
    })
  }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' })

  document.querySelectorAll('.profile, .ben-card, .voice-card, .cta-card, .vb-text, .gv-content').forEach((el) => {
    obs.observe(el)
  })
}

function initVoiceCarousel() {
  const track = document.getElementById('voiceTrack')
  const dotsWrap = document.getElementById('voiceDots')
  if (!track || !dotsWrap)
    return

  const cards = track.querySelectorAll('.voice-card')
  let cur = 0

  cards.forEach((_, i) => {
    const dot = document.createElement('button')
    dot.className = `vd${i === 0 ? ' active' : ''}`
    dot.addEventListener('click', () => go(i))
    dotsWrap.appendChild(dot)
  })
  const dots = dotsWrap.querySelectorAll('.vd')

  function go(i) {
    cur = Math.max(0, Math.min(i, cards.length - 1))
    const gap = 16
    const cw = cards[0].offsetWidth + gap
    const pw = track.parentElement.offsetWidth
    const off = (pw - cards[0].offsetWidth) / 2
    track.style.transform = `translateX(${off - cur * cw}px)`
    dots.forEach((d, j) => d.classList.toggle('active', j === cur))
  }

  let sx = 0
  track.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX }, { passive: true })
  track.addEventListener('touchend', (e) => {
    const diff = sx - e.changedTouches[0].clientX
    if (Math.abs(diff) > 40)
      diff > 0 ? go(cur + 1) : go(cur - 1)
  })

  go(0)
  window.addEventListener('resize', () => go(cur))
  setInterval(() => go(cur < cards.length - 1 ? cur + 1 : 0), 6000)
}

function initFloatCta() {
  const btn = document.querySelector('.float-cta')
  if (!btn)
    return
  let shown = false
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400 && !shown) {
      btn.classList.add('visible')
      shown = true
    }
    else if (window.scrollY <= 400 && shown) {
      btn.classList.remove('visible')
      shown = false
    }
  }, { passive: true })
}
</script>
