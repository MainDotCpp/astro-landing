---
import { Image } from 'astro:assets'

import RedirectCode from '@/components/RedirectCode.astro'
import contentImg from './static/content.png'
import JPComplianceFooter from '../../common/JPComplianceFooter.astro'
import './static/css/index-b-wcoy1g.css'
import './static/css/uni.06dd3c8e.css'
import './static/css/index-dn9clil2.css'

export function getStaticPaths() {
  const pages = [
  { params: { people: '三橋貴明', version: '0' }, props: { name: '三橋貴明' } },
  { params: { people: '馬渕磨理子', version: '0' }, props: { name: '馬渕磨理子' } },
]
return pages
}

const { people } = Astro.params
const { name } = Astro.props
const heroImg = import(`../images/${people}_hero.jpg`)
const lineButtonImg = import(`../images/${people}_line_button.png`)
const floatingButtonImg = import(`../images/${people}_floating_button.png`);
---
<!doctype html>
<html
  lang="en"
  style="
    font-size: 16px;
    --status-bar-height: 0px;
    --top-window-height: 0px;
    --window-left: 0px;
    --window-right: 0px;
    --window-margin: 0px;
    --tab-bar-height: 0px;
    --window-top: calc(0px + env(safe-area-inset-top));
    --window-bottom: calc(0px + env(safe-area-inset-bottom));
  "
>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover"
    />
    <title>{name} の株式投資塾【切り抜き】</title>
   <RedirectCode />

  </head>

  <body data-v-335935df="" nvue-dir-column="">
    <div id="app" data-v-app="">
      <div class="container" data-v-335935df="">
        <div class="section" data-v-335935df="">
          <Image data-v-335935df="" src={heroImg} alt="1" width={1200} />
          <p data-v-335935df="" style="color: rgb(255, 0, 0); font-size: 19px; font-weight: 600">
            『京大院卒の経済アナリストが開発！収入10倍アップの高速勉強法』
          </p>
          <p data-v-335935df="" class="p1">
            {name} 経済アナリスト／一般社団法人「日本金融経済研究所」代表理事／FUNDINNO ECFアナリスト
          </p>
          <p data-v-335935df="" class="p1">
            これまでに投資をしてきた方は、新たな年間投資限度額を活用することができますし、これから新たに口座を開設する方もいるため、市場にはさらなる資金流入が見込まれます。
            中には「成長投資枠」を活用して個別株を購入し、すでに利益を確定させている投資家もいるかもしれません。また、投資枠が拡大するにつれて、その枠を使って利益を出し、売却を行う動きも増えることが考えられます。」
            こうした投資熱がますます高まるなかで、個人投資家はどのように立ち回るべきなのでしょうか？
          </p>
          <p data-v-335935df="" style="color: rgb(255, 0, 0); font-size: 19px; font-weight: 600">
            私の投資戦略にご興味のある方、または最新の急騰株情報を受け取りたい方は、下のボタンからLINEを追加してください。
            登録後、情報は無料でお届けいたします。
          </p>
        </div>
        <div class="cta" data-v-335935df="">
          <Image data-v-335935df="" src={contentImg} alt="1" width={1200} />
          <a data-v-335935df="" class="btn golink1" href="javascript:void(0)" onclick="mixinJump()">
            <Image data-v-335935df="" src={lineButtonImg} alt="2" width={1200} />
          </a>
        </div>
      </div>
      <a data-v-335935df="" class="golink1" href="javascript:void(0)" onclick="mixinJump()">
        <Image
          data-v-335935df=""
          src={floatingButtonImg}
          alt="Floating Image"
          class="floating-image"
          width={300}
        />
      </a>
    </div>
    <JPComplianceFooter />
</body>
</html>
