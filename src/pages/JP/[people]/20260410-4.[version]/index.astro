        <p style="font-size: 9px; line-height: 1.4; color: #888; margin-top: 8px; text-align: center; width: 100%; max-width: 24rem; margin-left: auto; margin-right: auto; letter-spacing: -0.025em; filter: drop-shadow(0 1px 1px rgba(0,0,0,0.05));">※口座開設は無料ですが、実際の取引には所定の手数料及びリスクが伴います。</p>
      <p class="inline-cta-note">※ ボタンをタップするとLINEアプリが開きます</p>
    </div>

    <!-- ===== Garden Visual ===== -->
    <section class="garden-visual">
      <Image src={gardenImg} alt="" width={1080} height={720} style="width:100%;height:100%;object-fit:cover" />
      <div class="gv-overlay"></div>
    </section>

    <!-- ===== Testimonials ===== -->
    <section class="voices">
      <div class="container">
        <h2 class="section-title">参加者の皆さまの声</h2>
        <div class="voice-list">
          {testimonials.map((t: { name: string, age: string, text: string }) => (
            <div class="voice-card">
              <p class="voice-text">「{t.text}」</p>
              <div class="voice-author">
                <span class="voice-name">{t.name}</span>
                <span class="voice-age">{t.age}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Inline CTA: After Testimonials ===== -->
    <div class="inline-cta container">
