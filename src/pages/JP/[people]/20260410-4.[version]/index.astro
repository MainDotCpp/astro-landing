    <script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  // Simple scroll reveal - gentle fade only
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible')
        obs.unobserve(e.target)
      }
    })
  }, { threshold: 0.1 })

  document.querySelectorAll('.profile-card, .msg-body, .ben-item, .voice-card, .cta-box, .tv-text').forEach((el) => {
    obs.observe(el)
  })

  // Floating CTA - show after scroll
  const fc = document.getElementById('floatCta')
  if (fc) {
    window.addEventListener('scroll', () => {
      fc.classList.toggle('show', window.scrollY > 300)
    }, { passive: true })
  }
})
</script>
