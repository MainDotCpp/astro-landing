---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import JPComplianceFooter from '../../common/JPComplianceFooter.astro'
import JPSecurityIcons from '../../common/JPSecurityIcons.astro'

import gardenImg from './static/images/garden.png'
import heroBg from './static/images/hero-bg.png'
import trustBg from './static/images/trust-bg.png'

import './static/css/style.css'

export const getStaticPaths = (() => {
  return [
    {
      params: { people: '三橋貴明', version: '0' },
      props: {
        name: '三橋貴明',
        title: '三橋貴明先生の投資勉強会｜無料でご参加いただけます',
        description: '経済評論家・三橋貴明先生が主宰する投資勉強会。初心者の方も安心してご参加いただけます。',
        role: '経済評論家・作家',
        greeting: '皆さまへ、心を込めてお届けします。',
        heroHeading: '安心して学べる\n投資の勉強会',
        profileText: '経済評論家として100冊以上の著書を持ち、テレビ・新聞でも活躍。難しい経済の話を、どなたにも分かりやすくお伝えすることを大切にしています。',
        messageTitle: '三橋貴明からのメッセージ',
        message: '「投資は難しい」そう思っていませんか？\n\n実は、基礎をしっかり学べば、\nどなたでも安心して始められます。\n\n私の勉強会では、難しい専門用語を使わず、\n分かりやすい言葉で丁寧にお伝えしています。\n\nまずは気軽にご参加ください。\n費用は一切かかりません。',
        benefits: [
          { icon: 'book', title: '投資入門ガイドを無料進呈', desc: '初心者の方にも分かりやすい投資ガイドブックをプレゼント' },
          { icon: 'calendar', title: '月2〜3回の勉強会', desc: 'オンラインで自宅から参加可能。質問も自由にできます' },
          { icon: 'chart', title: '最新の経済情報をお届け', desc: 'ニュースの読み方や注目ポイントを分かりやすく解説' },
          { icon: 'chat', title: 'いつでも相談できる環境', desc: '分からないことがあれば、いつでもお気軽にご質問ください' },
        ],
        testimonials: [
          { name: '佐藤さん', age: '60代・元教師', text: '定年後の資産運用に不安がありましたが、三橋先生の分かりやすい説明のおかげで、安心して投資を始められました。' },
          { name: '田中さん', age: '50代・会社員', text: '難しいと思っていた経済の話が、先生の解説を聞くとスッと頭に入ってきます。もっと早く出会いたかったです。' },
          { name: '鈴木さん', age: '70代・年金生活', text: '年金だけでは不安でしたが、少しずつ配当収入をつくることができました。同年代の仲間がいるのも心強いです。' },
        ],
      },
    },
    {
      params: { people: '馬渕磨理子', version: '0' },
      props: {
        name: '馬渕磨理子',
        title: '馬渕磨理子先生の投資勉強会｜無料でご参加いただけます',
        description: '経済アナリスト・馬渕磨理子先生が主宰する投資勉強会。初心者の方も安心してご参加いただけます。',
        role: '経済アナリスト・投資アドバイザー',
        greeting: '皆さまへ、心を込めてお届けします。',
        heroHeading: '安心して学べる\n投資の勉強会',
        profileText: '経済アナリストとして株式市場を長年分析。テレビ出演や講演活動を通じて、投資の基本を幅広い世代に分かりやすくお伝えしています。',
        messageTitle: '馬渕磨理子からのメッセージ',
        message: '「投資は難しい」そう思っていませんか？\n\n実は、基礎をしっかり学べば、\nどなたでも安心して始められます。\n\n私の勉強会では、データを使って\n分かりやすく投資のコツをお伝えしています。\n\nまずは気軽にご参加ください。\n費用は一切かかりません。',
        benefits: [
          { icon: 'book', title: '投資入門ガイドを無料進呈', desc: '初心者の方にも分かりやすい投資ガイドブックをプレゼント' },
          { icon: 'calendar', title: '月2〜3回の勉強会', desc: 'オンラインで自宅から参加可能。質問も自由にできます' },
          { icon: 'chart', title: '最新の市場情報をお届け', desc: '注目銘柄や市場の動向を分かりやすく解説' },
          { icon: 'chat', title: 'いつでも相談できる環境', desc: '分からないことがあれば、いつでもお気軽にご質問ください' },
        ],
        testimonials: [
          { name: '山田さん', age: '60代・主婦', text: '馬渕先生の説明はとても丁寧で安心できます。家計の見直しから始めて、今では少しずつ投資も楽しんでいます。' },
          { name: '中村さん', age: '55代・自営業', text: 'データに基づいた解説なので、納得して判断できます。仕事の合間にオンラインで参加できるのもありがたいです。' },
          { name: '高橋さん', age: '68代・退職者', text: '退職金の運用について相談でき、とても助かりました。安心して老後の資産形成に取り組めています。' },
        ],
      },
    },
    {
      params: { people: '堀江貴文', version: '0' },
      props: {
        name: '堀江貴文',
        title: '堀江貴文先生の投資勉強会｜無料でご参加いただけます',
        description: '実業家・堀江貴文が主宰する投資勉強会。初心者の方も安心してご参加いただけます。',
        role: '実業家・投資家',
        greeting: '皆さまへ、心を込めてお届けします。',
        heroHeading: '安心して学べる\n投資の勉強会',
        profileText: '実業家・投資家として第一線で活躍。複雑な経済の仕組みを、どなたにも分かりやすくシンプルにお伝えすることを心がけています。',
        messageTitle: '堀江貴文からのメッセージ',
        message: '「投資は難しい」そう思っていませんか？\n\n実は、基礎をしっかり学べば、\nどなたでも安心して始められます。\n\n私の勉強会では、シンプルで実践的な\n投資の考え方をお伝えしています。\n\nまずは気軽にご参加ください。\n費用は一切かかりません。',
        benefits: [
          { icon: 'book', title: '投資入門ガイドを無料進呈', desc: '初心者の方にも分かりやすい投資ガイドブックをプレゼント' },
          { icon: 'calendar', title: '月2〜3回の勉強会', desc: 'オンラインで自宅から参加可能。質問も自由にできます' },
          { icon: 'chart', title: '最新のトレンド情報', desc: 'テクノロジーと経済の最新動向を分かりやすく解説' },
          { icon: 'chat', title: 'いつでも相談できる環境', desc: '分からないことがあれば、いつでもお気軽にご質問ください' },
        ],
        testimonials: [
          { name: '渡辺さん', age: '58代・会社役員', text: '堀江さんのシンプルな考え方に感銘を受けました。投資に対するハードルが一気に下がり、実践できています。' },
          { name: '伊藤さん', age: '65代・退職者', text: '新しいテクノロジーの話も、分かりやすく説明してくれるので安心です。視野が広がりました。' },
          { name: '木村さん', age: '72代・年金生活', text: '年齢に関係なく歓迎してくれる雰囲気がうれしいです。少額から始められるのも安心です。' },
        ],
      },
    },
  ]
}) satisfies GetStaticPaths

const { name, title, description, role, greeting, heroHeading, profileText, messageTitle, message, benefits, testimonials } = Astro.props

let avatarImg
if (name === '三橋貴明') {
  const m = await import('../../../../assets/avatar/三橋貴明_avatar.png')
  avatarImg = m.default
}
 else if (name === '馬渕磨理子') {
  const m = await import('../../../../assets/avatar/馬渕磨理子_avatar.png')
  avatarImg = m.default
}
 else if (name === '堀江貴文') {
  const m = await import('../../../../assets/avatar/堀江貴文_avatar.png')
  avatarImg = m.default
}
