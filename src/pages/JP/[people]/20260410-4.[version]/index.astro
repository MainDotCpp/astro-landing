<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!--#include file="head.html" -->
    <!---------------------------⬇⬇⬇⬇跟踪代码粘贴在这里⬇⬇⬇⬇------------------------------------>
    <!---------------------------⬆⬆⬆⬆跟踪代码粘贴在这里⬆⬆⬆⬆----------------------------------->
    <script is:inline>
    const link = '<!--#include file="link.txt" -->'
</script>
<script src="/mjSFqQ/QvBmKz.js" is:inline></script>
  </head>
  <body>
    <!-- ===== Hero ===== -->
    <section class="hero">
      <div class="hero-img">
        <Image src={heroBg} alt="" width={1080} height={1080} style="width:100%;height:100%;object-fit:cover" />
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="hero-greeting">{greeting}</p>
        <h1 class="hero-heading">{heroHeading}</h1>
        <div class="hero-name-badge">
          <span>{name}先生 主宰</span>
        </div>
        <p class="hero-free">参加費無料</p>

        <div style="margin-top: 32px; font-size: 11px; color: #666; display: flex; justify-content: center; align-items: center; gap: 12px;">
          <span>関東財務局長（金商）第9999号</span>
          <span style="width: 1px; height: 12px; background-color: #ccc;"></span>
          <span style="font-weight: bold;">口座開設数 50万突破</span>
        </div>
    </div>
    </section>

    <!-- ===== Inline CTA: After Hero ===== -->
    <div class="inline-cta container">
      <button onclick="onLinkBtnClick()" class="inline-cta-btn">
        <svg viewBox="0 0 24 24" fill="#fff" width="24" height="24">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.271.173-.508.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
        </svg>
        <span>LINEで無料参加する</span>
      </button>
        <p style="font-size: 9px; line-height: 1.4; color: #888; margin-top: 8px; text-align: center; width: 100%; max-width: 24rem; margin-left: auto; margin-right: auto; letter-spacing: -0.025em; filter: drop-shadow(0 1px 1px rgba(0,0,0,0.05));">※口座開設は無料ですが、実際の取引には所定の手数料及びリスクが伴います。</p>
      <p class="inline-cta-note">※ 参加費無料・退会自由</p>
    </div>

    <!-- ===== Profile ===== -->
    <section class="profile">
      <div class="container">
        <div class="profile-card">
          <div class="profile-avatar">
            {avatarImg && (
              <Image
                src={avatarImg}
                alt={name}
                width={120}
                height={120}
                style="width:100%;height:100%;object-fit:cover;border-radius:50%"
              />
            )}
          </div>
          <h2 class="profile-name">{name}<span class="honorific">先生</span></h2>
          <p class="profile-role">{role}</p>
          <div class="profile-divider"></div>
          <p class="profile-text">{profileText}</p>
        </div>
      </div>
    </section>

    <!-- ===== Message ===== -->
    <section class="message">
      <div class="container">
        <h2 class="msg-title">{messageTitle}</h2>
        <div class="msg-body">
          <p>{message}</p>
        </div>
      </div>
    </section>

    <!-- ===== Inline CTA: After Message ===== -->
    <div class="inline-cta container">
      <button onclick="onLinkBtnClick()" class="inline-cta-btn">
        <svg viewBox="0 0 24 24" fill="#fff" width="24" height="24">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.271.173-.508.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
        </svg>
        <span>まずは気軽に参加する</span>
      </button>
        <p style="font-size: 9px; line-height: 1.4; color: #888; margin-top: 8px; text-align: center; width: 100%; max-width: 24rem; margin-left: auto; margin-right: auto; letter-spacing: -0.025em; filter: drop-shadow(0 1px 1px rgba(0,0,0,0.05));">※口座開設は無料ですが、実際の取引には所定の手数料及びリスクが伴います。</p>
      <p class="inline-cta-note">※ 費用は一切かかりません</p>
    </div>

    <!-- ===== Trust Visual ===== -->
    <section class="trust-visual">
      <Image src={trustBg} alt="" width={1080} height={720} style="width:100%;height:100%;object-fit:cover" />
      <div class="tv-overlay"></div>
      <div class="tv-text">
        <p>穏やかな暮らしのために、<br />確かな知識を。</p>
      </div>
    </section>

    <!-- ===== Benefits ===== -->
    <section class="benefits">
      <div class="container">
        <h2 class="section-title">ご参加の特典</h2>
        <div class="ben-list">
          {benefits.map((b: { icon: string, title: string, desc: string }) => (
            <div class="ben-item">
              <span class="ben-icon">
                {b.icon === 'book' && (
                  <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /><line x1="8" y1="7" x2="16" y2="7" /><line x1="8" y1="11" x2="13" y2="11" /></svg>
                )}
                {b.icon === 'calendar' && (
                  <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                )}
                {b.icon === 'chart' && (
                  <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /><line x1="2" y1="20" x2="22" y2="20" /></svg>
                )}
                {b.icon === 'chat' && (
                  <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                )}
              </span>
              <div class="ben-text">
                <h3>{b.title}</h3>
                <p>{b.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Inline CTA: After Benefits ===== -->
    <div class="inline-cta container">
      <JPSecurityIcons />
      <button onclick="onLinkBtnClick()" class="inline-cta-btn">
        <svg viewBox="0 0 24 24" fill="#fff" width="24" height="24">
          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.271.173-.508.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
        </svg>
