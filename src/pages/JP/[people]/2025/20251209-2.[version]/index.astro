---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'
// Import CSS
import './static/css/style.css'

export const getStaticPaths = (() => {
  return [
    {
      params: { people: '田端信太郎', version: '0' },
      props: {
        name: '田端信太郎',
        img_prefix: 'honda_',
      },
    },
  ]
}) satisfies GetStaticPaths

// These params are used in the route but not in the component
const { people: _people, version: _version } = Astro.params
const { img_prefix, name } = Astro.props as { img_prefix: string, name: string }

// Dynamic image imports
const heroImg = (await import(`./static/images/${img_prefix}1.png`)).default
const aboutImg = (await import(`./static/images/${img_prefix}2.png`)).default
const lineIcon = (await import(`./static/images/line.png`)).default
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> {name} | 資産管理専門家 · 投資教育者</title>
    <meta name="description" content="{name}と一緒に学ぶ無料投資コミュニティ。株式、ETF、資産運用戦略を学びましょう。" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <RedirectCode />

  </head>
  <body>
    <!-- Stock Ticker -->
    <div class="stock-ticker">
      <div class="ticker-wrap">
        <div class="ticker-content">
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> トヨタ自動車 3,245円 +1.8%</span>
          <span class="ticker-item down"><i class="fas fa-arrow-down"></i> ソニーグループ 13,580円 -0.5%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> キーエンス 68,500円 +2.3%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> 任天堂 7,850円 +1.2%</span>
          <span class="ticker-item down"><i class="fas fa-arrow-down"></i> パナソニック 1,245円 -0.8%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> 日立製作所 9,680円 +3.1%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> 三菱UFJフィナンシャル 1,125円 +0.9%</span>
          <span class="ticker-item down"><i class="fas fa-arrow-down"></i> ソフトバンクグループ 7,245円 -1.2%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> 東京エレクトロン 25,800円 +2.0%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> ファーストリテイリング 38,500円 +1.5%</span>
          <!-- Duplicate for seamless loop -->
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> トヨタ自動車 3,245円 +1.8%</span>
          <span class="ticker-item down"><i class="fas fa-arrow-down"></i> ソニーグループ 13,580円 -0.5%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> キーエンス 68,500円 +2.3%</span>
          <span class="ticker-item up"><i class="fas fa-arrow-up"></i> 任天堂 7,850円 +1.2%</span>
          <span class="ticker-item down"><i class="fas fa-arrow-down"></i> パナソニック 1,245円 -0.8%</span>
        </div>
      </div>
    </div>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg-pattern"></div>
      <div class="hero-container">
        <div class="hero-content">
          <div class="hero-badge"><i class="fas fa-crown"></i> 資産管理専門家</div>
          <h1 class="hero-title">
            <span class="highlight">{name}</span>と一緒に<br />
            <span class="sub-title">あなたの資産を守りましょう</span>
