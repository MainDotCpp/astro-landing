                <span class="cta-main">LINE友だち追加で無料参加</span>
                <span class="cta-sub">投資情報を今すぐ受け取る</span>
              </div>
            </button>
          </div>
          <div class="community-image">
            <div class="phone-mockup">
              <div class="phone-screen">
                <div class="chat-header">
                  <div class="chat-avatar">
                    <Image src={lineIcon} alt="LINE" class="line-avatar-img" />
