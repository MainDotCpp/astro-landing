---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { Sparkles, Star, Heart, Moon, TrendingUp, BarChart3, Clock, Users, Award, Gem } from 'lucide-astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import lineIcon from '@/assets/line-icon.png'
import JPComplianceFooter from '../../../common/JPComplianceFooter.astro'

export const getStaticPaths = (() => {
  return [
    { params: { people: '三橋貴明', version: '0' }, props: { name: '三橋貴明', img_prefix: 'sq5_' } },
    { params: { people: '小谷真生子', version: '0' }, props: { name: 'こたに まおこ', img_prefix: 'zsz1_' } },
    { params: { people: '桐谷広人', version: '0' }, props: { name: '桐谷広人', img_prefix: 'tg_' } },
    { params: { people: '高橋洋一', version: '0' }, props: { name: '高橋洋一', img_prefix: 'gqyy_' } },
    { params: { people: '大前研一', version: '0' }, props: { name: '大前研一', img_prefix: 'dqyy_' } },
    { params: { people: '前澤友作', version: '0' }, props: { name: '前澤友作', img_prefix: 'qzyz_' } },
    { params: { people: '通版', version: '1' }, props: { name: '急騰銘柄研究所', img_prefix: 'common1_' } },
    { params: { people: '通版', version: '2' }, props: { name: '急騰銘柄研究所', img_prefix: 'common2_' } },
    { params: { people: '通版', version: '3' }, props: { name: '急騰銘柄研究所', img_prefix: 'common3_' } },
    { params: { people: '通版', version: '4' }, props: { name: '急騰銘柄研究所', img_prefix: 'common4_' } },
    { params: { people: '通版', version: '5' }, props: { name: '急騰銘柄研究所', img_prefix: 'common5_' } },
  ]
}) satisfies GetStaticPaths

const { name: people, img_prefix } = Astro.props

const headImage = await import(`../../shared-images/static/${img_prefix}head.jpg`)
const headerImage = await import(`../../shared-images/static/${img_prefix}header.png`)
const contentImage = await import(`../../shared-images/static/${img_prefix}img.png`)
---

<BaseLayout title={`${people}のエレガント投資法 | 美しく賢く資産を増やす`} description={`上品で洗練された投資スタイルで資産を形成`}>
  <style>
    @keyframes sparkle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }
    @keyframes float-elegant {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-10px) rotate(5deg); }
    }
    @keyframes gradient-flow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .animate-sparkle { animation: sparkle 2s ease-in-out infinite; }
    .animate-float-elegant { animation: float-elegant 4s ease-in-out infinite; }
    .purple-gradient {
      background: linear-gradient(-45deg, #a855f7, #ec4899, #f472b6, #c084fc);
      background-size: 400% 400%;
      animation: gradient-flow 15s ease infinite;
    }
    
    /* 移动端文字大小优化 */
    @media (max-width: 768px) {
      .text-5xl { font-size: 2rem; line-height: 2.5rem; }
      .text-4xl { font-size: 1.75rem; line-height: 2rem; }
      .text-3xl { font-size: 1.5rem; line-height: 1.75rem; }
      .text-2xl { font-size: 1.25rem; line-height: 1.5rem; }
      h1 { font-size: 2rem !important; line-height: 2.5rem !important; }
      h2 { font-size: 1.75rem !important; line-height: 2rem !important; }
      h3 { font-size: 1.5rem !important; line-height: 1.75rem !important; }
    }
    /* ===== Safe area for bottom CTA (Overrides for JPComplianceFooter) ===== */
  .jp-compliance-footer {
    padding-bottom: 100px !important;
  }
</style>

  <!-- Hero Section - 优雅紫色风格 -->
  <section class="purple-gradient text-white relative overflow-hidden min-h-screen flex items-center">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    
    <div class="max-w-4xl mx-auto px-4 py-20 relative z-10 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-white/20 backdrop-blur-md rounded-full text-sm font-medium mb-6 border border-white/30">
        <Sparkles size={16} class="mr-2 animate-sparkle" /> エレガントな投資で未来を創る
      </div>
      
      <div class="w-32 h-32 mx-auto mb-8 rounded-full overflow-hidden border-4 border-white/50 shadow-2xl animate-float-elegant">
        <Image
          src={headImage.default}
          alt={people}
          width={128}
          height={128}
          class="w-full h-full object-cover"
        />
      </div>
      
      <h1 class="text-5xl md:text-6xl font-black mb-6 leading-tight">
        <span class="block text-white mb-2">{people}が提案する</span>
        <span class="block text-pink-200">エレガント投資法</span>
      </h1>
      
      <div class="text-2xl md:text-3xl font-bold mb-6 text-pink-100">
        上品に賢く<span class="text-white text-2xl md:text-4xl">資産3.5倍</span>を実現
      </div>
      
      <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 mb-8 border border-white/20">
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <div class="text-2xl md:text-3xl font-black text-pink-200">+378%</div>
            <div class="text-sm text-white/80">平均収益率</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-black text-pink-200">97.3%</div>
            <div class="text-sm text-white/80">成功率</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-black text-pink-200">7,234</div>
            <div class="text-sm text-white/80">参加者数</div>
          </div>
        </div>
      </div>
      
      <div class="bg-pink-400 text-purple-900 p-4 rounded-xl mb-6 inline-flex items-center font-bold shadow-lg">
        <Clock size={20} class="mr-2" />
        <span>限定公開残り: <span id="countdown" class="text-2xl">02:15</span></span>
      </div>
      
      <button
        class="link-btn w-full max-w-md px-10 py-6 bg-white text-purple-900 rounded-2xl hover:bg-pink-100 transition-all duration-300 transform hover:scale-105 shadow-2xl text-xl font-black"
        data-umami-event="contact"
        data-umami-event-method="line"
        data-umami-event-position="hero"
        data-umami-event-instructor={people}
      >
        <div class="flex items-center justify-center">
          <Image src={lineIcon} alt="LINE" width={28} height={28} class="mr-3" />
          <span>エレガント投資法を無料受取</span>
        </div>
      </button>
      
      <p class="text-white/80 mt-6 text-sm">✨ 完全無料 ✨ 登録30秒 ✨ いつでも退出OK</p>
    </div>
  </section>

  <!-- Elegant Investment Section -->
  <section class="py-20 px-4 bg-gradient-to-b from-purple-50 via-pink-50 to-purple-50">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-bold mb-4">
          <Gem size={16} class="mr-2" />エレガントな投資スタイル
        </span>
        <h2 class="text-2xl md:text-4xl font-bold text-slate-900 mb-4">なぜ<span class="text-purple-600">エレガント投資</span>が選ばれるのか？</h2>
        <p class="text-lg text-slate-600">上品で洗練された投資スタイルで、美しく資産を増やす</p>
      </div>
      
      <div class="mb-8 text-center">
        <Image
          src={headerImage.default}
          alt="エレガント投資"
          width={400}
          height={240}
          class="mx-auto rounded-xl shadow-xl border-2 border-purple-200"
        />
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-8 rounded-2xl shadow-lg border-2 border-purple-200">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl mx-auto mb-4 flex items-center justify-center">
            <Heart size={32} class="text-white" />
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-slate-900">上品な投資スタイル</h3>
          <p class="text-slate-600 text-center text-sm leading-relaxed">リスクを最小限に抑えながら、安定した収益を実現。上品で洗練された投資スタイル</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg border-2 border-pink-200">
          <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-purple-500 rounded-2xl mx-auto mb-4 flex items-center justify-center">
            <Star size={32} class="text-white" />
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-slate-900">バランスの取れたポートフォリオ</h3>
          <p class="text-slate-600 text-center text-sm leading-relaxed">多様な資産クラスに分散投資し、リスクを分散しながら安定した成長を実現</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-lg border-2 border-purple-200">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl mx-auto mb-4 flex items-center justify-center">
            <Moon size={32} class="text-white" />
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-slate-900">長期的な視点</h3>
          <p class="text-slate-600 text-center text-sm leading-relaxed">短期的な変動に一喜一憂せず、長期的な視点で資産を育てる投資哲学</p>
        </div>
      </div>
      
      <div class="bg-gradient-to-r from-purple-600 to-pink-600 text-white p-10 rounded-2xl shadow-xl">
        <div class="text-center">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">エレガント投資の実績</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            <div>
              <div class="text-2xl md:text-4xl font-black text-pink-200 mb-2">+378%</div>
              <div class="text-sm text-purple-100">平均収益率</div>
            </div>
            <div>
              <div class="text-2xl md:text-4xl font-black text-pink-200 mb-2">90日</div>
              <div class="text-sm text-purple-100">平均達成期間</div>
            </div>
            <div>
              <div class="text-2xl md:text-4xl font-black text-pink-200 mb-2">97.3%</div>
              <div class="text-sm text-purple-100">成功率</div>
            </div>
            <div>
              <div class="text-2xl md:text-4xl font-black text-pink-200 mb-2">7,234</div>
              <div class="text-sm text-purple-100">参加者数</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="inline-flex items-center px-4 py-2 bg-pink-100 text-pink-700 rounded-full text-sm font-bold mb-4">
          <Heart size={16} class="mr-2" />投資哲学
        </span>
        <h2 class="text-2xl md:text-4xl font-bold text-slate-900 mb-4">エレガント投資の<span class="text-purple-600">3つの原則</span></h2>
      </div>
      
      <div class="space-y-6">
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 p-8 rounded-2xl shadow-md border-l-4 border-purple-500">
          <div class="flex items-start">
            <Heart size={24} class="text-purple-500 mr-4 flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">美しさと実用性の両立</h3>
              <p class="text-slate-600 leading-relaxed">投資は単なる利益追求ではなく、人生を豊かにするための手段。美しく、上品に、そして賢く資産を増やすことが重要です。</p>
            </div>
          </div>
        </div>
        
        <div class="bg-gradient-to-r from-pink-50 to-purple-50 p-8 rounded-2xl shadow-md border-l-4 border-pink-500">
          <div class="flex items-start">
            <Star size={24} class="text-pink-500 mr-4 flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">リスク管理の重要性</h3>
              <p class="text-slate-600 leading-relaxed">大きな利益を追求するのではなく、リスクを適切に管理しながら、安定した成長を実現することが長期的な成功につながります。</p>
            </div>
          </div>
        </div>
        
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 p-8 rounded-2xl shadow-md border-l-4 border-purple-500">
          <div class="flex items-start">
            <Moon size={24} class="text-purple-500 mr-4 flex-shrink-0 mt-1" />
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">長期的な視点</h3>
              <p class="text-slate-600 leading-relaxed">短期的な変動に一喜一憂せず、長期的な視点で資産を育てる。これがエレガント投資の本質です。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Stories -->
  <section class="py-20 px-4 bg-gradient-to-br from-purple-50 to-pink-50">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm font-bold mb-4">
          <Users size={16} class="mr-2" />参加者の声
        </span>
        <h2 class="text-2xl md:text-4xl font-bold text-slate-900 mb-4">エレガント投資で<span class="text-purple-600">人生が変わった</span>人々</h2>
      </div>
      
      <div class="space-y-6">
        <div class="bg-white p-8 rounded-2xl border-2 border-purple-200 shadow-lg">
          <div class="flex items-start mb-4">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-2xl mr-4">山</div>
            <div class="flex-1">
              <p class="font-bold text-slate-900 text-lg mb-1">山田様 (デザイナー・35歳)</p>
              <p class="text-purple-600 font-bold mb-3">収益: +378% (資産4.78倍) - 90日間</p>
              <p class="text-slate-700 italic leading-relaxed">
                「{people}さんのエレガント投資法は、まさに私が求めていた投資スタイルでした。上品で洗練された方法で、90日で資産が4.78倍になりました。リスクを抑えながら、安定した成長を実現できて本当に満足しています。」
              </p>
              <div class="flex items-center mt-3 text-yellow-500">
                ⭐⭐⭐⭐⭐ <span class="ml-2 text-slate-600 text-sm">5つ星評価</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-white p-8 rounded-2xl border-2 border-pink-200 shadow-lg">
          <div class="flex items-start mb-4">
            <div class="w-16 h-16 bg-gradient-to-br from-pink-500 to-purple-500 rounded-full flex items-center justify-center text-white font-bold text-2xl mr-4">鈴</div>
            <div class="flex-1">
              <p class="font-bold text-slate-900 text-lg mb-1">鈴木様 (主婦・42歳)</p>
              <p class="text-pink-600 font-bold mb-3">収益: +356% (資産4.56倍) - 85日間</p>
              <p class="text-slate-700 italic leading-relaxed">
                「投資は難しいものだと思っていましたが、{people}さんの方法なら上品に、そして安心して資産を増やすことができました。85日で資産が4.56倍になり、356%のリターンを獲得。本当に感謝しています。」
              </p>
              <div class="flex items-center mt-3 text-yellow-500">
                ⭐⭐⭐⭐⭐ <span class="ml-2 text-slate-600 text-sm">5つ星評価</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 px-4 purple-gradient text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="absolute inset-0 opacity-20" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.1\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="text-2xl md:text-5xl font-black mb-6">
        あなたも<span class="text-pink-200">エレガント投資</span>で未来を創りませんか？
      </h2>
      
      <p class="text-xl mb-8 text-purple-50 leading-relaxed">
        {people}が提案するエレガント投資法で、<span class="text-pink-200 font-bold">上品に賢く資産を3.5倍</span>に増やすことが可能です。<br>
        <span class="text-pink-200 font-bold">今なら完全無料</span>でこの投資法を公開中です。
      </p>
      
      <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl mb-8 border border-white/30 inline-block">
        <div class="flex items-center justify-center mb-2">
          <Clock size={24} class="mr-2 text-pink-200" />
          <p class="text-2xl font-black text-pink-200">本日23:59まで限定公開</p>
        </div>
        <p class="text-sm text-purple-50">明日からは有料プランのみ（月額40万円）</p>
      </div>

      <button
        class="link-btn inline-flex items-center px-10 py-6 bg-white text-purple-900 rounded-2xl hover:bg-pink-100 transition-all duration-300 transform hover:scale-105 shadow-2xl text-xl font-black mb-6"
        data-umami-event="contact"
        data-umami-event-method="line"
        data-umami-event-position="final-cta"
        data-umami-event-instructor={people}
      >
        <Sparkles size={24} class="mr-2" />
        <span>今すぐエレガント投資法を無料受取</span>
      </button>
      
      <div class="text-center space-y-2">
        <p class="text-pink-200 text-sm font-bold">✨ 登録者数：7,234名突破</p>
        <p class="text-pink-100 text-sm font-bold">✨ 満足度：98.5%</p>
        <p class="text-pink-200 text-sm font-bold">✨ 平均収益率：+378%（資産4.78倍）</p>
      </div>
    </div>
  </section>

  <!-- Fixed Bottom CTA Button -->
  <div class="fixed-bottom-cta">
    <button
      class="link-btn fixed-cta-btn inline-flex items-center justify-center px-6 py-4 bg-white text-purple-900 rounded-2xl hover:bg-pink-100 transition-all duration-300 transform hover:scale-105 shadow-2xl text-lg font-black"
      data-umami-event="contact"
      data-umami-event-method="line"
      data-umami-event-position="fixed-bottom"
      data-umami-event-instructor={people}
    >
      <Sparkles size={20} class="mr-2" />
      <span>エレガント投資法を無料受取</span>
    </button>
  </div>
  <JPComplianceFooter />
</BaseLayout>

<style>
  .fixed-bottom-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 16px 24px;
    padding-top: 40px;
  }

  .fixed-cta-btn {
    width: 100%;
    max-width: 480px;
    font-size: 17px;
    padding: 18px 36px;
  }

  @media (max-width: 768px) {
    .fixed-bottom-cta {
      padding: 12px 16px;
      padding-top: 30px;
    }
    .fixed-cta-btn {
      font-size: 15px;
      padding: 16px 24px;
    }
  }
</style>

<script>
  function initCountdown() {
    const storageKey = 'countdown_start_time';
    let startTime: number;
    const stored = localStorage.getItem(storageKey);
    
    if (!stored) {
      startTime = new Date().getTime();
      localStorage.setItem(storageKey, startTime.toString());
    } else {
      startTime = parseInt(stored, 10);
    }
    
    const countdownDuration = 135 * 1000;
    const endTime = startTime + countdownDuration;
    
    function updateCountdown() {
      const now = new Date().getTime();
      const distance = endTime - now;
      
      if (distance < 0) {
        const countdownElements = document.querySelectorAll('[id="countdown"], .countdown-timer');
        countdownElements.forEach(element => {
          element.innerHTML = "00:00";
        });
        return;
      }
      
      const minutes = Math.floor(distance / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      
      const timeString = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      
      const countdownElements = document.querySelectorAll('[id="countdown"], .countdown-timer');
      countdownElements.forEach(element => {
        element.innerHTML = timeString;
      });
    }
    
    setInterval(updateCountdown, 1000);
    updateCountdown();
  }
  
  initCountdown();
</script>

