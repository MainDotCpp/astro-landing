import lineIcon from '@/assets/line-icon.png'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = (() => {
  return [
    { params: { people: '三橋貴明', version: '0' }, props: { name: '三橋貴明', img_prefix: 'sq5_' } },
    { params: { people: '小谷真生子', version: '0' }, props: { name: 'こたに まおこ', img_prefix: 'zsz1_' } },
    { params: { people: '通版', version: '1' }, props: { name: '急騰銘柄研究所', img_prefix: 'common1_' } },
    { params: { people: '通版', version: '2' }, props: { name: '急騰銘柄研究所', img_prefix: 'common2_' } },
    { params: { people: '通版', version: '3' }, props: { name: '急騰銘柄研究所', img_prefix: 'common3_' } },
    { params: { people: '通版', version: '4' }, props: { name: '急騰銘柄研究所', img_prefix: 'common4_' } },
    { params: { people: '通版', version: '5' }, props: { name: '急騰銘柄研究所', img_prefix: 'common5_' } },
