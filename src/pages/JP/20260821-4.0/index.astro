---
import JPComplianceFooter from '../common/JPComplianceFooter.astro'
import JPSecurityIcons from '../common/JPSecurityIcons.astro'
import heroBg from './images/hero-bg.png'
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>AI・半導体・高配当テーマ株分析 | 無料LINE配信</title>
<meta name="description" content="AI、半導体、高配当など注目テーマ株を業績と市場環境から分析。LINEで無料配信中。">

<script is:inline>document.documentElement.classList.add('js')</script>

