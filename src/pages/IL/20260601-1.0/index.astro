    <script is:inline>
      // staggered scroll reveal
      (function () {
        const els = Array.from(document.querySelectorAll('.reveal'))
        if (!('IntersectionObserver' in window)) { els.forEach(e => e.classList.add('in')); return }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en, i) => {
            if (en.isIntersecting) {
              const el = en.target
              setTimeout(() => el.classList.add('in'), (Number(el.dataset.d) || 0))
              io.unobserve(el)
            }
          })
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
        // stagger siblings within each grid
        document.querySelectorAll('.card-grid, .who-list, .modules, .hero-grid').forEach(group => {
          Array.from(group.querySelectorAll('.reveal')).forEach((el, i) => { el.dataset.d = i * 90 })
        })
        els.forEach(el => io.observe(el))
      })()
    </script>
