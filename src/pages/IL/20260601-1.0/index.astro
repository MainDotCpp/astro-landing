---
import RedirectCode from '@/components/RedirectCode.astro'
import adWeeklyPhone from './assets/images/ad-weekly-phone.jpg'
import adAiTech from './assets/images/ad-ai-tech.jpg'
import adDashboardTablet from './assets/images/ad-dashboard-tablet.jpg'
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>סקירת שוק שבועית | AI, מניות ארה״ב וטכנולוגיה</title>
    <meta
      name="description"
      content="‏סקירת שוק קצרה למשקיעים בישראל: AI, מניות ארה״ב, טכנולוגיה, גרפים וחדשות שוק — תוכן מידע בלבד."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <style define:vars={{
      heroImg: `url(${adWeeklyPhone.src})`,
      whoImg: `url(${adAiTech.src})`,
      previewImg: `url(${adDashboardTablet.src})`,
    }}>
      :root {
        --bg:        #060B16;
        --bg-soft:   #0A1326;
        --panel:     #0E1A30;
        --panel-2:   #11223F;
        --line:      rgba(120, 165, 215, 0.13);
        --line-soft: rgba(120, 165, 215, 0.07);
        --teal:      #00E6C3;
        --teal-dim:  #0BBFA5;
        --teal-glow: rgba(0, 230, 195, 0.22);
        --gold:      #E2B45F;
        --text:      #EBF1FB;
        --muted:     #93A6C4;
        --muted-2:   #61748F;
        --green:     #2BD67B;
        --red:       #FF6B6B;
        --font:  'Heebo', Arial, 'Noto Sans Hebrew', sans-serif;
        --mono:  'JetBrains Mono', ui-monospace, monospace;
        --maxw:  1180px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        direction: rtl;
        text-align: right;
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* atmospheric background: teal glow + faint tech grid */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -2;
        background:
          radial-gradient(900px 600px at 15% -5%, rgba(0, 230, 195, 0.10), transparent 60%),
          radial-gradient(800px 700px at 100% 10%, rgba(30, 90, 200, 0.14), transparent 60%),
          var(--bg);
      }
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image:
          linear-gradient(var(--line-soft) 1px, transparent 1px),
          linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
        background-size: 54px 54px;
        mask-image: radial-gradient(ellipse 100% 70% at 50% 0%, #000 30%, transparent 80%);
        opacity: 0.7;
      }

      .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: 22px; }

      a { color: inherit; text-decoration: none; }

      /* ===== buttons ===== */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: var(--font);
        font-weight: 800;
        font-size: 1.06rem;
        letter-spacing: -0.01em;
        padding: 16px 30px;
        border-radius: 14px;
        cursor: pointer;
        border: none;
        transition: transform .18s ease, box-shadow .25s ease, background .25s ease;
        white-space: nowrap;
      }
      .btn svg { width: 20px; height: 20px; flex-shrink: 0; }
      .btn-primary {
        background: linear-gradient(135deg, var(--teal) 0%, var(--teal-dim) 100%);
        color: #042019;
        box-shadow: 0 14px 34px -10px var(--teal-glow), inset 0 1px 0 rgba(255,255,255,.35);
      }
      .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 20px 42px -10px var(--teal-glow); }
      .btn-wa {
        background: #25D366;
        color: #04220F;
        box-shadow: 0 14px 34px -12px rgba(37, 211, 102, .5);
      }
      .btn-wa:hover { transform: translateY(-2px); }
      .btn-ghost {
        background: rgba(255,255,255,.04);
        color: var(--text);
        border: 1px solid var(--line);
      }
      .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }
      .cta-pulse { animation: ctaPulse 2.4s ease-in-out infinite; }
      @keyframes ctaPulse {
        0%,100% { box-shadow: 0 14px 34px -10px var(--teal-glow), inset 0 1px 0 rgba(255,255,255,.35); }
        50%     { box-shadow: 0 14px 46px -6px var(--teal-glow), inset 0 1px 0 rgba(255,255,255,.35); }
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: .74rem;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--teal);
      }
      .eyebrow .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 4px var(--teal-glow);
        animation: blink 1.8s ease-in-out infinite;
      }
      @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.4} }

      .teal { color: var(--teal); }

      /* ===== header ===== */
      .site-head {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(6, 11, 22, .72);
        border-bottom: 1px solid var(--line-soft);
      }
      .site-head .wrap {
        display: flex; align-items: center; justify-content: space-between;
        height: 64px;
      }
      .brand { display: inline-flex; align-items: center; gap: 11px; font-weight: 900; font-size: 1.16rem; letter-spacing: -.02em; }
      .brand .mark {
        width: 34px; height: 34px; border-radius: 9px;
        display: grid; place-items: center;
        background: linear-gradient(135deg, rgba(0,230,195,.18), rgba(0,230,195,.04));
        border: 1px solid rgba(0,230,195,.35);
      }
      .brand .mark svg { width: 19px; height: 19px; color: var(--teal); }
      .head-cta { font-size: .92rem; padding: 9px 18px; }

      /* ===== sections ===== */
      section { position: relative; }
      .sec-pad { padding-block: clamp(56px, 9vw, 104px); }
      .sec-head { max-width: 660px; margin-bottom: 44px; }
      h1, h2, h3 { letter-spacing: -0.025em; line-height: 1.12; font-weight: 900; }
      h2 { font-size: clamp(1.7rem, 4.4vw, 2.55rem); margin-top: 14px; }
      .lead { color: var(--muted); font-size: clamp(1rem, 2.4vw, 1.14rem); margin-top: 16px; }

      /* ===== HERO ===== */
      .hero { padding-top: clamp(40px, 6vw, 70px); padding-bottom: clamp(50px, 8vw, 96px); }
      .hero-grid {
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: clamp(28px, 5vw, 64px);
        align-items: center;
      }
      .hero h1 {
        font-size: clamp(2.1rem, 6.2vw, 3.5rem);
        margin: 18px 0 0;
      }
      .hero h1 .hl { color: var(--teal); }
      .hero .lead { max-width: 540px; }
      .hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 32px; }
      .hero-actions .fineprint { font-size: .82rem; color: var(--muted-2); max-width: 460px; line-height: 1.5; }

      .hero-visual { position: relative; }
      .hero-visual .frame {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid var(--line);
        background-image: var(--heroImg);
        background-size: cover;
        background-position: center;
        aspect-ratio: 1024 / 1280;
        box-shadow: 0 40px 90px -30px rgba(0,0,0,.8), 0 0 0 1px rgba(0,230,195,.06);
      }
      .hero-visual .frame::after {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(180deg, transparent 55%, rgba(6,11,22,.55) 100%);
      }
      .float-chip {
        position: absolute;
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(14, 26, 48, .82);
        backdrop-filter: blur(8px);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 10px 14px;
        font-size: .82rem; font-weight: 700;
        box-shadow: 0 18px 40px -16px rgba(0,0,0,.7);
        animation: floaty 5s ease-in-out infinite;
      }
      .float-chip .lbl { color: var(--muted); font-weight: 600; }
      .float-chip svg { width: 17px; height: 17px; color: var(--teal); }
      .float-chip.tl { top: 8%; left: -16px; }
      .float-chip.bl { bottom: 13%; left: -22px; animation-delay: 1.6s; }
      @keyframes floaty { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-9px) } }

      .ticker-row { display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:30px; }
      .ticker {
        display:inline-flex; align-items:center; gap:7px;
        font-family: var(--mono); font-size:.8rem; font-weight:700; color: var(--muted);
      }
      .ticker b { color: var(--text); }
      .ticker .pip { width:6px; height:6px; border-radius:50%; background: var(--teal); }

      /* ===== CARDS (what's included) ===== */
      .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
      .card {
        background: linear-gradient(180deg, var(--panel) 0%, rgba(14,26,48,.55) 100%);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 26px 24px 28px;
        transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
      }
      .card:hover { transform: translateY(-5px); border-color: rgba(0,230,195,.4); box-shadow: 0 26px 50px -26px rgba(0,0,0,.7); }
      .card .ico {
        width: 50px; height: 50px; border-radius: 13px;
        display: grid; place-items: center; margin-bottom: 18px;
        background: var(--teal-glow);
        border: 1px solid rgba(0,230,195,.3);
      }
      .card .ico svg { width: 25px; height: 25px; color: var(--teal); }
      .card h3 { font-size: 1.18rem; font-weight: 800; margin-bottom: 9px; }
      .card p { color: var(--muted); font-size: .95rem; line-height: 1.6; }

      /* ===== WHO IS IT FOR ===== */
      .who-grid {
        display: grid; grid-template-columns: 0.85fr 1.15fr;
        gap: clamp(28px, 5vw, 60px); align-items: center;
      }
      .who-visual {
        border-radius: 20px; overflow: hidden;
        border: 1px solid var(--line);
        background-image: var(--whoImg);
        background-size: cover; background-position: center;
        aspect-ratio: 1024 / 1280;
        box-shadow: 0 36px 80px -34px rgba(0,0,0,.8);
      }
      .who-list { list-style: none; display: flex; flex-direction: column; gap: 14px; margin-top: 26px; }
      .who-list li {
        display: flex; align-items: flex-start; gap: 14px;
        background: rgba(255,255,255,.022);
        border: 1px solid var(--line-soft);
        border-radius: 13px; padding: 15px 18px;
        font-size: 1.04rem; font-weight: 500;
      }
      .who-list li:hover { border-color: var(--line); }
      .who-list .chk {
        width: 26px; height: 26px; flex-shrink: 0; border-radius: 8px;
        display: grid; place-items: center;
        background: var(--teal-glow); border: 1px solid rgba(0,230,195,.35);
      }
      .who-list .chk svg { width: 15px; height: 15px; color: var(--teal); }

      /* ===== PREVIEW (briefing sample) ===== */
      .preview-sec { background: linear-gradient(180deg, transparent, rgba(10,19,38,.6)); border-block: 1px solid var(--line-soft); }
      .preview-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(26px, 4vw, 52px); align-items: stretch; }
      .preview-visual {
        position: relative; border-radius: 18px; overflow: hidden;
        border: 1px solid var(--line);
        background-image: var(--previewImg);
        background-size: cover; background-position: center;
        min-height: 340px;
        box-shadow: 0 36px 80px -36px rgba(0,0,0,.8);
      }
      .preview-tag {
        position: absolute; inset-inline-start: 16px; top: 16px;
        background: rgba(6,11,22,.78); backdrop-filter: blur(8px);
        border: 1px solid var(--line); border-radius: 10px;
        padding: 7px 13px; font-size: .76rem; font-weight: 700; letter-spacing: .04em;
        display: inline-flex; align-items: center; gap: 8px;
      }
      .preview-tag .dot { width:6px; height:6px; border-radius:50%; background: var(--teal); box-shadow: 0 0 0 4px var(--teal-glow); }
      .modules { display: flex; flex-direction: column; gap: 16px; }
      .module {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px; padding: 22px 24px;
        position: relative; overflow: hidden;
      }
      .module::before {
        content: ''; position: absolute; inset-inline-start: 0; top: 0; bottom: 0;
        width: 4px; background: linear-gradient(var(--teal), var(--teal-dim));
      }
      .module .mhead { display: flex; align-items: center; gap: 11px; margin-bottom: 8px; }
      .module .mhead .mi { width: 34px; height: 34px; border-radius: 9px; display:grid; place-items:center; background: var(--teal-glow); border:1px solid rgba(0,230,195,.28); }
      .module .mhead .mi svg { width:18px; height:18px; color: var(--teal); }
      .module h3 { font-size: 1.1rem; font-weight: 800; }
      .module p { color: var(--muted); font-size: .94rem; }

      /* ===== CONVERSION ===== */
      .convert {
        background:
          radial-gradient(700px 380px at 80% 0%, rgba(0,230,195,.12), transparent 60%),
          var(--bg-soft);
        border-radius: 26px;
        border: 1px solid var(--line);
        padding: clamp(34px, 5vw, 60px);
        display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 4vw, 56px);
        align-items: start;
      }
      .convert .lead { max-width: 460px; }
      .convert-actions { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 28px; }
      .trust-line { display:flex; align-items:center; gap:9px; margin-top:20px; font-size:.85rem; color: var(--muted); }
      .trust-line svg { width:17px; height:17px; color: var(--teal); flex-shrink:0; }

      .lead-form {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px; padding: 26px 24px;
      }
      .field { margin-bottom: 18px; }
      .field > label { display:block; font-size:.86rem; font-weight:700; color: var(--text); margin-bottom: 9px; }
      .field input, .field select {
        width: 100%; font-family: var(--font); font-size: .98rem;
        background: rgba(6,11,22,.6); color: var(--text);
        border: 1px solid var(--line); border-radius: 11px;
        padding: 13px 15px; outline: none; transition: border-color .2s ease;
        text-align: right;
      }
      .field input::placeholder { color: var(--muted-2); }
      .field input:focus, .field select:focus { border-color: var(--teal); }
      .chip-group { display:flex; flex-wrap:wrap; gap:9px; }
      .chip-opt { position: relative; }
      .chip-opt input { position:absolute; opacity:0; pointer-events:none; }
      .chip-opt label {
        display:inline-block; cursor:pointer;
        font-size:.88rem; font-weight:600;
        padding: 9px 15px; border-radius: 999px;
        background: rgba(255,255,255,.03); border:1px solid var(--line); color: var(--muted);
        transition: all .18s ease;
      }
      .chip-opt input:checked + label { background: var(--teal-glow); border-color: var(--teal); color: var(--teal); }
      .form-note { font-size: .78rem; color: var(--muted-2); margin-top: 4px; line-height:1.5; }
      .lead-form .btn { width: 100%; margin-top: 6px; }

      /* ===== footer / disclaimer ===== */
      .disclaimer { border-top: 1px solid var(--line-soft); }
      .disclaimer p {
        max-width: 880px; margin-inline: auto;
        color: var(--muted-2); font-size: .85rem; line-height: 1.7; text-align: center;
      }
      .foot {
        border-top: 1px solid var(--line-soft);
        padding-block: 26px;
        display:flex; flex-wrap:wrap; gap:14px 22px; align-items:center; justify-content:space-between;
        font-size:.82rem; color: var(--muted-2);
      }
      .foot-links { display:flex; gap:20px; }
      .foot-links a:hover { color: var(--teal); }

      /* ===== sticky mobile CTA ===== */
      .sticky-cta {
        position: fixed; bottom: 0; inset-inline: 0; z-index: 60;
        display: none;
        padding: 11px 14px calc(11px + env(safe-area-inset-bottom));
        background: rgba(6,11,22,.92);
        backdrop-filter: blur(14px);
        border-top: 1px solid var(--line);
      }
      .sticky-cta .btn { width: 100%; padding: 15px; }

      /* ===== reveal animation ===== */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
      .reveal.in { opacity: 1; transform: none; }

      /* ===== responsive ===== */
      @media (max-width: 980px) {
        .card-grid { grid-template-columns: repeat(2, 1fr); }
        .hero-grid, .who-grid, .preview-grid, .convert { grid-template-columns: 1fr; }
        .who-visual { order: 2; aspect-ratio: 16/10; }
        .hero-visual { max-width: 420px; margin-inline: auto; width: 100%; }
        .float-chip.tl { left: 4px; } .float-chip.bl { left: 6px; }
        .convert { gap: 30px; }
      }
      @media (max-width: 560px) {
        .card-grid { grid-template-columns: 1fr; }
        .head-cta { display: none; }
        .sticky-cta { display: block; }
        body { padding-bottom: 78px; }
        .convert-actions .btn { width: 100%; }
        .float-chip { font-size: .76rem; padding: 8px 11px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { transition: none; opacity: 1; transform: none; }
        .cta-pulse, .float-chip, .eyebrow .dot { animation: none; }
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body>
    <!-- ===================== HEADER ===================== -->
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="#top">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 17l5-5 4 3 6-7" /><path d="M14 8h4v4" />
            </svg>
          </span>
          <span>מבט שוק</span>
        </a>
        <a class="btn btn-primary head-cta link-btn" onclick="mixinJump()">קבלו את הסקירה</a>
      </div>
    </header>

    <main id="top">
      <!-- ===================== 1 · HERO ===================== -->
      <section class="hero wrap">
        <div class="hero-grid">
          <div class="hero-copy reveal">
            <span class="eyebrow"><span class="dot"></span>סקירת שוק · מידע בלבד</span>
            <h1>
              סקירת שוק שבועית:
              <span class="hl">AI</span>, <span class="hl">מניות ארה״ב</span> וטכנולוגיה
            </h1>
            <p class="lead">
              גרפים, חדשות ותובנות שוק שיעזרו להבין את התמונה הרחבה — בלי הבטחות, בלי רעש, רק מבט ברור יותר על מה שקורה בשווקים.
            </p>

            <div class="ticker-row">
              <span class="ticker"><span class="pip"></span>S&amp;P 500</span>
              <span class="ticker"><span class="pip"></span>NASDAQ 100</span>
              <span class="ticker"><span class="pip"></span>DOW JONES</span>
              <span class="ticker"><span class="pip"></span>AI &amp; Semis</span>
            </div>

            <div class="hero-actions">
              <a class="btn btn-primary cta-pulse link-btn" onclick="mixinJump()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l-6 6 6 6"/></svg>
                קבלו את הסקירה
              </a>
              <p class="fineprint">תוכן מידע ושוק בלבד. אינו מותאם אישית ואינו מהווה המלצה לפעולה.</p>
            </div>
          </div>

          <div class="hero-visual reveal">
            <div class="frame"></div>
            <span class="float-chip tl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 14l3-3 2 2 4-5"/></svg>
              <span><span class="lbl">נתונים בזמן אמת</span></span>
            </span>
            <span class="float-chip bl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/></svg>
              <span>AI &amp; <span class="lbl">טכנולוגיה</span></span>
            </span>
          </div>
        </div>
      </section>

      <!-- ===================== 2 · WHAT'S INCLUDED ===================== -->
      <section class="sec-pad wrap">
        <div class="sec-head reveal">
          <span class="eyebrow"><span class="dot"></span>תוכן הסקירה</span>
          <h2>מה כוללת הסקירה?</h2>
        </div>
        <div class="card-grid">
          <article class="card reveal">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4a1 1 0 0 1 1-1h11l4 4v15a1 1 0 0 1-1 1z"/><path d="M16 3v4h4M8 11h8M8 15h8M8 19h5"/></svg></div>
            <h3>חדשות שוק</h3>
