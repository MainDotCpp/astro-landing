---
import RedirectCode from '@/components/RedirectCode.astro'
import heroPerson from './assets/images/hero-person.png'
import heroPhone from './assets/images/hero-phone.png'
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>מניה לפני זינוק — קבלו את קוד המניה בבורסת תל אביב בחינם</title>
    <meta name="description" content="‏מניה הנסחרת בבורסת תל אביב במחיר של כ-14 ₪ צפויה לעלות. קבלו את קוד המניה בחינם ועקבו אחרי הניתוח היומי יחד עם הקהילה שלנו." />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              navy: '#0B2A5B',
              ink: '#0A1F44',
              flame: '#FB4516',
              blue: '#1E6BFF',
              blueDark: '#0A4FD0',
              mute: '#5A6B86',
            },
            fontFamily: {
              sans: ['"Heebo"', 'system-ui', 'sans-serif'],
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
      body {
        font-family: 'Heebo', system-ui, sans-serif;
        background: linear-gradient(180deg, #FFFFFF 0%, #EEF4FF 100%);
        background-attachment: fixed;
        color: #0A1F44;
      }

      @keyframes ctaPulse {
        0%, 100% { transform: translateY(0); box-shadow: 0 14px 30px -8px rgba(30, 107, 255, 0.55); }
        50%      { transform: translateY(-3px); box-shadow: 0 20px 38px -8px rgba(30, 107, 255, 0.65); }
      }
      .cta-pulse { animation: ctaPulse 1.9s ease-in-out infinite; }
    </style>
  </head>

  <body class="min-h-screen flex flex-col">

    <main class="flex-1">

      <!-- ===== מסך 1 — HERO ===== -->
      <section class="max-w-6xl mx-auto w-full px-6 pt-10 md:pt-16 pb-12 grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-center">

        <!-- copy -->
        <div class="order-2 lg:order-1 text-right">
          <p class="inline-flex items-center gap-2 text-[11px] md:text-xs uppercase tracking-[0.18em] text-blue font-700 mb-5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-flame animate-pulse"></span>
            איתות בבורסה · פורסם היום
          </p>

          <h1 class="font-800 text-navy text-[2rem] leading-[1.1] md:text-[2.9rem] md:leading-[1.05] mb-4">
            מניה בבורסת תל אביב מתחת ל-15 ₪ נתנה אות קנייה נדיר
          </h1>

          <p class="text-mute text-[15px] md:text-lg leading-relaxed mb-7 max-w-[480px] me-auto">
            השם נשאר חסוי — אבל <span class="font-700 text-navy">קוד המניה מתפרסם בחינם</span>
            בקבוצה שלנו היום. הנה לאן האנליסטים שלנו צופים שהיא מועדת.
          </p>

          <!-- price predictions (credible range) -->
          <div class="space-y-3 mb-6 max-w-[440px] me-auto">
            <div class="flex items-center gap-3 justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">נסחרת כעת</span>
              <span class="font-800 text-navy text-xl md:text-2xl">‏14.20 ₪</span>
            </div>
            <div class="flex items-center gap-3 justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">יעד ל-30 יום</span>
              <span class="font-800 text-flame text-xl md:text-2xl">‏22.40 ₪</span>
              <span class="text-xs font-700 text-flame bg-flame/10 rounded-full px-2 py-0.5">‎+58%‎</span>
            </div>
            <div class="flex items-center gap-3 justify-start">
              <span class="text-mute text-sm font-500 shrink-0 w-[130px] text-right">יעד ל-12 שבועות</span>
              <span class="font-800 text-flame text-xl md:text-2xl">‏28.40 ₪</span>
              <span class="text-xs font-700 text-flame bg-flame/10 rounded-full px-2 py-0.5">‎+100%‎</span>
            </div>
          </div>

          <!-- social proof -->
          <p class="flex items-center gap-2 justify-start text-sm text-navy font-600 mb-5">
            <span class="inline-block w-2 h-2 rounded-full bg-green-500 animate-pulse shrink-0"></span>
            <span><span class="font-800">9,200+</span> משקיעים ישראלים בפנים · <span class="font-800">274</span> הצטרפו היום</span>
          </p>

          <div class="flex flex-col items-start gap-3">
            <a
              onclick="onLinkBtnClick()"
              class="link-btn cta-pulse inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-blue to-blueDark text-white font-800 text-base md:text-lg tracking-wide px-9 py-4 md:py-[18px] rounded-full cursor-pointer whitespace-nowrap w-full sm:w-auto"
            >
              <span>קבלו את קוד המניה בחינם</span>
            </a>
            <p class="text-xs text-mute">הקוד מתפרסם בקבוצה היום בלבד · חינם · ללא תשלום · אפשר לצאת בכל רגע</p>
          </div>
        </div>

        <!-- visual -->
        <div class="order-1 lg:order-2">
          <img src={heroPerson.src} alt="אנליסט בוחן גרף מניה עולה על המסך" class="w-full h-auto block select-none pointer-events-none rounded-2xl" />
        </div>
      </section>

      <!-- ===== מסך 1.5 — WHY / TRUST ===== -->
      <section class="bg-white/70 border-t border-blue/10">
        <div class="max-w-5xl mx-auto w-full px-6 py-10 md:py-12">
          <div class="grid lg:grid-cols-2 gap-9 lg:gap-14 items-center">

            <!-- phone proof -->
            <div class="order-1 text-center">
              <img src={heroPhone.src} alt="הפוזיציה של חבר בקבוצה מטפסת בתוך אפליקציית המסחר" class="w-full max-w-[320px] mx-auto h-auto block rounded-2xl shadow-xl shadow-navy/10 select-none pointer-events-none" />
              <p class="mt-3 text-xs text-mute">בתוך הקבוצה — הפוזיציה של אחד החברים בבחירה של השבוע</p>
            </div>

            <!-- stats + cta -->
            <div class="order-2">
              <p class="text-center lg:text-right text-[11px] uppercase tracking-[0.18em] text-mute font-700 mb-6">למה המשקיעים לא מחכים</p>

              <div class="grid grid-cols-3 gap-4 text-center lg:text-right mb-8">
                <div>
                  <div class="font-800 text-navy text-2xl md:text-3xl mb-1 leading-none">9,200<span class="text-flame">+</span></div>
                  <p class="text-mute text-xs">חברים פעילים</p>
                </div>
                <div>
                  <div class="font-800 text-flame text-2xl md:text-3xl mb-1 leading-none">‎+64%‎</div>
                  <p class="text-mute text-xs">ממוצע · 3 הבחירות האחרונות</p>
                </div>
                <div>
                  <div class="font-800 text-navy text-2xl md:text-3xl mb-1 leading-none">היום</div>
                  <p class="text-mute text-xs">פרסום הקוד</p>
                </div>
              </div>

              <div class="flex flex-col items-center lg:items-start gap-3">
                <a
                  onclick="onLinkBtnClick()"
                  class="link-btn inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-blue to-blueDark text-white font-800 text-base md:text-lg tracking-wide px-9 py-4 rounded-full cursor-pointer whitespace-nowrap w-full sm:w-auto shadow-lg shadow-blue/30 hover:opacity-95 transition-opacity"
                >
                  <span>קבלו את הקוד לפני שייעלם</span>
                </a>
                <p class="text-xs text-mute">מוגבל לסשן של היום · חינם · אפשר לצאת בכל רגע</p>
              </div>
            </div>

          </div>
        </div>
      </section>

    </main>

    <footer class="py-5 text-center text-mute text-[11px] px-4">
      © 2026 · תובנות מניות בבורסת תל אביב · תוכן חינוכי בלבד, אינו ייעוץ השקעות. ההון בסיכון.
    </footer>

  </body>
</html>
