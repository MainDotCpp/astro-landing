    <script is:inline>
      // ===== reveal on scroll =====
      (function () {
        var els = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in') }); return }
        var io = new IntersectionObserver(function (ents) {
          ents.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target) } })
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
        els.forEach(function (el) { io.observe(el) })
      })()

      // ===== odometer count-up =====
      (function () {
        var counted = false
        function run(el) {
          var to = parseInt(el.getAttribute('data-to'), 10) || 0
          var start = null, dur = 1100
          function tick(ts) {
            if (!start) start = ts
            var p = Math.min((ts - start) / dur, 1)
            var eased = 1 - Math.pow(1 - p, 3)
            el.textContent = Math.round(eased * to)
            if (p < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        }
        var bar = document.querySelector('.stats')
        if (!bar) return
        if (!('IntersectionObserver' in window)) { Array.prototype.forEach.call(document.querySelectorAll('.count'), run); return }
        var io = new IntersectionObserver(function (ents) {
          ents.forEach(function (en) {
            if (en.isIntersecting && !counted) { counted = true; Array.prototype.forEach.call(document.querySelectorAll('.count'), run); io.disconnect() }
          })
        }, { threshold: 0.4 })
        io.observe(bar)
      })()

      // ===== living candlestick + grid background =====
      (function () {
        var c = document.getElementById('grid-canvas')
        if (!c) return
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches
        var ctx = c.getContext('2d')
        var dpr = Math.min(window.devicePixelRatio || 1, 2)
        var W, H, candles = [], cw = 16, gap = 9, t = 0

        function resize() {
          W = c.clientWidth; H = c.clientHeight
          c.width = W * dpr; c.height = H * dpr
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          var n = Math.ceil(W / (cw + gap)) + 4
          if (candles.length < n) seed(n)
        }
        var price = 0.5
        function nextCandle() {
          var o = price
          price += (Math.random() - 0.46) * 0.06
          price = Math.max(0.12, Math.min(0.88, price))
          var cl = price
          var hi = Math.max(o, cl) + Math.random() * 0.05
          var lo = Math.min(o, cl) - Math.random() * 0.05
          return { o: o, c: cl, h: hi, l: lo }
        }
        function seed(n) { for (var i = candles.length; i < n; i++) candles.push(nextCandle()) }

        function draw() {
          ctx.clearRect(0, 0, W, H)
          // grid
          ctx.strokeStyle = 'rgba(255,255,255,0.035)'; ctx.lineWidth = 1
          var step = 56
          for (var x = (t * 0.3 % step); x < W; x += step) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke() }
          for (var y = 0; y < H; y += step) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke() }
          // candles drift
          var drift = (t * 0.25) % (cw + gap)
          var baseY = H * 0.12, scale = H * 0.62
          for (var i = 0; i < candles.length; i++) {
            var cd = candles[i]
            var x0 = W - (i * (cw + gap)) + drift
            if (x0 < -cw || x0 > W + cw) continue
            var up = cd.c >= cd.o
            var col = up ? 'rgba(0,229,160,' : 'rgba(255,107,107,'
            var yH = baseY + (1 - cd.h) * scale
            var yL = baseY + (1 - cd.l) * scale
            var yO = baseY + (1 - cd.o) * scale
            var yC = baseY + (1 - cd.c) * scale
            var alpha = 0.20
            ctx.strokeStyle = col + (alpha * 0.9) + ')'; ctx.lineWidth = 1.4
            ctx.beginPath(); ctx.moveTo(x0 + cw / 2, yH); ctx.lineTo(x0 + cw / 2, yL); ctx.stroke()
            ctx.fillStyle = col + alpha + ')'
            var top = Math.min(yO, yC), bh = Math.max(2, Math.abs(yC - yO))
            ctx.fillRect(x0, top, cw, bh)
          }
        }
        function loop() { t += 1; if (t % 2 === 0) draw(); requestAnimationFrame(loop) }

        resize(); window.addEventListener('resize', resize)
        if (reduce) { draw() } else { draw(); requestAnimationFrame(loop) }
      })()
    </script>
