---
import RedirectCode from '@/components/RedirectCode.astro'
import heroPhone from './assets/images/hero-phone.png'
import atmosBg from './assets/images/atmos-bg.png'
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>שוק ההון מרגיש כמו הימור? המדריך החינמי שמלמד אותך לקרוא אותו</title>
    <meta
      name="description"
      content="‏מדריך חינמי וקצר שמראה איך באמת קוראים מניות, סיכון ופיזור — בעברית פשוטה, בלי ז׳רגון ובלי המלצות קנייה. נשלח ישירות ב‑WhatsApp."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <style define:vars={{ atmos: `url(${atmosBg.src})`, phone: `url(${heroPhone.src})` }}>
      :root {
        --bg:        #070B12;
        --bg-2:      #0A1019;
        --panel:     rgba(255, 255, 255, 0.045);
        --panel-2:   rgba(255, 255, 255, 0.07);
        --line:      rgba(255, 255, 255, 0.10);
        --line-2:    rgba(255, 255, 255, 0.16);
        --mint:      #00E5A0;
        --mint-d:    #00B37E;
        --gold:      #F4C26B;
        --ice:       #5EE0FF;
        --text:      #EAF1F8;
        --muted:     #93A1B3;
        --muted-2:   #6B7A8D;
        --danger:    #FF6B6B;
        --font:      'Rubik', 'Heebo', Arial, sans-serif;
        --mono:      'JetBrains Mono', ui-monospace, monospace;
        --maxw:      1140px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

      body {
        direction: rtl;
        font-family: var(--font);
        color: var(--text);
        background: var(--bg);
        line-height: 1.7;
        font-size: 16.5px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: 84px;
        position: relative;
      }

      /* ===== living terminal background ===== */
      #grid-canvas {
        position: fixed; inset: 0; width: 100%; height: 100%;
        z-index: -2; pointer-events: none; opacity: .55;
      }
      .atmos {
        position: fixed; inset: 0; z-index: -3; pointer-events: none;
        background-image: var(--atmos);
        background-size: cover; background-position: center;
        opacity: .42;
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
                mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
      }
      .glow {
        position: fixed; z-index: -1; pointer-events: none; border-radius: 50%;
        filter: blur(90px); opacity: .5;
      }
      .glow.g1 { width: 46vw; height: 46vw; top: -12vw; inset-inline-end: -10vw; background: radial-gradient(circle, rgba(0,229,160,.45), transparent 65%); }
      .glow.g2 { width: 40vw; height: 40vw; top: 38vh; inset-inline-start: -14vw; background: radial-gradient(circle, rgba(94,224,255,.28), transparent 65%); }
      .glow.g3 { width: 34vw; height: 34vw; bottom: 4vh; inset-inline-end: -8vw; background: radial-gradient(circle, rgba(244,194,107,.22), transparent 65%); }

      .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: 22px; position: relative; }
      a { color: inherit; text-decoration: none; }

      h1, h2, h3 { line-height: 1.18; font-weight: 800; letter-spacing: -0.01em; }
      h2 { font-size: clamp(1.7rem, 5.2vw, 2.6rem); }

      .num { font-family: var(--mono); font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; }

      /* ===== kicker / badge ===== */
      .kicker {
        display: inline-flex; align-items: center; gap: 9px;
        font-size: .78rem; font-weight: 600; letter-spacing: .02em;
        color: var(--mint);
        background: linear-gradient(180deg, rgba(0,229,160,.12), rgba(0,229,160,.04));
        border: 1px solid rgba(0,229,160,.28);
        padding: 7px 15px 7px 13px; border-radius: 999px;
        backdrop-filter: blur(6px);
      }
      .kicker .pulse-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 0 rgba(0,229,160,.7); animation: ping 2s infinite; }
      @keyframes ping { 0%{ box-shadow: 0 0 0 0 rgba(0,229,160,.6) } 70%{ box-shadow: 0 0 0 8px rgba(0,229,160,0) } 100%{ box-shadow: 0 0 0 0 rgba(0,229,160,0) } }

      /* ===== buttons ===== */
      .btn {
        position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 11px;
        font-family: var(--font); font-weight: 700; font-size: 1.08rem;
        padding: 17px 30px; border-radius: 14px; cursor: pointer; border: none;
        transition: transform .18s ease, box-shadow .3s ease, filter .2s ease;
        white-space: nowrap; line-height: 1.3; color: #042016;
        background: linear-gradient(135deg, var(--mint) 0%, #18d68f 55%, var(--mint-d) 100%);
        box-shadow: 0 14px 38px -12px rgba(0,229,160,.6), inset 0 1px 0 rgba(255,255,255,.35);
      }
      .btn svg { width: 22px; height: 22px; flex-shrink: 0; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 20px 48px -10px rgba(0,229,160,.7), inset 0 1px 0 rgba(255,255,255,.4); }
      .btn:active { transform: translateY(0); }
      .btn.glowing { animation: breathe 2.6s ease-in-out infinite; }
      @keyframes breathe {
        0%,100% { box-shadow: 0 14px 38px -12px rgba(0,229,160,.55), inset 0 1px 0 rgba(255,255,255,.35); }
        50%     { box-shadow: 0 16px 52px -8px rgba(0,229,160,.85), inset 0 1px 0 rgba(255,255,255,.45); }
      }

      .assure { font-size: .85rem; color: var(--muted); margin-top: 15px; display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .assure svg { width: 16px; height: 16px; color: var(--mint); flex-shrink: 0; }

      section { position: relative; }
      .sec { padding-block: clamp(54px, 9vw, 100px); }
      .sec-head { max-width: 660px; margin-bottom: 40px; }
      .sec-head h2 { margin-top: 16px; }
      .sec-head h2 .hl { background: linear-gradient(120deg, var(--mint), var(--ice)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      .sec-head .sub { margin-top: 14px; color: var(--muted); font-size: 1.04rem; }

      /* ===== HERO ===== */
      .hero { padding-block: clamp(40px, 7vw, 76px) clamp(30px, 5vw, 60px); }
      .hero-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: clamp(24px, 4vw, 56px); align-items: center; }
      .hero h1 { font-size: clamp(2.1rem, 7.2vw, 3.5rem); font-weight: 900; margin: 20px 0 0; letter-spacing: -0.02em; }
      .hero h1 .hl { background: linear-gradient(110deg, var(--mint) 10%, var(--ice) 90%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      .hero .lead { font-size: clamp(1.04rem, 2.5vw, 1.2rem); color: var(--muted); margin-top: 20px; max-width: 540px; }
      .hero .lead b { color: var(--text); font-weight: 600; }
      .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; align-items: center; }

      .hero-visual { position: relative; display: grid; place-items: center; }
      .phone {
        width: clamp(230px, 24vw, 340px); aspect-ratio: 1024 / 1536; justify-self: center;
        background-image: var(--phone); background-size: cover; background-position: center;
        border-radius: 26px;
        filter: drop-shadow(0 40px 70px rgba(0,0,0,.6)) drop-shadow(0 0 50px rgba(0,229,160,.18));
        animation: float 6s ease-in-out infinite;
      }
      @keyframes float { 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-14px) } }
      .chip {
        position: absolute; display: flex; align-items: center; gap: 10px;
        background: rgba(10,16,25,.72); border: 1px solid var(--line-2); border-radius: 14px;
        padding: 10px 14px; backdrop-filter: blur(14px);
        box-shadow: 0 18px 40px -18px rgba(0,0,0,.7);
      }
      .chip .ic { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; flex-shrink: 0; background: rgba(0,229,160,.14); color: var(--mint); }
      .chip .ic svg { width: 17px; height: 17px; }
      .chip b { font-size: .9rem; color: var(--text); display: block; line-height: 1.25; }
      .chip span { font-size: .74rem; color: var(--muted); }
      .chip.c1 { top: 12%; inset-inline-start: -2%; animation: float 6s ease-in-out infinite .8s; }
      .chip.c2 { bottom: 14%; inset-inline-end: -3%; animation: float 6.6s ease-in-out infinite .3s; }
      .chip.up b { color: var(--mint); font-family: var(--mono); }

      /* ===== STATS BAR ===== */
      .stats { margin-top: clamp(38px, 6vw, 60px); }
      .stats-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
        background: var(--line); border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
        backdrop-filter: blur(8px);
      }
      .stat { background: rgba(10,16,25,.55); padding: 22px 16px; text-align: center; }
      .stat .v { font-family: var(--mono); font-weight: 700; font-size: clamp(1.5rem, 5vw, 2.1rem); color: var(--text); direction: ltr; }
      .stat .v .u { color: var(--mint); }
      .stat .l { font-size: .82rem; color: var(--muted); margin-top: 4px; }

      /* ===== PAIN ===== */
      .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .card {
        background: var(--panel); border: 1px solid var(--line); border-radius: 20px; padding: 28px 24px;
        backdrop-filter: blur(10px); transition: transform .28s ease, border-color .28s ease, background .28s ease;
        position: relative; overflow: hidden;
      }
      .card::before { content: ''; position: absolute; inset: 0; border-radius: 20px; padding: 1px; background: linear-gradient(160deg, rgba(0,229,160,.35), transparent 40%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity .3s ease; }
      .card:hover { transform: translateY(-5px); border-color: var(--line-2); background: var(--panel-2); }
      .card:hover::before { opacity: 1; }
      .card .ic { width: 50px; height: 50px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 16px; background: rgba(255,107,107,.12); color: var(--danger); }
      .card .ic svg { width: 25px; height: 25px; }
      .card h3 { font-size: 1.18rem; margin-bottom: 8px; }
      .card p { color: var(--muted); font-size: .96rem; }
      .pain-punch { margin-top: 36px; font-size: clamp(1.2rem, 3.4vw, 1.65rem); font-weight: 700; max-width: 820px; line-height: 1.45; }
      .pain-punch .hl { background: linear-gradient(110deg, var(--mint), var(--ice)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

      /* ===== INCLUDES (checklist) ===== */
      .inc-wrap { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 5vw, 60px); align-items: center; }
      .inc-list { display: flex; flex-direction: column; gap: 14px; }
      .inc-item {
        display: flex; gap: 15px; align-items: flex-start;
        background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px;
        backdrop-filter: blur(8px); transition: transform .22s ease, border-color .22s ease;
      }
      .inc-item:hover { transform: translateX(-4px); border-color: rgba(0,229,160,.35); }
      .inc-item .chk { width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0; display: grid; place-items: center; background: rgba(0,229,160,.14); color: var(--mint); margin-top: 2px; }
      .inc-item .chk svg { width: 16px; height: 16px; }
      .inc-item h3 { font-size: 1.05rem; margin-bottom: 3px; font-weight: 700; }
      .inc-item p { font-size: .9rem; color: var(--muted); }
      .inc-visual { position: relative; border-radius: 22px; overflow: hidden; border: 1px solid var(--line-2); aspect-ratio: 3/4; background-image: var(--phone); background-size: cover; background-position: center; box-shadow: 0 30px 60px -28px rgba(0,0,0,.7); }
      .inc-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(7,11,18,.85)); }

      /* ===== STEPS ===== */
      .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: s; }
      .step {
        position: relative; background: var(--panel); border: 1px solid var(--line); border-radius: 20px;
        padding: 30px 26px 26px; backdrop-filter: blur(10px);
      }
      .step .no { font-family: var(--mono); font-weight: 700; font-size: 2.4rem; line-height: 1; background: linear-gradient(135deg, var(--mint), var(--ice)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      .step h3 { font-size: 1.16rem; margin: 14px 0 7px; }
      .step p { color: var(--muted); font-size: .95rem; }
      .step .line { position: absolute; top: 44px; inset-inline-start: -9px; width: 18px; height: 2px; background: linear-gradient(90deg, var(--mint), transparent); }

      /* ===== DISCLAIMER STRIP ===== */
      .note {
        display: flex; gap: 16px; align-items: flex-start;
        background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 24px 26px;
        backdrop-filter: blur(8px);
      }
      .note .ic { width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0; display: grid; place-items: center; background: rgba(244,194,107,.13); color: var(--gold); }
      .note .ic svg { width: 22px; height: 22px; }
      .note h3 { font-size: 1.08rem; margin-bottom: 6px; }
      .note p { color: var(--muted); font-size: .94rem; }

      /* ===== FINAL CTA ===== */
      .final {
        position: relative; text-align: center; border-radius: 28px; overflow: hidden;
        padding: clamp(44px, 7vw, 80px) clamp(24px, 5vw, 60px);
        background: linear-gradient(160deg, rgba(0,229,160,.10), rgba(94,224,255,.05) 50%, rgba(244,194,107,.06));
        border: 1px solid var(--line-2);
      }
      .final::before { content: ''; position: absolute; inset: 0; background-image: var(--atmos); background-size: cover; background-position: center; opacity: .25; z-index: -1; }
      .final h2 { font-size: clamp(1.85rem, 5.5vw, 2.9rem); font-weight: 900; }
      .final h2 .hl { background: linear-gradient(110deg, var(--mint), var(--ice)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
      .final p { color: var(--muted); max-width: 560px; margin: 16px auto 0; }
      .final-cta { margin-top: 30px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .final-cta .micro { font-size: .84rem; color: var(--muted-2); }

      /* ===== footer ===== */
      .foot { border-top: 1px solid var(--line); padding-block: 26px; margin-top: clamp(40px, 6vw, 70px); }
      .foot .disc { color: var(--muted-2); font-size: .8rem; line-height: 1.7; max-width: 880px; margin-bottom: 16px; }
      .foot-row { display: flex; flex-wrap: wrap; gap: 12px 22px; justify-content: space-between; align-items: center; font-size: .82rem; color: var(--muted-2); }
      .foot-row a:hover { color: var(--mint); }

      /* ===== sticky mobile CTA ===== */
      .sticky {
        position: fixed; bottom: 0; inset-inline: 0; z-index: 60; display: none;
        padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
        background: rgba(7,11,18,.86); backdrop-filter: blur(16px); border-top: 1px solid var(--line);
      }
      .sticky .btn { width: 100%; padding: 15px; }

      /* ===== reveal ===== */
      .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.2,.7,.3,1), transform .7s cubic-bezier(.2,.7,.3,1); }
      .reveal.in { opacity: 1; transform: none; }
      .reveal[data-d="1"] { transition-delay: .08s; }
      .reveal[data-d="2"] { transition-delay: .16s; }
      .reveal[data-d="3"] { transition-delay: .24s; }

      /* ===== responsive ===== */
      @media (max-width: 920px) {
        .hero-grid { grid-template-columns: 1fr; }
        .hero-visual { order: -1; max-width: 300px; margin-inline: auto; margin-bottom: 4px; }
        .phone { width: min(54vw, 210px); }
        .chip { display: none; }
        .pain-grid, .steps { grid-template-columns: 1fr; }
        .inc-wrap { grid-template-columns: 1fr; }
        .inc-visual { display: none; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .step .line { display: none; }
      }
      @media (max-width: 560px) {
        .sticky { display: block; }
        .hero-cta .btn { width: 100%; }
        body { padding-bottom: 78px; }
        .note { flex-direction: column; gap: 12px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .phone, .chip, .btn.glowing, .kicker .pulse-dot { animation: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body id="top">
    <div class="atmos"></div>
    <canvas id="grid-canvas"></canvas>
    <div class="glow g1"></div>
    <div class="glow g2"></div>
    <div class="glow g3"></div>

    <main>
      <!-- ===== HERO ===== -->
      <section class="hero wrap">
        <div class="hero-grid">
          <div>
            <span class="kicker reveal"><span class="pulse-dot"></span>מדריך חינם · נשלח ב‑WhatsApp</span>
            <h1 class="reveal" data-d="1">
              שוק ההון מרגיש כמו <span class="hl">הימור?</span><br />
              כי אף אחד לא לימד אותך לקרוא אותו.
            </h1>
            <p class="lead reveal" data-d="2">
              מדריך חינמי וקצר שמראה איך באמת קוראים <b>מניות, סיכון ופיזור</b> — בעברית פשוטה, בלי ז׳רגון ובלי המלצות קנייה. רק הבסיס שכל מתחיל חייב להבין — לפני שהוא שם שקל אחד.
            </p>
            <div class="hero-cta reveal" data-d="3">
              <a class="btn glowing link-btn" onclick="mixinJump()">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z"/></svg>
                לקבלת המדריך ב‑WhatsApp
              </a>
            </div>
            <span class="assure reveal" data-d="3">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              חינם לגמרי · נשלח עכשיו · בלי שיחות מכירה
            </span>
          </div>

          <div class="hero-visual reveal" data-d="2">
            <div class="phone"></div>
            <div class="chip c1 up">
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v5"/></svg></span>
              <span><b>פיזור נכון</b><span>פחות סיכונים מיותרים</span></span>
            </div>
            <div class="chip c2">
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></span>
              <span><b>קוראים את השוק</b><span>בלי הרעש שמסביב</span></span>
            </div>
          </div>
        </div>

        <!-- STATS -->
        <div class="stats reveal">
          <div class="stats-grid">
            <div class="stat"><div class="v"><span class="count" data-to="7">0</span></div><div class="l">דקות ביום מספיקות</div></div>
            <div class="stat"><div class="v"><span class="count" data-to="12">0</span></div><div class="l">מושגי יסוד מוסברים</div></div>
            <div class="stat"><div class="v"><span class="num">0</span><span class="u"> ₪</span></div><div class="l">חינם לחלוטין, בלי כוכביות</div></div>
            <div class="stat"><div class="v"><span class="count" data-to="3">0</span></div><div class="l">צעדים עד שמתחילים</div></div>
          </div>
        </div>
      </section>

      <!-- ===== PAIN ===== -->
      <section class="sec wrap">
        <div class="sec-head reveal">
