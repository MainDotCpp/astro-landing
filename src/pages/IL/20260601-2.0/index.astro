    <script is:inline>
      (function () {
        const els = Array.from(document.querySelectorAll('.reveal'))
        if (!('IntersectionObserver' in window)) { els.forEach(e => e.classList.add('in')); return }
        document.querySelectorAll('.value-grid, .pain-list, .quotes, .faq').forEach(g => {
          Array.from(g.querySelectorAll('.reveal')).forEach((el, i) => { el.dataset.d = i * 80 })
        })
        const io = new IntersectionObserver((ents) => {
          ents.forEach(en => {
            if (en.isIntersecting) { const el = en.target; setTimeout(() => el.classList.add('in'), Number(el.dataset.d) || 0); io.unobserve(el) }
          })
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
        els.forEach(el => io.observe(el))
      })()
    </script>
