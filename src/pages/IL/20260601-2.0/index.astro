---
import RedirectCode from '@/components/RedirectCode.astro'
import heroBg from './assets/images/hero-bg.png'
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>קהילת השוק האמריקאי בעברית — Nasdaq, S&P 500 ו-AI כל שבוע</title>
    <meta
      name="description"
      content="‏כל מה שחשוב במניות האמריקאיות, ב-AI וב-Nasdaq — מסונן, בעברית פשוטה, כמה דקות בשבוע. קהילת WhatsApp חינמית של אלפי משקיעים ישראלים. בלי ניסיון, בלי אנגלית, בלי תשלום."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <style define:vars={{ heroImg: `url(${heroBg.src})` }}>
      :root {
        --navy:      #0A1A2F;
        --ink:       #050B14;
        --teal:      #00E5A8;
        --teal-dim:  #06C492;
        --teal-glow: rgba(0, 229, 168, 0.22);
        --wa:        #25D366;
        --white:     #FFFFFF;
        --muted:     #8FA3B8;
        --muted-2:   #5C6F86;
        --warn:      #FF5A4D;
        --line:      rgba(143, 163, 184, 0.16);
        --line-soft: rgba(143, 163, 184, 0.08);
        --panel:     #0E2138;
        --panel-2:   #102A45;
        --font:      'Heebo', Arial, 'Noto Sans Hebrew', sans-serif;
        --maxw:      1080px;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }

      body {
        direction: rtl;
        text-align: right;
        font-family: var(--font);
        background: var(--ink);
        color: var(--white);
        line-height: 1.65;
        font-size: 17px;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: 84px; /* room for sticky CTA on mobile */
      }

      bdi { unicode-bidi: isolate; }
      .num { font-variant-numeric: tabular-nums; }

      .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: 20px; }
      a { color: inherit; text-decoration: none; }

      h1, h2, h3 { line-height: 1.18; font-weight: 800; }
      h2 { font-size: clamp(1.55rem, 5vw, 2.3rem); font-weight: 900; }
      .teal { color: var(--teal); }
      .warn { color: var(--warn); }

      /* ===== buttons ===== */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 11px;
        font-family: var(--font); font-weight: 800; font-size: 1.12rem;
        padding: 17px 30px; border-radius: 14px; cursor: pointer; border: none;
        transition: transform .16s ease, box-shadow .25s ease, filter .2s ease;
        white-space: nowrap; line-height: 1.2;
      }
      .btn svg { width: 22px; height: 22px; flex-shrink: 0; }
      .btn-wa {
        background: var(--wa); color: #04220F;
        box-shadow: 0 16px 38px -12px rgba(37, 211, 102, .55), inset 0 1px 0 rgba(255,255,255,.3);
      }
      .btn-wa:hover { transform: translateY(-2px); filter: brightness(1.04); }
      .btn-teal {
        background: linear-gradient(135deg, var(--teal), var(--teal-dim));
        color: #042019;
        box-shadow: 0 16px 38px -12px var(--teal-glow), inset 0 1px 0 rgba(255,255,255,.35);
      }
      .btn-teal:hover { transform: translateY(-2px); }
      .pulse { animation: pulse 2.4s ease-in-out infinite; }
      @keyframes pulse { 0%,100%{ box-shadow: 0 16px 38px -12px rgba(37,211,102,.55), inset 0 1px 0 rgba(255,255,255,.3) } 50%{ box-shadow: 0 16px 50px -8px rgba(37,211,102,.6), inset 0 1px 0 rgba(255,255,255,.3) } }

      .eyebrow {
        display: inline-flex; align-items: center; gap: 9px;
        font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
        color: var(--teal);
      }
      .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px var(--teal-glow); animation: blink 1.8s infinite; }
      @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }

      section { position: relative; }
      .sec { padding-block: clamp(48px, 8vw, 88px); }

      /* ===== HEADER ===== */
      .head {
        position: sticky; top: 0; z-index: 50;
        background: rgba(5, 11, 20, .8); backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line-soft);
      }
      .head .wrap { display: flex; align-items: center; justify-content: space-between; height: 60px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 900; font-size: 1.1rem; }
      .brand .mark { width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: linear-gradient(135deg, rgba(0,229,168,.2), rgba(0,229,168,.05)); border: 1px solid rgba(0,229,168,.35); }
      .brand .mark svg { width: 18px; height: 18px; color: var(--teal); }
      .head-cta { font-size: .92rem; padding: 9px 17px; }

      /* ===== HERO ===== */
      .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 7vw, 76px); }
      .hero::before {
        content: ''; position: absolute; inset: 0; z-index: -2;
        background-image: var(--heroImg); background-size: cover; background-position: center left;
      }
      .hero::after {
        content: ''; position: absolute; inset: 0; z-index: -1;
        background:
          linear-gradient(90deg, var(--ink) 8%, rgba(10,26,47,.82) 48%, rgba(10,26,47,.45) 100%),
          linear-gradient(180deg, transparent 60%, var(--ink) 100%);
      }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(26px, 4vw, 52px); align-items: center; }
      .hero h1 { font-size: clamp(2rem, 6.4vw, 3.35rem); font-weight: 900; margin-top: 16px; }
      .hero h1 .u { color: var(--teal); }
      .hero .sub { color: #C8D6E6; font-size: clamp(1.02rem, 2.6vw, 1.22rem); margin-top: 18px; max-width: 560px; }
      .hero .sub bdi { color: var(--white); font-weight: 600; }
      .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 30px; }
      .hero-cta .micro { font-size: .84rem; color: var(--muted); display: flex; align-items: center; gap: 8px; }
      .hero-cta .micro svg { width: 16px; height: 16px; color: var(--teal); }

      /* loss-vs-nasdaq comparison chart (pure SVG) */
      .loss-card {
        background: rgba(8, 18, 32, .72); backdrop-filter: blur(8px);
        border: 1px solid var(--line); border-radius: 18px; padding: 20px 20px 16px;
        box-shadow: 0 30px 70px -28px rgba(0,0,0,.8);
      }
      .loss-card .lc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
      .loss-card .lc-title { font-weight: 800; font-size: .96rem; }
      .loss-card .lc-sub { font-size: .76rem; color: var(--muted); }
      .loss-card svg.chart { width: 100%; height: auto; display: block; }
      .legend { display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; }
      .legend span { display: inline-flex; align-items: center; gap: 7px; font-size: .8rem; color: var(--muted); }
      .legend i { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }

      /* ===== PAIN ("נשמע מוכר?") ===== */
      .pain-list { list-style: none; display: grid; gap: 12px; margin-top: 30px; max-width: 760px; }
      .pain-list li { display: flex; gap: 13px; align-items: flex-start; background: rgba(255,90,77,.05); border: 1px solid rgba(255,90,77,.16); border-radius: 13px; padding: 15px 17px; font-size: 1.04rem; color: #E6EDF5; }
      .pain-list .ic { width: 24px; height: 24px; flex-shrink: 0; color: var(--warn); margin-top: 2px; }
      .pain-punch { margin-top: 26px; font-size: clamp(1.15rem, 3.2vw, 1.5rem); font-weight: 800; max-width: 700px; }
      .pain-punch .teal { white-space: normal; }

      /* ===== VALUE ("מה אתה מקבל") ===== */
      .value-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 34px; }
      .value-card { background: linear-gradient(180deg, var(--panel), rgba(14,33,56,.5)); border: 1px solid var(--line); border-radius: 16px; padding: 24px 22px; transition: transform .25s ease, border-color .25s ease; }
      .value-card:hover { transform: translateY(-4px); border-color: rgba(0,229,168,.4); }
      .value-card .ic { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; background: var(--teal-glow); border: 1px solid rgba(0,229,168,.3); margin-bottom: 15px; }
      .value-card .ic svg { width: 24px; height: 24px; color: var(--teal); }
      .value-card p { font-size: 1.02rem; color: #DCE6F1; }
      .value-foot { margin-top: 26px; text-align: center; font-weight: 700; color: var(--muted); }
      .value-foot b { color: var(--white); }

      /* ===== SOCIAL PROOF ===== */
      .proof-grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(26px, 4vw, 48px); align-items: center; margin-top: 30px; }
      .quotes { display: grid; gap: 14px; }
      .quote { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; position: relative; }
      .quote::before { content: '"'; position: absolute; top: 2px; inset-inline-start: 14px; font-size: 2.4rem; color: var(--teal); opacity: .4; font-family: Georgia, serif; line-height: 1; }
      .quote p { font-size: 1.02rem; color: #E6EDF5; padding-top: 8px; }
      .quote .who { margin-top: 9px; font-size: .85rem; color: var(--teal); font-weight: 700; }
      .rating { display: flex; align-items: center; gap: 10px; margin-top: 18px; font-size: .92rem; color: var(--muted); flex-wrap: wrap; }
      .rating .stars { color: #FFC23D; letter-spacing: 2px; }

      /* fake WhatsApp group screenshot (pure HTML/CSS, accurate RTL Hebrew) */
      .wa-phone { background: #0B141A; border: 1px solid var(--line); border-radius: 22px; padding: 0; overflow: hidden; box-shadow: 0 36px 80px -32px rgba(0,0,0,.85); max-width: 340px; margin-inline: auto; }
      .wa-top { background: #1F2C33; display: flex; align-items: center; gap: 11px; padding: 13px 15px; }
      .wa-top .ava { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--teal), var(--teal-dim)); display: grid; place-items: center; color: #042019; font-weight: 900; font-size: .95rem; }
      .wa-top .nm { font-size: .9rem; font-weight: 700; color: #fff; }
      .wa-top .st { font-size: .72rem; color: #8FA3B8; }
      .wa-body { padding: 16px 12px; background: #0B141A; display: flex; flex-direction: column; gap: 9px; min-height: 300px; background-image: radial-gradient(rgba(255,255,255,.018) 1px, transparent 1px); background-size: 16px 16px; }
      .bubble { max-width: 84%; padding: 8px 12px; border-radius: 12px; font-size: .86rem; line-height: 1.5; position: relative; }
      .bubble.in { align-self: flex-start; background: #1F2C33; color: #E9EDF0; border-top-right-radius: 4px; }
      .bubble.out { align-self: flex-end; background: #075E54; color: #E9F7EF; border-top-left-radius: 4px; }
      .bubble .nm { font-size: .73rem; font-weight: 800; color: var(--teal); margin-bottom: 2px; }
      .bubble .tm { font-size: .64rem; color: rgba(255,255,255,.45); margin-top: 3px; text-align: start; }

      /* ===== BRIEFING SAMPLE ===== */
      .brief { background: linear-gradient(180deg, var(--panel-2), var(--panel)); border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 4vw, 38px); margin-top: 30px; box-shadow: 0 30px 70px -34px rgba(0,0,0,.7); }
      .brief-tag { display: inline-flex; align-items: center; gap: 9px; font-size: .82rem; font-weight: 800; letter-spacing: .03em; color: var(--teal); border: 1px solid rgba(0,229,168,.3); background: var(--teal-glow); border-radius: 999px; padding: 7px 15px; margin-bottom: 20px; }
      .brief-tag svg { width: 16px; height: 16px; }
      .brief-points { list-style: none; display: grid; gap: 16px; }
      .brief-points li { display: flex; gap: 14px; align-items: flex-start; }
      .brief-points .n { width: 30px; height: 30px; flex-shrink: 0; border-radius: 9px; display: grid; place-items: center; background: var(--teal); color: #042019; font-weight: 900; font-size: .95rem; }
      .brief-points p { font-size: 1.04rem; color: #E6EDF5; }
      .brief-author { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); display: flex; gap: 13px; align-items: flex-start; }
      .brief-author .ic { width: 42px; height: 42px; flex-shrink: 0; border-radius: 11px; display: grid; place-items: center; background: var(--teal-glow); border: 1px solid rgba(0,229,168,.3); }
      .brief-author .ic svg { width: 22px; height: 22px; color: var(--teal); }
      .brief-author p { font-size: .92rem; color: var(--muted); }
      .brief-author b { color: var(--white); }
      .brief-next { margin-top: 18px; font-size: 1rem; font-weight: 700; }

      /* ===== FAQ / OBJECTIONS ===== */
      .faq { display: grid; gap: 12px; margin-top: 30px; max-width: 800px; }
      .faq-item { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
      .faq-item .q { display: flex; align-items: center; gap: 11px; font-weight: 800; font-size: 1.06rem; }
      .faq-item .q .qi { width: 26px; height: 26px; flex-shrink: 0; border-radius: 7px; display: grid; place-items: center; background: var(--teal-glow); color: var(--teal); border: 1px solid rgba(0,229,168,.3); font-weight: 900; }
      .faq-item .a { margin-top: 9px; color: #CFDAE6; font-size: 1rem; padding-inline-start: 37px; }

      /* ===== FINAL CTA + FORM ===== */
      .final { background: radial-gradient(680px 360px at 75% 0%, rgba(0,229,168,.13), transparent 60%), var(--navy); border-radius: 24px; border: 1px solid var(--line); padding: clamp(30px, 5vw, 56px); display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 4vw, 52px); align-items: start; }
      .final h2 { margin-bottom: 16px; }
      .final .sub { color: #CFDAE6; font-size: 1.08rem; max-width: 460px; }
      .final-cta { margin-top: 26px; }
      .final-cta .micro { margin-top: 14px; font-size: .86rem; color: var(--muted); display: flex; align-items: center; gap: 8px; }
      .final-cta .micro svg { width: 17px; height: 17px; color: var(--teal); flex-shrink: 0; }

      .form { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 26px 24px; }
      .form .intro { font-size: .96rem; color: var(--muted); margin-bottom: 18px; }
      .field { margin-bottom: 16px; }
      .field label { display: block; font-size: .88rem; font-weight: 700; margin-bottom: 8px; }
      .field input, .field select { width: 100%; font-family: var(--font); font-size: 1rem; background: rgba(5,11,20,.6); color: var(--white); border: 1px solid var(--line); border-radius: 11px; padding: 13px 15px; outline: none; transition: border-color .2s; text-align: right; }
      .field input:focus, .field select:focus { border-color: var(--teal); }
      .field .opt { font-size: .76rem; color: var(--muted-2); font-weight: 500; }
      .phone-row { display: flex; gap: 9px; }
      .phone-row .cc { flex: 0 0 auto; width: 78px; text-align: center; direction: ltr; color: var(--muted); display: grid; place-items: center; background: rgba(5,11,20,.6); border: 1px solid var(--line); border-radius: 11px; font-weight: 700; }
      .phone-row input { direction: ltr; text-align: left; }
      .form .btn { width: 100%; margin-top: 6px; }
      .form .note { font-size: .76rem; color: var(--muted-2); margin-top: 10px; line-height: 1.5; }

      /* ===== disclaimer / footer ===== */
      .disclaimer { border-top: 1px solid var(--line-soft); }
      .disclaimer p { max-width: 880px; margin-inline: auto; text-align: center; color: var(--muted-2); font-size: .82rem; line-height: 1.7; }
      .foot { border-top: 1px solid var(--line-soft); padding-block: 24px; display: flex; flex-wrap: wrap; gap: 12px 22px; justify-content: space-between; align-items: center; font-size: .8rem; color: var(--muted-2); }
      .foot-links { display: flex; gap: 18px; }
      .foot-links a:hover { color: var(--teal); }

      /* ===== sticky mobile CTA ===== */
      .sticky { position: fixed; bottom: 0; inset-inline: 0; z-index: 60; display: none; padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: rgba(5,11,20,.94); backdrop-filter: blur(14px); border-top: 1px solid var(--line); }
      .sticky .btn { width: 100%; padding: 15px; }

      /* ===== reveal ===== */
      .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
      .reveal.in { opacity: 1; transform: none; }

      /* ===== responsive ===== */
      @media (max-width: 920px) {
        .hero-grid, .proof-grid, .final { grid-template-columns: 1fr; }
        .hero::after { background: linear-gradient(180deg, rgba(5,11,20,.55) 0%, rgba(10,26,47,.8) 60%, var(--ink) 100%); }
        .hero { text-align: right; }
        .proof-grid .wa-phone { order: -1; }
      }
      @media (max-width: 560px) {
        body { font-size: 16px; }
        .value-grid { grid-template-columns: 1fr; }
        .head-cta { display: none; }
        .sticky { display: block; }
        .hero-cta .btn, .final-cta .btn { width: 100%; }
        .hero-cta { align-items: stretch; }
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .pulse, .eyebrow .dot { animation: none; }
        html { scroll-behavior: auto; }
      }
    </style>
  </head>

  <body id="top">
    <!-- ===== HEADER ===== -->
    <header class="head">
      <div class="wrap">
        <a class="brand" href="#top">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 4 3 6-7"/><path d="M14 8h4v4"/></svg>
          </span>
          <span>מבט שוק</span>
        </a>
        <a class="btn btn-wa head-cta link-btn" onclick="onLinkBtnClick()">הצטרף בחינם</a>
      </div>
    </header>

    <main>
      <!-- ===== 1 · HERO ===== -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="reveal">
            <span class="eyebrow"><span class="dot"></span>קהילת מידע וניתוח · לא ייעוץ</span>
            <h1>בזמן שאתה קורא את הכותרות — <span class="u">אחרים כבר פעלו לפי המידע.</span></h1>
            <p class="sub">
              כל שבוע אנחנו לוקחים את מה שזז ב-<bdi>Wall Street</bdi> — <bdi>Nasdaq</bdi>, <bdi>S&amp;P 500</bdi> ומניות ה-<bdi>AI</bdi> והטכנולוגיה הגדולות — ומתרגמים את זה לעברית פשוטה שכל אחד מבין. בלי ז'רגון. בלי אנגלית. בלי לשלם שקל.
            </p>
            <div class="hero-cta">
              <a class="btn btn-wa pulse link-btn" onclick="onLinkBtnClick()">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm5.8 14.13c-.24.68-1.42 1.32-1.95 1.36-.5.05-.96.24-3.23-.67-2.73-1.08-4.45-3.86-4.59-4.04-.13-.18-1.1-1.46-1.1-2.79 0-1.32.69-1.97.94-2.24.24-.27.53-.34.71-.34l.51.01c.16.01.39-.06.6.46.24.58.81 2 .88 2.14.07.14.12.31.02.49-.09.18-.14.29-.27.45-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.93 1.94 1.22 2.21 1.36.27.14.43.12.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.22.6-.13.25.09 1.57.74 1.84.87.27.14.45.2.51.31.07.12.07.66-.17 1.34z"/></svg>
                הצטרף עכשיו לקבוצה — בחינם
              </a>
              <span class="micro">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                בלי כרטיס אשראי · בלי התחייבות · אפשר לצאת בכל רגע
              </span>
            </div>
          </div>

          <div class="reveal">
            <!-- loss vs Nasdaq comparison: makes the hidden loss visible -->
            <div class="loss-card">
              <div class="lc-head">
                <span class="lc-title">הכסף בעו״ש מול ה-<bdi>Nasdaq</bdi></span>
                <span class="lc-sub">המחשה · 5 שנים</span>
              </div>
              <svg class="chart" viewBox="0 0 320 170" preserveAspectRatio="none" role="img" aria-label="גרף השוואה">
                <defs>
                  <linearGradient id="up" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#00E5A8" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#00E5A8" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <!-- grid lines -->
