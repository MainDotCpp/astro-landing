    <script>
      import gsap from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      import Swiper from 'swiper'
      import { Autoplay, Keyboard } from 'swiper/modules'

      gsap.registerPlugin(ScrollTrigger)

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      /**
       * 滾動顯現：JS 只負責加 .in，樣式由 CSS 過渡完成。
       * 若 ScrollTrigger 因任何原因沒觸發，兜底計時器會把內容顯示出來，
       * 不會讓文字永久停在 opacity:0。
       */
      function revealOnScroll() {
        const items = gsap.utils.toArray('[data-rev]')
        document.documentElement.classList.add('js-on')

        items.forEach((el) => {
          ScrollTrigger.create({
            trigger: el,
            start: 'top 90%',
            once: true,
            onEnter: () => el.classList.add('in'),
          })
        })

        setTimeout(() => items.forEach(el => el.classList.add('in')), 4000)
      }

      function parallax() {
        gsap.utils.toArray('[data-para]').forEach((el) => {
          const amt = parseFloat(el.dataset.para || '0.1')
          gsap.fromTo(
            el,
            { yPercent: -amt * 100 },
            {
              yPercent: amt * 100,
              ease: 'none',
              scrollTrigger: {
                trigger: el.parentElement,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            },
          )
        })
      }

      function counters() {
        gsap.utils.toArray('[data-count]').forEach((el) => {
          const target = parseFloat(el.dataset.count || '0')
          const dec = parseInt(el.dataset.dec || '0', 10)
          const prefix = el.dataset.prefix || ''
          const suffix = el.dataset.suffix || ''
          const obj = { v: 0 }

          const paint = () => {
            const n = dec > 0
              ? obj.v.toFixed(dec)
              : Math.round(obj.v).toLocaleString('en-US')
            el.innerHTML = `${prefix}${n}<span class="u">${suffix}</span>`
          }
          paint()

          gsap.to(obj, {
            v: target,
            duration: 1.9,
            ease: 'power2.out',
            onUpdate: paint,
            scrollTrigger: { trigger: el, start: 'top 92%', once: true },
          })

          // 兜底：動畫沒跑到底就直接落到終值，不留一排 0 給使用者看
          setTimeout(() => {
            if (obj.v !== target) { obj.v = target; paint() }
          }, 5000)
        })
      }

      function processRail() {
        const rail = document.querySelector('[data-rail]')
        const fill = document.querySelector('[data-rail-fill]')
        if (!rail || !fill) return

        const steps = gsap.utils.toArray('[data-step]')

        ScrollTrigger.create({
          trigger: rail,
          start: 'top 72%',
          end: 'bottom 78%',
          scrub: .5,
          onUpdate: (self) => {
            fill.style.height = `${self.progress * 100}%`
          },
        })

        steps.forEach((s) => {
          ScrollTrigger.create({
            trigger: s,
            start: 'top 76%',
            onEnter: () => s.classList.add('lit'),
            onLeaveBack: () => s.classList.remove('lit'),
          })
        })
      }

      function buildSwiper(rootSel, dotsSel, prevSel, nextSel, opts) {
        const root = document.querySelector(rootSel)
        const dotsBox = document.querySelector(dotsSel)
        if (!root) return

        const sw = new Swiper(root, {
          modules: [Autoplay, Keyboard],
          wrapperClass: 'sw-wrap',
          slideClass: 'sw-slide',
          slidesPerView: 1.1,
          spaceBetween: 14,
          grabCursor: true,
          keyboard: { enabled: true },
          autoplay: reduce ? false : { delay: 5200, disableOnInteraction: true },
          breakpoints: {
            560: { slidesPerView: 2.05, spaceBetween: 18 },
            900: { slidesPerView: 3, spaceBetween: 24 },
          },
          ...opts,
        })

        if (dotsBox) {
          const n = sw.slides.length
          dotsBox.innerHTML = Array.from({ length: n }, () => '<span class="d"></span>').join('')
          const dots = Array.from(dotsBox.children)
          const sync = () => dots.forEach((d, i) => d.classList.toggle('on', i === sw.realIndex))
          dots.forEach((d, i) => d.addEventListener('click', () => sw.slideTo(i)))
          sw.on('slideChange', sync)
          sync()
        }

        const prev = prevSel ? document.querySelector(prevSel) : null
        const next = nextSel ? document.querySelector(nextSel) : null
        if (prev) prev.addEventListener('click', () => sw.slidePrev())
        if (next) next.addEventListener('click', () => sw.slideNext())

        return sw
      }

      function faqAccordion() {
        const items = Array.from(document.querySelectorAll('[data-faq]'))

        items.forEach((item) => {
          const btn = item.querySelector('.faq-q')
          const panel = item.querySelector('.faq-a')
          if (!btn || !panel) return

          btn.addEventListener('click', () => {
            const isOpen = item.classList.contains('open')

            items.forEach((other) => {
              if (other === item || !other.classList.contains('open')) return
              other.classList.remove('open')
              gsap.to(other.querySelector('.faq-a'), { height: 0, duration: .4, ease: 'power2.inOut' })
            })

            if (isOpen) {
              item.classList.remove('open')
              gsap.to(panel, { height: 0, duration: .4, ease: 'power2.inOut' })
            }
            else {
              item.classList.add('open')
              gsap.to(panel, {
                height: 'auto',
                duration: .5,
                ease: 'power2.out',
                onComplete: () => ScrollTrigger.refresh(),
              })
            }
          })
        })
      }

      function init() {
        revealOnScroll()
        if (!reduce) parallax()
        counters()
        processRail()
        faqAccordion()

        buildSwiper('[data-hero-sw]', '[data-hero-dots]', null, null, {
          slidesPerView: 1,
          spaceBetween: 0,
          rewind: true,
          slideActiveClass: 'sw-slide-act',
          autoplay: reduce ? false : { delay: 6200, disableOnInteraction: false },
          breakpoints: {},
        })

        buildSwiper('[data-case-sw]', '[data-case-dots]', '[data-case-prev]', '[data-case-next]')
        buildSwiper('[data-lw-sw]', '[data-lw-dots]', '[data-lw-prev]', '[data-lw-next]', {
          slidesPerView: 1.15,
          breakpoints: {
            560: { slidesPerView: 2.2, spaceBetween: 18 },
            900: { slidesPerView: 3.4, spaceBetween: 24 },
          },
        })

        window.addEventListener('load', () => ScrollTrigger.refresh())
      }

      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init)
      else
        init()
    </script>
  </body>
</html>
