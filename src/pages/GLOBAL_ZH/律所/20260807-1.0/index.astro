        color: rgba(255,255,255,.78);
      }
      .close .note {
        margin-top: 14px;
        text-align: center;
        font-size: 11.5px;
        letter-spacing: .05em;
        color: rgba(255,255,255,.55);
      }

      /* ---------- footer ---------- */
      footer {
        background: var(--navy-3);
        color: rgba(255,255,255,.7);
        padding: 38px 22px 44px;
      }
      footer .mk {
