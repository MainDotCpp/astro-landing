        .proc-fig { height: 400px; }
        .rail { margin-top: 56px; padding-left: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 78px; }
        .rail::before, .rail-fill { left: 50%; }
        .step { padding: 0 0 54px; }
        .step.l { grid-column: 1; text-align: right; }
        .step.r { grid-column: 2; margin-top: 78px; }
        .step h3 { font-size: 22px; }
        .step p { font-size: 14px; }
        .step .dot { left: -44px; top: 12px; }
