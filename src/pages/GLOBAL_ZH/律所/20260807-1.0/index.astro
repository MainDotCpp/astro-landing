      }
      .close-in { position: relative; z-index: 2; }
      .close h2 {
        font-family: var(--cjk);
        font-weight: 700;
        font-size: 26px;
        line-height: 1.44;
        letter-spacing: -.012em;
      }
      .close p {
        margin-top: 18px;
