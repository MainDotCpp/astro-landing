      .fc { display: flex; gap: 14px; padding: 7px 0; font-size: 12.5px; }
      .fc .k { flex: 0 0 76px; letter-spacing: .1em; color: var(--brass-l); }
      .fc .v { color: rgba(255,255,255,.8); }
      footer p {
        margin-top: 14px;
