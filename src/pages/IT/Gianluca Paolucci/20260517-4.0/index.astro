---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ITComplianceFooter from '@/pages/IT/components/ITComplianceFooter.astro'
import paolucciAvatar from '../20260517-1.0/images/paolucci.png'

const BRAND = {
  nome: 'Bussola Mercati',
  payoff: 'Osservatorio indipendente sui mercati italiani',
}

const PERSONA = {
  nome: 'Gianluca Paolucci',
  titolo: 'Analista indipendente dei mercati finanziari italiani',
  tagline: 'Oltre 15 anni a osservare i flussi di capitale sull\'economia reale italiana',
  avatar: paolucciAvatar.src,
}

const title = 'Bussola Mercati — Mid-cap italiane sottovalutate: i numeri che il mercato ignora'
const description = 'Le mid-cap italiane scambiano con uno sconto storico rispetto alle large-cap. Scopri quali titoli stiamo osservando e ricevi la lista su WhatsApp.'
---

<BaseLayout title={title} description={description} lang="it">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --bg: #F7F6F3;
        --bg-subtle: #EFEEE9;
        --surface: #FFFFFF;
        --ink: #1A1A2E;
        --ink-soft: #64647B;
        --ink-muted: #9E9EB0;
        --accent: #4F46E5;
        --accent-soft: rgba(79, 70, 229, 0.06);
        --accent-glow: rgba(79, 70, 229, 0.18);
        --positive: #059669;
        --positive-soft: rgba(5, 150, 105, 0.07);
        --negative: #DC2626;
        --negative-soft: rgba(220, 38, 38, 0.06);
        --negative-glow: rgba(220, 38, 38, 0.15);
        --border: #E8E7E4;
        --border-light: #F0EFEC;
        --wa-green: #25D366;
        --max-w: 800px;
        --radius: 14px;
        --shadow-sm: 0 1px 2px rgba(26,26,46,0.04), 0 2px 6px rgba(26,26,46,0.03);
        --shadow-md: 0 2px 4px rgba(26,26,46,0.04), 0 8px 24px rgba(26,26,46,0.06);
        --shadow-lg: 0 4px 8px rgba(26,26,46,0.04), 0 16px 40px rgba(26,26,46,0.08);
        --shadow-hover: 0 8px 16px rgba(26,26,46,0.06), 0 24px 48px rgba(26,26,46,0.1);
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        margin: 0;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        background-image: radial-gradient(circle, #D5D4D0 0.6px, transparent 0.6px);
        background-size: 28px 28px;
        background-attachment: fixed;
      }

      .serif {
        font-family: 'Instrument Serif', Georgia, serif;
      }

      .mono {
        font-family: 'JetBrains Mono', monospace;
      }

      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* stagger children */
      .reveal-delay-1 { transition-delay: 0.08s; }
      .reveal-delay-2 { transition-delay: 0.16s; }
      .reveal-delay-3 { transition-delay: 0.24s; }

      /* ─── Animated top bar ─── */
      .mc-topbar {
        height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--positive), var(--accent), var(--positive));
        background-size: 300% 100%;
        animation: topbar-shift 8s ease infinite;
      }
      @keyframes topbar-shift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
      }

      /* ─── Header ─── */
      .mc-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(247, 246, 243, 0.85);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        border-bottom: 1px solid var(--border);
        padding: 0.8rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .mc-header-brand {
        font-family: 'Instrument Serif', serif;
        font-style: italic;
        font-size: 1.1rem;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .mc-header-cta {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.5rem 1.15rem;
        background: var(--ink);
        color: var(--bg);
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        letter-spacing: 0.02em;
      }

      .mc-header-cta:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(26, 26, 46, 0.2);
      }

      /* ─── Container ─── */
      .mc-container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* ─── Hero ─── */
      .mc-hero {
        padding: 5rem 0 4rem;
        text-align: center;
        position: relative;
      }

      .mc-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, var(--negative-soft) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
        opacity: 0.7;
      }

      .mc-hero .mc-container {
        position: relative;
        z-index: 1;
      }

      .mc-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--negative);
        background: var(--negative-soft);
        padding: 0.4rem 1rem;
        border-radius: 100px;
        margin-bottom: 2rem;
      }

      .mc-hero-badge::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--negative);
        animation: pulse-dot 2s ease-in-out infinite;
      }

      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.7); }
      }

      .mc-hero-stat {
        display: inline-block;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 2.5rem 4rem;
        margin-bottom: 2.5rem;
        box-shadow: var(--shadow-lg), 0 0 0 1px var(--negative-soft), 0 0 60px var(--negative-glow);
        position: relative;
        overflow: hidden;
      }

      .mc-hero-stat::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 60%, var(--negative-soft) 100%);
        pointer-events: none;
      }

      .mc-hero-number {
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(4rem, 12vw, 6.5rem);
        font-weight: 700;
        color: var(--negative);
        line-height: 1;
        margin: 0;
        letter-spacing: -0.04em;
      }

      .mc-hero-stat-label {
        font-size: 0.82rem;
        color: var(--ink-soft);
        margin-top: 0.85rem;
        line-height: 1.55;
        max-width: 340px;
        margin-left: auto;
        margin-right: auto;
      }

      .mc-hero-source {
        font-size: 0.65rem;
        color: var(--ink-muted);
        margin-top: 0.45rem;
        font-weight: 500;
      }

      .mc-hero h1 {
        font-family: 'Instrument Serif', serif;
        font-size: clamp(1.6rem, 4vw, 2.25rem);
        font-weight: 400;
        line-height: 1.35;
        color: var(--ink);
        margin: 0 auto 2.5rem;
        max-width: 620px;
        letter-spacing: -0.01em;
      }

      .mc-hero h1 em {
        font-style: italic;
        color: var(--accent);
      }

      .mc-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--accent);
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.9rem 2rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        letter-spacing: 0.01em;
      }

      .mc-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px var(--accent-glow);
      }

      .mc-btn-primary svg {
        transition: transform 0.2s;
      }

      .mc-btn-primary:hover svg {
        transform: translateX(3px);
      }

      /* ─── Section styles ─── */
      .mc-section {
        padding: 4.5rem 0;
      }

      .mc-section-header {
        margin-bottom: 2.5rem;
      }

      .mc-section-tag {
        display: inline-block;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        margin-bottom: 0.85rem;
      }

      .mc-section-h2 {
        font-family: 'Instrument Serif', serif;
        font-size: clamp(1.5rem, 3.5vw, 2rem);
        font-weight: 400;
        color: var(--ink);
        margin: 0 0 0.5rem;
        letter-spacing: -0.01em;
        line-height: 1.25;
      }

      .mc-section-sub {
        font-size: 0.88rem;
        color: var(--ink-soft);
        margin: 0;
        line-height: 1.6;
      }

      /* ─── Divider ─── */
      .mc-divider {
        border: none;
        height: 1px;
        background: var(--border);
        margin: 0;
      }

      /* ─── Data cards ─── */
      .mc-data-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }

      .mc-data-card {
        background: var(--surface);
        border-radius: var(--radius);
        padding: 1.75rem 1.5rem 1.5rem;
        text-align: center;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
        transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s;
        position: relative;
        overflow: hidden;
      }

      .mc-data-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--positive);
        border-radius: var(--radius) var(--radius) 0 0;
      }

      .mc-data-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
      }

      .mc-data-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-muted);
        margin-bottom: 1.25rem;
      }

      .mc-data-primary {
        font-family: 'JetBrains Mono', monospace;
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--positive);
        line-height: 1;
        margin-bottom: 0.3rem;
        letter-spacing: -0.03em;
      }

      .mc-data-secondary {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.88rem;
        color: var(--ink-muted);
        margin-bottom: 1rem;
      }

      .mc-data-bar {
        height: 6px;
        border-radius: 3px;
        background: var(--border);
        margin-bottom: 0.75rem;
        overflow: hidden;
      }

      .mc-data-bar-fill {
        height: 100%;
        border-radius: 3px;
        background: linear-gradient(90deg, var(--positive), #34d399);
        transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .mc-data-tag {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.25rem 0.7rem;
        border-radius: 100px;
        background: var(--positive-soft);
        color: var(--positive);
      }

      .mc-data-footer {
        font-size: 0.6rem;
        color: var(--ink-muted);
        margin-top: 0.85rem;
        padding-top: 0.7rem;
        border-top: 1px solid var(--border-light);
      }

      /* ─── Reasons ─── */
      .mc-reasons {
        display: grid;
        gap: 1rem;
      }

      .mc-reason-item {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        padding: 1.5rem 1.75rem;
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-left: 4px solid var(--accent);
        border-radius: 2px var(--radius) var(--radius) 2px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .mc-reason-item:hover {
        transform: translateX(4px);
        box-shadow: var(--shadow-md);
      }

      .mc-reason-num {
        font-family: 'Instrument Serif', serif;
        font-size: 2rem;
        font-weight: 400;
        color: var(--accent);
        line-height: 1;
        flex-shrink: 0;
        opacity: 0.5;
      }

      .mc-reason-text {
        font-size: 0.9rem;
        line-height: 1.7;
        color: var(--ink);
        margin: 0;
      }

      .mc-reason-text strong {
        color: var(--ink);
        font-weight: 700;
      }

      /* ─── Criteri ─── */
      .mc-criteri-list {
        list-style: none;
        padding: 0;
        margin: 0 0 2.5rem;
        display: grid;
        gap: 0.65rem;
      }

      .mc-criteri-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.88rem;
        color: var(--ink);
        padding: 1rem 1.35rem;
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-radius: 10px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.15s, box-shadow 0.15s;
      }

      .mc-criteri-item:hover {
        transform: translateX(3px);
        box-shadow: var(--shadow-md);
      }

      .mc-criteri-check {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        background: var(--positive-soft);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--positive);
      }

      .mc-criteri-check svg {
        width: 13px;
        height: 13px;
      }

      .mc-criteri-transition {
        font-family: 'Instrument Serif', serif;
        font-style: italic;
        font-size: 1.15rem;
        color: var(--ink);
        line-height: 1.55;
        margin: 0;
        padding-left: 1rem;
        border-left: 3px solid var(--accent);
      }

      /* ─── Lista (dark glass block) ─── */
      .mc-lista-outer {
        background: var(--ink);
        margin: 0;
        padding: 5rem 1.5rem;
        position: relative;
        overflow: hidden;
      }

      .mc-lista-outer::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 20% 30%, rgba(79, 70, 229, 0.12) 0%, transparent 50%),
          radial-gradient(circle at 80% 70%, rgba(5, 150, 105, 0.08) 0%, transparent 50%);
        pointer-events: none;
      }

      .mc-lista-outer::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle, rgba(255,255,255,0.03) 0.5px, transparent 0.5px);
        background-size: 24px 24px;
        pointer-events: none;
      }

      .mc-lista-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 1;
      }

      .mc-lista-rows {
        display: grid;
        gap: 0.55rem;
      }

      .mc-lista-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.8rem 1.15rem;
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(8px);
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: background 0.2s;
      }

      .mc-lista-row:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .mc-lista-lock {
        width: 14px;
        height: 14px;
        color: rgba(255, 255, 255, 0.25);
        flex-shrink: 0;
      }

      .mc-lista-blur {
        flex: 1;
        height: 14px;
        border-radius: 4px;
        background: linear-gradient(90deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.03) 100%);
        position: relative;
        overflow: hidden;
      }

      .mc-lista-blur::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
        animation: shimmer 2.5s ease-in-out infinite;
      }

      @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
      }

      .mc-lista-tag {
        font-size: 0.62rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.5);
        padding: 0.2rem 0.6rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        white-space: nowrap;
        letter-spacing: 0.03em;
      }

      .mc-lista-text {
        text-align: left;
      }

      .mc-lista-text h3 {
        font-family: 'Instrument Serif', serif;
        font-size: 1.6rem;
        font-weight: 400;
        margin: 0 0 0.85rem;
        color: #fff;
        line-height: 1.3;
      }

      .mc-lista-text p {
        font-size: 0.88rem;
        color: rgba(255, 255, 255, 0.55);
        line-height: 1.7;
        margin: 0 0 1.75rem;
      }

      .mc-btn-unlock {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--accent);
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.9rem 2rem;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        letter-spacing: 0.01em;
      }

      .mc-btn-unlock:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(79, 70, 229, 0.35);
      }

      .mc-lista-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 800;
      }

      /* ─── Persona ─── */
      .mc-persona-block {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        padding: 2rem 2.25rem;
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-left: 4px solid var(--accent);
        border-radius: 2px var(--radius) var(--radius) 2px;
        box-shadow: var(--shadow-md);
      }

      .mc-persona-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(26, 26, 46, 0.12);
        border: 3px solid var(--surface);
        outline: 1px solid var(--border);
      }

      .mc-persona-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .mc-persona-info h3 {
        font-family: 'Instrument Serif', serif;
        font-size: 1.25rem;
        font-weight: 400;
        margin: 0 0 0.2rem;
        color: var(--ink);
      }

      .mc-persona-info .mc-persona-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        margin: 0 0 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .mc-persona-info .mc-persona-bio {
        font-size: 0.85rem;
        color: var(--ink-soft);
        line-height: 1.65;
        margin: 0;
      }

      /* ─── CTA Finale ─── */
      .mc-cta-finale {
        padding: 5rem 0;
        text-align: center;
        position: relative;
      }

      .mc-cta-finale::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
        pointer-events: none;
      }

      .mc-cta-finale .mc-container {
        position: relative;
        z-index: 1;
      }

      .mc-cta-finale h2 {
        font-family: 'Instrument Serif', serif;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 400;
        line-height: 1.3;
        margin: 0 0 0.75rem;
        color: var(--ink);
      }

      .mc-cta-finale h2 em {
        font-style: italic;
        color: var(--accent);
      }

      .mc-cta-finale > .mc-container > p:first-of-type {
        color: var(--ink-soft);
        font-size: 0.92rem;
        margin: 0 auto 2.5rem;
        max-width: 440px;
        line-height: 1.7;
      }

      .mc-btn-wa {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        background: var(--wa-green);
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 1rem 2.25rem;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(37, 211, 102, 0.25);
      }

      .mc-btn-wa:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(37, 211, 102, 0.35);
      }

      .mc-btn-wa svg {
        flex-shrink: 0;
      }

