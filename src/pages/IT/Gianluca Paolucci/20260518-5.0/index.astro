---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ITComplianceFooter from '@/pages/IT/components/ITComplianceFooter.astro'
import paolucciAvatar from '../20260517-1.0/images/paolucci.png'

const BRAND = {
  nome: 'Bussola Mercati',
  payoff: 'Osservatorio indipendente sui mercati italiani',
}

const PERSONA = {
  nome: 'Gianluca Paolucci',
  titolo: 'Analista indipendente dei mercati finanziari italiani',
  avatar: paolucciAvatar.src,
}

const title = 'Bussola Mercati — I tuoi risparmi perdono valore ogni giorno'
const description = 'L\'inflazione erode il potere d\'acquisto dei tuoi risparmi. Scopri cosa sta succedendo sui mercati italiani e ricevi analisi gratuite su WhatsApp.'
---

<BaseLayout title={title} description={description} lang="it">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Lora:ital,wght@0,400;0,700;1,700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #FFFFFF;
        --ink: #1A1A1A;
        --ink-soft: #6B6B6B;
        --rosso: #B71C1C;
        --rule: #1A1A1A;
        --rule-light: #E0E0E0;
        --wa-green: #25D366;
        --max-w: 720px;
      }

      body {
        font-family: 'Source Sans 3', sans-serif;
        background-color: var(--bg);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        margin: 0;
        padding: 0;
      }

      h1, h2, h3, .serif {
        font-family: 'Lora', serif;
      }

      .mono {
        font-family: 'JetBrains Mono', monospace;
      }

      .bn-container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* ─── SECTION DIVIDERS ─── */
      .bn-hero,
      .bn-data,
      .bn-quote,
      .bn-persona,
      .bn-benefits {
        border-bottom: 3px solid var(--rule);
      }

      /* ─── SECTION 1: BREAKING HERO ─── */
      .bn-hero {
        padding: 3rem 0 2.5rem;
      }

      .bn-breaking-tag {
        display: inline-block;
        background: var(--rosso);
        color: #fff;
        font-family: 'Source Sans 3', sans-serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        padding: 0.3em 0.75em;
        margin-bottom: 1.25rem;
      }

      .bn-hero h1 {
        font-family: 'Lora', serif;
        font-size: clamp(1.8rem, 5vw, 2.75rem);
        font-weight: 700;
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 1.25rem;
      }

      .bn-typewriter {
        border-right: 3px solid var(--rosso);
        padding-right: 2px;
        animation: bn-blink 0.8s step-end infinite;
        color: var(--rosso);
      }

      @keyframes bn-blink {
        0%, 100% { border-right-color: var(--rosso); }
        50% { border-right-color: transparent; }
      }

      .bn-hero-sub {
        font-family: 'Lora', serif;
        font-size: 1.05rem;
        line-height: 1.75;
        color: var(--ink);
        font-style: italic;
        margin: 0 0 1.75rem;
      }

      .bn-hero-sub strong {
        color: var(--rosso);
        font-family: 'JetBrains Mono', monospace;
        font-style: normal;
        font-weight: 700;
      }

      .bn-byline {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.82rem;
        color: var(--ink-soft);
      }

      .bn-byline img {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
      }

      /* ─── SECTION 2: DATA IMPACT ─── */
      .bn-data {
        padding: 2.5rem 0;
      }

      .bn-data h2 {
        font-family: 'Lora', serif;
        font-size: clamp(1.2rem, 3vw, 1.6rem);
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 2rem;
      }

      .bn-data-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .bn-data-card {
        padding: 1.25rem 0;
        border-top: 3px solid var(--rule);
      }

      .bn-data-number {
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(2.2rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--ink);
        line-height: 1;
        display: block;
        margin-bottom: 0.5rem;
      }

      .bn-data-number.negative {
        color: var(--rosso);
      }

      .bn-data-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.4;
        margin-bottom: 0.6rem;
        display: block;
      }

      .bn-data-source {
        font-size: 0.65rem;
        color: var(--ink-soft);
        line-height: 1.5;
        border-top: 1px solid var(--rule-light);
        padding-top: 0.6rem;
        margin-top: 0.6rem;
        display: block;
      }

      /* ─── SECTION 3: EDITORIAL QUOTE ─── */
      .bn-quote {
        background: #FAFAFA;
        padding: 3rem 0;
      }

      .bn-quote blockquote {
        font-family: 'Lora', serif;
        font-size: clamp(1.25rem, 3vw, 1.85rem);
        font-weight: 700;
        font-style: italic;
        color: var(--ink);
        margin: 0;
        padding-left: 2rem;
        border-left: 4px solid var(--rosso);
        line-height: 1.45;
      }

      /* ─── SECTION 4: PERSONA ─── */
      .bn-persona {
        padding: 2rem 0;
      }

      .bn-persona-row {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .bn-persona-row img {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
      }

      .bn-persona-name {
        font-family: 'Lora', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ink);
        display: block;
        margin-bottom: 0.2rem;
      }

      .bn-persona-title {
        font-size: 0.82rem;
        color: var(--ink-soft);
        display: block;
      }

      /* ─── SECTION 5: BENEFITS ─── */
      .bn-benefits {
        padding: 2.5rem 0;
      }

      .bn-benefits h2 {
        font-family: 'Lora', serif;
        font-size: clamp(1.2rem, 3vw, 1.5rem);
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 1.5rem;
      }

      .bn-benefits-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .bn-benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule-light);
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--ink);
      }

      .bn-benefit-item:last-child {
        border-bottom: none;
      }

      .bn-benefit-icon {
        flex-shrink: 0;
        margin-top: 2px;
      }

      /* ─── SECTION 6: CTA ─── */
      .bn-cta {
        padding: 3rem 0 2.5rem;
        text-align: center;
      }

      .bn-cta h2 {
        font-family: 'Lora', serif;
        font-size: clamp(1.3rem, 3.5vw, 1.85rem);
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 1rem;
      }

      .bn-cta p {
        font-size: 1rem;
        color: var(--ink-soft);
        line-height: 1.6;
        margin: 0 0 2rem;
        max-width: 520px;
        margin-left: auto;
        margin-right: auto;
      }

      .bn-btn-wa-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
      }

      .bn-btn-wa {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        background: var(--wa-green);
        color: #fff;
        font-family: 'Source Sans 3', sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none;
        border: none;
        cursor: pointer;
        padding: 1rem 2.25rem;
        width: 100%;
        max-width: 420px;
        border-radius: 0;
        transition: background 0.2s ease;
      }

      .bn-btn-wa:hover {
        background: #1ebe5d;
      }

      .bn-guarantee {
        font-size: 0.72rem;
        color: var(--ink-soft);
        margin: 0;
        line-height: 1.6;
      }

      /* ─── RESPONSIVE ─── */
      @media (max-width: 768px) {
        .bn-data-grid {
          grid-template-columns: 1fr;
        }

        .bn-btn-wa {
          width: 100%;
          max-width: 100%;
        }
      }

      @media (max-width: 480px) {
        .bn-hero {
          padding: 2rem 0 1.75rem;
        }

        .bn-hero h1 {
          font-size: 1.55rem;
        }
      }
    </style>
  </Fragment>

  <!-- ─── SECTION 1: BREAKING HERO ─── -->
  <section class="bn-hero">
    <div class="bn-container">
      <span class="bn-breaking-tag reveal">Ultime Notizie · Mercati</span>
      <h1 class="reveal">
        I tuoi risparmi perdono valore <span class="bn-typewriter" id="bn-typewriter"></span>
      </h1>
      <p class="bn-hero-sub reveal">
        L'inflazione in Italia è al <strong>2,0%</strong>. Il tuo conto deposito rende meno dell'<strong>1%</strong>.
        Ogni giorno che passa, il tuo potere d'acquisto si riduce.
        Non è un'opinione — sono i numeri ufficiali.
      </p>
      <div class="bn-byline reveal">
        <img src={PERSONA.avatar} alt={PERSONA.nome} width="32" height="32" />
        <span>A cura di {PERSONA.nome} · Aggiornato a maggio 2026</span>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 2: DATA IMPACT ─── -->
  <section class="bn-data">
    <div class="bn-container">
      <h2 class="reveal">I numeri che il tuo conto in banca non ti mostra</h2>
      <div class="bn-data-grid">
        <div class="bn-data-card reveal">
          <span class="bn-data-number" data-countup="2.0" data-suffix="%">2,0%</span>
          <span class="bn-data-label">Inflazione annua in Italia</span>
          <span class="bn-data-source">Fonte: ISTAT, rilevazione aprile 2026. Dato NIC (indice nazionale dei prezzi al consumo).</span>
        </div>
        <div class="bn-data-card reveal">
          <span class="bn-data-number negative" data-countup="-1580" data-prefix="€" data-duration="2000">−€1.580</span>
          <span class="bn-data-label">Perdita reale su €100.000 in un anno</span>
          <span class="bn-data-source">Stima indicativa basata su differenziale inflazione/rendimento medio depositi. Non costituisce consulenza finanziaria.</span>
        </div>
        <div class="bn-data-card reveal">
          <span class="bn-data-number negative" data-countup="-1.2" data-suffix="%">−1,2%</span>
          <span class="bn-data-label">Gap tra rendimento depositi e inflazione</span>
          <span class="bn-data-source">Rendimento medio conto deposito vincolato a 12 mesi: ~0,8%. Fonte: elaborazione su dati Banca d'Italia.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 3: EDITORIAL QUOTE ─── -->
  <section class="bn-quote">
    <div class="bn-container">
      <blockquote class="reveal">
        La domanda non è se i mercati saliranno. È se i tuoi soldi possono permettersi di aspettare.
      </blockquote>
    </div>
  </section>

  <!-- ─── SECTION 4: PERSONA ─── -->
  <section class="bn-persona">
    <div class="bn-container">
      <div class="bn-persona-row reveal">
        <img src={PERSONA.avatar} alt={PERSONA.nome} width="56" height="56" />
        <div>
          <span class="bn-persona-name">{PERSONA.nome}</span>
          <span class="bn-persona-title">{PERSONA.titolo}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 5: BENEFITS ─── -->
  <section class="bn-benefits">
    <div class="bn-container">
      <h2 class="reveal">Cosa ricevi, gratuitamente</h2>
      <ul class="bn-benefits-list">
        <li class="bn-benefit-item reveal">
          <svg class="bn-benefit-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="10" cy="10" r="10" fill="#B71C1C"/>
            <path d="M5.5 10.5L8.5 13.5L14.5 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Analisi di mercato aggiornate, in italiano, senza gergo tecnico</span>
        </li>
        <li class="bn-benefit-item reveal">
          <svg class="bn-benefit-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="10" cy="10" r="10" fill="#B71C1C"/>
            <path d="M5.5 10.5L8.5 13.5L14.5 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Nessuna promessa di rendimento — solo informazione e contesto</span>
        </li>
        <li class="bn-benefit-item reveal">
          <svg class="bn-benefit-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="10" cy="10" r="10" fill="#B71C1C"/>
            <path d="M5.5 10.5L8.5 13.5L14.5 7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Disiscrizione in un tocco, nessuno spam, zero obblighi</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ─── SECTION 6: CTA ─── -->
  <section class="bn-cta">
    <div class="bn-container">
      <h2 class="serif reveal">I tuoi risparmi sono davvero al sicuro?</h2>
      <p class="reveal">Ricevi gratuitamente le analisi di mercato più aggiornate, direttamente su WhatsApp.</p>
      <div class="bn-btn-wa-wrap reveal">
        <button class="bn-btn-wa link-btn" onclick="window.onLinkBtnClick()">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Ricevi le analisi su WhatsApp — Gratis
        </button>
      </div>
      <p class="bn-guarantee reveal">Gratuito · Nessun obbligo · Nessuna promessa di rendimento · Disiscrizione libera</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const el = document.getElementById('bn-typewriter')
      if (!el) return
      const text = 'ogni giorno. Ecco cosa sta succedendo.'
      let i = 0
      function type() {
        if (i < text.length) {
          el.textContent += text.charAt(i)
          i++
          setTimeout(type, 45)
        }
      }
      setTimeout(type, 600)
    })();

    (function () {
      const counters = document.querySelectorAll('[data-countup]')
      const observed = new Set()

      function animateCount(el) {
        const target = parseFloat(el.getAttribute('data-countup'))
        const prefix = el.getAttribute('data-prefix') || ''
        const suffix = el.getAttribute('data-suffix') || ''
        const duration = parseInt(el.getAttribute('data-duration')) || 1500
        const isNeg = target < 0
        const abs = Math.abs(target)
        const decimals = (String(abs).split('.')[1] || '').length
        const start = performance.now()

        function step(now) {
          const progress = Math.min((now - start) / duration, 1)
          const eased = 1 - Math.pow(1 - progress, 3)
          const current = eased * abs
          const formatted = current.toFixed(decimals)
          el.textContent = (isNeg ? '−' : '') + prefix + formatted + suffix
          if (progress < 1) requestAnimationFrame(step)
        }
        requestAnimationFrame(step)
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !observed.has(entry.target)) {
            observed.add(entry.target)
            animateCount(entry.target)
          }
        })
      }, { threshold: 0.3 })

      counters.forEach((el) => io.observe(el))
    })();

    (function () {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active')
              observer.unobserve(entry.target)
            }
          })
        },
        { threshold: 0.12 },
      )
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
    })();
  </script>

  <ITComplianceFooter brand={BRAND} />
</BaseLayout>
