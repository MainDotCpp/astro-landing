  <script type="module" src="/src/utils/jump.ts"></script>
<script is:inline>
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('active'), idx * 70);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('active'));
    }

    // Reveal floating CTA only after the user scrolls past the hero — avoids competing with hero CTA
    const floatCta = document.querySelector('.float-cta');
    const heroEl = document.querySelector('.hero');
    if (floatCta && heroEl && 'IntersectionObserver' in window) {
      const heroIo = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio > 0.2) {
            floatCta.classList.remove('is-visible');
          } else {
            floatCta.classList.add('is-visible');
          }
        });
      }, { threshold: [0, 0.2, 0.5, 1] });
      heroIo.observe(heroEl);
    } else if (floatCta) {
      floatCta.classList.add('is-visible');
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const slot = el.getAttribute('data-cta') || 'unknown';
          try {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'cta_click', {
                event_category: 'whatsapp_channel',
                event_label: slot,
                page_path: '/CA/20260524-4.0/',
              });
            }
            // FB Pixel custom event for any CTA (incl. floating sticky)
            if (typeof fbq !== 'undefined') {
              fbq('trackCustom', 'WhatsAppCTAClick', { slot });
            }
          } catch (e) { /* swallow */ }
        });
      });

      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    });
  </script>
