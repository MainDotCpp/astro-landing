---
import { getImage } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'
import calgarySrc from './images/calgary-dusk.png'
import controlSrc from './images/control-room.png'
import flowSrc from './images/flow-to-payout.png'
import heroSrc from './images/hero-prairie-dusk.png'
import pipeSrc from './images/pipe-yard.png'

const HERO_W = 1100
const hero = await getImage({ src: heroSrc, format: 'webp', width: HERO_W, quality: 72 })

const BAND_W = 1000
const pipe = await getImage({ src: pipeSrc, format: 'webp', width: BAND_W, quality: 74 })
const pipeH = Math.round(BAND_W * pipeSrc.height / pipeSrc.width)
const control = await getImage({ src: controlSrc, format: 'webp', width: BAND_W, quality: 74 })
const controlH = Math.round(BAND_W * controlSrc.height / controlSrc.width)

const FIG_W = 880
const flow = await getImage({ src: flowSrc, format: 'webp', width: FIG_W, quality: 76 })
const flowH = Math.round(FIG_W * flowSrc.height / flowSrc.width)

const POR_W = 760
const calgary = await getImage({ src: calgarySrc, format: 'webp', width: POR_W, quality: 78 })
const calgaryH = Math.round(POR_W * calgarySrc.height / calgarySrc.width)

const MAX = 4.84
const yields = [
  { name: 'Enbridge', note: 'Pipelines. Paid on volume moved, under long-term contract.', pct: 4.84 },
  { name: 'Best one-year GIC', note: "Locked in for twelve months. You can't touch it.", pct: 3.6 },
  { name: 'Royal Bank', note: 'Raised its quarterly payout 7.3% in the second quarter.', pct: 2.83 },
  { name: 'TD', note: 'Now reviews its dividend twice a year instead of once.', pct: 2.52 },
  { name: 'Bank of Canada rate', note: 'Held at this level six meetings running.', pct: 2.25 },
]
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>The Cheque Clears Even If You Don't Believe in Oil</title>
    <meta
      name="description"
      content="Oil went from US$117 to US$55 and back to US$78 inside a year. The toll a pipeline charges to move it never moved at all. Enbridge has raised its dividend 31 years running. A plain look at how Canadian energy income actually works, plus free morning notes on WhatsApp."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style
      define:vars={{
        heroImg: `url(${hero.src})`,
      }}
    >
      :root {
        --night: #16130f;
        --soil: #241d16;
        --soil-2: #2f2619;
        --rust: #c2532a;
        --wheat: #e0b872;
        --text: #f2ece2;
        --mut: #a89c8c;
        --dim: #7b7062;
        --edge: rgba(242, 236, 226, 0.13);
        --wa: #25d366;
        --wa-d: #1bae52;
        --display: 'Anton', Impact, sans-serif;
        --sans: 'Inter Tight', system-ui, -apple-system, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        font-family: var(--sans);
        background: var(--night);
        color: var(--text);
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: calc(80px + env(safe-area-inset-bottom));
      }
      img { display: block; max-width: 100%; height: auto; }

      .wrap { width: 100%; padding-inline: 22px; }

      /* ---------- hero ---------- */
      .hero {
        display: flex;
        align-items: flex-end;
        min-height: 100svh;
        padding-top: calc(env(safe-area-inset-top) + 56px);
        padding-bottom: 104px;
        background-image:
          linear-gradient(180deg, rgba(22, 19, 15, 0.55) 0%, rgba(22, 19, 15, 0.35) 40%, rgba(22, 19, 15, 0.94) 100%),
          var(--heroImg);
        background-size: cover, cover;
        background-position: center, 50% 55%;
        background-repeat: no-repeat;
      }
      .hero h1 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(2.5rem, 12vw, 4.1rem);
        line-height: 0.98;
        letter-spacing: -0.02em;
        text-transform: none;
        text-wrap: balance;
      }
      .hero h1 span { color: var(--wheat); }
      .hero .lede {
        margin-top: 20px;
        font-size: 1.04rem;
        color: var(--mut);
        max-width: 45ch;
      }
      .acts { margin-top: 28px; }

      /* ---------- buttons ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 16px 24px;
        border: none;
        border-radius: 4px;
        background: var(--rust);
        color: #fff6f0;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.14s ease;
        box-shadow: 0 16px 40px -20px rgba(194, 83, 42, 0.95);
      }
      .btn svg { width: 17px; height: 17px; flex: none; }
      .btn:hover { background: #d76237; transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn:focus-visible { outline: 3px solid var(--wheat); outline-offset: 3px; }

      /* ---------- text band ---------- */
      .tband { background: var(--soil); padding: 58px 0; }
      .tband.alt { background: var(--soil-2); }
      h2 {
        font-family: var(--sans);
        font-weight: 700;
        font-size: clamp(1.5rem, 6.2vw, 2.1rem);
        line-height: 1.16;
        letter-spacing: -0.032em;
        text-wrap: balance;
      }
      .body {
        margin-top: 16px;
        font-size: 1.02rem;
        color: var(--mut);
        max-width: 60ch;
      }
      .body + .body { margin-top: 13px; }
      .body strong { color: var(--text); font-weight: 600; }

      /* ---------- photo band ---------- */
      .band { overflow: hidden; background: var(--night); }
      .band img { width: 100%; transform: scale(1.06); }
      .js .band.in img { transform: scale(1); transition: transform 1.1s cubic-bezier(0.22, 0.8, 0.3, 1); }
      .cap {
        padding: 14px 22px 20px;
        font-size: 0.82rem;
        line-height: 1.55;
        color: var(--dim);
        background: var(--night);
      }

      /* ---------- pull quote ---------- */
      .pull {
        background: var(--night);
        padding: 46px 0 52px;
      }
      .pull p {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(1.6rem, 7vw, 2.4rem);
        line-height: 1.1;
        letter-spacing: -0.015em;
        color: var(--wheat);
        max-width: 22ch;
      }

      /* ---------- yield bars ---------- */
      .bars { margin-top: 28px; }
      .row { padding: 16px 0; border-top: 1px solid var(--edge); }
      .row:last-child { border-bottom: 1px solid var(--edge); }
      .rowtop { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
      .rname { font-weight: 600; font-size: 0.98rem; }
      .rpct {
        font-family: var(--display);
        font-weight: 400;
        font-size: 1.5rem;
        color: var(--wheat);
        letter-spacing: 0;
        font-variant-numeric: tabular-nums;
      }
      .bar {
        margin-top: 9px;
        height: 7px;
        background: rgba(242, 236, 226, 0.09);
        border-radius: 4px;
        overflow: hidden;
      }
      .bar i { display: block; height: 100%; width: 0; background: var(--rust); border-radius: 4px; }
      .js .bars.in .bar i { width: var(--w); transition: width 0.9s cubic-bezier(0.22, 0.8, 0.3, 1); }
      .rnote { margin-top: 8px; font-size: 0.84rem; color: var(--dim); }
      .caveat { margin-top: 18px; font-size: 0.82rem; line-height: 1.6; color: var(--dim); max-width: 58ch; }

      figure { margin-top: 26px; }
      figure img { border: 1px solid var(--edge); border-radius: 3px; width: 100%; }
      figcaption { margin-top: 11px; font-size: 0.82rem; line-height: 1.55; color: var(--dim); }

      .fine { margin-top: 15px; font-size: 0.8rem; color: var(--dim); }

      .foot { padding: 32px 0 40px; background: var(--night); border-top: 1px solid var(--edge); }
      .foot p { font-size: 0.77rem; line-height: 1.62; color: var(--dim); max-width: 70ch; }

      /* ---------- sticky whatsapp ---------- */
      .wa-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 11px 0 calc(11px + env(safe-area-inset-bottom));
        background: rgba(22, 19, 15, 0.94);
        backdrop-filter: blur(10px);
        border-top: 1px solid var(--edge);
      }
      .wa-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 52px;
        border: none;
        border-radius: 4px;
        background: var(--wa);
        color: #04220f;
        font-family: var(--sans);
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .wa-btn svg { width: 21px; height: 21px; flex: none; }
      .wa-btn:hover { background: #34e075; }
      .wa-btn:focus-visible { outline: 3px solid var(--wheat); outline-offset: 3px; }

      /* ---------- reveal ---------- */
      .js .reveal { opacity: 0; transform: translateY(16px); }
      .js .reveal.in {
        opacity: 1;
        transform: none;
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.8, 0.3, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        .js .reveal { opacity: 1; transform: none; }
        .js .band img { transform: none; }
        .js .bars .bar i { width: var(--w); }
        html { scroll-behavior: auto; }
      }

      /* ---------- progressive enhancement ---------- */
      @media (min-width: 640px) {
        .wrap { max-width: 700px; margin-inline: auto; padding-inline: 32px; }
        .btn, .wa-btn { width: auto; min-width: 300px; }
        .acts { display: flex; }
        .cap { max-width: 764px; margin-inline: auto; padding-inline: 32px; }
      }
      @media (min-width: 900px) {
        .tband { padding: 84px 0; }
        .hero { padding-bottom: 92px; }
        .pull { padding: 66px 0 72px; }
        .rpct { font-size: 1.75rem; }
      }
      @media (min-width: 1120px) {
        .wrap { max-width: 960px; }
        .cap { max-width: 1024px; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap">
        <h1 class="reveal">The cheque clears even if you <span>don't believe in oil</span>.</h1>
        <p class="lede reveal">
          A pipeline is paid to move the barrel, not to guess what the barrel sells for. That gap is
          the whole difference between an Alberta producer and the pipe it ships through, and it's
          why one of them keeps paying through a year the other one would rather forget.
        </p>
        <div class="acts reveal">
          <button type="button" class="btn link-btn" onclick="onLinkBtnClick()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ WHERE THE CHEQUE COMES FROM ============ -->
    <section class="tband">
      <div class="wrap">
        <h2 class="reveal">Where the cheque actually comes from</h2>
        <p class="body reveal">
          Energy has had a wild year. Crude went over <strong>US$117</strong> when the Middle East
          flared up, then gave the lot back — <strong>US$55</strong> at the bottom, about
          <strong>US$78</strong> this morning. Energy ended up the best-performing sector on the TSX.
          Good luck to anyone who tried to trade that.
        </p>
        <p class="body reveal">
          The tolls never moved. Enbridge collected the same contracted rate on a barrel at US$117
          and at US$55, and raised its dividend for the <strong>31st straight year</strong> either
          way. Suncor, which does ride the price, put up <strong>$4 billion</strong> in adjusted
          funds from operations in the first quarter on record production, and pays 60 cents a share
          on September 25.
        </p>
        <p class="body reveal">
          Thirty-one years covers four oil crashes, a financial crisis and a pandemic. Something in
          that business model does not care what oil costs. It's worth knowing what.
        </p>
      </div>
    </section>

    <!-- ============ PHOTO BAND ============ -->
    <div class="band reveal">
      <img
        src={pipe.src}
        width={BAND_W}
        height={pipeH}
        alt="Stacked large-diameter steel pipe sections in a winter storage yard, snow on the gravel between the rows."
        loading="lazy"
        decoding="async"
      />
    </div>
    <p class="cap">
      Pipe waiting to go in the ground. Once it's buried, it gets paid by the barrel for decades and
      nobody photographs it again.
    </p>

    <!-- ============ THE CHAIN ============ -->
    <section class="tband alt">
      <div class="wrap">
        <h2 class="reveal">The chain, end to end</h2>
        <p class="body reveal">
          A barrel leaves a wellhead north of Fort Mac. It goes through a gathering system, onto a
          mainline, and eventually to a terminal or a refinery. Somebody owns each of those steps and
          charges for it.
        </p>
        <p class="body reveal">
          The producer sells the barrel and lives on what it fetches. The pipeline charges to move
          it, under contracts written years in advance. A good share of that capacity is
          <strong>take-or-pay</strong>: the shipper pays for the space whether or not it fills it.
        </p>
        <p class="body reveal">
          Toll isn't my metaphor, by the way. It's the word on the tariff sheet the regulator sees.
          And the other thing about a buried pipe is that nobody is getting a new right of way
          approved to compete with it. Ask anyone who tried.
        </p>

        <figure class="reveal">
          <img
            src={flow.src}
            width={FIG_W}
            height={flowH}
            alt="An engineering-style schematic of the flow of funds from wellhead through gathering system, mainline, export terminal, contracted toll and quarterly dividend."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Six steps between a well north of Fort Mac and the cheque. The toll is charged on volume, not
            on price.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ YIELD BARS ============ -->
    <section class="tband">
      <div class="wrap">
        <h2 class="reveal">What the same dollar earns, depending on where you park it</h2>
        <p class="body reveal">
          The Bank of Canada has held its policy rate at 2.25% for six meetings running. That's the
          floor under everything conservative, and it's the number the rest of this list has to beat
          to be worth the trouble.
        </p>

        <div class="bars reveal">
          {yields.map(y => (
            <div class="row">
              <div class="rowtop">
                <span class="rname">{y.name}</span>
                <span class="rpct">{y.pct.toFixed(2).replace(/\.?0+$/, '')}%</span>
              </div>
              <div class="bar"><i style={`--w:${Math.round(y.pct / MAX * 100)}%`}></i></div>
              <p class="rnote">{y.note}</p>
            </div>
          ))}
        </div>

        <p class="caveat">
          A higher yield isn't automatically a better deal. Sometimes it means the market has doubts
          about the payout, and a GIC can't fall 30% while a pipeline share can. The comparison is
          about what you're being paid to accept, not which number is biggest.
        </p>
      </div>
    </section>

    <!-- ============ PHOTO BAND 2 ============ -->
    <div class="band reveal">
      <img
        src={control.src}
        width={BAND_W}
        height={controlH}
        alt="Two operators seen from behind in a pipeline control room, watching a curved wall of schematic flow displays."
        loading="lazy"
        decoding="async"
      />
    </div>
    <p class="cap">
      A pipeline control centre. Somebody is watching this at 3 a.m. This is the asset.
    </p>

    <section class="pull">
      <div class="wrap">
        <p class="reveal">Nobody puts a pipeline toll on the evening news. That's roughly the point.</p>
      </div>
    </section>

    <!-- ============ CALGARY ============ -->
    <section class="tband alt">
      <div class="wrap">
        <h2 class="reveal">Calgary, 7 a.m.</h2>
        <p class="body reveal">
          Toronto opens at 7:30 Mountain, which is why the lights in those towers are on before the
          rest of the country has poured its first coffee. Quarterly results, dividend declarations,
          moves in the WCS differential and pipeline outages all land in that window.
        </p>
        <p class="body reveal">
          Almost none of it is dramatic. It's a slow pile-up of small facts about contracts and
          capacity. Easy to miss, if nobody's reading it for you.
        </p>

        <figure class="reveal">
          <img
            src={calgary.src}
            width={POR_W}
            height={calgaryH}
            alt="Downtown Calgary at blue hour on a winter morning, office lights on in scattered floors of the glass towers."
            loading="lazy"
            decoding="async"
          />
          <figcaption>Calgary, before the bell.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="tband">
      <div class="wrap">
        <h2 class="reveal">Every trading day, 7:15 Mountain</h2>
        <p class="body reveal">
          What was declared, where the WCS differential went, and which contracts are up for renewal.
          Three things. Plain English, before the open, under 200 words. No tips, no targets.
        </p>

        <div class="acts reveal">
          <button type="button" class="btn link-btn" onclick="onLinkBtnClick()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <p class="fine reveal">Free · no forms, no fees · leave whenever you like</p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <p>
          Everything here is general market commentary and educational research. It doesn't take
          your objectives or financial situation into account and it's not a recommendation to buy
          or sell anything. Yields quoted move with share prices, and dividends can be cut. Energy
          shares are cyclical and can fall sharply. Do your own research before you invest.
        </p>
      </div>
    </footer>

    <div class="wa-bar">
      <div class="wrap">
        <button type="button" class="wa-btn link-btn" onclick="onLinkBtnClick()">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.04c-.24.68-1.4 1.3-1.94 1.38-.5.07-1.13.1-1.82-.11-.42-.13-.96-.31-1.65-.61-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.19-1.58-1.19-3.01 0-1.43.75-2.14 1.02-2.43.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.19.73-.85.92-1.14.19-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.71-.17 1.39z" /></svg>
          Join the free group
        </button>
      </div>
    </div>

    <script is:inline>
      ;(function () {
        var items = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!items.length) return

        function tick() {
          var vh = window.innerHeight || document.documentElement.clientHeight
          for (var i = items.length - 1; i >= 0; i--) {
            var r = items[i].getBoundingClientRect()
            if (r.top < vh - 60) {
              items[i].classList.add('in')
              items.splice(i, 1)
            }
          }
          if (!items.length) {
            window.removeEventListener('scroll', tick)
            window.removeEventListener('resize', tick)
          }
        }

        window.addEventListener('scroll', tick, { passive: true })
        window.addEventListener('resize', tick)
        tick()
        setTimeout(tick, 300)
      })()
    </script>
  </body>
</html>
