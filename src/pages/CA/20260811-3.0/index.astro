---
import { getImage } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'
import ladderSrc from './images/energy-ladder.png'
import cashSrc from './images/cash-machine.png'
import lngSrc from './images/lng-economics.png'
import mapSrc from './images/west-canada-map.png'

const FIG_W = 880
const mapFig = await getImage({ src: mapSrc, format: 'webp', width: FIG_W, quality: 76 })
const mapH = Math.round(FIG_W * mapSrc.height / mapSrc.width)

const PLATE_W = 720
const cash = await getImage({ src: cashSrc, format: 'webp', width: PLATE_W, quality: 76 })
const cashH = Math.round(PLATE_W * cashSrc.height / cashSrc.width)
const lng = await getImage({ src: lngSrc, format: 'webp', width: PLATE_W, quality: 76 })
const lngH = Math.round(PLATE_W * lngSrc.height / lngSrc.width)

const POR_W = 760
const ladder = await getImage({ src: ladderSrc, format: 'webp', width: POR_W, quality: 78 })
const ladderH = Math.round(POR_W * ladderSrc.height / ladderSrc.width)

const tape = [
  { metric: 'LNG Canada', px: '14 Mt', unit: '/yr', note: 'Phase 1 at nameplate, first cargo June 2025' },
  { metric: 'TMX', px: '-US$8', unit: '/bbl', note: 'WCS discount narrowed since expansion started' },
  { metric: 'Oil sands', px: 'C$2.4B', unit: ' Q2', note: 'returned to shareholders in a single quarter' },
]

const gainers = [
  { name: 'Cameco', tk: 'CCO', pct: 42.8 },
  { name: 'Canadian Natural', tk: 'CNQ', pct: 28.5 },
  { name: 'Suncor Energy', tk: 'SU', pct: 22.1 },
  { name: 'S&P/TSX Composite', tk: 'the broad market', pct: 6.25 },
]
const maxPct = gainers[0].pct

const deals = [
  {
    who: 'LNG Canada',
    tk: 'Phase 1 · Kitimat',
    got: 'First LNG cargo shipped June 30, 2025, aboard the Gaslog Glasgow. Both trains now running. Surpassed one million tonnes exported in a single month by April 2026, with roughly 80 cargoes delivered to Asia.',
    lead: '14 million tonnes a year.',
    rest: 'That is the nameplate capacity of Phase 1. The joint venture — Shell, Petronas, PetroChina, Mitsubishi, KOGAS — is nearing a final investment decision on Phase 2, which would double it. The Coastal GasLink pipeline feeding the plant runs 670 km from the Montney gas fields.',
  },
  {
    who: 'Trans Mountain',
    tk: 'TMX · expanded',
    got: 'The expanded pipeline entered service in May 2024, tripling capacity to 890,000 barrels per day. Operating at roughly 84% utilization, with gross revenue tracking toward C$3.15–3.30 billion for 2026.',
    lead: 'The discount disappeared.',
    rest: 'The WCS–WTI differential narrowed by about US$8 a barrel since TMX started shipping. Analysts estimate the price uplift has increased Western Canadian oil revenues by more than C$10 billion since expansion. That money flows straight to producers\' free cash.',
  },
  {
    who: 'The buyback machine',
    tk: 'Oil sands producers',
    got: 'With pipelines no longer the bottleneck, the big oil sands companies are generating record free cash flow and returning it to shareholders. Canadian Natural posted record Q2 2026 earnings of C$4.6 billion.',
    lead: 'C$2.4 billion in one quarter.',
    rest: 'That was Canadian Natural alone — C$1.3 billion in dividends and C$1.1 billion in buybacks in Q2 2026. The company has raised its dividend for 26 consecutive years. Suncor and Cenovus are running the same playbook.',
  },
]

const layers = [
  {
    layer: 'Integrated major',
    earns: 'Owns everything from the wellhead to the gas pump. Refining margins cushion a drop in crude — when oil falls, refined product spreads often widen.',
    next: 'The crack spread, and whether the refinery is running at capacity or in turnaround.',
  },
  {
    layer: 'Pure upstream producer',
    earns: 'Drills, pumps and sells the barrel. All the commodity exposure and all the operating leverage. When oil runs, this layer runs hardest.',
    next: 'Production guidance, breakeven cost per barrel, and how much of the cash goes to buybacks versus drilling.',
  },
  {
    layer: 'Midstream / pipeline',
    earns: 'Toll revenue — paid to move the barrel, not to own it. Contracted volumes make the cash flow predictable. The TMX economics work at any oil price.',
    next: 'Utilization rates, tariff resets, and whether new capacity gets sanctioned.',
  },
  {
    layer: 'Critical minerals',
    earns: 'Uranium, copper, potash, lithium — the inputs the energy transition cannot do without. Cameco is the world\'s largest publicly traded uranium producer. Teck just exited coal to bet entirely on copper.',
    next: 'Contract book pricing, reactor restarts for uranium, and copper demand from electrification.',
  },
  {
    layer: 'Equipment and services',
    earns: 'Drill bits, frac fleets, engineering hours, pipeline coatings. Gets paid before a single barrel ships, and nobody builds anything without this layer.',
    next: 'The rig count, the order book, and whether capacity is sold out before the next cycle.',
  },
]
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Canada shipped its first LNG cargo a year ago. The pipelines are full. The producers are printing cash.</title>
    <meta
      name="description"
      content="LNG Canada hit nameplate capacity, TMX narrowed the oil discount by US$8 a barrel, and Canadian Natural just posted a record C$4.6-billion quarter. A plain-English field note on Canadian energy, and a free WhatsApp group where the ticker being discussed gets named."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Archivo:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --paper: #f3eee4;
        --paper-2: #e9e2d5;
        --card: #fbf8f2;
        --ink: #191d21;
        --ink-2: #4a5158;
        --rule: rgba(25, 29, 33, 0.16);
        --rule-2: rgba(25, 29, 33, 0.08);
        --patina: #6b4c1e;
        --brass: #8b6b2e;
        --wa: #25d366;
        --wa-d: #1bae52;
        --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
        --sans: 'Archivo', system-ui, -apple-system, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        font-family: var(--serif);
        color: var(--ink);
        line-height: 1.66;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: calc(80px + env(safe-area-inset-bottom));
        background-color: var(--paper);
        background-image:
          repeating-linear-gradient(
            0deg,
            rgba(25, 29, 33, 0.022) 0 1px,
            transparent 1px 24px
          ),
          radial-gradient(120% 80% at 50% 0%, rgba(255, 255, 255, 0.5), transparent 60%);
      }
      img { display: block; max-width: 100%; height: auto; }

      .wrap { width: 100%; padding-inline: 22px; }

      .issue {
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--ink-2);
      }

      hr.rule {
        border: none;
        border-top: 1px solid var(--rule);
        margin: 30px 0;
        transform: scaleX(0);
        transform-origin: left;
      }
      .js hr.rule.in { transform: none; transition: transform 0.7s cubic-bezier(0.22, 0.8, 0.3, 1); }

      .open { padding-top: calc(env(safe-area-inset-top) + 42px); padding-bottom: 8px; }
      .open h1 {
        margin-top: 14px;
        font-weight: 700;
        font-size: clamp(1.95rem, 8.2vw, 2.7rem);
        line-height: 1.13;
        letter-spacing: -0.018em;
        text-wrap: balance;
      }
      .standfirst {
        margin-top: 14px;
        font-family: var(--sans);
        font-size: 0.92rem;
        font-weight: 500;
        line-height: 1.5;
        color: var(--patina);
        max-width: 46ch;
      }
      .lede {
        margin-top: 20px;
        font-size: 1.09rem;
        line-height: 1.7;
        color: var(--ink-2);
        max-width: 60ch;
      }
      .lede::first-letter {
        float: left;
        font-size: 3.35rem;
        line-height: 0.86;
        font-weight: 700;
        color: var(--patina);
        padding-right: 9px;
        padding-top: 5px;
      }

      .tape {
        margin-top: 26px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 14px 0;
        border-block: 1px solid var(--rule);
      }
      .tape .metric {
        font-family: var(--sans);
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--ink-2);
        min-height: 1.4em;
      }
      .tape .note { min-height: 2.7em; }
      .tape .px {
        margin-top: 3px;
        font-size: clamp(1.05rem, 4.6vw, 1.3rem);
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }
      .tape .px span { font-size: 0.66em; font-weight: 500; color: var(--ink-2); }
      .tape .note {
        margin-top: 4px;
        font-family: var(--sans);
        font-size: 0.66rem;
        line-height: 1.35;
        color: var(--brass);
      }
      .src-note {
        margin-top: 10px;
        font-family: var(--sans);
        font-size: 0.68rem;
        line-height: 1.5;
        color: var(--ink-2);
        max-width: 62ch;
      }

      .acts { margin-top: 26px; }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 16px 24px;
        border: none;
        border-radius: 3px;
        background: var(--ink);
        color: var(--paper);
        font-family: var(--sans);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.14s ease;
      }
      .btn svg { width: 17px; height: 17px; flex: none; }
      .btn:hover { background: var(--patina); transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn:focus-visible { outline: 3px solid var(--patina); outline-offset: 3px; }

      .sec { padding: 12px 0 46px; }
      .sec h2 {
        font-weight: 700;
        font-size: clamp(1.4rem, 5.6vw, 1.85rem);
        line-height: 1.22;
        letter-spacing: -0.014em;
        text-wrap: balance;
      }
      .body {
        margin-top: 15px;
        font-size: 1.03rem;
        color: var(--ink-2);
        max-width: 62ch;
      }
      .body + .body { margin-top: 13px; }
      .body strong { color: var(--ink); font-weight: 600; }

      .stats {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px 10px;
      }
      .stats .n {
        font-size: clamp(1.5rem, 7vw, 2.1rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: var(--patina);
      }
      .stats .k {
        margin-top: 5px;
        font-family: var(--sans);
        font-size: 0.7rem;
        line-height: 1.4;
        font-weight: 500;
        color: var(--ink-2);
      }

      .gainers { list-style: none; margin-top: 26px; border-top: 1px solid var(--rule); }
      .gainers li {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 7px 12px;
        padding: 12px 0 13px;
        border-bottom: 1px solid var(--rule-2);
      }
      .g-name { font-family: var(--sans); font-size: 0.86rem; font-weight: 600; }
      .g-name em {
        font-style: normal;
        font-weight: 500;
        font-size: 0.74rem;
        letter-spacing: 0.05em;
        color: var(--ink-2);
      }
      .g-pct {
        font-family: var(--sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--patina);
        white-space: nowrap;
      }
      .g-bar { grid-column: 1 / -1; height: 7px; background: var(--rule-2); }
      .g-bar i {
        display: block;
        height: 100%;
        width: var(--w);
        background: linear-gradient(90deg, var(--brass), var(--patina));
      }
      .gainers li.base .g-pct { color: var(--ink-2); }
      .gainers li.base .g-bar i { background: var(--ink-2); opacity: 0.45; }
      .js .gainers .g-bar i { width: 0; }
      .js .gainers.in .g-bar i { width: var(--w); transition: width 1.05s cubic-bezier(0.22, 0.8, 0.3, 1); }

      .rerate {
        margin-top: 26px;
        background: var(--card);
        border: 1px solid var(--rule);
        border-left: 3px solid var(--patina);
        padding: 20px 18px;
      }
      .rerate .pair { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
      .rerate .n {
        font-size: clamp(1.6rem, 7.4vw, 2.25rem);
        font-weight: 700;
        letter-spacing: -0.022em;
        line-height: 1.1;
      }
      .rerate .n.hi { color: var(--patina); }
      .rerate .arw { font-family: var(--sans); font-weight: 600; color: var(--brass); font-size: 1.1rem; }
      .rerate .cap {
        margin-top: 11px;
        font-family: var(--sans);
        font-size: 0.78rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ink-2);
      }

      figure {
        margin-top: 26px;
        background: var(--card);
        border: 1px solid var(--rule);
        padding: 13px;
      }
      figure img { width: 100%; }
      figcaption {
        margin-top: 11px;
        font-family: var(--sans);
        font-size: 0.75rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ink-2);
      }
      .plates { display: grid; gap: 18px; }

      .tbl-scroll { margin-top: 24px; overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; min-width: 540px; }
      thead th {
        font-family: var(--sans);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-align: left;
        color: var(--ink);
        padding: 0 12px 9px 0;
        border-bottom: 2px solid var(--patina);
        vertical-align: bottom;
      }
      tbody td {
        font-size: 0.93rem;
        line-height: 1.58;
        color: var(--ink-2);
        padding: 13px 12px 13px 0;
        border-bottom: 1px solid var(--rule-2);
        vertical-align: top;
      }
      tbody td:first-child {
        font-family: var(--sans);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--ink);
        white-space: nowrap;
      }
      tbody td strong { color: var(--ink); font-weight: 600; }
      tbody td .tk { font-weight: 500; color: var(--ink-2); }
      .js tbody tr { opacity: 0; }
      .js .tbl-scroll.in tbody tr { opacity: 1; transition: opacity 0.5s ease; }

      table.deal-tbl { min-width: 0; width: 100%; }
      .deal-tbl thead { display: none; }
      .deal-tbl tbody tr { display: block; padding: 16px 0; border-bottom: 1px solid var(--rule-2); }
      .deal-tbl tbody td { display: block; padding: 0; border: none; white-space: normal; }
      .deal-tbl tbody td:first-child {
        font-family: var(--sans);
        font-size: 1rem;
        white-space: normal;
        margin-bottom: 8px;
      }
      .deal-tbl tbody td:first-child .tk { font-size: 0.78rem; letter-spacing: 0.05em; }
      .deal-tbl tbody td + td { margin-top: 9px; }
      .deal-tbl tbody td[data-l]::before {
        content: attr(data-l);
        display: block;
        font-family: var(--sans);
        font-size: 0.64rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--brass);
        margin-bottom: 3px;
      }
      .deal-tbl tbody td.terms {
        background: rgba(107, 76, 30, 0.07);
        border-left: 2px solid var(--patina);
        padding: 10px 12px;
      }

      .hole {
        margin-top: 24px;
        background: var(--card);
        border: 1px solid var(--rule);
        padding: 18px;
      }
      .hole .id {
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .hole .cut {
        margin-top: 7px;
        font-size: clamp(1.15rem, 5.2vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }
      .hole .cut b { color: var(--patina); font-weight: 700; }
      .hole dl { margin-top: 15px; border-top: 1px solid var(--rule-2); }
      .hole dt { font-family: var(--sans); font-size: 0.78rem; font-weight: 600; padding-top: 11px; }
      .hole dd {
        font-size: 0.93rem;
        line-height: 1.55;
        color: var(--ink-2);
        padding-bottom: 11px;
        border-bottom: 1px solid var(--rule-2);
      }
      .hole .fund {
        margin-top: 13px;
        font-family: var(--sans);
        font-size: 0.78rem;
        line-height: 1.55;
        color: var(--ink-2);
      }

      .honest { background: var(--paper-2); border-block: 1px solid var(--rule); padding: 40px 0; }
      .honest .body { max-width: 60ch; }

      .steps { margin-top: 20px; padding-left: 20px; }
      .steps li { font-size: 1rem; color: var(--ink-2); margin-bottom: 9px; padding-left: 5px; }
      .steps li::marker { font-family: var(--sans); font-weight: 600; color: var(--patina); font-size: 0.85rem; }

      .fine { margin-top: 15px; font-family: var(--sans); font-size: 0.74rem; color: var(--ink-2); }

      .foot { padding: 30px 0 40px; border-top: 1px solid var(--rule); }
      .foot p { font-size: 0.78rem; line-height: 1.62; color: var(--ink-2); max-width: 70ch; }
      .foot p + p { margin-top: 10px; }

      .wa-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 11px 0 calc(11px + env(safe-area-inset-bottom));
        background: rgba(243, 238, 228, 0.95);
        backdrop-filter: blur(10px);
        border-top: 1px solid var(--rule);
      }
      .wa-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 52px;
        border: none;
        border-radius: 3px;
        background: var(--wa);
        color: #04220f;
        font-family: var(--sans);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .wa-btn svg { width: 21px; height: 21px; flex: none; }
      .wa-btn:hover { background: var(--wa-d); }
      .wa-btn:focus-visible { outline: 3px solid var(--patina); outline-offset: 3px; }

      .js .reveal { opacity: 0; transform: translateY(14px); }
      .js .reveal.in {
        opacity: 1;
        transform: none;
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.8, 0.3, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        .js .reveal, .js tbody tr { opacity: 1; transform: none; }
        .js hr.rule { transform: none; }
        .js .gainers .g-bar i { width: var(--w); }
        html { scroll-behavior: auto; }
      }

      @media (min-width: 640px) {
        .wrap { max-width: 680px; margin-inline: auto; padding-inline: 32px; }
        .btn, .wa-btn { width: auto; min-width: 300px; }
        .acts { display: flex; }
        .open { padding-top: calc(env(safe-area-inset-top) + 64px); }
        .gainers li { grid-template-columns: 15rem 1fr auto; align-items: center; gap: 0 16px; }
        .g-bar { grid-column: auto; }
        .hole { padding: 24px; }
        .deal-tbl thead { display: table-header-group; }
        .deal-tbl tbody tr { display: table-row; padding: 0; }
        .deal-tbl tbody td {
          display: table-cell;
          padding: 13px 12px 13px 0;
          border-bottom: 1px solid var(--rule-2);
        }
        .deal-tbl tbody td:first-child { font-size: 0.85rem; margin-bottom: 0; }
        .deal-tbl tbody td + td { margin-top: 0; }
        .deal-tbl tbody td[data-l]::before { display: none; }
        .deal-tbl tbody td.terms { background: none; border-left: none; padding: 13px 12px 13px 0; }
      }
      @media (min-width: 760px) {
        .plates { grid-template-columns: 1fr 1fr; gap: 20px; }
        table { min-width: 0; }
      }
      @media (min-width: 1024px) {
        .wrap { max-width: 880px; }
        .sec { padding: 16px 0 62px; }
        .honest { padding: 62px 0; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <section class="open">
      <div class="wrap">
        <p class="issue reveal">Field note · Aug. 11, 2026 · Calgary</p>
        <h1 class="reveal">
          Canada shipped its first LNG cargo a year ago. The pipelines are full. The producers are printing cash.
        </h1>
        <p class="standfirst reveal">
          LNG Canada hit nameplate. TMX narrowed the oil discount by eight dollars a barrel. Canadian Natural just posted a record quarter.
        </p>
        <p class="lede reveal">
          For twenty years the story was the same: Canada produces the oil and gas but can't get it to market. The pipelines were too few, the coast was too far, and every barrel sold at a discount because there was nowhere else to send it. That story ended. Two new export routes opened within a year of each other, and the companies on top of the resource are now generating more free cash than they know how to spend.
        </p>

        <div class="tape reveal">
          {tape.map(t => (
            <div>
              <p class="metric">{t.metric}</p>
              <p class="px">{t.px}<span>{t.unit}</span></p>
              <p class="note">{t.note}</p>
            </div>
          ))}
        </div>
        <p class="src-note reveal">
          LNG Canada public disclosures, Trans Mountain financial reports, Canadian Natural Resources Q2 2026 earnings release. Figures as reported.
        </p>

        <div class="acts reveal">
          <button type="button" class="btn link-btn" onclick="onLinkBtnClick()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <hr class="rule reveal" />
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">Two export routes that didn't exist two years ago</h2>
        <p class="body reveal">
          LNG Canada loaded its first cargo on June 30, 2025 — the Gaslog Glasgow, out of Kitimat, bound for Asia. Both liquefaction trains are now running. By April 2026 the plant was exporting more than <strong>a million tonnes in a single month</strong>, with roughly 80 cargoes delivered. The Coastal GasLink pipeline feeding it runs 670 kilometres from the Montney gas fields in northeast BC.
        </p>
        <p class="body reveal">
          Trans Mountain's expansion entered service in May 2024, tripling the pipeline's capacity to <strong>890,000 barrels a day</strong>. It's running at about 84% utilization and tracking toward C$3.15–3.30 billion in gross revenue for 2026. The WCS–WTI differential narrowed by roughly US$8 a barrel since TMX started — and that price uplift has added more than <strong>C$10 billion</strong> to Western Canadian oil revenues.
        </p>

        <div class="stats reveal">
          <div>
            <p class="n">14 Mt/yr</p>
            <p class="k">LNG Canada Phase 1 at nameplate capacity</p>
          </div>
          <div>
            <p class="n">890K bbl/d</p>
            <p class="k">TMX expanded capacity, triple the old line</p>
          </div>
          <div>
            <p class="n">C$10B+</p>
            <p class="k">Oil revenue uplift since the discount narrowed</p>
          </div>
        </div>

        <figure class="reveal">
          <img
            src={mapFig.src}
            width={FIG_W}
            height={mapH}
            alt="A printed map of Western Canada showing the Trans Mountain pipeline from Alberta to the BC coast, the Coastal GasLink pipeline to Kitimat, and the oil sands region in northern Alberta."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Alberta to tidewater, two ways. The oil goes southwest through TMX. The gas goes northwest through Coastal GasLink and leaves as LNG from Kitimat.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">Where the cash is going</h2>
        <p class="body reveal">
          With the bottleneck gone, the big oil sands producers are doing what any business does when it has more cash than capital projects: giving it back. Canadian Natural posted <strong>record Q2 2026 earnings of C$4.6 billion</strong> and returned C$2.4 billion to shareholders in a single quarter — C$1.3 billion in dividends, C$1.1 billion in buybacks. That was the company's 26th consecutive year of dividend increases.
        </p>
        <p class="body reveal">
          Suncor and Cenovus are running the same playbook. The difference now is that they're doing it with <strong>a discount that has largely disappeared</strong> and export capacity they didn't have before. Every barrel that used to sell at a penalty now reaches tidewater at world price.
        </p>

        <div class="rerate reveal">
          <div class="pair">
            <span class="n">-US$20</span>
            <span class="arw">→</span>
            <span class="n hi">-US$12</span>
          </div>
          <p class="cap">
            The WCS–WTI discount before and after TMX. Eight dollars a barrel on roughly 4 million barrels a day of Western Canadian production. That's more than US$30 million a day in revenue that used to evaporate. Not all of it flows to one company, but none of it existed before the pipeline opened.
          </p>
        </div>

        <div class="tbl-scroll reveal">
          <table class="deal-tbl">
            <thead>
              <tr>
                <th>What</th>
                <th>What actually happened</th>
                <th>The numbers</th>
              </tr>
            </thead>
            <tbody>
              {deals.map((d, i) => (
                <tr style={`transition-delay:${i * 90}ms`}>
                  <td>{d.who}<br /><span class="tk">{d.tk}</span></td>
                  <td data-l="What happened">{d.got}</td>
                  <td class="terms" data-l="The numbers"><strong>{d.lead}</strong> {d.rest}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="src-note reveal">
          LNG Canada public disclosures, Trans Mountain operating data, Canadian Natural Resources Q2 2026 press release. These are the names already on the front page; the point is the shape of the cash flows, not a suggestion to buy any of them.
        </p>

        <div class="acts reveal" style="margin-top:28px">
          <button type="button" class="btn link-btn" onclick="onLinkBtnClick()">
            Get the morning notes free
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">The market has noticed some of this</h2>
        <p class="body reveal">
          Energy is the best-performing sector on the TSX in 2026. Uranium is leading inside it — Cameco is up more than 40% year to date as reactor restarts and new builds lock in long-term supply contracts. The oil sands names have outrun the broad market by a wide margin, and they're doing it while shrinking their share count.
        </p>

        <ol class="gainers reveal">
          {gainers.map((g, i) => (
            <li class={g.tk === 'the broad market' ? 'base' : ''}>
              <span class="g-name">{g.name} <em>{g.tk}</em></span>
              <span class="g-bar"><i style={`--w:${Math.round((g.pct / maxPct) * 100)}%;transition-delay:${i * 70}ms`}></i></span>
              <span class="g-pct">+{g.pct.toFixed(2)}%</span>
            </li>
          ))}
        </ol>
        <p class="src-note reveal">
          Year-to-date price change, 2026. The bottom bar is the broad market, for scale. Past performance says nothing about what any of these do next.
        </p>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">How to read an LNG deal</h2>
        <p class="body reveal">
          LNG economics run on four numbers, and most people never look past the headline. Here's the chain from wellhead to tanker, using real figures from the Montney-to-Kitimat corridor.
        </p>

        <div class="hole reveal">
          <p class="id">Montney → Coastal GasLink → LNG Canada → Asia</p>
          <p class="cut">
            Gas at <b>C$2.10/GJ</b> in the field, liquefied and loaded at <b>Kitimat</b>, delivered to Asia at <b>US$12–14/MMBtu</b>
          </p>
          <dl>
            <dt>C$2.10/GJ</dt>
            <dd>The wellhead cost in the Montney — some of the cheapest natural gas on the planet. This is the raw material, and it's why the project pencils at all.</dd>
            <dt>670 km</dt>
            <dd>The length of the Coastal GasLink pipeline from the gas fields to the coast. The hardest and most expensive part of the chain, and it's already built and running.</dd>
            <dt>14 Mt/year</dt>
            <dd>Phase 1 nameplate capacity — what LNG Canada can liquefy and load. Phase 2 would double it. The final investment decision is the next catalyst.</dd>
            <dt>US$12–14/MMBtu</dt>
            <dd>What LNG fetches in Asia. Subtract the gas cost, the pipeline toll and the liquefaction cost, and what's left is the margin that makes this entire chain worthwhile.</dd>
          </dl>
          <p class="fund">
            Every LNG deal can be read this way: gas cost, transport cost, liquefaction cost, delivered price. The spread between the first number and the last is the whole story.
          </p>
        </div>

        <div class="plates">
          <figure class="reveal">
