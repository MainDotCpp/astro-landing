    <!-- reveal -->
    <script is:inline>
      ;(function () {
        var items = Array.prototype.slice.call(document.querySelectorAll('.reveal'))
        if (!items.length) return

        function tick() {
          var vh = window.innerHeight || document.documentElement.clientHeight
          for (var i = items.length - 1; i >= 0; i--) {
            var r = items[i].getBoundingClientRect()
            if (r.top < vh - 60) {
              items[i].classList.add('in')
              items.splice(i, 1)
            }
          }
          if (!items.length) {
            window.removeEventListener('scroll', tick)
            window.removeEventListener('resize', tick)
          }
        }

        window.addEventListener('scroll', tick, { passive: true })
        window.addEventListener('resize', tick)
        tick()
        setTimeout(tick, 300)
      })()
    </script>

    <!-- compounding calculator -->
    <script is:inline>
      ;(function () {
        var slider = document.getElementById('monthly')
        var startSlider = document.getElementById('starting')
        var out = document.getElementById('monthlyOut')
        var startOut = document.getElementById('startingOut')
        var rateOut = document.getElementById('rateOut')
        var tbody = document.getElementById('calcBody')
        var roomWarn = document.getElementById('roomWarn')
        var presets = Array.prototype.slice.call(document.querySelectorAll('.preset'))
        if (!slider || !startSlider || !tbody) return

        var money = new Intl.NumberFormat('en-CA', {
          style: 'currency',
          currency: 'CAD',
          maximumFractionDigits: 0,
        })
        var YEARS = [5, 10, 20, 30]
        var rate = 6
        var TFSA_MONTHLY = 7000 / 12

        function futureValue(start, monthly, years, annualPct) {
          var r = annualPct / 100 / 12
          var n = years * 12
          if (r === 0) return start + monthly * n
          return start * Math.pow(1 + r, n) + monthly * ((Math.pow(1 + r, n) - 1) / r)
        }

        function render() {
          var monthly = parseInt(slider.value, 10)
          var start = parseInt(startSlider.value, 10)
          out.textContent = money.format(monthly)
          startOut.textContent = money.format(start)
          rateOut.textContent = rate
          roomWarn.hidden = monthly <= TFSA_MONTHLY

          var html = ''
          for (var i = 0; i < YEARS.length; i++) {
            var y = YEARS[i]
            var paid = start + monthly * 12 * y
            var value = futureValue(start, monthly, y, rate)
            var growth = value - paid
            html += '<tr><td>' + y + ' years</td><td>' + money.format(paid)
              + '</td><td class="grow">' + money.format(growth)
              + '</td><td>' + money.format(value) + '</td></tr>'
          }
          tbody.innerHTML = html
        }

        slider.addEventListener('input', render)
        startSlider.addEventListener('input', render)
        presets.forEach(function (b) {
          b.addEventListener('click', function () {
            rate = parseFloat(b.getAttribute('data-rate'))
            presets.forEach(function (o) { o.setAttribute('aria-pressed', String(o === b)) })
            render()
          })
        })

        render()
      })()
    </script>
  </body>
