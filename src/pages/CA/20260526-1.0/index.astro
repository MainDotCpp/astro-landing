---
import RedirectCode from '@/components/RedirectCode.astro'
import heroBg from './assets/images/hero-bg.png'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Last Week We Called 3 Stocks That Pumped +332%</title>
    <meta name="description" content="Trusted by 6,000+ investors. This week we're releasing 5 new picks expected to run +150%. Join free on WhatsApp." />

    <RedirectCode />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#00FF2F',
              secondary: '#0bd127',
              accent: '#f97316',
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style define:vars={{ heroBgImage: `url(${heroBg.src})` }}>
      body { font-family: 'Inter', system-ui, sans-serif; }

      @keyframes ctaBounce {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.04); }
      }
      .bounce { animation: ctaBounce 1.6s ease-in-out infinite; }

      .hero-bg {
        background-image: var(--heroBgImage);
        background-size: cover;
        background-position: top right;
        background-repeat: no-repeat;
      }

      .pct {
        color: #00FF2F;
        font-weight: 800;
        font-size: 2.25rem;
        line-height: 1;
        text-shadow: 0 0 14px rgba(0, 255, 47, 0.45);
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      @media (min-width: 768px) {
        .pct { font-size: 3.25rem; }
      }

      .case-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.1rem 0;
        border-bottom: 1px solid #1a1a1a;
      }
      .case-row:last-child { border-bottom: none; }

      .case-meta {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
        min-width: 0;
      }
      .ticker {
        color: #fff;
        font-weight: 700;
        font-size: 1.35rem;
        letter-spacing: 0.02em;
      }
      .price-flow {
        color: #9ca3af;
        font-size: 0.95rem;
      }

      .cta-sticky {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.6rem 0.85rem 0.85rem;
        background: linear-gradient(to top, #0b0b0b 78%, rgba(11,11,11,0));
        z-index: 50;
      }
      @media (min-width: 768px) {
        .cta-sticky { display: none; }
      }
    </style>
  </head>

  <body class="bg-[#0b0b0b] text-white pb-40 md:pb-12">
    <main class="relative max-w-[720px] mx-auto px-5 pt-10 md:pt-14 overflow-hidden">
      <div class="hero-bg absolute top-0 inset-x-0 h-[45%] opacity-[0.22] pointer-events-none z-0"></div>
      <div class="absolute top-0 inset-x-0 h-[45%] bg-gradient-to-b from-[#0b0b0b]/40 via-transparent to-[#0b0b0b] pointer-events-none z-0"></div>

      <div class="relative z-10">
        <section class="py-6 md:py-10">
          <p class="text-xs md:text-sm text-gray-400 uppercase tracking-[0.18em] mb-4 font-semibold">
            Trusted by 6,000+ investors
          </p>
          <h1 class="text-3xl md:text-5xl font-extrabold leading-[1.08] mb-5">
            Last Week We Called 3 Stocks That Pumped <span class="text-primary" style="text-shadow:0 0 12px rgba(0,255,47,0.35);">+332%</span>
          </h1>
          <p class="text-base md:text-lg text-gray-200 leading-relaxed">
            In the past 30 days, our database tracked institutional fund flows and identified 3 outstanding picks.
          </p>
        </section>

        <section class="py-2 md:py-4">
          <div class="case-row">
            <div class="case-meta">
              <span class="ticker">CRML</span>
              <span class="price-flow">$7.09 → $29.97</span>
            </div>
            <span class="pct">+332.71%</span>
          </div>
          <div class="case-row">
            <div class="case-meta">
              <span class="ticker">RGTI</span>
              <span class="price-flow">$29.85 → $56.34</span>
            </div>
            <span class="pct">+88.74%</span>
          </div>
          <div class="case-row">
            <div class="case-meta">
              <span class="ticker">ASTS</span>
              <span class="price-flow">$56.97 → $95.69</span>
            </div>
            <span class="pct">+67.97%</span>
          </div>
        </section>

        <section class="py-8 md:py-12">
          <h2 class="text-2xl md:text-4xl font-extrabold leading-tight mb-3">
            This Week: 5 New Picks Expected to Run <span class="text-accent">+150%</span>
          </h2>
          <p class="text-base md:text-lg text-accent leading-relaxed">
            Next 30-day report drops inside — the next wave of high-potential tickers.
          </p>
        </section>

        <section class="py-4 md:py-8 text-center">
          <p class="text-sm text-gray-400 mb-4">Join free. Not happy? Leave anytime.</p>
          <a onclick="onLinkBtnClick()" class="link-btn inline-flex items-center justify-center gap-3 bg-primary hover:bg-secondary text-black font-extrabold text-base md:text-lg px-6 md:px-10 py-4 md:py-5 rounded-xl shadow-2xl shadow-primary/40 bounce cursor-pointer transition-colors w-full md:w-auto whitespace-nowrap">
            <i class="fab fa-whatsapp text-2xl shrink-0"></i>
            <span>Get This Week's 5 Picks &nbsp;→</span>
          </a>
        </section>

        <footer class="py-8 text-center text-gray-500 text-xs">
          © 2026 SignalEdge · All Rights Reserved.
        </footer>
      </div>
    </main>

    <div class="cta-sticky">
      <a onclick="onLinkBtnClick()" class="link-btn flex items-center justify-center gap-2 bg-primary text-black font-extrabold text-base px-5 py-3.5 rounded-xl shadow-xl shadow-primary/50 cursor-pointer whitespace-nowrap">
        <i class="fab fa-whatsapp text-xl shrink-0"></i>
        <span>Get This Week's 5 Picks &nbsp;→</span>
      </a>
    </div>
  </body>
</html>
