---
import BaseLayout from '@/layouts/BaseLayout.astro'
import authorPortrait from './images/author-portrait.jpg'
import story1 from './images/story-1.jpg'
import story2 from './images/story-2.jpg'
import story3 from './images/story-3.jpg'
import accountScreenshot from './images/account-screenshot.png'

const title = "A letter from Daniel Hartman · 12 seats in my Toronto trading room"
const description = "A personal letter from Daniel Hartman, former Bay Street prop-desk trader. 12 free seats in my private WhatsApp trading room — closing tonight at 7:42 PM EST."
---

<BaseLayout title={title} description={description} lang="en">
  <Fragment slot="head">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={authorPortrait.src} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=JetBrains+Mono:wght@400;500;600;700&family=Caveat:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --page:           #FFFFFF;
        --ink:            #1A1A1F;
        --ink-soft:       #3D3D45;
        --meta:           #6B6B73;
        --rule:           rgba(26, 26, 31, 0.1);
        --rule-strong:    rgba(26, 26, 31, 0.22);
        --paper-soft:     #F8F7F4;
        --marker:         #FFE3B7;
        --marker-deep:    #FFD276;
        --alert:          #FF4828;
        --alert-soft:     rgba(255, 72, 40, 0.1);
        --gain:           #1C9D55;
        --wa-green:       #25D366;
        --wa-green-deep:  #128C7E;
        --ink-pen:        #2E4FA8;

        --font-serif:     'Source Serif 4', Charter, Georgia, 'Times New Roman', serif;
        --font-mono:      'JetBrains Mono', Menlo, Consolas, monospace;
        --font-hand:      'Caveat', cursive;

        --container-letter: 660px;
        --container-wide:   720px;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0;
        background: var(--page);
        color: var(--ink);
        font-family: var(--font-serif);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
        font-size: 16px;
        line-height: 1.55;
      }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; cursor: pointer; }

      .letter {
        max-width: var(--container-letter);
        margin: 0 auto;
        padding: 0 32px;
      }
      .letter--wide { max-width: var(--container-wide); padding: 0 24px; }
      @media (max-width: 720px) {
        .letter, .letter--wide { padding: 0 20px; }
      }

      /* ─── STICKY PROGRESS BAR ─── */
      .sticky-bar {
        position: fixed; top: 0; left: 0; right: 0;
        height: 44px;
        background: var(--page);
        border-bottom: 1px solid var(--rule);
        z-index: 100;
        transform: translateY(-100%);
        transition: transform .3s cubic-bezier(.22, 1, .36, 1);
        display: flex; align-items: center;
      }
      .sticky-bar.is-visible { transform: translateY(0); }
      .sticky-bar .progress-fill {
        position: absolute; top: 0; left: 0;
        height: 2px; width: 0%;
        background: var(--marker-deep);
        transition: width .12s linear;
      }
      .sticky-bar-inner {
        width: 100%;
        max-width: var(--container-letter);
        margin: 0 auto;
        padding: 0 24px;
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px;
      }
      .sticky-bar .meta {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--meta);
        letter-spacing: 0.02em;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .sticky-bar .meta .sep { margin: 0 8px; color: var(--rule-strong); }
      .cta-wa-mini {
        flex-shrink: 0;
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px;
        background: var(--wa-green);
        color: #fff;
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 13px;
        border-radius: 4px;
        border: none;
        text-decoration: none;
        line-height: 1.2;
        transition: background .2s ease;
      }
      .cta-wa-mini:hover { background: var(--wa-green-deep); }
      .cta-wa-mini .arrow { font-size: 14px; line-height: 1; }
      @media (max-width: 480px) {
        .sticky-bar .meta-mid { display: none; }
        .sticky-bar-inner { padding: 0 16px; }
        .cta-wa-mini { font-size: 12px; padding: 6px 10px; }
      }

      /* ─── PAGE TOP RHYTHM ─── */
      .page-top { padding-top: 64px; }
      @media (max-width: 720px) {
        .page-top { padding-top: 32px; }
      }

      /* ─── LETTER HEADER ─── */
      .letter-meta-row {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--meta);
        margin: 0;
        text-transform: uppercase;
      }
      .letter-rule {
        width: 80px; height: 1px;
        background: var(--rule-strong);
        margin: 18px 0 20px;
      }
      .letter-h1 {
        font-family: var(--font-serif);
        font-size: clamp(30px, 5vw, 44px);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.015em;
        color: var(--ink);
        margin: 0;
        font-variation-settings: 'opsz' 44;
      }
      .letter-h1-sub {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(16px, 1.7vw, 17px);
        font-weight: 400;
        color: var(--ink-soft);
        margin: 10px 0 0;
        line-height: 1.5;
      }

      /* ─── AUTHOR BLOCK ─── */
      .author-block {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin: 40px 0 0;
        padding: 24px 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      .author-photo {
        flex-shrink: 0;
        width: 56px; height: 56px;
        border-radius: 50%;
        object-fit: cover;
        object-position: center 30%;
        border: 2px solid var(--page);
        outline: 1px solid var(--rule);
      }
      .author-info {
        flex: 1; min-width: 0;
      }
      .author-name {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(17px, 2vw, 19px);
        line-height: 1.3;
        letter-spacing: -0.005em;
        margin: 0 0 4px;
        color: var(--ink);
      }
      .author-bio {
        font-family: var(--font-serif);
        font-size: clamp(13px, 1.5vw, 14px);
        color: var(--ink-soft);
        line-height: 1.5;
        margin: 0;
      }
      .author-followers {
        display: flex; align-items: center; gap: 8px;
        margin: 10px 0 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--meta);
        letter-spacing: 0.02em;
      }
      .author-followers .dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--gain);
        flex-shrink: 0;
      }
      .author-followers .subbed {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 13px;
      }

      /* ─── BODY PROSE ─── */
      .prose {
        font-family: var(--font-serif);
        font-size: clamp(17px, 1.9vw, 19px);
        line-height: 1.72;
        color: var(--ink);
      }
      .prose p { margin: 0 0 24px; }
      .prose p:last-child { margin-bottom: 0; }
      .prose strong { font-weight: 700; }
      .prose em { font-style: italic; color: var(--ink-soft); }
      .prose .pnl { color: var(--alert); font-weight: 700; }
      .prose .pnl-gain { color: var(--gain); font-weight: 700; }
      .prose blockquote {
        margin: 28px 0;
        padding: 0 0 0 24px;
        border-left: 3px solid var(--marker-deep);
        font-style: italic;
        color: var(--ink-soft);
      }
      .prose blockquote p { margin: 0; }
      .prose a { color: var(--ink-pen); text-decoration: underline; text-underline-offset: 3px; }

      /* ─── MARKER HIGHLIGHT ─── */
      .hl {
        background: linear-gradient(180deg,
          transparent 55%, var(--marker) 55%,
          var(--marker) 95%, transparent 95%);
        padding: 0 4px;
      }
      .hl--tilt {
        display: inline-block;
        transform: rotate(-0.5deg);
      }

      /* ─── HANDWRITING ACCENT ─── */
      .hand {
        font-family: var(--font-hand);
        font-size: clamp(20px, 2.3vw, 24px);
        color: var(--ink-pen);
        font-weight: 500;
        display: block;
        transform: rotate(-1.5deg);
        margin: -8px 0 36px 32px;
        line-height: 1.2;
      }
      .hand--right {
        text-align: right;
        margin: 8px 0 0;
        transform: rotate(-1deg);
      }
      .scribble {
        display: block;
        margin: -10px 0 24px 32px;
        height: 12px;
        color: var(--ink-pen);
        max-width: 240px;
      }

      /* ─── LEAD PARAGRAPH WITH DROP CAP ─── */
      .lead {
        margin: 40px 0 0;
      }
      .lead > p:first-child::first-letter {
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: clamp(64px, 9vw, 92px);
        line-height: 0.85;
        float: left;
        margin: 6px 12px -4px 0;
        color: var(--ink);
        font-variation-settings: 'opsz' 60;
      }

      /* ─── SECTION TITLES ─── */
      .section-title {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: 600;
        font-size: clamp(22px, 2.8vw, 28px);
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 80px 0 8px;
      }
      .section-title-sub {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(14px, 1.6vw, 15px);
        color: var(--meta);
        margin: 0 0 32px;
      }
      @media (max-width: 720px) {
        .section-title { margin-top: 56px; }
      }

      /* ─── STORY CARDS ─── */
      .stories {
        margin: 24px 0 0;
        display: flex; flex-direction: column;
        gap: 40px;
      }
      .stories::before {
        content: '';
        display: block;
        width: 32px; height: 2px;
        background: var(--marker-deep);
        margin-bottom: 8px;
      }
      .story-card {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 20px;
        align-items: flex-start;
      }
      .story-photo {
        width: 64px; height: 64px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--page);
        outline: 1px solid var(--rule);
        flex-shrink: 0;
      }
      .story-head {
        font-family: var(--font-serif);
        font-size: clamp(15px, 1.7vw, 17px);
        line-height: 1.3;
        margin: 0 0 4px;
      }
      .story-head .name {
        font-weight: 700;
        color: var(--ink);
        margin-right: 6px;
      }
      .story-head .meta {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--meta);
      }
      .story-pnl {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 600;
        color: var(--alert);
        margin: 0 0 12px;
        letter-spacing: 0.02em;
      }
      .story-body {
        font-family: var(--font-serif);
        font-size: clamp(16px, 1.8vw, 17px);
        line-height: 1.65;
        color: var(--ink);
        margin: 0;
      }
      .story-body p { margin: 0 0 14px; }
      .story-body p:last-child { margin-bottom: 0; }
      @media (max-width: 480px) {
        .story-card { grid-template-columns: 56px 1fr; gap: 16px; }
        .story-photo { width: 56px; height: 56px; }
      }

      /* ─── SETUP TEASER ─── */
      .setup-intro {
        margin: 56px 0 0;
      }
      .setup-card {
        background: var(--paper-soft);
        border: 1px solid var(--rule-strong);
        border-radius: 4px;
        padding: 32px 36px;
        margin: 24px 0 0;
        font-family: var(--font-mono);
        font-size: clamp(13px, 1.4vw, 14px);
        line-height: 1.65;
        color: var(--ink);
      }
      .setup-card h3 {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 18px;
        color: var(--ink);
      }
      .setup-card .dash {
        width: 100%; border: none;
        border-top: 1px dashed var(--rule-strong);
        margin: 0 0 22px;
      }
      .setup-item { margin-bottom: 22px; }
      .setup-item:last-of-type { margin-bottom: 18px; }
      .setup-item .label {
        color: var(--marker-deep);
        font-weight: 700;
        margin-right: 4px;
      }
      .setup-item .key {
        display: inline-block;
        min-width: 96px;
        color: var(--meta);
      }
      .setup-item .redact {
        letter-spacing: 0.06em;
        color: var(--ink);
      }
      .setup-item .conviction {
        margin-top: 6px;
      }
      .setup-item .conviction strong {
        color: var(--alert);
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .setup-room-rule {
        text-align: center;
        margin: 14px 0 0;
        color: var(--meta);
        font-size: 12px;
        letter-spacing: 0.04em;
      }
      .setup-caption {
        margin: 16px 0 0;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(14px, 1.6vw, 15px);
        color: var(--alert);
        line-height: 1.55;
        padding-left: 12px;
        border-left: 3px solid var(--alert);
      }
      @media (max-width: 720px) {
        .setup-card { padding: 24px 20px; }
        .setup-item .key { display: block; min-width: 0; margin-bottom: 2px; }
      }

      /* ─── ACCOUNT SCREENSHOT ─── */
      .account-shot {
        margin: 40px 0 0;
        max-width: var(--container-letter);
      }
      .account-shot img {
        display: block;
        width: 100%; height: auto;
        border: 1px solid var(--rule-strong);
        border-radius: 4px;
      }
      .account-shot figcaption {
        margin: 10px 0 0;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 13px;
        color: var(--meta);
        line-height: 1.5;
      }

      /* ─── INLINE PAYWALL CARD ─── */
      .paywall-wrap {
        margin: 64px auto 0;
        max-width: var(--container-wide);
        padding: 0 24px;
      }
      @media (max-width: 720px) {
        .paywall-wrap { padding: 0 20px; }
      }
      .paywall-card {
        background: var(--paper-soft);
        border-left: 4px solid var(--marker-deep);
        padding: 48px 40px;
        border-radius: 4px;
      }
      .paywall-h {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: clamp(22px, 2.6vw, 26px);
        line-height: 1.25;
        letter-spacing: -0.005em;
        margin: 0;
        color: var(--ink);
      }
      .paywall-rule {
        width: 24px; height: 2px;
        background: var(--ink);
        margin: 14px 0 20px;
      }
      .paywall-sub {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(15px, 1.7vw, 17px);
        line-height: 1.55;
        color: var(--ink-soft);
        margin: 0 0 28px;
        max-width: 540px;
      }
      .paywall-cta-wrap { margin: 0; }
      .paywall-urgency {
        margin-top: 24px;
        padding-left: 12px;
        border-left: 3px solid var(--alert);
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 14px;
        line-height: 1.4;
        color: var(--alert);
      }
      .paywall-urgency .when {
        font-family: var(--font-mono);
        font-weight: 600;
      }
      @media (max-width: 720px) {
        .paywall-card { padding: 32px 24px; }
      }

      /* ─── WHATSAPP CTA (full) ─── */
      .cta-wa {
        display: inline-flex;
        align-items: center; justify-content: center;
        gap: 12px;
        padding: 18px 32px;
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: 17px;
        letter-spacing: 0.02em;
        color: #fff;
        background: var(--wa-green);
        border: none;
        border-radius: 6px;
        text-decoration: none;
        line-height: 1.1;
        transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        box-shadow: 0 1px 0 rgba(18, 140, 126, 0.4);
      }
      .cta-wa:hover {
        background: var(--wa-green-deep);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25), 0 1px 0 rgba(18, 140, 126, 0.5);
      }
      .cta-wa .wa-icon { flex-shrink: 0; width: 20px; height: 20px; }
      .cta-wa .arrow { font-family: var(--font-serif); font-weight: 600; font-size: 18px; }
      .cta-wa--full { width: 100%; padding: 20px 24px; font-size: 17px; }
      @media (max-width: 720px) {
        .cta-wa { width: 100%; padding: 16px 20px; font-size: 16px; }
      }

      /* ─── PS BLOCK ─── */
      .ps-block {
        margin: 80px 0 0;
        padding: 32px 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      .ps-label {
        font-family: var(--font-hand);
        font-size: clamp(26px, 3vw, 30px);
        font-weight: 500;
        color: var(--ink-pen);
        margin: 0 0 8px;
        line-height: 1;
      }
      .ps-body {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: clamp(16px, 1.8vw, 17px);
        line-height: 1.7;
        color: var(--ink);
        margin: 0;
      }
      .ps-body p { margin: 0 0 16px; }
      .ps-body p:last-of-type { margin-bottom: 24px; }
      .ps-signature {
        font-family: var(--font-hand);
        font-size: clamp(26px, 3vw, 30px);
        color: var(--ink-pen);
        text-align: right;
        margin: 0;
        line-height: 1;
      }
      .ps-signature .underline {
        display: block;
        width: 96px;
        height: 1px;
        background: var(--ink-pen);
        margin: 4px 0 0 auto;
      }

      /* ─── FINAL CTA ─── */
      .final-cta-wrap {
        margin: 48px 0 0;
        text-align: center;
      }
      .final-cta-meta {
        margin: 16px 0 0;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--meta);
        letter-spacing: 0.04em;
      }

      /* ─── FOOTER ─── */
      .site-footer {
        margin: 96px 0 0;
        padding: 40px 0 56px;
        border-top: 1px solid var(--rule);
      }
      .site-footer p {
        margin: 0 0 6px;
        font-family: var(--font-serif);
        font-size: 12px;
        line-height: 1.55;
        color: var(--meta);
      }
      .site-footer p:last-child { margin-bottom: 0; }
      .site-footer .brand {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 14px;
      }
      .site-footer a { color: var(--ink-pen); }

      /* ─── REVEAL ─── */
      .reveal {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity .7s cubic-bezier(.22, 1, .36, 1),
                    transform .7s cubic-bezier(.22, 1, .36, 1);
      }
      .reveal.active { opacity: 1; transform: translateY(0); }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .sticky-bar { transition: none; }
      }
    </style>
  </Fragment>

  <main>
    <!-- ═══ STICKY PROGRESS BAR ═══ -->
    <div class="sticky-bar" id="sticky-bar" role="region" aria-label="Reading progress and CTA">
      <div class="progress-fill" id="progress-fill"></div>
      <div class="sticky-bar-inner">
        <span class="meta">LETTER №14<span class="sep">·</span><span class="meta-mid">MAY 24</span></span>
        <span class="meta"><span id="read-pct">0</span>% done</span>
        <a class="cta-wa-mini link-btn" href="#" data-cta="sticky" onclick="onLinkBtnClick()">
          <svg class="wa-icon" viewBox="0 0 32 32" aria-hidden="true" width="14" height="14">
            <path fill="#fff" d="M16.003 3C9.376 3 4 8.376 4 15c0 2.354.685 4.547 1.87 6.4L4 29l7.79-1.847A11.95 11.95 0 0 0 16.003 27C22.628 27 28 21.624 28 15S22.628 3 16.003 3z"/>
          </svg>
          Join the room <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- ═══ [1] LETTER HEADER ═══ -->
    <div class="page-top"></div>
    <section class="letter">
      <p class="letter-meta-row">A letter from Daniel Hartman</p>
      <div class="letter-rule"></div>
      <h1 class="letter-h1">Posted from Toronto.<br/>Twelve seats. <span class="hl hl--tilt">Closing tonight.</span></h1>
      <p class="letter-h1-sub">May 24, 2026 &nbsp;·&nbsp; 7:42 AM EST &nbsp;·&nbsp; <span id="read-est">Estimated read: 4 minutes</span></p>
    </section>

    <!-- ═══ [2] AUTHOR BLOCK ═══ -->
    <section class="letter">
      <div class="author-block">
        <img src={authorPortrait.src} alt="Daniel Hartman" class="author-photo" width="56" height="56" />
        <div class="author-info">
