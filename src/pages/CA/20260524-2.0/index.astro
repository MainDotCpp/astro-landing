  <script type="module" src="/src/utils/jump.ts"></script>
<script is:inline>
    // ─── Reveal-on-scroll ───
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('active'), idx * 60);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('active'));
    }

    // ─── Sticky progress bar (≥30% triggers slide-in) ───
    const stickyBar = document.getElementById('sticky-bar');
    const progressFill = document.getElementById('progress-fill');
    const readPct = document.getElementById('read-pct');
    let lastPct = -1;

    function updateProgress() {
      const doc = document.documentElement;
      const scrollTop = window.scrollY || doc.scrollTop;
      const viewportH = window.innerHeight;
      const fullH = doc.scrollHeight - viewportH;
      const pct = fullH > 0 ? Math.min(100, Math.max(0, (scrollTop / fullH) * 100)) : 0;
      const pctRounded = Math.round(pct);

      if (progressFill) progressFill.style.width = pct + '%';
      if (readPct && pctRounded !== lastPct) {
        readPct.textContent = pctRounded;
        lastPct = pctRounded;
      }

      if (stickyBar) {
        if (pct >= 30) stickyBar.classList.add('is-visible');
        else stickyBar.classList.remove('is-visible');
      }
    }
    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);

    // ─── Live seat counter (jitter in [8, 12], never 0) ───
    let seats = 12;
    function syncSeats() {
      const s = String(seats);
      ['seats-inline', 'seats-pay', 'seats-final'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.textContent = s;
      });
    }
    function jitterSeats() {
      // 65% chance to decrement, 35% to stay/up; clamp [8, 12]
      const r = Math.random();
      if (r < 0.55 && seats > 8) seats -= 1;
      else if (r > 0.92 && seats < 12) seats += 1;
      syncSeats();
    }
    syncSeats();
    setInterval(jitterSeats, 18000);

    // ─── Reader count slow drift ───
    const readerEl = document.getElementById('reader-count');
    let readerCount = 12438;
    if (readerEl) {
      setInterval(() => {
        readerCount += Math.random() < 0.7 ? 1 : 0;
        readerEl.textContent = readerCount.toLocaleString('en-CA');
      }, 22000);
    }

    // ─── GA event tracking on CTA clicks ───
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const slot = el.getAttribute('data-cta') || 'unknown';
          try {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'cta_click', {
                event_category: 'whatsapp_letter',
                event_label: slot,
                page_path: '/CA/20260524-2.0/',
              });
            }
          } catch (e) { /* swallow */ }
        });
      });
    });
  </script>
