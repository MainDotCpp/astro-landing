---
import { getImage } from 'astro:assets'
import RedirectCode from '@/components/RedirectCode.astro'
import ladderSrc from './images/power-ladder.png'
import ppaSrc from './images/ppa-master.png'
import queueSrc from './images/queue-plate.png'
import mapSrc from './images/grid-map.png'

const FIG_W = 880
const mapFig = await getImage({ src: mapSrc, format: 'webp', width: FIG_W, quality: 76 })
const mapH = Math.round(FIG_W * mapSrc.height / mapSrc.width)

const PLATE_W = 720
const ppa = await getImage({ src: ppaSrc, format: 'webp', width: PLATE_W, quality: 76 })
const ppaH = Math.round(PLATE_W * ppaSrc.height / ppaSrc.width)
const queue = await getImage({ src: queueSrc, format: 'webp', width: PLATE_W, quality: 76 })
const queueH = Math.round(PLATE_W * queueSrc.height / queueSrc.width)

const POR_W = 760
const ladder = await getImage({ src: ladderSrc, format: 'webp', width: POR_W, quality: 78 })
const ladderH = Math.round(POR_W * ladderSrc.height / ladderSrc.width)

const tape = [
  { metric: 'Ontario', px: '+65%', unit: ' by 2050', note: 'demand: 150 TWh today, 250 TWh then' },
  { metric: 'Alberta', px: '10 GW+', unit: '', note: 'data centres queued, AESO, early 2025' },
  { metric: 'Canada', px: 'C$700B', unit: ' est.', note: 'cumulative grid spending needed' },
]

const gainers = [
  { name: 'Northland Power', tk: 'NPI', pct: 35.33 },
  { name: 'Brookfield Renewable', tk: 'BEP.UN', pct: 30.76 },
  { name: 'Canadian Utilities', tk: 'CU', pct: 23.20 },
  { name: 'S&P/TSX Composite', tk: 'the broad market', pct: 6.25 },
]
const maxPct = gainers[0].pct

const deals = [
  {
    who: 'TransAlta',
    tk: 'TA',
    got: 'A non-binding memorandum with CPP Investments and Brookfield covering data centres at its Keephills site in Parkland County, Alberta, with TransAlta named the exclusive site and power provider.',
    lead: '230 MW to start.',
    rest: 'That is the size of the long-term power purchase agreement it contemplates, with phased development toward as much as 1 GW under evaluation. Shares rose more than 5% to C$18.75 on the news, and the company raised its quarterly dividend to 7 cents a share from 6.5 cents.',
  },
  {
    who: 'Capital Power',
    tk: 'CPX',
    got: 'A power supply deal with Meta. The company is also negotiating an Alberta data centre agreement and hunting acquisitions in the United States.',
    lead: 'Numbers, on the record.',
    rest: 'The company now guides 2026 adjusted funds from operations of C$890 million to C$1.01 billion and EBITDA of C$1.57 to C$1.77 billion. Dividend raised again.',
  },
  {
    who: 'The queue',
    tk: 'Alberta and Ontario',
    got: 'As of early 2025, AESO’s interconnection queue held more than 10 GW of proposed data centre projects. In Ontario, the IESO expects data centres to be 13% of all new demand by 2035.',
    lead: 'Nothing signed.',
    rest: 'None of this is spoken for yet. Whoever ends up holding all three pieces — the land, the wires and the power — writes the terms.',
  },
]

const layers = [
  {
    layer: 'Regulated utility',
    earns: 'A regulator approves what it can charge, so every dollar it puts into the system — the rate base — comes back with a return attached. Boring on purpose.',
    next: 'The rate decision, and what it borrowed to build. This is the layer that behaves like a bond and gets hurt like one.',
  },
  {
    layer: 'Transmission',
    earns: 'Paid to move power, not to make it. Every new plant and every new factory has to connect through somebody.',
    next: 'Which lines get approved, and how long the interconnection queue in that province has become.',
  },
  {
    layer: 'Independent producer',
    earns: 'Owns generation and sells it, either into the market or under contract. A signed long-term agreement changes the whole valuation.',
    next: 'Contracted versus merchant megawatts, and the counterparty on the other end of the paper.',
  },
  {
    layer: 'Renewable developer',
    earns: 'A pipeline of projects, most of them not built. Earnings arrive years after the announcement does.',
    next: 'Whether the project reaches financial close on the terms in the press release.',
  },
  {
    layer: 'Small infrastructure and equipment',
    earns: 'Transformers, switchgear, substations, engineering. Nobody electrifies anything without this layer, and it’s the one nobody looks at.',
    next: 'The order book, and whether capacity is sold out before the demand shows up.',
  },
]
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Ontario needs two-thirds more electricity by 2050. Somebody gets paid to build the wires.</title>
    <meta
      name="description"
      content="Ontario's own system operator now forecasts electricity demand up 65% by 2050. Alberta's queue held more than 10 GW of proposed data centres. TransAlta has signed a non-binding memorandum covering 230 MW, with room for a gigawatt. A plain-English field note on Canadian power, and a free WhatsApp group where the ticker being discussed gets named."
    />

    <RedirectCode />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Archivo:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --paper: #f3eee4;
        --paper-2: #e9e2d5;
        --card: #fbf8f2;
        --ink: #191d21;
        --ink-2: #4a5158;
        --rule: rgba(25, 29, 33, 0.16);
        --rule-2: rgba(25, 29, 33, 0.08);
        --patina: #1e6a5b;
        --brass: #8b6b2e;
        --wa: #25d366;
        --wa-d: #1bae52;
        --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
        --sans: 'Archivo', system-ui, -apple-system, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        font-family: var(--serif);
        color: var(--ink);
        line-height: 1.66;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        padding-bottom: calc(80px + env(safe-area-inset-bottom));
        background-color: var(--paper);
        background-image:
          repeating-linear-gradient(
            0deg,
            rgba(25, 29, 33, 0.022) 0 1px,
            transparent 1px 24px
          ),
          radial-gradient(120% 80% at 50% 0%, rgba(255, 255, 255, 0.5), transparent 60%);
      }
      img { display: block; max-width: 100%; height: auto; }

      .wrap { width: 100%; padding-inline: 22px; }

      .issue {
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--ink-2);
      }

      hr.rule {
        border: none;
        border-top: 1px solid var(--rule);
        margin: 30px 0;
        transform: scaleX(0);
        transform-origin: left;
      }
      .js hr.rule.in { transform: none; transition: transform 0.7s cubic-bezier(0.22, 0.8, 0.3, 1); }

      /* ---------- masthead / opening ---------- */
      .open { padding-top: calc(env(safe-area-inset-top) + 42px); padding-bottom: 8px; }
      .open h1 {
        margin-top: 14px;
        font-weight: 700;
        font-size: clamp(1.95rem, 8.2vw, 2.7rem);
        line-height: 1.13;
        letter-spacing: -0.018em;
        text-wrap: balance;
      }
      .standfirst {
        margin-top: 14px;
        font-family: var(--sans);
        font-size: 0.92rem;
        font-weight: 500;
        line-height: 1.5;
        color: var(--patina);
        max-width: 46ch;
      }
      .lede {
        margin-top: 20px;
        font-size: 1.09rem;
        line-height: 1.7;
        color: var(--ink-2);
        max-width: 60ch;
      }
      .lede::first-letter {
        float: left;
        font-size: 3.35rem;
        line-height: 0.86;
        font-weight: 700;
        color: var(--patina);
        padding-right: 9px;
        padding-top: 5px;
      }

      /* ---------- number tape ---------- */
      .tape {
        margin-top: 26px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 14px 0;
        border-block: 1px solid var(--rule);
      }
      .tape .metric {
        font-family: var(--sans);
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--ink-2);
        min-height: 1.4em;
      }
      .tape .note { min-height: 2.7em; }
      .tape .px {
        margin-top: 3px;
        font-size: clamp(1.05rem, 4.6vw, 1.3rem);
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }
      .tape .px span { font-size: 0.66em; font-weight: 500; color: var(--ink-2); }
      .tape .note {
        margin-top: 4px;
        font-family: var(--sans);
        font-size: 0.66rem;
        line-height: 1.35;
        color: var(--brass);
      }
      .src-note {
        margin-top: 10px;
        font-family: var(--sans);
        font-size: 0.68rem;
        line-height: 1.5;
        color: var(--ink-2);
        max-width: 62ch;
      }

      /* ---------- buttons ---------- */
      .acts { margin-top: 26px; }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        min-height: 56px;
        padding: 16px 24px;
        border: none;
        border-radius: 3px;
        background: var(--ink);
        color: var(--paper);
        font-family: var(--sans);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.14s ease;
      }
      .btn svg { width: 17px; height: 17px; flex: none; }
      .btn:hover { background: var(--patina); transform: translateY(-2px); }
      .btn:active { transform: translateY(0); }
      .btn:focus-visible { outline: 3px solid var(--patina); outline-offset: 3px; }

      /* ---------- sections ---------- */
      .sec { padding: 12px 0 46px; }
      .sec h2 {
        font-weight: 700;
        font-size: clamp(1.4rem, 5.6vw, 1.85rem);
        line-height: 1.22;
        letter-spacing: -0.014em;
        text-wrap: balance;
      }
      .body {
        margin-top: 15px;
        font-size: 1.03rem;
        color: var(--ink-2);
        max-width: 62ch;
      }
      .body + .body { margin-top: 13px; }
      .body strong { color: var(--ink); font-weight: 600; }

      /* ---------- stat row ---------- */
      .stats {
        margin-top: 24px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px 10px;
      }
      .stats .n {
        font-size: clamp(1.5rem, 7vw, 2.1rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: var(--patina);
      }
      .stats .k {
        margin-top: 5px;
        font-family: var(--sans);
        font-size: 0.7rem;
        line-height: 1.4;
        font-weight: 500;
        color: var(--ink-2);
      }

      /* ---------- performance bars ---------- */
      .gainers { list-style: none; margin-top: 26px; border-top: 1px solid var(--rule); }
      .gainers li {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 7px 12px;
        padding: 12px 0 13px;
        border-bottom: 1px solid var(--rule-2);
      }
      .g-name { font-family: var(--sans); font-size: 0.86rem; font-weight: 600; }
      .g-name em {
        font-style: normal;
        font-weight: 500;
        font-size: 0.74rem;
        letter-spacing: 0.05em;
        color: var(--ink-2);
      }
      .g-pct {
        font-family: var(--sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--patina);
        white-space: nowrap;
      }
      .g-bar { grid-column: 1 / -1; height: 7px; background: var(--rule-2); }
      .g-bar i {
        display: block;
        height: 100%;
        width: var(--w);
        background: linear-gradient(90deg, var(--brass), var(--patina));
      }
      .gainers li.base .g-pct { color: var(--ink-2); }
      .gainers li.base .g-bar i { background: var(--ink-2); opacity: 0.45; }
      .js .gainers .g-bar i { width: 0; }
      .js .gainers.in .g-bar i { width: var(--w); transition: width 1.05s cubic-bezier(0.22, 0.8, 0.3, 1); }

      /* ---------- re-rating figure ---------- */
      .rerate {
        margin-top: 26px;
        background: var(--card);
        border: 1px solid var(--rule);
        border-left: 3px solid var(--patina);
        padding: 20px 18px;
      }
      .rerate .pair { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
      .rerate .n {
        font-size: clamp(1.6rem, 7.4vw, 2.25rem);
        font-weight: 700;
        letter-spacing: -0.022em;
        line-height: 1.1;
      }
      .rerate .n.hi { color: var(--patina); }
      .rerate .arw { font-family: var(--sans); font-weight: 600; color: var(--brass); font-size: 1.1rem; }
      .rerate .cap {
        margin-top: 11px;
        font-family: var(--sans);
        font-size: 0.78rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ink-2);
      }

      /* ---------- plates ---------- */
      figure {
        margin-top: 26px;
        background: var(--card);
        border: 1px solid var(--rule);
        padding: 13px;
      }
      figure img { width: 100%; }
      figcaption {
        margin-top: 11px;
        font-family: var(--sans);
        font-size: 0.75rem;
        line-height: 1.55;
        font-weight: 500;
        color: var(--ink-2);
      }
      .plates { display: grid; gap: 18px; }

      /* ---------- tables ---------- */
      .tbl-scroll { margin-top: 24px; overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; min-width: 540px; }
      thead th {
        font-family: var(--sans);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-align: left;
        color: var(--ink);
        padding: 0 12px 9px 0;
        border-bottom: 2px solid var(--patina);
        vertical-align: bottom;
      }
      tbody td {
        font-size: 0.93rem;
        line-height: 1.58;
        color: var(--ink-2);
        padding: 13px 12px 13px 0;
        border-bottom: 1px solid var(--rule-2);
        vertical-align: top;
      }
      tbody td:first-child {
        font-family: var(--sans);
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--ink);
        white-space: nowrap;
      }
      tbody td strong { color: var(--ink); font-weight: 600; }
      tbody td .tk { font-weight: 500; color: var(--ink-2); }
      .js tbody tr { opacity: 0; }
      .js .tbl-scroll.in tbody tr { opacity: 1; transition: opacity 0.5s ease; }

      /* deals table: stacked cards on phones, real table from 640px up */
      table.deal-tbl { min-width: 0; width: 100%; }
      .deal-tbl thead { display: none; }
      .deal-tbl tbody tr { display: block; padding: 16px 0; border-bottom: 1px solid var(--rule-2); }
      .deal-tbl tbody td { display: block; padding: 0; border: none; white-space: normal; }
      .deal-tbl tbody td:first-child {
        font-family: var(--sans);
        font-size: 1rem;
        white-space: normal;
        margin-bottom: 8px;
      }
      .deal-tbl tbody td:first-child .tk { font-size: 0.78rem; letter-spacing: 0.05em; }
      .deal-tbl tbody td + td { margin-top: 9px; }
      .deal-tbl tbody td[data-l]::before {
        content: attr(data-l);
        display: block;
        font-family: var(--sans);
        font-size: 0.64rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--brass);
        margin-bottom: 3px;
      }
      .deal-tbl tbody td.terms {
        background: rgba(30, 106, 91, 0.07);
        border-left: 2px solid var(--patina);
        padding: 10px 12px;
      }

      /* ---------- contract readout ---------- */
      .hole {
        margin-top: 24px;
        background: var(--card);
        border: 1px solid var(--rule);
        padding: 18px;
      }
      .hole .id {
        font-family: var(--sans);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .hole .cut {
        margin-top: 7px;
        font-size: clamp(1.15rem, 5.2vw, 1.5rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }
      .hole .cut b { color: var(--patina); font-weight: 700; }
      .hole dl { margin-top: 15px; border-top: 1px solid var(--rule-2); }
      .hole dt { font-family: var(--sans); font-size: 0.78rem; font-weight: 600; padding-top: 11px; }
      .hole dd {
        font-size: 0.93rem;
        line-height: 1.55;
        color: var(--ink-2);
        padding-bottom: 11px;
        border-bottom: 1px solid var(--rule-2);
      }
      .hole .fund {
        margin-top: 13px;
        font-family: var(--sans);
        font-size: 0.78rem;
        line-height: 1.55;
        color: var(--ink-2);
      }

      /* ---------- honest ---------- */
      .honest { background: var(--paper-2); border-block: 1px solid var(--rule); padding: 40px 0; }
      .honest .body { max-width: 60ch; }

      .steps { margin-top: 20px; padding-left: 20px; }
      .steps li { font-size: 1rem; color: var(--ink-2); margin-bottom: 9px; padding-left: 5px; }
      .steps li::marker { font-family: var(--sans); font-weight: 600; color: var(--patina); font-size: 0.85rem; }

      .fine { margin-top: 15px; font-family: var(--sans); font-size: 0.74rem; color: var(--ink-2); }

      .foot { padding: 30px 0 40px; border-top: 1px solid var(--rule); }
      .foot p { font-size: 0.78rem; line-height: 1.62; color: var(--ink-2); max-width: 70ch; }
      .foot p + p { margin-top: 10px; }

      /* ---------- sticky whatsapp ---------- */
      .wa-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 40;
        padding: 11px 0 calc(11px + env(safe-area-inset-bottom));
        background: rgba(243, 238, 228, 0.95);
        backdrop-filter: blur(10px);
        border-top: 1px solid var(--rule);
      }
      .wa-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 52px;
        border: none;
        border-radius: 3px;
        background: var(--wa);
        color: #04220f;
        font-family: var(--sans);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      .wa-btn svg { width: 21px; height: 21px; flex: none; }
      .wa-btn:hover { background: var(--wa-d); }
      .wa-btn:focus-visible { outline: 3px solid var(--patina); outline-offset: 3px; }

      /* ---------- reveal ---------- */
      .js .reveal { opacity: 0; transform: translateY(14px); }
      .js .reveal.in {
        opacity: 1;
        transform: none;
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.8, 0.3, 1);
      }

      @media (prefers-reduced-motion: reduce) {
        .js .reveal, .js tbody tr { opacity: 1; transform: none; }
        .js hr.rule { transform: none; }
        .js .gainers .g-bar i { width: var(--w); }
        html { scroll-behavior: auto; }
      }

      /* ---------- progressive enhancement ---------- */
      @media (min-width: 640px) {
        .wrap { max-width: 680px; margin-inline: auto; padding-inline: 32px; }
        .btn, .wa-btn { width: auto; min-width: 300px; }
        .acts { display: flex; }
        .open { padding-top: calc(env(safe-area-inset-top) + 64px); }
        .gainers li { grid-template-columns: 15rem 1fr auto; align-items: center; gap: 0 16px; }
        .g-bar { grid-column: auto; }
        .hole { padding: 24px; }
        .deal-tbl thead { display: table-header-group; }
        .deal-tbl tbody tr { display: table-row; padding: 0; }
        .deal-tbl tbody td {
          display: table-cell;
          padding: 13px 12px 13px 0;
          border-bottom: 1px solid var(--rule-2);
        }
        .deal-tbl tbody td:first-child { font-size: 0.85rem; margin-bottom: 0; }
        .deal-tbl tbody td + td { margin-top: 0; }
        .deal-tbl tbody td[data-l]::before { display: none; }
        .deal-tbl tbody td.terms { background: none; border-left: none; padding: 13px 12px 13px 0; }
      }
      @media (min-width: 760px) {
        .plates { grid-template-columns: 1fr 1fr; gap: 20px; }
        table { min-width: 0; }
      }
      @media (min-width: 1024px) {
        .wrap { max-width: 880px; }
        .sec { padding: 16px 0 62px; }
        .honest { padding: 62px 0; }
      }
    </style>

    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <!-- ============ OPENING ============ -->
    <section class="open">
      <div class="wrap">
        <p class="issue reveal">Field note · Aug. 11, 2026 · Toronto</p>
        <h1 class="reveal">
          Your hydro bill is about to build a lot of new wires. Somebody gets paid to build them.
        </h1>
        <p class="standfirst reveal">
          Ontario's own system operator now puts demand two-thirds higher by 2050. Alberta has ten gigawatts of data centres waiting on a connection.
        </p>
        <p class="lede reveal">
          The IESO, which runs Ontario's grid, now forecasts provincial demand 65% higher by 2050 — from just over 150 terawatt-hours a year to about 250. Good intentions don't move electrons. Somebody has to build the plants and string the wires, somebody has to be paid to do it, and almost none of that money has been spent yet.
        </p>

        <div class="tape reveal">
          {tape.map(t => (
            <div>
              <p class="metric">{t.metric}</p>
              <p class="px">{t.px}<span>{t.unit}</span></p>
              <p class="note">{t.note}</p>
            </div>
          ))}
        </div>
        <p class="src-note reveal">
          IESO 2026 Annual Planning Outlook, AESO interconnection queue as of early 2025, and published national estimates of grid investment. Figures as reported.
        </p>

        <div class="acts reveal">
          <button type="button" class="btn link-btn" onclick="mixinJump()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <hr class="rule reveal" />
      </div>
    </section>

    <!-- ============ THE LOAD ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">The demand nobody planned for</h2>
        <p class="body reveal">
          Electricity demand in this country was flat for the better part of two decades. Efficiency kept cancelling out growth, so nobody built much. Then three things arrived at once: electrification of cars and buildings, industry coming back onshore, and computing that eats power by the gigawatt.
        </p>
        <p class="body reveal">
          The IESO expects data centres alone to be <strong>13% of all new demand by 2035</strong>. Hydro-Québec called them the largest single new item in its 2023 supply plan. In Alberta, where power is cheapest and permitting is fastest, the queue of proposed data centre projects passed ten gigawatts more than a year ago.
        </p>

        <div class="stats reveal">
          <div>
            <p class="n">+100 TWh</p>
            <p class="k">Ontario demand growth to 2050, on the reference case</p>
          </div>
          <div>
            <p class="n">13%</p>
            <p class="k">Share of Ontario's new demand from data centres by 2035</p>
          </div>
          <div>
            <p class="n">10 GW+</p>
            <p class="k">Alberta data centre projects queued for a connection</p>
          </div>
        </div>

        <figure class="reveal">
          <img
            src={mapFig.src}
            width={FIG_W}
            height={mapH}
            alt="A printed two-colour plate of Canada marking Ontario, Alberta and Quebec as the three load centres, with three facts: demand forecast up 65% by 2050, data centres queued for gigawatts of load, and the wires not built yet."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Ontario, Alberta and Quebec are taking almost all of it. The queue is longest where power is cheapest and permitting is fastest.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ WHO GETS PAID ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">Who actually gets paid for it</h2>
        <p class="body reveal">
          There are only three ways any of this turns into money for you.
          <strong>One:</strong> a regulator lets a utility earn a return on new capital, so the more
          it builds, the more it is allowed to make. <strong>Two:</strong> a generator signs a long-term contract with a creditworthy buyer, and the market reprices the whole company the day it is announced. <strong>Three:</strong> somebody sells the transformers, switchgear
          and engineering hours, and gets paid before a single megawatt-hour is delivered.
        </p>

        <div class="rerate reveal">
          <div class="pair">
            <span class="n">230 MW</span>
            <span class="arw">→</span>
            <span class="n hi">up to 1 GW</span>
          </div>
          <p class="cap">
            TransAlta has signed a memorandum of understanding with CPP Investments and Brookfield — non-binding, which matters. It contemplates a long-term power purchase agreement of about 230 MW at Keephills, in Parkland County, and phased development toward as much as a gigawatt. The stock rose more than 5% to C$18.75 on the news and the quarterly dividend went to 7 cents a share from 6.5 cents. That's what an MOU can do before anything is actually contracted.
          </p>
        </div>

        <p class="body reveal">
          The second route is the one worth learning, because it runs on paperwork instead of luck. A company like Meta, which needs power it can count on around the clock for twenty years, isn't a customer you lose to a competitor next quarter — and the terms are public the moment they're filed.
        </p>

        <div class="tbl-scroll reveal">
          <table class="deal-tbl">
            <thead>
              <tr>
                <th>Who</th>
                <th>What was actually agreed</th>
                <th>The terms</th>
              </tr>
            </thead>
            <tbody>
              {deals.map((d, i) => (
                <tr style={`transition-delay:${i * 90}ms`}>
                  <td>{d.who}<br /><span class="tk">{d.tk}</span></td>
                  <td data-l="What was agreed">{d.got}</td>
                  <td class="terms" data-l="The terms"><strong>{d.lead}</strong> {d.rest}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="src-note reveal">
          Company news releases and system-operator filings. These are the names already on the front page, and the point is the shape of the deals rather than a suggestion to buy any of them.
        </p>

        <div class="acts reveal" style="margin-top:28px">
          <button type="button" class="btn link-btn" onclick="mixinJump()">
            Get the morning notes free
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ============ THE TAPE ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">The market has noticed some of this</h2>
        <p class="body reveal">
          Utilities are the third-best performing sector on the TSX so far this year, behind energy and basic materials. That's not how this sector normally behaves — it's where you park money when you want to be bored. The names carrying it are the ones with generation to contract out.
        </p>

        <ol class="gainers reveal">
          {gainers.map((g, i) => (
            <li class={g.tk === 'the broad market' ? 'base' : ''}>
              <span class="g-name">{g.name} <em>{g.tk}</em></span>
              <span class="g-bar"><i style={`--w:${Math.round((g.pct / maxPct) * 100)}%;transition-delay:${i * 70}ms`}></i></span>
              <span class="g-pct">+{g.pct.toFixed(2)}%</span>
            </li>
          ))}
        </ol>
        <p class="src-note reveal">
          Year-to-date price change, 2026; Brookfield Renewable trades as partnership units, not shares. The bottom bar is the broad market, for scale. Past performance says nothing about what any of these do next.
        </p>
      </div>
    </section>

    <!-- ============ READING A PPA ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">How to read the sentence that moves a power stock</h2>
        <p class="body reveal">
          Power deals get announced in one paragraph of contract language, and most people skim it.
          Four things in it decide whether the announcement is worth anything. Here is the TransAlta
          one, taken apart.
        </p>

        <div class="hole reveal">
          <p class="id">Keephills · Parkland County, Alberta · phased data centre development</p>
          <p class="cut">
            <b>230 MW</b> contemplated under a <b>long-term</b> agreement, TransAlta named the <b>exclusive</b> site and power provider, with up to <b>1 GW</b> under evaluation
          </p>
          <dl>
            <dt>230 MW</dt>
            <dd>The size of what's being discussed, which is not yet the size of a commitment. One big data centre campus pulls this much around the clock, every day of the year. That steadiness is why it can be sold years ahead under contract instead of dumped into a spot market that swings.</dd>
            <dt>Long-term</dt>
            <dd>The word that changes the valuation. Contracted megawatts get priced like an annuity; merchant megawatts get priced like a commodity. Same turbine, very different multiple.</dd>
            <dt>Exclusive site and power provider</dt>
            <dd>Nobody else can supply that campus. And the scarce thing here isn't the power plant — it's flat land beside a transmission line that already has a connection.</dd>
            <dt>Up to 1 GW</dt>
            <dd>The option, not the promise. Phased means every stage has to clear its own hurdle, so read the gigawatt as something the market hasn't priced in yet.</dd>
          </dl>
          <p class="fund">
            Every serious power announcement can be read this way: how many megawatts, for how long, with whom, and what has to happen before stage two.
          </p>
        </div>

        <div class="plates">
          <figure class="reveal">
            <img
              src={ppa.src}
              width={PLATE_W}
              height={ppaH}
              alt="An overhead photograph of a printed power purchase agreement with a signature block, a folded blueprint schematic, a pencil, a calculator and a numbered equipment tag."
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              The agreement. Megawatts, term, counterparty, and what has to clear before stage two: the four things that decide whether a press release is an annuity or a headline.
            </figcaption>
          </figure>

          <figure class="reveal">
            <img
              src={queue.src}
              width={PLATE_W}
              height={queueH}
              alt="An overhead photograph of a printed interconnection queue table with megawatt figures noted in blue pen, beside a small printed photograph of a substation switchyard."
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              The queue. Everyone wants to connect. The system operator decides who can, and when — and a position in this list is worth more than a press release about ambition.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============ LAYERS ============ -->
    <section class="sec">
      <div class="wrap">
        <h2 class="reveal">Five layers, and they don't move together</h2>
        <p class="body reveal">
          “Power stock” covers five completely different businesses. Which layer a company sits in decides what a regulator's decision, a move from the Bank of Canada, or a signed contract does to it. Establish that first, before reading a single headline about the company.
        </p>

        <div class="tbl-scroll reveal">
          <table class="deal-tbl">
            <thead>
              <tr>
                <th>Layer</th>
                <th>What it actually earns</th>
                <th>What we watch next</th>
              </tr>
            </thead>
            <tbody>
              {layers.map((l, i) => (
                <tr style={`transition-delay:${i * 90}ms`}>
                  <td>{l.layer}</td>
                  <td data-l="What it earns">{l.earns}</td>
                  <td data-l="What we watch next">{l.next}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ HONEST ============ -->
    <section class="honest">
      <div class="wrap">
        <h2 class="reveal">The honest part</h2>
        <p class="body reveal">
          Power companies borrow enormous amounts of money. That makes them a bet on interest rates almost as much as a bet on electricity. Then the Bank of Canada started hiking, and this sector got repriced hard. Algonquin cut its quarterly dividend by 40% in early 2023 after interest costs and construction delays caught up with it, and by the time that was over the shares had lost most of what they were worth. A utility can be right about demand and still lose you money.
        </p>
        <p class="body reveal">
          A queue isn't a build. Ten gigawatts of proposed data centres means ten gigawatts of applications, and a good share of those projects will be withdrawn, downsized or parked. Here is the sobering version: Canada's installed data centre capacity is only about 750 MW today, forecast to reach roughly 1.16 GW by 2029. Set that against ten gigawatts of applications in one province and you can see how much of a queue is just paper. Announcements are free; steel and turbines are not.
        </p>
        <p class="body reveal">
          And who sets the price depends on the province. On the regulated side a company doesn't decide what it earns — a hearing at the OEB in Ontario, or the AUC in Alberta, does. In Alberta's wholesale market the price is whatever the market says, and that cuts both ways. Either way, the outcome can land nowhere near what the guidance implied.
        </p>
        <p class="body reveal">
          None of that argues for staying out. It argues for knowing which layer a company sits in and what it has actually signed, before looking at the chart. That's the job. It's what goes out in the group every morning.
        </p>
      </div>
    </section>

    <!-- ============ LADDER + MORNING ============ -->
    <section class="sec" style="padding-top:44px">
      <div class="wrap">
        <h2 class="reveal">Where nobody's looking</h2>
        <p class="body reveal">
          The top of the ladder is owned by everyone. Index funds, pension plans and dividend
          portfolios all have to hold the big regulated utilities, so those names are priced by
          people who never read a rate filing.
        </p>
        <p class="body reveal">
          Nothing forces anyone to own the bottom two rungs. That's where a company can be doing the work — supplying equipment, holding a connection, building out a site — while the share price waits for somebody to notice. It's also where most of the ways to lose money live, which is why the layer matters more than the story.
        </p>

        <figure class="reveal">
          <img
            src={ladder.src}
            width={POR_W}
            height={ladderH}
            alt="A printed ladder diagram with five rungs from small infrastructure up to regulated utility, with a bracket marking the bottom two rungs that no index has to buy."
            loading="lazy"
            decoding="async"
          />
          <figcaption>Five rungs. No index has to buy the bottom two.</figcaption>
        </figure>

        <hr class="rule reveal" />

        <h2 class="reveal">Three things, before the open</h2>
        <ol class="steps">
          <li class="reveal">What got signed overnight — power purchase agreements, site deals, interconnection approvals — and which layer the company that signed it belongs to.</li>
          <li class="reveal">Whether the announcement adds contracted megawatts or only ambition.</li>
          <li class="reveal">What has to happen next for any of it to still matter a month from now.</li>
        </ol>
        <p class="body reveal">
          That goes out on WhatsApp before the bell, in plain English, and it costs nothing. One tap, no login, nothing to learn. Everything named above is already in the papers. The small-cap the group has been chewing on this week — the ticker — gets said out loud in there, not on a page like this.
        </p>

        <div class="acts reveal" style="margin-top:30px">
          <button type="button" class="btn link-btn" onclick="mixinJump()">
            Join the free WhatsApp group
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
        <p class="fine reveal">Free · no forms, no fees · two taps to leave, nobody calls you</p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <p>
          Everything here is general market commentary and educational research. It doesn't take your
          objectives or financial situation into account and it's not a recommendation to buy or sell
          anything. Electricity and infrastructure shares carry real risk: they are sensitive to
          interest rates, dependent on regulatory decisions, and projects announced do not always get
          built. Do your own research before you invest.
        </p>
        <p>
          Forecasts, deal terms and price moves are as publicly reported: the IESO 2026 Annual
          Planning Outlook, AESO interconnection queue data, company news releases and quarterly
          guidance, and TSX share price changes year-to-date in 2026. Past performance is not
          indicative of future results.
        </p>
      </div>
    </footer>

