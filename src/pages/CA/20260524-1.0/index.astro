  <script is:inline>
    // ─── Countdown to midnight EST ───
    function fmt2(n) { return String(n).padStart(2, '0'); }

    function getMidnightEST() {
      const now = new Date();
      // Approx EST (UTC-5). Sufficient for an LP countdown.
      const utcMs = now.getTime() + now.getTimezoneOffset() * 60000;
      const estNow = new Date(utcMs + (-5 * 3600000));
      const estMidnight = new Date(estNow);
      estMidnight.setHours(23, 59, 59, 999);
      const diff = estMidnight.getTime() - estNow.getTime();
      return diff > 0 ? diff : 0;
    }

    function updateCountdown() {
      const diff = getMidnightEST();
      const el = document.getElementById('countdown');
      const stickyEl = document.getElementById('sticky-countdown');
      if (diff <= 0) {
        if (el) el.textContent = 'Closing today';
        if (stickyEl) stickyEl.textContent = 'closes today';
        return;
      }
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      if (el) el.textContent = `${fmt2(h)} h  ${fmt2(m)} m  ${fmt2(s)} s`;
      if (stickyEl) stickyEl.textContent = `closes in ${fmt2(h)}h ${fmt2(m)}m`;
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // ─── Live seat counter (jitter in [38, 47]) ───
    let seatsTaken = 41;
    function updateSeats() {
      const taken = seatsTaken;
      const left = 50 - taken;
      const pct = Math.min(98, Math.round((taken / 50) * 100));
      const fill = document.getElementById('seats-fill');
      const label = document.getElementById('seats-label');
      const numEl = document.getElementById('seats-taken');
      const tickerEl = document.getElementById('ticker-seats');
      const heroEl = document.getElementById('hero-seats');
      if (fill) fill.style.width = pct + '%';
      if (label) label.textContent = `${taken} / 50`;
      if (numEl) numEl.textContent = String(taken);
      if (tickerEl) tickerEl.textContent = `${taken} of 50 seats taken`;
      if (heroEl) heroEl.textContent = `${left} seats left for today · Closes when full`;
    }
    function jitterSeats() {
      // small random walk, clamped [38, 47]
      const delta = Math.random() < 0.65 ? 1 : (Math.random() < 0.5 ? 0 : -1);
      seatsTaken = Math.min(47, Math.max(38, seatsTaken + delta));
      updateSeats();
    }
    updateSeats();
    setInterval(jitterSeats, 11000);

    // ─── Reveal animation ───
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('active'), idx * 70);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('active'));
    }

    // ─── Sticky mobile CTA after hero ───
    const hero = document.querySelector('.hero');
    const sticky = document.getElementById('sticky-cta');
    if (hero && sticky && 'IntersectionObserver' in window) {
      const stickyIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            sticky.classList.remove('active');
          } else {
            sticky.classList.add('active');
          }
        });
      }, { threshold: 0.05 });
      stickyIO.observe(hero);
    }

    // ─── GA event tracking on CTA clicks ───
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const slot = el.getAttribute('data-cta') || 'unknown';
          try {
            if (typeof gtag !== 'undefined') {
              gtag('event', 'cta_click', {
                event_category: 'whatsapp_room',
                event_label: slot,
                page_path: '/CA/20260524-1.0/',
              });
            }
          } catch (e) { /* swallow */ }
        });
      });
    });
  </script>
</BaseLayout>
</content>
