---
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = '5 Well-Known Canadian Companies — Next Big Opportunity'
const description = 'More Canadians are paying attention to passive income, long-term investing, and potential future stock value from strong consumer brands.'

type Company = { name: string; sector: string; icon: string }

const companies: Company[] = [
  { name: 'GoodLife', sector: 'Health & Fitness', icon: 'dumbbell' },
  { name: 'Longo’s', sector: 'Grocery Retail', icon: 'cart' },
  { name: 'MEC', sector: 'Outdoor Retail', icon: 'mountain' },
  { name: 'Harvey’s', sector: 'Quick Service', icon: 'burger' },
]
---

<BaseLayout title={title} description={description} lang="en">
  <Fragment slot="head">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </Fragment>

  <main
    class="min-h-screen w-full bg-cover bg-center bg-no-repeat relative flex items-center justify-center px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
    style="background-image: linear-gradient(rgba(5,15,35,0.82), rgba(5,15,35,0.86)), url('https://images.unsplash.com/photo-1517935706615-2717063c2225?q=80&w=2070&auto=format&fit=crop');"
  >
    <div
      class="w-full max-w-6xl bg-white/8 backdrop-blur-xl border border-white/10 rounded-2xl sm:rounded-3xl lg:rounded-[40px] p-5 sm:p-8 lg:p-14 shadow-2xl text-white"
    >
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Left Content -->
        <div class="min-w-0">
          <div
            class="inline-flex items-center gap-2 bg-red-600/20 border border-red-500/30 px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs sm:text-sm font-medium mb-5 sm:mb-6 whitespace-nowrap"
          >
            <span aria-hidden="true" class="text-base sm:text-lg leading-none">🇨🇦</span>
            Canadian Market Opportunity
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-black leading-[1.05] uppercase mb-5 sm:mb-6 hyphens-none">
            5 Well-Known Canadian Companies
            <span class="text-yellow-400 block mt-2">
              Could Become The Next Big Opportunity
            </span>
          </h1>

          <p class="text-sm sm:text-base lg:text-lg text-gray-200 leading-relaxed mb-6 sm:mb-8 max-w-xl">
            More Canadians are paying attention to passive income, long-term investing, and potential future stock value from strong consumer brands.
          </p>

          <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-6 sm:mb-8 max-w-lg">
            <div class="bg-white/10 rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-white/10 flex items-start gap-2.5 sm:block">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-yellow-400 shrink-0 sm:mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v10M9 9.5a2.5 2.5 0 0 1 5 0c0 1.5-3 1.5-3 3a2.5 2.5 0 0 0 5 0" />
              </svg>
              <div class="font-bold text-xs sm:text-sm md:text-base leading-tight">Passive<br class="sm:hidden"> Income</div>
            </div>

            <div class="bg-white/10 rounded-xl sm:rounded-2xl p-3 sm:p-5 border border-white/10 flex items-start gap-2.5 sm:block">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-green-400 shrink-0 sm:mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17l6-6 4 4 8-8" />
                <path d="M14 7h7v7" />
              </svg>
              <div class="font-bold text-xs sm:text-sm md:text-base leading-tight">Potential<br class="sm:hidden"> Stock Value</div>
            </div>
          </div>

          <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
            <span class="relative flex h-3 w-3 sm:h-4 sm:w-4 shrink-0">
              <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-60 animate-ping"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 sm:h-4 sm:w-4 bg-green-500"></span>
            </span>
            <div class="text-base sm:text-lg lg:text-xl font-semibold">
              28,000+ Canadians Already Joined
            </div>
          </div>

          <a
            href="#"
            class="link-btn inline-flex w-full sm:w-auto items-center justify-center gap-2.5 bg-green-500 hover:bg-green-400 active:bg-green-600 transition-all text-black font-black text-base sm:text-lg lg:text-xl px-6 sm:px-10 py-4 sm:py-5 rounded-xl sm:rounded-2xl shadow-2xl shadow-green-500/30 cursor-pointer"
            data-cta="hero"
          >
            <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.74.45 3.43 1.32 4.92L2 22l5.31-1.39a9.86 9.86 0 0 0 4.73 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.79 13.85c-.24.68-1.18 1.25-1.96 1.42-.52.11-1.21.2-3.51-.76-2.94-1.22-4.83-4.21-4.98-4.41-.15-.2-1.19-1.58-1.19-3.02s.76-2.14 1.02-2.43c.27-.29.59-.37.79-.37.2 0 .39 0 .57.01.18.01.43-.07.67.51.25.59.83 2.04.91 2.19.07.15.12.32.02.51-.1.2-.15.32-.29.49-.15.18-.31.39-.44.53-.15.15-.3.31-.13.61.17.29.76 1.26 1.64 2.04 1.13 1.01 2.08 1.32 2.38 1.47.29.15.46.12.63-.07.17-.2.72-.84.91-1.13.2-.29.39-.24.66-.15.27.1 1.71.81 2 .96.29.15.49.22.56.34.07.13.07.73-.17 1.41z"/>
            </svg>
            Join On WhatsApp
          </a>
        </div>

        <!-- Right Company Cards -->
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          {companies.map(item => (
            <div class="bg-white text-gray-900 rounded-2xl sm:rounded-3xl p-4 sm:p-6 text-center shadow-2xl">
              <div class="w-10 h-10 sm:w-14 sm:h-14 mx-auto mb-2 sm:mb-4 rounded-full bg-yellow-50 ring-1 ring-yellow-200 flex items-center justify-center text-yellow-600">
                {item.icon === 'dumbbell' && (
                  <svg class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 8v8M3 10v4M18 8v8M21 10v4M6 12h12" />
                  </svg>
                )}
                {item.icon === 'cart' && (
                  <svg class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="20" r="1.6" />
                    <circle cx="18" cy="20" r="1.6" />
                    <path d="M2 3h3l2.5 12h12l2-8H6" />
                  </svg>
                )}
                {item.icon === 'mountain' && (
                  <svg class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 20l5.5-9 3 5 3-4 6.5 8z" />
                    <circle cx="17" cy="6" r="2" />
                  </svg>
                )}
                {item.icon === 'burger' && (
                  <svg class="w-5 h-5 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 11a9 9 0 0 1 18 0H3zM3 15h18M5 19h14" />
                  </svg>
                )}
              </div>
              <div class="text-base sm:text-xl lg:text-2xl font-black leading-tight">{item.name}</div>
              <div class="text-[10px] sm:text-xs text-gray-500 mt-1 uppercase tracking-wider font-medium">{item.sector}</div>
            </div>
          ))}

          <div class="col-span-2 bg-gradient-to-br from-yellow-400 to-yellow-500 text-gray-900 rounded-2xl sm:rounded-3xl p-4 sm:p-6 text-center shadow-2xl">
            <div class="text-base sm:text-2xl lg:text-3xl font-black mb-1.5 sm:mb-2 leading-tight">
              Potential Canadian Investment Opportunities
            </div>
            <div class="font-semibold text-xs sm:text-base lg:text-lg leading-snug">
              Passive Income · Long-Term Growth · Consumer Brands
            </div>
          </div>
        </div>
      </div>

      <div class="text-center text-[10px] sm:text-xs text-gray-400 mt-6 sm:mt-8 leading-relaxed">
        This content is for informational purposes only and does not constitute financial advice.
      </div>
    </div>
  </main>

  <script type="module" src="/src/utils/jump.ts"></script>
  <script is:inline>
    document.querySelectorAll('.link-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        if (typeof window.mixinJump === 'function') window.mixinJump()
        else if (typeof link !== 'undefined') window.location.href = link
      })
    })
  </script>
</BaseLayout>
