  <script>
    function pad(n) { return String(n).padStart(2, '0'); }

    function tickCountdown() {
      const now = new Date();
      const endOfDay = new Date(now);
      endOfDay.setHours(23, 59, 59, 999);
      const diffMs = endOfDay.getTime() - now.getTime();

      let h, m, s;
      if (diffMs <= 0) { h = m = s = 0; }
      else {
        h = Math.floor(diffMs / 3.6e6);
        m = Math.floor((diffMs % 3.6e6) / 6e4);
        s = Math.floor((diffMs % 6e4) / 1000);
      }

      const ch = document.getElementById('cd-h');
      const cm = document.getElementById('cd-m');
      const cs = document.getElementById('cd-s');
      if (ch) ch.textContent = pad(h);
      if (cm) cm.textContent = pad(m);
      if (cs) cs.textContent = pad(s);

      const sticky = document.getElementById('sticky-cd');
      if (sticky) sticky.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
    }
    tickCountdown();
    setInterval(tickCountdown, 1000);

    const heroCtaRow = document.getElementById('hero-cta-row');
    const stickyBar = document.getElementById('sticky-cta');
    if (heroCtaRow && stickyBar && 'IntersectionObserver' in window) {
      const showSticky = (show) => stickyBar.classList.toggle('visible', show);
      const heroIO = new IntersectionObserver((entries) => {
        entries.forEach((entry) => showSticky(!entry.isIntersecting));
      }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
      heroIO.observe(heroCtaRow);
    } else if (stickyBar) {
      stickyBar.classList.add('visible');
    }

    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry, idx) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('active'), idx * 70);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('active'));
    }
  </script>
